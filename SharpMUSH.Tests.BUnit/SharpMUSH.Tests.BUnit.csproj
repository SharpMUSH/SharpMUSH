<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <RollForward>LatestMajor</RollForward>
    <NoWarn>TUnit0038</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bunit" Version="2.7.2" />
    <PackageReference Include="AngleSharp" Version="1.5.0" />
    <PackageReference Include="TUnit" Version="1.19.16" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="MudBlazor" Version="9.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpMUSH.Client\SharpMUSH.Client.csproj" />
    <ProjectReference Include="..\SharpMUSH.Server\SharpMUSH.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Inputs for PortalSurfacesTests, which cross-checks the two files that decide what the
         per-locale localization gate covers: the key-prefix -> surface map in the i18n tooling, and
         the client's SatelliteResourceLanguages. Copied rather than located by walking up from the
         test binary, which is guesswork that breaks the moment the output layout changes. -->
    <None Include="..\tools\i18n\extract_untranslated.py" Link="i18n\extract_untranslated.py" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\SharpMUSH.Client\SharpMUSH.Client.csproj" Link="i18n\SharpMUSH.Client.csproj" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Inputs for MonoFontStackTests. The CJK font switch overrides one custom property, so it only
         works while every mono surface reads that property; a component naming a font directly opts
         itself out silently, which is how 24 of them were opted out before the switch existed. -->
    <None Include="..\SharpMUSH.Client\wwwroot\css\custom.css" Link="client\custom.css" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\SharpMUSH.Client\wwwroot\index.html" Link="client\index.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\SharpMUSH.Client\**\*.razor" Exclude="..\SharpMUSH.Client\bin\**;..\SharpMUSH.Client\obj\**"
          Link="client\razor\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\SharpMUSH.Client\**\*.razor.css" Exclude="..\SharpMUSH.Client\bin\**;..\SharpMUSH.Client\obj\**"
          Link="client\razor\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
