<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>default</LangVersion>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="ColorCode.Core" Version="2.0.15" />
		<PackageReference Include="Markdig" Version="1.3.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SharpMUSH.Library\SharpMUSH.Library.csproj" />
		<ProjectReference Include="..\SharpMUSH.Contracts\SharpMUSH.Contracts.csproj" />
		<PackageReference Include="MarkupString" Version="$(MarkupStringVersion)" />
		<PackageReference Include="MarkupString.Ansi" Version="$(MarkupStringVersion)" />
		<PackageReference Include="MarkupString.Html" Version="$(MarkupStringVersion)" />
	</ItemGroup>

</Project>
