{
  "title": "SharpMUSH function and command timings",
  "uid": "sharpmush-invocations",
  "tags": [
    "sharpmush"
  ],
  "timezone": "",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "top",
        "label": "Top",
        "type": "custom",
        "query": "5,10,15,25",
        "current": {
          "text": "10",
          "value": "10"
        },
        "options": [
          {
            "text": "5",
            "value": "5",
            "selected": false
          },
          {
            "text": "10",
            "value": "10",
            "selected": true
          },
          {
            "text": "15",
            "value": "15",
            "selected": false
          },
          {
            "text": "25",
            "value": "25",
            "selected": false
          }
        ]
      },
      {
        "name": "function",
        "label": "Function",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(sharpmush_function_invocation_duration_milliseconds_count, function_name)",
          "refId": "V"
        },
        "definition": "label_values(sharpmush_function_invocation_duration_milliseconds_count, function_name)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "command",
        "label": "Command",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(sharpmush_command_invocation_duration_milliseconds_count, command_name)",
          "refId": "V"
        },
        "definition": "label_values(sharpmush_command_invocation_duration_milliseconds_count, command_name)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Functions: p95 duration",
      "description": "95th percentile per call, own work only: arguments and nested calls are counted where they ran.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk($top, histogram_quantile(0.95, sum by (le, function_name) (rate(sharpmush_function_invocation_duration_milliseconds_bucket{function_name=~\"$function\"}[$__rate_interval]))))",
          "legendFormat": "{{function_name}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Functions: time spent per second",
      "description": "Milliseconds spent in each, per second of wall time: where the engine's time goes. Each millisecond is counted once, in the call that spent it.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk($top, sum by (function_name) (rate(sharpmush_function_invocation_duration_milliseconds_sum{function_name=~\"$function\"}[$__rate_interval])))",
          "legendFormat": "{{function_name}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Functions: calls per second",
      "description": "How often each is called.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk($top, sum by (function_name) (rate(sharpmush_function_invocation_duration_milliseconds_count{function_name=~\"$function\"}[$__rate_interval])))",
          "legendFormat": "{{function_name}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Functions: failed calls per second",
      "description": "Calls that errored, were refused, or hit a limit. (unknown) is a call to a function that does not exist.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk($top, sum by (function_name) (rate(sharpmush_function_invocation_duration_milliseconds_count{function_name=~\"$function\",success=\"false\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{function_name}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Commands: p95 duration",
      "description": "95th percentile per call, own work only: arguments and nested calls are counted where they ran.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk($top, histogram_quantile(0.95, sum by (le, command_name) (rate(sharpmush_command_invocation_duration_milliseconds_bucket{command_name=~\"$command\"}[$__rate_interval]))))",
          "legendFormat": "{{command_name}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Commands: time spent per second",
      "description": "Milliseconds spent in each, per second of wall time: where the engine's time goes. Each millisecond is counted once, in the call that spent it.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk($top, sum by (command_name) (rate(sharpmush_command_invocation_duration_milliseconds_sum{command_name=~\"$command\"}[$__rate_interval])))",
          "legendFormat": "{{command_name}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Commands: calls per second",
      "description": "How often each is called.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk($top, sum by (command_name) (rate(sharpmush_command_invocation_duration_milliseconds_count{command_name=~\"$command\"}[$__rate_interval])))",
          "legendFormat": "{{command_name}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Commands: failed calls per second",
      "description": "Commands that threw an error while running. A command refused before it runs (bad switch, permission denied) is not timed, and one that reports an error is counted as a success.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk($top, sum by (command_name) (rate(sharpmush_command_invocation_duration_milliseconds_count{command_name=~\"$command\",success=\"false\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{command_name}}"
        }
      ]
    }
  ]
}
