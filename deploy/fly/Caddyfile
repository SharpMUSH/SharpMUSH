# SharpMUSH's front door inside the all-in-one container (deploy/fly/Dockerfile). The host's proxy
# (Fly's or Railway's) ends TLS and hands plain HTTP to :8000. Reached directly at an address other
# than localhost, Caddy serves :8000 itself with a certificate from its own CA (start.sh sets
# SHARPMUSH_SITE and writes tls.caddy). Everything behind Caddy is on localhost.
{
	admin localhost:2019
	# Caddy runs as an unprivileged user: no :80 redirect listener, and its CA stays out of the
	# container's trust store.
	auto_https disable_redirects
	skip_install_trust
	default_sni {$SHARPMUSH_DEFAULT_SNI:localhost}
	servers {
		# Fly's proxy reaches the machine from a private address and names the client in X-Forwarded-For.
		# A host whose proxy comes from elsewhere sets SHARPMUSH_TRUSTED_PROXIES to its ranges.
		trusted_proxies static {$SHARPMUSH_TRUSTED_PROXIES:private_ranges}
	}
}

{$SHARPMUSH_SITE::8000} {
	import /data/state/tls/*.caddy
	encode zstd gzip

	route {
		# The first-boot guard, written by sharpmush-start and emptied once /setup is finished.
		import /data/state/guard/*.caddy

		@ws path /ws /ws/*
		handle @ws {
			reverse_proxy 127.0.0.1:4202 {
				header_up X-Forwarded-For {client_ip}
			}
		}

		# The game server: beside Caddy, or at its private address when it runs apart (start.sh).
		handle {
			reverse_proxy {$SHARPMUSH_SERVER_ADDRESS} {
				header_up X-Forwarded-For {client_ip}
			}
		}
	}
}
