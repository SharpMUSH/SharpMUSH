<Project>

  <!--
    The three MarkupString packages are cut from one repository, released together, and share a
    version by construction (https://github.com/SharpMUSH/MarkupString). Pinning that version in
    one place is what keeps the thirteen projects that reference them from drifting apart: a
    mismatched trio restores two copies of the core assembly and fails on the first render.
  -->
  <PropertyGroup>
    <MarkupStringVersion>2.1.0</MarkupStringVersion>
  </PropertyGroup>

  <!--
    TelnetNegotiationCore, for the same reason and after the same lesson: the three projects that
    referenced it each carried their own literal, and all three sat on 2.9.1 long after upstream
    reached 2.15.0 - so the MXP start-marker fix (2.16.0) had three places to be applied and no one
    place to look. One property, three references.
  -->
  <PropertyGroup>
    <TelnetNegotiationCoreVersion>2.16.0</TelnetNegotiationCoreVersion>
  </PropertyGroup>

</Project>
