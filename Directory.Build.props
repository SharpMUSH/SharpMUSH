<Project>

  <!--
    The three MarkupString packages are cut from one repository, released together, and share a
    version by construction (https://github.com/SharpMUSH/MarkupString). Pinning that version in
    one place is what keeps the projects that reference them from drifting apart: a mismatched set
    restores two copies of the core assembly and fails on the first render. MarkupString.Mxp and
    MarkupString.Pueblo are the same family, carried only by what renders those dialects.
  -->
  <PropertyGroup>
    <MarkupStringVersion>2.23.1</MarkupStringVersion>
  </PropertyGroup>

  <!--
    TelnetNegotiationCore, for the same reason and after the same lesson: the three projects that
    referenced it each carried their own literal, and all three sat on 2.9.1 long after upstream
    reached 2.15.0 - so the MXP start-marker fix (2.16.0) had three places to be applied and no one
    place to look. One property, three references.
  -->
  <PropertyGroup>
    <TelnetNegotiationCoreVersion>4.5.2</TelnetNegotiationCoreVersion>
  </PropertyGroup>

  <!--
    The Microsoft.AspNetCore.*, Microsoft.Extensions.*, Microsoft.Data.Sqlite and
    System.Configuration.ConfigurationManager packages ship with the runtime and share its version.
    They move with global.json's SDK: a package a release behind the shared framework the app runs
    on is the NU1605 downgrade that fails every project under TreatWarningsAsErrors.
  -->
  <PropertyGroup>
    <DotNetPackageVersion>11.0.0-rc.2.26504.105</DotNetPackageVersion>
  </PropertyGroup>

  <!--
    The engine's version: what version(), numversion(), @version, MSSP's CODEBASE and a package's
    requires_server/maximum_server checks see. It is the release the tree is heading for, and the
    release tag overrides it (docker-publish.yml passes the tag's version as -p:SharpMUSHVersion).
    It is not the plugin contract version (PluginContractVersion, the SharpMUSH.Library and
    SharpMUSH.Implementation.Generated packages), which moves only when that contract changes.
    Bump it with the next CHANGELOG.md section.
  -->
  <PropertyGroup>
    <SharpMUSHVersion Condition="'$(SharpMUSHVersion)' == ''">1.0.0</SharpMUSHVersion>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="SharpMUSHVersion" />
  </ItemGroup>

  <!-- Keep the runner, assertions, generators, and ASP.NET integration on one release. -->
  <PropertyGroup>
    <TUnitVersion>1.66.27</TUnitVersion>
  </PropertyGroup>

</Project>
