<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>default</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Serves no browser assets. Without this the .NET 11 rc.2 Web SDK adds a dotnet-watch JS
         initializer, and a Web project referencing this one fails with "scoped css bundles do not
         have matching endpoints". -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MarkupString" Version="$(MarkupStringVersion)" />
    <PackageReference Include="MarkupString.Ansi" Version="$(MarkupStringVersion)" />
    <PackageReference Include="MarkupString.Html" Version="$(MarkupStringVersion)" />
    <PackageReference Include="MarkupString.Mxp" Version="$(MarkupStringVersion)" />
    <PackageReference Include="MarkupString.Pueblo" Version="$(MarkupStringVersion)" />
    <PackageReference Include="OpenTelemetry.Api" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.20.1-beta.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.2" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.ResourceDetectors.Container" Version="1.0.0-beta.7" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="TelnetNegotiationCore" Version="$(TelnetNegotiationCoreVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharpMUSH.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpMUSH.Messaging\SharpMUSH.Messaging.csproj" />
    <ProjectReference Include="..\SharpMUSH.Contracts\SharpMUSH.Contracts.csproj" />
  </ItemGroup>

  <!--
    Published ahead of time to a native binary (see the Dockerfile): it starts in a fraction of a second and
    holds no JIT. A build or a test run is still JIT; PublishAot turns on the trim and AOT analyzers there too,
    and TreatWarningsAsErrors makes any new warning from them, or from the native publish, an error.
  -->
  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <!-- The .dbg symbols are four times the binary; an image has no use for them. -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
  <ItemGroup>
    <!-- Testcontainers is reflection-based: published, the native binary leaves it out (NatsStrategyProvider); a
         build still starts a NATS container when NATS_URL is unset. -->
    <RuntimeHostConfigurationOption Include="SharpMUSH.Messaging.NatsTestContainers" Value="false" Trim="true"
      Condition="'$(_IsPublishing)' == 'true'" />
  </ItemGroup>
</Project>
