<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>default</LangVersion>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>

  <ItemGroup>
    <!-- IsRetryableConflict gates both retry and log level; the tests pin its message matching. -->
    <InternalsVisibleTo Include="SharpMUSH.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SurrealDb.Embedded.InMemory" Version="1.0.0" />
    <PackageReference Include="SurrealDb.Embedded.RocksDb" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpMUSH.Database\SharpMUSH.Database.csproj" />
    <ProjectReference Include="..\SharpMUSH.Contracts\SharpMUSH.Contracts.csproj" />
  </ItemGroup>

</Project>
