{
  "name": "sharpmush-language",
  "displayName": "SharpMUSH Language Support",
  "description": "Language support for SharpMUSH MUSH code with syntax highlighting and error checking",
  "version": "0.1.0",
  "publisher": "sharpmush",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "mush",
    "sharpmush",
    "mud",
    "game development"
  ],
  "activationEvents": [
    "onLanguage:mush",
    "onCommand:sharpmush.setRemoteCredentials",
    "onCommand:sharpmush.clearRemoteCredentials"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "mush",
        "extensions": [
          ".mush",
          ".mu",
          ".mushfn",
          ".fun",
          ".mushcmd"
        ],
        "aliases": [
          "MUSH",
          "mush"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mush",
        "scopeName": "source.mush",
        "path": "./syntaxes/mush.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "SharpMUSH",
      "properties": {
        "sharpmush.languageServer.path": {
          "type": "string",
          "default": "",
          "description": "Path to SharpMUSH.LanguageServer.dll (leave empty for auto-detect)"
        },
        "sharpmush.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the language server"
        },
        "sharpmush.languageServer.mode": {
          "type": "string",
          "enum": [
            "offline",
            "remote"
          ],
          "default": "offline",
          "description": "Offline stdio analysis or authenticated remote LSP."
        },
        "sharpmush.languageServer.bridgePath": {
          "type": "string",
          "default": "",
          "description": "Path to SharpMUSH.LspBridge.dll for remote mode."
        },
        "sharpmush.languageServer.endpoint": {
          "type": "string",
          "default": "",
          "description": "WSS remote LSP endpoint, without credentials or query."
        }
      }
    },
    "commands": [
      {
        "command": "sharpmush.setRemoteCredentials",
        "title": "SharpMUSH: Set Remote Credentials"
      },
      {
        "command": "sharpmush.clearRemoteCredentials",
        "title": "SharpMUSH: Clear Remote Credentials"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "test": "npm run compile && node tests/launch.cjs"
  },
  "dependencies": {
    "vscode-languageclient": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^18.x",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SharpMUSH/SharpMUSH.git",
    "directory": "SharpMUSH.LanguageServer/vscode-extension-example"
  }
}
