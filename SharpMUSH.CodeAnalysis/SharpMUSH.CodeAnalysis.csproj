<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>default</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpMUSH.Library\SharpMUSH.Library.csproj" />
    <ProjectReference Include="..\SharpMUSH.Implementation\SharpMUSH.Implementation.csproj" />
    <PackageReference Include="MarkupString" Version="$(MarkupStringVersion)" />
    <PackageReference Include="MarkupString.Ansi" Version="$(MarkupStringVersion)" />
    <PackageReference Include="MarkupString.Html" Version="$(MarkupStringVersion)" />
    <!-- SharpMUSH.Library compiles against the Caching.Memory in the ASP.NET shared framework, which it
         references with PrivateAssets="all", so restore prunes the package from Library's closure. This
         project (and the LanguageServer through it) has no shared framework to supply it, and would
         otherwise resolve FusionCache's 10.x floor against a Library built for 11.x. -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="$(DotNetPackageVersion)" />
  </ItemGroup>

</Project>
