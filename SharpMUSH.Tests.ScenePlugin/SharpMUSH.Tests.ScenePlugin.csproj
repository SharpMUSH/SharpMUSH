<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <RollForward>LatestMajor</RollForward>
    <NoWarn>TUnit0038</NoWarn>
  </PropertyGroup>

  <!-- SceneControllerVisibilityTests drives the plugin's MVC controller directly (ControllerContext +
       DefaultHttpContext), which needs the ASP.NET Core shared framework. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="TUnit" Version="1.19.16" />
  </ItemGroup>

  <!-- Focused unit test for the Scene plugin's AddSceneSystem registration seam (Phase 8). References the
       plugin and Library WITHOUT touching SharpMUSH.Implementation, so the plugin's generated VersionInfo
       does not collide with the engine's. Storage regressions use the pinned embedded SurrealDB provider. -->
  <ItemGroup>
    <ProjectReference Include="..\SharpMUSH.Plugins.Scene\SharpMUSH.Plugins.Scene.csproj" />
    <ProjectReference Include="..\SharpMUSH.Library\SharpMUSH.Library.csproj" />
    <ProjectReference Include="..\SharpMUSH.Database.SurrealDB\SharpMUSH.Database.SurrealDB.csproj" />
  </ItemGroup>

</Project>
