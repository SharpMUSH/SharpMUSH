<Project Sdk="Microsoft.NET.Sdk">

	<!-- The World plugin's public surface: the map, place and room records, and IWorldMaps.
	     A plugin that builds on the World plugin references this alone and never the
	     implementation; at run time the copy shipped in plugins/world/ is shared into it by the loader. -->
	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>default</LangVersion>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<RootNamespace>SharpMUSH.Plugins.World</RootNamespace>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IsPackable>true</IsPackable>
		<PackageId>SharpMUSH.Plugins.World.Abstractions</PackageId>
		<!-- Its own version, not the plugin contract's: it moves with the World plugin's surface. -->
		<Version>1.0.0</Version>
		<Description>Read access to the SharpMUSH World plugin's stored maps, for plugins that build on the World plugin.</Description>
	</PropertyGroup>

	<ItemGroup>
		<!-- Host-owned at run time, as in the World plugin itself. -->
		<ProjectReference Include="..\SharpMUSH.Library\SharpMUSH.Library.csproj">
			<Private>false</Private>
			<ExcludeAssets>runtime</ExcludeAssets>
		</ProjectReference>
		<!-- Bundled inside the SharpMUSH.Library package, so not a package dependency of its own. -->
		<ProjectReference Include="..\SharpMUSH.Contracts\SharpMUSH.Contracts.csproj">
			<Private>false</Private>
			<ExcludeAssets>runtime</ExcludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</ProjectReference>
	</ItemGroup>

</Project>
