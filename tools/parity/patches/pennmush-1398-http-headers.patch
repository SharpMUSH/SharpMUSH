+int
+comp_gencomp(dbref executor, char *left, char *right, const char *type)
+{
+  int c;
+  c = gencomp(executor, left, right, type);
+  return (c > 0 ? 1 : (c < 0 ? -1 : 0)) * sort_order;
+}
