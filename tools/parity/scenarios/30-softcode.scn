# Softcode: evaluation, math, strings, lists, control flow, registers, attributes.
::case sc.login
::login wiz Wiz wizpass
think ok

::case sc.math  arithmetic and comparison
think [add(1,2,3)] [sub(10,4)] [mul(2,3,4)] [div(7,2)] [fdiv(7,2)] [mod(-7,3)] [remainder(-7,3)]
think [inc(5)] [dec(5)] [abs(-3)] [sign(-9)] [max(1,9,3)] [min(4,2,8)] [power(2,10)] [sqrt(16)]
think [round(3.14159,2)] [floor(-1.5)] [ceil(-1.5)] [trunc(-1.5)] [bound(15,1,10)]
think [eq(1,1.0)] [gt(2,1)] [lte(3,3)] [cand(1,0)] [cor(0,1)] [not(0)] [xor(1,1)]
think [add(1,foo)] [div(1,0)] [sqrt(-1)]

::case sc.strings  string functions
think [strlen(hello)] [mid(abcdef,1,3)] [left(abcdef,2)] [right(abcdef,2)] [reverse(abc)] [repeat(ab,3)]
think [upcstr(abc)] [lcstr(ABC)] [capstr(abc def)] [trim(  a b  )] [trim(xxaxx,x,b)]
think [pos(c,abcd)] [strmatch(hello,h*o)] [match(a b c,b)] [comp(a,b)] [ljust(a,3)]|[rjust(a,3)]|[center(a,5)]
think [edit(banana,a,A)] [replace(a b c,2,X)] [delete(abcdef,1,2)] [squish(a   b)] [escape(a[b])]
think [before(a-b-c,-)] [after(a-b-c,-)] [wrap(aaa bbb ccc,5)]

::case sc.lists  list functions
think [words(a b c)] [first(a b c)] [rest(a b c)] [last(a b c)] [extract(a b c d,2,2)]
think [sort(c a b)] [sort(10 9 100,n)] [sortby(#lambda/comp(%%0,%%1),c b a)] [setunion(a b,b c)] [setinter(a b,b c)] [setdiff(a b,b c)]
think [lnum(5)] [lnum(2,4)] [revwords(a b c)] [remove(a b c,b)] [member(a b c,c)] [splice(a b c,x y z,b)]
think [iter(a b c,##-#@)] [map(#lambda/strlen(%%0),aa b cccc)] [fold(#lambda/add(%%0,%%1),1 2 3)] [filter(#lambda/gt(%%0,1),0 1 2 3)]
think [itemize(a b c)] [elements(a b c d,2 4)] [ldelete(a b c,2)] [insert(a b c,2,X)]

::case sc.splice  splice() swaps in the second list's word wherever the first list's word is <word> (#1383)
think [splice(foo bar baz,eek moof gleep,bar)] [splice(b a b,x y z,b)] [splice(a b c,x y z,B)] [splice(a|b|c,x|y|z,c,|)]
think [splice(a b c,x y z,)] [splice(a|b|c,x|y|z,a|b,|)] [splice(a b c,x y,b)]

::case sc.lsearch  lsearch() answers with dbrefs, not objids (#1409)
think [lsearch(*Alice,type,player)] [strmatch(lsearch(*Alice,type,player),num(*Alice))] [nlsearch(*Alice,type,player)]

::case sc.control  switch, if, registers, evaluation order
think [if(1,yes,no)] [if(0,yes,no)] [ifelse(,a,b)] [switch(2,1,one,2,two,other)] [case(3,1,x,3,y)]
think [setq(0,hi)][r(0)] [setr(1,there)] [r(1)] [%q0 %q1]
think [null(x)][s(%b)] [lit([add(1,2)])] [eval(add(1,2))]
think [ulambda(#lambda/add(%%0,1),5)]
think [setq(0,outer)][ulocal(#lambda/setq(0,inner)%%q0,x)] [r(0)]
@dolist a b c=think item ##
::settle
think [t()] [t(0)] [t(00)] [t(a)] [t(#-1)] [isnum(1.5)] [isint(1.5)] [isdbref(#1)]

::case sc.itertokens  ## and #@ name the loop they are written in, not one a called attribute runs in (#1827)
# The inner @dolist is inline: a second queued level reaches the two servers' output in different steps.
&ITOK me=##:#@
&ILOOP me=iter(x y,#@:##)
think [iter(a b,u(me/ITOK))] [iter(a b,u(me/ILOOP))] [iter(a b,iter(x y,#@:##))]
think [iter(a b,#1 x#)] ##:#@
@dolist a b=@dolist/inline x y=think nested ##
::settle
&ITOK me
&ILOOP me

::case sc.switchsubject  #$ is the subject of the outermost switch whose action it is written in, text elsewhere
&SWSHOW me=#$
&SWOWN me=switch(z,*,#$)
think [switch(moof,*a*,foo,#$)] [switchall(abc,a*,#$,*c,-#$)] [reswitch(abc,^a,#$)]
think [switch(a,*,switch(b,*,#$))] [switch(b,*,switch(b,#$,x,y))] [switch(a,*,case(b,b,#$))] [iter(x y,switch(##,*,#$))]
think [switch(a,*,u(me/SWSHOW))] [switch(a,*,u(me/SWOWN))] [switch(abc,#$,yes,no)] #$
@switch/inline outer=*,{@switch/inline inner=*,{think nested #$ %$0}}
@select queued=q*,think queued #$
::settle
&SWSHOW me
&SWOWN me

::case sc.subjectcaseif  #$ in case() and if(): text in PennMUSH, the subject or condition in SharpMUSH; a switch() still wins
think [case(moof,moof,#$)] [caseall(ab,ab,#$)] [if(abc,#$)] [ifelse(0,x,#$)] [switch(a,*,if(1,%$0 [slev()]))]
think [switch(a,*,case(b,b,#$))] [case(a,a,switch(b,*,#$))] [if(1,switch(b,*,#$))] [switch(a,*,if(1,#$))]

::case sc.tokenbinding  with loops and switches nested in each other, ## #@ #$ name the outermost (innermost_tokens off)
think [iter(a b,##[iter(x,##)])] [iter(a b,iter(##,##))] [switch(a,*,iter(x y,#$##))] [iter(a b,switch(c,*,switch(d,*,###$)))]
@dolist a b=think dol [iter(x y,##:#@)]
@dolist/inline a b=@switch/inline s=*,think dolsw ##:#$
@switch/inline o=*,@dolist/inline x y=think swdol #$:##
::settle

::case sc.attrs  attribute functions on the fixture object
think [get([first(lcon(*Alice))]/COLOR)]
think [name(first(lcon(*Alice)))] [type(first(lcon(*Alice)))] [owner(first(lcon(*Alice)))=owner(*Alice)]
think [hasattr(first(lcon(*Alice)),COLOR)] [hasattr(first(lcon(*Alice)),NOPE)]
think [lattr(first(lcon(*Alice)))]
think [xget(first(lcon(*Alice)),SIZE)] [grep(first(lcon(*Alice)),*,lu)]
think [u(first(lcon(*Alice))/GREET,Bob)]

::case sc.identity  who-am-I substitutions
think %n %# %! %l %0 [name(%#)]
think [name(%!)] [hasflag(%#,WIZARD)] [flags()] [type(%#)]

::case sc.errors  error strings
think [nosuchfunction(1)]
think [add()] [strlen()] [mid(abc)]
think [get(nothing/nothing)] [name(#9999)] [loc(#9999)]

::case sc.wshtml-default  wshtml() takes PennMUSH's <default string> (#1282)
think [wshtml(<b>x</b>,x)]
@pemit me=[wshtml(<b>x</b>,x)] and more

::case sc.coverage-gaps  functions no SharpMUSH.Tests case dispatched until #974
think [art(apple)] [art(banana)] [art(Egg)] [art(unicorn)] [art(hour)] [art(8)]
think [ordinal(1)] [ordinal(2)] [ordinal(3)] [ordinal(4)] [ordinal(11)] [ordinal(12)] [ordinal(21)] [ordinal(100)] [ordinal(0)] [ordinal(-1)] [ordinal(abc)]
think [floor(2.7)] [floor(-2.7)] [floor(3)] [floor(abc)]
think [pos(b,abc)] [pos(bc,abcbc)] [pos(z,abc)] [pos(,abc)]
think [bound(5,1,10)] [bound(-5,1,10)] [bound(15,1)] [bound(1.5,1,2)]
think [player(first(ports(me)))=num(me)] [player(-1)] [player(abc)]
# The Widget is parented to the Lab for two steps and put back, so later cases see the world unchanged.
think [parent(first(lcon(*Alice)),loc(*Alice))]
think [lparent(first(lcon(*Alice)))] [lparent(loc(*Alice))] [children(loc(*Alice))]
think [children(first(lcon(*Alice)))]
think [parent(first(lcon(*Alice)),none)] [lparent(first(lcon(*Alice)))]

::case sc.objeval  objeval() evaluates its object argument, and falls back to the executor when it cannot use it
think [objeval([loc(*Alice)],add(1,2))] [strmatch(objeval(#[add(0,1)],num(me)),#1)]
think [strmatch(objeval(#99999999,num(me)),num(me))]
::login bob Bob bobpass
::as bob
think [strmatch(objeval(*Wiz,num(me)),num(me))] [objeval(*Wiz,setr(ov,ran))-[r(ov)]]
::logout bob

::case sc.piped-output  %> is the last command's output here; PennMUSH has no such substitution and prints >
::as wiz
think a%>b
think a>b

::case sc.printed-output  %| is piped output here (TinyMUX ;|); PennMUSH has no such substitution and prints |
::as wiz
think a%|b
think a|b

::case sc.empty-bracket  an empty [] evaluates to nothing
::as wiz
think a[]b|[strcat(x,[],y)]|[]

::case sc.skip  @skip runs its action list only when the condition is false; @skip/ifelse is @if
::as wiz
@skip 1=think skip-1 ran
@skip abc=think skip-abc ran
@skip 0=think skip-0 ran
@skip #-1 NO MATCH=think skip-nomatch ran
@skip =think skip-empty ran
@skip 0=think first,think second
@skip 0
@skip/ifelse 1=think ifelse-true,think ifelse-false
@skip/ifelse 0=think ifelse-true,think ifelse-false
@skip/ifelse 0=think ifelse-only-true

::case sc.trailing-percent  a % at the end of the text is a literal %; a \ there is dropped when evaluated and kept when stored
::as wiz
think 50%
say 50%
think 50%% x
think %
think a\
&TRAILPCT me=50%
&TRAILBS me=a\
think [get(me/TRAILPCT)] [u(me/TRAILPCT)] [get(me/TRAILBS)] [u(me/TRAILBS)]

::case sc.gender-first-letter  only the first letter of SEX picks the pronoun: M male, F/W female, T/P plural (get_gender, src/funstr.c)
::as wiz
@sex me=m
think [subj(me)] [obj(me)] [poss(me)] [aposs(me)]
@sex me=Male
think [subj(me)] [obj(me)] [poss(me)] [aposs(me)]
@sex me=f
think [subj(me)] [obj(me)] [poss(me)] [aposs(me)]
@sex me=woman
think [subj(me)] [obj(me)] [poss(me)] [aposs(me)]
@sex me=plural
think [subj(me)] [obj(me)] [poss(me)] [aposs(me)]
@sex me=t
think [subj(me)] [obj(me)] [poss(me)] [aposs(me)]
@sex me=male
think %s %o %p %a %S
@sex me=woman
think %s %o %p %a %S
@sex me=
