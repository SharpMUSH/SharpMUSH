<Project Sdk="Microsoft.NET.Sdk">

	<!-- Writes the general help as the game serves it, plugin help and listings included, for the documentation
	     sites. The help-export workflow runs it on main and publishes the result to the help-export branch. -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<RootNamespace>SharpMUSH.Tools.HelpExport</RootNamespace>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\SharpMUSH.Documentation\SharpMUSH.Documentation.csproj" />
	</ItemGroup>

</Project>
