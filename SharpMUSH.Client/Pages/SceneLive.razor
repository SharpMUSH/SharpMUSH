@page "/scenes/{Id}/live"
@attribute [Authorize]
@using System.Text.Json
@using SharpMUSH.Client.Components.Scenes
@using SharpMUSH.Client.Models
@using SharpMUSH.Library.Models.Portal
@using SharpMUSH.Library.Services.Interfaces
@inject IStringLocalizer<SharedResource> Loc
@inject SceneService SceneService
@inject IConnectionStateService Hub
@inject ITerminalService Terminal
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@Loc["RolLiveScene"] — @Loc["AppTitle"]</PageTitle>

@* Nothing to watch on a game with the Scene System off: say so instead of failing to load. *@
<FeatureGate Feature="@GameFeatures.Scenes">
<ChildContent>

@if (_loading)
{
    <div style="padding:var(--cpad);">
        <MudProgressLinear Indeterminate="true" />
    </div>
}
else if (_error is not null)
{
    <div style="padding:var(--cpad);">
        <MudAlert Severity="Severity.Error" Class="scene-load-error">@_error</MudAlert>
        <MudButton Href="/scenes/active" Color="Color.Primary" Variant="Variant.Text" Class="mt-2">
            @Loc["RolBackToActiveScenes"]
        </MudButton>
    </div>
}
else if (_notFound)
{
    <div style="padding:var(--cpad);">
        <MudAlert Severity="Severity.Warning">@Loc["RolSceneNotFound"]</MudAlert>
        <MudButton Href="/scenes/active" Color="Color.Primary" Variant="Variant.Text" Class="mt-2">
            @Loc["RolBackToActiveScenes"]
        </MudButton>
    </div>
}
else
{
    var scene = _scene!;
    <div class="scene-live-page full-height">

        <header class="scene-live-header">
            <div class="scene-live-heading">
                <div class="scene-live-kicker">
                    @if (scene.IsLive)
                    {
                        <Pill Tag="true" Dot="var(--accent)" Class="scene-live-status">@Loc["RolLiveBadge"]</Pill>
                    }
                    else if (scene.IsPaused)
                    {
                        <Pill Tag="true" Class="scene-live-status">@Loc["RolPausedBadge"]</Pill>
                    }
                    <span class="scene-live-room">
                        <MudIcon Icon="@Icons.Material.Outlined.Place" Style="font-size:15px;" />@scene.RoomName
                    </span>
                    <span class="scene-live-dot" aria-hidden="true">·</span>
                    <span>@Loc.Plural("RolPoseCount", "count", scene.PoseCount)</span>
                </div>
                <h1 class="scene-live-title">@SceneTitle(scene)</h1>
            </div>
            <CapsuleButton Class="scene-live-archive" Icon="@Icons.Material.Outlined.MenuBook" Href="@($"/scenes/{Uri.EscapeDataString(Id)}")"
                           AriaLabel="@Loc["RolViewArchive"]"><span class="scene-live-archive-label">@Loc["RolViewArchive"]</span></CapsuleButton>
        </header>

        @if (_liveUnavailable)
        {
            <div class="scene-live-banner" role="status">@Loc["RolSceneLiveUnavailable"]</div>
        }
        else if (!Terminal.IsConnected)
        {
            @* Each banner is gated on the connection whose loss it actually describes. The two are
               separate transports: posting goes over the terminal socket, live poses arrive on the hub.
               Gating both on one predicate — the tempting simplification — would disable a Send button
               that works whenever the live feed alone is down. What was wrong was the wording: this
               message says you cannot post, and it was shown for a hub outage, which does not stop
               posting at all. *@
            <div class="scene-live-banner" role="status">@Loc["RolNotConnected"]</div>
        }
        else if (!Hub.IsConnected)
        {
            <div class="scene-live-banner" role="status">@Loc["RolSceneLiveFeedDown"]</div>
        }

        @* column-reverse keeps the story at its newest pose as poses arrive, as Play's does. *@
        <div class="scene-live-scroll">
            <div class="scene-live-story">
                <SceneStory SceneId="@Id" ViewerName="@Terminal.ConnectedPlayerName" LiveUnavailableChanged="OnLiveUnavailable"
                            OnEditPose="EditPoseAsync" />
            </div>
        </div>

        @if (scene.IsLive)
        {
            <div class="scene-live-compose @(_mode == Ooc ? "scene-live-compose--ooc" : null)">
                <div class="scene-live-card">
                    <div class="scene-live-bar">
                        <TypeChips Items="_modes" Selected="@_mode" SelectedChanged="OnModeChanged" AriaLabel="@Loc["RolComposeMode"]" />
                        @if (_field is not null)
                        {
                            <FormatMenu Target="_field" ButtonClass="scene-live-tool" OnRawChanged="raw => _draft.SetRaw(raw)" />
                        }
                    </div>
                    @* A FormattedInput, as in Play: the pose is written as styled text (the format menu colours a
                       selection) and sent as decompose() writes it, or as softcode with the menu's switch. Plain
                       Enter is a new line, not Send: a pose is prose, composed over several lines and edited before
                       it goes out. Ctrl/⌘+Enter sends, which inserts nothing in a textarea. *@
                    <FormattedInput @ref="_field" Draft="_draft" Class="scene-live-field" InputClass="scene-live-input" Rows="3"
                                    Placeholder="@Placeholder" AriaLabel="@($"{Loc["RolComposeMode"]}: {Label(_mode)}")"
                                    OnKeyDown="OnKeyDownAsync" OnRawRequested="() => _draft.SetRaw(true)" />
                    <div class="scene-live-foot">
                        <span class="scene-live-hint">@Loc["RolComposeSendHint"]</span>
                        <button type="button" class="scene-live-send" disabled="@(!CanSend)" @onclick="SendPoseAsync">
                            <MudIcon Icon="@Icons.Material.Filled.Send" Style="font-size:16px;" /><span>@Loc["Send"]</span>
                        </button>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="scene-live-closed" role="status">@(scene.IsPaused ? Loc["RolComposePaused"] : Loc["RolComposeNotRunning"])</div>
        }
    </div>
}
</ChildContent>
<Otherwise><ScenesNotEnabled /></Otherwise>
</FeatureGate>

@code {
    [Parameter] public required string Id { get; set; }

    private SceneSummary? _scene;
    private bool _loading = true;
    private bool _notFound;

    /// <summary>
    /// The scene hub refused the live subscription (SceneStory reports it): the archive still shows, but
    /// this connection is not in the scene's group, so nothing posted from here would come back.
    /// </summary>
    private bool _liveUnavailable;

    /// <summary>Why the scene could not be read, for any failure but 404 — which is <see cref="_notFound"/>.</summary>
    private string? _error;

    private readonly ComposerDraft _draft = new();
    private FormattedInput? _field;
    private FormattedInput? _menuFor;
    private ComposerDraft? _watched;

    /// <summary>Send's state follows the draft, which the field changes without this component rendering.</summary>
    private void Watch(ComposerDraft draft)
    {
        if (ReferenceEquals(_watched, draft)) return;
        if (_watched is not null) _watched.Changed -= OnDraftChanged;
        _watched = draft;
        draft.Changed += OnDraftChanged;
    }

    private void OnDraftChanged()
    {
        _ = SaveDraftAsync();
        _ = InvokeAsync(StateHasChanged);
    }

    protected override void OnInitialized()
    {
        _modes = [(Emit, Label(Emit)), (Pose, Label(Pose)), (Semipose, Label(Semipose)), (Say, Label(Say)), (Ooc, Label(Ooc))];
        Watch(_draft);
    }

    /// <summary>
    /// The format menu needs the field, which exists only once it has rendered: render again for it. The kept
    /// draft is read once the field is there to show it.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_field is not null) await LoadDraftAsync();
        if (_field == _menuFor) return;
        _menuFor = _field;
        if (_field is not null) StateHasChanged();
    }
    private const string Emit = "emit";
    private const string Pose = "pose";
    private const string Semipose = "semipose";
    private const string Say = "say";
    private const string Ooc = "ooc";

    // Emit by default: it renders the author's words verbatim, with no name glued to the front.
    // That is what a compose box on one scene's own page is for — the other modes stay available
    // for the times a player wants the built-in framing, or to step out of character.
    private string _mode = Emit;

    private IReadOnlyList<(string Key, string Label)> _modes = [];

    private bool CanSend => !_draft.IsEmpty && Terminal.IsConnected && !_liveUnavailable;

    private string Label(string mode) => mode switch
    {
        Pose => Loc["RolModePose"],
        Semipose => Loc["RolModeSemipose"],
        Say => Loc["RolModeSay"],
        Ooc => Loc["NavPlayTypeOoc"],
        _ => Loc["RolModeEmit"],
    };

    private string Placeholder => _mode switch
    {
        Pose => Loc["RolComposePlaceholderPose"],
        Semipose => Loc["RolComposePlaceholderSemipose"],
        Say => Loc["NavPlayPlaceholderSay"],
        Ooc => Loc["NavPlayPlaceholderOoc"],
        _ => Loc["NavPlayPlaceholderEmit"],
    };

    private Task OnModeChanged(string mode)
    {
        _mode = mode;
        return SaveDraftAsync();
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && (e.CtrlKey || e.MetaKey)) await SendPoseAsync();
    }

    /// <summary>An edit to the viewer's own pose: the scene package's whole-text edit, as Play sends it.</summary>
    private Task EditPoseAsync((string PoseId, string Text) edit) =>
        Terminal.SendAsync($"+scene/rewrite {edit.PoseId}={MushComposeEncoder.Encode(edit.Text)}");

    /// <summary>Where this scene's unsent pose and mode are kept, so a reload or a wander away loses neither.</summary>
    private string DraftKey => $"scene.draft.{Id}";

    /// <summary>A kept draft: the mode, the text, and when it was styled, the styled text (a serialized MString).</summary>
    private sealed record Draft(string Mode, string Text, string? Markup = null);

    private string? _loadedKey;
    private bool _reading;

    private async Task SaveDraftAsync()
    {
        if (_reading || _loadedKey != DraftKey) return;
        if (_draft.Value.Length == 0 && _mode == Emit)
        {
            await JS.RemoveItemAsync(BrowserStore.Local, DraftKey);
            return;
        }
        var markup = !_draft.Raw && !_draft.Text.Runs.IsDefaultOrEmpty ? MarkupTextSerializer.Serialize(_draft.Text) : null;
        await JS.SetItemAsync(BrowserStore.Local, DraftKey, JsonSerializer.Serialize(new Draft(_mode, _draft.Value, markup)));
    }

    /// <summary>Reads this scene's kept draft once, unless something was typed before it could be.</summary>
    private async Task LoadDraftAsync()
    {
        if (_loadedKey == DraftKey) return;
        // Another scene's page in the same component: its draft is already kept under its own key.
        var switched = _loadedKey is not null;
        _loadedKey = DraftKey;
        if (switched)
        {
            _reading = true;
            _mode = Emit;
            _draft.Clear();
            _reading = false;
            StateHasChanged();
        }
        else if (_draft.Value.Length > 0)
        {
            return;
        }
        if (await JS.GetItemAsync(BrowserStore.Local, DraftKey) is not { Length: > 0 } json) return;
        try
        {
            if (JsonSerializer.Deserialize<Draft>(json) is not { } draft) return;
            _reading = true;
            _mode = _modes.Any(m => m.Key == draft.Mode) ? draft.Mode : Emit;
            _draft.Load(Styled(draft) ?? MarkupText.Plain(draft.Text ?? string.Empty), _draft.Raw);
            StateHasChanged();
        }
        catch (JsonException)
        {
            // Not a draft this page wrote: start empty.
        }
        finally
        {
            _reading = false;
        }
    }

    /// <summary>The kept styled text, when there is one and it still reads.</summary>
    private static MarkupText? Styled(Draft draft)
    {
        if (draft.Markup is not { Length: > 0 } markup) return null;
        try
        {
            var text = MarkupTextSerializer.Deserialize(markup);
            return text.Text == draft.Text ? text : null;
        }
        catch (JsonException)
        {
            return null;
        }
    }

    public void Dispose()
    {
        if (_watched is not null) _watched.Changed -= OnDraftChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _notFound = false;
        _liveUnavailable = false;
        _error = null;
        _scene = null;

        // A scene that does not exist and one that exists but is not visible to this caller BOTH land here,
        // and both must render the one _notFound card. The REST route answers 404 to both for that reason,
        // and the hub throws one message for both — a refusal a caller can tell apart is a way to enumerate
        // private scene ids. Any future edit that wants to explain a not-found must keep those two cases
        // sharing an answer.
        // Only a 404 is that answer. Any other failure is the server failing to answer at all, and the
        // not-found card would turn an outage into a claim that the scene is gone.
        switch (await SceneService.GetSceneAsync(Id))
        {
            case SceneSummary scene:
                _scene = scene;
                break;
            case ApiFailure { Kind: ApiFailureKind.NotFound }:
                _notFound = true;
                break;
            case ApiFailure failure:
                _error = failure.Message;
                break;
        }

        _loading = false;
    }

    private void OnLiveUnavailable(bool unavailable) => _liveUnavailable = unavailable;

    private async Task SendPoseAsync()
    {
        // _liveUnavailable means this connection is not in the scene's group. Nothing renders a pose but the
        // round-trip event, so posting from here would look like the command vanished.
        if (!CanSend) return;

        // The text itself is NOT trimmed. A pose that opens on an indent or a blank line means it,
        // and trimming here threw that away before the encoder could protect it — leading whitespace
        // was the one kind that could never reach the archive.
        //
        // The scene is named rather than inferred: the room-based verbs record through capture hooks
        // that only fire for the scene you are focused on, in the room you are standing in.
        //
        // The draft's softcode spells the whitespace out as substitutions (%b/%t/%r) and neutralises the
        // command separator; without that the parser compressed every run of spaces, dropped the ones at
        // a line's edges, and cut the pose short at the first semicolon. Styled text also has its colours
        // written as ansi() and every other special escaped, so it arrives as shown.
        var command = $"+scene/{_mode} {Id}={_draft.ToSoftcode()[0]}";

        _draft.Clear();

        // Down the terminal websocket, already open as this character; the hub is for RECEIVING the
        // pose back.
        await Terminal.SendAsync(command);
    }

    private string SceneTitle(SceneSummary s) =>
        s.Meta.TryGetValue("title", out var t) && !string.IsNullOrWhiteSpace(t)
            ? t
            : Loc["RolSceneIn", s.RoomName];
}
