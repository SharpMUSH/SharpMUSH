@page "/scenes/{Id}/live"
@attribute [Authorize]
@implements IAsyncDisposable
@using Microsoft.AspNetCore.SignalR
@using SharpMUSH.Client.Models
@using SharpMUSH.Library.Models.Portal
@using SharpMUSH.Library.Services.Interfaces
@inject IStringLocalizer<SharedResource> Loc
@inject SceneService SceneService
@inject IConnectionStateService Hub
@inject ITerminalService Terminal
@inject ISceneHubControl SceneHub

<PageTitle>@Loc["RolLiveScene"] — @Loc["AppTitle"]</PageTitle>

@if (_loading)
{
    <div style="padding:var(--cpad);">
        <MudProgressLinear Indeterminate="true" />
    </div>
}
else if (_notFound)
{
    <div style="padding:var(--cpad);">
        <MudAlert Severity="Severity.Warning">@Loc["RolSceneNotFound"]</MudAlert>
        <MudButton Href="/scenes/active" Color="Color.Primary" Variant="Variant.Text" Class="mt-2">
            @Loc["RolBackToActiveScenes"]
        </MudButton>
    </div>
}
else
{
    <div class="scene-live-page full-bleed full-height" style="display:flex;flex-direction:column;height:100%;">

        <div class="scene-live-header">
            <MudChip T="string" Color="Color.Success" Size="Size.Small"
                     Style="font-size:0.625rem;letter-spacing:0.06em;height:20px;padding:0 0.4375rem;">@Loc["RolLiveBadge"]</MudChip>
            <MudText Style="font-size:0.9375rem;font-weight:600;">@SceneTitle(_scene!)</MudText>
            <MudText Style="font-size:0.75rem;color:var(--text-dim);margin-left:0.25rem;">
                <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" Style="vertical-align:middle;margin-right:0.125rem;" />
                @_scene!.RoomName
            </MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Text" Size="Size.Small"
                       Color="Color.Default" Href="@($"/scenes/{Id}")">
                @Loc["RolViewArchive"]
            </MudButton>
        </div>

        @if (_liveUnavailable)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Style="border-radius:0;flex-shrink:0;">
                @Loc["RolSceneLiveUnavailable"]
            </MudAlert>
        }
        else if (!Terminal.IsConnected)
        {
            @* Each banner is gated on the connection whose loss it actually describes. The two are
               separate transports: posting goes over the terminal socket, live poses arrive on the hub.
               Gating both on one predicate — the tempting simplification — would disable a Send button
               that works whenever the live feed alone is down. What was wrong was the wording: this
               message says you cannot post, and it was shown for a hub outage, which does not stop
               posting at all. *@
            <MudAlert Severity="Severity.Warning" Dense="true" Style="border-radius:0;flex-shrink:0;">
                @Loc["RolNotConnected"]
            </MudAlert>
        }
        else if (!Hub.IsConnected)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Style="border-radius:0;flex-shrink:0;">
                @Loc["RolSceneLiveFeedDown"]
            </MudAlert>
        }

        <div class="scene-log scene-log--live">
            @if (_poses.Count == 0)
            {
                <MudText Style="color:var(--text-faint);font-style:italic;">@Loc["RolWaitingForActivity"]</MudText>
            }
            @foreach (var pose in _poses)
            {
                <ScenePoseLine Pose="pose" />
            }
        </div>

        <div class="scene-live-compose">
            <MudSelect T="string" @bind-Value="_mode" Dense="true" Margin="Margin.Dense"
                       Variant="Variant.Outlined" Style="max-width:130px;">
                <MudSelectItem Value="@("emit")">@Loc["RolModeEmit"]</MudSelectItem>
                <MudSelectItem Value="@("pose")">@Loc["RolModePose"]</MudSelectItem>
                <MudSelectItem Value="@("say")">@Loc["RolModeSay"]</MudSelectItem>
                <MudSelectItem Value="@("semipose")">@Loc["RolModeSemipose"]</MudSelectItem>
            </MudSelect>
            @* Immediate: the button below is gated on this field being non-empty, and MudTextField
               otherwise binds on blur — so the value stayed empty through an entire typed pose and
               Send could never be clicked. Enter is deliberately NOT wired to send: a pose is prose,
               composed over several lines and edited before it goes out. *@
            <MudTextField @bind-Value="_composeText" Placeholder="@Loc["RolComposePlaceholder"]"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Immediate="true"
                          Lines="2" MaxLines="4"
                          Style="flex:1;background:var(--surface-2);" />
            <MudIconButton Icon="@Icons.Material.Filled.Send" Color="Color.Primary"
                           Size="Size.Medium" Variant="Variant.Filled"
                           OnClick="SendPoseAsync"
                           Disabled="@(string.IsNullOrWhiteSpace(_composeText) || !Terminal.IsConnected || _liveUnavailable)" />
        </div>
    </div>
}

@code {
    [Parameter] public required string Id { get; set; }

    private SceneSummary? _scene;
    private readonly List<ScenePoseView> _poses = [];
    private bool _loading = true;
    private bool _notFound;
    private bool _liveUnavailable;
    private string _composeText = string.Empty;
    // Emit by default: it renders the author's words verbatim, with no name glued to the front.
    // That is what a compose box on one scene's own page is for — the other three modes stay
    // available for the times a player wants the built-in framing.
    private string _mode = "emit";
    private bool _subscribed;
    private string? _joinedSceneId;

    protected override void OnInitialized()
    {
        SceneHub.OnSceneEventReceived += HandleSceneEvent;
        _subscribed = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _notFound = false;
        _liveUnavailable = false;
        _poses.Clear();
        _scene = null;

        // A scene that does not exist and one that exists but is not visible to this caller BOTH land here,
        // and both must render the one _notFound card. The REST route answers 404 to both for that reason,
        // and the hub throws one message for both — a refusal a caller can tell apart is a way to enumerate
        // private scene ids. Any future edit that wants to explain a not-found must keep those two cases
        // sharing an answer.
        var scene = await SceneService.GetSceneAsync(Id);
        if (scene is null)
        {
            _notFound = true;
            _loading = false;
            return;
        }

        _scene = scene;
        _poses.AddRange(await SceneService.GetPosesAsync(Id, count: 100));

        // The hub is a per-page-load singleton and only the login/character-switch paths connect it,
        // so a returning player arrives here with no connection at all: the banner below, and a
        // compose box that can never send. This page is the one that needs the connection, so it is
        // the one that establishes it. ConnectAsync is a no-op when a hub already exists, which
        // matters — reconnecting would drop the scene groups other pages have joined.
        if (!Hub.IsConnected)
        {
            await Hub.ConnectAsync();
        }

        // Join the SignalR scene group so we receive realtime ReceiveSceneMessage events.
        if (!string.Equals(_joinedSceneId, Id, StringComparison.Ordinal))
        {
            await LeaveJoinedSceneAsync();

            try
            {
                await SceneHub.JoinSceneAsync(Id);
                _joinedSceneId = Id;
            }
            catch (HubException)
            {
                // NOT the not-found card. The fetch above already returned this scene, so the caller
                // demonstrably may read it and its archive is about to render; calling it missing would be
                // a plain lie, and it is the lie that costs a real user the page they are entitled to.
                //
                // What was refused is only the live subscription. The hub gates that on a character AND on
                // the same visibility the fetch just passed, so this is either a session acting as no
                // character (guests cannot join scenes) or a scene that stopped being visible in the moment
                // between the two calls. Naming that leaks nothing: the caller learned this scene exists
                // from the 200 they already hold, which is the enumeration boundary — not this message.
                _liveUnavailable = true;
            }
        }

        _loading = false;
    }

    private void HandleSceneEvent(SceneEventMessage msg)
    {
        if (!string.Equals(msg.SceneId, Id, StringComparison.Ordinal)) return;

        switch (msg.EventType)
        {
            case "pose":
                // Append exactly once — there is no optimistic insert, so an author's own
                // pose arrives here and renders for the first time.
                if (_poses.All(p => !string.Equals(p.Id, msg.PoseId, StringComparison.Ordinal)))
                {
                    _poses.Add(FromEvent(msg, existing: null));
                }
                break;

            case "edit":
                ReplacePose(msg.PoseId, existing => FromEvent(msg, existing));
                break;

            case "delete":
                // Strike through in place (keep ordering).
                ReplacePose(msg.PoseId, existing => existing with { IsDeleted = true });
                break;

            case "move":
                // Reorder isn't fully described by the event payload; re-fetch the ordered chain.
                _ = ReloadPosesAsync();
                return;

            default:
                // "meta" and unknown event kinds: nothing to patch in the pose list.
                return;
        }

        InvokeAsync(StateHasChanged);
    }

    private void ReplacePose(string poseId, Func<ScenePoseView, ScenePoseView> mutate)
    {
        var idx = _poses.FindIndex(p => string.Equals(p.Id, poseId, StringComparison.Ordinal));
        if (idx >= 0)
        {
            _poses[idx] = mutate(_poses[idx]);
        }
    }

    private async Task ReloadPosesAsync()
    {
        var fresh = await SceneService.GetPosesAsync(Id, count: 100);
        _poses.Clear();
        _poses.AddRange(fresh);
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Projects a realtime event onto a <see cref="ScenePoseView"/>. For edits the
    /// existing pose supplies the fields the event does not carry (author identity);
    /// EditCount is bumped so the "edited" badge shows.
    /// </summary>
    private ScenePoseView FromEvent(SceneEventMessage msg, ScenePoseView? existing) => new(
        Id: msg.PoseId,
        SceneId: msg.SceneId,
        AuthorDbref: existing?.AuthorDbref,
        AuthorName: existing?.AuthorName ?? msg.ActorName,
        ShowAsName: msg.ActorName,
        OriginDbref: existing?.OriginDbref,
        OriginName: existing?.OriginName ?? msg.Location,
        Source: msg.Source,
        Tags: msg.Tags ?? [],
        Meta: existing?.Meta ?? new Dictionary<string, string>(),
        CreatedAt: existing?.CreatedAt ?? msg.Timestamp,
        IsDeleted: false,
        Content: msg.Content,
        Markup: msg.Markup,
        EditCount: existing is null ? 1 : existing.EditCount + 1,
        LastEditedAt: existing is null ? null : msg.Timestamp,
        LastEditorDbref: existing?.LastEditorDbref,
        LastEditorName: existing is null ? null : msg.ActorName);

    private async Task SendPoseAsync()
    {
        var text = _composeText.Trim();
        // _liveUnavailable means this connection is not in the scene's group. Nothing renders a pose but the
        // round-trip event, so posting from here would look like the command vanished.
        if (text.Length == 0 || !Terminal.IsConnected || _liveUnavailable) return;

        // The scene is named, not inferred. The room-based verbs (: / say / ;) record through the
        // capture hooks, which only fire when the character is focused on a scene in the room they
        // are standing in — so posing from a page for a scene you are merely reading emitted into
        // wherever you happened to be and was silently never recorded.
        //
        // Newlines become %r because this is a line-delimited channel: a raw newline would end the
        // command. The engine expands %r back to a newline before the verb's pattern is matched, and
        // a wildcard spans newlines, so a multi-line pose arrives intact.
        var command = $"+scene/{_mode} {Id}={text.Replace("\r\n", "\n").Replace("\n", "%r")}";

        _composeText = string.Empty;

        // Sent down the command terminal's websocket, which is already open as this character and
        // whose input the engine already consumes. The game hub's SendCommand publishes onto a
        // subject nothing subscribes to, so a pose sent that way never arrived; the hub is kept for
        // RECEIVING the round-tripped event, which is what renders the pose.
        await Terminal.SendAsync(command);
    }

    public async ValueTask DisposeAsync()
    {
        if (_subscribed)
        {
            SceneHub.OnSceneEventReceived -= HandleSceneEvent;
            _subscribed = false;
        }

        await LeaveJoinedSceneAsync();
    }

    /// <summary>
    /// Leaves the joined scene group, if any, tolerating a hub refusal. This runs on navigation away and
    /// during disposal, where a thrown <see cref="HubException"/> has nowhere to surface; a refused leave
    /// costs at most one subscription that the connection's own teardown drops anyway.
    /// </summary>
    /// <remarks>
    /// Only the refusal is caught here. A connection that closes mid-call is the hub control's problem and
    /// is a no-op there (<see cref="ISceneHubControl.LeaveSceneAsync"/>) — which matters most on this path,
    /// since disposal is exactly when the connection is being torn down.
    /// </remarks>
    private async Task LeaveJoinedSceneAsync()
    {
        if (_joinedSceneId is not { } sceneId) return;

        _joinedSceneId = null;
        try
        {
            await SceneHub.LeaveSceneAsync(sceneId);
        }
        catch (HubException)
        {
            // Nothing to do and nowhere to report it: the group membership dies with the connection.
        }
    }

    private string SceneTitle(SceneSummary s) =>
        s.Meta.TryGetValue("title", out var t) && !string.IsNullOrWhiteSpace(t)
            ? t
            : Loc["RolSceneIn", s.RoomName];
}
