@page "/scenes/{Id}"
@layout ScenesLayout
@using SharpMUSH.Client.Components.Scenes
@inject IStringLocalizer<SharedResource> Loc
@inject SceneService SceneService
@inject IAccountAuthState AccountAuth
@inject GameCommandService Commands
@implements IDisposable

@* A scene's log in the D1 kit: the plain header (the room as kicker, the title, LIVE and the meta
   line, Watch Live and Back), the tag chips, the log in a card, and an aside with the scene's details
   and the characters who posed in it. The scene's owner, acting as its owner, can pause a running
   scene (with a new time if it has one) and start or resume one that waits on the schedule. *@
<div class="scene-detail-page">
    @if (_loading)
    {
        <PageTitle>@Loc["RolScene"] — @Loc["AppTitle"]</PageTitle>
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }
    else if (_error is not null)
    {
        <PageTitle>@Loc["RolScene"] — @Loc["AppTitle"]</PageTitle>
        <MudAlert Severity="Severity.Error" Class="scene-load-error">@_error</MudAlert>
        <div class="scene-detail-back">
            <CapsuleButton Href="/scenes" Icon="@Icons.Material.Outlined.ArrowBack">@Loc["RolBackToScenes"]</CapsuleButton>
        </div>
    }
    else if (_scene is null)
    {
        <PageTitle>@Loc["RolScene"] — @Loc["NotFound"]</PageTitle>
        <MudAlert Severity="Severity.Warning" Class="scene-not-found">@Loc["RolSceneNotFound"]</MudAlert>
        <div class="scene-detail-back">
            <CapsuleButton Href="/scenes" Icon="@Icons.Material.Outlined.ArrowBack">@Loc["RolBackToScenes"]</CapsuleButton>
        </div>
    }
    else
    {
        var scene = _scene;
        var visible = FilteredPoses();
        <PageTitle>@Loc.Title(scene) — @Loc["AppTitle"]</PageTitle>
        <PlainPageHeader Kicker="@scene.RoomName" Title="@Loc.Title(scene)">
            <DescriptionContent>
                <span class="scene-detail-meta">
                    @if (scene.IsLive)
                    {
                        <Pill Tag="true" Dot="var(--accent)" Class="scene-detail-live">@Loc["RolLiveBadge"]</Pill>
                    }
                    else if (scene.IsPaused)
                    {
                        <Pill Tag="true" Class="scene-detail-paused">@Loc["RolPausedBadge"]</Pill>
                    }
                    <span>@Loc.Plural("RolPoseCount", "count", scene.PoseCount)</span>
                    <span aria-hidden="true">·</span>
                    <span>@scene.StartedAtUtc.ToLocalTime().ToString("MMM d, yyyy HH:mm")</span>
                </span>
            </DescriptionContent>
            <Actions>
                @if (ActingOwner(scene) is not null)
                {
                    if (scene.IsLive)
                    {
                        <MudTooltip Text="@Loc["RolPauseScene"]">
                            <CapsuleButton Class="scene-detail-pause" Icon="@Icons.Material.Outlined.Pause" AriaLabel="@Loc["RolPauseScene"]"
                                           Expanded="@_pausing" Disabled="@_busy" OnClick="@(() => _pausing = !_pausing)" />
                        </MudTooltip>
                    }
                    else
                    {
                        var start = scene.IsPaused ? Loc["RolResumeScene"] : Loc["RolStartSceneNow"];
                        <MudTooltip Text="@start">
                            <CapsuleButton Class="scene-detail-resume" Icon="@Icons.Material.Outlined.PlayArrow" AriaLabel="@start"
                                           Disabled="@_busy" OnClick="StartAsync" />
                        </MudTooltip>
                    }
                }
                @if (scene.IsLive)
                {
                    <CapsuleButton Primary="true" Icon="@Icons.Material.Outlined.Sensors" Href="@($"/scenes/{Uri.EscapeDataString(Id)}/live")">@Loc["RolWatchLive"]</CapsuleButton>
                }
                <CapsuleButton Icon="@Icons.Material.Outlined.ArrowBack" Href="/scenes">@Loc["RolBackToScenes"]</CapsuleButton>
            </Actions>
        </PlainPageHeader>

        @if (_pausing && scene.IsLive)
        {
            <KitCard Class="scene-pause" Title="@Loc["RolPauseScene"]">
                <div class="scene-pause-form">
                    <p class="scene-pause-hint">@Loc["RolPauseHint"]</p>
                    <div class="scene-pause-when">
                        <MudDatePicker @bind-Date="_resumeDate" Label="@Loc["RolPauseNewTime"]" Clearable="true"
                                       MinDate="@DateTime.Today" Variant="Variant.Outlined" Margin="Margin.Dense"
                                       Class="scene-pause-date" />
                        <MudTimePicker @bind-Time="_resumeTime" Label="@Loc["RolPauseTime"]" Disabled="@(_resumeDate is null)"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" Class="scene-pause-time" />
                    </div>
                    <div class="scene-pause-buttons">
                        <CapsuleButton Primary="true" Icon="@Icons.Material.Outlined.Pause" Class="scene-pause-submit"
                                       Disabled="@_busy" OnClick="PauseAsync">@Loc["RolPauseScene"]</CapsuleButton>
                        <CapsuleButton OnClick="@(() => _pausing = false)">@Loc["Cancel"]</CapsuleButton>
                    </div>
                </div>
            </KitCard>
        }

        @if (_actionError is not null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="scene-action-error">@_actionError</MudAlert>
        }

        <div class="scene-detail-grid">
            <div class="scene-detail-main">
                @if (_allTags.Count > 0)
                {
                    <TypeChips Items="@TagChips" Selected="@(_activeTag ?? AllTags)" SelectedChanged="SetTag" AriaLabel="@Loc["NavSceneTagFilter"]" />
                }

                @if (_posesError is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="scene-poses-error">@_posesError</MudAlert>
                }
                else if (visible.Count == 0)
                {
                    <EmptyBox>@Loc["RolNoPoses"]</EmptyBox>
                }
                else
                {
                    <KitCard>
                        <div class="scene-detail-log">
                            <div class="scene-log">
                                @foreach (var pose in visible)
                                {
                                    <ScenePoseLine @key="pose.Id" Pose="pose" />
                                }
                            </div>
                        </div>
                    </KitCard>
                }
            </div>

            <aside class="scene-detail-aside">
                <KitCard Aside="true" Title="@Loc["NavSceneDetails"]">
                    <dl class="scene-detail-facts">
                        <dt>@Loc["NavSceneStarted"]</dt>
                        <dd>@scene.StartedAtUtc.ToLocalTime().ToString("MMM d, yyyy HH:mm")</dd>
                        @if (!scene.IsLive && scene.ScheduledForUtc is { } due)
                        {
                            <dt>@Loc["NavScenesScheduled"]</dt>
                            <dd class="scene-detail-scheduled">@due.ToLocalTime().ToString("MMM d, yyyy HH:mm")</dd>
                        }
                        <dt>@Loc["NavSceneLastActivity"]</dt>
                        <dd>@Loc.Format(scene.LastActivityAtUtc)</dd>
                        @if (!string.IsNullOrWhiteSpace(scene.StarterName))
                        {
                            <dt>@Loc["NavSceneStartedBy"]</dt>
                            <dd><Mention Name="@scene.StarterName" /></dd>
                        }
                        <dt>@Loc["NavSceneLength"]</dt>
                        <dd>@Loc.Plural("RolPoseCount", "count", scene.PoseCount)</dd>
                    </dl>
                </KitCard>
                @if (_cast.Count > 0)
                {
                    <KitCard Aside="true" Title="@Loc.Plural("NavSceneCast", "count", _cast.Count)">
                        <ul class="scene-detail-cast">
                            @foreach (var name in _cast)
                            {
                                <li><Mention Name="@name" /></li>
                            }
                        </ul>
                    </KitCard>
                }
            </aside>
        </div>
    }
</div>

@code {
    [Parameter] public required string Id { get; set; }

    private const string AllTags = "";

    /// <summary>Null while loading, when the read failed (<see cref="_error"/>) and when there is no such scene.</summary>
    private SceneSummary? _scene;
    private IReadOnlyList<ScenePoseView> _poses = [];
    private List<string> _allTags = [];

    /// <summary>The characters who posed, in the order they first did.</summary>
    private List<string> _cast = [];
    private string? _activeTag;
    private bool _loading = true;

    /// <summary>Why the scene could not be read, for any failure but 404 — which is a null scene with no error.</summary>
    private string? _error;
    private string? _posesError;

    private IReadOnlyList<(string Key, string Label)> TagChips =>
        [(AllTags, Loc["All"].Value), .. _allTags.Select(t => (t, t))];

    /// <summary>
    /// Whether the scene can be read at all depends on who asks — a private scene is shown only to its
    /// owner and members — so a switch of character reads it again.
    /// </summary>
    private readonly ViewerScopedReload _reload = new();

    protected override void OnInitialized() => _reload.Watch(AccountAuth, () => _ = InvokeAsync(async () =>
    {
        // LoadAsync clears the scene before its first await; rendering then takes the previous
        // character's log off the screen at the switch rather than when the new read answers.
        var load = LoadAsync();
        StateHasChanged();
        await load;
        StateHasChanged();
    }));

    protected override Task OnParametersSetAsync() => LoadAsync();

    public void Dispose()
    {
        _reload.Dispose();
        _stream?.Cancel();
        _stream?.Dispose();
    }

    /// <summary>Cancels the previous load's pose stream when the scene is read again or the page goes away.</summary>
    private CancellationTokenSource? _stream;

    private async Task LoadAsync()
    {
        var ticket = _reload.Begin();
        _loading = true;
        _error = null;
        _posesError = null;
        _poses = [];
        _allTags = [];
        _cast = [];
        _activeTag = null;
        _scene = null;

        var found = await SceneService.GetSceneAsync(Id);
        if (!_reload.IsCurrent(ticket)) return;
        switch (found)
        {
            case SceneSummary scene:
                _scene = scene;
                break;
            case ApiFailure { Kind: ApiFailureKind.NotFound }:
                _loading = false;
                return;
            case ApiFailure failure:
                _error = failure.Message;
                _loading = false;
                return;
        }

        // The header and details render now; the log fills in batch by batch as the server streams it.
        _loading = false;
        _stream?.Cancel();
        _stream?.Dispose();
        var stream = _stream = new CancellationTokenSource();
        var poses = new List<ScenePoseView>();
        _poses = poses;
        ApiResult<SharpMUSH.Library.DiscriminatedUnions.Success> streamed;
        try
        {
            streamed = await SceneService.StreamPosesAsync(Id, batch =>
            {
                if (!_reload.IsCurrent(ticket)) return Task.CompletedTask;
                poses.AddRange(batch);
                RefreshChips();
                StateHasChanged();
                return Task.CompletedTask;
            }, stream.Token);
        }
        catch (OperationCanceledException) when (stream.IsCancellationRequested)
        {
            return;
        }

        if (!_reload.IsCurrent(ticket)) return;
        if (streamed is ApiFailure streamFailure)
        {
            _poses = [];
            _posesError = streamFailure.Message;
        }

        // Once more over the whole log, so the chips are right however the batches fell.
        RefreshChips();
    }

    private void RefreshChips()
    {
        _allTags = _poses
            .SelectMany(p => p.Tags)
            .Where(t => !string.IsNullOrWhiteSpace(t))
            .Distinct(StringComparer.Ordinal)
            .OrderBy(t => t, StringComparer.OrdinalIgnoreCase)
            .ToList();
        _cast = _poses
            .Select(p => p.AuthorName)
            .Where(n => !string.IsNullOrWhiteSpace(n))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    /// <summary>The pause form is open.</summary>
    private bool _pausing;

    /// <summary>A pause or start is on its way to the server.</summary>
    private bool _busy;

    private DateTime? _resumeDate;
    private TimeSpan? _resumeTime;

    /// <summary>Why the last pause or start did not take, from the command's own output.</summary>
    private string? _actionError;

    /// <summary>
    /// The objid of the character this tab acts as, when that character owns <paramref name="scene"/> and the
    /// scene is not finished; otherwise null. The commands check ownership again, and staff, who may pause any
    /// scene, do it in-game.
    /// </summary>
    private string? ActingOwner(SceneSummary scene) =>
        !scene.IsFinished && AccountAuth.ActiveCharacter is { } acting && scene.OwnerDbref == $"#{acting.DbrefNumber}"
            ? $"#{acting.DbrefNumber}:{acting.CreationTime}"
            : null;

    /// <summary>
    /// The new time as epoch seconds, read in the browser's own time zone, or null when none was chosen.
    /// FUN`SCHED_WHEN takes a bare number as epoch seconds, so no date format crosses the wire.
    /// </summary>
    private long? ResumeAt() => _resumeDate is { } date
        ? new DateTimeOffset(DateTime.SpecifyKind(date.Date + (_resumeTime ?? TimeSpan.Zero), DateTimeKind.Local)).ToUnixTimeSeconds()
        : null;

    private Task PauseAsync() => RunLifecycleAsync(id => ResumeAt() is { } at
        ? $"+scene/pause {id}={at}"
        : $"+scene/pause {id}", "paused", Loc["RolSceneNotPaused"]);

    private Task StartAsync() => RunLifecycleAsync(id => $"+scene/start {id}", "active", Loc["RolSceneNotStarted"]);

    /// <summary>
    /// Runs a +scene lifecycle verb as the owner and asks the scene's status in the same queue entry: the verb
    /// refuses in its output, so only the status says whether it took. The scene id is the server's, never the
    /// address's, so nothing typed into the URL reaches the command line.
    /// </summary>
    private async Task RunLifecycleAsync(Func<string, string> command, string expected, string fallback)
    {
        if (_scene is not { } scene || ActingOwner(scene) is not { } character) return;

        _busy = true;
        _actionError = null;
        try
        {
            _actionError = await Commands.RunAsync(command(scene.Id), $"scene({scene.Id},status)", character) switch
            {
                PortalCommandResponse { Result: { } status } when status == expected => null,
                PortalCommandResponse refused => refused.Output.Count > 0 ? string.Join(" ", refused.Output) : fallback,
                ApiFailure failure => failure.Message,
            };
            if (_actionError is not null) return;

            _pausing = false;
            _resumeDate = null;
            _resumeTime = null;
            // The address may have moved on to another scene while the read was out.
            if (await SceneService.GetSceneAsync(scene.Id) is SceneSummary changed && changed.Id == Id)
            {
                _scene = changed;
            }

            // The section sidebar counts live scenes, and this scene just joined or left them.
            SceneService.ReportChanged();
        }
        finally
        {
            _busy = false;
        }
    }

    private void SetTag(string tag) => _activeTag = tag == AllTags ? null : tag;

    private List<ScenePoseView> FilteredPoses() =>
        _activeTag is null
            ? _poses.ToList()
            : _poses.Where(p => p.Tags.Contains(_activeTag, StringComparer.Ordinal)).ToList();
}
