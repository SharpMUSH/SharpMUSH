@page "/scenes/{Id}"
@layout ScenesLayout
@using SharpMUSH.Client.Components.Scenes
@inject IStringLocalizer<SharedResource> Loc
@inject SceneService SceneService
@inject IAccountAuthState AccountAuth
@inject GameCommandService Commands
@inject PoseTypeService PoseTypes
@inject NavigationManager Navigation
@implements IDisposable

@* A scene's log in the D1 kit: the plain header (the room as kicker, the title, LIVE and the meta
   line, Watch Live and Back), the tag chips, the log in a card, and an aside with the scene's details
   and the characters who posed in it. The scene's owner, acting as its owner, can pause a running
   scene (with a new time if it has one), start or resume one that waits on the schedule, and edit its
   title, pitch, visibility and time. A scene with a time to come can be added to a calendar. *@
<div class="scene-detail-page">
    @if (_loading)
    {
        <PageTitle>@Loc["RolScene"] — @Loc["AppTitle"]</PageTitle>
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }
    else if (_error is not null)
    {
        <PageTitle>@Loc["RolScene"] — @Loc["AppTitle"]</PageTitle>
        <MudAlert Severity="Severity.Error" Class="scene-load-error">@_error</MudAlert>
        <div class="scene-detail-back">
            <CapsuleButton Href="/scenes" Icon="@Icons.Material.Outlined.ArrowBack">@Loc["RolBackToScenes"]</CapsuleButton>
        </div>
    }
    else if (_scene is null)
    {
        <PageTitle>@Loc["RolScene"] — @Loc["NotFound"]</PageTitle>
        <MudAlert Severity="Severity.Warning" Class="scene-not-found">@Loc["RolSceneNotFound"]</MudAlert>
        <div class="scene-detail-back">
            <CapsuleButton Href="/scenes" Icon="@Icons.Material.Outlined.ArrowBack">@Loc["RolBackToScenes"]</CapsuleButton>
        </div>
    }
    else
    {
        var scene = _scene;
        var visible = FilteredPoses();
        <PageTitle>@Loc.Title(scene) — @Loc["AppTitle"]</PageTitle>
        <PlainPageHeader Kicker="@scene.RoomName" Title="@Loc.Title(scene)">
            <DescriptionContent>
                <span class="scene-detail-meta">
                    @if (scene.IsLive)
                    {
                        <Pill Tag="true" Dot="var(--accent)" Class="scene-detail-live">@Loc["RolLiveBadge"]</Pill>
                    }
                    else if (scene.IsPaused)
                    {
                        <Pill Tag="true" Class="scene-detail-paused">@Loc["RolPausedBadge"]</Pill>
                    }
                    @if (NotStarted(scene))
                    {
                        @* Nothing has happened yet: what matters is when it will. *@
                        if (!scene.IsPaused)
                        {
                            <Pill Tag="true" Class="scene-detail-upcoming">@Loc["NavScenesScheduled"]</Pill>
                        }
                        if (scene.ScheduledForUtc is { } due)
                        {
                            <span class="scene-detail-due">@due.ToLocalTime().ToString("MMM d, yyyy HH:mm")</span>
                        }
                    }
                    else
                    {
                        <span>@Loc.Plural("RolPoseCount", "count", scene.PoseCount)</span>
                        <span aria-hidden="true">·</span>
                        <span>@scene.StartedAtUtc.ToLocalTime().ToString("MMM d, yyyy HH:mm")</span>
                    }
                </span>
            </DescriptionContent>
            <Actions>
                @if (ActingOwner(scene) is not null)
                {
                    <MudTooltip Text="@Loc["RolEditScene"]">
                        <CapsuleButton Class="scene-detail-edit" Icon="@Icons.Material.Outlined.Edit" AriaLabel="@Loc["RolEditScene"]"
                                       Expanded="@_editing" Disabled="@_busy" OnClick="ToggleEdit" />
                    </MudTooltip>
                    if (scene.IsLive)
                    {
                        <MudTooltip Text="@Loc["RolPauseScene"]">
                            <CapsuleButton Class="scene-detail-pause" Icon="@Icons.Material.Outlined.Pause" AriaLabel="@Loc["RolPauseScene"]"
                                           Expanded="@_pausing" Disabled="@_busy" OnClick="@(() => _pausing = !_pausing)" />
                        </MudTooltip>
                    }
                    else
                    {
                        var start = scene.IsPaused ? Loc["RolResumeScene"] : Loc["RolStartSceneNow"];
                        <MudTooltip Text="@start">
                            <CapsuleButton Class="scene-detail-resume" Icon="@Icons.Material.Outlined.PlayArrow" AriaLabel="@start"
                                           Disabled="@_busy" OnClick="StartAsync" />
                        </MudTooltip>
                    }
                }
                @if (scene.IsLive)
                {
                    <CapsuleButton Primary="true" Icon="@Icons.Material.Outlined.Sensors" Href="@($"/scenes/{Uri.EscapeDataString(Id)}/live")">@Loc["RolWatchLive"]</CapsuleButton>
                }
                <CapsuleButton Icon="@Icons.Material.Outlined.ArrowBack" Href="/scenes">@Loc["RolBackToScenes"]</CapsuleButton>
            </Actions>
        </PlainPageHeader>

        @if (Pitch(scene) is { } pitch)
        {
            <p class="scene-detail-pitch">@pitch</p>
        }

        @if (_editing)
        {
            <KitCard Class="scene-edit" Title="@Loc["RolEditScene"]">
                <div class="scene-edit-form">
                    <MudTextField @bind-Value="_editTitle" Label="@Loc["RolSceneTitleLabel"]" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" Class="scene-edit-title" />
                    <MudTextField @bind-Value="_editPitch" Label="@Loc["RolScenePitchLabel"]" HelperText="@Loc["RolScenePitchHint"]"
                                  Lines="3" Variant="Variant.Outlined" Margin="Margin.Dense" Class="scene-edit-pitch" />
                    <MudSwitch @bind-Value="_editPublic" Label="@Loc["RolScenePublicLabel"]" Color="Color.Primary" Class="scene-edit-public" />
                    @if (!scene.IsLive)
                    {
                        <div class="scene-pause-when">
                            <MudDatePicker @bind-Date="_editDate" Label="@Loc["RolSceneDate"]" Variant="Variant.Outlined"
                                           Margin="Margin.Dense" Class="scene-edit-date" />
                            <MudTimePicker @bind-Time="_editTime" Label="@Loc["RolPauseTime"]" Disabled="@(_editDate is null)"
                                           Variant="Variant.Outlined" Margin="Margin.Dense" Class="scene-edit-time" />
                        </div>
                    }
                    <div class="scene-pause-buttons">
                        <CapsuleButton Primary="true" Icon="@Icons.Material.Outlined.Check" Class="scene-edit-submit"
                                       Disabled="@_busy" OnClick="SaveAsync">@Loc["Save"]</CapsuleButton>
                        <CapsuleButton OnClick="@(() => _editing = false)">@Loc["Cancel"]</CapsuleButton>
                    </div>
                </div>
            </KitCard>
        }

        @if (_pausing && scene.IsLive)
        {
            <KitCard Class="scene-pause" Title="@Loc["RolPauseScene"]">
                <div class="scene-pause-form">
                    <p class="scene-pause-hint">@Loc["RolPauseHint"]</p>
                    <div class="scene-pause-when">
                        <MudDatePicker @bind-Date="_resumeDate" Label="@Loc["RolPauseNewTime"]" Clearable="true"
                                       MinDate="@DateTime.Today" Variant="Variant.Outlined" Margin="Margin.Dense"
                                       Class="scene-pause-date" />
                        <MudTimePicker @bind-Time="_resumeTime" Label="@Loc["RolPauseTime"]" Disabled="@(_resumeDate is null)"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" Class="scene-pause-time" />
                    </div>
                    <div class="scene-pause-buttons">
                        <CapsuleButton Primary="true" Icon="@Icons.Material.Outlined.Pause" Class="scene-pause-submit"
                                       Disabled="@_busy" OnClick="PauseAsync">@Loc["RolPauseScene"]</CapsuleButton>
                        <CapsuleButton OnClick="@(() => _pausing = false)">@Loc["Cancel"]</CapsuleButton>
                    </div>
                </div>
            </KitCard>
        }

        @if (_actionError is not null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="scene-action-error">@_actionError</MudAlert>
        }

        <div class="scene-detail-grid">
            <div class="scene-detail-main">
                <div class="scene-detail-filters">
                    @if (_allTags.Count > 0)
                    {
                        <TypeChips Items="@TagChips" Selected="@(_activeTag ?? AllTags)" SelectedChanged="SetTag" AriaLabel="@Loc["NavSceneTagFilter"]" />
                    }
                    <PoseTypeMenu Class="scene-detail-types" />
                </div>

                @if (_posesError is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="scene-poses-error">@_posesError</MudAlert>
                }
                else if (visible.Count == 0 && NotStarted(scene))
                {
                    <EmptyBox Class="scene-detail-not-started">@(scene.ScheduledForUtc is { } due
                        ? string.Format(Loc["RolSceneStartsAt"], due.ToLocalTime().ToString("MMM d, yyyy HH:mm"))
                        : Loc["RolSceneNotStartedYet"])</EmptyBox>
                }
                else if (visible.Count == 0)
                {
                    <EmptyBox>@Loc["RolNoPoses"]</EmptyBox>
                }
                else
                {
                    @* The log reads as the live view does (StoryPose): each pose as its type draws it, the other
                       participants' names as mentions, and the types the reader hides folded into one line a run. *@
                    var viewer = AccountAuth.ActiveCharacter?.Name;
                    <KitCard>
                        <div class="scene-detail-log">
                            @foreach (var entry in StoryFolds.Fold(visible, PoseTypes.For, PoseTypes.IsHidden, _revealed))
                            {
                                switch (entry)
                                {
                                    case ScenePoseView pose:
                                        <StoryPose @key="pose.Id" Pose="pose" PoseType="@PoseTypes.For(pose.Type)" Mentions="_mentions"
                                                   Mine="@(viewer is not null && string.Equals(pose.AuthorName, viewer, StringComparison.OrdinalIgnoreCase))" />
                                        break;
                                    case StoryFold fold:
                                        <StoryFoldRow @key="@("fold:" + fold.Poses[0].Id)" Fold="fold" OnReveal="Reveal" />
                                        break;
                                }
                            }
                        </div>
                    </KitCard>
                }
            </div>

            @* On a phone the aside comes before the log, folded into one line that names the cast, so a long log
               does not push it out of reach; on a wide page it sits beside the log and stays in view. *@
            <aside class="scene-detail-aside @(_aboutOpen ? "scene-detail-aside-open" : null)">
                <button type="button" class="scene-detail-about-toggle" aria-expanded="@(_aboutOpen ? "true" : "false")"
                        aria-controls="scene-detail-about" @onclick="@(() => _aboutOpen = !_aboutOpen)">
                    <span class="scene-detail-about-label">@Loc["RolSceneAboutToggle"]</span>
                    @if (_cast.Count > 0)
                    {
                        <span class="scene-detail-about-cast">@string.Join(", ", _cast)</span>
                    }
                    <MudIcon Class="scene-detail-about-chevron" Size="Size.Small"
                             Icon="@(_aboutOpen ? Icons.Material.Outlined.ExpandLess : Icons.Material.Outlined.ExpandMore)" />
                </button>
                <div id="scene-detail-about" class="scene-detail-about">
                    <KitCard Aside="true" Title="@Loc["NavSceneDetails"]">
                        @* A scene that has not started has no start, length or activity to tell: when it is due and
                           who hosts it are what a reader comes for. *@
                        <dl class="scene-detail-facts">
                            @if (!NotStarted(scene))
                            {
                                <dt>@Loc["NavSceneStarted"]</dt>
                                <dd>@scene.StartedAtUtc.ToLocalTime().ToString("MMM d, yyyy HH:mm")</dd>
                            }
                            @if (!scene.IsLive && scene.ScheduledForUtc is { } due)
                            {
                                <dt>@Loc["NavScenesScheduled"]</dt>
                                <dd class="scene-detail-scheduled">@due.ToLocalTime().ToString("MMM d, yyyy HH:mm")</dd>
                            }
                            @if (NotStarted(scene))
                            {
                                @if (!string.IsNullOrWhiteSpace(scene.OwnerName))
                                {
                                    <dt>@Loc["NavSceneHost"]</dt>
                                    <dd><Mention Name="@scene.OwnerName" /></dd>
                                }
                            }
                            else
                            {
                                <dt>@Loc["NavSceneLastActivity"]</dt>
                                <dd>@Loc.Format(scene.LastActivityAtUtc)</dd>
                                @if (!string.IsNullOrWhiteSpace(scene.StarterName))
                                {
                                    <dt>@Loc["NavSceneStartedBy"]</dt>
                                    <dd><Mention Name="@scene.StarterName" /></dd>
                                }
                                <dt>@Loc["NavSceneLength"]</dt>
                                <dd>@Loc.Plural("RolPoseCount", "count", scene.PoseCount)</dd>
                            }
                        </dl>
                        @if (CalendarStart(scene) is { } start)
                        {
                            var title = Loc.Title(scene);
                            var details = CalendarDetails(scene);
                            var location = string.IsNullOrWhiteSpace(scene.RoomName) ? Loc["AppTitle"].Value : scene.RoomName;
                            <div class="scene-calendar">
                                <span class="scene-calendar-label">@Loc["RolAddToCalendar"]</span>
                                <a class="scene-calendar-google" href="@SceneCalendar.GoogleUrl(title, details, location, start)"
                                   target="_blank" rel="noopener">
                                    <MudIcon Icon="@Icons.Material.Outlined.Event" Size="Size.Small" />@Loc["RolGoogleCalendar"]
                                </a>
                                <a class="scene-calendar-ics" download="@($"scene-{scene.Id}.ics")"
                                   href="@SceneCalendar.DataUri(SceneCalendar.Ics($"scene-{scene.Id}@{new Uri(Navigation.BaseUri).Host}", title, details, location, SceneUrl(scene), start, DateTimeOffset.UtcNow))">
                                    <MudIcon Icon="@Icons.Material.Outlined.Download" Size="Size.Small" />@Loc["RolIcsDownload"]
                                </a>
                            </div>
                        }
                    </KitCard>
                    @if (_cast.Count > 0)
                    {
                        <KitCard Aside="true" Title="@Loc.Plural("NavSceneCast", "count", _cast.Count)">
                            <ul class="scene-detail-cast">
                                @foreach (var name in _cast)
                                {
                                    <li><Mention Name="@name" /></li>
                                }
                            </ul>
                        </KitCard>
                    }
                </div>
            </aside>
        </div>
    }
</div>

@code {
    [Parameter] public required string Id { get; set; }

    private const string AllTags = "";

    /// <summary>Null while loading, when the read failed (<see cref="_error"/>) and when there is no such scene.</summary>
    private SceneSummary? _scene;
    private IReadOnlyList<ScenePoseView> _poses = [];
    private List<string> _allTags = [];

    /// <summary>The characters who posed, in the order they first did.</summary>
    private List<string> _cast = [];

    /// <summary>The cast as mentions in the log: a name in another's pose links to them, the viewer's in the accent.</summary>
    private IReadOnlyList<StoryMentions.Target> _mentions = [];
    private string? _activeTag;
    private bool _loading = true;

    /// <summary>Why the scene could not be read, for any failure but 404 — which is a null scene with no error.</summary>
    private string? _error;
    private string? _posesError;

    private IReadOnlyList<(string Key, string Label)> TagChips =>
        [(AllTags, Loc["All"].Value), .. _allTags.Select(t => (t, t))];

    /// <summary>
    /// Whether the scene can be read at all depends on who asks — a private scene is shown only to its
    /// owner and members — so a switch of character reads it again.
    /// </summary>
    private readonly ViewerScopedReload _reload = new();

    /// <summary>Hidden poses this page shows anyway: a fold was opened. The type stays hidden.</summary>
    private readonly HashSet<string> _revealed = new(StringComparer.Ordinal);

    private void Reveal(StoryFold fold)
    {
        foreach (var pose in fold.Poses) _revealed.Add(pose.Id);
    }

    private void OnPoseTypesChanged() => _ = InvokeAsync(StateHasChanged);

    protected override void OnInitialized()
    {
        PoseTypes.Changed += OnPoseTypesChanged;
        WatchViewer();
    }

    private void WatchViewer() => _reload.Watch(AccountAuth, () => _ = InvokeAsync(async () =>
    {
        // LoadAsync clears the scene before its first await; rendering then takes the previous
        // character's log off the screen at the switch rather than when the new read answers.
        var load = LoadAsync();
        StateHasChanged();
        await load;
        StateHasChanged();
    }));

    protected override Task OnParametersSetAsync() => LoadAsync();

    public void Dispose()
    {
        PoseTypes.Changed -= OnPoseTypesChanged;
        _reload.Dispose();
        _stream?.Cancel();
        _stream?.Dispose();
    }

    /// <summary>Cancels the previous load's pose stream when the scene is read again or the page goes away.</summary>
    private CancellationTokenSource? _stream;

    private async Task LoadAsync()
    {
        var ticket = _reload.Begin();
        _loading = true;
        _error = null;
        _posesError = null;
        _poses = [];
        _allTags = [];
        _cast = [];
        _mentions = [];
        _activeTag = null;
        _revealed.Clear();
        _scene = null;
        // A form open on the scene this page showed before holds that scene's values; saving them here would
        // write them onto this one.
        _editing = false;
        _pausing = false;
        _actionError = null;

        var found = await SceneService.GetSceneAsync(Id);
        if (!_reload.IsCurrent(ticket)) return;
        switch (found)
        {
            case SceneSummary scene:
                _scene = scene;
                break;
            case ApiFailure { Kind: ApiFailureKind.NotFound }:
                _loading = false;
                return;
            case ApiFailure failure:
                _error = failure.Message;
                _loading = false;
                return;
        }

        // The header and details render now; the log fills in batch by batch as the server streams it.
        _loading = false;
        _stream?.Cancel();
        _stream?.Dispose();
        var stream = _stream = new CancellationTokenSource();
        var poses = new List<ScenePoseView>();
        _poses = poses;
        ApiResult<SharpMUSH.Library.DiscriminatedUnions.Success> streamed;
        try
        {
            streamed = await SceneService.StreamPosesAsync(Id, batch =>
            {
                if (!_reload.IsCurrent(ticket)) return Task.CompletedTask;
                poses.AddRange(batch);
                RefreshChips();
                StateHasChanged();
                return Task.CompletedTask;
            }, stream.Token);
        }
        catch (OperationCanceledException) when (stream.IsCancellationRequested)
        {
            return;
        }

        if (!_reload.IsCurrent(ticket)) return;
        if (streamed is ApiFailure streamFailure)
        {
            _poses = [];
            _posesError = streamFailure.Message;
        }

        // Once more over the whole log, so the chips are right however the batches fell.
        RefreshChips();
    }

    private void RefreshChips()
    {
        _allTags = _poses
            .SelectMany(p => p.Tags)
            .Where(t => !string.IsNullOrWhiteSpace(t))
            .Distinct(StringComparer.Ordinal)
            .OrderBy(t => t, StringComparer.OrdinalIgnoreCase)
            .ToList();
        _cast = _poses
            .Select(p => p.AuthorName)
            .Where(n => !string.IsNullOrWhiteSpace(n))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        var viewer = AccountAuth.ActiveCharacter?.Name;
        _mentions = [.. _cast.Select(name => new StoryMentions.Target(name, null,
            viewer is not null && string.Equals(name, viewer, StringComparison.OrdinalIgnoreCase)))];
    }

    /// <summary>The pause form is open.</summary>
    private bool _pausing;

    /// <summary>A pause or start is on its way to the server.</summary>
    private bool _busy;

    private DateTime? _resumeDate;
    private TimeSpan? _resumeTime;

    /// <summary>Why the last pause or start did not take, from the command's own output.</summary>
    private string? _actionError;

    /// <summary>
    /// The objid of the character this tab acts as, when that character owns <paramref name="scene"/> and the
    /// scene is not finished; otherwise null. The commands check ownership again, and staff, who may pause any
    /// scene, do it in-game.
    /// </summary>
    private string? ActingOwner(SceneSummary scene) =>
        !scene.IsFinished && AccountAuth.ActiveCharacter is { } acting && scene.OwnerDbref == $"#{acting.DbrefNumber}"
            ? $"#{acting.DbrefNumber}:{acting.CreationTime}"
            : null;

    /// <summary>
    /// The new time as epoch seconds, read in the browser's own time zone, or null when none was chosen.
    /// FUN`SCHED_WHEN takes a bare number as epoch seconds, so no date format crosses the wire.
    /// </summary>
    private long? ResumeAt() => _resumeDate is { } date
        ? new DateTimeOffset(DateTime.SpecifyKind(date.Date + (_resumeTime ?? TimeSpan.Zero), DateTimeKind.Local)).ToUnixTimeSeconds()
        : null;

    private Task PauseAsync() => RunLifecycleAsync(id => ResumeAt() is { } at
        ? $"+scene/pause {id}={at}"
        : $"+scene/pause {id}", "paused", Loc["RolSceneNotPaused"]);

    private Task StartAsync() => RunLifecycleAsync(id => $"+scene/start {id}", "active", Loc["RolSceneNotStarted"]);

    /// <summary>
    /// Runs a +scene lifecycle verb as the owner and asks the scene's status in the same queue entry: the verb
    /// refuses in its output, so only the status says whether it took. The scene id is the server's, never the
    /// address's, so nothing typed into the URL reaches the command line.
    /// </summary>
    private async Task RunLifecycleAsync(Func<string, string> command, string expected, string fallback)
    {
        if (_scene is not { } scene || ActingOwner(scene) is not { } character) return;

        _busy = true;
        _actionError = null;
        try
        {
            _actionError = await Commands.RunAsync(command(scene.Id), $"scene({scene.Id},status)", character) switch
            {
                PortalCommandResponse { Result: { } status } when status == expected => null,
                PortalCommandResponse refused => refused.Output.Count > 0 ? string.Join(" ", refused.Output) : fallback,
                ApiFailure failure => failure.Message,
            };
            if (_actionError is not null) return;

            _pausing = false;
            _resumeDate = null;
            _resumeTime = null;
            // The address may have moved on to another scene while the read was out.
            if (await SceneService.GetSceneAsync(scene.Id) is SceneSummary changed && changed.Id == Id)
            {
                _scene = changed;
            }

            // The section sidebar counts live scenes, and this scene just joined or left them.
            SceneService.ReportChanged();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>The edit form is open.</summary>
    private bool _editing;

    /// <summary>Whether the details and cast are unfolded on a narrow page; a wide page always shows them.</summary>
    private bool _aboutOpen;
    private string _editTitle = "";
    private string _editPitch = "";
    private bool _editPublic;
    private DateTime? _editDate;
    private TimeSpan? _editTime;

    /// <summary>The pitch the owner set with +scene/pitch, or null when there is none.</summary>
    private static string? Pitch(SceneSummary scene) =>
        scene.Meta.TryGetValue("summary", out var pitch) && !string.IsNullOrWhiteSpace(pitch) ? pitch : null;

    /// <summary>Opens the form on the scene as it is now.</summary>
    private void ToggleEdit()
    {
        _editing = !_editing;
        if (!_editing || _scene is not { } scene) return;

        _editTitle = scene.Meta.TryGetValue("title", out var title) ? title : "";
        _editPitch = Pitch(scene) ?? "";
        _editPublic = scene.IsPublic;
        var due = scene.ScheduledForUtc?.ToLocalTime();
        _editDate = due?.Date;
        _editTime = due?.TimeOfDay;
    }

    /// <summary>The time chosen in the form as epoch seconds, read in the browser's time zone, or null for none.</summary>
    private long? EditedTime() => _editDate is { } date
        ? new DateTimeOffset(DateTime.SpecifyKind(date.Date + (_editTime ?? TimeSpan.Zero), DateTimeKind.Local)).ToUnixTimeSeconds()
        : null;

    /// <summary>
    /// Saves what changed, one +scene verb per field, each naming the scene and asking it back in the same
    /// queue entry: a verb refuses in its output, so only the value read back says whether it took. The text
    /// goes through the compose encoder, as a pose does, so its spaces, line breaks and semicolons arrive.
    /// </summary>
    private async Task SaveAsync()
    {
        if (_scene is not { } scene || ActingOwner(scene) is not { } character) return;

        var id = scene.Id;
        var changes = new List<(string Command, string Result, string Expected)>();
        var title = _editTitle.Trim();
        if (title.Length > 0 && title != (scene.Meta.TryGetValue("title", out var oldTitle) ? oldTitle : ""))
            changes.Add(($"+scene/title {id}={MushComposeEncoder.Encode(title)}", $"scene({id},title)", title));
        var pitch = _editPitch.Trim();
        if (pitch != (Pitch(scene) ?? ""))
            changes.Add(($"+scene/pitch {id}={MushComposeEncoder.Encode(pitch)}", $"scene({id},summary)", pitch));
        if (_editPublic != scene.IsPublic)
            changes.Add((_editPublic ? $"+scene/public {id}" : $"+scene/private {id}", $"scene({id},public)", _editPublic ? "1" : "0"));
        if (!scene.IsLive && EditedTime() is { } at && at * 1000 != scene.ScheduledFor)
            changes.Add(($"+scene/reschedule {id}={at}", $"scene({id},scheduledfor)", (at * 1000).ToString(System.Globalization.CultureInfo.InvariantCulture)));

        _busy = true;
        _actionError = null;
        try
        {
            foreach (var (command, result, expected) in changes)
            {
                _actionError = await Commands.RunAsync(command, result, character) switch
                {
                    PortalCommandResponse { Result: { } value } when Same(value, expected) => null,
                    PortalCommandResponse refused => refused.Output.Count > 0 ? string.Join(" ", refused.Output) : Loc["RolSceneNotSaved"],
                    ApiFailure failure => failure.Message,
                };
                if (_actionError is not null) break;
            }

            if (changes.Count > 0 && await SceneService.GetSceneAsync(id) is SceneSummary changed && changed.Id == Id)
            {
                _scene = changed;
            }

            if (_actionError is null) _editing = false;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>A value read back is the one sent, give or take line endings and the edges' whitespace.</summary>
    private static bool Same(string value, string expected) =>
        string.Equals(value.Replace("\r\n", "\n").Trim(), expected.Replace("\r\n", "\n").Trim(), StringComparison.Ordinal);

    /// <summary>The scene has not run yet: it is not live, has not finished, and nothing was posed in it.</summary>
    private static bool NotStarted(SceneSummary scene) => !scene.IsLive && !scene.IsFinished && scene.PoseCount == 0;

    /// <summary>When the scene starts, for a scene that is waiting on a time: not one that runs now or has ended.</summary>
    private static DateTimeOffset? CalendarStart(SceneSummary scene) =>
        !scene.IsLive && !scene.IsFinished && !string.Equals(scene.Status, "cancelled", StringComparison.OrdinalIgnoreCase)
            ? scene.ScheduledForUtc
            : null;

    private string SceneUrl(SceneSummary scene) => Navigation.ToAbsoluteUri($"scenes/{Uri.EscapeDataString(scene.Id)}").ToString();

    private string CalendarDetails(SceneSummary scene) =>
        Pitch(scene) is { } pitch ? pitch + "\n\n" + SceneUrl(scene) : SceneUrl(scene);

    private void SetTag(string tag) => _activeTag = tag == AllTags ? null : tag;

    private List<ScenePoseView> FilteredPoses() =>
        _activeTag is null
            ? _poses.ToList()
            : _poses.Where(p => p.Tags.Contains(_activeTag, StringComparer.Ordinal)).ToList();
}
