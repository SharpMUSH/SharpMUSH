@page "/settings/characters"
@attribute [Authorize]
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["Characters"] — @Loc["Settings"] — @Loc["AppTitle"]</PageTitle>

<div class="settings-page">
    <header class="settings-header">
        <div class="settings-kicker">@Loc["AppTitle"] · @Loc["Settings"]</div>
        <h1 class="settings-title">@Loc["NavCharacterManagement"]</h1>
    </header>

    <section class="settings-card">
        <div class="settings-card-section-label">@Loc["ComingSoon"]</div>
        <p class="settings-card-text">
            @Loc["NavCharacterManagementComingSoon"]
            <a class="settings-link" href="/account">@Loc["NavGoToAccountPage"]</a>
        </p>
    </section>
</div>
