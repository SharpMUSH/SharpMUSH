@page "/mail/{Id:int}"
@layout MailLayout
@attribute [Authorize]
@using SharpMUSH.Client.Components.Mail
@using SharpMUSH.Client.Services
@using SharpMUSH.Library.DiscriminatedUnions
@inject IStringLocalizer<SharedResource> Loc
@inject MailService Mail
@inject IAccountAuthState AccountAuth
@implements IDisposable
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@Loc["Mail"] #@Id — <GameName /></PageTitle>

@* D1 §6.5 one message: the plain header (its folder, its subject, Reply and Delete) over the
   message card. Back returns to the folder it was read from. *@
<div class="mail-detail-page">
    <PageHeader Kicker="@($"{Loc["Mail"]} · {MailSidebar.FolderName(Loc, FolderName)}")" Title="@(_message?.Subject ?? $"#{Id}")">
        <Actions>
            <CapsuleButton Href="@MailSidebar.FolderHref(FolderName)" Icon="@Icons.Material.Outlined.ArrowBack" AriaLabel="@Loc["NavMailBackToFolder", MailSidebar.FolderName(Loc, FolderName)]" />
            @if (_message is not null)
            {
                <CapsuleButton Class="md-delete" Icon="@Icons.Material.Outlined.Delete" OnClick="DeleteAsync">@Loc["Delete"]</CapsuleButton>
                @if (ReachesOthers(_message))
                {
                    <CapsuleButton Class="md-reply-all" Icon="@Icons.Material.Outlined.ReplyAll" Href="@SharpMUSH.Client.Pages.Mail.ReplyAllHref(_message)">@Loc["NavMailReplyAll"]</CapsuleButton>
                }
                <CapsuleButton Class="md-reply" Primary="true" Icon="@Icons.Material.Outlined.Reply" Href="@SharpMUSH.Client.Pages.Mail.ReplyHref(Summary(_message))">@Loc["Reply"]</CapsuleButton>
            }
        </Actions>
    </PageHeader>

    @if (_loading)
    {
        <KitCard Class="md-card">
            <SkeletonLines Lines="6" />
        </KitCard>
    }
    else if (_message is null)
    {
        <KitCard>
            <div class="md-missing">@(_error ?? Loc["MailNotFound"])</div>
        </KitCard>
    }
    else
    {
        <KitCard Class="md-card">
            <div class="md-head">
                <span class="md-from">@Loc["From"]: <strong>@_message.From</strong></span>
                @if (_message.Urgent)
                {
                    <Pill Tag="true" Warn="true">@Loc["Urgent"]</Pill>
                }
                @if (_message.To is { Count: > 0 } to)
                {
                    <span class="md-to">@Loc["To"]: <strong>@string.Join(", ", to)</strong></span>
                }
                <span class="md-date">@DateDisplay.LongDateTime(_message.DateSent, asGiven: _message.Zoned)</span>
            </div>
            <div class="md-body">@_message.Body</div>
        </KitCard>

        @* The conversation the message is in, when there is more of it than this one message: each message the
           character sent or holds, oldest first. One they hold opens; one they only sent is marked as theirs. *@
        @if (_thread is { Count: > 1 } thread)
        {
            <KitCard Class="md-thread">
                <h2 class="md-thread-title">@Loc["NavMailConversation"]</h2>
                <ol class="md-thread-list">
                    @foreach (var entry in thread)
                    {
                        var current = entry.Number == Id && string.Equals(entry.Folder, FolderName, StringComparison.OrdinalIgnoreCase);
                        <li class="md-thread-row @(current ? "md-thread-row--current" : null)" aria-current="@(current ? "true" : null)">
                            @if (entry.Number is { } number && entry.Folder is { } folder && !current)
                            {
                                <a class="md-thread-subject" href="@DetailHref(folder, number)">@entry.Subject</a>
                            }
                            else
                            {
                                <span class="md-thread-subject">@entry.Subject</span>
                            }
                            <span class="md-thread-meta">
                                <span class="md-thread-from">@entry.From</span>
                                @if (entry.To.Count > 0)
                                {
                                    <span class="md-thread-to">→ @string.Join(", ", entry.To)</span>
                                }
                                @if (entry.Sent)
                                {
                                    <Pill Tag="true">@Loc["NavMailYouSent"]</Pill>
                                }
                                <span class="md-thread-date">@DateDisplay.LongDateTime(entry.DateSent, asGiven: entry.Zoned)</span>
                            </span>
                        </li>
                    }
                </ol>
            </KitCard>
        }
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    [SupplyParameterFromQuery(Name = "folder")]
    public string? Folder { get; set; }

    private MailService.MailMessage? _message;
    private IReadOnlyList<MailService.MailThreadEntry>? _thread;
    private string? _error;
    private bool _loading = true;

    private string FolderName => string.IsNullOrWhiteSpace(Folder) ? MailSidebar.Inbox : Folder;

    /// <summary>
    /// A number names a message only within the acting character's mailbox, so a switch of character
    /// reads the new character's message of that number.
    /// </summary>
    private readonly ViewerScopedReload _reload = new();

    protected override void OnInitialized() => _reload.Watch(AccountAuth, () => _ = InvokeAsync(async () =>
    {
        // The message on screen is the previous character's, and its Delete would now act on the new
        // character's message of the same number: it goes before the new one is asked for.
        (_message, _error, _thread) = (null, null, null);
        _loading = true;
        StateHasChanged();
        await LoadAsync();
        StateHasChanged();
    }));

    protected override Task OnParametersSetAsync() => LoadAsync();

    public void Dispose() => _reload.Dispose();

    private async Task LoadAsync()
    {
        _loading = true;
        _thread = null;
        await _reload.LoadAsync(() => Mail.ReadAsync(FolderName, Id), result =>
        {
            _message = result is MailService.MailMessage message ? message : null;
            // A missing message keeps the page's own wording; anything else is the server's reason.
            _error = result is ApiFailure { Kind: not ApiFailureKind.NotFound } failure ? failure.Message : null;
            _loading = false;
        });

        // The conversation is extra: the message shows without it, and a failure to read it shows nothing.
        if (_message is { Thread: { } thread })
        {
            await _reload.LoadAsync(() => Mail.ThreadAsync(thread), result =>
                _thread = result is IReadOnlyList<MailService.MailThreadEntry> entries ? entries : null);
        }
    }

    private static string DetailHref(string folder, int number) =>
        $"/mail/{number}?folder={Uri.EscapeDataString(folder)}";

    /// <summary>Reply all reaches someone a plain reply does not: another player, or an alias.</summary>
    private bool ReachesOthers(MailService.MailMessage message) =>
        message.To is { } to && to.Any(name => name.StartsWith('+')
            || !string.Equals(name, AccountAuth.ActiveCharacter?.Name, StringComparison.OrdinalIgnoreCase));

    private static MailService.MailSummary Summary(MailService.MailMessage m) =>
        new(m.Number, m.From, m.Subject, m.DateSent, m.Read, m.Urgent, m.Folder, m.Zoned);

    private async Task DeleteAsync()
    {
        if (_message is null) return;
        switch (await Mail.DeleteAsync(FolderName, Id))
        {
            case Success:
                Snackbar.Add(Loc["MailDeleted"], Severity.Success);
                // Back to the folder the message was in, not always the inbox.
                Nav.NavigateTo(MailSidebar.FolderHref(FolderName));
                break;
            case ApiFailure failure:
                Snackbar.Add(Loc["MailDeleteFailed", failure.Message], Severity.Error);
                break;
        }
    }
}
