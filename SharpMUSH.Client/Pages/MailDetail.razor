@page "/mail/{Id:int}"
@layout MailLayout
@attribute [Authorize]
@using SharpMUSH.Client.Components.Mail
@using SharpMUSH.Client.Services
@using SharpMUSH.Library.DiscriminatedUnions
@inject IStringLocalizer<SharedResource> Loc
@inject MailService Mail
@inject IAccountAuthState AccountAuth
@implements IDisposable
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@Loc["Mail"] #@Id — @Loc["AppTitle"]</PageTitle>

@* D1 §6.5 one message: the plain header (its folder, its subject, Reply and Delete) over the
   message card. Back returns to the folder it was read from. *@
<div class="mail-detail-page">
    <PlainPageHeader Kicker="@($"{Loc["Mail"]} · {FolderName}")" Title="@(_message?.Subject ?? $"#{Id}")">
        <Actions>
            <CapsuleButton Href="@MailSidebar.FolderHref(FolderName)" Icon="@Icons.Material.Outlined.ArrowBack" AriaLabel="@Loc["NavMailBackToFolder", FolderName]" />
            @if (_message is not null)
            {
                <CapsuleButton Class="md-delete" Icon="@Icons.Material.Outlined.Delete" OnClick="DeleteAsync">@Loc["Delete"]</CapsuleButton>
                <CapsuleButton Class="md-reply" Primary="true" Icon="@Icons.Material.Outlined.Reply" Href="@SharpMUSH.Client.Pages.Mail.ReplyHref(Summary(_message))">@Loc["Reply"]</CapsuleButton>
            }
        </Actions>
    </PlainPageHeader>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_message is null)
    {
        <KitCard>
            <div class="md-missing">@(_error ?? Loc["MailNotFound"])</div>
        </KitCard>
    }
    else
    {
        <KitCard Class="md-card">
            <div class="md-head">
                <span class="md-from">@Loc["From"]: <strong>@_message.From</strong></span>
                @if (_message.Urgent)
                {
                    <Pill Tag="true" Warn="true">@Loc["Urgent"]</Pill>
                }
                <span class="md-date">@_message.DateSent.LocalDateTime.ToString("f")</span>
            </div>
            <div class="md-body">@_message.Body</div>
        </KitCard>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    [SupplyParameterFromQuery(Name = "folder")]
    public string? Folder { get; set; }

    private MailService.MailMessage? _message;
    private string? _error;
    private bool _loading = true;

    private string FolderName => string.IsNullOrWhiteSpace(Folder) ? MailSidebar.Inbox : Folder;

    /// <summary>
    /// A number names a message only within the acting character's mailbox, so a switch of character
    /// reads the new character's message of that number.
    /// </summary>
    private readonly ViewerScopedReload _reload = new();

    protected override void OnInitialized() => _reload.Watch(AccountAuth, () => _ = InvokeAsync(async () =>
    {
        // The message on screen is the previous character's, and its Delete would now act on the new
        // character's message of the same number: it goes before the new one is asked for.
        (_message, _error) = (null, null);
        _loading = true;
        StateHasChanged();
        await LoadAsync();
        StateHasChanged();
    }));

    protected override Task OnParametersSetAsync() => LoadAsync();

    public void Dispose() => _reload.Dispose();

    private Task LoadAsync()
    {
        _loading = true;
        return _reload.LoadAsync(() => Mail.ReadAsync(FolderName, Id), result =>
        {
            _message = result is MailService.MailMessage message ? message : null;
            // A missing message keeps the page's own wording; anything else is the server's reason.
            _error = result is ApiFailure { Kind: not ApiFailureKind.NotFound } failure ? failure.Message : null;
            _loading = false;
        });
    }

    private static MailService.MailSummary Summary(MailService.MailMessage m) =>
        new(m.Number, m.From, m.Subject, m.DateSent, m.Read, m.Urgent, m.Folder);

    private async Task DeleteAsync()
    {
        if (_message is null) return;
        switch (await Mail.DeleteAsync(FolderName, Id))
        {
            case Success:
                Snackbar.Add(Loc["MailDeleted"], Severity.Success);
                // Back to the folder the message was in, not always the inbox.
                Nav.NavigateTo(MailSidebar.FolderHref(FolderName));
                break;
            case ApiFailure failure:
                Snackbar.Add(Loc["MailDeleteFailed", failure.Message], Severity.Error);
                break;
        }
    }
}
