@page "/play"
@page "/client"
@using SharpMUSH.Client.Layout
@using SharpMUSH.Client.Services
@inject CharacterSessionRegistry Sessions
@inject ClientCharacters Characters
@inject NavigationManager Navigation
@inject ThemeService Themes
@implements IDisposable

@* Play, for the character the tab acts as. Keyed by its session, so a switch that brings another character's
   session to the front mounts Play afresh over it, every part of the page reading that character; the session
   left behind keeps its connection, its output and its unsent line. /client is the same page with the account's
   characters in the rail (MainLayout), each connected; there a switch keeps every character connected. *@
@if (Sessions.KeepsSessions)
{
    @* The page keeps one theme; the character in front has its own on Play's card and widget column. *@
    <SharpMUSH.Client.Components.Theme.CharacterThemeArea Session="Sessions.Focused">
        <Play @key="Sessions.Focused" Client="_client" />
    </SharpMUSH.Client.Components.Theme.CharacterThemeArea>
}
else
{
    <Play @key="Sessions.Focused" />
}

@code {
    /// <summary>On /client: the characters lead the menu, as the rail (MainLayout) leads a desktop.</summary>
    private bool _client;

    protected override void OnInitialized()
    {
        Sessions.FocusChanged += OnFocusChanged;
        // /play and /client are one page: going from one to the other keeps it and sets no parameter, so the route is
        // read again here rather than in OnParametersSet.
        Navigation.LocationChanged += OnLocationChanged;
        ReadRoute();
    }

    private void ReadRoute()
    {
        _client = ShellRouting.IsClientRoute(Navigation.Uri);
        if (_client) Sessions.KeepsSessions = true;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(() =>
    {
        ReadRoute();
        StateHasChanged();
    });

    // Every render, not the first only: /play to /client keeps this page, and restoring is done once a page load.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Sessions.KeepsSessions) return;
        // Until the acting character is known (a reload reads it after the first render) there is nothing to hold.
        Themes.HoldPage();
        await Characters.ConnectAllAsync();
    }

    private void OnFocusChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Sessions.FocusChanged -= OnFocusChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
