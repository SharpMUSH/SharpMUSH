@page "/play"
@using SharpMUSH.Client.Components
@using SharpMUSH.Client.Components.Play
@using SharpMUSH.Client.Components.Scenes
@using SharpMUSH.Client.Components.Widgets
@using SharpMUSH.Client.Models
@using SharpMUSH.Client.Models.Widgets
@using SharpMUSH.Client.Services
@using System.Globalization
@inject IStringLocalizer<SharedResource> Loc
@inject IPlayTerminalService PlayTerminal
@inject AccountAuthService AccountAuth
@inject ICommFeed Comms
@inject ILayoutService Layouts
@inject ApplicationCatalog Catalog
@inject IWidgetRegistry Widgets
@inject IServiceProvider ServiceProvider
@using SharpMUSH.Client.Widgets
@using SharpMUSH.Client.Components.Layout
@using SharpMUSH.Client.Models.Applications
@using SharpMUSH.Library.Models.Portal.Widgets
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@Loc["Play"] — @Loc["AppTitle"]</PageTitle>

@* Four states, resolved before anything mounts. An anonymous visitor and a player with a
   character both get the terminal (the guest/character distinction is GlobalTerminal's job); an
   account holding NO character used to get the terminal too — blank, permanently "not connected",
   with a Connect button that could never succeed and nothing saying why. That case gets the same
   treatment /mail already gives it: say what is missing, and offer the one action that fixes it.
   A roster request that FAILED is the fourth state and deliberately not folded into the third:
   "you have no character, create one" is an assertion about the account, and a page that never got
   an answer must not make it. *@
@if (!_rosterResolved)
{
    <div class="play-gate full-height">
        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
    </div>
}
else if (_rosterFailed)
{
    <div class="play-gate full-height">
        <EmptyState Class="play-gate-card">
            <MudText>@Loc["NavPlayRosterUnavailable"]</MudText>
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="RetryRosterAsync" Class="mt-2">
                @Loc["NavTryAgain"]
            </MudButton>
        </EmptyState>
    </div>
}
else if (_needsCharacter)
{
    <div class="play-gate full-height">
        <EmptyState Class="play-gate-card">
            <MudText>@Loc["NavPlayNeedsCharacter"]</MudText>
            <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/characters/new" Class="mt-2">
                @Loc["NavCreateCharacter"]
            </MudButton>
        </EmptyState>
    </div>
}
else
{
    @* D1 §5 (boards 01–11): the Play sidebar in the shell's page-sidebar slot; main is the room banner
       and the scene card (Story | Terminal, focus mode, the composer); the aside is Here then Exits.
       Focus mode steps the sidebar, the banner and the aside away, and the shell chrome with them
       (shell.css: the rail, the touch header, the zones). Below the narrow tier the aside
       becomes the Room sheet and Play has its own tabs. The terminal stays mounted in both views, so
       switching never drops its output or its connection. *@
    <SectionShell Key="play" NavLabel="@Loc["Play"]" PadBody="false" Hidden="@_focus" Nav="SidebarNav">
        <div class="play full-bleed full-height @(_focus ? "play--focus" : null)">
            <div class="play-main">
                @if (BannerShown)
                {
                    <RoomBanner Info="@Room.Info" Here="@Room.Occupants.Count" Exits="@Room.Exits.Count"
                                Minimised="@BannerMinimised" MinimisedChanged="OnBannerMinimisedAsync" />
                }
                @if (_commKey is { } commKey)
                {
                    <div class="play-comm">
                        <CommView Key="@commKey" OnSend="SendAsync" OnClose="CloseComm" />
                    </div>
                }
                @* Hidden, not removed, under the channel view: the terminal keeps its connection and output. *@
                <div class="play-card" hidden="@(_commKey is not null)">
                    <PlaySceneCard Title="@ViewerName" Subtitle="@CardSubtitle" HeaderImage="@CardImage"
                                   OnSubtitle="@(BannerFolded ? EventCallback.Factory.Create(this, OpenFoldedBanner) : default)"
                                   SubtitleAction="@Loc["NavBannerRestore"]" InScene="@InScene" View="@View" ViewChanged="OnViewChanged" Focus="@_focus" FocusChanged="OnFocusChanged">
                        <Lead>@ViewerAvatar</Lead>
                        <Controls>
                            @if (View == PlayView.Terminal)
                            {
                                @TerminalSettings
                            }
                            @ConnectionControl
                        </Controls>
                        <ChildContent>
                            <div class="play-views">
                                @if (Room.Info?.Scene is { } scene)
                                {
                                    <div class="play-view play-story @(View == PlayView.Story ? null : "play-view--off")" inert="@(View != PlayView.Story)">
                                        @if (StoryLiveUnavailable)
                                        {
                                            <div class="play-story-unavailable" role="status">@Loc["RolSceneLiveUnavailable"]</div>
                                        }
                                        <div class="play-story-scroll">
                                            <SceneStory SceneId="@scene.Id" Occupants="@Room.Occupants" ViewerName="@PlayTerminal.ConnectedPlayerName"
                                                        OnCharacter="OpenSheetByName" LiveUnavailableChanged="unavailable => OnLiveUnavailable(scene.Id, unavailable)" />
                                        </div>
                                    </div>
                                }
                                <div class="play-view play-terminal @(View == PlayView.Terminal ? null : "play-view--off")" inert="@(View != PlayView.Terminal)">
                                    <GlobalTerminal @ref="_playTerm" Terminal="PlayTerminal" ShowDiagnostics="false"
                                                    TargetColumns="_targetCols" ShowClearButton="false" ShowConnectionBar="false" AllowGuest="true" />
                                </div>
                            </div>
                        </ChildContent>
                        <Footer>
                            @if (View == PlayView.Story)
                            {
                                <PlayComposer @ref="_composer" Connected="@(PlayTerminal.IsConnected && !StoryLiveUnavailable)" OnSend="SendAsync" />
                            }
                        </Footer>
                    </PlaySceneCard>
                </div>
            </div>
            @* Hidden rather than removed in focus mode: the exit keys live with the Exits card. *@
            <aside class="play-aside" aria-label="@Loc["NavPlayTabRoom"]" hidden="@_focus">
                @* README §7.4: the aside is the "play" layout scope (Here, then Exits, by default), then the game's
                   panels registered for the Play scope that the layout does not already place. The same entries
                   as the Room sheet, so the role and zone rules hold in both. *@
                <CascadingValue Value="_pageContext" IsFixed="true">
                    @foreach (var entry in _asideEntries.Where(e => e.Placed))
                    {
                        <WidgetErrorBoundary WidgetName="@entry.Name">
                            <DynamicComponent Type="@entry.Widget.ComponentType" Parameters="@EntryParameters(entry)" />
                        </WidgetErrorBoundary>
                    }
                    @foreach (var app in _scopePanels)
                    {
                        <KitCard Aside="true" Title="@app.DisplayName" Class="play-panel">
                            <SchemaWidget WidgetName="@app.Slug" Zone="@nameof(WidgetZone.RightSidebar)" />
                        </KitCard>
                    }
                </CascadingValue>
            </aside>
            <nav class="play-tabs" aria-label="@Loc["NavPlayTabs"]">
                <button type="button" class="play-tab @(_mobileSheet is null ? "play-tab--on" : null)" aria-pressed="@(_mobileSheet is null ? "true" : "false")"
                        @onclick="() => _mobileSheet = null">
                    <MudIcon Icon="@Icons.Material.Outlined.Theaters" Size="Size.Small" /><span>@Loc["NavPlayTabScene"]</span>
                </button>
                <button type="button" class="play-tab @(_mobileSheet == MobileSheet.Room ? "play-tab--on" : null)" aria-pressed="@(_mobileSheet == MobileSheet.Room ? "true" : "false")"
                        @onclick="() => OpenMobileSheetAsync(MobileSheet.Room)">
                    <MudIcon Icon="@Icons.Material.Outlined.MeetingRoom" Size="Size.Small" /><span>@Loc["NavPlayTabRoom"]</span>
                </button>
                <button type="button" class="play-tab @(_mobileSheet == MobileSheet.Channels ? "play-tab--on" : null)" aria-pressed="@(_mobileSheet == MobileSheet.Channels ? "true" : "false")"
                        @onclick="() => OpenMobileSheetAsync(MobileSheet.Channels)">
                    <span class="play-tab-hash" aria-hidden="true">#</span><span>@Loc["NavPlayChannels"]</span>
                    @Badge(Comms.Channels.Where(c => c.Joined).Sum(c => c.Unread))
                </button>
                <button type="button" class="play-tab @(_mobileSheet == MobileSheet.Pages ? "play-tab--on" : null)" aria-pressed="@(_mobileSheet == MobileSheet.Pages ? "true" : "false")"
                        @onclick="() => OpenMobileSheetAsync(MobileSheet.Pages)">
                    <MudIcon Icon="@Icons.Material.Outlined.ChatBubbleOutline" Size="Size.Small" /><span>@Loc["NavPlayPages"]</span>
                    @Badge(Comms.Conversations.Sum(c => c.Unread))
                </button>
            </nav>
        </div>
    </SectionShell>

    @if (_mobileSheet is { } sheet)
    {
        <MudOverlay Visible="true" LockScroll="true" OnClick="CloseMobileSheet" Style="background: rgba(8, 9, 10, 0.55); align-items: flex-end;">
            <div class="play-sheet" role="dialog" aria-modal="true" aria-label="@SheetLabel(sheet)" tabindex="-1"
                 @onclick:stopPropagation="true" @onkeydown="OnMobileSheetKey">
                <MudFocusTrap DefaultFocus="DefaultFocus.FirstChild">
                    <div class="play-sheet-grip" aria-hidden="true"></div>
                    @if (sheet == MobileSheet.Room)
                    {
                        @* The Room sheet is the aside on a phone (§5.9): one tab per entry of the play layout, then the
                           scope panels, each rendered as the aside renders it but in sheet mode. *@
                        <div class="play-sheet-tabs" role="tablist">
                            @foreach (var entry in _asideEntries)
                            {
                                var e = entry;
                                var on = e.Name == _sheetEntry;
                                <button type="button" role="tab" id="@($"play-tab-{e.Name}")" aria-controls="play-panel-room" aria-selected="@(on ? "true" : "false")"
                                        class="play-sheet-tab @(on ? "play-sheet-tab--on" : null)" @onclick="() => _sheetEntry = e.Name">
                                    @TabLabel(e)
                                </button>
                            }
                        </div>
                        <div class="play-sheet-body" role="tabpanel" id="play-panel-room" aria-labelledby="@($"play-tab-{_sheetEntry}")">
                            <CascadingValue Value="_sheetContext" IsFixed="true">
                                @if (_asideEntries.FirstOrDefault(e => e.Name == _sheetEntry) is { } shown)
                                {
                                    <DynamicComponent Type="@shown.Widget.ComponentType" Parameters="@EntryParameters(shown)" />
                                }
                            </CascadingValue>
                        </div>
                    }
                    else
                    {
                        <div class="play-sheet-body">
                            <PlaySidebar CharacterName="@PlayTerminal.ConnectedPlayerName" Connected="@PlayTerminal.IsConnected" Room="@Room.Info"
                                         Current="@SidebarCurrent" OnOpenScene="OpenSceneFromSheet" OnOpen="OpenCommFromSheet" />
                        </div>
                    }
                </MudFocusTrap>
            </div>
        </MudOverlay>
    }

    <CharacterSheet Name="@_sheetName" Occupant="@_sheetOccupant" SceneId="@Room.Info?.Scene?.Id" OnClose="CloseSheet"
                    OnCommand="SendAsync" OnPage="StartPageAsync" Details="SheetDetails" />
}

@code {
    private GlobalTerminal? _playTerm;
    private PlayComposer? _composer;
    private RoomState Room = RoomState.Empty;

    /// <summary>The player's choice of view in a scene; null until they choose (Story, by default).</summary>
    private PlayView? _chosenView;

    private bool _focus;
    private bool _bannerMinimised;

    /// <summary>A phone, either way up (layout.js compactScreenQuery): the banner folds into the card header.</summary>
    private bool _compactScreen;

    /// <summary>The player opened the full banner on the compact screen; dropped when the screen changes tier.</summary>
    private bool _compactScreenBannerOpen;

    /// <summary>
    /// On a compact screen the banner folds into the card header, whose sub-line names the room and opens the
    /// full banner: one header row instead of a banner over a header, the same either way up.
    /// </summary>
    private bool BannerFolded => _compactScreen && !_compactScreenBannerOpen && !_focus;

    private bool BannerShown => !_focus && !BannerFolded;

    private void OpenFoldedBanner() => _compactScreenBannerOpen = true;

    private DotNetObjectReference<Play>? _self;

    /// <summary>
    /// On a compact screen the banner is folded into the card header unless the player opened it, and then it
    /// is the full banner: its minimise folds it again. That choice lasts until the screen changes tier and is
    /// not remembered, so it does not change the banner on a larger screen.
    /// </summary>
    private bool BannerMinimised => !_compactScreen && _bannerMinimised;
    private string? _sheetName;
    private RoomOccupant? _sheetOccupant;

    private enum MobileSheet { Room, Channels, Pages }

    private MobileSheet? _mobileSheet;
    /// <summary>One aside entry: a layout placement or a scope panel, by widget name.</summary>
    /// <param name="Placed">From the play layout; otherwise a scope panel the page appends.</param>
    private sealed record AsideEntry(string Name, IPortalWidget Widget, System.Text.Json.JsonElement? Config, bool Placed);

    /// <summary>The play layout's aside, then the scope panels it does not place, as the Room sheet's tabs.</summary>
    private IReadOnlyList<AsideEntry> _asideEntries = [];

    /// <summary>The minimum-role gate for the aside and the Room sheet, the one every zone applies.</summary>
    private ApplicationWidgetGate? _asideGate;

    private ApplicationWidgetGate AsideGate => _asideGate ??= new ApplicationWidgetGate(Widgets, ServiceProvider);

    /// <summary>The Room sheet's current tab: Exits when there is one (board 11), else the first.</summary>
    private string? _sheetEntry;

    /// <summary>The sheet's variant of the page context: sheet mode, and a send that closes the sheet.</summary>
    private PlayPageContext _sheetContext = null!;

    private bool InScene => Room.Info?.Scene is not null;

    /// <summary>What the play-scope widgets may do on this page: open the sheet, send a command.</summary>
    private PlayPageContext _pageContext = null!;

    /// <summary>Widget apps registered for the Play scope that the play layout does not place itself.</summary>
    private IReadOnlyList<PortalApplication> _scopePanels = [];

    /// <summary>The scene whose live subscription the hub refused, as SceneStory reported it.</summary>
    private string? _liveRefusedFor;

    /// <summary>
    /// This client cannot receive the room scene's poses (a guest, or a character that cannot see it):
    /// the Story says so and its composer does not send, as on the live scene page — a pose sent from
    /// here would be posted and never appear. The terminal view still takes commands.
    /// </summary>
    private bool StoryLiveUnavailable => Room.Info?.Scene?.Id is { } id && id == _liveRefusedFor;

    private void OnLiveUnavailable(string sceneId, bool unavailable)
    {
        if (unavailable) _liveRefusedFor = sceneId;
        else if (_liveRefusedFor == sceneId) _liveRefusedFor = null;
    }

    /// <summary>Story in a scene unless the player chose Terminal; outside a scene there is only the terminal.</summary>
    private PlayView View => InScene ? _chosenView ?? PlayView.Story : PlayView.Terminal;

    /// <summary>The sidebar's current row: the In scene row only while the Story is shown.</summary>
    private string? SidebarCurrent => _commKey ?? (View == PlayView.Story ? null : string.Empty);

    /// <summary>The channel or conversation main is showing (board 06), or null for the scene card.</summary>
    private string? _commKey;

    /// <summary>
    /// The card is headed by who the player is playing, the way the terminal's connection row named them:
    /// the connected character, else the account's active one. The room's name is the banner's job.
    /// </summary>
    private string ViewerName =>
        PlayTerminal.ConnectedPlayerName is { Length: > 0 } connected ? connected
        : SelfRow?.Name is { Length: > 0 } self ? self
        : AccountAuth.ActiveCharacter?.Name is { Length: > 0 } active ? active
        : Loc["TermNotLoggedIn"];

    /// <summary>
    /// The viewer's row in the room's contents while connected. It names a guest, whose character the
    /// server chooses, so nothing on the client knows it otherwise.
    /// </summary>
    private RoomOccupant? SelfRow => PlayTerminal.IsConnected ? Room.Occupants.FirstOrDefault(o => o.You) : null;

    /// <summary>The scene's title in a scene; outside one, the room's name only while no banner shows it.</summary>
    private string? CardSubtitle =>
        Room.Info?.Scene?.Title is { Length: > 0 } scene ? scene
        : BannerShown ? null
        : Room.Info?.Name;

    /// <summary>The room's picture behind the card header, while no banner shows it.</summary>
    private string? CardImage =>
        !BannerShown && Room.Info?.Image?.Url is { } url && ImageUrlPolicy.IsRenderable(url) ? url : null;

    /// <summary>The viewer's own picture from the room's contents (the row marked as them).</summary>
    private ImageRef? ViewerImage => SelfRow?.Image;

    /// <summary>A small avatar with a connection dot: the picture, else the name's initial on its hue.</summary>
    private RenderFragment ViewerAvatar => __builder =>
    {
        var connected = PlayTerminal.IsConnected;
        var image = ViewerImage;
        var hue = NameHue.Of(ViewerName);
        <span class="play-me @(connected ? "play-me--on" : null)">
            @if (image is not null && ImageUrlPolicy.IsRenderable(image.Url))
            {
                <img class="play-me-img" src="@ApiUrl.Resolve(image.Url)" alt="" />
            }
            else
            {
                <span class="play-me-initial" aria-hidden="true" style="@($"background:hsl({hue} 30% 24%);color:hsl({hue} 45% 82%);")">@Initial(ViewerName)</span>
            }
            <span class="play-me-dot" title="@(connected ? Loc["Connected"] : Loc["Disconnected"])"></span>
            <span class="play-me-status">@(connected ? Loc["Connected"] : Loc["Disconnected"])</span>
        </span>
    };

    private static string Initial(string name) =>
        name.FirstOrDefault(char.IsLetterOrDigit) is var c && c != default ? char.ToUpperInvariant(c).ToString() : "?";

    /// <summary>The connection row's buttons, in the card header: Disconnect, Connect, or Login for a visitor.</summary>
    private RenderFragment ConnectionControl => __builder =>
    {
        if (PlayTerminal.IsConnected)
        {
            <button type="button" class="play-conn" aria-label="@Loc["Disconnect"]" title="@Loc["Disconnect"]" @onclick="DisconnectAsync">
                <MudIcon Icon="@Icons.Material.Filled.PowerSettingsNew" Size="Size.Small" />
            </button>
        }
        else if (AccountAuth.IsLoggedIn)
        {
            <button type="button" class="play-conn play-conn--connect" @onclick="ConnectAsync">@Loc["Connect"]</button>
        }
        else
        {
            <a class="play-conn play-conn--connect" href="/login">@Loc["Login"]</a>
        }
    };

    private Task ConnectAsync() => _playTerm?.ConnectAsync() ?? Task.CompletedTask;

    private Task DisconnectAsync() => _playTerm?.DisconnectAsync() ?? Task.CompletedTask;

    private RenderFragment<bool> SidebarNav => collapsed =>
        @<PlaySidebar Collapsed="collapsed" CharacterName="@PlayTerminal.ConnectedPlayerName" Connected="@PlayTerminal.IsConnected"
                      Room="@Room.Info" Current="@SidebarCurrent" OnOpenScene="OpenScene" OnOpen="OpenComm" />;

    private RenderFragment<string> SheetDetails => name =>
        @<CascadingValue Value="@(new ProfilePageContext(name, false))">
            <SchemaWidget WidgetName="character-header" />
        </CascadingValue>;

    private RenderFragment Badge(int unread) => __builder =>
    {
        @if (unread > 0)
        {
            <span class="play-tab-badge" aria-label="@Loc.Plural("NavUnreadCount", "count", unread)">@unread</span>
        }
    };

    private string SheetLabel(MobileSheet sheet) => sheet switch
    {
        MobileSheet.Room => Loc["NavPlayTabRoom"],
        MobileSheet.Channels => Loc["NavPlayChannels"],
        _ => Loc["NavPlayPages"],
    };

    private RenderFragment TerminalSettings => __builder =>
    {
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true">
            <ActivatorContent>
                <button type="button" class="play-settings-btn" @onclick="@context.ToggleAsync"
                        title="@Loc["NavTerminalSettings"]" aria-label="@Loc["NavTerminalSettings"]">
                    <MudIcon Icon="@Icons.Material.Outlined.Tune" Size="Size.Small" />
                </button>
            </ActivatorContent>
            <ChildContent>
                <div class="play-cfg" @onclick:stopPropagation="true">
                    <div class="play-cfg-kicker">@Loc["Terminal"]</div>
                    <label class="play-cfg-row" title="@Loc["NavTerminalWidthTooltip"]">
                        <span>@Loc["NavTerminalWidthCols"]</span>
                        <input class="play-cols-input" type="number" min="78" max="240" step="1"
                               value="@_targetCols" @onchange="OnColsChanged" />
                    </label>
                    <button type="button" class="play-cfg-item" @onclick="ClearTerminal">
                        <MudIcon Icon="@Icons.Material.Filled.ClearAll" Style="font-size:1rem;" />
                        <span>@Loc["TermClearTerminal"]</span>
                    </button>
                </div>
            </ChildContent>
        </MudMenu>
    };

    private void ClearTerminal() => _playTerm?.ClearOutput();

    // The player's preferred terminal width in columns (min 78). The terminal autoscales its
    // font to fill this many columns; the value is also what the client reports over NAWS.
    // Persisted per-browser in localStorage, with the banner's minimised state.
    private const int MinCols = 78;
    private const int MaxCols = 240;
    private const string BannerKey = "play.banner";
    private int _targetCols = MinCols;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var changed = false;
        var stored = await JS.GetItemAsync(BrowserStore.Local, "play.cols");
        if (int.TryParse(stored, out var n))
        {
            var clamped = Math.Clamp(n, MinCols, MaxCols);
            changed |= clamped != _targetCols;
            _targetCols = clamped;
        }
        if (await JS.GetItemAsync(BrowserStore.Local, BannerKey) == "min")
        {
            changed |= !_bannerMinimised;
            _bannerMinimised = true;
        }
        _self = DotNetObjectReference.Create(this);
        try
        {
            var compactScreen = await JS.InvokeAsync<bool>("sharpmushLayout.watchCompactScreen", _self);
            changed |= compactScreen != _compactScreen;
            _compactScreen = compactScreen;
        }
        catch (JSException)
        {
            // No layout script (prerender, tests): the banner follows the stored choice.
        }
        if (changed) StateHasChanged();
    }

    /// <summary>The screen turned into or out of the short tier (layout.js watchCompactScreen).</summary>
    [JSInvokable]
    public Task OnCompactScreenChanged(bool compactScreen) => InvokeAsync(() =>
    {
        _compactScreen = compactScreen;
        _compactScreenBannerOpen = false;
        StateHasChanged();
    });

    private async Task OnColsChanged(ChangeEventArgs e)
    {
        _targetCols = int.TryParse(e.Value?.ToString(), out var n)
            ? Math.Clamp(n, MinCols, MaxCols)
            : MinCols;
        await JS.SetItemAsync(BrowserStore.Local, "play.cols", _targetCols.ToString(CultureInfo.InvariantCulture));
    }

    private async Task OnBannerMinimisedAsync(bool minimised)
    {
        if (_compactScreen)
        {
            _compactScreenBannerOpen = !minimised;
            return;
        }
        _bannerMinimised = minimised;
        await JS.SetItemAsync(BrowserStore.Local, BannerKey, minimised ? "min" : "open");
    }

    private void OnViewChanged(PlayView view) => _chosenView = view;

    private void OnFocusChanged(bool focus) => _focus = focus;

    // Whether the account-vs-roster question has been answered yet, and its answer. All three start
    // "unknown"/false so the terminal is not mounted — and no dead Connect button rendered — until
    // we know which state this visitor is in.
    private bool _rosterResolved;
    private bool _needsCharacter;
    private bool _rosterFailed;

    protected override void OnInitialized()
    {
        PlayTerminal.ConnectionStateChanged += OnConnectionChanged;
        PlayTerminal.OobChannels.RoomChanged += OnRoomChanged;
        Comms.Changed += OnCommsChanged;
        Room = PlayTerminal.OobChannels.Room;
        _pageContext = new PlayPageContext(
            occupant => InvokeAsync(() => { OpenSheet(occupant); StateHasChanged(); }),
            SendAsync);
        _sheetContext = new PlayPageContext(
            occupant => InvokeAsync(() => { OpenSheetFromRoom(occupant); StateHasChanged(); }),
            command => InvokeAsync(async () => { await SendFromSheetAsync(command); StateHasChanged(); }),
            InSheet: true);
        Layouts.OnLayoutChanged += OnLayoutChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await ResolveRosterAsync();
        await LoadAsideAsync();
    }

    /// <summary>
    /// The aside's entries from the play layout, then the widget apps registered for the Play scope that the
    /// layout does not place, that allow the right sidebar, and that the viewer's role allows. An application
    /// the layout places keeps its minimum role too: placing it is not granting it. The placed entries go
    /// through the same <see cref="ApplicationWidgetGate"/> as every zone, so one the catalog has not delivered
    /// yet joins only once its application is found and admits this viewer. Re-read when an admin changes the
    /// layout.
    /// </summary>
    private async Task LoadAsideAsync()
    {
        var layout = await Layouts.GetLayoutAsync(LayoutScopes.Play);
        var role = AuthState is null ? SharpMUSH.Library.Authorization.PortalRole.Guest : PortalRoleHelper.CurrentRole((await AuthState).User);
        var placements = (layout.Zones.TryGetValue(WidgetZone.RightSidebar, out var list) ? list : [])
            .OrderBy(p => p.Order)
            .ToList();

        BuildAside(placements, role);
        if (await AsideGate.ResolveAsync(placements.Select(p => p.WidgetName)))
        {
            BuildAside(placements, role);
            StateHasChanged();
        }
    }

    private void BuildAside(List<WidgetPlacement> placements, SharpMUSH.Library.Authorization.PortalRole role)
    {
        var placed = placements.Select(p => p.WidgetName).ToHashSet(StringComparer.OrdinalIgnoreCase);
        _scopePanels = Catalog.ForScope(LayoutScopes.Play)
            .Where(a => role >= a.MinimumRoleEnum)
            .Where(a => a.KindEnum == SharpMUSH.Library.Models.Portal.Applications.ApplicationKind.Widget && !placed.Contains(a.Slug))
            .Where(a => a.ZoneEnums.Contains(WidgetZone.RightSidebar))
            .ToList();

        var entries = new List<AsideEntry>();
        foreach (var placement in placements.Where(p => AsideGate.Admits(p.WidgetName, role)))
        {
            if (Widgets.GetWidget(placement.WidgetName) is { } widget) entries.Add(new AsideEntry(placement.WidgetName, widget, placement.Config, Placed: true));
        }
        foreach (var app in _scopePanels)
        {
            if (Widgets.GetWidget(app.Slug) is { } widget) entries.Add(new AsideEntry(app.Slug, widget, null, Placed: false));
        }
        _asideEntries = entries;
        if (_sheetEntry is null || entries.All(e => e.Name != _sheetEntry))
        {
            _sheetEntry = entries.FirstOrDefault(e => e.Name == "Exits")?.Name ?? entries.FirstOrDefault()?.Name;
        }
    }

    private void OnLayoutChanged(string scope)
    {
        if (!string.Equals(scope, LayoutScopes.Play, StringComparison.OrdinalIgnoreCase)) return;
        _ = InvokeAsync(async () =>
        {
            await LoadAsideAsync();
            StateHasChanged();
        });
    }

    private string TabLabel(AsideEntry entry) => entry.Name switch
    {
        "Here" => $"{Loc["TermBrowserHere"]} · {Room.Occupants.Count(o => !o.You)}",
        "Exits" => $"{Loc["NavExits"]} · {Room.Exits.Count}",
        _ => Catalog.Get(entry.Name)?.DisplayName ?? Loc[entry.Widget.DisplayName],
    };

    /// <summary>The parameters ZoneRenderer passes a widget, built by the same gate.</summary>
    private Dictionary<string, object> EntryParameters(AsideEntry entry) =>
        AsideGate.Parameters(entry.Name, entry.Widget, entry.Config, nameof(WidgetZone.RightSidebar));

    private async Task ResolveRosterAsync()
    {
        _needsCharacter = false;
        _rosterFailed = false;

        // InitAsync is cached per tab, so this costs a task await once the session has hydrated.
        // It restores the session token but NOT the roster (see AccountAuthService.InitCoreAsync),
        // so a reloaded tab always has to ask the server who this account owns — exactly what
        // GlobalTerminal does before deciding whether it can connect.
        await AccountAuth.InitAsync();

        if (AccountAuth.IsLoggedIn && AccountAuth.Characters.Count == 0)
        {
            if (await AccountAuth.GetCharactersAsync() is IReadOnlyList<AccountAuthService.CharacterSummary> characters)
                _needsCharacter = characters.Count == 0;
            else
                _rosterFailed = true;
        }

        _rosterResolved = true;
    }

    /// <summary>Re-asks the server for the roster, back through the loading state so the failed
    /// card cannot sit there looking answered while the retry is in flight.</summary>
    private async Task RetryRosterAsync()
    {
        _rosterResolved = false;
        await ResolveRosterAsync();
    }

    private void OnConnectionChanged(bool _) => InvokeAsync(StateHasChanged);

    private void OnCommsChanged() => InvokeAsync(StateHasChanged);

    // The store keeps the room typed and replaces each list whole on every push, so this reads one
    // snapshot rather than parsing the payloads again.
    private void OnRoomChanged()
    {
        Room = PlayTerminal.OobChannels.Room;
        InvokeAsync(StateHasChanged);
    }

    private async Task SendAsync(string command)
    {
        if (!string.IsNullOrWhiteSpace(command))
            await PlayTerminal.SendAsync(command);
    }

    private async Task SendFromSheetAsync(string command)
    {
        _mobileSheet = null;
        await SendAsync(command);
    }

    private void OpenSheet(RoomOccupant occupant)
    {
        _sheetOccupant = occupant;
        _sheetName = occupant.Name;
    }

    private void OpenSheetFromRoom(RoomOccupant occupant)
    {
        _mobileSheet = null;
        OpenSheet(occupant);
    }

    /// <summary>A name from the story: their room row when they are here, else just the name.</summary>
    private void OpenSheetByName(string name)
    {
        _sheetOccupant = Room.Occupants.FirstOrDefault(o => string.Equals(o.Name, name, StringComparison.OrdinalIgnoreCase));
        _sheetName = name;
    }

    private void CloseSheet()
    {
        _sheetName = null;
        _sheetOccupant = null;
    }

    /// <summary>
    /// The sheet's Page: the composer in Story, the terminal's own line otherwise. The room row's Page action
    /// (<c>page #312=</c>) is used when it has one: a dbref survives a rename and a name with spaces.
    /// </summary>
    private async Task StartPageAsync(string name)
    {
        var action = _sheetOccupant?.Actions.FirstOrDefault(a => string.Equals(a.Label, "Page", StringComparison.OrdinalIgnoreCase))?.Cmd;
        CloseSheet();
        if (View == PlayView.Story && _composer is not null)
        {
            await _composer.StartPageAsync(name, action);
        }
        else if (_playTerm is not null)
        {
            await _playTerm.SetInputAsync(action ?? $"page {name}=");
        }
    }

    private void OpenScene()
    {
        _commKey = null;
        _chosenView = PlayView.Story;
    }

    /// <summary>A channel or conversation opens the channel view in main (README §5.1, board 06).</summary>
    private void OpenComm(string key) => _commKey = key;

    private void CloseComm() => _commKey = null;

    private void OpenSceneFromSheet()
    {
        _mobileSheet = null;
        OpenScene();
    }

    private void OpenCommFromSheet(string key)
    {
        _mobileSheet = null;
        OpenComm(key);
    }

    /// <summary>Opens a phone sheet, remembering what opened it so closing can hand focus back.</summary>
    private async Task OpenMobileSheetAsync(MobileSheet sheet)
    {
        await RunFocusAsync("sharpmushLayout.rememberFocus");
        _mobileSheet = sheet;
    }

    private async Task CloseMobileSheet()
    {
        _mobileSheet = null;
        await RunFocusAsync("sharpmushLayout.restoreFocus");
    }

    // No preventDefault: it is decided at render time and would swallow the next key.
    private async Task OnMobileSheetKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await CloseMobileSheet();
    }

    private async Task RunFocusAsync(string identifier)
    {
        try { await JS.InvokeVoidAsync(identifier); }
        catch (JSException) { }
        catch (InvalidOperationException) { }
    }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    public async ValueTask DisposeAsync()
    {
        Layouts.OnLayoutChanged -= OnLayoutChanged;
        PlayTerminal.ConnectionStateChanged -= OnConnectionChanged;
        PlayTerminal.OobChannels.RoomChanged -= OnRoomChanged;
        Comms.Changed -= OnCommsChanged;
        if (_self is null) return;
        try
        {
            await JS.InvokeVoidAsync("sharpmushLayout.unwatchCompactScreen");
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException)
        {
            // The page is going away; so is the listener's reason to call it.
        }
        _self.Dispose();
    }
}
