@page "/play"
@using SharpMUSH.Client.Components
@using SharpMUSH.Client.Components.Play
@using SharpMUSH.Client.Components.Scenes
@using SharpMUSH.Client.Components.Widgets
@using SharpMUSH.Client.Models
@using SharpMUSH.Client.Models.Widgets
@using SharpMUSH.Client.Services
@inject IStringLocalizer<SharedResource> Loc
@inject IPlayTerminalService PlayTerminal
@inject TerminalLog TerminalLog
@inject AccountAuthService AccountAuth
@inject ICommFeed Comms
@inject ILayoutService Layouts
@inject ApplicationCatalog Catalog
@inject IWidgetRegistry Widgets
@inject IServiceProvider ServiceProvider
@using SharpMUSH.Client.Widgets
@using SharpMUSH.Client.Components.Layout
@using SharpMUSH.Client.Models.Applications
@using SharpMUSH.Library.Models.Portal.Widgets
@inject IJSRuntime JS
@inject ServerInfoService ServerInfo
@inject ScreenReaderMode ScreenReader
@implements IAsyncDisposable

<PageTitle>@Loc["Play"] — @Loc["AppTitle"]</PageTitle>

@* Four states, resolved before anything mounts. An anonymous visitor and a player with a
   character both get the terminal (the guest/character distinction is GlobalTerminal's job); an
   account holding NO character used to get the terminal too — blank, permanently "not connected",
   with a Connect button that could never succeed and nothing saying why. That case gets the same
   treatment /mail already gives it: say what is missing, and offer the one action that fixes it.
   A roster request that FAILED is the fourth state and deliberately not folded into the third:
   "you have no character, create one" is an assertion about the account, and a page that never got
   an answer must not make it. *@
@if (Gate is { } gate)
{
    <PlayGate State="gate" OnRetry="RetryRosterAsync" />
}
else
{
    @* D1 §5 (boards 01–11): the Play sidebar in the shell's page-sidebar slot; main is the scene card, headed by
       the room banner when it is open (Story | Terminal, focus mode, the composer); the aside is Here then Exits.
       Focus mode steps the sidebar, the banner and the aside away, and the shell chrome with them
       (shell.css: the rail, the touch header, the zones). On a phone Play is laid out like a chat app: the
       card header is the one bar, its menu button opens Play's sidebar from the left (with the site menu at
       its top), and below the narrow tier its people button opens the Room panel (the aside) from the right. The terminal stays mounted in both views, so
       switching never drops its output or its connection. *@
    <SectionShell Key="play" NavLabel="@Loc["Play"]" PadBody="false" Hidden="@_focus" Nav="SidebarNav">
        <div class="play full-height @(_focus ? "play--focus" : null) @(_shortScreen ? "play--short" : null) @(Room.Info is null ? null : "play--room")">
            <div class="play-main">
                @* The open banner's room name is the page's h1; otherwise this one, for the reader alone, so the page
                   has a heading to land on (FocusOnNavigate) and to jump back to. *@
                @if (!BannerShown)
                {
                    <h1 class="visually-hidden">@(Room.Info?.Name is { Length: > 0 } here ? $"{Loc["Play"]}: {here}" : Loc["Play"])</h1>
                }
                @if (_commKey is { } commKey)
                {
                    <div class="play-comm">
                        <CommView Key="@commKey" OnSend="SendAsync" OnClose="CloseComm">
                            <Lead>
                                <PlayHeaderLead Menu="@_touchChrome" Unread="@UnreadComms" OnMenu="OpenSideSheetAsync" />
                            </Lead>
                        </CommView>
                    </div>
                }
                @* Hidden, not removed, under the channel view: the terminal keeps its connection and output. *@
                <div class="play-card" hidden="@(_commKey is not null)">
                    <PlaySceneCard Title="@ViewerName" Subtitle="@CardSubtitle" HeaderImage="@CardImage"
                                   OnSubtitle="@(BannerFolded ? EventCallback.Factory.Create(this, OpenFoldedBanner) : default)"
                                   SubtitleAction="@Loc["NavBannerRestore"]" InScene="@InScene" View="@View" ViewChanged="OnViewChanged" Focus="@_focus" FocusChanged="OnFocusChanged"
                                   Footer="@(View == PlayView.Story ? StoryComposer : null)">
                        <Banner>
                            @* The opened banner is the card's top, not a box of its own above it: one unit over the game. *@
                            @if (BannerShown)
                            {
                                <RoomBanner Info="@Room.Info" Here="@Room.Occupants.Count" Exits="@Room.Exits.Count"
                                            Minimised="false" MinimisedChanged="OnBannerMinimisedAsync" BottomActions="@BannerControls(PlaySettingsMenu.Banner)" />
                            }
                        </Banner>
                        <Lead>
                            <PlayHeaderLead Menu="@_touchChrome" Picture="true" Unread="@UnreadComms" OnMenu="OpenSideSheetAsync"
                                            Name="@ViewerName" ImageUrl="@ViewerImage?.Url" Character="@ViewerCharacter" Connected="@PlayTerminal.IsConnected" />
                        </Lead>
                        <Controls>
                            @* On a phone these step back into the banner's controls row (Play.razor.css). *@
                            <span class="play-head-more">
                                @if (View == PlayView.Terminal)
                                {
                                    @TerminalSettings(PlaySettingsMenu.Header)
                                }
                                else if (SceneHere is { Focus: true })
                                {
                                    @LeaveSceneControl
                                }
                            </span>
                            @* The Room panel (Here, Exits, the scope panels) from the right, like a chat app's member list.
                               Play.razor.css shows it only while the aside is not on screen: below the narrow tier, or in focus mode. *@
                            <PlayControl Class="play-room-btn" Label="@Loc["NavPlayTabRoom"]" Icon="@Icons.Material.Outlined.Group" PopsUp="true"
                                         OnClick="() => OpenMobileSheetAsync(PlaySheet.Room)" />
                            @if (PlayTerminal.IsConnected)
                            {
                                <span class="play-head-more">@ConnectionControl</span>
                            }
                            else
                            {
                                @ConnectionControl
                            }
                        </Controls>
                        <ChildContent>
                            @* A plain click in the story or the output focuses the field below it (input-focus.js). *@
                            <div class="play-views" data-input-region>
                                @if (SceneHere is { } scene)
                                {
                                    <div class="play-view play-story @(View == PlayView.Story ? null : "play-view--off")" inert="@(View != PlayView.Story)">
                                        @if (StoryLiveUnavailable)
                                        {
                                            <div class="play-story-unavailable" role="status">@Loc["RolSceneLiveUnavailable"]</div>
                                        }
                                        else if (_storyLiveDown)
                                        {
                                            @* Posting still works (it goes over the terminal), so the composer stays on. *@
                                            <div class="play-story-unavailable" role="status">@Loc["RolSceneLiveFeedDown"]</div>
                                        }
                                        <div class="play-story-scroll">
                                            <SceneStory SceneId="@scene.Id" Occupants="@Room.Occupants" ViewerName="@PlayTerminal.ConnectedPlayerName"
                                                        OnCharacter="OpenSheetByName" LiveUnavailableChanged="unavailable => OnLiveUnavailable(scene.Id, unavailable)"
                                                        LiveDownChanged="down => _storyLiveDown = down"
                                                        OnEditPose="EditPoseAsync" />
                                        </div>
                                    </div>
                                }
                                <div class="play-view play-terminal @(View == PlayView.Terminal ? null : "play-view--off")" inert="@(View != PlayView.Terminal)">
                                    @if (SceneHere is { } running && _hintHiddenFor != running.Id)
                                    {
                                        <PlaySceneHint Scene="running" OnOpen="OpenScene" OnHide="() => _hintHiddenFor = running.Id" />
                                    }
                                    <GlobalTerminal @ref="_playTerm" Terminal="PlayTerminal" ShowDiagnostics="false"
                                                    TargetColumns="_targetCols" ShowClearButton="false" ShowConnectionBar="false" AllowGuest="true" KeepsLog="true" />
                                </div>
                            </div>
                        </ChildContent>
                    </PlaySceneCard>
                </div>
            </div>
            @* Hidden rather than removed in focus mode: the exit keys live with the Exits card. *@
            <aside class="play-aside" aria-label="@Loc["NavPlayTabRoom"]" hidden="@_focus">
                @* README §7.4: the aside is the "play" layout scope (Here, then Exits, by default), then the game's
                   panels registered for the Play scope that the layout does not already place. The same entries
                   as the Room sheet, so the role and zone rules hold in both. *@
                <CascadingValue Value="_pageContext" IsFixed="true">
                    @foreach (var entry in _asideEntries.Where(e => e.Placed))
                    {
                        <WidgetErrorBoundary WidgetName="@entry.Name">
                            <DynamicComponent Type="@entry.Widget.ComponentType" Parameters="@EntryParameters(entry)" />
                        </WidgetErrorBoundary>
                    }
                    @foreach (var app in _scopePanels)
                    {
                        <KitCard Aside="true" Title="@app.DisplayName" Class="play-panel">
                            <SchemaWidget WidgetName="@app.Slug" Zone="@nameof(WidgetZone.RightSidebar)" />
                        </KitCard>
                    }
                </CascadingValue>
            </aside>
        </div>
    </SectionShell>

    @if (_mobileSheet is { } sheet)
    {
        <PlayMobileSheet Sheet="sheet" Label="@SheetLabel(sheet)" OnClose="CloseMobileSheet">
            @switch (sheet)
            {
                case PlaySheet.Details:
                    @* The room's details, dropped over the page from the header the way a chat app opens a channel's:
                       the banner, with the header's less frequent buttons on it. Its minimise closes it. *@
                    <RoomBanner Info="@Room.Info" Here="@Room.Occupants.Count" Exits="@Room.Exits.Count"
                                Minimised="false" MinimisedChanged="@(_ => CloseMobileSheet())" BottomActions="@BannerControls(PlaySettingsMenu.Sheet)" />
                    break;
                case PlaySheet.Room:
                    <PlayRoomTabs Entries="_asideEntries" @bind-Selected="_sheetEntry" Label="@SheetLabel(sheet)" Room="Room"
                                  Context="_sheetContext" ParametersFor="EntryParameters" />
                    break;
                default:
                    @* Play's sidebar (the scene, channels, pages), with the site's own menu at its top. *@
                    @if (Shell is not null)
                    {
                        <button type="button" class="play-sheet-site" @onclick="OpenSiteMenu">
                            <MudIcon Icon="@Icons.Material.Filled.Menu" Size="Size.Small" /><span>@Loc["NavMenuLabel"]</span>
                        </button>
                    }
                    <div class="play-sheet-body">
                        <PlaySidebar CharacterName="@PlayTerminal.ConnectedPlayerName" Connected="@PlayTerminal.IsConnected" Room="@SidebarRoom"
                                     Current="@SidebarCurrent" OnOpenScene="OpenSceneFromSheet" OnOpen="OpenCommFromSheet" />
                    </div>
                    break;
            }
        </PlayMobileSheet>
    }

    <CharacterSheet Name="@_sheetName" Occupant="@_sheetOccupant" SceneId="@SceneHere?.Id" OnClose="CloseSheet"
                    OnCommand="SendAsync" OnPage="StartPageAsync" Details="SheetDetails" />
}

@code {
    /// <summary>The connection row's buttons, in the card header: Disconnect, Connect, or Login for a visitor.</summary>
    private RenderFragment ConnectionControl => __builder =>
    {
        if (PlayTerminal.IsConnected)
        {
            <PlayControl Label="@Loc["Disconnect"]" Icon="@Icons.Material.Filled.PowerSettingsNew" OnClick="DisconnectAsync" />
        }
        else if (AccountAuth.IsLoggedIn)
        {
            <PlayControl Class="play-conn--connect" OnClick="ConnectAsync">@Loc["Connect"]</PlayControl>
        }
        else
        {
            <PlayControl Class="play-conn--connect" Href="/login">@Loc["Login"]</PlayControl>
        }
    };

    /// <summary>Leaves the room's scene (unfocuses it); the room.info that follows shows the join bar again.</summary>
    private RenderFragment LeaveSceneControl => __builder =>
    {
        <PlayControl Label="@Loc["NavPlaySceneLeave"]" Icon="@Icons.Material.Outlined.Logout" Disabled="@(!PlayTerminal.IsConnected)"
                     OnClick="LeaveSceneAsync" />
    };

    private RenderFragment TerminalSettings(PlaySettingsMenu menu) => __builder =>
    {
        <PlayTerminalSettings Menu="menu" Open="@(_settingsOpen == menu)" OpenChanged="@((bool now) => OnSettingsOpenChanged(menu, now))"
                              OnEscape="CloseSettings" Columns="_targetCols" ColumnsChanged="OnColsChanged"
                              ScreenReaderOn="@ScreenReader.On" ScreenReaderChanged="ScreenReader.SetAsync"
                              KeepLogsOn="@TerminalLog.On" KeepLogsChanged="TerminalLog.SetAsync" OnClear="ClearTerminal"
                              Focus="_focus" FocusChanged="OnFocusChanged" />
    };

    /// <summary>
    /// The banner's controls row, where the header's less frequent buttons go on a phone (Play.razor.css): the
    /// header keeps the buttons used all the time and the name opens the room's details, as a chat app's channel
    /// name does. Focus mode, the terminal settings (or Leave, in a scene's Story) and Disconnect; Connect and Login
    /// stay in the header.
    /// </summary>
    private RenderFragment BannerControls(PlaySettingsMenu menu) => __builder =>
    {
        <div class="play-banner-more">
            <PlayControl Class="play-banner-focus" Label="@Loc["NavFocusMode"]" Icon="@Icons.Material.Filled.Fullscreen" OnClick="EnterFocusAsync" />
            @if (View == PlayView.Terminal)
            {
                @TerminalSettings(menu)
            }
            else if (SceneHere is { Focus: true })
            {
                @LeaveSceneControl
            }
            @if (PlayTerminal.IsConnected)
            {
                @ConnectionControl
            }
        </div>
    };

    /// <summary>
    /// The card's footer in the Story view. The Terminal view has no footer at all, rather than an empty one:
    /// the card's footer pads itself, and a sideways phone has no 12px to give away under the terminal's input.
    /// </summary>
    private RenderFragment StoryComposer => __builder =>
    {
        if (SceneHere is { Outside: true } scene)
        {
            @* Not focused on the room's scene: joining focuses the viewer, and the room.info that follows brings
               the composer back. *@
            <PlaySceneJoinBar Scene="scene" Refusal="@(_joinRefusal is { } refusal && refusal.SceneId == scene.Id ? refusal.Text : null)"
                              Disabled="@(!PlayTerminal.IsConnected || _joining)" OnJoin="() => JoinSceneAsync(scene)" />
        }
        else
        {
            <PlayComposer @ref="_composer" Connected="@(PlayTerminal.IsConnected && !StoryLiveUnavailable)" OnSend="SendAsync"
                          DraftKey="@DraftKey" />
        }
    };

    private RenderFragment<bool> SidebarNav => collapsed =>
        @<PlaySidebar Collapsed="collapsed" CharacterName="@PlayTerminal.ConnectedPlayerName" Connected="@PlayTerminal.IsConnected"
                      Room="@SidebarRoom" Current="@SidebarCurrent" OnOpenScene="OpenScene" OnOpen="OpenComm" />;

    private RenderFragment<string> SheetDetails => name =>
        @<CascadingValue Value="@(new ProfilePageContext(name, false))">
            <SchemaWidget WidgetName="character-header" />
        </CascadingValue>;
}
