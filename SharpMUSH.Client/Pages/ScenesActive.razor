@page "/scenes/active"
@layout ScenesLayout
@using SharpMUSH.Client.Components.Scenes
@inject IStringLocalizer<SharedResource> Loc
@inject SceneService SceneService
@inject AccountAuthService AccountAuth

<PageTitle>@Loc["NavScenesLive"] — @Loc["AppTitle"]</PageTitle>

@* The sidebar's "Live now": every running scene as a card, the live view its accent action. *@
<div class="scenes-active-page">
    <PlainPageHeader Kicker="@Loc["SceneArchive"]" Title="@Loc["NavScenesLive"]" Description="@Loc["ResActiveScenesSubtitle"]" />

    @if (_loading)
    {
        <div class="scenes-list" aria-busy="true">
            @for (var i = 0; i < 4; i++)
            {
                <div class="scenes-skeleton"></div>
            }
        </div>
    }
    else if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="scene-list-error">@_error</MudAlert>
    }
    else if (_scenes.Count == 0)
    {
        <div class="scenes-empty">@Loc["WidNoActiveScenes"]</div>
    }
    else
    {
        <div class="scenes-list">
            @foreach (var scene in _scenes)
            {
                <SceneCard @key="scene.Id" Scene="scene" CanJoin="@_canJoin" />
            }
        </div>
    }
</div>

@code {
    private IReadOnlyList<SceneSummary> _scenes = [];
    private string? _error;
    private bool _loading = true;
    private bool _canJoin;

    protected override async Task OnInitializedAsync()
    {
        var pending = SceneService.GetActiveScenesAsync();
        await AccountAuth.InitAsync();
        _canJoin = AccountAuth.IsLoggedIn && AccountAuth.ActiveCharacter is not null;
        var result = await pending;
        (_scenes, _error) = result switch
        {
            IReadOnlyList<SceneSummary> scenes => (scenes, (string?)null),
            ApiFailure failure => ([], failure.Message),
        };
        _loading = false;
    }
}
