@page "/admin/config/import"
@layout ConfigLayout
@attribute [Authorize(Policy = "config.admin")]
@using SharpMUSH.Client.Services
@inject AdminConfigService AdminConfigService
@inject ILogger<ImportConfig> Logger
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["ImportConfiguration"] - @Loc["Configuration"]</PageTitle>

<div class="config-section-page">
    <PlainPageHeader Kicker="@Loc["ResConfigSectionKicker"]" Title="@Loc["ImportConfiguration"]" Description="@Loc["ImportConfigDescription"]" />

    @* D1 frame, as the database import beside it: the drop zone and the chosen file are kit cards,
       the preview a read-only MudBlazor field, and Import the page's one primary capsule. *@
    <div class="page-stack impcfg-stack">
        <KitCard Class="impcfg-dropzone">
            <div class="impcfg-body">
                <MudFileUpload T="IBrowserFile"
                               Accept=".cnf,.conf,.txt"
                               FilesChanged="OnFileSelected"
                               MaximumFileCount="1"
                               MaxFileSize="1048576" />
                <div class="impcfg-dropzone-inner">
                    <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Class="impcfg-dropzone-icon" />
                    <span class="impcfg-dropzone-title">@Loc["DropFilesOrClick"]</span>
                    <span class="impcfg-dropzone-hint">@Loc["SupportedFormatsConfig"]</span>
                </div>
            </div>
        </KitCard>

        @if (_selectedFile != null)
        {
            <KitCard Title="@Loc["SelectedFile"]">
                <div class="impcfg-body">
                    <div class="impcfg-file-row">
                        <MudIcon Icon="@Icons.Material.Filled.Description" Class="impcfg-file-icon" />
                        <span class="impcfg-file-name">@_selectedFile.Name</span>
                        <span class="impcfg-file-size">(@($"{_selectedFile.Size / 1024.0:F1}") KB)</span>
                    </div>

                    @if (!string.IsNullOrEmpty(_fileContent))
                    {
                        <MudExpansionPanels Elevation="0" Class="impcfg-preview">
                            <MudExpansionPanel MaxHeight="400">
                                <TitleContent>
                                    <div class="impcfg-preview-title">
                                        <MudIcon Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" />
                                        <span>@Loc["PreviewFileContent"]</span>
                                    </div>
                                </TitleContent>
                                <ChildContent>
                                    <MudTextField T="string" Value="@_fileContent" ReadOnly="true" Lines="15"
                                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                                  aria-label="@Loc["PreviewFileContent"]"
                                                  Class="impcfg-preview-text" />
                                </ChildContent>
                            </MudExpansionPanel>
                        </MudExpansionPanels>
                    }

                    @if (_error is not null)
                    {
                        <MudAlert Severity="Severity.Error" Dense="true">@Loc["ConfigImportFailed", _error].Value</MudAlert>
                    }

                    <div class="impcfg-actions">
                        <CapsuleButton Icon="@Icons.Material.Filled.Clear" OnClick="ClearSelection">@Loc["ClearSelection"]</CapsuleButton>
                        <CapsuleButton Icon="@(_isImporting ? null : Icons.Material.Filled.Upload)" Primary="true"
                                       OnClick="ImportConfiguration" Disabled="_isImporting">
                            @if (_isImporting)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                @Loc["Importing"]
                            }
                            else
                            {
                                @Loc["ImportConfiguration"]
                            }
                        </CapsuleButton>
                    </div>
                </div>
            </KitCard>
        }
    </div>
</div>

@code {
	private IBrowserFile? _selectedFile;
	private string? _fileContent;
	private bool _isImporting;
	private string? _error;

	private async Task OnFileSelected(IBrowserFile? file)
	{
		_selectedFile = file;
		_error = null;

		if (file != null)
		{
			try
			{
				await using var stream = file.OpenReadStream(maxAllowedSize: 1048576); // 1MB
				using var reader = new StreamReader(stream);
				_fileContent = await reader.ReadToEndAsync();
			}
			catch (Exception ex)
			{
				Logger.LogError(ex, "Error reading configuration file {FileName}", file.Name);
			}
		}
	}

	private void ClearSelection()
	{
		_selectedFile = null;
		_fileContent = null;
		_error = null;
	}

	private async Task ImportConfiguration()
	{
		if (_selectedFile is null || string.IsNullOrEmpty(_fileContent))
			return;

		_isImporting = true;
		_error = null;

		switch (await AdminConfigService.ImportFromConfigFileAsync(_fileContent))
		{
			case ConfigurationResponse:
				Navigation.NavigateTo("/admin/config");
				break;
			case ApiFailure failure:
				_error = failure.Message;
				break;
		}

		_isImporting = false;
	}
}
