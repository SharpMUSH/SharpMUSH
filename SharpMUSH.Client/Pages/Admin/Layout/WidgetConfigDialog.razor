@using System.Net
@using System.Text.Json
@using SharpMUSH.Client.Services
@using SharpMUSH.Library.Models.Portal.Widgets
@using SharpMUSH.Client.Models.Widgets
@using SharpMUSH.Library.DiscriminatedUnions
@inject IStringLocalizer<SharedResource> Loc
@inject IWidgetRegistry Registry

<MudDialog>
    <DialogContent>
        <div class="widget-config-dialog">
            @if (IsSpacer)
            {
                <MudText Typo="Typo.body2" Class="mb-3" Style="color:var(--text-dim);">
                    @Loc["LaySpacerHelp"]
                </MudText>
                <MudNumericField @bind-Value="_height" Label="@Loc["LaySpacerHeight"]" Variant="Variant.Outlined"
                                 Min="0" Max="600" Step="4" />
            }
            else if (_form is { } form)
            {
                <div class="wcd-mode">
                    <MudText Typo="Typo.body2" Style="color:var(--text-dim);">@Loc["LayCfgFormHelp", WidgetName]</MudText>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="wcd-to-json"
                               StartIcon="@Icons.Material.Outlined.DataObject" OnClick="ShowJson">
                        @Loc["LayCfgEditJson"]
                    </MudButton>
                </div>
                <WidgetConfigForm Fields="_fields" Document="form" OnChanged="StateHasChanged" />
                @if (form.UnknownKeys(_fields) is { Count: > 0 } unknown)
                {
                    <MudText Typo="Typo.caption" Class="wcd-unknown mt-2" Style="color:var(--text-dim);">
                        @Loc["LayCfgUnknownKeys", string.Join(", ", unknown)]
                    </MudText>
                }
            }
            else
            {
                <div class="wcd-mode">
                    <MudText Typo="Typo.body2" Style="color:var(--text-dim);">
                        @((MarkupString)string.Format(Loc["LayConfigJsonHelp"].Value, $"<strong>{WebUtility.HtmlEncode(WidgetName)}</strong>"))
                    </MudText>
                    @if (_fields.Count > 0)
                    {
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="wcd-to-form"
                                   StartIcon="@Icons.Material.Outlined.Tune" OnClick="ShowForm">
                            @Loc["LayCfgEditForm"]
                        </MudButton>
                    }
                </div>

                @* The JSON view, for keys the form does not cover or a config pasted from elsewhere. The
                   key reference is generated from the widget's ConfigType so the accepted keys are on
                   screen while typing. *@
                <MudPaper Elevation="0" Class="layout-config-schema mb-3"
                          Style="border:1px solid var(--border);border-radius:var(--radius);padding:var(--space-4);background:var(--surface);">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">@Loc["LayCfgReferenceTitle"]</MudText>
                    @if (_fields.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Style="color:var(--text-dim);">@Loc["LayCfgNone"]</MudText>
                    }
                    else
                    {
                        <MudSimpleTable Dense="true" Bordered="false" Striped="false" Style="background:transparent;">
                            <thead>
                                <tr>
                                    <th>@Loc["LayCfgColKey"]</th>
                                    <th>@Loc["LayCfgColType"]</th>
                                    <th>@Loc["LayCfgColDefault"]</th>
                                    <th>@Loc["LayCfgColDescription"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var field in _fields)
                                {
                                    @RenderField(field, depth: 0)
                                    @foreach (var child in field.Children)
                                    {
                                        @RenderField(child, depth: 1)
                                    }
                                }
                            </tbody>
                        </MudSimpleTable>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="mt-1"
                                   StartIcon="@Icons.Material.Outlined.DataObject"
                                   Disabled="@(!string.IsNullOrWhiteSpace(_json))"
                                   OnClick="InsertTemplate">
                            @Loc["LayCfgInsertTemplate"]
                        </MudButton>
                    }
                </MudPaper>

                <MudTextField @bind-Value="_json" Variant="Variant.Outlined" Lines="10"
                              Label="@Loc["LayConfigJsonLabel"]" Class="layout-config-json"
                              Style="font-family:var(--font-mono);font-size:var(--text-sm);" />
                @if (_error is not null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Error" Class="mt-1">@_error</MudText>
                }
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel">@Loc["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">@Loc["LayApply"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>Human-readable widget name (shown in the JSON editor header).</summary>
    [Parameter] public string WidgetName { get; set; } = string.Empty;

    /// <summary>Machine widget key. Resolves the descriptor, and so the config schema shown here.</summary>
    [Parameter] public string? WidgetKey { get; set; }

    /// <summary>The placement's current config as raw JSON (null when unset).</summary>
    [Parameter] public string? InitialJson { get; set; }

    private const int DefaultSpacerHeight = 24;

    private string _json = string.Empty;
    private string? _error;

    /// <summary>The settings form's config; null while the JSON view is showing.</summary>
    private WidgetConfigDocument? _form;
    private int _height = DefaultSpacerHeight;
    private IReadOnlyList<WidgetConfigField> _fields = [];

    private bool IsSpacer => string.Equals(WidgetKey, "Spacer", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        _json = InitialJson ?? string.Empty;
        if (IsSpacer)
        {
            _height = ReadHeight(InitialJson) ?? DefaultSpacerHeight;
            return;
        }

        _fields = WidgetConfigSchema.Describe(
            WidgetKey is null ? null : Registry.GetWidget(WidgetKey)?.ConfigType);

        // The form when the widget documents its keys and the stored config is an object it can
        // read; otherwise the JSON view, where a broken config can be seen and fixed.
        if (_fields.Count > 0 && WidgetConfigDocument.Parse(InitialJson, Loc["LayCfgNotAnObject"]) is WidgetConfigDocument document)
        {
            _form = document;
        }
    }

    private void ShowJson()
    {
        _json = _form?.ToJson() ?? string.Empty;
        _form = null;
        _error = null;
    }

    private void ShowForm()
    {
        switch (WidgetConfigDocument.Parse(_json, Loc["LayCfgNotAnObject"]))
        {
            case WidgetConfigDocument document:
                _form = document;
                _error = null;
                break;
            case Error<string> error:
                _error = Loc["LayInvalidJson", error.Value];
                break;
        }
    }

    private RenderFragment RenderField(WidgetConfigField field, int depth) =>
        @<tr>
            <td style="@($"font-family:var(--font-mono);padding-left:{depth * 1.25}rem;")">@field.Key</td>
            <td style="color:var(--text-dim);">@field.TypeLabel</td>
            <td style="font-family:var(--font-mono);color:var(--text-dim);">@(field.Default ?? "—")</td>
            <td>@Loc[field.DescriptionKey]</td>
        </tr>;

    private void InsertTemplate() => _json = WidgetConfigSchema.TemplateJson(_fields);

    private static int? ReadHeight(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
        {
            return null;
        }

        try
        {
            using var doc = JsonDocument.Parse(json);
            if (doc.RootElement.ValueKind == JsonValueKind.Object
                && doc.RootElement.TryGetProperty("height", out var h)
                && h.TryGetInt32(out var value))
            {
                return value;
            }
        }
        catch (JsonException) { /* ignore — use default */ }

        return null;
    }

    private void Cancel() => MudDialog.Cancel();

    private void Save()
    {
        if (IsSpacer)
        {
            var height = Math.Clamp(_height, 0, 600);
            MudDialog.Close(DialogResult.Ok<string?>($"{{\"height\":{height}}}"));
            return;
        }

        if (_form is { } form)
        {
            // No keys left → clear config, as an empty JSON box does.
            MudDialog.Close(DialogResult.Ok<string?>(form.ToJson()));
            return;
        }

        if (string.IsNullOrWhiteSpace(_json))
        {
            // Empty → clear config. Sentinel "null" distinguishes "cleared" from "cancelled".
            MudDialog.Close(DialogResult.Ok<string?>(null));
            return;
        }

        try
        {
            using var parsed = JsonDocument.Parse(_json);

            // Every widget reads its config as an object and ignores anything else, so an array or a
            // scalar would save cleanly and then silently do nothing. Refuse it here instead.
            if (parsed.RootElement.ValueKind != JsonValueKind.Object)
            {
                _error = Loc["LayCfgNotAnObject"];
                return;
            }
        }
        catch (JsonException ex)
        {
            _error = Loc["LayInvalidJson", ex.Message];
            return;
        }

        MudDialog.Close(DialogResult.Ok<string?>(_json));
    }
}
