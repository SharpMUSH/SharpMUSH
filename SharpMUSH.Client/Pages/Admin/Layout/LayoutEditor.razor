@page "/admin/layout/{Scope}"
@using System.Text.Json
@using SharpMUSH.Library.Authorization
@attribute [Authorize(Policy = "layout.admin")]
@inject IStringLocalizer<SharedResource> Loc
@inject ILayoutService LayoutService
@inject IWidgetRegistry Registry
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>@Loc["LayEditorPageTitle", ScopeLabel] — @Loc["AdminPanel"] — @Loc["AppTitle"]</PageTitle>

<div class="layedit full-bleed">
    <div class="layedit-head">
        <div>
            <a class="layedit-back" href="/admin/layout"><MudIcon Icon="@Icons.Material.Filled.ArrowBack" Style="font-size:0.8125rem;" /> @Loc["LayAllLayouts"]</a>
            <h1 class="layedit-title">@ScopeLabel</h1>
            <p class="layedit-blurb">@(_scopeInfo is null ? null : Loc[_scopeInfo.DescriptionKey].Value)</p>
        </div>
        <div class="layedit-actions">
            <button type="button" class="le-btn @(_showPreview ? "le-btn--on" : "")" @onclick="@(() => _showPreview = !_showPreview)">
                <MudIcon Icon="@Icons.Material.Filled.Visibility" Style="font-size:0.875rem;" /> @Loc["LayPreview"]
            </button>
            <button type="button" class="le-btn" @onclick="ResetAsync" disabled="@_saving">
                <MudIcon Icon="@Icons.Material.Filled.RestartAlt" Style="font-size:0.875rem;" /> @Loc["ResetToDefault"]
            </button>
            <button type="button" class="le-btn le-btn--primary" @onclick="SaveAsync" disabled="@(_saving || !_dirty)">
                <MudIcon Icon="@Icons.Material.Filled.Save" Style="font-size:0.875rem;" /> @(_saving ? Loc["LayPublishing"] : Loc["LayPublish"])
            </button>
        </div>
    </div>

    @if (_scopeInfo is null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@Loc["LayUnknownScope", Scope]</MudAlert>
    }
    else if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Style="height:2px;" />
    }
    else
    {
        @* --le-drag-span sizes the drop skeleton to the widget in flight, so the dashed box shows the
           real landing footprint rather than a generic one-column stub. *@
        <MudDropContainer T="EditItem" @ref="_container" Items="_items"
                          ItemsSelector="@((item, zoneId) => item.Zone == zoneId)"
                          ItemsClassSelector="@ItemsClass"
                          ItemDraggingClass="le-item-lifted"
                          ItemPicked="OnPicked"
                          ItemDropped="OnDropped" Class="le-board"
                          Style="@($"--le-drag-span:{_dragSpan};")">
            <ChildContent>
                <div class="le-palette">
                    <div class="le-panel-label">@Loc["LayWidgetsPanel"]</div>
                    <MudDropZone T="EditItem" Identifier="palette" Class="le-palette-zone" AllowReorder="false" />
                    <div class="le-hint">@Loc["LayPaletteHint"]</div>

                    <div class="le-panel-label" style="margin-top:1.125rem;">@Loc["LaySidebarsAndFooter"]</div>
                    <div class="le-settings">
                        <label class="le-toggle"><input type="checkbox" checked="@_leftOn" @onchange="@(e => { _leftOn = (bool)e.Value!; _dirty = true; InvalidatePreview(); })" /> @Loc[WidgetZone.LeftSidebar.ResourceKey()]</label>
                        <label class="le-toggle"><input type="checkbox" checked="@_rightOn" @onchange="@(e => { _rightOn = (bool)e.Value!; _dirty = true; InvalidatePreview(); })" /> @Loc[WidgetZone.RightSidebar.ResourceKey()]</label>
                        <label class="le-toggle"><input type="checkbox" checked="@_footerOn" @onchange="@(e => { _footerOn = (bool)e.Value!; _dirty = true; InvalidatePreview(); })" /> @Loc[WidgetZone.Footer.ResourceKey()]</label>
                    </div>
                </div>

                <div class="le-zones">
                    @foreach (var zone in _scopeInfo.Zones)
                    {
                        <div class="le-zone" id="@ZoneElementId(zone)">
                            <div class="le-zone-head">
                                <MudIcon Icon="@ZoneIcon(zone)" Style="font-size:0.875rem;color:var(--accent);" />
                                <span>@Loc[zone.ResourceKey()]</span>
                                <span class="le-zone-hint">@(IsGridZone(zone) ? Loc["LayGridZoneHint"] : Loc["LayFlowZoneHint"])</span>
                            </div>
                            @* AllowReorder is what makes a drop land where it was released. Without it
                               MudBlazor's CommitTransaction reports index -1 and every drop lands at the
                               front of the zone — and it renders no drop skeleton either. *@
                            <MudDropZone T="EditItem" Identifier="@zone.ToString()" AllowReorder="true"
                                         Class="@($"le-zone-drop {(IsGridZone(zone) ? "le-zone-drop--grid" : "")}")" />
                        </div>
                    }
                </div>
            </ChildContent>
            <ItemRenderer>
                <div class="le-item @(context.IsTemplate ? "le-item--template" : "") @(ReferenceEquals(context, _resizing) ? "le-item--resizing" : "")">
                    <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Class="le-item-grip" Style="font-size:0.875rem;color:var(--text-faint);" />
                    <span class="le-item-name">@context.DisplayName</span>
                    @if (!context.IsTemplate)
                    {
                        <span style="flex:1;"></span>
                        @if (IsGridZoneName(context.Zone))
                        {
                            <span class="le-span-num" title="@Loc["LayWidthInColumns"]">@ClampSpan(context.Span)</span>
                        }
                        @if (context.Config is not null)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Tune" Style="font-size:0.75rem;color:var(--accent);" Title="@Loc["LayHasConfig"]" />
                        }
                        @* Dragging is never the only way to reorder: these are the keyboard and touch path. *@
                        <button type="button" class="le-item-btn le-item-btn--up" title="@Loc["LayMoveUp"]"
                                disabled="@(!CanMove(context, -1))"
                                @onclick="@(() => MoveBy(context, -1))" @onclick:stopPropagation="true">
                            <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowUp" Style="font-size:0.8125rem;" />
                        </button>
                        <button type="button" class="le-item-btn le-item-btn--down" title="@Loc["LayMoveDown"]"
                                disabled="@(!CanMove(context, 1))"
                                @onclick="@(() => MoveBy(context, 1))" @onclick:stopPropagation="true">
                            <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Style="font-size:0.8125rem;" />
                        </button>
                        <button type="button" class="le-item-btn" title="@Loc["LayConfigure"]" @onclick="@(() => EditConfigAsync(context))" @onclick:stopPropagation="true">
                            <MudIcon Icon="@Icons.Material.Filled.Settings" Style="font-size:0.8125rem;" />
                        </button>
                        <button type="button" class="le-item-btn le-item-btn--danger" title="@Loc["LayRemove"]" @onclick="@(() => Remove(context))" @onclick:stopPropagation="true">
                            <MudIcon Icon="@Icons.Material.Filled.Close" Style="font-size:0.8125rem;" />
                        </button>
                        @if (IsGridZoneName(context.Zone))
                        {
                            @* The width grip sits ON the edge it moves, so the pointer never has to chase a
                               control that is itself being resized. draggable=false keeps a grab here from
                               starting a MudBlazor drag transaction instead of a resize. *@
                            @* draggable=false alone is not enough: the grip sits inside MudBlazor's
                               draggable drop item, so the first move would start a native HTML5 drag on
                               the ancestor — and starting a drag revokes the pointer capture, killing the
                               resize one pixel in. Cancelling the mousedown default stops that drag from
                               ever beginning. *@
                            <div class="le-resize" id="@ResizeGripId(context)"
                                 role="separator" aria-orientation="vertical" tabindex="0"
                                 draggable="false"
                                 @onmousedown:preventDefault="true"
                                 @onmousedown:stopPropagation="true"
                                 aria-label="@Loc["LayWidthInColumns"]"
                                 aria-valuenow="@ClampSpan(context.Span)" aria-valuemin="1" aria-valuemax="12"
                                 aria-valuetext="@Loc["LayColumnsValue", ClampSpan(context.Span)]"
                                 title="@Loc["LayResizeHint"]"
                                 @onpointerdown="@(e => BeginResizeAsync(context, e))"
                                 @onpointerdown:stopPropagation="true"
                                 @onpointermove="@(e => OnResizeMove(context, e))"
                                 @onpointerup="@(_ => EndResize())"
                                 @onpointercancel="@(_ => EndResize())"
                                 @onkeydown="@(e => ResizeByKey(context, e))"
                                 @onkeydown:stopPropagation="true"
                                 @onclick:stopPropagation="true"></div>
                        }
                    }
                </div>
            </ItemRenderer>
        </MudDropContainer>

        @if (_showPreview)
        {
            @* Preview is a snapshot, not a live projection: rebuilding it on every pointer move during a
               resize re-lays the whole page (and changes its height) under the user. It settles on release. *@
            var preview = Preview;
            <div class="le-preview">
                <div class="le-preview-head">
                    <MudIcon Icon="@Icons.Material.Filled.Visibility" Style="font-size:0.875rem;color:var(--accent);" />
                    <span>@Loc["LayLivePreview"]</span>
                    <span class="le-preview-note">
                        @Loc["LayPreviewNote"]@(Scope == LayoutScopes.Profile ? Loc["LayPreviewNoteProfile"].Value : string.Empty)
                    </span>
                </div>
                <div class="le-preview-surface">
                    @foreach (var zone in _scopeInfo.Zones)
                    {
                        <div class="le-preview-zone">
                            <div class="le-preview-zlabel">@Loc[zone.ResourceKey()]</div>
                            <ZoneRenderer Zone="zone" Layout="preview" Grid="IsGridZone(zone)" />
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter] public string Scope { get; set; } = string.Empty;

    private sealed class EditItem
    {
        public string InstanceId { get; init; } = Guid.NewGuid().ToString("N");
        public string WidgetName { get; init; } = string.Empty;
        public string DisplayName { get; init; } = string.Empty;
        public string Zone { get; set; } = "palette";
        public JsonElement? Config { get; set; }
        public bool IsTemplate { get; init; }

        /// <summary>Grid width in columns (1–12). Only meaningful in grid zones.</summary>
        public int Span { get; set; } = 12;
    }

    // Vertical zones lay widgets out in a 12-column grid (per-placement width). The top bar is
    // horizontal, so it stays a simple list with no column-width control.
    private static bool IsGridZone(WidgetZone zone) => zone != WidgetZone.TopBar;

    private static bool IsGridZoneName(string zone)
        => Enum.TryParse<WidgetZone>(zone, out var z) && IsGridZone(z);

    private static int ClampSpan(int span) => span is >= 1 and <= 12 ? span : 12;

    private string ItemsClass(EditItem item, string dropzoneId)
        => !item.IsTemplate && IsGridZoneName(dropzoneId)
            ? $"le-span-{ClampSpan(item.Span)}"
            : string.Empty;

    /// <summary>Number of columns a grid zone lays out. Mirrors <c>repeat(12, 1fr)</c> in the stylesheet.</summary>
    private const int GridColumns = 12;

    /// <summary>Wraps the drop zone so JS can measure the grid without touching MudBlazor's own element id.</summary>
    private string ZoneElementId(WidgetZone zone) => $"le-zone-{Scope}-{zone}";

    /// <summary>Identifies the grip to <c>setPointerCapture</c>, which needs a real element.</summary>
    private static string ResizeGripId(EditItem item) => $"le-grip-{item.InstanceId}";

    private EditItem? _resizing;
    private int _resizeStartSpan;
    private double _resizeStartX;
    private double _resizeColumnWidth;
    private bool _skipRender;

    /// <summary>
    /// Column width of the widget currently being dragged, published to CSS as <c>--le-drag-span</c> so
    /// the drop skeleton matches the footprint the widget will actually occupy.
    /// </summary>
    private int _dragSpan = GridColumns;

    private void OnPicked(MudDragAndDropItemTransaction<EditItem> transaction)
        => _dragSpan = transaction.Item is { IsTemplate: false } item ? ClampSpan(item.Span) : GridColumns;

    private async Task BeginResizeAsync(EditItem item, PointerEventArgs e)
    {
        // Below the narrow-viewport breakpoint the zone collapses to one column, so there is no
        // column width to drag against. The keyboard path still works there; pointer resize does not.
        var columnWidth = await JS.InvokeAsync<double>(
            "sharpmushLayout.gridColumnWidth", ZoneElementId(Enum.Parse<WidgetZone>(item.Zone)), GridColumns);
        if (columnWidth <= 0)
        {
            return;
        }

        _resizing = item;
        _resizeStartSpan = ClampSpan(item.Span);
        _resizeStartX = e.ClientX;
        _resizeColumnWidth = columnWidth;

        await JS.InvokeVoidAsync("sharpmushLayout.capturePointer", ResizeGripId(item), e.PointerId);
    }

    private void OnResizeMove(EditItem item, PointerEventArgs e)
    {
        // Pointer capture keeps the moves coming to this grip, but every other grip carries the same
        // handler; ignore anything that is not the gesture in progress.
        if (_resizing is null || !ReferenceEquals(item, _resizing))
        {
            _skipRender = true;
            return;
        }

        var span = Math.Clamp(
            _resizeStartSpan + (int)Math.Round((e.ClientX - _resizeStartX) / _resizeColumnWidth), 1, GridColumns);

        // Re-render only when a column boundary is crossed. Pointer moves arrive far faster than the
        // grid can meaningfully change, and rendering each one is what made the old slider thrash.
        if (span == ClampSpan(_resizing.Span))
        {
            _skipRender = true;
            return;
        }

        _resizing.Span = span;
        _dirty = true;
        ApplySpans();
    }

    private void EndResize()
    {
        if (_resizing is null)
        {
            _skipRender = true;
            return;
        }

        _resizing = null;
        InvalidatePreview();
    }

    private void ResizeByKey(EditItem item, KeyboardEventArgs e)
    {
        var step = e.ShiftKey ? 3 : 1;
        var delta = e.Key switch
        {
            "ArrowRight" => step,
            "ArrowLeft" => -step,
            _ => 0
        };

        var span = Math.Clamp(ClampSpan(item.Span) + delta, 1, GridColumns);
        if (delta == 0 || span == ClampSpan(item.Span))
        {
            _skipRender = true;
            return;
        }

        item.Span = span;
        _dirty = true;
        InvalidatePreview();
        ApplySpans();
    }

    // A pointer move that changes nothing must not re-render: the editor grid, and every widget in the
    // live preview below it, would be rebuilt dozens of times per second for no visible difference.
    protected override bool ShouldRender()
    {
        if (!_skipRender)
        {
            return true;
        }

        _skipRender = false;
        return false;
    }

    /// <summary>
    /// Re-applies <see cref="ItemsClass"/> to the placed widgets. A plain <c>StateHasChanged</c> does not
    /// reach inside <c>MudDropContainer</c> — the column-span class is only re-read when the container
    /// refreshes — so a width change is invisible without this.
    /// </summary>
    private void ApplySpans() => _container?.Refresh();

    private bool CanMove(EditItem item, int delta)
    {
        if (!_zones.TryGetValue(item.Zone, out var list))
        {
            return false;
        }

        var index = list.IndexOf(item);
        return index >= 0 && index + delta >= 0 && index + delta < list.Count;
    }

    private void MoveBy(EditItem item, int delta)
    {
        if (!CanMove(item, delta) || !_zones.TryGetValue(item.Zone, out var list))
        {
            return;
        }

        var index = list.IndexOf(item);
        (list[index], list[index + delta]) = (list[index + delta], list[index]);
        _dirty = true;
        RebuildItems();
    }

    private LayoutScope? _scopeInfo;
    private MudDropContainer<EditItem>? _container;
    private bool _loading = true;
    private bool _saving;
    private bool _dirty;

    private List<EditItem> _palette = [];
    private Dictionary<string, List<EditItem>> _zones = [];
    private List<EditItem> _items = [];

    private LayoutConfiguration? _preview;

    /// <summary>The layout the preview panel renders. Rebuilt on commit, never mid-gesture.</summary>
    private LayoutConfiguration Preview => _preview ??= BuildPreviewLayout();

    private void InvalidatePreview() => _preview = null;

    private bool _leftOn, _rightOn, _footerOn;
    private string _leftWidth = "280px", _rightWidth = "280px";
    private bool _showPreview = true;

    private string ScopeLabel => _scopeInfo is null ? Scope : Loc[_scopeInfo.DisplayNameKey].Value;

    // Built-in descriptors put a SharedResource key in DisplayName; application-backed ones carry
    // admin-supplied text (or a bare slug), which the lookup misses and passes through unchanged.
    private string WidgetLabel(IPortalWidget widget)
    {
        var label = Loc[widget.DisplayName];
        return label.ResourceNotFound ? widget.DisplayName : label.Value;
    }

    protected override async Task OnParametersSetAsync()
    {
        _scopeInfo = LayoutScopes.Find(Scope);
        if (_scopeInfo is null)
        {
            _loading = false;
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var layout = await LayoutService.GetLayoutAsync(Scope);

        _leftOn = layout.Settings.LeftSidebarEnabled;
        _rightOn = layout.Settings.RightSidebarEnabled;
        _footerOn = layout.Settings.FooterEnabled;
        _leftWidth = layout.Settings.LeftSidebarWidth;
        _rightWidth = layout.Settings.RightSidebarWidth;

        _palette = Registry.GetAllWidgets()
            .Where(w => w.AllowedZones.Any(z => _scopeInfo!.Zones.Contains(z)))
            .Select(w => new EditItem { WidgetName = w.Name, DisplayName = WidgetLabel(w), Zone = "palette", IsTemplate = true })
            .OrderBy(i => i.DisplayName, StringComparer.CurrentCultureIgnoreCase)
            .ToList();

        _zones = _scopeInfo!.Zones.ToDictionary(
            z => z.ToString(),
            z => (layout.Zones.TryGetValue(z, out var list) ? list : [])
                .OrderBy(p => p.Order)
                .Select(p => new EditItem
                {
                    WidgetName = p.WidgetName,
                    DisplayName = Registry.GetWidget(p.WidgetName) is { } w ? WidgetLabel(w) : p.WidgetName,
                    Zone = z.ToString(),
                    Config = p.Config,
                    Span = ClampSpan(p.Span)
                })
                .ToList());

        RebuildItems();
        _dirty = false;
        _loading = false;
    }

    private void RebuildItems()
    {
        // Mutated in place, never reassigned: Refresh makes each zone re-read Container.Items straight
        // away, and Container.Items still points at whatever list was last passed as a parameter. Handing
        // it a fresh list here would have the zones rebuild their indices from the *old* order, and the
        // reordering would be discarded on the next render (MudBlazor#7191).
        _items.Clear();
        _items.AddRange(_palette.Concat(_scopeInfo!.Zones.SelectMany(z => _zones[z.ToString()])));
        InvalidatePreview();
        // Refresh clears each zone's internal reorder indices, so display order is re-derived from
        // _items — keeping what the editor shows and what Publish writes the same thing.
        _container?.Refresh();
    }

    private void OnDropped(MudItemDropInfo<EditItem> info)
    {
        if (info.Item is not { } item)
        {
            return;
        }

        var target = info.DropzoneIdentifier;

        if (item.IsTemplate)
        {
            // Adding a fresh placement; the template stays in the palette.
            if (target != "palette" && _zones.TryGetValue(target, out var list))
            {
                var clone = new EditItem
                {
                    WidgetName = item.WidgetName,
                    DisplayName = item.DisplayName,
                    Zone = target
                };
                InsertAt(list, clone, info.IndexInZone);
                _dirty = true;
            }
        }
        else
        {
            RemoveFromZones(item);
            if (target == "palette")
            {
                // Dragged back to the palette → removed.
                _dirty = true;
            }
            else if (_zones.TryGetValue(target, out var list))
            {
                item.Zone = target;
                InsertAt(list, item, info.IndexInZone);
                _dirty = true;
            }
        }

        RebuildItems();
    }

    private static void InsertAt(List<EditItem> list, EditItem item, int index)
    {
        index = Math.Clamp(index, 0, list.Count);
        list.Insert(index, item);
    }

    private void RemoveFromZones(EditItem item)
    {
        foreach (var list in _zones.Values)
        {
            list.Remove(item);
        }
    }

    private void Remove(EditItem item)
    {
        RemoveFromZones(item);
        _dirty = true;
        RebuildItems();
    }

    private async Task EditConfigAsync(EditItem item)
    {
        var parameters = new DialogParameters<WidgetConfigDialog>
        {
            { x => x.WidgetName, item.DisplayName },
            { x => x.WidgetKey, item.WidgetName },
            { x => x.InitialJson, item.Config?.GetRawText() }
        };
        // FullWidth is required: the dialog body declares container-type, and inline-size
        // containment zeroes its contribution to the paper's shrink-to-fit width.
        var dialog = await DialogService.ShowAsync<WidgetConfigDialog>(
            Loc["LayConfigureWidget", item.DisplayName], parameters, new DialogOptions { FullWidth = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled)
        {
            return;
        }

        var json = result.Data as string;
        // Clone() detaches the element from the parsed document so it survives disposal.
        item.Config = string.IsNullOrWhiteSpace(json)
            ? null
            : JsonDocument.Parse(json).RootElement.Clone();
        _dirty = true;
        InvalidatePreview();
        StateHasChanged();
    }

    private LayoutConfiguration BuildPreviewLayout()
    {
        var zones = _scopeInfo!.Zones.ToDictionary(
            z => z,
            z => _zones[z.ToString()]
                .Select((it, idx) => new WidgetPlacement(it.WidgetName, idx, it.Config, ClampSpan(it.Span)))
                .ToList());
        return new LayoutConfiguration(zones, new LayoutSettings(_leftOn, _rightOn, _footerOn, _leftWidth, _rightWidth));
    }

    private async Task SaveAsync()
    {
        if (_scopeInfo is null)
        {
            return;
        }

        _saving = true;
        var ok = await LayoutService.SaveLayoutAsync(Scope, BuildPreviewLayout());
        _saving = false;

        if (ok)
        {
            _dirty = false;
            Snackbar.Add(Loc["LayPublished", ScopeLabel], Severity.Success);
        }
        else
        {
            Snackbar.Add(Loc["LayPublishFailed"], Severity.Error);
        }
    }

    private async Task ResetAsync()
    {
        if (_scopeInfo is null)
        {
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            Loc["LayResetLayout"],
            Loc["LayResetConfirm", ScopeLabel],
            yesText: Loc["LayReset"], cancelText: Loc["Cancel"]);

        if (confirmed != true)
        {
            return;
        }

        _saving = true;
        var ok = await LayoutService.ResetLayoutAsync(Scope);
        _saving = false;

        if (ok)
        {
            await LoadAsync();
            Snackbar.Add(Loc["LayResetDone", ScopeLabel], Severity.Success);
        }
        else
        {
            Snackbar.Add(Loc["LayResetFailed"], Severity.Error);
        }
    }

    private static string ZoneIcon(WidgetZone zone) => zone switch
    {
        WidgetZone.TopBar => Icons.Material.Filled.ViewHeadline,
        WidgetZone.LeftSidebar => Icons.Material.Filled.ViewSidebar,
        WidgetZone.RightSidebar => Icons.Material.Filled.ViewSidebar,
        WidgetZone.Footer => Icons.Material.Filled.ViewStream,
        _ => Icons.Material.Filled.ViewQuilt
    };
}
