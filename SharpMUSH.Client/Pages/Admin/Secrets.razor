@page "/admin/config/secrets"
@layout ConfigLayout
@* Not config.admin alone: a secret's ManagedBy permission (discord.admin for discord.token) lets its holder manage
   that one, and the server lists only the secrets the caller may manage. *@
@attribute [Authorize]
@using System.Globalization
@using SharpMUSH.Client.Services
@using SharpMUSH.Library.API
@inject SecretsService SecretsService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> Loc

<AdminPageTitle Page="@Loc["AdmSecrets"]" />

@* Write-only: a value goes up in the form and nothing on this page, or behind it, ever shows one again.
   The list says only where each secret's value comes from and who stored it. *@
<div class="config-section-page">
    <PlainPageHeader Kicker="@Loc["ResConfigSectionKicker"]" Title="@Loc["AdmSecrets"]" Description="@Loc["AdmSecretsDescription"]" />

    <div class="page-stack">
        @if (_loading)
        {
            <MudProgressLinear Color="Color.Secondary" Indeterminate="true" />
        }
        else if (_forbidden)
        {
            <p class="secret-empty secret-forbidden">@Loc["AdmSecretsForbidden"]</p>
        }
        else
        {
            <KitCard Title="@Loc["AdmSecretSetTitle"]">
                <div class="secret-form">
                    <MudTextField T="string" Value="@_name" ValueChanged="@(v => _name = v ?? string.Empty)"
                                  Label="@Loc["AdmSecretName"]" Placeholder="sql.password"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                                  Class="secret-field secret-field--name" />
                    <MudTextField T="string" Value="@_value" ValueChanged="@(v => _value = v ?? string.Empty)"
                                  Label="@Loc["AdmSecretValue"]" InputType="InputType.Password"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                                  Class="secret-field" UserAttributes="@NoAutofill" />
                    @if (SentByHttp(_name))
                    {
                        @* A secret @http may send goes nowhere until its hosts are named, so the form asks for them with it. *@
                        <ListEditor Items="_hosts" ItemsChanged="@(hosts => _hosts = hosts)" Label="@Loc["AdmSecretHosts"]"
                                    Placeholder="api.example.com" Help="@Loc["AdmSecretHostsAdvice"]" Mono="true"
                                    Separators="HostSeparators" Normalize="NormalizeHost" Class="secret-hosts-editor" />
                    }
                    <CapsuleButton Primary="true" Icon="@Icons.Material.Filled.Save" Class="secret-save"
                                   Disabled="@(_busy || string.IsNullOrWhiteSpace(_name) || _value.Length == 0)"
                                   OnClick="SetAsync">@Loc["Save"]</CapsuleButton>
                </div>
            </KitCard>

            <KitCard Title="@Loc["AdmSecretsList"]">
                <Controls>
                    <Pill Tag="true">@_secrets.Count</Pill>
                </Controls>
                <ChildContent>
                    @if (_secrets.Count == 0)
                    {
                        <p class="secret-empty">@Loc["AdmSecretsNone"]</p>
                    }
                    else
                    {
                        <ul class="secret-rows">
                            @foreach (var secret in _secrets)
                            {
                                <li class="secret-row" data-config-option="@secret.Name">
                                    <div class="secret-row-text">
                                        <span class="secret-row-head">
                                            <code class="secret-name">@secret.Name</code>
                                            <Pill Tag="true" Warn="@(secret.Source is SecretSource.Unset or SecretSource.Unreadable)">@SourceLabel(secret)</Pill>
                                            @if (SentByHttp(secret.Name) && secret.Hosts is null)
                                            {
                                                <Pill Tag="true" Warn="true" Class="secret-no-hosts">@Loc["AdmSecretNoHosts"]</Pill>
                                            }
                                        </span>
                                        @if (secret.Description is { } description)
                                        {
                                            <span class="secret-sub">@description</span>
                                        }
                                        @if (secret is { SetAt: { } at, SetBy: { } by })
                                        {
                                            <span class="secret-sub">@string.Format(Loc["AdmSecretStoredBy"], at.ToLocalTime().ToString("g", CultureInfo.CurrentCulture), by.Name)</span>
                                        }
                                        @if (secret.Hosts is { } hosts)
                                        {
                                            <span class="secret-sub">@Loc["AdmSecretHostsList"] <code class="secret-hosts">@hosts</code></span>
                                        }
                                        else if (SentByHttp(secret.Name))
                                        {
                                            <span class="secret-sub">@Loc["AdmSecretNoHostsAdvice"]</span>
                                        }
                                        @if (_hostsFor == secret.Name)
                                        {
                                            <div class="secret-hosts-form">
                                                <ListEditor Items="_hostsEdit" ItemsChanged="@(hosts => _hostsEdit = hosts)" Label="@Loc["AdmSecretHosts"]"
                                                            Placeholder="api.example.com" Mono="true" Separators="HostSeparators"
                                                            Normalize="NormalizeHost" Class="secret-hosts-editor" />
                                                <CapsuleButton Primary="true" Icon="@Icons.Material.Filled.Save" Class="secret-hosts-save"
                                                               Disabled="@_busy" OnClick="@(() => SaveHostsAsync(secret.Name))">@Loc["Save"]</CapsuleButton>
                                                <CapsuleButton Class="secret-hosts-cancel" OnClick="@(() => _hostsFor = null)">@Loc["Cancel"]</CapsuleButton>
                                            </div>
                                        }
                                    </div>
                                    <div class="secret-row-actions">
                                        <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small"
                                                       aria-label="@Loc["AdmSecretReplace"]" title="@Loc["AdmSecretReplace"]"
                                                       OnClick="@(() => _name = secret.Name)" />
                                        @if (SentByHttp(secret.Name) || secret.Hosts is not null)
                                        {
                                            <MudIconButton Icon="@Icons.Material.Outlined.Language" Size="Size.Small"
                                                           aria-label="@Loc["AdmSecretEditHosts"]" title="@Loc["AdmSecretEditHosts"]"
                                                           OnClick="@(() => EditHosts(secret))" />
                                        }
                                        @if (secret.Stored)
                                        {
                                            <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Size="Size.Small" Color="Color.Error"
                                                           aria-label="@Loc["AdmSecretClear"]" title="@Loc["AdmSecretClear"]"
                                                           Disabled="@_busy" OnClick="@(() => ClearAsync(secret.Name))" />
                                        }
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </ChildContent>
            </KitCard>
        }
    </div>
</div>

<ConfigOptionFocus Ready="@(!_loading && !_forbidden)" />

@code {
    // A password manager offering to save the value as a login would keep a copy outside the server.
    private static readonly Dictionary<string, object> NoAutofill = new() { ["autocomplete"] = "new-password" };

    private bool _loading = true;
    private bool _busy;
    private bool _forbidden;
    private List<SecretStatus> _secrets = [];
    private string _name = string.Empty;
    private string _value = string.Empty;
    private IReadOnlyList<string> _hosts = [];
    private string? _hostsFor;
    private IReadOnlyList<string> _hostsEdit = [];

    // A host holds neither a space nor a comma, so either ends one as it is typed or pasted.
    private static readonly char[] HostSeparators = [' ', ','];

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            switch (await SecretsService.ListAsync())
            {
                case List<SecretStatus> secrets:
                    _secrets = secrets;
                    break;
                case ApiFailure { Kind: ApiFailureKind.Forbidden }:
                    _forbidden = true;
                    break;
                case ApiFailure failure:
                    Snackbar.Add(string.Format(Loc["AdmSecretsLoadFailed"], failure.Message), Severity.Error);
                    break;
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SetAsync()
    {
        var name = _name.Trim().ToLowerInvariant();
        _busy = true;
        try
        {
            switch (await SecretsService.SetAsync(name, _value))
            {
                case SecretStatus status:
                    _value = string.Empty;
                    _name = string.Empty;
                    Snackbar.Add(status.Override is { } where
                        ? string.Format(Loc["AdmSecretSavedOverridden"], name, where)
                        : string.Format(Loc["AdmSecretSaved"], name), status.Override is null ? Severity.Success : Severity.Warning);
                    // Left empty, the field keeps whatever hosts the secret already had.
                    if (SentByHttp(name) && _hosts.Count > 0)
                    {
                        await StoreHostsAsync(name, _hosts);
                    }

                    _hosts = [];
                    await LoadAsync();
                    break;
                case ApiFailure failure:
                    Snackbar.Add(string.Format(Loc["AdmSecretSaveFailed"], name, failure.Message), Severity.Error);
                    break;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ClearAsync(string name)
    {
        _busy = true;
        try
        {
            switch (await SecretsService.ClearAsync(name))
            {
                case SecretStatus:
                    Snackbar.Add(string.Format(Loc["AdmSecretCleared"], name), Severity.Success);
                    await LoadAsync();
                    break;
                case ApiFailure failure:
                    Snackbar.Add(string.Format(Loc["AdmSecretClearFailed"], name, failure.Message), Severity.Error);
                    break;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private void EditHosts(SecretStatus secret)
    {
        _hostsFor = secret.Name;
        _hostsEdit = secret.Hosts?.Split(' ') ?? [];
    }

    private async Task SaveHostsAsync(string name)
    {
        _busy = true;
        try
        {
            if (await StoreHostsAsync(name, _hostsEdit))
            {
                _hostsFor = null;
                await LoadAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Names the hosts <c>@http</c> may send <paramref name="name"/> to, and says how that went.</summary>
    private async Task<bool> StoreHostsAsync(string name, IReadOnlyList<string> hosts)
    {
        switch (await SecretsService.SetHostsAsync(name, hosts))
        {
            case SecretStatus { Hosts: { } stored }:
                Snackbar.Add(string.Format(Loc["AdmSecretHostsSaved"], name, stored), Severity.Success);
                return true;
            case SecretStatus:
                Snackbar.Add(string.Format(Loc["AdmSecretNoHostsSaved"], name), Severity.Warning);
                return true;
            case ApiFailure failure:
                Snackbar.Add(string.Format(Loc["AdmSecretHostsSaveFailed"], name, failure.Message), Severity.Error);
                return false;
        }

        return false;
    }

    private static string NormalizeHost(string host) => host.ToLowerInvariant();

    /// <summary>Only a secret named <c>http.</c>… can go out in an <c>@http</c> header.</summary>
    private static bool SentByHttp(string name) => name.Trim().StartsWith("http.", StringComparison.OrdinalIgnoreCase);

    private string SourceLabel(SecretStatus secret) => secret.Source switch
    {
        SecretSource.Stored => Loc["AdmSecretSourceStored"],
        SecretSource.Environment or SecretSource.File => string.Format(Loc["AdmSecretSourceOverride"], secret.Override),
        SecretSource.Unreadable => Loc["AdmSecretSourceUnreadable"],
        _ => Loc["AdmSecretSourceUnset"]
    };
}
