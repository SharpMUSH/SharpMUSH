@page "/admin/config"
@attribute [Authorize(Policy = "config.admin")]
@using SharpMUSH.Client.Models.Configuration
@using SharpMUSH.Client.Services
@using SharpMUSH.Library.API
@inject IStringLocalizer<SharedResource> Loc
@inject ConfigSchemaService SchemaService

<PageTitle>@Loc["Configuration"] - @Loc["AppTitle"]</PageTitle>

@* D1 §6.4 configuration home (board 27): a plain header, a two-column grid of linked group cards
   (accent icon tile, name, count, an Important tag on Security, description, section chips), and
   an aside on how changes apply (the other staff pages are in the Build & manage sidebar). Counts come from the
   schema; when it cannot be read the cards stay usable and the alert says why. *@
<div class="config-home">
    <div class="page-stack config-home-main">
        <PlainPageHeader Kicker="@Loc["ResConfigHomeKicker"]" Title="@Loc["ServerConfiguration"]" Description="@Loc["ManageAllSettings"]" />

        @* The six cards need nothing from the schema; only their counts do, so they render at once. *@
        @if (_loading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Style="height:2px;" />
        }
        else if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@Loc["FailedToLoadSchema"]: @_error</MudAlert>
        }
        <div class="config-cat-grid">
                @foreach (var group in ConfigSections.Groups)
                {
                    var g = group;
                    var shown = g.Sections.Take(ChipsShown).ToList();
                    var more = g.Sections.Count - shown.Count;
                    <a class="config-cat-card" href="@g.FirstRoute">
                        <div class="config-cat-head">
                            <IconTile Icon="@g.Icon" />
                            <div class="config-cat-titles">
                                <div class="config-cat-title">
                                    @Loc[g.TitleKey]
                                    @if (g.Important)
                                    {
                                        <span class="config-cat-flag">@Loc["Important"]</span>
                                    }
                                </div>
                                @if (!_loading && _error is null)
                                {
                                    <div class="config-cat-count">@Loc.Plural("AdmConfigSettingsCount", "count", CountFor(g))</div>
                                }
                            </div>
                        </div>
                        <div class="config-cat-desc">@Loc[g.DescKey]</div>
                        <div class="config-cat-chips">
                            @foreach (var section in shown)
                            {
                                <span class="config-cat-chip">@Loc[section.TitleKey]</span>
                            }
                            @if (more > 0)
                            {
                                <span class="config-cat-more">@string.Format(Loc["AdmConfigMoreSections"], more)</span>
                            }
                        </div>
                    </a>
                }
        </div>
    </div>

    <aside class="config-home-aside">
        <KitCard Aside="true" Title="@Loc["AdmConfigHowChangesApply"]">
            <p class="config-home-how">@Loc["AdmConfigHowChangesApplyBody"]</p>
        </KitCard>
    </aside>
</div>

@code {
    private const int ChipsShown = 4;

    private bool _loading = true;
    private string? _error;
    private Dictionary<string, int> _categoryCounts = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        // A failed read used to be swallowed here and every card read "0 settings": a server that did
        // not answer looked like one with nothing to configure. The cards stay usable without counts.
        switch (await SchemaService.GetSchemaAsync())
        {
            case ConfigurationSchema schema:
                _categoryCounts = schema.Properties.Values
                    .GroupBy(p => p.Category, StringComparer.OrdinalIgnoreCase)
                    .ToDictionary(g => g.Key, g => g.Count(), StringComparer.OrdinalIgnoreCase);
                break;
            case ApiFailure failure:
                _error = failure.Message;
                break;
        }

        _loading = false;
    }

    private int CountFor(ConfigGroup group) =>
        group.Sections.Sum(s => _categoryCounts.TryGetValue(s.SchemaCategory, out var n) ? n : 0);
}
