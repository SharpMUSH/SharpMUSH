@page "/admin/config/{category}"
@attribute [Authorize(Policy = "config.admin")]
@using SharpMUSH.Client.Services
@using SharpMUSH.Client.Models
@using SharpMUSH.Client.Models.Configuration
@using SharpMUSH.Library.API
@inject AdminConfigService AdminConfigService
@inject ConfigSchemaService SchemaService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> Loc
@implements IDisposable

<PageTitle>@CategoryTitle - @Loc["Configuration"]</PageTitle>

@* D1 §6.4 section page (boards 28–29): a plain header with Reset to defaults, a section label
   above a card of rows per group, the kit controls on the right of each row, the unsaved bottom bar
   (only while something changed), and an "In this section" table of contents in the aside. *@
<div class="config-section">
    <div class="config-section-main">
        <PlainPageHeader Kicker="@Loc["ResConfigSectionKicker"]" Title="@CategoryTitle" Description="@_categoryMetadata?.Description">
            <Actions>
                @if (!_loading && _categoryMetadata != null)
                {
                    <CapsuleButton Icon="@Icons.Material.Outlined.RestartAlt" OnClick="ResetToDefaults">@Loc["ResetToDefaults"]</CapsuleButton>
                }
            </Actions>
        </PlainPageHeader>

        <div class="config-section-content">
            @if (CustomPageCategories.Contains(Category))
            {
                <KitCard>
                    <MudAlert Severity="Severity.Error">
                        <strong>@Loc["RoutingError"]</strong> @string.Format(Loc["RoutingErrorDescription"], Category)
                        <br/>
                        @Loc["RoutingErrorExpected"] <code>/admin/config/@Category</code>
                        <br/>
                        @Loc["ResRoutingErrorHint"]
                    </MudAlert>
                </KitCard>
            }
            else if (_loading)
            {
                <MudProgressLinear Color="Color.Secondary" Indeterminate="true" />
            }
            else if (_categoryMetadata == null)
            {
                <KitCard>
                    <MudAlert Severity="Severity.Warning">
                        @string.Format(Loc["CategoryNotFound"], Category)
                    </MudAlert>
                </KitCard>
            }
            else if (!_categoryProperties.Any())
            {
                <KitCard>
                    <MudAlert Severity="Severity.Info">
                        @string.Format(Loc["NoPropertiesFound"], CategoryTitle)
                        <br />
                        <small>@Loc["NoPropertiesHint"]</small>
                    </MudAlert>
                </KitCard>
            }
            else if (NonEmptyGroups.Count == 0)
            {
                <div class="cfg-group">
                    <KitCard>
                        @foreach (var prop in _categoryProperties.Values.OrderBy(p => p.Name))
                        {
                            <ConfigFieldRow Property="prop" Draft="_draft" OnChanged="OnDraftChanged" />
                        }
                    </KitCard>
                </div>
            }
            else
            {
                @foreach (var group in NonEmptyGroups)
                {
                    var groupProperties = GetPropertiesInGroup(group.Name).OrderBy(p => p.Order).ToList();

                    <div class="cfg-group" id="@ConfigNaming.GroupAnchor(group.Name)">
                        <SectionLabel>@group.DisplayName</SectionLabel>
                        <KitCard>
                            @foreach (var prop in groupProperties)
                            {
                                <ConfigFieldRow Property="prop" Draft="_draft" OnChanged="OnDraftChanged" />
                            }
                        </KitCard>
                    </div>
                }
            }
        </div>

        @if (_draft.HasChanges)
        {
            <BottomBar Class="cfg-unsaved">
                <div class="cfg-unsaved-row">
                    <MudIcon Icon="@Icons.Material.Outlined.WarningAmber" Size="Size.Small" Class="cfg-unsaved-icon" />
                    <span class="cfg-unsaved-text"><strong>@Loc["UnsavedChanges"]</strong> @Loc["InThisSection"]</span>
                    <span class="cfg-count">@Loc.Plural("ResChangeCount", "count", _draft.ChangedCount)</span>
                    <span class="cfg-unsaved-spacer"></span>
                    <CapsuleButton Class="cfg-reset" OnClick="ResetChanges" Disabled="_saving">@Loc["ResetChanges"]</CapsuleButton>
                    <CapsuleButton Primary="true" Icon="@Icons.Material.Outlined.Save" OnClick="SaveChanges" Disabled="_saving">
                        @(_saving ? Loc["Saving"] : Loc["SaveConfiguration"])
                    </CapsuleButton>
                </div>
            </BottomBar>
        }
    </div>

    @if (!_loading && NonEmptyGroups.Count > 0)
    {
        <aside class="config-section-aside">
            <KitCard Aside="true" Title="@Loc["AdmConfigInThisSection"]">
                <div class="cfg-toc-list">
                    @foreach (var group in NonEmptyGroups)
                    {
                        var count = GetPropertiesInGroup(group.Name).Count();
                        var anchor = ConfigNaming.GroupAnchor(group.Name);
                        var current = anchor == _currentAnchor;
                        @* The path is spelt out: a bare "#anchor" resolves against <base href="/"> and leaves the page.
                           The click marks the link current itself, since a hash-only change raises no LocationChanged. *@
                        <a class="cfg-toc @(current ? "cfg-toc--current" : null)" href="@($"{CurrentPath}#{anchor}")" aria-current="@(current ? "location" : null)" @onclick="@(() => _currentAnchor = anchor)">
                            <span class="cfg-toc-name">@group.DisplayName</span>
                            <span class="cfg-toc-count">@count</span>
                        </a>
                    }
                </div>
            </KitCard>
        </aside>
    }
</div>

@code {
    [Parameter]
    public string Category { get; set; } = string.Empty;

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    private bool _loading = true;
    private bool _saving = false;
    private CategoryMetadata? _categoryMetadata;
    private Dictionary<string, PropertyMetadata> _categoryProperties = new();
    private readonly ConfigDraft _draft = new();

    private static readonly HashSet<string> CustomPageCategories = new(StringComparer.OrdinalIgnoreCase)
    {
        "bannednames",
        "mssp",
        "restrictions",
        "sitelock",
        "sitelockrules"
    };

    private string CategoryTitle => _categoryMetadata?.DisplayName ?? ConfigNaming.CategoryTitle(Category);

    /// <summary>The "#group-…" anchor in the address, so the table of contents can mark it current.</summary>
    private string? _currentAnchor;

    /// <summary>The schema's groups that hold at least one property of this category, in order.</summary>
    private IReadOnlyList<GroupMetadata> NonEmptyGroups =>
        _categoryMetadata is null
            ? []
            : _categoryMetadata.Groups.OrderBy(g => g.Order).Where(g => GetPropertiesInGroup(g.Name).Any()).ToList();

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        ReadAnchor();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        ReadAnchor();
        _ = InvokeAsync(StateHasChanged);
    }

    private void ReadAnchor()
    {
        var fragment = new Uri(NavigationManager.Uri).Fragment;
        _currentAnchor = fragment.Length > 1 ? fragment[1..] : null;
    }

    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;

    private string? _loadedCategory;

    /// <summary>The page's own path, base-relative, without query or fragment.</summary>
    private string CurrentPath
    {
        get
        {
            var path = "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
            var cut = path.IndexOfAny(['?', '#']);
            return cut >= 0 ? path[..cut] : path;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (CustomPageCategories.Contains(Category))
        {
            return;
        }

        // The router re-renders this page on every navigation, including a hash-only one to a group
        // anchor; reloading then would throw away unsaved edits. Load once per category.
        if (string.Equals(_loadedCategory, Category, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _loadedCategory = Category;
        await LoadConfigurationAsync();
    }

    private async Task LoadConfigurationAsync()
    {
        _loading = true;
        _draft.Clear();

        try
        {
            switch (await SchemaService.GetSchemaAsync())
            {
                case ConfigurationSchema schema:
                    await LoadCategoryAsync(schema);
                    break;
                case ApiFailure failure:
                    Snackbar.Add($"{Loc["FailedToLoadSchema"]}: {failure.Message}", Severity.Error);
                    break;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(Loc["ErrorLoadingConfig"], ex.Message), Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>Picks this page's category out of <paramref name="schema"/> and loads its values.</summary>
    private async Task LoadCategoryAsync(ConfigurationSchema schema)
    {
        var categoryName = ConfigNaming.CategoryName(Category);

        _categoryMetadata = schema.Categories.FirstOrDefault(c =>
            c.Name.Equals(categoryName, StringComparison.OrdinalIgnoreCase));

        if (_categoryMetadata == null)
        {
            Snackbar.Add(string.Format(Loc["CategoryNotFoundShort"], categoryName), Severity.Warning);
            return;
        }

        _categoryProperties = schema.Properties
            .Where(kvp => kvp.Value.Category.Equals(categoryName, StringComparison.OrdinalIgnoreCase))
            .ToDictionary(kvp => kvp.Key, kvp => kvp.Value);

        switch (await AdminConfigService.FetchConfigurationFromServer())
        {
            case ConfigurationResponse response:
                _draft.Load(_categoryProperties.Values, response.Configuration);
                break;
            case ApiFailure failure:
                Snackbar.Add($"{Loc["FailedToLoadValues"]}: {failure.Message}", Severity.Error);
                break;
        }
    }

    private async Task SaveChanges()
    {
        _saving = true;
        _draft.ClearErrors();

        try
        {
            var changes = _draft.Changes();

            if (changes.Count == 0)
            {
                Snackbar.Add(Loc["NoChangesToSave"].Value, Severity.Info);
                return;
            }

            switch (await AdminConfigService.UpdateConfigAsync(changes))
            {
                case ConfigurationResponse:
                    Snackbar.Add(Loc.Plural("ConfigSavedCount", "count", changes.Count), Severity.Success);
                    _draft.MarkSaved(changes.Keys);
                    break;
                case ConfigSaveRefusal refusal:
                    _draft.SetErrors(refusal.Fields, Loc["ResInvalid"].Value);
                    foreach (var message in refusal.Messages)
                        Snackbar.Add(message ?? Loc["ResValidationFailed"].Value, Severity.Error);
                    break;
                case ApiFailure failure:
                    Snackbar.Add(string.Format(Loc["SaveFailed"].Value, failure.Message), Severity.Error);
                    break;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(Loc["SaveFailed"].Value, ex.Message), Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void ResetChanges() => _draft.ResetChanges();

    private void ResetToDefaults()
    {
        _draft.ResetToDefaults(_categoryProperties.Values);
        Snackbar.Add(Loc["DefaultsRestored"].Value, Severity.Info);
    }

    private IEnumerable<PropertyMetadata> GetPropertiesInGroup(string groupName)
    {
        return _categoryProperties.Values.Where(p =>
            (p.Group ?? "General").Equals(groupName, StringComparison.OrdinalIgnoreCase));
    }

    /// <summary>A row's edit landed in the draft; redraw the unsaved bar.</summary>
    private void OnDraftChanged()
    {
    }
}
