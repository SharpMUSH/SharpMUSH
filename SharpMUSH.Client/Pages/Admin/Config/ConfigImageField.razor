@using SharpMUSH.Client.Models.Configuration
@inject IStringLocalizer<SharedResource> Loc

@* A picture option (SharpConfig Image), its empty field showing the option's example. Empty previews what the
   portal shows instead: portal_favicon falls back to portal_logo, and both to the SharpMUSH logo; any other picture
   option (portal_banner, portal_side_art) shows nothing in its place. *@
<ImageUrlField Name="@Property.Path" Value="@Value" ValueChanged="SetAsync" Label="@Label" DescribedBy="@DescribedBy"
               Placeholder="@(Property.Example ?? Loc["AdmCfgImageDefault"].Value)" ReadOnly="Property.ReadOnly" Fallback="@Fallback" />

@code {
    [Parameter, EditorRequired]
    public PropertyMetadata Property { get; set; } = default!;

    [Parameter, EditorRequired]
    public ConfigDraft Draft { get; set; } = default!;

    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string? DescribedBy { get; set; }

    /// <summary>Raised after an edit lands in <see cref="Draft"/>.</summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    /// <summary>The option portal_favicon falls back to when empty.</summary>
    private const string LogoPath = "Cosmetic.PortalLogo";

    private const string FaviconPath = "Cosmetic.PortalFavicon";

    private string? Value => Draft.String(Property);

    /// <summary>The picture the portal shows while the option is empty; null when it shows none.</summary>
    private string? Fallback => Property.Path switch
    {
        FaviconPath when Draft.Values.GetValueOrDefault(LogoPath) is string logo && !string.IsNullOrWhiteSpace(logo) => logo,
        FaviconPath or LogoPath => "assets/Logo.svg",
        _ => null
    };

    private Task SetAsync(string value)
    {
        Draft.Set(Property, value);
        return OnChanged.InvokeAsync();
    }
}
