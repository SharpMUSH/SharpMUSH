@page "/admin"
@attribute [Authorize(Policy = BuildNavCatalog.OverviewPolicy)]
@inject IStringLocalizer<SharedResource> Loc
@inject IAuthorizationService Authorization
@inject SetupWizardService SetupWizard
@inject ServerInfoService ServerInfo
@inject OnboardingService Guide
@using SharpMUSH.Client.Components.Onboarding
@using SharpMUSH.Library.Models.Portal.Onboarding
@implements IDisposable
@using System.Security.Claims

<PageTitle>@Loc["AdmOverview"] — @Loc["NavBuildManage"] — <GameName /></PageTitle>

@* D1 §6.5: the plain header over the section's groups, each a grid of linked tool cards. The cards
   are BuildNavCatalog's entries, the same list and gates as the sidebar, so the overview offers
   exactly the pages the sidebar does, in the same groups. *@
<div class="page-stack page-stack--padded adm-dash">
    <PlainPageHeader Kicker="@Loc["NavBuildManage"]" Title="@Loc["AdmOverview"]" Description="@Loc["AdmOverviewDescription"]" />
    @* The first-run wizard is unfinished: an administrator who closed the tab after claiming the game
       finds the way back here, since nothing else sends them to /setup once the game is claimed. *@
    @if (_setupPending)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="adm-dash-setup">
            @Loc["AdmSetupUnfinished"]
            <a href="/setup" class="adm-dash-setup-link">@Loc["AdmSetupContinue"]</a>
        </MudAlert>
    }

    @* The first-players checklist leads the page until every step is verified or deferred; after that it is
       one line, for the administrator who wants to look again. *@
    <AuthorizeView Policy="config.admin">
        @if (ChecklistOpen)
        {
            <section class="adm-dash-checklist" aria-labelledby="adm-dash-checklist-title">
                <h2 id="adm-dash-checklist-title">@Loc["GuideAdminHeading"]</h2>
                <p>@Loc["GuideAdminDashboardLead"]</p>
                <ChecklistProgress Progress="Guide.Progress" />
                <a class="adm-dash-checklist-continue" href="/admin/onboarding">@Loc["GuideAdminContinue"]</a>
            </section>
        }
        else
        {
            <p class="adm-dash-guide"><a href="/admin/onboarding">@Loc["GuideAdminEntry"]</a> @Loc["GuideAdminDescription"]</p>
        }
    </AuthorizeView>

    @foreach (var group in _groups)
    {
        <section class="adm-dash-group" aria-label="@Loc[BuildNavCatalog.GroupLabelKey(group.Key)!]">
            <SectionLabel>@Loc[BuildNavCatalog.GroupLabelKey(group.Key)!]</SectionLabel>
            <div class="adm-dash-grid">
                @foreach (var card in group)
                {
                    <LinkCard Class="adm-dash-card" Href="@card.Href" Icon="@card.Icon" Title="@Loc[card.LabelKey]" Description="@Loc[card.DescriptionKey]" />
                }
            </div>
        </section>
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private IReadOnlyList<IGrouping<BuildNavCatalog.Group, BuildNavCatalog.Entry>> _groups = [];

    /// <summary>The viewer administers the server and the first-run wizard is unfinished.</summary>
    private bool _setupPending;

    private ClaimsPrincipal? _user;

    private bool ChecklistOpen => Guide is { Ready: true, Journey: GuideJourney.Administrator } && !ChecklistProgress.Finished(Guide.Progress);

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null) return;
        _user = (await AuthState).User;
        ServerInfo.Changed += OnServerInfoChanged;
        Guide.Changed += OnGuideChanged;
        var checklist = (await Authorization.AuthorizeAsync(_user, "config.admin")).Succeeded
            ? Guide.LoadAsync(GuideJourney.Administrator)
            : Task.CompletedTask;
        var setup = (await Authorization.AuthorizeAsync(_user, "server.admin")).Succeeded
            ? SetupWizard.GetAsync()
            : null;
        await LoadGroupsAsync(_user);
        _setupPending = setup is not null && await setup is SetupWizardResponse { Pending: true };
        await checklist;
    }

    private async Task LoadGroupsAsync(ClaimsPrincipal user) =>
        _groups = (await BuildNavCatalog.VisibleAsync(Authorization, user, ServerInfo))
            .Where(e => e.Group != BuildNavCatalog.Group.Overview)
            .GroupBy(e => e.Group)
            .ToList();

    /// <summary>An application was turned on or off: its cards follow without a reload.</summary>
    private void OnServerInfoChanged() => _ = InvokeAsync(async () =>
    {
        if (_user is null) return;
        await LoadGroupsAsync(_user);
        StateHasChanged();
    });

    private void OnGuideChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ServerInfo.Changed -= OnServerInfoChanged;
        Guide.Changed -= OnGuideChanged;
    }
}
