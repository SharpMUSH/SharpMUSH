@page "/admin"
@attribute [Authorize(Policy = BuildNavCatalog.OverviewPolicy)]
@inject IStringLocalizer<SharedResource> Loc
@inject IAuthorizationService Authorization
@inject SetupWizardService SetupWizard

<PageTitle>@Loc["AdmOverview"] — @Loc["NavBuildManage"] — @Loc["AppTitle"]</PageTitle>

@* D1 §6.5: the plain header over the section's groups, each a grid of linked tool cards. The cards
   are BuildNavCatalog's entries, the same list and gates as the sidebar, so the overview offers
   exactly the pages the sidebar does, in the same groups. *@
<div class="page-stack page-stack--padded adm-dash">
    <PlainPageHeader Kicker="@Loc["NavBuildManage"]" Title="@Loc["AdmOverview"]" Description="@Loc["AdmOverviewDescription"]" />

    @* The first-run wizard is unfinished: an administrator who closed the tab after claiming the game
       finds the way back here, since nothing else sends them to /setup once the game is claimed. *@
    @if (_setupPending)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="adm-dash-setup">
            @Loc["AdmSetupUnfinished"]
            <a href="/setup" class="adm-dash-setup-link">@Loc["AdmSetupContinue"]</a>
        </MudAlert>
    }

    @foreach (var group in _groups)
    {
        <section class="adm-dash-group" aria-label="@Loc[BuildNavCatalog.GroupLabelKey(group.Key)!]">
            <SectionLabel>@Loc[BuildNavCatalog.GroupLabelKey(group.Key)!]</SectionLabel>
            <div class="adm-dash-grid">
                @foreach (var card in group)
                {
                    <LinkCard Class="adm-dash-card" Href="@card.Href" Icon="@card.Icon" Title="@Loc[card.LabelKey]" Description="@Loc[card.DescriptionKey]" />
                }
            </div>
        </section>
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private IReadOnlyList<IGrouping<BuildNavCatalog.Group, BuildNavCatalog.Entry>> _groups = [];

    /// <summary>The viewer administers the server and the first-run wizard is unfinished.</summary>
    private bool _setupPending;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null) return;
        var user = (await AuthState).User;
        var setup = (await Authorization.AuthorizeAsync(user, "server.admin")).Succeeded
            ? SetupWizard.GetAsync()
            : null;
        _groups = (await BuildNavCatalog.VisibleAsync(Authorization, user))
            .Where(e => e.Group != BuildNavCatalog.Group.Overview)
            .GroupBy(e => e.Group)
            .ToList();
        _setupPending = setup is not null && await setup is SetupWizardResponse { Pending: true };
    }
}
