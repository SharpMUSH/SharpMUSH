@page "/admin"
@attribute [Authorize(Policy = "players.view")]
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["AdmDashboardTitle"] — @Loc["AppTitle"]</PageTitle>

<div style="padding:var(--cpad);">
    <div class="ph-header">
        <div class="ph-kicker">@Loc["AdmKicker"]</div>
        <h1 class="ph-title">@Loc["AdmDashboardTitle"]</h1>
    </div>

    <div class="ph-grid">
        @foreach (var card in _cards)
        {
            <a href="@card.Href" class="ph-card">
                <div class="ph-card-icon">
                    <MudIcon Icon="@card.Icon" />
                </div>
                <div class="ph-card-body">
                    <div class="ph-card-title">@Loc[card.TitleKey]</div>
                    <div class="ph-card-action">@Loc[card.ActionKey]</div>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Class="ph-card-chevron" />
            </a>
        }
    </div>
</div>

@code {
    private record AdminCard(string TitleKey, string ActionKey, string Href, string Icon);

    private readonly AdminCard[] _cards =
    [
        new("AdmPlayersTitle", "AdmPlayersAction", "/admin/players", Icons.Material.Filled.Group),
        new("AdmAccountsTitle", "AdmAccountsAction", "/admin/accounts", Icons.Material.Filled.ManageAccounts),
        new("Characters", "AdmCharactersAction", "/admin/characters", Icons.Material.Filled.Person),
        new("AdmProfilesTitle", "AdmProfilesAction", "/admin/profiles", Icons.Material.Filled.Badge),
        new("Configuration", "AdmConfigAction", "/admin/config", Icons.Material.Filled.Settings),
        new("AdmRolesTitle", "AdmRolesAction", "/admin/roles", Icons.Material.Filled.Shield),
        new("AdmModerationTitle", "AdmModerationAction", "/admin/moderation", Icons.Material.Filled.Gavel),
        new("Suggestions", "AdmSuggestionsAction", "/admin/suggestions", Icons.Material.Filled.Lightbulb),
        new("WikiAdmin", "WikiAdmin", "/admin/wiki", Icons.Material.Filled.MenuBook),
        new("AdmMediaTitle", "AdmMediaAction", "/admin/media", Icons.Material.Filled.PermMedia),
        new("AdmApplicationsTitle", "AdmApplicationsAction", "/admin/applications", Icons.Material.Filled.Apps),
        new("AdmPackagesTitle", "AdmPackagesAction", "/admin/packages", Icons.Material.Filled.Inventory2),
        new("AdmLayoutTitle", "AdmLayoutAction", "/admin/layout", Icons.Material.Filled.Dashboard),
        new("Server", "AdmServerAction", "/admin/server", Icons.Material.Filled.Dns),
        new("AdmDatabaseImportTitle", "AdmDatabaseImportAction", "/admin/database/import", Icons.Material.Filled.CloudUpload),
    ];
}
