@page "/admin/themes"
@attribute [Authorize(Policy = "layout.admin")]
@implements IDisposable
@inject IStringLocalizer<SharedResource> Loc
@inject PortalThemesAdminService Api
@inject IThemeService Themes
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IHttpClientFactory HttpFactory
@using ThemePalette = MarkupString.ThemePalette
@using ThemeHarmony = MarkupString.ThemeHarmony
@using SharpMUSH.Library.DiscriminatedUnions

@* The theme editor: the game's themes as named sets of the design tokens and style choices, which ones a
   character that chose none sees (one for browsers that prefer dark, one for light), and which ones players may
   choose. Built-in themes are read-only; "Duplicate" starts an editable copy. "Try on the portal" paints the whole
   portal with the unsaved draft until it is turned off or the page is left. *@

<PageTitle>@Loc["AdmThemesTitle"] — @Loc["AdmBreadcrumb"] — @Loc["AppTitle"]</PageTitle>

<div class="page-stack page-stack--padded adm-theme">
    <PlainPageHeader Kicker="@Loc["AdmGroupPortal"]" Title="@Loc["AdmThemesTitle"]" Description="@Loc["AdmThemesDescription"]">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" id="theme-new"
                       Disabled="@(_state is null || _busy)" OnClick="New">@Loc["AdmThemesNew"]</MudButton>
        </Actions>
    </PlainPageHeader>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @if (_state is null)
    {
        @if (_error is null)
        {
            <MudProgressLinear Indeterminate="true" />
        }
    }
    else
    {
        <div class="adm-theme-layout">
            <nav class="adm-theme-list" aria-label="@Loc["AdmThemesTitle"]">
                @foreach (var theme in _state.Themes)
                {
                    var current = _draft?.Id == theme.Id;
                    <button type="button" class="adm-theme-item @(current ? "adm-theme-item--current" : null)" data-theme="@theme.Id"
                            aria-current="@(current ? "true" : null)" @onclick="() => Select(theme)">
                        <ThemeSwatch Theme="ThemeResolver.Resolve(theme)" />
                        <span class="adm-theme-item-text">
                            <span class="adm-theme-item-name">@theme.Name</span>
                            <span class="adm-theme-item-tags">
                                @if (IsDefault(theme.Id))
                                {
                                    <span class="adm-theme-tag adm-theme-tag--default">@Loc["AdmThemesDefault"]</span>
                                }
                                @if (theme.BuiltIn)
                                {
                                    <span class="adm-theme-tag">@Loc["AdmThemesBuiltIn"]</span>
                                }
                                @if (!theme.Published)
                                {
                                    <span class="adm-theme-tag adm-theme-tag--draft">@Loc["AdmThemesUnpublished"]</span>
                                }
                            </span>
                        </span>
                    </button>
                }
                @if (_draft is { Id: null })
                {
                    <div class="adm-theme-item adm-theme-item--current adm-theme-item--new">
                        <ThemeSwatch Theme="Draft" />
                        <span class="adm-theme-item-text">
                            <span class="adm-theme-item-name">@(string.IsNullOrWhiteSpace(_draft.Name) ? Loc["AdmThemesUntitled"] : _draft.Name)</span>
                            <span class="adm-theme-item-tags"><span class="adm-theme-tag adm-theme-tag--draft">@Loc["AdmThemesNotSaved"]</span></span>
                        </span>
                    </div>
                }
            </nav>

            @if (_draft is not null)
            {
                var locked = _draft.BuiltIn;
                <KitCard Class="adm-theme-editor" Title="@(string.IsNullOrWhiteSpace(_draft.Name) ? Loc["AdmThemesUntitled"] : _draft.Name)"
                         Sub="@Loc[_draft.Id is null ? "AdmThemesNewSub" : locked ? "AdmThemesBuiltInSub" : "AdmThemesEditSub"]">
                    <div class="adm-theme-body">
                        @if (locked)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" id="theme-builtin">@Loc["AdmThemesBuiltInNote"]</MudAlert>
                        }

                        <div class="adm-theme-meta">
                            <MudTextField T="string" @bind-Value="_draft.Name" @bind-Value:after="Edited" Label="@Loc["AdmThemesName"]"
                                          MaxLength="40" Disabled="locked" Variant="Variant.Outlined" Margin="Margin.Dense" id="theme-name" />
                            <div class="adm-theme-mode" role="radiogroup" aria-label="@Loc["AdmThemesMode"]">
                                <button type="button" role="radio" class="adm-theme-mode-choice @(_draft.Dark ? "is-on" : null)" disabled="@(locked || IsDefault(_draft.Id))"
                                        aria-checked="@(_draft.Dark ? "true" : "false")" @onclick="() => SetDark(true)">
                                    <MudIcon Icon="@Icons.Material.Outlined.DarkMode" Size="Size.Small" />@Loc["AdmThemesDark"]
                                </button>
                                <button type="button" role="radio" class="adm-theme-mode-choice @(!_draft.Dark ? "is-on" : null)" disabled="@(locked || IsDefault(_draft.Id))"
                                        aria-checked="@(!_draft.Dark ? "true" : "false")" @onclick="() => SetDark(false)">
                                    <MudIcon Icon="@Icons.Material.Outlined.LightMode" Size="Size.Small" />@Loc["AdmThemesLight"]
                                </button>
                            </div>
                            <MudSwitch T="bool" @bind-Value="_draft.Published" @bind-Value:after="Edited" Color="Color.Primary" Disabled="locked"
                                       Label="@Loc["AdmThemesPublished"]" id="theme-published" />
                        </div>

                        @if (!locked)
                        {
                            <section class="adm-theme-group" id="theme-generate">
                                <h3 class="adm-theme-group-title">@Loc["AdmThemesGenerate"]</h3>
                                <p class="adm-theme-hint">@Loc["AdmThemesGenerateHint"]</p>
                                <div class="adm-theme-generate">
                                    <label class="adm-theme-token">
                                        <input type="color" class="adm-theme-color" value="@_seed" aria-label="@Loc["AdmThemesSeed"]"
                                               @onchange="e => SetSeed(e.Value?.ToString())" />
                                        <span class="adm-theme-token-text">
                                            <span class="adm-theme-token-name">@Loc["AdmThemesSeed"]</span>
                                            <input type="text" class="adm-theme-hex" value="@_seed" spellcheck="false" maxlength="7" id="theme-seed"
                                                   aria-label="@($"{Loc["AdmThemesSeed"]} (hex)")" @onchange="e => SetSeed(e.Value?.ToString())" />
                                        </span>
                                    </label>
                                    <MudSelect T="ThemeHarmony" @bind-Value="_harmony" Label="@Loc["AdmThemesHarmony"]" Variant="Variant.Outlined"
                                               Margin="Margin.Dense" Dense="true" id="theme-harmony">
                                        @foreach (var harmony in Enum.GetValues<ThemeHarmony>())
                                        {
                                            <MudSelectItem T="ThemeHarmony" Value="@harmony">@Loc[$"AdmThemesHarmony{harmony}"]</MudSelectItem>
                                        }
                                    </MudSelect>
                                    <MudSlider T="double" @bind-Value="_contrast" Min="0" Max="1" Step="0.1" Color="Color.Primary" Class="adm-theme-contrast-slider">
                                        @Loc["AdmThemesContrastLevel", _contrast.ToString("0.0")]
                                    </MudSlider>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="GenerateFromSeed" id="theme-generate-seed">
                                        @Loc["AdmThemesGenerateSeed"]
                                    </MudButton>
                                </div>
                                <div class="adm-theme-generate">
                                    <MudSelect T="string" @bind-Value="_preset" Label="@Loc["AdmThemesPreset"]" Variant="Variant.Outlined"
                                               Margin="Margin.Dense" Dense="true" id="theme-preset">
                                        @foreach (var preset in ThemePalette.Presets)
                                        {
                                            <MudSelectItem T="string" Value="@preset.Name">@preset.Name</MudSelectItem>
                                        }
                                    </MudSelect>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@string.IsNullOrEmpty(_preset)"
                                               OnClick="() => UsePalette(_preset)" id="theme-generate-preset">@Loc["AdmThemesUsePalette"]</MudButton>
                                </div>
                                <div class="adm-theme-generate adm-theme-generate--json">
                                    <MudTextField T="string" @bind-Value="_paletteJson" Label="@Loc["AdmThemesPaletteJson"]" Lines="3"
                                                  Variant="Variant.Outlined" Margin="Margin.Dense" Class="adm-theme-code" id="theme-palette-json"
                                                  Placeholder='{"seed":"#6b4fa8","harmony":"triadic","contrast":0.3}' />
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@string.IsNullOrWhiteSpace(_paletteJson)"
                                               OnClick="() => UsePalette(_paletteJson)" id="theme-generate-json">@Loc["AdmThemesUseJson"]</MudButton>
                                </div>
                                @if (_paletteError is not null)
                                {
                                    <MudAlert Severity="Severity.Warning" Dense="true" id="theme-palette-error">@_paletteError</MudAlert>
                                }
                                <details class="adm-theme-guide" id="theme-guide">
                                    <summary>@Loc["AdmThemesGuideTitle"]</summary>
                                    <p>@Loc["AdmThemesGuideSeed"]</p>
                                    <p>@Loc["AdmThemesGuidePreset"]</p>
                                    <p>@Loc["AdmThemesGuideJson"]</p>
                                    <p>@Loc["AdmThemesGuideMapping"]</p>
                                    <p>@Loc["AdmThemesGuideCode"]</p>
                                    <pre class="adm-theme-code-sample">@GuideCode</pre>
                                    <p>@Loc["AdmThemesGuideDocs"]</p>
                                </details>
                            </section>
                        }

                        @if (ThemeStylesheet.ColorOverrides(_draft.Stylesheet) is { Count: > 0 } overridden)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" id="theme-sheet-overrides">
                                @Loc["AdmThemesSheetOverrides", string.Join(", ", overridden.Keys.Select(k => Loc[TokenKey(k)].Value))]
                            </MudAlert>
                        }

                        @foreach (var (groupKey, tokens) in Groups)
                        {
                            <section class="adm-theme-group">
                                <h3 class="adm-theme-group-title">@Loc[groupKey]</h3>
                                <div class="adm-theme-tokens">
                                    @foreach (var token in tokens)
                                    {
                                        <label class="adm-theme-token" data-token="@token">
                                            <input type="color" class="adm-theme-color" value="@_draft.Tokens[token]" disabled="@locked"
                                                   aria-label="@Loc[TokenKey(token)]" @onchange="e => SetToken(token, e.Value?.ToString())" />
                                            <span class="adm-theme-token-text">
                                                <span class="adm-theme-token-name">@Loc[TokenKey(token)]</span>
                                                <input type="text" class="adm-theme-hex" value="@_draft.Tokens[token]" disabled="@locked" spellcheck="false"
                                                       maxlength="7" aria-label="@($"{Loc[TokenKey(token)]} (hex)")"
                                                       @onchange="e => SetToken(token, e.Value?.ToString())" />
                                            </span>
                                        </label>
                                    }
                                </div>
                            </section>
                        }

                        <section class="adm-theme-group" id="theme-style">
                            <h3 class="adm-theme-group-title">@Loc["AdmThemesGroupStyle"]</h3>
                            <div class="adm-theme-mode adm-theme-edit-mode" role="radiogroup" aria-label="@Loc["AdmThemesEditMode"]" id="theme-edit-mode">
                                @foreach (var mode in ThemeStyles.Modes)
                                {
                                    var on = Mode == mode;
                                    <button type="button" role="radio" class="adm-theme-mode-choice @(on ? "is-on" : null)" disabled="@locked"
                                            aria-checked="@(on ? "true" : "false")" data-mode="@mode" @onclick="() => SetModeAsync(mode)">
                                        @Loc[ModeKey(mode)]
                                    </button>
                                }
                            </div>
                            <p class="adm-theme-hint">@Loc[ModeKey(Mode) + "Hint"]</p>
                            <div class="adm-theme-styles">
                                @foreach (var key in Mode == ThemeStyles.Simple ? ThemeStyles.Keys : ThemeStyles.PartKeys)
                                {
                                    <MudSelect T="string" Value="@StyleValue(key)" ValueChanged="v => SetStyle(key, v)" Label="@Loc[StyleKey(key)]"
                                               Disabled="locked" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" id="@($"theme-style-{key}")">
                                        @foreach (var choice in ThemeStyles.Choices[key])
                                        {
                                            <MudSelectItem T="string" Value="@choice">
                                                @if (key == ThemeStyles.FontDisplay)
                                                {
                                                    <span class="adm-theme-face" data-font-display="@choice">@FaceName(choice)</span>
                                                }
                                                else
                                                {
                                                    @Loc[ChoiceKey(key, choice)]
                                                }
                                            </MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                            </div>
                            @if (Mode != ThemeStyles.Simple)
                            {
                                <h4 class="adm-theme-subtitle">@Loc["AdmThemesDecorative"]</h4>
                                <p class="adm-theme-hint">@Loc["AdmThemesDecorativeHint"]</p>
                                <div class="adm-theme-tokens" id="theme-decorative">
                                    @foreach (var token in ThemeTokens.Decorative)
                                    {
                                        var value = DecorativeValue(token);
                                        <label class="adm-theme-token" data-token="@token">
                                            <input type="color" class="adm-theme-color" value="@value" disabled="@locked"
                                                   aria-label="@Loc[TokenKey(token)]" @onchange="e => SetToken(token, e.Value?.ToString())" />
                                            <span class="adm-theme-token-text">
                                                <span class="adm-theme-token-name">@Loc[TokenKey(token)]</span>
                                                <input type="text" class="adm-theme-hex" value="@value" disabled="@locked" spellcheck="false"
                                                       maxlength="7" aria-label="@($"{Loc[TokenKey(token)]} (hex)")"
                                                       @onchange="e => SetToken(token, e.Value?.ToString())" />
                                            </span>
                                        </label>
                                    }
                                </div>
                            }
                        </section>

                        <section class="adm-theme-group">
                            <h3 class="adm-theme-group-title">@Loc["AdmThemesContrast"]</h3>
                            <p class="adm-theme-hint">@Loc["AdmThemesContrastHint"]</p>
                            <ul class="adm-theme-contrast" id="theme-contrast">
                                @{ var effective = ThemeStylesheet.WithColorOverrides(_draft.Tokens, _draft.Stylesheet); }
                                @foreach (var (fg, bg, ratio) in ThemeResolver.Contrasts(effective))
                                {
                                    var ok = ratio >= ThemeTokens.TextContrast;
                                    <li class="@(ok ? null : "adm-theme-contrast--low")" data-pair="@($"{fg}/{bg}")">
                                        <span class="adm-theme-contrast-sample" style="@($"color:{effective[fg]};background:{effective[bg]};border-color:{effective[ThemeTokens.Border]}")">Aa</span>
                                        <span class="adm-theme-contrast-pair">@Loc["AdmThemesOn", Loc[TokenKey(fg)], Loc[TokenKey(bg)]]</span>
                                        <span class="adm-theme-contrast-ratio">@ratio.ToString("0.0")</span>
                                        <MudIcon Icon="@(ok ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Warning)" Size="Size.Small"
                                                 Class="@(ok ? "adm-theme-ok" : "adm-theme-low")" Title="@Loc[ok ? "AdmThemesContrastOk" : "AdmThemesContrastLow"]" />
                                    </li>
                                }
                            </ul>
                        </section>

                        @if (Mode == ThemeStyles.Custom)
                        {
                            <section class="adm-theme-group" id="theme-stylesheet">
                                <h3 class="adm-theme-group-title">@Loc["AdmThemesStylesheet"]</h3>
                                <p class="adm-theme-hint">@Loc["AdmThemesStylesheetHint"]</p>
                                <textarea class="adm-theme-sheet" id="theme-sheet" spellcheck="false" rows="24" disabled="@locked"
                                          aria-label="@Loc["AdmThemesStylesheet"]" value="@SheetText"
                                          @onchange="e => SetStylesheet(e.Value?.ToString())"></textarea>
                                <div class="adm-theme-sheet-bar">
                                    <span class="adm-theme-hint">@Loc["AdmThemesStylesheetSize", SheetText.Length, ThemeStylesheet.MaxLength]</span>
                                    <span class="adm-theme-spacer"></span>
                                    @if (!locked && _draft.Stylesheet is not null)
                                    {
                                        <MudButton Variant="Variant.Text" OnClick="ResetStylesheet" id="theme-sheet-reset">@Loc["AdmThemesStylesheetReset"]</MudButton>
                                    }
                                </div>
                                @if (SheetProblems is { Count: > 0 } problems)
                                {
                                    <ul class="adm-theme-sheet-problems" id="theme-sheet-problems">
                                        @foreach (var problem in problems)
                                        {
                                            <li>@problem</li>
                                        }
                                    </ul>
                                }
                            </section>
                        }

                        <div class="adm-theme-actions">
                            <MudSwitch T="bool" Value="_trying" ValueChanged="Try" Color="Color.Primary" Label="@Loc["AdmThemesTry"]" id="theme-try" />
                            <span class="adm-theme-spacer"></span>
                            @if (locked)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Duplicate" id="theme-duplicate">@Loc["AdmThemesDuplicate"]</MudButton>
                            }
                            else
                            {
                                @if (_draft.Id is not null)
                                {
                                    <MudButton Variant="Variant.Text" Color="Color.Error" Disabled="@(_busy || IsDefault(_draft.Id))"
                                               OnClick="DeleteAsync" id="theme-delete">@Loc["AdmThemesDelete"]</MudButton>
                                    <MudButton Variant="Variant.Text" Disabled="_busy" OnClick="Duplicate" id="theme-duplicate">@Loc["AdmThemesDuplicate"]</MudButton>
                                }
                                <MudButton Variant="Variant.Text" Disabled="@(_busy || !_dirty)" OnClick="Revert" id="theme-revert">@Loc["AdmThemesRevert"]</MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || !_dirty || SheetProblems.Count > 0)" OnClick="SaveAsync" id="theme-save">
                                    @Loc["Save"]
                                </MudButton>
                            }
                            @if (_draft.Id is not null && !IsDefault(_draft.Id))
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(_busy || _dirty || !_draft.Published)"
                                           OnClick="MakeDefaultAsync" id="theme-default">
                                    @Loc[_draft.Dark ? "AdmThemesMakeDefaultDark" : "AdmThemesMakeDefaultLight"]
                                </MudButton>
                            }
                        </div>
                    </div>
                </KitCard>
            }
        </div>
    }
</div>

@code {
    private sealed class ThemeDraft
    {
        public string? Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public bool Dark { get; set; } = true;
        public bool Published { get; set; }
        public bool BuiltIn { get; set; }
        public Dictionary<string, string> Tokens { get; set; } = [];

        /// <summary>The theme's own stylesheet, or null while it has none (the editor then shows the starter).</summary>
        public string? Stylesheet { get; set; }

        public static ThemeDraft From(PortalTheme theme) => new()
        {
            Id = theme.Id,
            Name = theme.Name,
            Dark = theme.Dark,
            Published = theme.Published,
            BuiltIn = theme.BuiltIn,
            Tokens = ThemeResolver.Complete(theme.Tokens) is var (colors, style) ? colors.Concat(style).ToDictionary() : [],
            Stylesheet = theme.Stylesheet,
        };

        public PortalTheme ToTheme() => new(Id ?? "draft", Name, Dark, Published, Tokens, Stylesheet: Stylesheet);

        public PortalThemeRequest ToRequest() => new(Name.Trim(), Dark, Published, new Dictionary<string, string>(Tokens), Stylesheet);
    }

    private static readonly (string Group, string[] Tokens)[] Groups =
    [
        ("AdmThemesGroupSurfaces", [ThemeTokens.Background, ThemeTokens.Surface, ThemeTokens.Surface2, ThemeTokens.Surface3, ThemeTokens.Rail]),
        ("AdmThemesGroupText", [ThemeTokens.Text, ThemeTokens.TextDim, ThemeTokens.TextFaint]),
        ("AdmThemesGroupLines", [ThemeTokens.Border, ThemeTokens.BorderSoft]),
        ("AdmThemesGroupColours", [ThemeTokens.Accent, ThemeTokens.Warn, ThemeTokens.LinkMissing]),
    ];

    private PortalThemesResponse? _state;
    private ThemeDraft? _draft;
    private bool _dirty;
    private bool _busy;
    private bool _trying;
    private string? _error;

    private string _seed = "#6b4fa8";
    private ThemeHarmony _harmony = ThemeHarmony.Analogous;
    private double _contrast;
    private string? _preset;
    private string? _paletteJson;
    private string? _paletteError;

    private ResolvedTheme Draft => ThemeResolver.Resolve(_draft!.ToTheme());

    /// <summary>What the stylesheet box shows: the theme's own, or the starter while it has none.</summary>
    private string SheetText => _draft?.Stylesheet ?? (_draft is null ? string.Empty : ThemeStylesheet.Starter(Draft, _partsCss));

    /// <summary>The portal's parts CSS (css/themes/), which the stylesheet's starter lists the theme's rules from.</summary>
    private string? _partsCss;

    private static readonly string[] PartsFiles = ["faces", "shape", "textures", "frames", "titles", "imagery"];

    /// <summary>How the draft is edited: Simple, Complex or Custom.</summary>
    private string Mode => _draft is null ? ThemeStyles.Simple : ThemeStyles.ModeOf(_draft.Tokens, _draft.Stylesheet);

    private IReadOnlyList<string> SheetProblems => ThemeStylesheet.Validate(_draft?.Stylesheet);

    private const string GuideCode = """
        using MarkupString;
        using SharpMUSH.Library.Models.Portal;

        // One colour, a harmony, light or dark, and how far above 4.5:1 to go (0 to 1).
        var palette = ThemePalette.Generate(new RgbColor(0x6b, 0x4f, 0xa8), ThemeHarmony.Triadic, ThemeMode.Light, contrast: 0.3);

        // Or a preset: ThemePalette.Preset("nord"), ThemePalette.Genres, ThemePalette.Presets.
        // Or palette JSON: ThemePalette.TryParse(json, out var parsed, out var error).

        var (colors, dark) = ThemeGenerator.FromPalette(palette);
        // colors: the 13 colour tokens. Send them, with style choices if you like, as the
        // Tokens of a PortalThemeRequest to POST api/themes (needs layout.admin).
        """;

    /// <summary>"surface-2" is "AdmThemeTokenSurface2".</summary>
    private static string TokenKey(string token) => "AdmThemeToken" + Pascal(token);

    /// <summary>"font-body" is "AdmThemeStyleFontBody"; with "serif", "AdmThemeStyleFontBodySerif".</summary>
    private static string StyleKey(string key, string? choice = null) => "AdmThemeStyle" + Pascal(key) + (choice is null ? "" : Pascal(choice));

    /// <summary>
    /// A choice's label. A part takes the label of the Simple choice of the same name (the frame-marks "plating" is the
    /// frame "plating"), and has its own only where no Simple choice is named the same.
    /// </summary>
    private string ChoiceKey(string key, string choice)
    {
        var simple = key switch
        {
            ThemeStyles.FrameMarks or ThemeStyles.FrameShadow => ThemeStyles.Frame,
            ThemeStyles.OrnamentGlyphs or ThemeStyles.OrnamentUnderline => ThemeStyles.Ornament,
            ThemeStyles.EffectShadow => ThemeStyles.Effect,
            _ => null,
        };
        return simple is not null && ThemeStyles.Choices[simple].Contains(choice) ? StyleKey(simple, choice) : StyleKey(key, choice);
    }

    /// <summary>"complex" is "AdmThemesEditModeComplex".</summary>
    private static string ModeKey(string mode) => "AdmThemesEditMode" + Pascal(mode);

    /// <summary>What a menu shows: the draft's own value, or for a part it leaves unset, what its Simple setting brings.</summary>
    private string StyleValue(string key)
        => _draft!.Tokens.TryGetValue(key, out var value) ? value : ThemeStyles.PartsOf(_draft.Tokens, Mode)[key];

    /// <summary>A decorative colour: the draft's own, or the one the theme derives when it sets none.</summary>
    private string DecorativeValue(string token)
        => _draft!.Tokens.TryGetValue(token, out var value) ? value : Draft.Tokens[token];

    private static string Pascal(string name) => string.Concat(name.Split('-').Select(p => char.ToUpperInvariant(p[0]) + p[1..]));

    /// <summary>A title face by its own name; the portal's own face is the one choice described rather than named.</summary>
    private string FaceName(string face) => face switch
    {
        "ui" => Loc["AdmThemeStyleFontDisplayUi"],
        "cinzel" => "Cinzel",
        "cormorant" => "Cormorant Garamond",
        "fell" => "IM Fell English",
        "playfair" => "Playfair Display",
        "grenze" => "Grenze Gotisch",
        "space" => "Space Grotesk",
        "typewriter" => "Special Elite",
        "orbitron" => "Orbitron",
        "marcellus" => "Marcellus",
        "fredoka" => "Fredoka",
        "dancing" => "Dancing Script",
        "mochiy" => "Mochiy Pop One",
        "patrick" => "Patrick Hand",
        "dela" => "Dela Gothic One",
        "graduate" => "Graduate",
        "saira-stencil" => "Saira Stencil One",
        "pixelify" => "Pixelify Sans",
        "yuji" => "Yuji Syuku",
        "bangers" => "Bangers",
        "lilita" => "Lilita One",
        "titan" => "Titan One",
        "chakra" => "Chakra Petch",
        "monoton" => "Monoton",
        "michroma" => "Michroma",
        "antonio" => "Antonio",
        "oxanium" => "Oxanium",
        "russo" => "Russo One",
        _ => face,
    };

    private bool IsDefault(string? id) => id is not null && _state is not null
        && (id == _state.DefaultThemeId || id == _state.DefaultLightThemeId);

    protected override async Task OnInitializedAsync()
    {
        var partsCss = LoadPartsCssAsync();
        switch (await Api.GetAsync())
        {
            case PortalThemesResponse state:
                _state = state;
                Select(state.Themes.FirstOrDefault(t => t.Id == state.Defaults.For(Themes.PrefersLight)) ?? state.Themes[0]);
                break;
            case ApiFailure failure:
                _error = failure.Message;
                break;
        }

        _partsCss = await partsCss;
    }

    /// <summary>The parts CSS, for the starter; without it the starter lists variables and hooks only.</summary>
    private async Task<string?> LoadPartsCssAsync()
    {
        try
        {
            var http = HttpFactory.CreateClient("help");
            var files = await Task.WhenAll(PartsFiles.Select(f => http.GetStringAsync($"css/themes/{f}.css")));
            return string.Join("\n", files);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or InvalidOperationException)
        {
            return null;
        }
    }

    private void Select(PortalTheme theme)
    {
        _draft = ThemeDraft.From(theme);
        _dirty = false;
        Refresh(dirty: false);
    }

    private void New() => StartCopy(_draft?.ToTheme() ?? BuiltInThemes.Phosphor, string.Empty);

    private void Duplicate() => StartCopy(_draft!.ToTheme(), Loc["AdmThemesCopyOf", _draft.Name]);

    private void StartCopy(PortalTheme source, string name)
    {
        _draft = ThemeDraft.From(source with { Name = name, Published = false, BuiltIn = false });
        _draft.Id = null;
        _draft.BuiltIn = false;
        Edited();
    }

    private void Revert()
    {
        if (_draft?.Id is { } id && _state?.Themes.FirstOrDefault(t => t.Id == id) is { } saved)
        {
            Select(saved);
        }
        else if (_state is not null)
        {
            Select(_state.Themes[0]);
        }
    }

    private void SetDark(bool dark)
    {
        _draft!.Dark = dark;
        Edited();
    }

    /// <summary>
    /// Moves the draft to another mode. Into Complex or Custom, each part takes the value its Simple setting brings, so
    /// nothing changes on the page. Back to Simple, the parts set apart go; out of Custom, the stylesheet goes. Either
    /// is asked first when it would change the look.
    /// </summary>
    private async Task SetModeAsync(string mode)
    {
        var from = Mode;
        if (_draft is null || mode == from) return;

        if (from == ThemeStyles.Custom && _draft.Stylesheet is not null
            && !await ConfirmAsync("AdmThemesLeaveCustomTitle", "AdmThemesLeaveCustomBody"))
        {
            return;
        }

        if (mode == ThemeStyles.Simple)
        {
            var parts = ThemeStyles.PartsOf(_draft.Tokens, from);
            if (!parts.SequenceEqual(ThemeStyles.PartsOf(_draft.Tokens, ThemeStyles.Simple))
                && !await ConfirmAsync("AdmThemesLeaveComplexTitle", "AdmThemesLeaveComplexBody"))
            {
                return;
            }

            foreach (var key in ThemeStyles.PartKeys.Except(ThemeStyles.Keys))
            {
                _draft.Tokens.Remove(key);
            }
        }
        else
        {
            foreach (var (key, value) in ThemeStyles.PartsOf(_draft.Tokens, from))
            {
                _draft.Tokens[key] = value;
            }
        }

        if (from == ThemeStyles.Custom)
        {
            _draft.Stylesheet = null;
        }

        _draft.Tokens[ThemeStyles.Mode] = mode;
        Edited();
    }

    private async Task<bool> ConfirmAsync(string title, string body)
        => await DialogService.ShowMessageBoxAsync(Loc[title], Loc[body], yesText: Loc["AdmThemesSwitchMode"], cancelText: Loc["Cancel"]) == true;

    private void SetStyle(string key, string? value)
    {
        if (ThemeStyles.IsValid(key, value))
        {
            _draft!.Tokens[key] = value!;
        }

        Edited();
    }

    private void SetToken(string token, string? value)
    {
        if (SharpMUSH.Library.Models.Portal.ThemeColor.TryParse(value, out var color))
        {
            _draft!.Tokens[token] = color.Hex;
        }

        Edited();
    }

    private void SetStylesheet(string? css)
    {
        // The starter, untouched, changes nothing: keep the theme without a stylesheet rather than store it.
        _draft!.Stylesheet = string.IsNullOrWhiteSpace(css) || css == ThemeStylesheet.Starter(Draft, _partsCss) ? null : css;
        Edited();
    }

    private void ResetStylesheet()
    {
        _draft!.Stylesheet = null;
        Edited();
    }

    private void SetSeed(string? value)
    {
        if (SharpMUSH.Library.Models.Portal.ThemeColor.TryParse(value, out var color))
        {
            _seed = color.Hex;
        }
    }

    private void GenerateFromSeed()
    {
        ApplyColors(ThemeGenerator.Generate(_seed, _harmony, _draft!.Dark, _contrast), _draft.Dark);
    }

    /// <summary>A preset's name or palette JSON, made again for this theme's mode when it was generated.</summary>
    private void UsePalette(string? text)
    {
        switch (ThemeGenerator.FromText(text ?? string.Empty, _draft!.Dark))
        {
            case ValueTuple<Dictionary<string, string>, bool> palette:
                ApplyColors(palette.Item1, palette.Item2);
                break;
            case Error<string> error:
                _paletteError = Loc["AdmThemesPaletteError", error.Value];
                break;
        }
    }

    private void ApplyColors(Dictionary<string, string> colors, bool dark)
    {
        _paletteError = null;
        foreach (var (token, value) in colors)
        {
            _draft!.Tokens[token] = value;
        }

        // A fixed scheme (base16) is dark or light already; the theme takes its mode unless that would move a default.
        if (dark != _draft!.Dark && !IsDefault(_draft.Id))
        {
            _draft.Dark = dark;
        }

        Edited();
    }

    private void Edited() => Refresh(dirty: true);

    private void Refresh(bool dirty)
    {
        _dirty |= dirty;
        if (_trying && _draft is not null)
        {
            Themes.Preview(Draft);
        }
    }

    private void Try(bool on)
    {
        _trying = on;
        Themes.Preview(on && _draft is not null ? Draft : null);
    }

    private async Task SaveAsync()
    {
        if (_draft is null) return;
        _busy = true;
        _error = null;
        var result = _draft.Id is { } id ? await Api.SaveAsync(id, _draft.ToRequest()) : await Api.CreateAsync(_draft.ToRequest());
        switch (result)
        {
            case PortalTheme saved:
                await ReloadAsync(saved.Id);
                Snackbar.Add(Loc["AdmThemesSaved", saved.Name], Severity.Success);
                break;
            case ApiFailure failure:
                _error = failure.Message;
                break;
        }

        _busy = false;
    }

    private async Task MakeDefaultAsync()
    {
        if (_draft?.Id is not { } id) return;
        _busy = true;
        _error = null;
        switch (await Api.SetDefaultAsync(id))
        {
            case PortalThemesResponse state:
                _state = state;
                await Themes.ReloadAsync();
                break;
            case ApiFailure failure:
                _error = failure.Message;
                break;
        }

        _busy = false;
    }

    private async Task DeleteAsync()
    {
        if (_draft?.Id is not { } id) return;
        var confirmed = await DialogService.ShowMessageBoxAsync(
            Loc["AdmThemesDeleteTitle", _draft.Name], Loc["AdmThemesDeleteBody"],
            yesText: Loc["AdmThemesDelete"], cancelText: Loc["Cancel"]);
        if (confirmed != true) return;

        _busy = true;
        _error = null;
        switch (await Api.DeleteAsync(id))
        {
            case PortalThemesResponse state:
                _state = state;
                Select(state.Themes.First(t => t.Id == state.Defaults.For(Themes.PrefersLight)));
                await Themes.ReloadAsync();
                break;
            case ApiFailure failure:
                _error = failure.Message;
                break;
        }

        _busy = false;
    }

    private async Task ReloadAsync(string selectId)
    {
        if (await Api.GetAsync() is PortalThemesResponse state)
        {
            _state = state;
            if (state.Themes.FirstOrDefault(t => t.Id == selectId) is { } theme)
            {
                Select(theme);
            }
        }

        await Themes.ReloadAsync();
    }

    public void Dispose()
    {
        if (_trying)
        {
            Themes.Preview(null);
        }
    }
}
