@page "/admin/config/apps"
@layout ConfigLayout
@attribute [Authorize(Policy = "config.admin")]
@using System.Globalization
@using SharpMUSH.Library.Models.Portal
@using SharpMUSH.Library.OAuth
@inject ConnectedAppsService Apps
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> Loc

<AdminPageTitle Page="@Loc["OAuthAdmApps"]" />

@* The apps that may send players to the consent page. A hosted package asks in its ui.json and is not listed here. *@
<div class="config-section-page">
    <PageHeader Kicker="@Loc["ResConfigSectionKicker"]" Title="@Loc["OAuthAdmApps"]" Description="@Loc["OAuthAdmAppsDescription"]" />

    <div class="page-stack">
        @if (_secret is { } secret)
        {
            <MudAlert Severity="Severity.Warning" Class="oauth-secret" ShowCloseIcon="true" CloseIconClicked="@(() => _secret = null)">
                <div>@Loc["OAuthAdmSecretOnce", secret.Client.Name]</div>
                <code class="oauth-secret-value">@secret.Secret</code>
            </MudAlert>
        }

        <KitCard Title="@(_editing is null ? Loc["OAuthAdmRegister"] : Loc["OAuthAdmChange", _name])">
            <div class="oauth-form">
                <MudTextField T="string" @bind-Value="_name" Label="@Loc["OAuthAdmName"]" MaxLength="80"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Class="oauth-field" />
                <MudTextField T="string" @bind-Value="_homepage" Label="@Loc["OAuthAdmHomepage"]" Placeholder="https://builder.example.com"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="oauth-field" />
                <MudTextField T="string" @bind-Value="_description" Label="@Loc["OAuthAdmDescription"]" Lines="2" MaxLength="500"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="oauth-field oauth-field--wide" />
                <ListEditor Items="_redirects" ItemsChanged="@(uris => _redirects = uris)" Label="@Loc["OAuthAdmRedirects"]"
                            Placeholder="https://builder.example.com/callback" Help="@Loc["OAuthAdmRedirectsHelp"]" Mono="true"
                            Separators="RedirectSeparators" Class="oauth-field--wide" />
                <fieldset class="oauth-scopes">
                    <legend class="oauth-scopes-legend">@Loc["OAuthAdmScopes"]</legend>
                    @foreach (var scope in _available.Where(scope => scope.Scope != DelegatedScopes.Profile))
                    {
                        <MudCheckBox T="bool" Value="@_selected.Contains(scope.Scope)" Dense="true" Class="oauth-check"
                                     ValueChanged="@(on => Toggle(scope.Scope, on))"
                                     Label="@OAuthScopeText.Name(Loc, scope.Scope, _available)" />
                    }
                </fieldset>
                @if (_editing is null)
                {
                    <MudCheckBox T="bool" @bind-Value="_confidential" Label="@Loc["OAuthAdmConfidential"]" Dense="true" Class="oauth-check" />
                }
                <div class="oauth-form-actions">
                    @if (_editing is not null)
                    {
                        <CapsuleButton OnClick="Reset">@Loc["Cancel"]</CapsuleButton>
                    }
                    <CapsuleButton Primary="true" Icon="@Icons.Material.Outlined.Save" Class="oauth-save"
                                   Disabled="@(_busy || string.IsNullOrWhiteSpace(_name) || _redirects.Count == 0)"
                                   OnClick="SaveAsync">@Loc["Save"]</CapsuleButton>
                </div>
            </div>
        </KitCard>

        <KitCard Title="@Loc["OAuthAdmPolicy"]" Class="oauth-policy">
            <div class="oauth-form">
                <p class="oauth-sub oauth-field--wide">@Loc["OAuthAdmPolicyHelp"]</p>
                <MudRadioGroup T="string" @bind-Value="_policy" Class="oauth-field--wide oauth-policy-choices">
                    <MudRadio T="string" Value="@OAuthPolicies.Review">@Loc["OAuthAdmPolicyReview"]</MudRadio>
                    <MudRadio T="string" Value="@OAuthPolicies.Open">@Loc["OAuthAdmPolicyOpen"]</MudRadio>
                    <MudRadio T="string" Value="@OAuthPolicies.Registered">@Loc["OAuthAdmPolicyRegistered"]</MudRadio>
                </MudRadioGroup>
                <ListEditor Items="_blockedDomains" ItemsChanged="@(domains => _blockedDomains = domains)" Label="@Loc["OAuthAdmBlockedDomains"]"
                            Placeholder="example.com" Help="@Loc["OAuthAdmBlockedDomainsHelp"]" Mono="true"
                            Separators="RedirectSeparators" Class="oauth-field--wide" />
                <div class="oauth-form-actions">
                    <CapsuleButton Primary="true" Icon="@Icons.Material.Outlined.Save" Class="oauth-policy-save"
                                   Disabled="@(_busy || _policy is null)" OnClick="SavePolicyAsync">@Loc["Save"]</CapsuleButton>
                </div>
            </div>
        </KitCard>

        <KitCard Title="@Loc["OAuthAdmDescribed"]" Class="oauth-described">
            <Controls>
                @if (_described.Count(client => client.Status == OAuthClientStatuses.Unreviewed) is > 0 and var waiting)
                {
                    <Pill Tag="true" Class="oauth-waiting">@Loc["OAuthAdmWaiting", waiting]</Pill>
                }
                <Pill Tag="true">@_described.Count</Pill>
            </Controls>
            <ChildContent>
                @if (_loading)
                {
                    <SkeletonRows Count="2" Height="52" Gap="6" />
                }
                else if (_described.Count == 0)
                {
                    <EmptyState Compact="true" Class="oauth-empty" Icon="@Icons.Material.Outlined.Public">@Loc["OAuthAdmDescribedNone"]</EmptyState>
                }
                else
                {
                    <ul class="oauth-rows">
                        @foreach (var client in _described)
                        {
                            <li class="oauth-row oauth-row--@client.Status">
                                <div class="oauth-row-text">
                                    <span class="oauth-row-head">
                                        <span class="oauth-row-name">@client.Name</span>
                                        <Pill Tag="true" Class="@($"oauth-status oauth-status--{client.Status}")">@StatusText(client.Status)</Pill>
                                        @foreach (var scope in client.Scopes)
                                        {
                                            <Pill Tag="true">@scope</Pill>
                                        }
                                    </span>
                                    <code class="oauth-sub">@client.Id</code>
                                    @foreach (var uri in client.RedirectUris)
                                    {
                                        <code class="oauth-sub">@uri</code>
                                    }
                                    <span class="oauth-sub">@string.Format(Loc["OAuthAdmFirstSeen"], client.CreatedAt.ToLocalTime().ToString("g", CultureInfo.CurrentCulture))</span>
                                </div>
                                <div class="oauth-row-actions">
                                    @if (client.Status != OAuthClientStatuses.Allowed)
                                    {
                                        <CapsuleButton Icon="@Icons.Material.Outlined.Check" Class="oauth-allow" Disabled="@_busy"
                                                       OnClick="@(() => ReviewAsync(client, OAuthClientStatuses.Allowed))">@Loc["OAuthAdmAllow"]</CapsuleButton>
                                    }
                                    @if (client.Status != OAuthClientStatuses.Blocked)
                                    {
                                        <CapsuleButton Icon="@Icons.Material.Outlined.Block" Class="oauth-block" Disabled="@_busy"
                                                       OnClick="@(() => ReviewAsync(client, OAuthClientStatuses.Blocked))">@Loc["OAuthAdmBlock"]</CapsuleButton>
                                    }
                                    <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Size="Size.Small"
                                                   aria-label="@Loc["OAuthAdmForget"]" title="@Loc["OAuthAdmForget"]"
                                                   Disabled="@_busy" OnClick="@(() => ReviewAsync(client, OAuthClientStatuses.Forget))" />
                                </div>
                            </li>
                        }
                    </ul>
                }
            </ChildContent>
        </KitCard>

        <KitCard Title="@Loc["OAuthAdmRegistered"]">
            <Controls>
                <Pill Tag="true">@_registered.Count</Pill>
            </Controls>
            <ChildContent>
                @if (_loading)
                {
                    <SkeletonRows Count="3" Height="52" Gap="6" />
                }
                else if (_registered.Count == 0)
                {
                    <EmptyState Compact="true" Class="oauth-empty" Icon="@Icons.Material.Outlined.Apps">@Loc["OAuthAdmNone"]</EmptyState>
                }
                else
                {
                    <ul class="oauth-rows">
                        @foreach (var client in _registered)
                        {
                            <li class="oauth-row">
                                <div class="oauth-row-text">
                                    <span class="oauth-row-head">
                                        <span class="oauth-row-name">@client.Name</span>
                                        <Pill Tag="true">@(client.Confidential ? Loc["OAuthAdmHasSecret"] : Loc["OAuthAdmPublic"])</Pill>
                                        @foreach (var scope in client.Scopes)
                                        {
                                            <Pill Tag="true">@scope</Pill>
                                        }
                                    </span>
                                    <code class="oauth-sub">@client.Id</code>
                                    @foreach (var uri in client.RedirectUris)
                                    {
                                        <code class="oauth-sub">@uri</code>
                                    }
                                    <span class="oauth-sub">@string.Format(Loc["OAuthAdmRegisteredOn"], client.CreatedAt.ToLocalTime().ToString("d", CultureInfo.CurrentCulture))</span>
                                </div>
                                <div class="oauth-row-actions">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small"
                                                   aria-label="@Loc["OAuthAdmEdit"]" title="@Loc["OAuthAdmEdit"]" OnClick="@(() => Edit(client))" />
                                    @if (client.Confidential)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Outlined.Autorenew" Size="Size.Small"
                                                       aria-label="@Loc["OAuthAdmNewSecret"]" title="@Loc["OAuthAdmNewSecret"]"
                                                       Disabled="@_busy" OnClick="@(() => ResetSecretAsync(client))" />
                                    }
                                    <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Size="Size.Small" Color="Color.Error"
                                                   aria-label="@Loc["OAuthAdmDelete"]" title="@Loc["OAuthAdmDelete"]"
                                                   Disabled="@_busy" OnClick="@(() => _deleting = client)" />
                                </div>
                            </li>
                        }
                    </ul>
                }
            </ChildContent>
        </KitCard>
    </div>
</div>

<ConfirmDialog Visible="@(_deleting is not null)" VisibleChanged="@(visible => { if (!visible) _deleting = null; })"
               Title="@Loc["OAuthAdmDeleteTitle"]" ConfirmText="@Loc["Delete"]" OnConfirm="DeleteAsync">
    <MudText>@Loc["OAuthAdmDeleteBody", _deleting?.Name ?? ""]</MudText>
</ConfirmDialog>

@code {
    // An address holds no space, so a space ends one as it is typed or pasted.
    private static readonly char[] RedirectSeparators = [' ', ','];

    private bool _loading = true;
    private bool _busy;
    private List<OAuthClientView> _registered = [];
    private List<OAuthClientView> _described = [];
    private string? _policy;
    private IReadOnlyList<string> _blockedDomains = [];

    // The values of the game's oauth_app_policy option.
    private static class OAuthPolicies
    {
        public const string Registered = "registered";
        public const string Review = "review";
        public const string Open = "open";
    }
    private OAuthClientCreated? _secret;
    private OAuthClientView? _deleting;
    private string? _editing;
    private string _name = string.Empty;
    private string? _description;
    private string? _homepage;
    private IReadOnlyList<string> _redirects = [];
    private IReadOnlyList<OAuthScopeView> _available = [];
    private readonly HashSet<string> _selected = new(StringComparer.Ordinal);
    private bool _confidential;

    protected override async Task OnInitializedAsync()
    {
        var scopes = Apps.ScopesAsync();
        var policy = Apps.PolicyAsync();
        await LoadAsync();
        if (await scopes is List<OAuthScopeView> available) _available = available;
        if (await policy is OAuthAppPolicyView current)
        {
            _policy = current.Policy;
            _blockedDomains = current.BlockedDomains;
        }
    }

    private void Toggle(string scope, bool on)
    {
        if (on) _selected.Add(scope);
        else _selected.Remove(scope);
    }

    private async Task LoadAsync()
    {
        _loading = true;
        switch (await Apps.ClientsAsync())
        {
            case List<OAuthClientView> clients:
                _registered = [.. clients.Where(client => client.DescribedAt is null)];
                // Waiting apps first, then allowed, then blocked; newest first within each.
                _described = [.. clients.Where(client => client.DescribedAt is not null)
                    .OrderBy(client => client.Status switch { OAuthClientStatuses.Unreviewed => 0, OAuthClientStatuses.Allowed => 1, _ => 2 })
                    .ThenByDescending(client => client.CreatedAt)];
                break;
            case ApiFailure failure:
                Snackbar.Add(failure.Message, Severity.Error);
                break;
        }

        _loading = false;
    }

    private OAuthClientEdit Draft => new(_name.Trim(), string.IsNullOrWhiteSpace(_description) ? null : _description.Trim(),
        string.IsNullOrWhiteSpace(_homepage) ? null : _homepage.Trim(), _redirects,
        [DelegatedScopes.Profile, .. _selected], _confidential);

    private async Task SaveAsync()
    {
        _busy = true;
        if (_editing is { } id)
        {
            switch (await Apps.UpdateAsync(id, Draft))
            {
                case OAuthClientView client:
                    Snackbar.Add(string.Format(Loc["OAuthAdmSaved"], client.Name), Severity.Success);
                    Reset();
                    await LoadAsync();
                    break;
                case ApiFailure failure:
                    Snackbar.Add(failure.Message, Severity.Error);
                    break;
            }
        }
        else
        {
            switch (await Apps.RegisterAsync(Draft))
            {
                case OAuthClientCreated created:
                    Snackbar.Add(string.Format(Loc["OAuthAdmSaved"], created.Client.Name), Severity.Success);
                    _secret = created.Secret is null ? null : created;
                    Reset();
                    await LoadAsync();
                    break;
                case ApiFailure failure:
                    Snackbar.Add(failure.Message, Severity.Error);
                    break;
            }
        }

        _busy = false;
    }

    private void Edit(OAuthClientView client)
    {
        _editing = client.Id;
        _name = client.Name;
        _description = client.Description;
        _homepage = client.Homepage;
        _redirects = client.RedirectUris;
        _selected.Clear();
        _selected.UnionWith(client.Scopes.Where(scope => scope != DelegatedScopes.Profile));
    }

    private void Reset()
    {
        _editing = null;
        _name = string.Empty;
        _description = null;
        _homepage = null;
        _redirects = [];
        _selected.Clear();
        _confidential = false;
    }

    private async Task ResetSecretAsync(OAuthClientView client)
    {
        _busy = true;
        switch (await Apps.ResetSecretAsync(client.Id))
        {
            case OAuthClientCreated created:
                _secret = created;
                break;
            case ApiFailure failure:
                Snackbar.Add(failure.Message, Severity.Error);
                break;
        }

        _busy = false;
    }

    private string StatusText(string status) => status switch
    {
        OAuthClientStatuses.Unreviewed => Loc["OAuthAdmStatusUnreviewed"],
        OAuthClientStatuses.Blocked => Loc["OAuthAdmStatusBlocked"],
        _ => Loc["OAuthAdmStatusAllowed"]
    };

    private async Task ReviewAsync(OAuthClientView client, string status)
    {
        _busy = true;
        switch (await Apps.ReviewAsync(client.Id, status))
        {
            case Library.DiscriminatedUnions.Success:
                Snackbar.Add(string.Format(Loc[status switch
                {
                    OAuthClientStatuses.Allowed => "OAuthAdmAllowed",
                    OAuthClientStatuses.Blocked => "OAuthAdmBlocked",
                    _ => "OAuthAdmForgotten"
                }], client.Name), Severity.Success);
                await LoadAsync();
                break;
            case ApiFailure failure:
                Snackbar.Add(failure.Message, Severity.Error);
                break;
        }

        _busy = false;
    }

    private async Task SavePolicyAsync()
    {
        if (_policy is not { } policy) return;
        _busy = true;
        switch (await Apps.SetPolicyAsync(new OAuthAppPolicyView(policy, _blockedDomains)))
        {
            case Library.DiscriminatedUnions.Success:
                Snackbar.Add(Loc["OAuthAdmPolicySaved"], Severity.Success);
                if (await Apps.PolicyAsync() is OAuthAppPolicyView saved) _blockedDomains = saved.BlockedDomains;
                break;
            case ApiFailure failure:
                Snackbar.Add(failure.Message, Severity.Error);
                break;
        }

        _busy = false;
    }

    private async Task DeleteAsync()
    {
        if (_deleting is not { } client) return;
        _deleting = null;
        _busy = true;
        switch (await Apps.DeleteAsync(client.Id))
        {
            case Library.DiscriminatedUnions.Success:
                Snackbar.Add(string.Format(Loc["OAuthAdmDeleted"], client.Name), Severity.Success);
                if (_editing == client.Id) Reset();
                await LoadAsync();
                break;
            case ApiFailure failure:
                Snackbar.Add(failure.Message, Severity.Error);
                break;
        }

        _busy = false;
    }
}
