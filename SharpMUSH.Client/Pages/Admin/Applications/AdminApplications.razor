@page "/admin/applications"
@using SharpMUSH.Client.Models.Applications
@using SharpMUSH.Client.Services
@using SharpMUSH.Library.Authorization
@using SharpMUSH.Library.Models.Portal.Applications
@using SharpMUSH.Library.Models.Portal.Widgets
@attribute [Authorize(Policy = "applications.admin")]
@using SharpMUSH.Client.Components.Admin
@inject IStringLocalizer<SharedResource> Loc
@inject ApplicationRegistryClient Registry
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>@Loc["LayApplications"] — @Loc["AdminPanel"] — @Loc["AppTitle"]</PageTitle>

<div class="page-stack page-stack--padded appadmin">
    <PlainPageHeader Kicker="@Loc["LayAppsKicker"]" Title="@Loc["LayApplications"]">
        <Actions>
            <CapsuleButton Icon="@Icons.Material.Filled.Code" Href="/softcode">@Loc["LayAppsSchemaRegistry"]</CapsuleButton>
            <CapsuleButton Icon="@Icons.Material.Filled.Add" Primary="true" OnClick="@(() => Edit(null))">@Loc["LayAppsNew"]</CapsuleButton>
        </Actions>
    </PlainPageHeader>

    <AdminStats>
        @foreach (var tile in new[]
        {
            ("apps",    Apps.Count.ToString(),                                              "LayApplications",  "LayAppsStatRegistered", Icons.Material.Filled.Apps),
            ("pages",   Apps.Count(a => a.KindEnum == ApplicationKind.Page).ToString(),     "LayAppsPages",     "LayAppsStatPages",      Icons.Material.Filled.WebAsset),
            ("widgets", Apps.Count(a => a.KindEnum == ApplicationKind.Widget).ToString(),   "LayAppsWidgets",   "LayAppsStatWidgets",    Icons.Material.Filled.Dashboard),
            ("schemas", Apps.Count(a => !string.IsNullOrEmpty(a.SchemaUrl)).ToString(),     "LayAppsSchemas",   "LayAppsStatSchemas",    Icons.Material.Filled.DataObject),
        })
        {
            var (key, val, labelKey, subKey, icon) = tile;
            <AdminStat Key="@key" Icon="@icon" Label="@Loc[labelKey]" Sub="@Loc[subKey]" Value="@(List.Loading ? "—" : val)" />
        }
    </AdminStats>

    @if (List.Loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <div class="appadmin-grid">
            <div class="appadmin-list">
                <div class="aa-search">
                    <MudIcon Icon="@Icons.Material.Filled.Search" Class="aa-ico aa-ico--faint" />
                    <input value="@_search" @oninput="@(e => _search = e.Value?.ToString() ?? string.Empty)"
                           placeholder="@Loc["LayAppsSearchPlaceholder"]" />
                </div>

                @if (Filtered.Count == 0)
                {
                    <div class="aa-empty-list">@Loc["LayAppsNoMatch"]</div>
                }
                @foreach (var app in Filtered)
                {
                    var a = app;
                    var on = List.IsSelected(a);
                    <button type="button" class="aa-card @(on ? "aa-card--on" : "")" @onclick="@(() => List.Select(a))">
                        <div class="aa-card-top">
                            <span class="aa-card-icon">
                                <MudIcon Icon="@AppIcons.Fill(a.Icon, Icons.Material.Filled.Apps)" Class="aa-ico aa-ico--card" />
                            </span>
                            <div class="aa-grow">
                                <div class="aa-card-name">@a.DisplayName</div>
                                <div class="aa-card-sub">/apps/@a.Slug</div>
                            </div>
                            <span class="aa-kind @KindClass(a.Kind)">@KindLabel(a.Kind)</span>
                        </div>
                    </button>
                }
            </div>

            <KitCard Class="appadmin-detail">
                @if (List.Selected is not { } selected)
                {
                    <div class="aa-empty-detail">
                        <MudIcon Icon="@Icons.Material.Filled.Apps" Class="aa-ico aa-ico--empty" />
                        <span>@Loc["LayAppsEmptyDetail"]</span>
                        <button type="button" class="aa-btn aa-btn--primary" @onclick="@(() => Edit(null))">
                            <MudIcon Icon="@Icons.Material.Filled.Add" Class="aa-ico" /> @Loc["LayAppsRegister"]
                        </button>
                    </div>
                }
                else
                {
                    <div class="aa-detail-head">
                        <span class="aa-detail-icon">
                            <MudIcon Icon="@AppIcons.Fill(selected.Icon, Icons.Material.Filled.Apps)" Class="aa-ico aa-ico--detail" />
                        </span>
                        <div class="aa-grow">
                            <div class="aa-detail-titles">
                                <h2 class="aa-detail-name">@selected.DisplayName</h2>
                                <span class="aa-kind @KindClass(selected.Kind)">@KindLabel(selected.Kind)</span>
                                <span class="aa-role">@selected.MinimumRole</span>
                            </div>
                            <div class="aa-detail-slug">/apps/@selected.Slug</div>
                        </div>
                        <div class="aa-detail-headbtns">
                            <button type="button" class="aa-icon-btn" title="@Loc["LayEdit"]" aria-label="@Loc["LayEdit"]" @onclick="@(() => Edit(selected))">
                                <MudIcon Icon="@Icons.Material.Filled.Edit" Class="aa-ico aa-ico--btn" />
                            </button>
                            <button type="button" class="aa-icon-btn aa-icon-btn--danger" title="@Loc["LayRemove"]" aria-label="@Loc["LayRemove"]" @onclick="@(() => Delete(selected))">
                                <MudIcon Icon="@Icons.Material.Filled.Delete" Class="aa-ico aa-ico--btn" />
                            </button>
                        </div>
                    </div>

                    <div class="aa-meta-grid">
                        @foreach (var field in new (string LabelKey, string Value)[]
                        {
                            ("LayAppSchemaUrl",    selected.SchemaUrl),
                            ("LayAppDataUrl",      selected.DataUrl ?? "—"),
                            ("LayAppSubmitRoute",  selected.SubmitRoute ?? "—"),
                            ("LayAppNavPlacement", selected.NavPlacement ?? "—"),
                            ("LayAppNavUrl",       selected.NavUrl ?? "—"),
                            ("LayAppScope",        selected.Scope ?? "—"),
                            ("LayAppOobPackage",   selected.OobPackage ?? "—"),
                            ("LayAppDisplayOrder", selected.Order.ToString()),
                            ("LayAppMinRole",      selected.MinimumRole),
                            ("LayAppPermission",   selected.Permission ?? "—"),
                        })
                        {
                            <div class="aa-meta">
                                <div class="aa-meta-label">@Loc[field.LabelKey]</div>
                                <div class="aa-meta-val">@field.Value</div>
                            </div>
                        }
                    </div>

                    @if (selected.ZoneEnums.Count > 0)
                    {
                        <div class="aa-section">
                            <div class="aa-section-label">@Loc["LayAppAllowedZones"]</div>
                            <div class="aa-chips">
                                @foreach (var zone in selected.ZoneEnums)
                                {
                                    <span class="aa-zone">@Loc[zone.ResourceKey()]</span>
                                }
                            </div>
                        </div>
                    }

                    <div class="aa-section">
                        <div class="aa-section-label">@Loc["LayActions"]</div>
                        <div class="aa-actions">
                            <a class="aa-btn aa-btn--primary" href="@($"/apps/{selected.Slug}")">
                                <MudIcon Icon="@Icons.Material.Filled.OpenInBrowser" Class="aa-ico" /> @Loc["LayAppOpen"]
                            </a>
                            <a class="aa-btn" href="/softcode">
                                <MudIcon Icon="@Icons.Material.Filled.Code" Class="aa-ico" /> @Loc["LayAppEditInSoftcode"]
                            </a>
                            @if (!string.IsNullOrEmpty(selected.SchemaUrl))
                            {
                                <a class="aa-btn" href="@selected.SchemaUrl" target="_blank" rel="noopener noreferrer">
                                    <MudIcon Icon="@Icons.Material.Filled.Link" Class="aa-ico" /> @Loc["LayAppViewSchema"]
                                </a>
                            }
                        </div>
                    </div>
                }
            </KitCard>
        </div>
    }
</div>

@code {
    private string _search = string.Empty;

    private AdminRecordList<PortalApplication>? _list;

    /// <summary>The registered applications; with any registered, one is always selected.</summary>
    private AdminRecordList<PortalApplication> List => _list ??= new(
        DialogService, Snackbar,
        async () => await Registry.ListAsync(),
        app => app.Slug,
        AdminReselect.First);

    private IReadOnlyList<PortalApplication> Apps => List.Items;

    private IReadOnlyList<PortalApplication> Filtered =>
        string.IsNullOrWhiteSpace(_search)
            ? Apps
            : Apps.Where(a =>
                a.DisplayName.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || a.Slug.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || (a.SchemaUrl ?? string.Empty).Contains(_search, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override Task OnInitializedAsync() => List.LoadAsync();

    private Task Edit(PortalApplication? existing) =>
        List.EditAsync<ApplicationEditDialog>(
            existing is null ? Loc["LayAppsRegister"] : Loc["LayAppEditTitle", existing.Slug],
            new DialogParameters<ApplicationEditDialog> { { x => x.Existing, existing } });

    private Task Delete(PortalApplication app) =>
        List.DeleteAsync(app,
            new AdminDeleteText(
                Loc["LayAppRemoveTitle"],
                Loc["LayAppRemoveConfirm", app.DisplayName, app.Slug],
                Loc["LayRemove"],
                Loc["Cancel"],
                Loc["LayAppRemoved", app.Slug],
                failure => Loc["LayAppRemoveFailed", failure.Message]),
            () => Registry.DeleteAsync(app.Slug));

    // Kind travels from the API as a string and a registration may carry a value outside
    // ApplicationKind (the badge palette still styles a legacy "Form"), so an unrecognized kind shows
    // through verbatim rather than being mislabelled as the parse fallback.
    private string KindLabel(string kind) =>
        Enum.TryParse<ApplicationKind>(kind, ignoreCase: true, out var parsed)
            ? Loc[parsed.ResourceKey()]
            : kind;

    private static string KindClass(string kind) => kind.ToUpperInvariant() switch
    {
        "PAGE"   => "aa-kind--page",
        "WIDGET" => "aa-kind--widget",
        "FORM"   => "aa-kind--form",
        _        => "aa-kind--other",
    };
}
