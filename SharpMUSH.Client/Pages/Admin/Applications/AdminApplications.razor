@page "/admin/applications"
@using SharpMUSH.Client.Models.Applications
@using SharpMUSH.Client.Services
@using SharpMUSH.Library.Authorization
@using SharpMUSH.Library.Models.Portal.Applications
@using SharpMUSH.Library.Models.Portal.Widgets
@attribute [Authorize(Policy = "applications.admin")]
@inject IStringLocalizer<SharedResource> Loc
@inject ApplicationRegistryClient Registry
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>@Loc["LayApplications"] — @Loc["AdminPanel"] — @Loc["AppTitle"]</PageTitle>

<div class="appadmin">
    <div class="appadmin-head">
        <div>
            <div class="appadmin-kicker">@Loc["LayAppsKicker"]</div>
            <h1 class="appadmin-title">@Loc["LayApplications"]</h1>
        </div>
        <div class="appadmin-actions">
            <a class="aa-btn" href="/softcode">
                <MudIcon Icon="@Icons.Material.Filled.Code" Style="font-size:0.875rem;" /> @Loc["LayAppsSchemaRegistry"]
            </a>
            <button type="button" class="aa-btn aa-btn--primary" @onclick="@(() => Edit(null))">
                <MudIcon Icon="@Icons.Material.Filled.Add" Style="font-size:0.875rem;" /> @Loc["LayAppsNew"]
            </button>
        </div>
    </div>

    <div class="appadmin-stats">
        @foreach (var tile in new[]
        {
            (_apps.Count.ToString(),                                              "LayApplications",  "LayAppsStatRegistered", Icons.Material.Filled.Apps,        "var(--accent)"),
            (_apps.Count(a => a.KindEnum == ApplicationKind.Page).ToString(),     "LayAppsPages",     "LayAppsStatPages",      Icons.Material.Filled.WebAsset,    "#6cde9a"),
            (_apps.Count(a => a.KindEnum == ApplicationKind.Widget).ToString(),   "LayAppsWidgets",   "LayAppsStatWidgets",    Icons.Material.Filled.Dashboard,   "#5aa9ff"),
            (_apps.Count(a => !string.IsNullOrEmpty(a.SchemaUrl)).ToString(),     "LayAppsSchemas",   "LayAppsStatSchemas",    Icons.Material.Filled.DataObject,  "#b39cff"),
        })
        {
            var (val, labelKey, subKey, icon, color) = tile;
            <div class="aa-stat">
                <MudIcon Icon="@icon" Style="@($"font-size:1.375rem;color:{color};")" />
                <div>
                    <div class="aa-stat-val" style="@($"color:{color};")">@(_loading ? "—" : val)</div>
                    <div class="aa-stat-label">@Loc[labelKey]</div>
                    <div class="aa-stat-sub">@Loc[subKey]</div>
                </div>
            </div>
        }
    </div>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Style="height:2px;" />
    }
    else
    {
        <div class="appadmin-grid">
            <div class="appadmin-list">
                <div class="aa-search">
                    <MudIcon Icon="@Icons.Material.Filled.Search" Style="font-size:0.875rem;color:var(--text-faint);" />
                    <input value="@_search" @oninput="@(e => _search = e.Value?.ToString() ?? string.Empty)"
                           placeholder="@Loc["LayAppsSearchPlaceholder"]" />
                </div>

                @if (Filtered.Count == 0)
                {
                    <div class="aa-empty-list">@Loc["LayAppsNoMatch"]</div>
                }
                @foreach (var app in Filtered)
                {
                    var a = app;
                    var on = _selected?.Slug == a.Slug;
                    <button type="button" class="aa-card @(on ? "aa-card--on" : "")" @onclick="@(() => _selected = a)">
                        <div class="aa-card-top">
                            <span class="aa-card-icon">
                                <MudIcon Icon="@(a.Icon ?? Icons.Material.Filled.Apps)" Style="font-size:1.0625rem;" />
                            </span>
                            <div style="flex:1;min-width:0;">
                                <div class="aa-card-name">@a.DisplayName</div>
                                <div class="aa-card-sub">/apps/@a.Slug</div>
                            </div>
                            <span class="aa-kind" style="@($"background:{KindBackground(a.Kind)};color:{KindColor(a.Kind)};")">@KindLabel(a.Kind)</span>
                        </div>
                    </button>
                }
            </div>

            <div class="appadmin-detail">
                @if (_selected is null)
                {
                    <div class="aa-empty-detail">
                        <MudIcon Icon="@Icons.Material.Filled.Apps" Style="font-size:2.5rem;color:var(--text-faint);opacity:0.4;" />
                        <span>@Loc["LayAppsEmptyDetail"]</span>
                        <button type="button" class="aa-btn aa-btn--primary" @onclick="@(() => Edit(null))">
                            <MudIcon Icon="@Icons.Material.Filled.Add" Style="font-size:0.875rem;" /> @Loc["LayAppsRegister"]
                        </button>
                    </div>
                }
                else
                {
                    <div class="aa-detail-head">
                        <span class="aa-detail-icon">
                            <MudIcon Icon="@(_selected.Icon ?? Icons.Material.Filled.Apps)" Style="font-size:1.375rem;" />
                        </span>
                        <div style="flex:1;min-width:0;">
                            <div style="display:flex;align-items:center;gap:0.625rem;flex-wrap:wrap;">
                                <h2 class="aa-detail-name">@_selected.DisplayName</h2>
                                <span class="aa-kind" style="@($"background:{KindBackground(_selected.Kind)};color:{KindColor(_selected.Kind)};")">@KindLabel(_selected.Kind)</span>
                                <span class="aa-role">@_selected.MinimumRole</span>
                            </div>
                            <div class="aa-detail-slug">/apps/@_selected.Slug</div>
                        </div>
                        <div class="aa-detail-headbtns">
                            <button type="button" class="aa-icon-btn" title="@Loc["LayEdit"]" @onclick="@(() => Edit(_selected))">
                                <MudIcon Icon="@Icons.Material.Filled.Edit" Style="font-size:1rem;" />
                            </button>
                            <button type="button" class="aa-icon-btn aa-icon-btn--danger" title="@Loc["LayRemove"]" @onclick="@(() => Delete(_selected))">
                                <MudIcon Icon="@Icons.Material.Filled.Delete" Style="font-size:1rem;" />
                            </button>
                        </div>
                    </div>

                    <div class="aa-meta-grid">
                        @foreach (var field in new (string LabelKey, string Value)[]
                        {
                            ("LayAppSchemaUrl",    _selected.SchemaUrl),
                            ("LayAppDataUrl",      _selected.DataUrl ?? "—"),
                            ("LayAppSubmitRoute",  _selected.SubmitRoute ?? "—"),
                            ("LayAppNavPlacement", _selected.NavPlacement ?? "—"),
                            ("LayAppDisplayOrder", _selected.Order.ToString()),
                            ("LayAppMinRole",      _selected.MinimumRole),
                        })
                        {
                            <div class="aa-meta">
                                <div class="aa-meta-label">@Loc[field.LabelKey]</div>
                                <div class="aa-meta-val">@field.Value</div>
                            </div>
                        }
                    </div>

                    @if (_selected.ZoneEnums.Count > 0)
                    {
                        <div class="aa-section">
                            <div class="aa-section-label">@Loc["LayAppAllowedZones"]</div>
                            <div class="aa-chips">
                                @foreach (var zone in _selected.ZoneEnums)
                                {
                                    <span class="aa-zone">@Loc[zone.ResourceKey()]</span>
                                }
                            </div>
                        </div>
                    }

                    <div class="aa-section">
                        <div class="aa-section-label">@Loc["LayActions"]</div>
                        <div class="aa-actions">
                            <a class="aa-btn aa-btn--primary" href="@($"/apps/{_selected.Slug}")">
                                <MudIcon Icon="@Icons.Material.Filled.OpenInBrowser" Style="font-size:0.875rem;" /> @Loc["LayAppOpen"]
                            </a>
                            <a class="aa-btn" href="/softcode">
                                <MudIcon Icon="@Icons.Material.Filled.Code" Style="font-size:0.875rem;" /> @Loc["LayAppEditInSoftcode"]
                            </a>
                            @if (!string.IsNullOrEmpty(_selected.SchemaUrl))
                            {
                                <a class="aa-btn" href="@_selected.SchemaUrl" target="_blank">
                                    <MudIcon Icon="@Icons.Material.Filled.Link" Style="font-size:0.875rem;" /> @Loc["LayAppViewSchema"]
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private string _search = string.Empty;
    private List<PortalApplication> _apps = [];
    private PortalApplication? _selected;

    private List<PortalApplication> Filtered =>
        string.IsNullOrWhiteSpace(_search)
            ? _apps
            : _apps.Where(a =>
                a.DisplayName.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || a.Slug.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || (a.SchemaUrl ?? string.Empty).Contains(_search, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _apps = (await Registry.ListAsync()).ToList();
        _loading = false;
        _selected = _selected is not null
            ? _apps.FirstOrDefault(a => a.Slug == _selected.Slug) ?? _apps.FirstOrDefault()
            : _apps.FirstOrDefault();
    }

    private async Task Edit(PortalApplication? existing)
    {
        var parameters = new DialogParameters<ApplicationEditDialog>
        {
            { x => x.Existing, existing }
        };
        var dialog = await DialogService.ShowAsync<ApplicationEditDialog>(
            existing is null ? Loc["LayAppsRegister"] : Loc["LayAppEditTitle", existing.Slug], parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
            await LoadAsync();
    }

    private async Task Delete(PortalApplication app)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            Loc["LayAppRemoveTitle"],
            Loc["LayAppRemoveConfirm", app.DisplayName, app.Slug],
            yesText: Loc["LayRemove"], cancelText: Loc["Cancel"]);

        if (confirmed == true)
        {
            if (await Registry.DeleteAsync(app.Slug))
            {
                Snackbar.Add(Loc["LayAppRemoved", app.Slug], Severity.Success);
                if (_selected?.Slug == app.Slug) _selected = null;
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(Loc["LayAppRemoveFailed"], Severity.Error);
            }
        }
    }

    // Kind travels from the API as a string and a registration may carry a value outside
    // ApplicationKind (the badge palette still styles a legacy "Form"), so an unrecognized kind shows
    // through verbatim rather than being mislabelled as the parse fallback.
    private string KindLabel(string kind) =>
        Enum.TryParse<ApplicationKind>(kind, ignoreCase: true, out var parsed)
            ? Loc[parsed.ResourceKey()]
            : kind;

    private static string KindBackground(string kind) => kind.ToUpperInvariant() switch
    {
        "PAGE"   => "rgba(0,200,100,0.12)",
        "WIDGET" => "rgba(90,169,255,0.12)",
        "FORM"   => "rgba(179,156,255,0.12)",
        _        => "rgba(255,255,255,0.06)",
    };

    private static string KindColor(string kind) => kind.ToUpperInvariant() switch
    {
        "PAGE"   => "#6cde9a",
        "WIDGET" => "#5aa9ff",
        "FORM"   => "#b39cff",
        _        => "var(--text-dim)",
    };
}
