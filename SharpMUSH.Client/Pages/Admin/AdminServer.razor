@page "/admin/server"
@attribute [Authorize(Policy = "server.admin")]
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["ServerSettings"] — @Loc["AdmBreadcrumb"] — @Loc["AppTitle"]</PageTitle>

<div class="adminsrv-page">
    <header class="adminsrv-header">
        <div class="adminsrv-kicker">@Loc["AdmServerKicker"]</div>
        <h1 class="adminsrv-title">@Loc["ServerSettings"]</h1>
    </header>

    <div class="adminsrv-card">
        <MudIcon Icon="@Icons.Material.Filled.Dns" Class="adminsrv-card-icon" />
        <div class="adminsrv-card-body">
            <span class="adminsrv-card-label">@Loc["AdmServerGodOnly"]</span>
            <span class="adminsrv-card-desc">@Loc["AdmServerComingSoon"]</span>
        </div>
    </div>
</div>
