@page "/admin/server"
@attribute [Authorize(Policy = "server.admin")]
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["ServerSettings"] — @Loc["AdmBreadcrumb"] — @Loc["AppTitle"]</PageTitle>

<div class="adm-soon">
    <PlainPageHeader Kicker="@Loc["AdmServerKicker"]" Title="@Loc["ServerSettings"]" />

    <KitCard Title="@Loc["AdmServerGodOnly"]">
        <div class="adm-soon-empty">
            <MudIcon Icon="@Icons.Material.Filled.Dns" Class="adm-soon-icon" />
            <div class="adm-soon-text">@Loc["AdmServerComingSoon"]</div>
        </div>
    </KitCard>
</div>
