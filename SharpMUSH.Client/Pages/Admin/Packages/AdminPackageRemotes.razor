@page "/admin/packages/remotes"
@attribute [Authorize(Policy = "packages.admin")]
@using SharpMUSH.Client.Services
@using SharpMUSH.Library.DiscriminatedUnions
@using SharpMUSH.Library.API
@using SharpMUSH.Library.Models.Packages
@inject PackagesAdminService Packages
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> Loc

<AdminPageTitle Page="@Loc["PkgRemotesHeading"]" />

<div class="page-stack page-stack--padded pkg-page">
    <PlainPageHeader Kicker="@Loc["AdmGroupPortal"]" Title="@Loc["PkgRemotesHeading"]" Description="@Loc["PkgRemotesDescription"]" />

<div class="pkg-cols">
    <div>
        <KitCard Title="@Loc["PkgConfiguredRemotes"]">
            <div class="pkg-card-body">
                @if (_remotesFailure is not null)
                {
                    <MudAlert Severity="Severity.Error" Class="pkg-remotes-error" role="alert">@_remotesFailure.Message</MudAlert>
                    <CapsuleButton Class="pkg-remotes-retry" OnClick="ReloadRemotesAsync" Icon="@Icons.Material.Filled.Refresh">@Loc["Refresh"]</CapsuleButton>
                }
                else if (_remotes is null)
                {
                    <SkeletonRows Count="2" Height="48" Gap="6" />
                }
                else
                {
                    <MudTable Items="_remotes" Dense="true" Elevation="0" Class="pkg-remotes-table">
                        <HeaderContent>
                            <MudTh>@Loc["PkgName"]</MudTh><MudTh>@Loc["PkgUrl"]</MudTh><MudTh>@Loc["PkgTrust"]</MudTh><MudTh>@Loc["PkgBranch"]</MudTh><MudTh />
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd data-label="@Loc["PkgName"]">@context.Name</MudTd>
                            <MudTd data-label="@Loc["PkgUrl"]"><MudText Typo="Typo.caption">@context.Url</MudText></MudTd>
                            <MudTd data-label="@Loc["PkgTrust"]"><TrustBadge Trust="@context.Trust" /></MudTd>
                            <MudTd data-label="@Loc["PkgBranch"]">@(context.Branch ?? Loc["PkgDefaultBranch"])</MudTd>
                            <MudTd>
                                <MudIconButton Icon="@Icons.Material.Filled.TravelExplore" Size="Size.Small"
                                               title="@Loc["PkgBrowse"]" aria-label="@Loc["PkgBrowse"]" Href="@($"/admin/packages/browse?remote={Uri.EscapeDataString(context.Name)}")" />
                                @* The bundled catalogue is not a configured remote — it is the set of
                                   packages embedded in this server build, so there is nothing to delete. *@
                                @if (!BundledPackageSource.IsCatalogueRemote(context.Name))
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                   aria-label="@Loc["Delete"]" OnClick="@(() => DeleteAsync(context.Name))" />
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }

                <MudDivider Class="my-4" />
                <MudText Typo="Typo.subtitle1" Class="mb-2">@Loc["PkgAddRemoteHeading"]</MudText>
                <MudStack Spacing="2">
                    <MudTextField @bind-Value="_newName" Label="@Loc["PkgName"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudTextField @bind-Value="_newUrl" Label="@Loc["PkgGitUrlLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudStack Row="true" Spacing="2">
                        <MudSelect T="string" @bind-Value="_newTrust" Label="@Loc["PkgTrust"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem Value="@("official")">@Loc["PkgTrustOfficial"]</MudSelectItem>
                            <MudSelectItem Value="@("community")">@Loc["PkgTrustCommunity"]</MudSelectItem>
                            <MudSelectItem Value="@("unknown")">@Loc["PkgTrustUnknown"]</MudSelectItem>
                        </MudSelect>
                        <MudTextField @bind-Value="_newBranch" Label="@Loc["PkgBranchOptionalLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudStack>
                    <MudButton Class="pkg-btn-primary" Variant="Variant.Filled" Disabled="@_busy" OnClick="@AddRemoteAsync">
                        @Loc["PkgAddRemote"]
                    </MudButton>
                </MudStack>
            </div>
        </KitCard>
    </div>

    <div>
        <KitCard Title="@Loc["PkgCommunityDirectory"]">
            <Controls>
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" Disabled="@_busy"
                               aria-label="@Loc["Refresh"]" OnClick="@LoadCommunityAsync" />
            </Controls>
            <ChildContent>
            <div class="pkg-card-body">
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                    @Loc["PkgCommunityDirectoryHint"]
                </MudText>
                @if (_communityFailure is not null)
                {
                    <MudAlert Severity="Severity.Error" Class="pkg-community-error" role="alert">@_communityFailure.Message</MudAlert>
                    <CapsuleButton Class="pkg-community-retry" OnClick="LoadCommunityAsync" Icon="@Icons.Material.Filled.Refresh">@Loc["Refresh"]</CapsuleButton>
                }
                else if (_community is null)
                {
                    <SkeletonRows Count="3" Height="48" Gap="6" />
                }
                else
                {
                    @foreach (var entry in _community.Listings)
                    {
                        <div class="pkg-listing">
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.subtitle1">@entry.Listing.Name</MudText>
                                <TrustBadge Trust="PackageRemoteTrust.Community" />
                                <MudSpacer />
                                <MudIconButton Icon="@Icons.Material.Filled.Description" Size="Size.Small" title="@Loc["PkgShowReadme", entry.Listing.Name]" aria-label="@Loc["PkgShowReadme", entry.Listing.Name]"
                                               OnClick="@(() => ShowReadmeAsync(entry.Listing))" />
                                @if (entry.AlreadyConfigured)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success">@Loc["PkgConfigured"]</MudChip>
                                }
                                else
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@_busy"
                                               OnClick="@(() => AddCommunityAsync(entry.Listing))">@Loc["Add"]</MudButton>
                                }
                            </MudStack>
                            <MudText Typo="Typo.body2">@entry.Listing.Description</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@entry.Listing.Url</MudText>
                        </div>
                    }
                    @if (_community.Listings.Count == 0)
                    {
                        <EmptyState Compact="true" Icon="@Icons.Material.Outlined.Storefront">@Loc["PkgNoCommunityRepos"]</EmptyState>
                    }
                    @foreach (var error in _community.Errors)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-1">@error</MudAlert>
                    }
                }
            </div>
            </ChildContent>
        </KitCard>
    </div>
</div>
</div>

<PackageReadmeDialog @ref="_readme" />

@code {
    private IReadOnlyList<PackageRemoteRecord>? _remotes;
    private CommunityReposResponse? _community;
    private ApiFailure? _remotesFailure;
    private ApiFailure? _communityFailure;
    private bool _busy;

    private string _newName = "";
    private string _newUrl = "";
    private string _newTrust = "community";
    private string _newBranch = "";

    private PackageReadmeDialog? _readme;

    protected override async Task OnInitializedAsync()
    {
        _remotes = await Remotes();
        await LoadCommunityAsync();
    }

    private async Task LoadCommunityAsync()
    {
        _community = null;
        _communityFailure = null;
        switch (await Packages.GetCommunityReposAsync())
        {
            case CommunityReposResponse community:
                _community = community;
                break;
            case ApiFailure failure:
                _communityFailure = failure;
                break;
        }
    }

    private async Task AddRemoteAsync()
    {
        _busy = true;
        try
        {
            if (await Packages.UpsertRemoteAsync(new RemoteRequest(
                _newName, _newUrl, _newTrust, string.IsNullOrWhiteSpace(_newBranch) ? null : _newBranch))
                is ApiFailure failure)
            {
                Snackbar.Add(failure.Message, Severity.Error);
                return;
            }

            Snackbar.Add(Loc["PkgRemoteSaved", _newName], Severity.Success);
            _newName = _newUrl = _newBranch = "";
            _remotes = await Remotes();
            await LoadCommunityAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AddCommunityAsync(CommunityRepoListing listing)
    {
        _busy = true;
        try
        {
            var added = await Packages.UpsertRemoteAsync(new RemoteRequest(
                listing.Name, listing.Url, "community", listing.Branch));
            Snackbar.Add(
                added is ApiFailure failure ? failure.Message : Loc["PkgCommunityRemoteAdded", listing.Name].Value,
                added is Success ? Severity.Success : Severity.Error);
            _remotes = await Remotes();
            await LoadCommunityAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync(string name)
    {
        if (await Packages.DeleteRemoteAsync(name) is ApiFailure failure)
        {
            Snackbar.Add(failure.Message, Severity.Error);
            return;
        }

        Snackbar.Add(Loc["PkgRemoteRemoved", name], Severity.Info);
        _remotes = await Remotes();
        await LoadCommunityAsync();
    }

    private Task ShowReadmeAsync(CommunityRepoListing listing)
        => _readme?.ShowAsync(listing.Name, () => Packages.GetCommunityReadmeAsync(listing.Url)) ?? Task.CompletedTask;

    private async Task ReloadRemotesAsync() => _remotes = await Remotes();

    /// <summary>Keep a failed read separate from a successfully empty remote list.</summary>
    private async Task<IReadOnlyList<PackageRemoteRecord>?> Remotes()
    {
        _remotesFailure = null;
        _remotes = null;
        return await Packages.GetRemotesAsync() switch
        {
            IReadOnlyList<PackageRemoteRecord> remotes => remotes,
            ApiFailure failure => Failed(failure)
        };
    }

    private IReadOnlyList<PackageRemoteRecord>? Failed(ApiFailure failure)
    {
        _remotesFailure = failure;
        return null;
    }
}
