@page "/admin/packages/review"
@attribute [Authorize(Policy = "packages.admin")]
@using SharpMUSH.Client.Services
@using SharpMUSH.Library.DiscriminatedUnions
@using SharpMUSH.Library.API
@using SharpMUSH.Library.Models.Packages
@inject PackagesAdminService Packages
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["PkgReviewInstall"] — @Loc["PkgAdminSection"] — @Loc["AppTitle"]</PageTitle>

<div class="pkg-review">
@if (_plan is null)
{
    <PlainPageHeader Kicker="@Loc["PkgKickerRegistry"]" Title="@Loc["PkgReview"]" />
    @if (_loadError is not null)
    {
        <MudAlert Severity="Severity.Error">@_loadError</MudAlert>
    }
    else
    {
        <MudProgressLinear Indeterminate="true" />
    }
}
else
{
    <PlainPageHeader Kicker="@Loc["PkgKickerRegistry"]"
                     Title="@($"{(_plan.Changeset.Kind == PackageRevisionKind.Install ? Loc["PkgInstallHeading"] : Loc["PkgUpgradeHeading"])}: {_plan.PackageId} {_plan.Version}")">
        <DescriptionContent>
            @if (IsUpload)
            {
                @Loc["PkgPlanUploaded", _plan.PackageId]
            }
            else
            {
                @Loc["PkgPlanLocation", _remote, _path, _plan.Commit[..Math.Min(10, _plan.Commit.Length)]]
            }
            @if (_plan.Changeset.FromVersion is not null)
            {
                <text> @Loc["PkgUpgradingFrom", _plan.Changeset.FromVersion]</text>
            }
        </DescriptionContent>
        <Actions>
            <CapsuleButton Href="@(IsUpload ? "/admin/packages" : "/admin/packages/browse")">@Loc["Cancel"]</CapsuleButton>
            <CapsuleButton Primary="true" Disabled="@(!CanApply || _busy)" OnClick="@ApplyAsync">@Loc["PkgApply"]</CapsuleButton>
        </Actions>
    </PlainPageHeader>

    @* ── Blockers ─────────────────────────────────────────────────────── *@
    @foreach (var issue in _plan.Changeset.DependencyIssues)
    {
        <MudAlert Severity="Severity.Error">
            @if (issue.IsPlugin)
            {
                <text>@Loc["PkgNeedsPlugin", issue.PackageId]</text>
            }
            else if (issue.IsConflict)
            {
                <text>@Loc["PkgConflictsWithInstalled"] <b>@issue.PackageId</b> @issue.InstalledVersion.</text>
            }
            else
            {
                <text>@Loc["PkgRequires"] <b>@issue.PackageId</b> @issue.Constraint
                    @(issue.InstalledVersion is null
                        ? Loc["PkgNotInstalledSuffix"]
                        : Loc["PkgInstalledSuffix", issue.InstalledVersion])</text>
                @if (issue.Source is not null)
                {
                    <text> @Loc["PkgAvailableFrom", issue.Source.Repo, issue.Source.Path is null ? "" : $" ({issue.Source.Path})"]</text>
                }
            }
        </MudAlert>
    }

    @foreach (var blocked in (_plan.Changeset.Declarations ?? []).Where(d => d.Action == PackageDeclarationAction.Blocked))
    {
        <MudAlert Severity="Severity.Error">@blocked.Kind.Noun() <b>@blocked.Name</b>: @blocked.Detail</MudAlert>
    }
    @foreach (var blocked in (_plan.Changeset.Settings ?? []).Where(s => s.Action == PackageSettingAction.Blocked))
    {
        <MudAlert Severity="Severity.Error">@Loc["PkgSettingBlocked"] <b>@blocked.Option</b>: @blocked.Detail</MudAlert>
    }
    @foreach (var blocked in (_plan.Changeset.Wiki ?? []).Where(w => w.Action == PackageWikiAction.Blocked))
    {
        <MudAlert Severity="Severity.Error">@Loc["PkgWikiBlocked"] <b>@WikiLabel(blocked)</b>: @blocked.Detail</MudAlert>
    }
    @switch (_plan.Changeset.Compatibility)
    {
        case { Fit: PackageServerFit.BelowMinimum } below:
            <MudAlert Severity="Severity.Error" id="pkg-server-minimum">@Loc["PkgServerBelowMinimum", below.Minimum ?? "", below.Server]</MudAlert>
            break;
        case { Fit: PackageServerFit.AboveMaximum } above:
            <MudAlert Severity="Severity.Warning" id="pkg-server-maximum">
                @Loc["PkgServerAboveMaximum", above.Maximum ?? "", above.Server]
                <MudCheckBox T="bool" @bind-Value="_pastMaximumConfirmed" Color="Color.Warning" id="pkg-server-maximum-confirm"
                             Label="@Loc["PkgServerPastMaximumConfirm"]" />
            </MudAlert>
            break;
        case { Fit: PackageServerFit.NewerThanVerified } untested:
            <MudAlert Severity="Severity.Warning" Dense="true" id="pkg-server-verified">@Loc["PkgServerNewerThanVerified", untested.Verified ?? "", untested.Server]</MudAlert>
            break;
    }

    @foreach (var warning in _plan.ManifestWarnings)
    {
        <MudAlert Severity="Severity.Warning" Dense="true">@warning</MudAlert>
    }
    @foreach (var collision in _plan.Changeset.CommandCollisions)
    {
        <MudAlert Severity="Severity.Warning" Dense="true">
            @Loc["PkgCommandCollision", collision.Pattern, collision.OtherPackageId, collision.OtherObjid, collision.OtherAttribute]
        </MudAlert>
    }
    @foreach (var note in _plan.Changeset.Notes)
    {
        <MudAlert Severity="Severity.Info" Dense="true">@note</MudAlert>
    }

    @* ── Plugin code ──────────────────────────────────────────────────── *@
    @if ((_plan.Kind is PackageKind.Plugin or PackageKind.Ui) && _plan.Binary is { } binary)
    {
        <KitCard Title="@(_plan.Kind == PackageKind.Ui ? "UI package files" : Loc["PkgPluginCode"].Value)" Sub="@(_plan.Kind == PackageKind.Ui ? "HTML and JavaScript for the reusable application host." : Loc["PkgPluginCodeSub"].Value)">
            <div class="pkg-review-body">
                <MudTable Items="binary.Files" Dense="true" Elevation="0" Class="pkg-objects-table">
                    <HeaderContent>
                        <MudTh>@Loc["PkgPluginFile"]</MudTh><MudTh>@Loc["PkgPluginSha"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd data-label="@Loc["PkgPluginFile"]"><code>@context.FileName</code></MudTd>
                        <MudTd data-label="@Loc["PkgPluginSha"]"><code class="pkg-sha">@context.Sha256</code></MudTd>
                    </RowTemplate>
                </MudTable>
                <MudText Typo="Typo.caption">@Loc["PkgPluginMinServer", binary.MinServerVersion.ToString()]</MudText>
                <MudCheckBox T="bool" @bind-Value="_pluginTrusted" Color="Color.Error" id="pkg-plugin-trust"
                             Label="@(_plan.Kind == PackageKind.Ui ? $"I trust the browser code in {_plan.PackageId}." : Loc["PkgPluginTrust", _plan.PackageId].Value)" />
            </div>
        </KitCard>
    }

    @* ── Configure ────────────────────────────────────────────────────── *@
    @if (_plan.Configure.Count > 0)
    {
        <KitCard Title="@Loc["Configuration"]">
            <div class="pkg-review-body">
                <MudStack Spacing="2">
                    @foreach (var prompt in _plan.Configure)
                    {
                        <MudTextField T="string"
                                      Value="@(_answers.GetValueOrDefault(prompt.Key) ?? prompt.Default ?? "")"
                                      ValueChanged="@(v => _answers[prompt.Key] = v)"
                                      Label="@($"{prompt.Label} ({prompt.Type})")"
                                      HelperText="@(prompt.Type == "dbref" ? Loc["PkgDbrefHelper"].Value : null)"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                    }
                    <MudButton Variant="Variant.Outlined" Disabled="@_busy" OnClick="@ReplanAsync">
                        @Loc["PkgReplan"]
                    </MudButton>
                </MudStack>
            </div>
        </KitCard>
    }

    @* ── What this game changed ──────────────────────────────────────── *@
    @if (_localEditRows.Count > 0)
    {
        <KitCard Title="@Loc["PkgLocalEditsCount", _localEditRows.Count]" Sub="@Loc["PkgLocalEditsSub"]" Class="pkg-local-edits">
            <div class="pkg-review-body">
                <MudTable Items="_localEditRows" Dense="true" Elevation="0" Class="pkg-objects-table">
                    <HeaderContent>
                        <MudTh>@Loc["PkgLocalEditWhat"]</MudTh><MudTh>@Loc["PkgLocalEditOutcome"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd data-label="@Loc["PkgLocalEditWhat"]"><code>@context.What</code></MudTd>
                        <MudTd data-label="@Loc["PkgLocalEditOutcome"]">
                            <MudChip T="string" Size="Size.Small" Color="@context.Color">@context.Outcome</MudChip>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </div>
        </KitCard>
    }

    @* ── Objects ──────────────────────────────────────────────────────── *@
    @if (!IsContentPack)
    {
    <KitCard Title="@Loc["PkgObjectsCount", _plan.Changeset.Objects.Count]">
        <div class="pkg-review-body">
            <MudTable Items="_plan.Changeset.Objects" Dense="true" Elevation="0" Class="pkg-objects-table">
                <HeaderContent>
                    <MudTh>@Loc["PkgRef"]</MudTh><MudTh>@Loc["PkgAction"]</MudTh><MudTh>@Loc["PkgType"]</MudTh><MudTh>@Loc["PkgName"]</MudTh><MudTh>@Loc["PkgDetails"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd data-label="@Loc["PkgRef"]"><code>@context.Ref</code></MudTd>
                    <MudTd data-label="@Loc["PkgAction"]"><MudChip T="string" Size="Size.Small" Color="@ObjectColor(context.Action)">@context.Action</MudChip></MudTd>
                    <MudTd data-label="@Loc["PkgType"]">@context.Type.ToString().ToLowerInvariant()</MudTd>
                    <MudTd data-label="@Loc["PkgName"]">@context.Name</MudTd>
                    <MudTd data-label="@Loc["PkgDetails"]">
                        @if (context.RenamedFromRef is not null)
                        {
                            <MudText Typo="Typo.caption">@Loc["PkgRenamedFrom", context.RenamedFromRef, context.Objid ?? string.Empty]</MudText>
                        }
                        @foreach (var diff in context.MetadataDiffs ?? [])
                        {
                            <MudText Typo="Typo.caption">@diff</MudText>
                        }
                        @if (context.Action == PackageObjectAction.Delete)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Error">@Loc["PkgWillBeMarkedGoing", context.Objid ?? string.Empty]</MudText>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </div>
    </KitCard>
    }

    @* ── Configuration options ───────────────────────────────────── *@
    @if (_plan.Changeset.Settings is { Count: > 0 } settings)
    {
        <KitCard Title="@Loc["PkgSettingsCount", settings.Count]" Sub="@Loc["PkgSettingsSub"]" Class="pkg-settings">
            <div class="pkg-review-body">
                <MudTable Items="settings" Dense="true" Elevation="0" Class="pkg-objects-table">
                    <HeaderContent>
                        <MudTh>@Loc["PkgSettingOption"]</MudTh><MudTh>@Loc["PkgSettingNow"]</MudTh><MudTh>@Loc["PkgSettingAfter"]</MudTh><MudTh>@Loc["PkgAction"]</MudTh><MudTh>@Loc["PkgDetails"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd data-label="@Loc["PkgSettingOption"]"><code>@context.Option</code></MudTd>
                        <MudTd data-label="@Loc["PkgSettingNow"]"><code>@(context.Current ?? Loc["PkgSettingNone"].Value)</code></MudTd>
                        <MudTd data-label="@Loc["PkgSettingAfter"]"><code>@(context.Value ?? Loc["PkgSettingNone"].Value)</code></MudTd>
                        <MudTd data-label="@Loc["PkgAction"]"><MudChip T="string" Size="Size.Small" Color="@SettingColor(context.Action)">@context.Action</MudChip></MudTd>
                        <MudTd data-label="@Loc["PkgDetails"]"><MudText Typo="Typo.caption">@context.Detail</MudText></MudTd>
                    </RowTemplate>
                </MudTable>
                @if (ChangesSettings)
                {
                    <MudCheckBox T="bool" @bind-Value="_settingsConfirmed" Color="Color.Primary" id="pkg-settings-confirm"
                                 Label="@Loc["PkgSettingsConfirm"]" />
                }
            </div>
        </KitCard>
    }

    @* ── Roles, permissions and categories ──────────────────────── *@
    @if (RoleDeclarations is { Count: > 0 } declarations)
    {
        <KitCard Title="@Loc["PkgDeclarationsCount", declarations.Count]">
            <div class="pkg-review-body">
                <MudTable Items="declarations" Dense="true" Elevation="0" Class="pkg-objects-table">
                    <HeaderContent>
                        <MudTh>@Loc["PkgType"]</MudTh><MudTh>@Loc["PkgName"]</MudTh><MudTh>@Loc["PkgAction"]</MudTh><MudTh>@Loc["PkgDetails"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd data-label="@Loc["PkgType"]">@context.Kind.Noun()</MudTd>
                        <MudTd data-label="@Loc["PkgName"]"><code>@context.Name</code></MudTd>
                        <MudTd data-label="@Loc["PkgAction"]"><MudChip T="string" Size="Size.Small" Color="@DeclarationColor(context.Action)">@context.Action</MudChip></MudTd>
                        <MudTd data-label="@Loc["PkgDetails"]"><MudText Typo="Typo.caption">@context.Detail</MudText></MudTd>
                    </RowTemplate>
                </MudTable>
            </div>
        </KitCard>
    }

    @* ── Attribute entries (format 1.5) ─────────────────────────── *@
    @if (AttributeEntries is { Count: > 0 } attributeEntries)
    {
        <KitCard Title="@Loc["PkgAttributeEntriesCount", attributeEntries.Count]" Sub="@Loc["PkgAttributeEntriesSub"]" Class="pkg-attribute-entries">
            <div class="pkg-review-body">
                <MudTable Items="attributeEntries" Dense="true" Elevation="0" Class="pkg-objects-table">
                    <HeaderContent>
                        <MudTh>@Loc["PkgName"]</MudTh><MudTh>@Loc["PkgAction"]</MudTh><MudTh>@Loc["PkgAttributeEntryRetroactive"]</MudTh><MudTh>@Loc["PkgDetails"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd data-label="@Loc["PkgName"]"><code>@context.Name</code></MudTd>
                        <MudTd data-label="@Loc["PkgAction"]"><MudChip T="string" Size="Size.Small" Color="@DeclarationColor(context.Action)">@context.Action</MudChip></MudTd>
                        <MudTd data-label="@Loc["PkgAttributeEntryRetroactive"]">@(context.Retroactive?.ToString() ?? "")</MudTd>
                        <MudTd data-label="@Loc["PkgDetails"]"><MudText Typo="Typo.caption">@context.Detail</MudText></MudTd>
                    </RowTemplate>
                </MudTable>
                @if (ChangesExistingAttributes)
                {
                    <MudCheckBox T="bool" @bind-Value="_retroactiveConfirmed" Color="Color.Primary" id="pkg-retroactive-confirm"
                                 Label="@Loc["PkgAttributeEntriesConfirm", RetroactiveCopies]" />
                }
            </div>
        </KitCard>
    }

    @* ── Wiki pages ───────────────────────────────────────────────────── *@
    @if (_plan.Changeset.Wiki is { Count: > 0 } wikiPages)
    {
        <KitCard Title="@Loc["PkgWikiPagesCount", wikiPages.Count]" Sub="@Loc["PkgWikiPagesSub"]" Class="pkg-wiki">
            <Controls>
                @if (_wikiConflicts.Count > 0)
                {
                    <Pill Tag="true" Warn="true">@Loc.Plural("PkgConflictCount", "count", _wikiConflicts.Count)</Pill>
                }
            </Controls>
            <ChildContent>
            <div class="pkg-review-body">
                <MudTable Items="wikiPages" Dense="true" Elevation="0" Class="pkg-objects-table">
                    <HeaderContent>
                        <MudTh>@Loc["PkgWikiPage"]</MudTh><MudTh>@Loc["PkgWikiTitle"]</MudTh><MudTh>@Loc["PkgAction"]</MudTh><MudTh>@Loc["PkgDetails"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd data-label="@Loc["PkgWikiPage"]"><code>@WikiLabel(context)</code></MudTd>
                        <MudTd data-label="@Loc["PkgWikiTitle"]">@context.Title</MudTd>
                        <MudTd data-label="@Loc["PkgAction"]">
                            <MudChip T="string" Size="Size.Small" Color="@WikiColor(context.Action)">
                                @(context.Action == PackageWikiAction.Conflict
                                    ? Loc["PkgConflictLabel", context.Conflict?.ToString() ?? string.Empty].Value
                                    : context.Action.ToString())
                            </MudChip>
                        </MudTd>
                        <MudTd data-label="@Loc["PkgDetails"]">
                            @foreach (var line in context.Changes ?? [])
                            {
                                <MudText Typo="Typo.caption">@line</MudText>
                            }
                            @if (context.Detail is not null)
                            {
                                <MudText Typo="Typo.caption">@context.Detail</MudText>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>

                @if (_wikiConflicts.Count > 0)
                {
                    <MudExpansionPanels MultiExpansion="true" Dense="true">
                        @foreach (var change in _wikiConflicts)
                        {
                            var key = WikiDecisionKey(change);
                            <MudExpansionPanel Expanded="true">
                                <TitleContent>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <code>@WikiLabel(change)</code>
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">
                                            @Loc["PkgConflictLabel", change.Conflict?.ToString() ?? string.Empty]
                                        </MudChip>
                                    </MudStack>
                                </TitleContent>
                                <ChildContent>
                                    <MudGrid>
                                        @if (change.BaseMarkdown is not null)
                                        {
                                            <MudItem xs="12" md="4">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@Loc["PkgBaseAsInstalled"]</MudText>
                                                <pre class="mush-pane">@change.BaseMarkdown</pre>
                                            </MudItem>
                                        }
                                        @if (change.LiveMarkdown is not null)
                                        {
                                            <MudItem xs="12" md="4">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@Loc["PkgLiveYourVersion"]</MudText>
                                                <pre class="mush-pane">@change.LiveMarkdown</pre>
                                            </MudItem>
                                        }
                                        @if (change.NewMarkdown is not null)
                                        {
                                            <MudItem xs="12" md="4">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@Loc["PkgNewVersion", _plan.Version]</MudText>
                                                <pre class="mush-pane">@change.NewMarkdown</pre>
                                            </MudItem>
                                        }
                                        @if (change.MergedMarkdown is not null)
                                        {
                                            <MudItem xs="12">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@Loc["PkgWikiMerged"]</MudText>
                                                <pre class="mush-pane">@change.MergedMarkdown</pre>
                                            </MudItem>
                                        }
                                    </MudGrid>

                                    <MudRadioGroup T="string"
                                                   Value="@(_decisions.GetValueOrDefault(key) ?? "")"
                                                   ValueChanged="@(v => _decisions[key] = v)">
                                        <MudRadio T="string" Value="@("KeepMine")">@Loc["PkgKeepMine"]</MudRadio>
                                        <MudRadio T="string" Value="@("TakeTheirs")">@Loc["PkgTakeTheirs"]</MudRadio>
                                        <MudRadio T="string" Value="@("UseCustom")">@Loc["PkgWikiEditMerged"]</MudRadio>
                                    </MudRadioGroup>
                                    @if (_decisions.GetValueOrDefault(key) == "UseCustom")
                                    {
                                        <MudTextField T="string"
                                                      Value="@(_customValues.GetValueOrDefault(key) ?? WikiStartingText(change))"
                                                      ValueChanged="@(v => _customValues[key] = v)"
                                                      Label="@Loc["PkgWikiMergedLabel"]" Lines="12" Variant="Variant.Outlined" />
                                    }
                                </ChildContent>
                            </MudExpansionPanel>
                        }
                    </MudExpansionPanels>
                }
            </div>
            </ChildContent>
        </KitCard>
    }

    @* ── Attributes ───────────────────────────────────────────────────── *@
    @if (!IsContentPack)
    {
    <KitCard Title="@Loc["PkgAttributesCount", _plan.Changeset.Attributes.Count]">
        <Controls>
            @if (_conflicts.Count > 0)
            {
                <Pill Tag="true" Warn="true">@Loc.Plural("PkgConflictCount", "count", _conflicts.Count)</Pill>
            }
            @if (HasLocalEdits)
            {
                <MudSwitch T="bool" @bind-Value="_onlyLocalEdits" Color="Color.Primary" id="pkg-only-local-edits"
                           Label="@Loc["PkgOnlyLocalEdits"]" />
            }
        </Controls>
        <ChildContent>
        <div class="pkg-review-body">
            <MudExpansionPanels MultiExpansion="true" Dense="true">
                @foreach (var change in _plan.Changeset.Attributes.Where(a => !_onlyLocalEdits || !HasLocalEdits || a.IsLocalEdit))
                {
                    var render = RenderFor(change);
                    <MudExpansionPanel Expanded="@(change.Action is PackageAttributeAction.Conflict or PackageAttributeAction.Merge)">
                        <TitleContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <code>@change.TargetRef/@change.Attribute</code>
                                <MudChip T="string" Size="Size.Small" Color="@AttributeColor(change)">
                                    @(change.Action == PackageAttributeAction.Conflict
                                        ? Loc["PkgConflictLabel", change.Conflict?.ToString() ?? string.Empty].Value
                                        : change.Action.ToString())
                                </MudChip>
                                @foreach (var danger in render?.DangerousPatterns ?? [])
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Error"
                                             Icon="@Icons.Material.Filled.Warning">@danger</MudChip>
                                }
                                @if (change.RequiresApplyResolution)
                                {
                                    <MudTooltip Text="@Loc["PkgResolvesAtApplyTooltip"]">
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@Loc["PkgResolvesAtApply"]</MudChip>
                                    </MudTooltip>
                                }
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            <MudGrid>
                                @if (render?.BaseHtml is not null)
                                {
                                    <MudItem xs="12" md="4">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@Loc["PkgBaseAsInstalled"]</MudText>
                                        <pre class="mush-pane">@((MarkupString)render.BaseHtml)</pre>
                                    </MudItem>
                                }
                                @if (render?.LiveHtml is not null)
                                {
                                    <MudItem xs="12" md="4">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@Loc["PkgLiveYourVersion"]</MudText>
                                        <pre class="mush-pane">@((MarkupString)render.LiveHtml)</pre>
                                    </MudItem>
                                }
                                @if (render?.NewHtml is not null)
                                {
                                    <MudItem xs="12" md="4">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@Loc["PkgNewVersion", _plan.Version]</MudText>
                                        <pre class="mush-pane">@((MarkupString)render.NewHtml)</pre>
                                    </MudItem>
                                }
                                @if (render?.MergedHtml is not null)
                                {
                                    <MudItem xs="12">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @(change.Action == PackageAttributeAction.Merge ? Loc["PkgMergedWritten"] : Loc["PkgWikiMerged"])
                                        </MudText>
                                        <pre class="mush-pane">@((MarkupString)render.MergedHtml)</pre>
                                    </MudItem>
                                }
                            </MudGrid>

                            @if (change.Action == PackageAttributeAction.Conflict)
                            {
                                var key = DecisionKey(change);
                                <MudRadioGroup T="string"
                                               Value="@(_decisions.GetValueOrDefault(key) ?? "")"
                                               ValueChanged="@(v => _decisions[key] = v)">
                                    <MudRadio T="string" Value="@("KeepMine")">@Loc["PkgKeepMine"]</MudRadio>
                                    <MudRadio T="string" Value="@("TakeTheirs")">
                                        @(change.Conflict == PackageConflictKind.ModifyDelete ? Loc["PkgDeleteTakeTheirs"] : Loc["PkgTakeTheirs"])
                                    </MudRadio>
                                    <MudRadio T="string" Value="@("UseCustom")">@Loc["PkgEditMergedValue"]</MudRadio>
                                </MudRadioGroup>
                                @if (_decisions.GetValueOrDefault(key) == "UseCustom")
                                {
                                    <MudTextField T="string"
                                                  Value="@(_customValues.GetValueOrDefault(key) ?? AttributeStartingText(change))"
                                                  ValueChanged="@(v => _customValues[key] = v)"
                                                  Label="@Loc["PkgMergedValueLabel"]" Lines="4" Variant="Variant.Outlined" />
                                }
                            }
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        </div>
        </ChildContent>
    </KitCard>
    }

    @* ── Lock conflicts ───────────────────────────────────────────────── *@
    @if (_lockConflicts.Count > 0)
    {
        <KitCard Title="@Loc["PkgLockConflictsCount", _lockConflicts.Count]" Sub="@Loc["PkgLockConflictsSub"]" Class="pkg-lock-conflicts">
            <div class="pkg-review-body">
                @foreach (var change in _lockConflicts)
                {
                    var key = LockDecisionKey(change);
                    <div class="pkg-lock-conflict">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <code>@change.TargetRef @Loc["PkgStructLock", change.Element]</code>
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning">
                                @Loc["PkgConflictLabel", change.Conflict?.ToString() ?? string.Empty]
                            </MudChip>
                        </MudStack>
                        <MudGrid>
                            @if (change.BaseValue is not null)
                            {
                                <MudItem xs="12" md="4">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@Loc["PkgBaseAsInstalled"]</MudText>
                                    <pre class="mush-pane">@change.BaseValue</pre>
                                </MudItem>
                            }
                            @if (change.LiveValue is not null)
                            {
                                <MudItem xs="12" md="4">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@Loc["PkgLiveYourVersion"]</MudText>
                                    <pre class="mush-pane">@change.LiveValue</pre>
                                </MudItem>
                            }
                            @if (change.NewValue is not null)
                            {
                                <MudItem xs="12" md="4">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@Loc["PkgNewVersion", _plan.Version]</MudText>
                                    <pre class="mush-pane">@change.NewValue</pre>
                                </MudItem>
                            }
                        </MudGrid>
                        <MudRadioGroup T="string"
                                       Value="@(_decisions.GetValueOrDefault(key) ?? "")"
                                       ValueChanged="@(v => _decisions[key] = v)">
                            <MudRadio T="string" Value="@("KeepMine")">@Loc["PkgKeepMine"]</MudRadio>
                            <MudRadio T="string" Value="@("TakeTheirs")">@Loc["PkgTakeTheirs"]</MudRadio>
                            <MudRadio T="string" Value="@("UseCustom")">@Loc["PkgEditMergedValue"]</MudRadio>
                        </MudRadioGroup>
                        @if (_decisions.GetValueOrDefault(key) == "UseCustom")
                        {
                            <MudTextField T="string"
                                          Value="@(_customValues.GetValueOrDefault(key) ?? change.LiveValue ?? change.NewValue ?? "")"
                                          ValueChanged="@(v => _customValues[key] = v)"
                                          Label="@Loc["PkgLockValueLabel"]" Variant="Variant.Outlined" />
                        }
                    </div>
                }
            </div>
        </KitCard>
    }

    @* ── What runs after the apply ───────────────────────────────────── *@
    @if (Hooks() is { Count: > 0 } hooks)
    {
        <KitCard Title="@Loc["PkgHooksCount", _plan.Changeset.LifecycleHook!, hooks.Count]" Sub="@Loc["PkgHooksSub"]" Class="pkg-hooks">
            <div class="pkg-review-body">
                @foreach (var hook in hooks)
                {
                    <div class="pkg-hook">
                        <MudText Typo="Typo.subtitle2"><code>@hook.Where</code></MudText>
                        <pre class="mush-pane">@hook.Code</pre>
                    </div>
                }
            </div>
        </KitCard>
    }
}
</div>

@code {
    private string _remote = "";
    private string _path = "";
    private string? _version;

    private PlanResponse? _plan;
    private string? _loadError;
    private bool _busy;

    private readonly Dictionary<string, string> _answers = new();
    private readonly Dictionary<string, string> _decisions = new();
    private readonly Dictionary<string, string> _customValues = new();
    private Dictionary<(string, string), AttributeRenderDto> _renders = new();
    private List<PackageAttributeChange> _conflicts = [];
    private List<PackageWikiChange> _wikiConflicts = [];
    private List<PackageStructureChange> _lockConflicts = [];

    /// <summary>One thing the game changed since the package last installed it, and what the upgrade does with it.</summary>
    private sealed record LocalEditRow(string What, string Outcome, Color Color);

    private List<LocalEditRow> _localEditRows = [];

    /// <summary>Whether the attribute list shows only what this game changed.</summary>
    private bool _onlyLocalEdits;

    /// <summary>
    /// Whether the plan has an attribute this game changed. The filter applies only then: a replan can leave none,
    /// and the switch is hidden with nothing to turn it off.
    /// </summary>
    private bool HasLocalEdits => _plan?.Changeset.Attributes.Any(a => a.IsLocalEdit) == true;

    private bool _settingsConfirmed;

    /// <summary>Whether the administrator confirmed applying a package on a server newer than its <c>maximum_server</c>.</summary>
    private bool _pastMaximumConfirmed;

    private bool PastMaximum => _plan?.Changeset.Compatibility?.Fit == PackageServerFit.AboveMaximum;

    /// <summary>Whether the administrator confirmed they trust a plugin package's author; a plugin cannot install without it.</summary>
    private bool _pluginTrusted;

    private bool IsPlugin => _plan?.Kind is PackageKind.Plugin or PackageKind.Ui;

    /// <summary>A content pack ships wiki pages and nothing else, so it has no objects or attributes to show.</summary>
    private bool IsContentPack =>
        _plan is { Changeset: { Objects.Count: 0, Attributes.Count: 0, Wiki.Count: > 0 } };

    private bool IsUpload => string.Equals(_remote, "upload", StringComparison.OrdinalIgnoreCase);

    /// <summary>Whether applying changes a configuration option, which the admin confirms before applying.</summary>
    private bool ChangesSettings =>
        _plan?.Changeset.Settings?.Any(s => s.Action is PackageSettingAction.Set or PackageSettingAction.Restore) ?? false;

    private bool _retroactiveConfirmed;

    /// <summary>The roles, permissions and categories in the plan; attribute entries have a card of their own.</summary>
    private List<PackageDeclarationChange> RoleDeclarations =>
        (_plan?.Changeset.Declarations ?? []).Where(d => d.Kind != PackageDeclarationKind.Attribute).ToList();

    /// <summary>The standard attribute entries in the plan (format 1.5).</summary>
    private List<PackageDeclarationChange> AttributeEntries =>
        (_plan?.Changeset.Declarations ?? []).Where(d => d.Kind == PackageDeclarationKind.Attribute).ToList();

    /// <summary>How many attributes already on objects a retroactive entry changes.</summary>
    private int RetroactiveCopies => AttributeEntries.Sum(d => d.Retroactive ?? 0);

    /// <summary>Whether applying changes the flags of attributes already on objects, which the admin confirms first.</summary>
    private bool ChangesExistingAttributes => RetroactiveCopies > 0;

    private bool CanApply =>
        _plan is not null
        && !_plan.Changeset.IsBlocked
        && (!ChangesSettings || _settingsConfirmed)
        && (!PastMaximum || _pastMaximumConfirmed)
        && (!ChangesExistingAttributes || _retroactiveConfirmed)
        && (!IsPlugin || _pluginTrusted)
        && _conflicts.All(c => !string.IsNullOrEmpty(_decisions.GetValueOrDefault(DecisionKey(c))))
        && _wikiConflicts.All(c => !string.IsNullOrEmpty(_decisions.GetValueOrDefault(WikiDecisionKey(c))))
        && _lockConflicts.All(c => !string.IsNullOrEmpty(_decisions.GetValueOrDefault(LockDecisionKey(c))));

    protected override async Task OnInitializedAsync()
    {
        var query = System.Web.HttpUtility.ParseQueryString(Nav.ToAbsoluteUri(Nav.Uri).Query);
        _remote = query["remote"] ?? "";
        _path = query["path"] ?? "";
        _version = query["version"];
        if (string.IsNullOrEmpty(_remote))
        {
            _loadError = Loc["PkgMissingRemoteParam"];
            return;
        }

        await ReplanAsync();
    }

    private async Task ReplanAsync()
    {
        _busy = true;
        try
        {
            var planned = await Packages.PlanAsync(new PlanRequest(_remote, _path, _version, new(_answers)));
            if (planned is ApiFailure planFailure)
            {
                _loadError = planFailure.Message;
                return;
            }
            if (planned is not PlanResponse plan) return;

            _plan = plan;
            _settingsConfirmed = false;
            _pastMaximumConfirmed = false;
            _retroactiveConfirmed = false;
            _renders = plan.Renders.ToDictionary(r => (r.TargetRef, r.Attribute), r => r);
            _conflicts = plan.Changeset.Attributes
                .Where(a => a.Action == PackageAttributeAction.Conflict)
                .ToList();
            _wikiConflicts = (plan.Changeset.Wiki ?? [])
                .Where(w => w.Action == PackageWikiAction.Conflict)
                .ToList();

            _lockConflicts = plan.Changeset.Structure
                .Where(s => s.Action == PackageStructureAction.Conflict && s.Kind == PackageStructureKind.Lock)
                .ToList();
            _localEditRows = LocalEditRows(plan.Changeset);

            // What staff changed is kept by default; the administrator chooses to take the package's instead.
            foreach (var change in _conflicts)
            {
                _decisions.TryAdd(DecisionKey(change), "KeepMine");
            }

            foreach (var change in _wikiConflicts)
            {
                _decisions.TryAdd(WikiDecisionKey(change), "KeepMine");
            }

            foreach (var change in _lockConflicts)
            {
                _decisions.TryAdd(LockDecisionKey(change), "KeepMine");
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private AttributeRenderDto? RenderFor(PackageAttributeChange change) =>
        _renders.GetValueOrDefault((change.TargetRef, change.Attribute));

    private static string DecisionKey(PackageAttributeChange change) =>
        $"{change.TargetRef}\0{change.Attribute}";

    /// <summary>One lifecycle hook the apply runs afterwards, as it will read once the apply has written it.</summary>
    private sealed record HookRow(string Where, string Code);

    /// <summary>
    /// The hooks the apply runs: the package's own, as the review's choices leave them, and any the game's objects
    /// hold that the package does not ship.
    /// </summary>
    private List<HookRow> Hooks()
    {
        if (_plan?.Changeset is not { LifecycleHook: { } hook } changeset)
        {
            return [];
        }

        return changeset.Attributes
            .Where(a => string.Equals(a.Attribute, hook, StringComparison.OrdinalIgnoreCase))
            .Select(a => (Where: $"{a.TargetRef}/{a.Attribute}", Code: HookCode(a)))
            .Concat((changeset.LocalHooks ?? []).Select(h => (Where: $"{h.TargetRef}/{h.Attribute}", Code: (string?)h.Value)))
            .Where(h => !string.IsNullOrWhiteSpace(h.Code))
            .Select(h => new HookRow(h.Where, h.Code!))
            .ToList();
    }

    /// <summary>What an attribute holds after the apply, under the decision chosen for it.</summary>
    private string? HookCode(PackageAttributeChange change) => change.Action switch
    {
        PackageAttributeAction.Delete or PackageAttributeAction.RemoveBaseline => null,
        PackageAttributeAction.KeepLocal => change.LiveValue,
        PackageAttributeAction.Merge => change.MergedValue,
        PackageAttributeAction.Conflict => _decisions.GetValueOrDefault(DecisionKey(change)) switch
        {
            "TakeTheirs" => change.NewValue,
            "UseCustom" => _customValues.GetValueOrDefault(DecisionKey(change)) ?? AttributeStartingText(change),
            _ => change.LiveValue
        },
        _ => change.NewValue
    };

    /// <summary>The installer keys a lock decision as the attribute <c>@LOCK`&lt;type&gt;</c> on its object.</summary>
    private static string LockDecisionAttribute(PackageStructureChange change) => $"@LOCK`{change.Element}";

    private static string LockDecisionKey(PackageStructureChange change) =>
        $"{change.TargetRef}\0{LockDecisionAttribute(change)}";

    /// <summary>Where an edited attribute starts: the merge with its clashes marked, else the game's value, else the package's.</summary>
    private static string AttributeStartingText(PackageAttributeChange change) =>
        change.MergedValue ?? change.LiveValue ?? change.NewValue ?? "";

    private List<LocalEditRow> LocalEditRows(PackageChangeset changeset) =>
        changeset.Attributes.Where(a => a.IsLocalEdit)
            .Select(a => new LocalEditRow($"{a.TargetRef}/{a.Attribute}", LocalOutcome(a.Action == PackageAttributeAction.Merge, a.Action == PackageAttributeAction.Conflict), LocalColor(a.Action == PackageAttributeAction.Conflict)))
            .Concat(changeset.Structure.Where(s => s.IsLocalEdit)
                .Select(s => new LocalEditRow($"{s.TargetRef} {StructureLabel(s)}", LocalOutcome(merged: false, s.Action == PackageStructureAction.Conflict), LocalColor(s.Action == PackageStructureAction.Conflict))))
            .ToList();

    private string LocalOutcome(bool merged, bool conflict) =>
        conflict ? Loc["PkgLocalDecide"] : merged ? Loc["PkgLocalMerged"] : Loc["PkgLocalKept"];

    private static Color LocalColor(bool conflict) => conflict ? Color.Warning : Color.Tertiary;

    private string StructureLabel(PackageStructureChange change) => change.Kind switch
    {
        PackageStructureKind.ObjectFlag => Loc["PkgStructFlag", change.Element],
        PackageStructureKind.ObjectPower => Loc["PkgStructPower", change.Element],
        PackageStructureKind.AttributeFlag => Loc["PkgStructAttrFlag", change.Element, change.Attribute ?? string.Empty],
        _ => Loc["PkgStructLock", change.Element]
    };

    private static string WikiDecisionKey(PackageWikiChange change) =>
        $"{change.TargetRef}\0{change.Page}";

    private static string WikiLabel(PackageWikiChange change) =>
        change.Namespace == "main" ? change.Page : $"{change.Namespace}:{change.Page}";

    /// <summary>Where an edited page starts: the merge with its clashes marked, else the game's page, else the package's.</summary>
    private static string WikiStartingText(PackageWikiChange change) =>
        change.MergedMarkdown ?? change.LiveMarkdown ?? change.NewMarkdown ?? "";

    private async Task ApplyAsync()
    {
        if (_plan is null)
        {
            return;
        }

        _busy = true;
        try
        {
            var decisions = _conflicts.Select(c =>
            {
                var key = DecisionKey(c);
                var resolution = Enum.Parse<PackageConflictResolution>(_decisions[key]);
                return new PackageConflictDecision(
                    c.TargetRef, c.Attribute, resolution,
                    resolution == PackageConflictResolution.UseCustom
                        ? _customValues.GetValueOrDefault(key) ?? AttributeStartingText(c)
                        : null);
            }).Concat(_lockConflicts.Select(c =>
            {
                var key = LockDecisionKey(c);
                var resolution = Enum.Parse<PackageConflictResolution>(_decisions[key]);
                return new PackageConflictDecision(
                    c.TargetRef, LockDecisionAttribute(c), resolution,
                    resolution == PackageConflictResolution.UseCustom
                        ? _customValues.GetValueOrDefault(key) ?? c.LiveValue ?? c.NewValue ?? ""
                        : null);
            })).Concat(_wikiConflicts.Select(c =>
            {
                var key = WikiDecisionKey(c);
                var resolution = Enum.Parse<PackageConflictResolution>(_decisions[key]);
                return new PackageConflictDecision(
                    c.TargetRef, c.Page, resolution,
                    resolution == PackageConflictResolution.UseCustom
                        ? _customValues.GetValueOrDefault(key) ?? WikiStartingText(c)
                        : null);
            })).ToList();

            switch (await Packages.ApplyAsync(new ApplyRequest(
                _remote, _path, _version, new(_answers), decisions, AllowPluginCode: IsPlugin && _pluginTrusted,
                AllowPastMaximum: PastMaximum && _pastMaximumConfirmed)))
            {
                case ApiFailure failure:
                    Snackbar.Add(failure.Message, Severity.Error);
                    return;
                case ApplyResponse result:
                    Snackbar.Add(Loc["PkgApplied", _plan.PackageId, _plan.Version, result.Revision], Severity.Success);
                    foreach (var note in result.Notes.Take(6))
                    {
                        Snackbar.Add(note, Severity.Info);
                    }

                    Nav.NavigateTo("/admin/packages");
                    break;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private static Color ObjectColor(PackageObjectAction action) => action switch
    {
        PackageObjectAction.Create or PackageObjectAction.RecreateMissing => Color.Info,
        PackageObjectAction.Delete => Color.Error,
        PackageObjectAction.Rename or PackageObjectAction.UpdateMetadata => Color.Warning,
        _ => Color.Default
    };

    private static Color SettingColor(PackageSettingAction action) => action switch
    {
        PackageSettingAction.Set or PackageSettingAction.Restore => Color.Warning,
        PackageSettingAction.Blocked => Color.Error,
        PackageSettingAction.Keep or PackageSettingAction.Release => Color.Tertiary,
        _ => Color.Default
    };

    private static Color DeclarationColor(PackageDeclarationAction action) => action switch
    {
        PackageDeclarationAction.Create => Color.Info,
        PackageDeclarationAction.Remove => Color.Error,
        PackageDeclarationAction.Blocked => Color.Error,
        PackageDeclarationAction.Update or PackageDeclarationAction.Release => Color.Warning,
        PackageDeclarationAction.Existing => Color.Tertiary,
        _ => Color.Default
    };

    private static Color WikiColor(PackageWikiAction action) => action switch
    {
        PackageWikiAction.Conflict => Color.Warning,
        PackageWikiAction.Create or PackageWikiAction.Update => Color.Info,
        PackageWikiAction.Delete or PackageWikiAction.Blocked => Color.Error,
        PackageWikiAction.Adopt or PackageWikiAction.Release => Color.Tertiary,
        _ => Color.Default
    };

    private static Color AttributeColor(PackageAttributeChange change) => change.Action switch
    {
        PackageAttributeAction.Conflict => Color.Warning,
        PackageAttributeAction.Create or PackageAttributeAction.AutoUpgrade => Color.Info,
        PackageAttributeAction.Delete or PackageAttributeAction.RemoveBaseline => Color.Error,
        PackageAttributeAction.KeepLocal or PackageAttributeAction.Adopt or PackageAttributeAction.Merge => Color.Tertiary,
        _ => Color.Default
    };
}
