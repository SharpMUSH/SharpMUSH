@using SharpMUSH.Library.API
@using SharpMUSH.Library.Models.Packages
@inject IStringLocalizer<SharedResource> Loc

@* One package in the remote library: its name, what it does and what it needs, whether it is installed, and the version,
   queue and review actions; the id, version, contents and origin wait under Details, and the README is in the row's
   menu. A package with no release tags offers only the dev channel; the library says that once, above its lists. *@
<div class="lib-row">
<PackageRow Icon="@PackageKinds.Icon(Primary)" Kind="@Primary.ToString().ToLowerInvariant()" Bridge="@Entry.Bridge"
            IconTitle="@(Entry.Bridge ? Loc["PkgKindBridgeOf", PackageKinds.Name(Primary, Loc)] : PackageKinds.Name(Primary, Loc))"
            Name="@PackageLibraryGroups.Name(Entry)"
            Id="@(Entry.Title is null ? null : Entry.PackageId)"
            Description="@(Entry.Description ?? Loc["PkgNoDescription"])">
    <Status>
        @if (Installed is not null)
        {
            <span class="lib-installed">
                <MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Size="Size.Small" aria-hidden="true" />
                @Loc["PkgBrowseInstalled", Installed.Version]
            </span>
        }
    </Status>
    <Notes>
        @if (!Entry.Bridge && Entry.DependsOn is { Count: > 0 } needs)
        {
            <span class="lib-needs">
                <MudIcon Icon="@Icons.Material.Outlined.AccountTree" Size="Size.Small" aria-hidden="true" />
                @Loc["PkgBrowseNeedsLabel"]
                @foreach (var need in needs)
                {
                    var missing = InstalledPackages is { } installed && !installed.ContainsKey(need);
                    <span class="lib-need @(missing ? "lib-need--missing" : null)" title="@(missing ? Loc["PkgBrowseNeedMissing", need].Value : null)">
                        @if (InstalledPackages?.ContainsKey(need) == true)
                        {
                            <MudIcon Icon="@Icons.Material.Outlined.Check" Size="Size.Small" aria-hidden="true" />
                        }
                        @need
                    </span>
                }
            </span>
        }
        @if (Entry.PackageId is null)
        {
            <span class="lib-warn">@Loc["PkgManifestParseFailed"]</span>
        }
    </Notes>
    <Tags>
        @if (Entry.Version is { } version)
        {
            <Pill Tag="true">v@(version)</Pill>
        }
        <PackageKindTags Contents="@Entry.Contents" Bridge="@Entry.Bridge" Joins="@Entry.DependsOn" />
    </Tags>
    <Meta>
        @if (Installed is not null && (!string.Equals(Installed.SourceRepo, SnapshotUrl, StringComparison.Ordinal)
            || !string.Equals(Installed.SourcePath ?? "", Entry.Path, StringComparison.Ordinal)))
        {
            <span class="lib-note">@Loc["PkgBrowseInstalledOrigin", Installed.SourceRepo, string.IsNullOrEmpty(Installed.SourcePath) ? "/" : Installed.SourcePath]</span>
        }
    </Meta>
    <Actions>
        <MudSelect T="string" Value="@Version" ValueChanged="@VersionChanged"
                   Label="@Loc["PkgVersionLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="lib-version-select">
            @foreach (var tag in Entry.Versions)
            {
                <MudSelectItem Value="@tag.Version">@tag.Version</MudSelectItem>
            }
            <MudSelectItem Value="@DevChannel">@Loc["PkgDevChannelOption", Entry.Version ?? "tip"]</MudSelectItem>
        </MudSelect>
        @if (Queued is not null)
        {
            <MudTooltip Text="@Loc["PkgBatchQueuedTooltip"]">
                <MudButton Class="lib-queued" Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Check"
                           aria-pressed="true" OnClick="@OnUnqueue">@Loc["PkgBatchQueued"]</MudButton>
            </MudTooltip>
        }
        else
        {
            <MudButton Class="pkg-btn-primary" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@QueueIcon"
                       aria-pressed="false" Disabled="@(Entry.PackageId is null)" OnClick="@OnQueue">@QueueLabel</MudButton>
        }
        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@OnReview">@Loc["PkgReviewInstall"]</MudButton>
        <RowMenu Label="@Loc["NavRowMore", PackageLibraryGroups.Name(Entry)]">
            <RowMenuItem Icon="@Icons.Material.Outlined.Description" OnClick="@OnReadme">@Loc["PkgShowReadme", Entry.PackageId ?? Entry.Path]</RowMenuItem>
        </RowMenu>
    </Actions>
</PackageRow>
</div>

@code {
    /// <summary>The version choice that installs the branch tip.</summary>
    public const string DevChannel = "__dev__";

    [Parameter, EditorRequired] public PackageRepoEntry Entry { get; set; } = null!;

    /// <summary>The remote's URL, to tell a package installed from elsewhere.</summary>
    [Parameter] public string? SnapshotUrl { get; set; }

    [Parameter] public InstalledPackageRecord? Installed { get; set; }

    /// <summary>Every installed package by id, to mark which of its dependencies are missing; null when that is not known.</summary>
    [Parameter] public IReadOnlyDictionary<string, InstalledPackageRecord>? InstalledPackages { get; set; }

    /// <summary>The queued install of this package, or null when it is not queued.</summary>
    [Parameter] public PackageBatchIntent? Queued { get; set; }

    [Parameter, EditorRequired] public string Version { get; set; } = DevChannel;
    [Parameter] public EventCallback<string> VersionChanged { get; set; }
    [Parameter] public EventCallback OnQueue { get; set; }
    [Parameter] public EventCallback OnUnqueue { get; set; }
    [Parameter] public EventCallback OnReview { get; set; }
    [Parameter] public EventCallback OnReadme { get; set; }

    private PackageContents Primary => PackageKinds.Primary(Entry.Contents);

    /// <summary>The version the chosen one installs: the tag, or the branch tip's manifest version.</summary>
    private string? Target => Version == DevChannel ? Entry.Version : Version;

    /// <summary>Queueing an installed package installs it again: the same version is a reinstall, another one a change of version.</summary>
    private string QueueLabel => Installed is null ? Loc["PkgBatchQueueInstall"]
        : Target == Installed.Version ? Loc["PkgBatchQueueReinstall"]
        : Target is { } target ? Loc["PkgBatchQueueChange", target]
        : Loc["PkgBatchQueueChangeTip"];

    private string QueueIcon => Installed is null ? Icons.Material.Outlined.AddToQueue : Icons.Material.Outlined.Sync;
}
