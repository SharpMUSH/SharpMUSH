@page "/admin/packages/browse"
@attribute [Authorize(Policy = "packages.admin")]
@using SharpMUSH.Client.Services
@using SharpMUSH.Library.API
@using SharpMUSH.Library.DiscriminatedUnions
@using SharpMUSH.Library.Models.Packages
@inject PackagesAdminService Packages
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["PkgBrowseHeading"] — @Loc["PkgAdminSection"] — <GameName /></PageTitle>

<div class="page-stack page-stack--padded pkg-page">
    <PlainPageHeader Kicker="@Loc["PkgKickerRegistry"]" Title="@Loc["PkgBrowseHeading"]" Description="@Loc["PkgBrowseDescription"]" />

    <KitCard>
    <div class="pkg-toolbar">
        <MudSelect T="string" @bind-Value="_selectedRemote" Label="@Loc["PkgRemoteLabel"]" Variant="Variant.Outlined"
                   Margin="Margin.Dense" Class="pkg-remote-select">
            @foreach (var remote in _remotes ?? [])
            {
                <MudSelectItem Value="@remote.Name">@remote.Name</MudSelectItem>
            }
        </MudSelect>
        <MudButton Class="pkg-btn-primary" Variant="Variant.Filled" Disabled="@(_busy || string.IsNullOrEmpty(_selectedRemote))"
                   OnClick="@BrowseAsync">@Loc["PkgRefreshAndBrowse"]</MudButton>
        @if (_remoteRecord is not null)
        {
            <TrustBadge Trust="@_remoteRecord.Trust" />
        }
    </div>
    </KitCard>

    @if (_remoteRecord is { Trust: PackageRemoteTrust.Unknown })
    {
        <MudAlert Severity="Severity.Warning">
            @Loc["PkgUnreviewedSource"]
        </MudAlert>
    }

    @if (_busy)
    {
        <MudProgressLinear Indeterminate="true" />
    }

    @if (_installedFailure is not null)
    {
        <MudAlert Severity="Severity.Warning" Class="pkg-installed-warning">@Loc["PkgBrowseInstalledUnavailable", _installedFailure.Message]</MudAlert>
    }

    @if (_snapshot is not null)
    {
        <div class="pkg-snapshot-meta">
            @Loc["PkgSnapshotAt", _snapshot.Url, _snapshot.HeadCommit[..Math.Min(10, _snapshot.HeadCommit.Length)]]
        </div>
        <div class="pkg-grid">
            @foreach (var entry in _snapshot.Packages)
            {
                <KitCard Title="@(entry.PackageId ?? entry.Path)">
                    <Controls>
                        <MudIconButton Icon="@Icons.Material.Filled.Description" Size="Size.Small" title="@Loc["PkgShowReadme", entry.PackageId ?? entry.Path]" aria-label="@Loc["PkgShowReadme", entry.PackageId ?? entry.Path]"
                                       OnClick="@(() => ShowReadmeAsync(entry))" />
                    </Controls>
                    <ChildContent>
                    <div class="pkg-card-body">
                        @if (entry.PackageId is { } id && _installed.TryGetValue(id, out var installed))
                        {
                            <div class="pkg-installed-marker">
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" aria-hidden="true" />
                                <span>@Loc["PkgBrowseInstalled", installed.Version]</span>
                            </div>
                            @if (!string.Equals(installed.SourceRepo, _snapshot.Url, StringComparison.Ordinal)
                                || !string.Equals(installed.SourcePath ?? "", entry.Path, StringComparison.Ordinal))
                            {
                                <div class="pkg-card-note">@Loc["PkgBrowseInstalledOrigin", installed.SourceRepo, string.IsNullOrEmpty(installed.SourcePath) ? "/" : installed.SourcePath]</div>
                            }
                        }
                        <div class="pkg-card-desc">@(entry.Description ?? Loc["PkgNoDescription"])</div>
                        @if (entry.PackageId is null)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">@Loc["PkgManifestParseFailed"]</MudAlert>
                        }
                        <div class="pkg-card-row">
                            <MudSelect T="string" Value="@SelectedVersion(entry)" ValueChanged="@(v => _selectedVersions[entry.Path] = v)"
                                       Label="@Loc["PkgVersionLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="pkg-version-select">
                                @foreach (var version in entry.Versions)
                                {
                                    <MudSelectItem Value="@version.Version">@version.Version</MudSelectItem>
                                }
                                <MudSelectItem Value="@DevChannel">@Loc["PkgDevChannelOption", entry.Version ?? "tip"]</MudSelectItem>
                            </MudSelect>
                            <MudButton Class="pkg-btn-primary" Variant="Variant.Filled" Size="Size.Small"
                                       Disabled="@(entry.PackageId is null)" OnClick="@(() => QueueInstall(entry))">@Loc["PkgBatchQueueInstall"]</MudButton>
                            <MudButton Size="Size.Small" OnClick="@(() => GoToReview(entry))">@Loc["PkgReviewInstall"]</MudButton>
                        </div>
                        @if (entry.Versions.Count == 0)
                        {
                            <div class="pkg-card-note">
                                @Loc["PkgNoReleaseTags"]
                            </div>
                        }
                    </div>
                    </ChildContent>
                </KitCard>
            }
        </div>
    }
    <PackageBatchQueue />
</div>

<PackageReadmeDialog @ref="_readme" />

@code {
    private const string DevChannel = "__dev__";

    private IReadOnlyList<PackageRemoteRecord>? _remotes;
    private PackageRemoteRecord? _remoteRecord;
    private string _selectedRemote = "";
    private PackageRepoSnapshot? _snapshot;
    private readonly Dictionary<string, string> _selectedVersions = new();
    private bool _busy;
    private IReadOnlyDictionary<string, InstalledPackageRecord> _installed = new Dictionary<string, InstalledPackageRecord>();
    private ApiFailure? _installedFailure;

    private PackageReadmeDialog? _readme;

    protected override async Task OnInitializedAsync()
    {
        _remotes = await Packages.GetRemotesAsync() is IReadOnlyList<PackageRemoteRecord> remotes ? remotes : [];

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var preset = query["remote"];
        if (!string.IsNullOrEmpty(preset) && _remotes.Any(r => r.Name == preset))
        {
            _selectedRemote = preset;
            await BrowseAsync();
        }
        else if (_remotes.Count == 1)
        {
            _selectedRemote = _remotes[0].Name;
        }
    }

    private string SelectedVersion(PackageRepoEntry entry) =>
        _selectedVersions.GetValueOrDefault(entry.Path)
        ?? entry.Versions.FirstOrDefault()?.Version
        ?? DevChannel;

    private async Task BrowseAsync()
    {
        _busy = true;
        _snapshot = null;
        _installed = new Dictionary<string, InstalledPackageRecord>();
        _installedFailure = null;
        try
        {
            _remoteRecord = (_remotes ?? []).FirstOrDefault(r => r.Name == _selectedRemote);
            var browse = Packages.BrowseAsync(_selectedRemote);
            var installed = Packages.GetInstalledAsync();
            await Task.WhenAll(browse, installed);
            switch (await installed)
            {
                case IReadOnlyList<InstalledPackageDto> packages:
                    _installed = packages.ToDictionary(p => p.Package.Id, p => p.Package, StringComparer.Ordinal);
                    break;
                case ApiFailure failure:
                    _installedFailure = failure;
                    break;
            }
            switch (await browse)
            {
                case PackageRepoSnapshot snapshot:
                    _snapshot = snapshot;
                    break;
                case ApiFailure failure:
                    Snackbar.Add(failure.Message, Severity.Error);
                    return;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private Task ShowReadmeAsync(PackageRepoEntry entry)
        => _readme?.ShowAsync(entry.PackageId ?? entry.Path, () => Packages.GetRemoteReadmeAsync(_selectedRemote, entry.Path))
            ?? Task.CompletedTask;

    private void QueueInstall(PackageRepoEntry entry)
    {
        if (entry.PackageId is null) return;
        var version = SelectedVersion(entry);
        Packages.Batch.Queue(new(entry.PackageId, PackageBatchAction.Install,
            new(_selectedRemote, entry.Path, version == DevChannel ? null : version)));
    }

    private void GoToReview(PackageRepoEntry entry)
    {
        var version = SelectedVersion(entry);
        var versionPart = version == DevChannel ? "" : $"&version={Uri.EscapeDataString(version)}";
        Nav.NavigateTo(
            $"/admin/packages/review?remote={Uri.EscapeDataString(_selectedRemote)}&path={Uri.EscapeDataString(entry.Path)}{versionPart}");
    }
}
