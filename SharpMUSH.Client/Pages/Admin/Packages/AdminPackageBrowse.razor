@page "/admin/packages/browse"
@attribute [Authorize(Policy = "packages.admin")]
@using SharpMUSH.Client.Models
@using SharpMUSH.Client.Resources
@using SharpMUSH.Client.Services
@using SharpMUSH.Library.API
@using SharpMUSH.Library.DiscriminatedUnions
@using SharpMUSH.Library.Models.Packages
@inject PackagesAdminService Packages
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@implements IDisposable
@inject IStringLocalizer<SharedResource> Loc

<AdminPageTitle Page="@Loc["PkgBrowseHeading"]" />

<div class="page-stack page-stack--padded pkg-page">
    <PlainPageHeader Kicker="@Loc["AdmGroupPortal"]" Title="@Loc["PkgBrowseHeading"]" Description="@Loc["PkgBrowseDescription"]" />

    <KitCard>
    <div class="pkg-toolbar">
        <MudSelect T="string" @bind-Value="_selectedRemote" Label="@Loc["PkgRemoteLabel"]" Variant="Variant.Outlined"
                   Margin="Margin.Dense" Class="pkg-remote-select">
            @foreach (var remote in _remotes ?? [])
            {
                <MudSelectItem Value="@remote.Name">@remote.Name</MudSelectItem>
            }
        </MudSelect>
        <MudButton Class="pkg-btn-primary" Variant="Variant.Filled" Disabled="@(_busy || string.IsNullOrEmpty(_selectedRemote))"
                   OnClick="@BrowseAsync">@Loc["PkgRefreshAndBrowse"]</MudButton>
        @if (_remoteRecord is not null)
        {
            <TrustBadge Trust="@_remoteRecord.Trust" />
        }
    </div>
    </KitCard>

    @if (_remoteRecord is { Trust: PackageRemoteTrust.Unknown })
    {
        <MudAlert Severity="Severity.Warning">
            @Loc["PkgUnreviewedSource"]
        </MudAlert>
    }

    @if (_busy)
    {
        <MudProgressLinear Indeterminate="true" />
    }

    @if (_installedFailure is not null)
    {
        <MudAlert Severity="Severity.Warning" Class="pkg-installed-warning">@Loc["PkgBrowseInstalledUnavailable", _installedFailure.Message]</MudAlert>
    }

    @if (_snapshot is not null)
    {
        var groups = Groups();
        <KitCard>
            <div class="lib-filters">
                <div class="lib-chips lib-views" role="group" aria-label="@Loc["PkgViewChoice"]">
                    <button type="button" class="lib-chip @(_graph ? null : "active")" aria-pressed="@(_graph ? "false" : "true")"
                            @onclick="@(() => _graph = false)">
                        <MudIcon Icon="@Icons.Material.Filled.ViewList" Size="Size.Small" aria-hidden="true" />
                        @Loc["PkgViewList"]
                    </button>
                    <button type="button" class="lib-chip @(_graph ? "active" : null)" aria-pressed="@(_graph ? "true" : "false")"
                            @onclick="@(() => _graph = true)">
                        <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" aria-hidden="true" />
                        @Loc["PkgViewGraph"]
                    </button>
                </div>
                <div class="lib-search">
                    <MudIcon Icon="@Icons.Material.Filled.Search" Class="lib-search-icon" />
                    <input name="library-search" type="search" placeholder="@Loc["PkgSearchPlaceholder"]" aria-label="@Loc["PkgSearchPlaceholder"]"
                           value="@_search" @oninput="@(e => _search = e.Value?.ToString() ?? string.Empty)" />
                </div>
                <div class="lib-chips" role="group" aria-label="@Loc["PkgBrowseKindFilter"]">
                    <span class="lib-chips-label">@Loc["PkgBrowseKindFilter"]</span>
                    <button type="button" class="lib-chip @(_kind == PackageContents.None ? "active" : null)" aria-pressed="@(_kind == PackageContents.None ? "true" : "false")"
                            @onclick="@(() => _kind = PackageContents.None)">@Loc["PkgBrowseAnyKind"]</button>
                    @foreach (var kind in KindsListed)
                    {
                        <button type="button" class="lib-chip lib-chip--@kind.ToString().ToLowerInvariant() @(_kind == kind ? "active" : null)" aria-pressed="@(_kind == kind ? "true" : "false")"
                                @onclick="@(() => _kind = kind)">
                            <MudIcon Icon="@PackageKinds.Icon(kind)" Size="Size.Small" aria-hidden="true" />
                            @PackageKinds.Name(kind, Loc)
                        </button>
                    }
                </div>
            </div>
            <nav class="lib-categories" aria-label="@Loc["PkgBrowseCategories"]">
                <button type="button" class="lib-category @(_category is null ? "active" : null)" aria-pressed="@(_category is null ? "true" : "false")"
                        @onclick="@(() => _category = null)">
                    @Loc["PkgBrowseAllCategories"] <span class="lib-count">@groups.Sum(g => g.Count)</span>
                </button>
                @foreach (var group in groups)
                {
                    <button type="button" class="lib-category @(_category == group.Title ? "active" : null)" aria-pressed="@(_category == group.Title ? "true" : "false")"
                            @onclick="@(() => _category = group.Title)">
                        @group.Title <span class="lib-count">@group.Count</span>
                    </button>
                }
            </nav>
        </KitCard>

        var shown = groups.Where(g => _category is null || g.Title == _category).ToList();
        @if (shown.Count == 0)
        {
            <EmptyState>@Loc["PkgNoSearchMatch"]</EmptyState>
        }
        else if (_graph)
        {
            var (nodes, edges) = Graph(shown);
            <KitCard Title="@Loc["PkgViewGraph"]">
                <div class="lib-graph"><PackageGraph Nodes="@nodes" Edges="@edges" /></div>
            </KitCard>
        }
        else
        {
            @foreach (var group in shown)
            {
                <KitCard Title="@group.Title" @key="group.Title">
                    <Controls>
                        <span class="lib-group-count">@Loc.Plural("PkgBrowsePackageCount", "count", group.Count)</span>
                    </Controls>
                    <ChildContent>
                        @foreach (var sub in group.Subcategories)
                        {
                            @if (sub.Title is { } subTitle)
                            {
                                <h3 class="lib-subcategory">@subTitle <span class="lib-count">@sub.Count</span></h3>
                            }
                            <div class="lib-rows">
                                @foreach (var family in sub.Families)
                                {
                                    @Family(family)
                                }
                            </div>
                        }
                    </ChildContent>
                </KitCard>
            }
        }
    }
    <PackageBatchQueue />
</div>

<PackageReadmeDialog @ref="_readme" />

@code {
    private const string DevChannel = LibraryPackageRow.DevChannel;

    private IReadOnlyList<PackageRemoteRecord>? _remotes;
    private PackageRemoteRecord? _remoteRecord;
    private string _selectedRemote = "";
    private PackageRepoSnapshot? _snapshot;
    private readonly Dictionary<string, string> _selectedVersions = new();
    private bool _busy;
    private IReadOnlyDictionary<string, InstalledPackageRecord> _installed = new Dictionary<string, InstalledPackageRecord>();

    /// <summary>The bundled catalogue, read the first time a bridge needs a package this remote does not list.</summary>
    private PackageRepoSnapshot? _catalogue;
    private ApiFailure? _installedFailure;

    private PackageReadmeDialog? _readme;

    private string _search = string.Empty;
    private PackageContents _kind = PackageContents.None;
    private string? _category;
    private readonly HashSet<string> _expanded = new(StringComparer.Ordinal);
    private bool _graph;

    private static readonly IReadOnlyList<PackageContents> KindsListed =
        [PackageContents.Softcode, PackageContents.Wiki, PackageContents.Application, PackageContents.Plugin];

    private RenderFragment Family(PackageLibraryFamily family) => __builder =>
    {
        <div class="lib-family" @key="family.Package.Path">
            @LibraryRow(family.Package)
            @if (family.AddOns.Count > 0)
            {
                var open = Expanded(family);
                <button type="button" class="lib-addons-toggle" aria-expanded="@(open ? "true" : "false")"
                        @onclick="@(() => Toggle(family))">
                    <MudIcon Icon="@(open ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)" Size="Size.Small" aria-hidden="true" />
                    @Loc.Plural("PkgBrowseAddOns", "count", family.AddOns.Count)
                    @if (!open)
                    {
                        <span class="lib-addons-names">@string.Join(" · ", family.AddOns.Select(AddOnName))</span>
                    }
                </button>
                @if (open)
                {
                    <div class="lib-addons">
                        @foreach (var addOn in family.AddOns)
                        {
                            <div @key="addOn.Path">@LibraryRow(addOn)</div>
                        }
                    </div>
                }
            }
        </div>
    };

    private RenderFragment LibraryRow(PackageRepoEntry entry) => __builder =>
    {
        <LibraryPackageRow Entry="@entry" SnapshotUrl="@_snapshot?.Url"
                           Installed="@(entry.PackageId is { } id && _installed.TryGetValue(id, out var record) ? record : null)"
                           InstalledPackages="@(_installedFailure is null ? _installed : null)"
                           Queued="@Queued(entry)" Version="@SelectedVersion(entry)"
                           VersionChanged="@(v => SelectVersion(entry, v))"
                           OnQueue="@(() => QueueInstall(entry))"
                           OnUnqueue="@(() => Unqueue(entry))"
                           OnReview="@(() => GoToReview(entry))"
                           OnReadme="@(() => ShowReadmeAsync(entry))" />
    };

    /// <summary>
    /// The graph of the packages <paramref name="shown"/> lists, with every package they need: from this remote when
    /// it lists it, else as installed, queued, or not in this source.
    /// </summary>
    private (IReadOnlyList<PackageDependencyGraph.Node>, IReadOnlyList<PackageDependencyGraph.Edge>) Graph(IReadOnlyList<PackageLibraryGroup> shown)
    {
        var listed = (_snapshot?.Packages ?? []).Where(e => e.PackageId is not null)
            .DistinctBy(e => e.PackageId, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(e => e.PackageId!, StringComparer.OrdinalIgnoreCase);
        var edges = listed.Values
            .SelectMany(e => (e.DependsOn ?? []).Select(d => new PackageDependencyGraph.Edge(e.PackageId!, d)))
            .ToList();
        var matched = shown.SelectMany(g => g.Subcategories).SelectMany(s => s.Families)
            .SelectMany(f => f.AddOns.Prepend(f.Package))
            .Select(e => e.PackageId).OfType<string>();
        var nodes = PackageDependencyGraph.WithDependencies(matched, edges)
            .Select(id => listed.GetValueOrDefault(id) is { } entry
                ? new PackageDependencyGraph.Node(entry.PackageId!, PackageLibraryGroups.Name(entry), GraphState(entry.PackageId!, listed: true), entry.Bridge)
                : new PackageDependencyGraph.Node(id, id, GraphState(id, listed: false)))
            .ToList();
        return (nodes, edges);
    }

    private PackageGraphState GraphState(string id, bool listed)
        => Queued(id) is not null ? PackageGraphState.Queued
            : _installed.ContainsKey(id) ? PackageGraphState.Installed
            : listed ? PackageGraphState.Available
            : PackageGraphState.Missing;

    private void Unqueue(PackageRepoEntry entry)
    {
        if (Queued(entry)?.ClientIntentId is { } id) Packages.Batch.Remove(id);
    }

    private IReadOnlyList<PackageLibraryGroup> Groups() => PackageLibraryGroups.For(
        (_snapshot?.Packages ?? []).Where(e => (_kind == PackageContents.None || e.Contents.HasFlag(_kind))
            && PackageLibraryGroups.Matches(e, _search)).ToList(),
        Loc["AdmSetupPkgGroupUncategorized"]);

    /// <summary>An add-on's name in its family's summary line: its title past the base's, as "+help topics" for "Fate sheet: +help topics".</summary>
    private static string AddOnName(PackageRepoEntry addOn)
        => PackageLibraryGroups.Name(addOn) is var name && name.IndexOf(": ", StringComparison.Ordinal) is var colon and > 0
            ? name[(colon + 2)..]
            : name;

    private bool Expanded(PackageLibraryFamily family)
        => !string.IsNullOrWhiteSpace(_search) || _kind != PackageContents.None || _expanded.Contains(family.Package.Path);

    private void Toggle(PackageLibraryFamily family)
    {
        if (!_expanded.Remove(family.Package.Path)) _expanded.Add(family.Package.Path);
    }

    private PackageBatchIntent? Queued(PackageRepoEntry entry) => entry.PackageId is { } id ? Queued(id) : null;

    private async Task SelectVersion(PackageRepoEntry entry, string version)
    {
        _selectedVersions[entry.Path] = version;
        if (Queued(entry) is not null) await QueueInstall(entry);
    }

    protected override void OnInitialized() => Packages.Batch.Changed += OnBatchChanged;
    private void OnBatchChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Packages.Batch.Changed -= OnBatchChanged;

    protected override async Task OnInitializedAsync()
    {
        _remotes = await Packages.GetRemotesAsync() is IReadOnlyList<PackageRemoteRecord> remotes ? remotes : [];

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var preset = query["remote"];
        if (!string.IsNullOrEmpty(preset) && _remotes.Any(r => r.Name == preset))
        {
            _selectedRemote = preset;
            await BrowseAsync();
        }
        else if (_remotes.Count == 1)
        {
            _selectedRemote = _remotes[0].Name;
        }
    }

    private string SelectedVersion(PackageRepoEntry entry) =>
        _selectedVersions.GetValueOrDefault(entry.Path)
        ?? entry.Versions.FirstOrDefault()?.Version
        ?? DevChannel;

    private async Task BrowseAsync()
    {
        _busy = true;
        _snapshot = null;
        _catalogue = null;
        _installed = new Dictionary<string, InstalledPackageRecord>();
        _installedFailure = null;
        try
        {
            _remoteRecord = (_remotes ?? []).FirstOrDefault(r => r.Name == _selectedRemote);
            var browse = Packages.BrowseAsync(_selectedRemote);
            var installed = Packages.GetInstalledAsync();
            await Task.WhenAll(browse, installed);
            switch (await installed)
            {
                case IReadOnlyList<InstalledPackageDto> packages:
                    _installed = packages.ToDictionary(p => p.Package.Id, p => p.Package, StringComparer.Ordinal);
                    break;
                case ApiFailure failure:
                    _installedFailure = failure;
                    break;
            }
            switch (await browse)
            {
                case PackageRepoSnapshot snapshot:
                    _snapshot = snapshot;
                    break;
                case ApiFailure failure:
                    Snackbar.Add(failure.Message, Severity.Error);
                    return;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private Task ShowReadmeAsync(PackageRepoEntry entry)
        => _readme?.ShowAsync(entry.PackageId ?? entry.Path, () => Packages.GetRemoteReadmeAsync(_selectedRemote, entry.Path))
            ?? Task.CompletedTask;

    private async Task QueueInstall(PackageRepoEntry entry)
    {
        if (entry.PackageId is null) return;
        if (entry.Bridge && _installedFailure is null)
            await QueueMissingDependenciesAsync(entry, entry.PackageId, new HashSet<string>(StringComparer.OrdinalIgnoreCase) { entry.PackageId });
        Packages.Batch.Queue(new(entry.PackageId, PackageBatchAction.Install, Source(_selectedRemote, entry)));
    }

    /// <summary>
    /// Queues what a bridge joins, and what those need in turn, that is neither installed nor queued: from this remote
    /// when it lists the package, otherwise from the bundled catalogue. Dependencies are queued before what needs them.
    /// </summary>
    private async Task QueueMissingDependenciesAsync(PackageRepoEntry entry, string bridge, HashSet<string> seen)
    {
        foreach (var id in entry.DependsOn ?? [])
        {
            if (!seen.Add(id) || _installed.ContainsKey(id) || Queued(id) is not null) continue;
            if (await FindDependencyAsync(id) is not ({ } remote, { } dependency)) continue;
            await QueueMissingDependenciesAsync(dependency, bridge, seen);
            Packages.Batch.Queue(new(id, PackageBatchAction.Install, Source(remote, dependency)), Loc["PkgBatchNeededBy", bridge]);
        }
    }

    private async Task<(string? Remote, PackageRepoEntry? Entry)> FindDependencyAsync(string id)
    {
        if (_snapshot?.Packages.FirstOrDefault(e => Same(e.PackageId, id)) is { } here) return (_selectedRemote, here);
        if (BundledPackageSource.IsCatalogueRemote(_selectedRemote)) return (null, null);
        _catalogue ??= await Packages.BrowseAsync(BundledPackageSource.RemoteName) is PackageRepoSnapshot catalogue ? catalogue : null;
        return _catalogue?.Packages.FirstOrDefault(e => Same(e.PackageId, id)) is { } bundled
            ? (BundledPackageSource.RemoteName, bundled)
            : (null, null);
    }

    private PackageBatchSource Source(string remote, PackageRepoEntry entry)
    {
        var version = remote == _selectedRemote ? SelectedVersion(entry) : entry.Versions.FirstOrDefault()?.Version ?? DevChannel;
        return new(remote, entry.Path, version == DevChannel ? null : version);
    }

    private PackageBatchIntent? Queued(string id)
        => Packages.Batch.Intents.FirstOrDefault(i => i.Action == PackageBatchAction.Install && Same(i.TargetId, id));

    private static bool Same(string? a, string? b) => string.Equals(a, b, StringComparison.OrdinalIgnoreCase);

    private void GoToReview(PackageRepoEntry entry)
    {
        var version = SelectedVersion(entry);
        var versionPart = version == DevChannel ? "" : $"&version={Uri.EscapeDataString(version)}";
        Nav.NavigateTo(
            $"/admin/packages/review?remote={Uri.EscapeDataString(_selectedRemote)}&path={Uri.EscapeDataString(entry.Path)}{versionPart}");
    }
}
