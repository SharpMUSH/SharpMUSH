@using SharpMUSH.Library.Models.Packages
@inject IStringLocalizer<SharedResource> Loc

@* A plugin: its name, what it does and whether it is running, any change waiting on a restart and why it failed;
   the id, version, origin and what it adds wait under Details. On/off stays on the row; the README is in its menu. *@
<PackageRow Icon="@Icons.Material.Outlined.Extension" Kind="plugin" Name="@Plugin.Name" Description="@Plugin.Description"
            Id="@(string.Equals(Plugin.Name, Plugin.Id, StringComparison.Ordinal) ? null : Plugin.Id)">
    <Status>
        <MudChip T="string" Size="Size.Small" Color="@StatusColor(Plugin.Status)">@StatusLabel(Plugin.Status)</MudChip>
        @if (Plugin.Pending != PluginPendingChange.None)
        {
            <Pill Tag="true" Warn="true">
                @(Plugin.Pending == PluginPendingChange.Starts ? Loc["PkgPluginStartsAtRestart"] : Loc["PkgPluginStopsAtRestartShort"])
            </Pill>
        }
    </Status>
    <Notes>
        @if (Plugin.Reason is not null)
        {
            <span class="pkg-row-reason">@Plugin.Reason</span>
        }
    </Notes>
    <Tags>
        @if (Plugin.Version is not null)
        {
            <Pill Tag="true">v@(Plugin.Version)</Pill>
        }
        <Pill Tag="true">@OriginLabel(Plugin)</Pill>
    </Tags>
    <Meta>
        @if (Plugin.Status == PluginBootStatus.Loaded)
        {
            <span>@Loc["PkgPluginAdds", Plugin.Commands, Plugin.Functions]</span>
        }
        @if (Plugin.Dependents.Count > 0)
        {
            <span>@Loc["PkgRequiredBy", string.Join(", ", Plugin.Dependents)]</span>
        }
    </Meta>
    <Actions>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="@Busy"
                   aria-label="@Loc[Plugin.Enabled ? "PkgPluginTurnOffNamed" : "PkgPluginTurnOnNamed", Plugin.Name]"
                   OnClick="@OnToggle">
            @(Plugin.Enabled ? Loc["PkgPluginTurnOff"] : Loc["PkgPluginTurnOn"])
        </MudButton>
        @if (Plugin.Package is { } package)
        {
            <RowMenu Label="@Loc["NavRowMore", Plugin.Name]">
                <RowMenuItem Icon="@Icons.Material.Outlined.Description" OnClick="@(() => OnReadme.InvokeAsync(package))">@Loc["PkgShowReadme", Plugin.Name]</RowMenuItem>
            </RowMenu>
        }
    </Actions>
</PackageRow>

@code {
    [Parameter, EditorRequired] public PluginStatusDto Plugin { get; set; } = null!;

    /// <summary>Whether a request or a restart is under way; the toggle waits for it.</summary>
    [Parameter] public bool Busy { get; set; }

    /// <summary>Shows the README of the package the plugin came from, given that package's id.</summary>
    [Parameter] public EventCallback<string> OnReadme { get; set; }

    /// <summary>Turns the plugin the other way.</summary>
    [Parameter] public EventCallback OnToggle { get; set; }

    private string OriginLabel(PluginStatusDto plugin) => plugin switch
    {
        { Origin: PluginOrigin.BuiltIn } => Loc["PkgPluginShipped"],
        { Package: { } package } => Loc["PkgPluginFromPackage", package],
        _ => Loc["PkgPluginFromFolder"]
    };

    private string StatusLabel(PluginBootStatus status) => status switch
    {
        PluginBootStatus.Loaded => Loc["PkgPluginRunning"],
        PluginBootStatus.Disabled => Loc["PkgPluginOff"],
        PluginBootStatus.Failed => Loc["PkgPluginFailed"],
        PluginBootStatus.Incompatible => Loc["PkgPluginIncompatible"],
        PluginBootStatus.Duplicate => Loc["PkgPluginDuplicate"],
        _ => Loc["PkgPluginNotStarted"]
    };

    private static Color StatusColor(PluginBootStatus status) => status switch
    {
        PluginBootStatus.Loaded => Color.Success,
        PluginBootStatus.Failed or PluginBootStatus.Incompatible or PluginBootStatus.Duplicate => Color.Error,
        _ => Color.Default
    };
}
