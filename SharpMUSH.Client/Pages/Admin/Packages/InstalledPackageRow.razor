@using SharpMUSH.Library.Models.Packages
@inject IStringLocalizer<SharedResource> Loc

@* An installed package: its name, what it does and whether it needs an update, with the version, source and counts
   under Details. The check action stays on the row; README, history and uninstall are in the row's menu. *@
<PackageRow Icon="@PackageKinds.Icon(Main)" Kind="@Main.ToString().ToLowerInvariant()" Bridge="@Package.Bridge"
            IconTitle="@(Package.Bridge ? Loc["PkgKindBridgeOf", PackageKinds.Name(Main, Loc)] : PackageKinds.Name(Main, Loc))" Name="@(Package.Title ?? Package.Package.Id)"
            Id="@(Package.Title is null ? null : Package.Package.Id)" Description="@Package.Description">
    <Status>
        @if (Package.Package.PastMaximum is { } past)
        {
            <span title="@Loc["PkgPastMaximumTooltip", past.Server, past.Maximum, past.At.ToString("yyyy-MM-dd")]">
                <Pill Tag="true" Warn="true">@Loc["PkgPastMaximumChip", past.Maximum]</Pill>
            </span>
        }
        @if (Update is not null)
        {
            @if (Update.InstalledTagMoved)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Error">@Loc["PkgTagMoved"]</MudChip>
            }
            else if (Update.UpdateAvailable)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Success">@Loc["PkgVersionAvailable", Update.LatestVersion ?? string.Empty]</MudChip>
            }
            else
            {
                <Pill Tag="true">@Loc["PkgCurrent"]</Pill>
            }
            @if (Update.PathChangedAtHead)
            {
                <Pill Tag="true" Warn="true">@Loc["PkgDevDrift"]</Pill>
            }
        }
    </Status>
    <Tags>
        <Pill Tag="true">v@(Package.Package.Version)</Pill>
        <PackageKindTags Contents="@Contents" Bridge="@Package.Bridge" />
        @if (!string.IsNullOrEmpty(Package.Package.SourceRepo))
        {
            <Pill Tag="true">@Package.Package.SourceRepo</Pill>
        }
    </Tags>
    <Meta>
        <span>@Loc["PkgInstalledOn", Package.Package.InstalledAt.ToString("yyyy-MM-dd")]</span>
        <span>@Loc["PkgObjAttrCounts", Package.ObjectCount, Package.ManagedAttributeCount]</span>
        @if (Package.Dependents.Count > 0)
        {
            <span>@Loc["PkgRequiredBy", string.Join(", ", Package.Dependents)]</span>
        }
    </Meta>
    <Actions>
        @if (Update is null)
        {
            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                       Disabled="@Busy"
                       OnClick="@OnCheck">
                @Loc["PkgCheck"]
            </MudButton>
        }
        <RowMenu Label="@Loc["NavRowMore", Package.Title ?? Package.Package.Id]" Disabled="@Busy">
            <RowMenuItem Icon="@Icons.Material.Outlined.Description" OnClick="@OnReadme">@Loc["PkgShowReadme", Package.Title ?? Package.Package.Id]</RowMenuItem>
            <RowMenuItem Icon="@Icons.Material.Outlined.History" OnClick="@OnHistory">@Loc["PkgRevisionHistory"]</RowMenuItem>
            <RowMenuItem Danger="true" Icon="@Icons.Material.Outlined.Delete" OnClick="@OnUninstall">@Loc["PkgUninstall"]</RowMenuItem>
        </RowMenu>
    </Actions>
</PackageRow>

@code {
    [Parameter, EditorRequired] public InstalledPackageDto Package { get; set; } = null!;

    /// <summary>The package's last update check; null until one is made.</summary>
    [Parameter] public PackageUpdateInfo? Update { get; set; }

    [Parameter] public bool Busy { get; set; }

    [Parameter] public EventCallback OnCheck { get; set; }
    [Parameter] public EventCallback OnReadme { get; set; }
    [Parameter] public EventCallback OnHistory { get; set; }
    [Parameter] public EventCallback OnUninstall { get; set; }

    private PackageContents Contents => PackageKinds.Of(Package.Package.Kind, Package.ObjectCount, Package.ManagedAttributeCount, Package.WikiPageCount);
    private PackageContents Main => PackageKinds.Primary(Contents);
}
