@page "/admin/packages"
@attribute [Authorize(Policy = "packages.admin")]
@using SharpMUSH.Client.Services
@using SharpMUSH.Library.API
@using SharpMUSH.Library.Models.Packages
@inject PackagesAdminService Packages
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["PkgPackages"] — @Loc["PkgAdminSection"] — @Loc["AppTitle"]</PageTitle>

<div class="pkg-page" style="padding:var(--cpad);">
    <div style="display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap;margin-bottom:0.25rem;">
        <MudText Typo="Typo.h4" Style="font-weight:700;">@Loc["PkgSoftcodePackages"]</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.TravelExplore"
                   Href="/admin/packages/browse">@Loc["PkgBrowse"]</MudButton>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Cloud"
                   Href="/admin/packages/remotes">@Loc["PkgRemotes"]</MudButton>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Edit"
                   Href="/admin/packages/author">@Loc["PkgAuthor"]</MudButton>
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small"
                       OnClick="ReloadAsync" Disabled="_busy" />
    </div>
    <MudText Style="color:var(--text-dim);font-size:0.875rem;margin-bottom:1.25rem;">
        @Loc["PkgInstalledDescription"]
    </MudText>

    <div class="pkg-stat-grid" style="display:grid;grid-template-columns:repeat(4,1fr);gap:0.75rem;margin-bottom:1.25rem;">
        @{
            var updatesAvailable = _installed is not null ? _installed.Count(p => _updates.TryGetValue(p.Package.Id, out var u) && u.UpdateAvailable) : 0;
        }
        @foreach (var tile in new[]
        {
            (_installed?.Count.ToString() ?? "—",         "PkgInstalled",        Icons.Material.Filled.Archive,      "var(--accent)"),
            (updatesAvailable.ToString(),                  "PkgUpdatesAvailable", Icons.Material.Filled.SystemUpdate, "#6cde9a"),
            ("—",                                         "PkgRemotes",          Icons.Material.Filled.Cloud,        "#5aa9ff"),
            (_installed?.Sum(p => p.ObjectCount).ToString() ?? "—", "PkgObjects", Icons.Material.Filled.DataObject,   "#b39cff"),
        })
        {
            var (val, labelKey, icon, color) = tile;
            <MudPaper Elevation="0" Style="@($"padding:1rem 1.125rem;border-radius:var(--radius);border:1px solid var(--border);background:var(--surface);")">
                <div style="display:flex;align-items:center;gap:0.75rem;">
                    <MudIcon Icon="@icon" Style="@($"color:{color};font-size:1.375rem;")" />
                    <div>
                        <MudText Style="@($"font-size:1.375rem;font-weight:700;color:{color};line-height:1.1;")">
                            @(_installed is null ? "—" : val)
                        </MudText>
                        <MudText Class="section-kicker" Style="opacity:0.7;">@Loc[labelKey]</MudText>
                    </div>
                </div>
            </MudPaper>
        }
    </div>

    @if (_installed is not null)
    {
        var installedCount = _installed.Count;
        var updateCount = _installed.Count(p => _updates.TryGetValue(p.Package.Id, out var u) && u.UpdateAvailable);
        <div class="pkg-tabs">
            <button class="pkg-tab @(_tab == PkgTab.Installed ? "active" : "")" @onclick="@(() => _tab = PkgTab.Installed)">
                @Loc["PkgInstalled"]
                <span class="pkg-tab-count">@installedCount</span>
            </button>
            <button class="pkg-tab @(_tab == PkgTab.Updates ? "active" : "")" @onclick="@(() => _tab = PkgTab.Updates)">
                @Loc["PkgUpdates"]
                <span class="pkg-tab-count">@updateCount</span>
            </button>
            <div style="flex:1;"></div>
            <div class="pkg-search">
                <MudIcon Icon="@Icons.Material.Filled.Search" Style="font-size:1rem;color:var(--text-faint);" />
                <input type="text" placeholder="@Loc["PkgSearchPlaceholder"]" value="@_search"
                       @oninput="@(e => _search = e.Value?.ToString() ?? string.Empty)" />
            </div>
        </div>
    }

    @if (_installed is null)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        @for (var i = 0; i < 4; i++) { <MudSkeleton Height="64px" Class="mb-2" /> }
    }
    else if (_installed.Count == 0)
    {
        <EmptyState>
            @Loc["PkgNoneInstalled"]
        </EmptyState>
    }
    else
    {
        var visible = FilteredPackages().ToList();
        if (visible.Count == 0)
        {
            <EmptyState>
                @(_tab == PkgTab.Updates ? Loc["PkgNoUpdatesAvailable"] : Loc["PkgNoSearchMatch"])
            </EmptyState>
        }
        <div style="display:flex;flex-direction:column;gap:0.5rem;">
            @foreach (var pkg in visible)
            {
                var p = pkg;
                _updates.TryGetValue(p.Package.Id, out var update);
                <MudPaper Elevation="0"
                          Style="display:flex;align-items:center;gap:1rem;padding:0.875rem 1.125rem;border-radius:var(--radius);border:1px solid var(--border);background:var(--surface);"
                          Class="pkg-row">
                    <MudIcon Icon="@Icons.Material.Filled.Archive"
                             Style="font-size:1.25rem;color:var(--accent);flex-shrink:0;" />
                    <div style="flex:1;min-width:0;">
                        <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;margin-bottom:0.125rem;">
                            <MudText Style="font-size:0.875rem;font-weight:600;">@p.Package.Id</MudText>
                            <MudChip T="string" Size="Size.Small"
                                     Style="height:18px;font-size:0.625rem;padding:0 0.3125rem;border:1px solid var(--border);">
                                v@p.Package.Version
                            </MudChip>
                            @if (!string.IsNullOrEmpty(p.Package.SourceRepo))
                            {
                                <MudChip T="string" Size="Size.Small"
                                         Style="height:18px;font-size:0.625rem;padding:0 0.3125rem;background:rgba(90,169,255,0.10);color:#5aa9ff;">
                                    @p.Package.SourceRepo
                                </MudChip>
                            }
                            @if (update is not null)
                            {
                                @if (update.InstalledTagMoved)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Error"
                                             Style="height:18px;font-size:0.625rem;padding:0 0.3125rem;">
                                        @Loc["PkgTagMoved"]
                                    </MudChip>
                                }
                                else if (update.UpdateAvailable)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success"
                                             Style="height:18px;font-size:0.625rem;padding:0 0.3125rem;">
                                        @Loc["PkgVersionAvailable", update.LatestVersion ?? string.Empty]
                                    </MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default"
                                             Style="height:18px;font-size:0.625rem;padding:0 0.3125rem;">
                                        @Loc["PkgCurrent"]
                                    </MudChip>
                                }
                                @if (update.PathChangedAtHead)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                             Style="height:18px;font-size:0.625rem;padding:0 0.3125rem;">
                                        @Loc["PkgDevDrift"]
                                    </MudChip>
                                }
                            }
                        </div>
                        <div style="display:flex;align-items:center;gap:0.75rem;">
                            <MudText Style="font-size:0.75rem;color:var(--text-faint);">
                                @Loc["PkgInstalledOn", p.Package.InstalledAt.ToString("yyyy-MM-dd")]
                            </MudText>
                            <MudText Style="font-size:0.75rem;color:var(--text-faint);">
                                @Loc["PkgObjAttrCounts", p.ObjectCount, p.ManagedAttributeCount]
                            </MudText>
                            @if (p.Dependents.Count > 0)
                            {
                                <MudText Style="font-size:0.75rem;color:var(--text-faint);">
                                    @Loc["PkgRequiredBy", string.Join(", ", p.Dependents)]
                                </MudText>
                            }
                        </div>
                    </div>
                    <div style="display:flex;align-items:center;gap:0.25rem;flex-shrink:0;">
                        @if (update is null)
                        {
                            <MudButton Variant="Variant.Text" Size="Size.Small"
                                       Disabled="@_busy"
                                       OnClick="@(() => CheckUpdateAsync(p.Package.Id))">
                                @Loc["PkgCheck"]
                            </MudButton>
                        }
                        <MudTooltip Text="@Loc["PkgRevisionHistory"]">
                            <MudIconButton Icon="@Icons.Material.Filled.History" Size="Size.Small"
                                           OnClick="@(() => OpenHistoryAsync(p.Package.Id))" />
                        </MudTooltip>
                        <MudTooltip Text="@Loc["PkgUninstall"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                           Color="Color.Error"
                                           OnClick="@(() => OpenUninstall(p))" />
                        </MudTooltip>
                    </div>
                </MudPaper>
            }
        </div>
    }
</div>

<MudDialog @bind-Visible="_showHistory" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent><MudText Typo="Typo.h6">@Loc["PkgRevisionsOf", _historyPackage ?? string.Empty]</MudText></TitleContent>
    <DialogContent>
        @if (_revisions is null)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            <MudList T="string" Dense="true">
                @foreach (var revision in _revisions)
                {
                    var rev = revision;
                    <MudListItem T="string">
                        <MudStack Row="true" AlignItems="AlignItems.Center">
                            <MudText Style="font-size:0.8125rem;">@Loc["PkgRevisionLine", rev.Revision, rev.Kind, rev.Version]</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @rev.AppliedAt.ToString("yyyy-MM-dd HH:mm")
                            </MudText>
                            <MudSpacer />
                            @if (revision.Revision != _revisions.Max(r => r.Revision))
                            {
                                <MudButton Size="Size.Small" Disabled="@_busy"
                                           OnClick="@(() => RollbackAsync(_historyPackage!, rev.Revision))">
                                    @Loc["PkgRollBack"]
                                </MudButton>
                            }
                        </MudStack>
                    </MudListItem>
                }
            </MudList>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showHistory = false)">@Loc["PkgClose"]</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_showUninstall">
    <TitleContent>
        <MudText Typo="Typo.h6">@Loc["PkgUninstallConfirmTitle", _uninstallTarget?.Package.Id ?? string.Empty]</MudText>
    </TitleContent>
    <DialogContent>
        <MudText>
            @Loc["PkgUninstallConfirmBody", _uninstallTarget?.ObjectCount ?? 0, _uninstallTarget?.ManagedAttributeCount ?? 0]
        </MudText>
        @if (_uninstallTarget?.Dependents.Count > 0)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-2">
                @Loc["PkgDependedOnBy", string.Join(", ", _uninstallTarget.Dependents)]
            </MudAlert>
            <MudCheckBox T="bool" @bind-Value="_forceUninstall" Label="@Loc["PkgForceRemoval"]" Color="Color.Error" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showUninstall = false)">@Loc["Cancel"]</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" Disabled="@_busy" OnClick="@UninstallAsync">
            @Loc["PkgUninstall"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private enum PkgTab { Installed, Updates }

    private IReadOnlyList<InstalledPackageDto>? _installed;
    private readonly Dictionary<string, PackageUpdateInfo> _updates = new();
    private bool _busy;

    private PkgTab _tab = PkgTab.Installed;
    private string _search = string.Empty;

    private IEnumerable<InstalledPackageDto> FilteredPackages()
    {
        if (_installed is null) return [];
        IEnumerable<InstalledPackageDto> rows = _installed;
        if (_tab == PkgTab.Updates)
            rows = rows.Where(p => _updates.TryGetValue(p.Package.Id, out var u) && u.UpdateAvailable);
        if (!string.IsNullOrWhiteSpace(_search))
            rows = rows.Where(p => p.Package.Id.Contains(_search, StringComparison.OrdinalIgnoreCase));
        return rows;
    }

    private bool _showHistory;
    private string? _historyPackage;
    private IReadOnlyList<RevisionDto>? _revisions;

    private bool _showUninstall;
    private InstalledPackageDto? _uninstallTarget;
    private bool _forceUninstall;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _installed = await Packages.GetInstalledAsync();
        StateHasChanged();
    }

    private async Task CheckUpdateAsync(string id)
    {
        _busy = true;
        try
        {
            var update = await Packages.CheckForUpdateAsync(id);
            if (update is null)
                Snackbar.Add(Loc["PkgUpdateCheckFailed"], Severity.Warning);
            else
            {
                _updates[id] = update;
                if (update.InstalledTagMoved)
                    Snackbar.Add(Loc["PkgTrustWarningTagMoved", id, update.InstalledVersion], Severity.Error);
            }
        }
        finally { _busy = false; }
    }

    private async Task OpenHistoryAsync(string id)
    {
        _historyPackage = id;
        _revisions = null;
        _showHistory = true;
        _revisions = await Packages.GetRevisionsAsync(id);
    }

    private async Task RollbackAsync(string id, int revision)
    {
        _busy = true;
        try
        {
            var (result, error) = await Packages.RollbackAsync(id, revision);
            if (error is not null)
            {
                Snackbar.Add(error, Severity.Error);
                return;
            }
            Snackbar.Add(Loc["PkgRolledBack", result!.RestoredFromRevision, result.Revision], Severity.Success);
            foreach (var note in result.Notes)
                Snackbar.Add(note, Severity.Info);
            _showHistory = false;
            _updates.Remove(id);
            await ReloadAsync();
        }
        finally { _busy = false; }
    }

    private void OpenUninstall(InstalledPackageDto target)
    {
        _uninstallTarget = target;
        _forceUninstall = false;
        _showUninstall = true;
    }

    private async Task UninstallAsync()
    {
        if (_uninstallTarget is null) return;
        _busy = true;
        try
        {
            var error = await Packages.UninstallAsync(_uninstallTarget.Package.Id, _forceUninstall);
            if (error is not null)
            {
                Snackbar.Add(error, Severity.Error);
                return;
            }
            Snackbar.Add(Loc["PkgUninstalled", _uninstallTarget.Package.Id], Severity.Success);
            _showUninstall = false;
            _updates.Remove(_uninstallTarget.Package.Id);
            await ReloadAsync();
        }
        finally { _busy = false; }
    }
}
