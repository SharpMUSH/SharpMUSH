@page "/admin/packages"
@attribute [Authorize(Policy = "packages.admin")]
@using SharpMUSH.Client.Models
@using SharpMUSH.Client.Services
@using SharpMUSH.Library.DiscriminatedUnions
@using SharpMUSH.Library.API
@using SharpMUSH.Library.Models.Packages
@inject PackagesAdminService Packages
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> Loc

<AdminPageTitle Page="@Loc["PkgPackages"]" />

<div class="page-stack page-stack--padded pkg-page">
    <PageHeader Kicker="@Loc["AdmGroupPortal"]" Title="@Loc["PkgSoftcodePackages"]" Description="@Loc["PkgInstalledDescription"]">
        <Actions>
            <CapsuleButton Icon="@Icons.Material.Outlined.TravelExplore" Href="/admin/packages/browse">@Loc["PkgBrowse"]</CapsuleButton>
            <CapsuleButton Icon="@Icons.Material.Outlined.Cloud" Href="/admin/packages/remotes">@Loc["PkgRemotes"]</CapsuleButton>
            <CapsuleButton Icon="@Icons.Material.Outlined.Edit" Href="/admin/packages/author">@Loc["PkgAuthor"]</CapsuleButton>
            @if (_plugins?.InstallAllowed == true)
            {
                <MudFileUpload T="IBrowserFile" Accept=".zip" FilesChanged="@UploadPluginAsync" MaximumFileCount="1"
                               MaxFileSize="@MaxPluginUploadBytes" Disabled="@_busy" Class="pkg-upload">
                    <CustomContent Context="upload">
                        <CapsuleButton Icon="@Icons.Material.Outlined.Extension" Disabled="@_busy"
                                       OnClick="@upload.OpenFilePickerAsync">@Loc["PkgUploadPlugin"]</CapsuleButton>
                    </CustomContent>
                </MudFileUpload>
            }
            <CapsuleButton Icon="@Icons.Material.Outlined.Refresh" AriaLabel="@Loc["Refresh"]" OnClick="ReloadAsync" Disabled="_busy" />
        </Actions>
    </PageHeader>

    @{
        var updatesAvailable = _installed?.Count(p => _updates.TryGetValue(p.Package.Id, out var u) && u.UpdateAvailable) ?? 0;
    }
    <AdminStats>
        <AdminStat Key="installed" Icon="@Icons.Material.Outlined.Archive" Label="@Loc["PkgInstalled"]"
                   Value="@(_installed?.Count.ToString() ?? "—")" />
        <AdminStat Key="updates" Icon="@Icons.Material.Outlined.SystemUpdate" Label="@Loc["PkgUpdatesAvailable"]"
                   Value="@(_installed is null ? "—" : updatesAvailable.ToString())" />
        <AdminStat Key="remotes" Icon="@Icons.Material.Outlined.Cloud" Label="@Loc["PkgRemotes"]"
                   Value="@(_remoteCount?.ToString() ?? "—")" />
        <AdminStat Key="objects" Icon="@Icons.Material.Outlined.DataObject" Label="@Loc["PkgObjects"]"
                   Value="@(_installed?.Sum(p => p.ObjectCount).ToString() ?? "—")" />
    </AdminStats>

    <KitCard>
        @if (_installed is not null || _installedFailure is not null || _plugins is not null)
        {
            <div class="pkg-tabs">
                <button type="button" class="pkg-tab @(_tab == PkgTab.Installed ? "active" : "")" aria-pressed="@(_tab == PkgTab.Installed ? "true" : "false")"
                        @onclick="@(() => _tab = PkgTab.Installed)">
                    @Loc["PkgInstalled"]
                    <span class="pkg-tab-count">@(_installed?.Count.ToString() ?? "—")</span>
                </button>
                <button type="button" class="pkg-tab @(_tab == PkgTab.Updates ? "active" : "")" aria-pressed="@(_tab == PkgTab.Updates ? "true" : "false")"
                        @onclick="@(() => _tab = PkgTab.Updates)">
                    @Loc["PkgUpdates"]
                    <span class="pkg-tab-count">@(_installed is null ? "—" : updatesAvailable.ToString())</span>
                </button>
                <button type="button" class="pkg-tab @(_tab == PkgTab.Plugins ? "active" : "")" aria-pressed="@(_tab == PkgTab.Plugins ? "true" : "false")"
                        @onclick="@(() => _tab = PkgTab.Plugins)">
                    @Loc["PkgPlugins"]
                    <span class="pkg-tab-count">@(_plugins?.Plugins.Count.ToString() ?? "—")</span>
                </button>
                <button type="button" class="pkg-tab @(_tab == PkgTab.Dependencies ? "active" : "")" aria-pressed="@(_tab == PkgTab.Dependencies ? "true" : "false")"
                        @onclick="@(() => _tab = PkgTab.Dependencies)">
                    @Loc["PkgDependencies"]
                </button>
                <div class="pkg-tabs-spacer"></div>
                <div class="pkg-search">
                    <MudIcon Icon="@Icons.Material.Outlined.Search" Class="pkg-search-icon" />
                    <input name="package-search" type="text" placeholder="@Loc["PkgSearchPlaceholder"]" aria-label="@Loc["PkgSearchPlaceholder"]" value="@_search"
                           @oninput="@(e => _search = e.Value?.ToString() ?? string.Empty)" />
                </div>
            </div>
        }

        <div class="pkg-body">
            @if (_tab == PkgTab.Plugins)
            {
                @PluginList
            }
            else if (_installedFailure is not null)
            {
                <MudAlert Severity="Severity.Error" Class="pkg-installed-error" role="alert">@_installedFailure.Message</MudAlert>
                <CapsuleButton Class="pkg-installed-retry" OnClick="ReloadAsync" Icon="@Icons.Material.Outlined.Refresh">@Loc["Refresh"]</CapsuleButton>
            }
            else if (_installed is null)
            {
                <SkeletonRows Count="4" Height="64" Gap="8" />
            }
            else if (_tab == PkgTab.Dependencies)
            {
                var (nodes, edges) = Graph();
                <PackageGraph Nodes="@nodes" Edges="@edges" />
            }
            else if (_installed.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Outlined.Inventory2">
                    <ChildContent>@Loc["PkgNoneInstalled"]</ChildContent>
                    <Action><CapsuleButton Primary="true" Icon="@Icons.Material.Outlined.Search" Href="/admin/packages/browse">@Loc["PkgBrowse"]</CapsuleButton></Action>
                </EmptyState>
            }
            else
            {
                var visible = FilteredPackages().ToList();
                if (visible.Count == 0)
                {
                    <EmptyState Icon="@(_tab == PkgTab.Updates ? Icons.Material.Outlined.CheckCircle : Icons.Material.Outlined.SearchOff)">
                        @(_tab == PkgTab.Updates ? Loc["PkgNoUpdatesAvailable"] : Loc["PkgNoSearchMatch"])
                    </EmptyState>
                }
                <div class="pkg-rows">
                    @foreach (var p in visible)
                    {
                        _updates.TryGetValue(p.Package.Id, out var update);
                        <InstalledPackageRow Package="p" Update="update" Busy="_busy"
                                             OnCheck="@(() => CheckUpdateAsync(p.Package.Id))"
                                             OnReadme="@(() => ShowReadmeAsync(p.Title ?? p.Package.Id, p.Package.Id))"
                                             OnHistory="@(() => OpenHistoryAsync(p.Package.Id))"
                                             OnUninstall="@(() => OpenUninstall(p))" />
                    }
                </div>
            }
        </div>
    </KitCard>
    <PackageBatchQueue />
</div>

<PackageReadmeDialog @ref="_readme" />

<MudDialog @bind-Visible="_showHistory" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent><MudText Typo="Typo.h6">@Loc["PkgRevisionsOf", _historyPackage ?? string.Empty]</MudText></TitleContent>
    <DialogContent>
        @if (_revisions is null)
        {
            <SkeletonRows Count="4" Height="40" Gap="4" />
        }
        else
        {
            <MudList T="string" Dense="true">
                @foreach (var revision in _revisions)
                {
                    var rev = revision;
                    <MudListItem T="string">
                        <MudStack Row="true" AlignItems="AlignItems.Center">
                            <MudText Style="font-size:var(--text-sm);">@Loc["PkgRevisionLine", rev.Revision, KindLabel(rev.Kind), rev.Version]</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @rev.AppliedAt.ToString("yyyy-MM-dd HH:mm")
                            </MudText>
                            <MudSpacer />
                            @if (revision.Revision != _revisions.Max(r => r.Revision))
                            {
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="@_busy"
                                           OnClick="@(() => RollbackAsync(_historyPackage!, rev.Revision))">
                                    @Loc["PkgRollBack"]
                                </MudButton>
                            }
                        </MudStack>
                    </MudListItem>
                }
            </MudList>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="@(() => _showHistory = false)">@Loc["PkgClose"]</MudButton>
    </DialogActions>
</MudDialog>

<ConfirmDialog @bind-Visible="_showUninstall" Title="@Loc["PkgUninstallConfirmTitle", _uninstallTarget?.Package.Id ?? string.Empty]"
               ConfirmText="@Loc["PkgUninstall"]" Busy="_busy" OnConfirm="UninstallAsync">
    <MudText>
        @Loc.Plural("PkgUninstallConfirmBody", "objects", _uninstallTarget?.ObjectCount ?? 0, "attributes", _uninstallTarget?.ManagedAttributeCount ?? 0)
    </MudText>
    @if (_uninstallTarget?.Dependents.Count > 0)
    {
        <MudAlert Severity="Severity.Warning" Class="mt-2">
            @Loc["PkgDependedOnBy", string.Join(", ", _uninstallTarget.Dependents)]
        </MudAlert>

    }
</ConfirmDialog>

<ConfirmDialog @bind-Visible="_showRestart" Title="@Loc["PkgRestartTitle"]" ConfirmText="@Loc["PkgRestart"]"
               Busy="_busy" OnConfirm="RestartAsync">
    <MudText>@Loc["PkgRestartBody"]</MudText>
</ConfirmDialog>

@code {
    private enum PkgTab { Installed, Updates, Plugins, Dependencies }

    /// <summary>The largest plugin upload the server accepts (<c>PluginUploadStore.MaxUploadBytes</c>).</summary>
    private const long MaxPluginUploadBytes = 20 * 1024 * 1024;

    private PluginsResponse? _plugins;

    private bool _showRestart;
    private bool _restarting;

    private RenderFragment PluginList => __builder =>
    {
        if (_plugins is null)
        {
            <EmptyState Failed="true">@Loc["PkgPluginsUnavailable"]</EmptyState>
        }
        else if (_restarting)
        {
            <MudAlert Severity="Severity.Info" Class="mb-2">@Loc["PkgRestarting"]</MudAlert>
        }
        else if (_plugins.RestartPending)
        {
            <MudAlert Severity="Severity.Info" Class="mb-2">
                <div class="pkg-restart-banner">
                    <span>@Loc["PkgRestartPending"]</span>
                    <AuthorizeView Policy="server.operate" Context="serverOperator">
                        <Authorized>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.RestartAlt"
                                       Disabled="@_busy" OnClick="@(() => _showRestart = true)">@Loc["PkgRestart"]</MudButton>
                        </Authorized>
                    </AuthorizeView>
                </div>
            </MudAlert>
        }

        if (_plugins is { Plugins.Count: 0 })
        {
            <EmptyState Icon="@Icons.Material.Outlined.Extension">@Loc["PkgNoPlugins"]</EmptyState>
        }
        else if (_plugins is not null)
        {
        <div class="pkg-rows">
            @foreach (var plugin in _plugins.Plugins)
            {
                var pl = plugin;
                <PluginRow Plugin="pl" Busy="@(_busy || _restarting)" OnToggle="@(() => TogglePluginAsync(pl, !pl.Enabled))"
                           OnReadme="@(package => ShowReadmeAsync(pl.Name, package))" />
            }
        </div>
        }
    };

    private IReadOnlyList<InstalledPackageDto>? _installed;

    /// <summary>How many remotes are configured; null until read, or when the read failed.</summary>
    private int? _remoteCount;
    private readonly Dictionary<string, PackageUpdateInfo> _updates = new();
    private bool _busy;

    private PkgTab _tab = PkgTab.Installed;
    private string _search = string.Empty;

    private IEnumerable<InstalledPackageDto> FilteredPackages()
    {
        if (_installed is null) return [];
        IEnumerable<InstalledPackageDto> rows = _installed;
        if (_tab == PkgTab.Updates)
            rows = rows.Where(p => _updates.TryGetValue(p.Package.Id, out var u) && u.UpdateAvailable);
        if (!string.IsNullOrWhiteSpace(_search))
            rows = rows.Where(p => p.Package.Id.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || p.Title?.Contains(_search, StringComparison.OrdinalIgnoreCase) == true);
        // Listed by what each row is called, its title where it has one.
        return rows.OrderBy(p => p.Title ?? p.Package.Id, StringComparer.CurrentCultureIgnoreCase);
    }

    /// <summary>The installed packages the search finds, with every installed package they need.</summary>
    private (IReadOnlyList<PackageDependencyGraph.Node>, IReadOnlyList<PackageDependencyGraph.Edge>) Graph()
    {
        var installed = _installed ?? [];
        var edges = installed
            .SelectMany(p => p.Dependents.Select(d => new PackageDependencyGraph.Edge(d, p.Package.Id)))
            .ToList();
        var shown = PackageDependencyGraph.WithDependencies(FilteredPackages().Select(p => p.Package.Id), edges);
        var nodes = installed.Where(p => shown.Contains(p.Package.Id))
            .Select(p => new PackageDependencyGraph.Node(p.Package.Id, p.Title ?? p.Package.Id,
                Packages.Batch.Intents.Any(i => string.Equals(i.TargetId, p.Package.Id, StringComparison.OrdinalIgnoreCase))
                    ? PackageGraphState.Queued
                    : PackageGraphState.Installed,
                p.Bridge))
            .ToList();
        return (nodes, edges);
    }

    private PackageReadmeDialog? _readme;

    /// <summary>Opens the README the installed package <paramref name="id"/> was applied with, titled <paramref name="title"/>.</summary>
    private Task ShowReadmeAsync(string title, string id)
        => _readme?.ShowAsync(title, () => Packages.GetInstalledReadmeAsync(id)) ?? Task.CompletedTask;

    private bool _showHistory;
    private string? _historyPackage;
    private IReadOnlyList<RevisionDto>? _revisions;

    private bool _showUninstall;
    private InstalledPackageDto? _uninstallTarget;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private ApiFailure? _installedFailure;

    private async Task ReloadAsync()
    {
        _installedFailure = null;
        _installed = await Packages.GetInstalledAsync() switch
        {
            IReadOnlyList<InstalledPackageDto> packages => packages,
            ApiFailure failure => Failed(failure)
        };

        // The remotes tile used to read "—" whatever was configured: nothing ever asked. A failed read
        // leaves it at "—" without a snackbar; the installed list above is what the page is for.
        _remoteCount = await Packages.GetRemotesAsync() switch
        {
            IReadOnlyList<PackageRemoteRecord> remotes => remotes.Count,
            ApiFailure => null
        };

        await ReloadPluginsAsync();

        IReadOnlyList<InstalledPackageDto>? Failed(ApiFailure failure)
        {
            _installedFailure = failure;
            return null;
        }
    }

    private async Task CheckUpdateAsync(string id)
    {
        _busy = true;
        try
        {
            if (await Packages.CheckForUpdateAsync(id) is not PackageUpdateInfo update)
                Snackbar.Add(Loc["PkgUpdateCheckFailed"], Severity.Warning);
            else
            {
                _updates[id] = update;
                if (update.InstalledTagMoved)
                    Snackbar.Add(Loc["PkgTrustWarningTagMoved", id, update.InstalledVersion], Severity.Error);
            }
        }
        finally { _busy = false; }
    }

    private async Task OpenHistoryAsync(string id)
    {
        _historyPackage = id;
        _revisions = null;
        _showHistory = true;
        _revisions = await Packages.GetRevisionsAsync(id) switch
        {
            IReadOnlyList<RevisionDto> revisions => revisions,
            ApiFailure failure => RevisionsFailed(failure)
        };

        IReadOnlyList<RevisionDto> RevisionsFailed(ApiFailure failure)
        {
            Snackbar.Add(failure.Message, Severity.Error);
            return [];
        }
    }

    private async Task RollbackAsync(string id, int revision)
    {
        _busy = true;
        try
        {
            switch (await Packages.RollbackAsync(id, revision))
            {
                case ApiFailure failure:
                    Snackbar.Add(failure.Message, Severity.Error);
                    return;
                case PackageRollbackResult result:
                    Snackbar.Add(Loc["PkgRolledBack", result.RestoredFromRevision, result.Revision], Severity.Success);
                    foreach (var note in result.Notes)
                        Snackbar.Add(note, Severity.Info);
                    break;
            }
            _showHistory = false;
            _updates.Remove(id);
            await ReloadAsync();
        }
        finally { _busy = false; }
    }

    private void OpenUninstall(InstalledPackageDto target)
    {
        _uninstallTarget = target;
        _showUninstall = true;
    }

    private Task UninstallAsync()
    {
        if (_uninstallTarget is not { } target) return Task.CompletedTask;
        Packages.Batch.Queue(new(target.Package.Id, PackageBatchAction.Uninstall));
        Packages.Batch.ConfirmUninstall(target.Package.Id, target.Package.Version, target.Package.CurrentRevision);
        _showUninstall = false;
        Nav.NavigateTo("/admin/packages/batch");
        return Task.CompletedTask;
    }

    private async Task ReloadPluginsAsync() =>
        _plugins = await Packages.GetPluginsAsync() switch
        {
            PluginsResponse plugins => plugins,
            ApiFailure => null
        };

    private async Task TogglePluginAsync(PluginStatusDto plugin, bool on)
    {
        if (!on && plugin.Dependents.Count == 0 && Packages.Batch.Intents.Count == 0)
        {
            await SetPluginEnabledAsync(plugin, false);
            return;
        }
        Packages.Batch.Queue(new(plugin.Id, on ? PackageBatchAction.PluginOn : PackageBatchAction.PluginOff));
        Nav.NavigateTo("/admin/packages/batch");
    }

    private async Task SetPluginEnabledAsync(PluginStatusDto plugin, bool on)
    {
        _busy = true;
        try
        {
            switch (await Packages.SetPluginEnabledAsync(plugin.Id, on))
            {
                case ApiFailure failure:
                    Snackbar.Add(failure.Message, Severity.Error);
                    break;
                case PluginStateBlockers:
                    Packages.Batch.Queue(new(plugin.Id, on ? PackageBatchAction.PluginOn : PackageBatchAction.PluginOff));
                    Nav.NavigateTo("/admin/packages/batch");
                    break;
                case PluginChangeResponse change:
                    Snackbar.Add(on ? Loc["PkgPluginTurnedOn", change.Plugin.Name] : Loc["PkgPluginTurnedOff", change.Plugin.Name], Severity.Success);
                    foreach (var removed in change.RemovedPackages)
                        Snackbar.Add(Loc["PkgUninstalled", removed], Severity.Info);
                    foreach (var note in change.Notes)
                        Snackbar.Add(note, Severity.Info);
                    break;
            }

            await ReloadAsync();
        }
        finally { _busy = false; }
    }

    private async Task RestartAsync()
    {
        _busy = true;
        try
        {
            if (await Packages.RestartServerAsync() is ApiFailure failure)
            {
                Snackbar.Add(failure.Message, Severity.Error);
                return;
            }

            _showRestart = false;
            _restarting = true;
        }
        finally { _busy = false; }
    }

    private async Task UploadPluginAsync(IBrowserFile? file)
    {
        if (file is null) return;
        _busy = true;
        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: MaxPluginUploadBytes);
            switch (await Packages.UploadPluginAsync(stream, file.Name))
            {
                case ApiFailure failure:
                    Snackbar.Add(failure.Message, Severity.Error);
                    break;
                case PluginUploadResponse staged:
                    Nav.NavigateTo($"/admin/packages/review?remote={Uri.EscapeDataString(staged.Remote)}&path={Uri.EscapeDataString(staged.Path)}");
                    break;
            }
        }
        catch (IOException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally { _busy = false; }
    }

    // RevisionDto.Kind is the wire string, so a revision written by a newer server may name a kind this
    // build has no PackageRevisionKind member (and no label) for; show it verbatim rather than guessing.
    private string KindLabel(string kind) =>
        Enum.TryParse<PackageRevisionKind>(kind, ignoreCase: true, out var parsed)
            ? Loc[parsed.ResourceKey()]
            : kind;
}
