@page "/admin/characters"
@attribute [Authorize(Policy = "players.view")]
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["Characters"] — @Loc["AdmBreadcrumb"] — @Loc["AppTitle"]</PageTitle>

<div class="adm-soon">
    <PlainPageHeader Kicker="@Loc["AdmKicker"]" Title="@Loc["Characters"]" />

    <KitCard>
        <div class="adm-soon-empty">
            <MudIcon Icon="@Icons.Material.Filled.Person" Class="adm-soon-icon" />
            <div class="adm-soon-text">@Loc["AdmCharactersComingSoon"]</div>
        </div>
    </KitCard>
</div>
