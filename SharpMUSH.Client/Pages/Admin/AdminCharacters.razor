@page "/admin/characters"
@attribute [Authorize(Policy = "players.view")]
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["Characters"] — @Loc["AdmBreadcrumb"] — @Loc["AppTitle"]</PageTitle>

<div style="padding:var(--cpad);">
    <div class="ph-header">
        <div class="ph-kicker">@Loc["AdmKicker"]</div>
        <h1 class="ph-title">@Loc["Characters"]</h1>
    </div>

    <div class="ph-empty">
        <MudIcon Icon="@Icons.Material.Filled.Person" Class="ph-empty-icon" />
        <div class="ph-empty-text">@Loc["AdmCharactersComingSoon"]</div>
    </div>
</div>
