@page "/admin/accounts"
@attribute [Authorize(Roles = "Wizard,God")]
@using SharpMUSH.Library.DiscriminatedUnions
@inject AdminAccountsService AccountsService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["AdmAccountsTitle"] — @Loc["AdmBreadcrumb"] — @Loc["AppTitle"]</PageTitle>

<div class="page-stack page-stack--padded accounts-page">
    <PlainPageHeader Kicker="@Loc["AdmGroupPeople"]" Title="@Loc["AdmAccountsTitle"]" />

    <KitCard>
        <div class="accounts-body">
            <MudTextField T="string" @bind-Value="_search" Placeholder="@Loc["AdmAccountsSearchPlaceholder"]"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Immediate="true" DebounceInterval="300" OnDebounceIntervalElapsed="OnSearchDebouncedAsync" />

            <LoadState Value="_rows" Loading="_loading" Context="rows">
                <MudTable Items="rows" Dense="true" Hover="true" Elevation="0" Class="accounts-table">
                    <HeaderContent>
                        <MudTh>@Loc["AdmUsername"]</MudTh>
                        <MudTh>@Loc["AdmEmail"]</MudTh>
                        <MudTh>@Loc["AdmStatus"]</MudTh>
                        <MudTh>@Loc["Characters"]</MudTh>
                        <MudTh />
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd data-label="@Loc["AdmUsername"]">@context.Username</MudTd>
                        <MudTd data-label="@Loc["AdmEmail"]">@(context.Email ?? "—")</MudTd>
                        <MudTd data-label="@Loc["AdmStatus"]">
                            <MudChip T="string" Color="@StatusColor(context.Status)" Size="Size.Small">
                                @Loc[$"AdmAccountStatus{context.Status}"]
                            </MudChip>
                            @if (context.MustChangePassword)
                            {
                                <MudChip T="string" Color="Color.Warning" Size="Size.Small">@Loc["AdmAccountMustChangePasswordChip"]</MudChip>
                            }
                        </MudTd>
                        <MudTd data-label="@Loc["Characters"]">
                            @foreach (var character in context.Characters)
                            {
                                @* God (#1) never leaves its account, so its chip has no unlink. *@
                                @if (character.DbrefNumber == 1)
                                {
                                    <MudChip T="string" Size="Size.Small">@character.Name (#@character.DbrefNumber)</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small"
                                             OnClose="@(() => UnlinkAsync(context, character))">
                                        @character.Name (#@character.DbrefNumber)
                                    </MudChip>
                                }
                            }
                        </MudTd>
                        <MudTd>
                            <MudButton Size="Size.Small" OnClick="@(() => OpenResetAsync(context))">@Loc["AdmResetPassword"]</MudButton>
                            @if (!context.IsReserved)
                            {
                                @foreach (var target in StatusTargets(context))
                                {
                                    <MudButton Size="Size.Small" data-testid="account-status-action"
                                               Color="@(target == "Active" ? Color.Success : Color.Error)"
                                               OnClick="@(() => SetStatusAsync(context, target))">
                                        @Loc[$"AdmAccountAction{target}"]
                                    </MudButton>
                                }
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </LoadState>
        </div>
    </KitCard>
</div>

@code {
    private IReadOnlyList<AdminAccountsService.AdminAccountRow> _rows = [];
    private string _search = string.Empty;
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task OnSearchDebouncedAsync(string _) => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _rows = await AccountsService.ListAsync(_search) switch
        {
            IReadOnlyList<AdminAccountsService.AdminAccountRow> rows => rows,
            ApiFailure failure => Failed(failure)
        };
        _loading = false;
        StateHasChanged();

        IReadOnlyList<AdminAccountsService.AdminAccountRow> Failed(ApiFailure failure)
        {
            Snackbar.Add(failure.Message, Severity.Error);
            return [];
        }
    }

    /// <summary>
    /// Reports the outcome and reloads. The failure carries the server's own refusal text, which is
    /// what the operator needs — "you are not signed in" and "the server is down" used to arrive as
    /// the same generic line.
    /// </summary>
    private async Task ReportAsync(ApiResult<Success> result, string succeeded, string failed,
        Severity successSeverity = Severity.Success, Action<SnackbarOptions>? configure = null)
    {
        switch (result)
        {
            case Success:
                Snackbar.Add(succeeded, successSeverity, configure);
                break;
            case ApiFailure failure:
                Snackbar.Add(failure.Message is { Length: > 0 } detail ? detail : failed, Severity.Error);
                break;
        }

        await LoadAsync();
    }

    private static Color StatusColor(string status) => status switch
    {
        "Active" => Color.Success,
        "Disabled" => Color.Warning,
        _ => Color.Error
    };

    /// <summary>The statuses an account can be moved to. God's account can only ever be restored.</summary>
    private static string[] StatusTargets(AdminAccountsService.AdminAccountRow row) => row.Status switch
    {
        "Active" when row.IsGodsAccount => [],
        "Active" => ["Disabled", "Closed", "Deleted"],
        _ => ["Active"]
    };

    private async Task SetStatusAsync(AdminAccountsService.AdminAccountRow row, string target)
    {
        await ReportAsync(await AccountsService.SetStatusAsync(row.Id, target),
            Loc["AdmAccountStatusChanged", row.Username].Value,
            Loc["AdmOperationFailed"].Value);
    }

    private async Task UnlinkAsync(AdminAccountsService.AdminAccountRow row, AdminAccountsService.AdminCharacterSummary character)
    {
        await ReportAsync(await AccountsService.UnlinkCharacterAsync(row.Id, character.DbrefNumber),
            Loc["AdmCharacterUnlinked", character.Name, row.Username].Value,
            Loc["AdmUnlinkFailed"].Value);
    }

    private async Task OpenResetAsync(AdminAccountsService.AdminAccountRow row)
    {
        var temp = $"temp-{Guid.NewGuid().ToString("N")[..10]}";
        // The temporary password is in this line and nowhere else, so it must stay up until dismissed.
        await ReportAsync(await AccountsService.ResetPasswordAsync(row.Id, temp),
            Loc["AdmPasswordReset", row.Username, temp].Value,
            Loc["AdmResetFailed"].Value,
            Severity.Warning, o => o.RequireInteraction = true);
    }
}
