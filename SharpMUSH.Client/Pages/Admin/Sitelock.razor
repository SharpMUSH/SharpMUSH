@page "/admin/config/sitelock"
@page "/admin/config/sitelockrules"
@layout ConfigLayout
@attribute [Authorize(Policy = "config.admin")]
@using SharpMUSH.Client.Components.Admin
@using SharpMUSH.Client.Services
@inject SitelockService SitelockService
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["SitelockRules"] - @Loc["Configuration"]</PageTitle>

<div class="config-section-page">
    <PlainPageHeader Kicker="@Loc["ResConfigSectionKicker"]" Title="@Loc["SitelockRules"]">
        <DescriptionContent>
            @Loc["SitelockDescription"]
            <code>!connect</code>, <code>!create</code>, <code>!guest</code>, <code>register</code>, <code>suspect</code>
        </DescriptionContent>
    </PlainPageHeader>

    <AdminKeyValueList Text="@Text"
                       Load="@(() => SitelockService.GetSitelockRulesAsync().AsEntriesAsync())"
                       Add="@SitelockService.AddSitelockRuleAsync"
                       Delete="@SitelockService.DeleteSitelockRuleAsync" />
</div>

@code {
    private AdminKeyValueListText Text => new(
        AddTitle: Loc["AddSitelockRule"],
        KeyLabel: Loc["HostPattern"],
        KeyPlaceholder: Loc["HostPatternHelper"],
        AddButton: Loc["Add"],
        ListTitle: Loc["ConfiguredRules"],
        Empty: Loc["NoSitelockRulesConfigured"],
        Added: pattern => string.Format(Loc["SitelockRuleAdded"], pattern),
        Removed: pattern => string.Format(Loc["SitelockRuleRemoved"], pattern),
        LoadFailed: failure => string.Format(Loc["ErrorLoadingSitelockRules"], failure.Message),
        AddFailed: (_, failure) => string.Format(Loc["ErrorAddingSitelockRule"], failure.Message),
        RemoveFailed: (_, failure) => string.Format(Loc["ErrorRemovingSitelockRule"], failure.Message))
    {
        ValuesLabel = Loc["AccessRulesLabel"],
        ValuesPlaceholder = Loc["AccessRulesHelper"],
        ValuesRequired = Loc["AtLeastOneAccessRule"],
    };
}
