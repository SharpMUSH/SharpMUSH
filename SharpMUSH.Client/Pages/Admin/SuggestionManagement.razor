@page "/admin/suggestions"
@attribute [Authorize(Policy = "config.admin")]
@using System.Net.Http.Json
@using Microsoft.Extensions.Localization
@inject IHttpClientFactory HttpFactory
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["SuggestionManagement"]</PageTitle>

<div class="sugg-page">
    <PlainPageHeader Kicker="@Loc["AdmSuggestionsKicker"]" Title="@Loc["SuggestionManagement"]" Description="@Loc["SuggestionsDescription"]">
        <Actions>
            <CapsuleButton Icon="@Icons.Material.Filled.Refresh" OnClick="LoadSuggestionsAsync">@Loc["Refresh"]</CapsuleButton>
            <CapsuleButton Icon="@Icons.Material.Filled.Add" Primary="true" OnClick="ShowAddCategoryDialog">@Loc["AddCategory"]</CapsuleButton>
        </Actions>
    </PlainPageHeader>

    @if (_isLoading)
    {
        <div class="sugg-loading">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        </div>
    }
    else if (_categories == null || !_categories.Any())
    {
        <KitCard>
            <div class="sugg-empty">
                <MudIcon Icon="@Icons.Material.Filled.Spellcheck" Class="sugg-empty-icon" />
                <div class="sugg-empty-text">@Loc["NoSuggestionCategories"]</div>
            </div>
        </KitCard>
    }

    @if (_categories != null && _categories.Any())
    {
        <AdminStats>
            <AdminStat Key="categories" Icon="@Icons.Material.Filled.Category" Label="@Loc["Categories"]"
                       Value="@_categories.Count.ToString()" />
            <AdminStat Key="words" Icon="@Icons.Material.Filled.TextFields" Label="@Loc["TotalWords"]"
                       Value="@_categories.Sum(c => c.Value.Count).ToString()" />
            <AdminStat Key="average" Icon="@Icons.Material.Filled.TrendingUp" Label="@Loc["AvgWordsPerCategory"]"
                       Value="@Math.Round(_categories.Average(c => c.Value.Count), 1).ToString()" />
        </AdminStats>

        <KitCard Title="@string.Format(Loc["CategoriesCount"], _categories.Count)">
            <div class="sugg-panels">
                <MudExpansionPanels Elevation="0">
                    @foreach (var category in _categories.OrderBy(c => c.Key))
                    {
                        <MudExpansionPanel>
                            <TitleContent>
                                <div class="sugg-panel-title">
                                    <MudIcon Icon="@Icons.Material.Filled.Category" Class="sugg-panel-icon" />
                                    <span class="sugg-panel-name">@category.Key</span>
                                    <Pill Tag="true" Class="sugg-count">@Loc.Plural("WordsCount", "count", category.Value.Count)</Pill>
                                    <MudSpacer />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   aria-label="@Loc["Delete"]"
                                                   OnClick="@(async () => await DeleteCategoryAsync(category.Key))" />
                                </div>
                            </TitleContent>
                            <ChildContent>
                                <div class="sugg-panel-inner">
                                    <MudStack Spacing="3">
                                        <MudStack Row="true" AlignItems="AlignItems.Center">
                                            <MudTextField T="string"
                                                          Value="@NewWordFor(category.Key)"
                                                          ValueChanged="@(v => _newWords[category.Key] = v)"
                                                          Label="@Loc["AddNewWord"].Value"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          Adornment="Adornment.End"
                                                          AdornmentIcon="@Icons.Material.Filled.Add"
                                                          OnAdornmentClick="@(async () => await AddWordAsync(category.Key))"
                                                          FullWidth="true" />
                                            <MudButton Variant="Variant.Filled"
                                                       Color="Color.Primary"
                                                       StartIcon="@Icons.Material.Filled.Add"
                                                       OnClick="@(async () => await AddWordAsync(category.Key))">
                                                @Loc["Add"]
                                            </MudButton>
                                        </MudStack>

                                        <SectionLabel Class="sugg-words-label">@Loc["Words"]</SectionLabel>
                                        @if (category.Value.Any())
                                        {
                                            <div class="sugg-words-box">
                                                <MudStack Row="true" Spacing="1" Class="sugg-words">
                                                    @foreach (var word in category.Value.OrderBy(w => w))
                                                    {
                                                        <MudChip T="string" Text="@word"
                                                                 Variant="Variant.Outlined"
                                                                 Size="Size.Small"
                                                                 Class="sugg-word"
                                                                 OnClose="@(async () => await DeleteWordAsync(category.Key, word))" />
                                                    }
                                                </MudStack>
                                            </div>
                                        }
                                        else
                                        {
                                            <MudAlert Severity="Severity.Info" Dense="true">
                                                @Loc["NoWordsInCategory"]
                                            </MudAlert>
                                        }
                                    </MudStack>
                                </div>
                            </ChildContent>
                        </MudExpansionPanel>
                    }
                </MudExpansionPanels>
            </div>
        </KitCard>
    }
</div>

<MudDialog @bind-Visible="_showAddCategoryDialog">
    <DialogContent>
        <MudTextField @bind-Value="_newCategoryName"
                      Label="@Loc["CategoryName"].Value"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      HelperText="@Loc["CategoryNameHelper"].Value" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showAddCategoryDialog = false)">@Loc["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddCategoryAsync">
            @Loc["Create"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private HttpClient Http => HttpFactory.CreateClient("api");

    private Dictionary<string, HashSet<string>>? _categories;
    private bool _isLoading = true;
    private string _newCategoryName = string.Empty;
    private bool _showAddCategoryDialog = false;

    /// <summary>
    /// The word being typed in each category's panel. One shared field used to echo whatever was typed
    /// in one panel into every other open panel, and to add it to whichever category's button was pressed.
    /// </summary>
    private readonly Dictionary<string, string> _newWords = new(StringComparer.Ordinal);

    private string NewWordFor(string category) => _newWords.GetValueOrDefault(category) ?? string.Empty;

    /// <summary>A category or word as one path segment; a word may carry "?", "#" or spaces.</summary>
    private static string Segment(string value) => Uri.EscapeDataString(value);

    protected override async Task OnInitializedAsync()
    {
        await LoadSuggestionsAsync();
    }

    private async Task LoadSuggestionsAsync()
    {
        _isLoading = true;
        try
        {
            var response = await Http.GetFromJsonAsync<SuggestionDataResponse>("/api/suggestion");
            _categories = response?.Categories ?? new Dictionary<string, HashSet<string>>();
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(Loc["ErrorLoadingSuggestions"], ex.Message), Severity.Error);
            _categories = new Dictionary<string, HashSet<string>>();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ShowAddCategoryDialog()
    {
        _newCategoryName = string.Empty;
        _showAddCategoryDialog = true;
    }

    private async Task AddCategoryAsync()
    {
        if (string.IsNullOrWhiteSpace(_newCategoryName))
        {
            Snackbar.Add(Loc["CategoryNameEmpty"].Value, Severity.Warning);
            return;
        }

        var categoryKey = _newCategoryName.ToLower().Trim();
        if (_categories?.ContainsKey(categoryKey) == true)
        {
            Snackbar.Add(string.Format(Loc["CategoryAlreadyExists"], categoryKey), Severity.Warning);
            return;
        }

        try
        {
            // Add a category by adding an empty word (which we'll remove)
            using var response = await Http.PostAsJsonAsync($"/api/suggestion/{Segment(categoryKey)}", " ");
            if (response.IsSuccessStatusCode)
            {
                using var placeholderRemoved = await Http.DeleteAsync($"/api/suggestion/{Segment(categoryKey)}/{Segment(" ")}");

                await LoadSuggestionsAsync();
                Snackbar.Add(string.Format(Loc["CategoryCreated"], categoryKey), Severity.Success);
                _showAddCategoryDialog = false;
                _newCategoryName = string.Empty;
            }
            else
            {
                Snackbar.Add(string.Format(Loc["CategoryCreateFailed"], response.ReasonPhrase), Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(Loc["ErrorCreatingCategory"], ex.Message), Severity.Error);
        }
    }

    private async Task AddWordAsync(string category)
    {
        var word = NewWordFor(category);
        if (string.IsNullOrWhiteSpace(word))
        {
            Snackbar.Add(Loc["WordEmpty"].Value, Severity.Warning);
            return;
        }

        try
        {
            using var response = await Http.PostAsJsonAsync($"/api/suggestion/{Segment(category)}", word.ToLower().Trim());
            if (response.IsSuccessStatusCode)
            {
                await LoadSuggestionsAsync();
                Snackbar.Add(string.Format(Loc["WordAdded"], word, category), Severity.Success);
                _newWords.Remove(category);
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add(string.Format(Loc["WordAddFailed"], error), Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(Loc["ErrorAddingWord"], ex.Message), Severity.Error);
        }
    }

    private async Task DeleteWordAsync(string category, string word)
    {
        try
        {
            // The word used to be spliced into the path raw, so "what?" deleted "what" and "a#b" deleted "a".
            using var response = await Http.DeleteAsync($"/api/suggestion/{Segment(category)}/{Segment(word)}");
            if (response.IsSuccessStatusCode)
            {
                await LoadSuggestionsAsync();
                Snackbar.Add(string.Format(Loc["WordRemoved"], word, category), Severity.Success);
            }
            else
            {
                Snackbar.Add(string.Format(Loc["WordRemoveFailed"], response.ReasonPhrase), Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(Loc["ErrorDeletingWord"], ex.Message), Severity.Error);
        }
    }

    private async Task DeleteCategoryAsync(string category)
    {
        try
        {
            using var response = await Http.DeleteAsync($"/api/suggestion/{Segment(category)}");
            if (response.IsSuccessStatusCode)
            {
                await LoadSuggestionsAsync();
                Snackbar.Add(string.Format(Loc["CategoryDeleted"], category), Severity.Success);
            }
            else
            {
                Snackbar.Add(string.Format(Loc["CategoryDeleteFailed"], response.ReasonPhrase), Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(Loc["ErrorDeletingCategory"], ex.Message), Severity.Error);
        }
    }

    private class SuggestionDataResponse
    {
        public Dictionary<string, HashSet<string>>? Categories { get; set; }
    }
}
