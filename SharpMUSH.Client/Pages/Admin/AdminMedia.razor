@page "/admin/media"
@attribute [Authorize(Policy = "media.admin")]
@using SharpMUSH.Client.Services
@using Microsoft.AspNetCore.Components.Forms
@inject WikiAssetService AssetService
@inject ISnackbar Snackbar
@inject IJSRuntime JsRuntime
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["WkImageLibrary"] — @Loc["AdminPanel"] — @Loc["AppTitle"]</PageTitle>

<div style="padding:var(--cpad);">
    <MudText Typo="Typo.h4" Style="font-weight:700;margin-bottom:0.25rem;">@Loc["WkImageLibrary"]</MudText>
    <MudText Style="color:var(--text-dim);font-size:0.875rem;margin-bottom:1.5rem;">@Loc["WkImageLibraryDescription"]</MudText>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:0.75rem;margin-bottom:1.25rem;">
        @foreach (var tile in new[] {
            (_assets.Count.ToString(),                             "WkTotalAssets",           Icons.Material.Filled.Image,        "var(--accent)"),
            (Loc.FormatBytes(TotalSizeBytes),                      "WkStorageUsed",           Icons.Material.Filled.Storage,      "#5aa9ff"),
            (_assets.Count(a => AssetKind(a.ContentType) == "image").ToString(), "WkKindImagePlural", Icons.Material.Filled.PhotoLibrary, "#6cde9a"),
            (_assets.Count(a => AssetKind(a.ContentType) != "image").ToString(), "WkKindOther", Icons.Material.Filled.Attachment,  "#b39cff"),
        })
        {
            var (val, labelKey, icon, color) = tile;
            <MudPaper Elevation="0" Style="@($"padding:1rem 1.125rem;border-radius:var(--radius);border:1px solid var(--border);background:var(--surface);")">
                <div style="display:flex;align-items:center;gap:0.75rem;">
                    <MudIcon Icon="@icon" Style="@($"color:{color};font-size:1.375rem;")" />
                    <div>
                        <MudText Style="@($"font-size:1.375rem;font-weight:700;color:{color};line-height:1.1;")">
                            @(_isLoading ? "—" : val)
                        </MudText>
                        <MudText Class="section-kicker" Style="opacity:0.7;">@Loc[labelKey]</MudText>
                    </div>
                </div>
            </MudPaper>
        }
    </div>

    <div style="display:flex;align-items:center;gap:0.625rem;flex-wrap:wrap;margin-bottom:0.875rem;">
        <MudChipSet T="string" SelectionMode="SelectionMode.SingleSelection"
                    SelectedValue="_kindFilter"
                    SelectedValueChanged="@(v => { _kindFilter = v ?? "all"; StateHasChanged(); })">
            @foreach (var kind in new[] { "all", "image", "video", "document" })
            {
                <MudChip T="string" Value="@kind"
                         Size="Size.Small"
                         Style="@(_kindFilter == kind ? "border:1px solid var(--accent);color:var(--accent);background:rgba(var(--glow),0.08);" : "border:1px solid var(--border);")">
                    @Loc[KindLabelKey(kind)]
                </MudChip>
            }
        </MudChipSet>
        <MudSpacer />
        <MudToggleGroup T="string" Value="_viewMode" ValueChanged="@(v => _viewMode = v ?? "grid")"
                        Color="Color.Primary" Style="gap:0;">
            <MudToggleItem Value="@("grid")" Text="@Loc["WkViewGrid"]" />
            <MudToggleItem Value="@("list")" Text="@Loc["WkViewList"]" />
        </MudToggleGroup>
        <MudFileUpload T="IBrowserFile"
                       Accept=".png,.jpg,.jpeg,.gif,.webp,.svg,.mp4,.webm,.pdf,.txt"
                       FilesChanged="@OnFileSelected"
                       MaximumFileCount="1"
                       MaxFileSize="52428800"
                       Disabled="_isUploading" />
        @if (_isUploading)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
        }
    </div>

    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        @for (var i = 0; i < 4; i++) { <MudSkeleton Height="80px" Class="mb-2" /> }
    }
    else if (FilteredAssets.Count == 0)
    {
        <EmptyState>@Loc["WkNoAssetsFound"]</EmptyState>
    }
    else if (_viewMode == "grid")
    {
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:0.75rem;">
            @foreach (var asset in FilteredAssets)
            {
                var a = asset;
                <MudPaper Elevation="0" Class="asset-card"
                          Style="border-radius:var(--radius);border:1px solid var(--border);overflow:hidden;background:var(--surface);position:relative;">
                    <div style="@($"height:120px;display:flex;align-items:center;justify-content:center;background:var(--surface-2);overflow:hidden;")">
                        @if (AssetKind(a.ContentType) == "image")
                        {
                            <img src="@a.Url" alt="@a.FileName"
                                 style="width:100%;height:100%;object-fit:cover;" loading="lazy" />
                        }
                        else
                        {
                            <MudIcon Icon="@KindIcon(AssetKind(a.ContentType))"
                                     Style="font-size:3rem;color:var(--text-faint);" />
                        }
                    </div>
                    <div style="padding:0.5rem 0.625rem;">
                        <MudText Style="font-size:0.75rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--text);" title="@a.FileName">
                            @a.FileName
                        </MudText>
                        <div style="display:flex;align-items:center;justify-content:space-between;margin-top:0.25rem;">
                            <MudText Style="font-size:0.6875rem;color:var(--text-faint);">@Loc.FormatBytes(a.SizeBytes)</MudText>
                            <div style="display:flex;gap:0.125rem;">
                                <MudTooltip Text="@Loc["WkCopyUrl"]">
                                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                                                   Style="padding:0.125rem;min-width:0;"
                                                   OnClick="@(() => CopyUrlAsync(a.Url))" />
                                </MudTooltip>
                                <MudTooltip Text="@Loc["Delete"]">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                   Color="Color.Error"
                                                   Style="padding:0.125rem;min-width:0;"
                                                   OnClick="@(() => ConfirmDeleteAsync(a))" />
                                </MudTooltip>
                            </div>
                        </div>
                    </div>
                </MudPaper>
            }
        </div>
    }
    else
    {
        <div style="overflow-x:auto;min-width:0;">
        <MudDataGrid T="WikiAssetInfo" Items="@FilteredAssets"
                     Dense="true" Hover="true"
                     Class="mush-dark-grid"
                     Elevation="0">
            <Columns>
                <TemplateColumn Title="@Loc["WkColPreview"]" Sortable="false" CellStyle="width:48px;">
                    <CellTemplate>
                        @if (AssetKind(context.Item.ContentType) == "image")
                        {
                            <img src="@context.Item.Url" alt="" style="width:32px;height:32px;object-fit:cover;border-radius:4px;" />
                        }
                        else
                        {
                            <MudIcon Icon="@KindIcon(AssetKind(context.Item.ContentType))"
                                     Style="font-size:1.25rem;color:var(--text-faint);" />
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@Loc["WkColFileName"]" Sortable="false">
                    <CellTemplate>
                        <MudText Style="font-size:0.8125rem;">@context.Item.FileName</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@Loc["WkColKind"]" Sortable="false" CellStyle="width:80px;">
                    <CellTemplate>
                        <MudChip T="string" Size="Size.Small"
                                 Style="height:18px;font-size:0.625rem;padding:0 0.3125rem;">
                            @Loc[KindLabelKey(AssetKind(context.Item.ContentType))]
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@Loc["WkColSize"]" Sortable="false" CellStyle="width:80px;">
                    <CellTemplate>
                        <MudText Style="font-size:0.75rem;font-family:var(--font-mono);color:var(--text-faint);">
                            @Loc.FormatBytes(context.Item.SizeBytes)
                        </MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@Loc["WkColUploaded"]" Sortable="false" CellStyle="width:130px;">
                    <CellTemplate>
                        <MudText Style="font-size:0.75rem;color:var(--text-dim);">
                            @context.Item.UploadedAt.ToLocalTime().ToString("MMM d, yyyy")
                        </MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@Loc["WkColUploader"]" Sortable="false">
                    <CellTemplate>
                        <MudText Style="font-size:0.75rem;font-family:var(--font-mono);color:var(--text-dim);">
                            @context.Item.UploaderDbref
                        </MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Sortable="false" CellStyle="width:80px;">
                    <CellTemplate>
                        <div style="display:flex;gap:0.125rem;">
                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                                           title="@Loc["WkCopyUrl"]" OnClick="@(() => CopyUrlAsync(context.Item.Url))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                           Color="Color.Error" title="@Loc["Delete"]"
                                           OnClick="@(() => ConfirmDeleteAsync(context.Item))" />
                        </div>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <MudText Color="Color.Secondary">@Loc["WkNoAssetsFound"]</MudText>
            </NoRecordsContent>
        </MudDataGrid>
        </div>
    }
</div>

<MudDialog @bind-Visible="_showDeleteConfirm">
    <TitleContent>
        <MudText Typo="Typo.h6">@Loc["WkDeleteAssetTitle"]</MudText>
    </TitleContent>
    <DialogContent>
        <MudText>@Loc["WkDeleteAssetConfirm", _deleteTarget?.FileName ?? string.Empty]</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showDeleteConfirm = false)">@Loc["Cancel"]</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="ExecuteDeleteAsync">@Loc["Delete"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<WikiAssetInfo> _assets = [];
    private bool _isLoading = true;
    private bool _isUploading;
    private string _kindFilter = "all";
    private string _viewMode = "grid";
    private bool _showDeleteConfirm;
    private WikiAssetInfo? _deleteTarget;

    private long TotalSizeBytes => _assets.Sum(a => a.SizeBytes);

    private List<WikiAssetInfo> FilteredAssets => _kindFilter == "all"
        ? _assets
        : _assets.Where(a => AssetKind(a.ContentType) == _kindFilter).ToList();

    protected override async Task OnInitializedAsync()
    {
        _assets = [.. await AssetService.ListAsync(skip: 0, take: 500)];
        _isLoading = false;
    }

    private async Task OnFileSelected(IBrowserFile file)
    {
        _isUploading = true;
        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: 52428800);
            var result = await AssetService.UploadAsync(stream, file.Name, file.ContentType);
            result.Switch(
                info =>
                {
                    _assets.Insert(0, new WikiAssetInfo(info.Id, info.FileName, info.Url,
                        info.ContentType, info.SizeBytes, string.Empty, "me", DateTimeOffset.UtcNow));
                    Snackbar.Add(Loc["WkAssetUploaded", info.FileName], Severity.Success);
                },
                err => Snackbar.Add(Loc["WkUploadFailed", err], Severity.Error)
            );
        }
        catch (Exception ex)
        {
            Snackbar.Add(Loc["WkUploadError", ex.Message], Severity.Error);
        }
        finally
        {
            _isUploading = false;
        }
    }

    private void ConfirmDeleteAsync(WikiAssetInfo asset)
    {
        _deleteTarget = asset;
        _showDeleteConfirm = true;
    }

    private async Task ExecuteDeleteAsync()
    {
        if (_deleteTarget is null) return;
        var target = _deleteTarget;
        _showDeleteConfirm = false;
        _deleteTarget = null;
        var ok = await AssetService.DeleteAsync(target.Id);
        if (ok)
        {
            _assets.RemoveAll(a => a.Id == target.Id);
            Snackbar.Add(Loc["WkAssetDeleted", target.FileName], Severity.Success);
        }
        else
        {
            Snackbar.Add(Loc["WkAssetDeleteFailed", target.FileName], Severity.Error);
        }
    }

    private async Task CopyUrlAsync(string url)
    {
        await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", url);
        Snackbar.Add(Loc["WkUrlCopied"], Severity.Info);
    }

    private static string AssetKind(string contentType) => contentType switch
    {
        var t when t.StartsWith("image/", StringComparison.OrdinalIgnoreCase) => "image",
        var t when t.StartsWith("video/", StringComparison.OrdinalIgnoreCase) => "video",
        _ => "document",
    };

    private static string KindLabelKey(string kind) => kind switch
    {
        "image"    => "WkKindImage",
        "video"    => "WkKindVideo",
        "document" => "WkKindDocument",
        _          => "All",
    };

    private static string KindIcon(string kind) => kind switch
    {
        "image"    => Icons.Material.Filled.Image,
        "video"    => Icons.Material.Filled.Videocam,
        "document" => Icons.Material.Filled.InsertDriveFile,
        _          => Icons.Material.Filled.Attachment,
    };
}
