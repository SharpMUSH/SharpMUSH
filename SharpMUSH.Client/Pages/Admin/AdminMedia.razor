@page "/admin/media"
@attribute [Authorize(Policy = "media.admin")]
@using SharpMUSH.Client.Services
@using SharpMUSH.Library.DiscriminatedUnions
@using Microsoft.AspNetCore.Components.Forms
@inject WikiAssetService AssetService
@inject ISnackbar Snackbar
@inject IJSRuntime JsRuntime
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["WkImageLibrary"] — @Loc["AdminPanel"] — @Loc["AppTitle"]</PageTitle>

<div class="page-stack page-stack--padded adm-media">
    <PlainPageHeader Kicker="@Loc["WkStaffMedia"]" Title="@Loc["WkImageLibrary"]" Description="@Loc["WkImageLibraryDescription"]">
        <Actions>
            @if (_isUploading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
            }
            <MudFileUpload T="IBrowserFile"
                           Accept=".png,.jpg,.jpeg,.gif,.webp,.svg,.mp4,.webm,.pdf,.txt"
                           FilesChanged="@OnFileSelected"
                           MaximumFileCount="1"
                           MaxFileSize="52428800"
                           Disabled="_isUploading" />
        </Actions>
    </PlainPageHeader>

    <AdminStats>
        <AdminStat Key="total" Icon="@Icons.Material.Filled.Image" Label="@Loc["WkTotalAssets"]"
                   Value="@(_isLoading ? "—" : _assets.Count.ToString())" />
        <AdminStat Key="storage" Icon="@Icons.Material.Filled.Storage" Label="@Loc["WkStorageUsed"]"
                   Value="@(_isLoading ? "—" : Loc.FormatBytes(TotalSizeBytes))" />
        <AdminStat Key="images" Icon="@Icons.Material.Filled.PhotoLibrary" Label="@Loc["WkKindImagePlural"]"
                   Value="@(_isLoading ? "—" : _assets.Count(a => AssetKind(a.ContentType) == "image").ToString())" />
        <AdminStat Key="other" Icon="@Icons.Material.Filled.Attachment" Label="@Loc["WkKindOther"]"
                   Value="@(_isLoading ? "—" : _assets.Count(a => AssetKind(a.ContentType) != "image").ToString())" />
    </AdminStats>

    <KitCard>
        <Controls>
            <TypeChips Items="@KindItems" Selected="@_kindFilter" SelectedChanged="@(v => _kindFilter = v)"
                       AriaLabel="@Loc["AdmMediaKindFilter"]" />
            <TypeChips Items="@ViewItems" Selected="@_viewMode" SelectedChanged="@(v => _viewMode = v)"
                       AriaLabel="@Loc["AdmMediaViewMode"]" />
        </Controls>
        <ChildContent>
            <div class="adm-media-body">
                @if (_isLoading)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                    @for (var i = 0; i < 4; i++) { <MudSkeleton Height="80px" Class="mb-2" /> }
                }
                else if (FilteredAssets.Count == 0)
                {
                    <EmptyState>@Loc["WkNoAssetsFound"]</EmptyState>
                }
                else if (_viewMode == "grid")
                {
                    <div class="adm-media-grid">
                        @foreach (var asset in FilteredAssets)
                        {
                            var a = asset;
                            <div class="adm-media-card" @key="a.Id">
                                <div class="adm-media-thumb">
                                    @if (AssetKind(a.ContentType) == "image")
                                    {
                                        <img src="@ApiUrl.Resolve(a.Url)" alt="@a.FileName" loading="lazy" />
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@KindIcon(AssetKind(a.ContentType))" Class="adm-media-kind-icon" />
                                    }
                                </div>
                                <div class="adm-media-card-body">
                                    <div class="adm-media-name" title="@a.FileName">@a.FileName</div>
                                    <div class="adm-media-card-foot">
                                        <span class="adm-media-size">@Loc.FormatBytes(a.SizeBytes)</span>
                                        <span class="adm-media-actions">
                                            <MudTooltip Text="@Loc["WkCopyUrl"]">
                                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                                                               aria-label="@Loc["WkCopyUrl"]"
                                                               OnClick="@(() => CopyUrlAsync(a.Url))" />
                                            </MudTooltip>
                                            <MudTooltip Text="@Loc["Delete"]">
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                               Color="Color.Error" aria-label="@Loc["Delete"]"
                                                               OnClick="@(() => ConfirmDeleteAsync(a))" />
                                            </MudTooltip>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="adm-media-list">
                        <MudDataGrid T="WikiAssetInfo" Items="@FilteredAssets"
                                     Dense="true" Hover="true"
                                     Class="mush-dark-grid"
                                     Elevation="0">
                            <Columns>
                                <TemplateColumn Title="@Loc["WkColPreview"]" Sortable="false" CellStyle="width:48px;">
                                    <CellTemplate>
                                        @if (AssetKind(context.Item.ContentType) == "image")
                                        {
                                            <img class="adm-media-list-thumb" src="@ApiUrl.Resolve(context.Item.Url)" alt="" />
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@KindIcon(AssetKind(context.Item.ContentType))" Size="Size.Small" Class="adm-media-list-icon" />
                                        }
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="@Loc["WkColFileName"]" Sortable="false">
                                    <CellTemplate>
                                        <span class="adm-media-list-name">@context.Item.FileName</span>
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="@Loc["WkColKind"]" Sortable="false" CellStyle="width:80px;">
                                    <CellTemplate>
                                        <Pill Tag="true">@Loc[KindLabelKey(AssetKind(context.Item.ContentType))]</Pill>
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="@Loc["WkColSize"]" Sortable="false" CellStyle="width:80px;">
                                    <CellTemplate>
                                        <span class="adm-media-list-mono">@Loc.FormatBytes(context.Item.SizeBytes)</span>
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="@Loc["WkColUploaded"]" Sortable="false" CellStyle="width:130px;">
                                    <CellTemplate>
                                        <span class="adm-media-list-dim">@context.Item.UploadedAt.ToLocalTime().ToString("MMM d, yyyy")</span>
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="@Loc["WkColUploader"]" Sortable="false">
                                    <CellTemplate>
                                        <span class="adm-media-list-mono">@context.Item.UploaderDbref</span>
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Sortable="false" CellStyle="width:80px;">
                                    <CellTemplate>
                                        <span class="adm-media-actions">
                                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                                                           title="@Loc["WkCopyUrl"]" aria-label="@Loc["WkCopyUrl"]"
                                                           OnClick="@(() => CopyUrlAsync(context.Item.Url))" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                           Color="Color.Error" title="@Loc["Delete"]" aria-label="@Loc["Delete"]"
                                                           OnClick="@(() => ConfirmDeleteAsync(context.Item))" />
                                        </span>
                                    </CellTemplate>
                                </TemplateColumn>
                            </Columns>
                            <NoRecordsContent>
                                <MudText Color="Color.Secondary">@Loc["WkNoAssetsFound"]</MudText>
                            </NoRecordsContent>
                        </MudDataGrid>
                    </div>
                }
            </div>
        </ChildContent>
    </KitCard>
</div>

<ConfirmDialog @bind-Visible="_showDeleteConfirm" Title="@Loc["WkDeleteAssetTitle"]" ConfirmText="@Loc["Delete"]" OnConfirm="ExecuteDeleteAsync">
    <MudText>@Loc["WkDeleteAssetConfirm", _deleteTarget?.FileName ?? string.Empty]</MudText>
</ConfirmDialog>

@code {
    private List<WikiAssetInfo> _assets = [];
    private bool _isLoading = true;
    private bool _isUploading;
    private string _kindFilter = "all";
    private string _viewMode = "grid";
    private bool _showDeleteConfirm;
    private WikiAssetInfo? _deleteTarget;

    private long TotalSizeBytes => _assets.Sum(a => a.SizeBytes);

    private IReadOnlyList<(string Key, string Label)> KindItems =>
        [.. new[] { "all", "image", "video", "document" }.Select(kind => (kind, Loc[KindLabelKey(kind)].Value))];

    private IReadOnlyList<(string Key, string Label)> ViewItems =>
        [("grid", Loc["WkViewGrid"].Value), ("list", Loc["WkViewList"].Value)];

    private List<WikiAssetInfo> FilteredAssets => _kindFilter == "all"
        ? _assets
        : _assets.Where(a => AssetKind(a.ContentType) == _kindFilter).ToList();

    protected override async Task OnInitializedAsync()
    {
        _assets = [.. await AssetService.ListAsync(skip: 0, take: 500)];
        _isLoading = false;
    }

    private async Task OnFileSelected(IBrowserFile file)
    {
        _isUploading = true;
        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: 52428800);
            var result = await AssetService.UploadAsync(stream, file.Name, file.ContentType);
            switch (result)
            {
                case UploadedAssetInfo info:
                    _assets.Insert(0, new WikiAssetInfo(info.Id, info.FileName, info.Url,
                        info.ContentType, info.SizeBytes, string.Empty, "me", DateTimeOffset.UtcNow));
                    Snackbar.Add(Loc["WkAssetUploaded", info.FileName], Severity.Success);
                    break;
                case ApiFailure failure:
                    Snackbar.Add(Loc["WkUploadFailed", failure.Message], Severity.Error);
                    break;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(Loc["WkUploadError", ex.Message], Severity.Error);
        }
        finally
        {
            _isUploading = false;
        }
    }

    private void ConfirmDeleteAsync(WikiAssetInfo asset)
    {
        _deleteTarget = asset;
        _showDeleteConfirm = true;
    }

    private async Task ExecuteDeleteAsync()
    {
        if (_deleteTarget is null) return;
        var target = _deleteTarget;
        _showDeleteConfirm = false;
        _deleteTarget = null;
        if (await AssetService.DeleteAsync(target.Id) is Success)
        {
            _assets.RemoveAll(a => a.Id == target.Id);
            Snackbar.Add(Loc["WkAssetDeleted", target.FileName], Severity.Success);
        }
        else
        {
            Snackbar.Add(Loc["WkAssetDeleteFailed", target.FileName], Severity.Error);
        }
    }

    private async Task CopyUrlAsync(string url)
    {
        try
        {
            // Rejected outside a secure context, or when the browser withholds clipboard permission.
            await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", url);
            Snackbar.Add(Loc["WkUrlCopied"], Severity.Info);
        }
        catch (JSException)
        {
            Snackbar.Add(Loc["WkCopyFailed"], Severity.Error);
        }
    }

    private static string AssetKind(string contentType) => contentType switch
    {
        var t when t.StartsWith("image/", StringComparison.OrdinalIgnoreCase) => "image",
        var t when t.StartsWith("video/", StringComparison.OrdinalIgnoreCase) => "video",
        _ => "document",
    };

    private static string KindLabelKey(string kind) => kind switch
    {
        "image"    => "WkKindImage",
        "video"    => "WkKindVideo",
        "document" => "WkKindDocument",
        _          => "All",
    };

    private static string KindIcon(string kind) => kind switch
    {
        "image"    => Icons.Material.Filled.Image,
        "video"    => Icons.Material.Filled.Videocam,
        "document" => Icons.Material.Filled.InsertDriveFile,
        _          => Icons.Material.Filled.Attachment,
    };
}
