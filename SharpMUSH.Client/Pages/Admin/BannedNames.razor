@page "/admin/config/bannednames"
@layout ConfigLayout
@attribute [Authorize(Policy = "config.admin")]
@using SharpMUSH.Client.Components.Admin
@using SharpMUSH.Client.Services
@inject BannedNamesService BannedNamesService
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["BannedNames"] - @Loc["Configuration"]</PageTitle>

<div class="config-section-page">
    <PlainPageHeader Kicker="@Loc["ResConfigSectionKicker"]" Title="@Loc["BannedPlayerNames"]" Description="@Loc["BannedNamesDescription"]" />

    <AdminKeyValueList Text="@Text"
                       Load="@(() => BannedNamesService.GetBannedNamesAsync().AsEntriesAsync())"
                       Add="@((name, _) => BannedNamesService.AddBannedNameAsync(name))"
                       Delete="@BannedNamesService.DeleteBannedNameAsync" />
</div>

@code {
    private AdminKeyValueListText Text => new(
        AddTitle: Loc["AddBannedName"],
        KeyLabel: Loc["NameToBan"],
        KeyPlaceholder: Loc["NameToBan"],
        AddButton: Loc["AddName"],
        ListTitle: Loc["BannedNamesList"],
        Empty: Loc["NoBannedNamesConfigured"],
        Added: name => string.Format(Loc["BannedNameAdded"], name),
        Removed: name => string.Format(Loc["BannedNameRemoved"], name),
        LoadFailed: failure => string.Format(Loc["ErrorLoadingBannedNames"], failure.Message),
        AddFailed: (name, _) => string.Format(Loc["BannedNameAddFailed"], name),
        RemoveFailed: (name, _) => string.Format(Loc["BannedNameRemoveFailed"], name));
}
