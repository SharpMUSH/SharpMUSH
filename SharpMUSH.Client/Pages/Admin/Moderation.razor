@page "/admin/moderation"
@attribute [Authorize(Policy = "players.moderate")]
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["AdmModerationTitle"] — @Loc["AdmBreadcrumb"] — @Loc["AppTitle"]</PageTitle>

<div class="adm-soon">
    <PlainPageHeader Kicker="@Loc["AdmKicker"]" Title="@Loc["AdmModerationTitle"]" />

    <KitCard>
        <div class="adm-soon-empty">
            <MudIcon Icon="@Icons.Material.Filled.Gavel" Class="adm-soon-icon" />
            <div class="adm-soon-text">@Loc["AdmModerationComingSoon"]</div>
        </div>
    </KitCard>
</div>
