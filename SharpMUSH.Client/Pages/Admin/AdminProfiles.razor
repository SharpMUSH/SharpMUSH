@page "/admin/profiles"
@attribute [Authorize(Policy = "players.moderate")]
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["ProfileHandler"] — @Loc["AdmBreadcrumb"] — @Loc["AppTitle"]</PageTitle>

<div class="adm-profiles">
    <PlainPageHeader Kicker="@Loc["AdmKicker"]" Title="@Loc["ProfileHandler"]">
        <DescriptionContent>
            @((MarkupString)Loc["AdmProfilesSubtitle",
                "<code>http_handler</code>",
                "<code>HTTP`PROFILE`*</code>",
                "<code>&amp;HTTP`PROFILE`GET …</code>"].Value)
        </DescriptionContent>
        <Actions>
            @if (_status?.HandlerExists == true)
            {
                <CapsuleButton Primary="true" Icon="@Icons.Material.Filled.RestartAlt" Disabled="_resetting" OnClick="ResetAsync">
                    @(_resetting ? Loc["AdmResetting"] : Loc["ResetToDefaults"])
                </CapsuleButton>
            }
        </Actions>
    </PlainPageHeader>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_status is null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@Loc["AdmProfilesStatusLoadFailed"]</MudAlert>
    }
    else
    {
        <KitCard Title="@Loc["AdmStatus"]">
            <div class="adm-profiles-status">
                <div class="adm-profiles-status-row">
                    <span class="adm-profiles-status-label">@Loc["AdmProfilesConfigured"]</span>
                    <span class="adm-profiles-status-value">@(_status.Configured ? Loc["AdmYes"] : Loc["AdmProfilesNotConfiguredValue"])</span>
                </div>
                @if (_status.Configured)
                {
                    <div class="adm-profiles-status-row">
                        <span class="adm-profiles-status-label">@Loc["AdmProfilesHandler"]</span>
                        <span class="adm-profiles-status-value">
                            @(_status.HandlerExists
                                ? $"{_status.HandlerName} (#{_status.HandlerDbref})"
                                : Loc["AdmProfilesHandlerNotFound", _status.HandlerDbref?.ToString() ?? string.Empty].Value)
                        </span>
                    </div>
                }
            </div>
        </KitCard>

        @if (_status.HandlerExists)
        {
            <KitCard Title="@Loc["AdmProfilesAttributesTitle"]">
                <div class="adm-profiles-attrs-head">
                    <span>@Loc["AdmAttribute"]</span>
                    <span>@Loc["AdmStatus"]</span>
                </div>
                @foreach (var attr in _status.Attributes)
                {
                    <div class="adm-profiles-attrs-row">
                        <code>@attr.Attribute</code>
                        @if (attr.Present)
                        {
                            <Pill Tag="true" Class="adm-profiles-present">@Loc["AdmPresent"]</Pill>
                        }
                        else
                        {
                            <Pill Tag="true" Warn="true">@Loc["AdmMissing"]</Pill>
                        }
                    </div>
                }
                <p class="adm-profiles-caption">
                    @((MarkupString)Loc["AdmProfilesResetCaption",
                        "<code>HTTP`PROFILE`*</code>",
                        "<code>FN`*</code>"].Value)
                </p>
            </KitCard>
        }
    }
</div>

@code {
    private record AttributeStatus(string Attribute, bool Present);
    private record HandlerStatus(bool Configured, int? HandlerDbref, string? HandlerName, bool HandlerExists, List<AttributeStatus> Attributes);
    private record ResetResult(int Written, List<string> Failed);

    private HandlerStatus? _status;
    private bool _loading = true;
    private bool _resetting;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var http = HttpClientFactory.CreateClient("api");
            _status = await http.GetFromJsonAsync<HandlerStatus>("api/admin/profile-handler");
        }
        catch (HttpRequestException)
        {
            _status = null;
        }
        _loading = false;
    }

    private async Task ResetAsync()
    {
        _resetting = true;
        try
        {
            var http = HttpClientFactory.CreateClient("api");
            using var response = await http.PostAsync("api/admin/profile-handler/reset", null);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ResetResult>();
                Snackbar.Add(Loc["AdmProfilesResetComplete", result?.Written ?? 0], Severity.Success);
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(Loc["AdmProfilesResetFailedStatus", (int)response.StatusCode], Severity.Error);
            }
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(Loc["AdmProfilesResetFailedError", ex.Message], Severity.Error);
        }
        _resetting = false;
    }
}
