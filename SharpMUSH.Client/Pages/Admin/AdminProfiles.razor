@page "/admin/profiles"
@attribute [Authorize(Policy = "players.moderate")]
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["ProfileHandler"] — @Loc["AdmBreadcrumb"] — @Loc["AppTitle"]</PageTitle>

<div style="padding:var(--cpad);">
    <div class="ph-header">
        <div class="ph-kicker">@Loc["AdmKicker"]</div>
        <h1 class="ph-title">@Loc["ProfileHandler"]</h1>
        <p class="ph-subtitle">
            @((MarkupString)Loc["AdmProfilesSubtitle",
                "<code>http_handler</code>",
                "<code>HTTP`PROFILE`*</code>",
                "<code>&amp;HTTP`PROFILE`GET …</code>"].Value)
        </p>
    </div>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Style="color:var(--accent);" />
    }
    else if (_status is null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@Loc["AdmProfilesStatusLoadFailed"]</MudAlert>
    }
    else
    {
        <div class="ph-card ph-status">
            <div class="ph-status-row">
                <span class="ph-status-label">@Loc["AdmProfilesConfigured"]</span>
                <span class="ph-status-value">@(_status.Configured ? Loc["AdmYes"] : Loc["AdmProfilesNotConfiguredValue"])</span>
            </div>
            @if (_status.Configured)
            {
                <div class="ph-status-row">
                    <span class="ph-status-label">@Loc["AdmProfilesHandler"]</span>
                    <span class="ph-status-value">
                        @(_status.HandlerExists
                            ? $"{_status.HandlerName} (#{_status.HandlerDbref})"
                            : Loc["AdmProfilesHandlerNotFound", _status.HandlerDbref?.ToString() ?? string.Empty].Value)
                    </span>
                </div>
            }
        </div>

        @if (_status.HandlerExists)
        {
            <div class="ph-card ph-attrs">
                <div class="ph-attrs-head">
                    <span>@Loc["AdmAttribute"]</span>
                    <span>@Loc["AdmStatus"]</span>
                </div>
                @foreach (var attr in _status.Attributes)
                {
                    <div class="ph-attrs-row">
                        <code>@attr.Attribute</code>
                        @if (attr.Present)
                        {
                            <span class="ph-chip ph-chip-ok">@Loc["AdmPresent"]</span>
                        }
                        else
                        {
                            <span class="ph-chip ph-chip-warn">@Loc["AdmMissing"]</span>
                        }
                    </div>
                }
            </div>

            <MudButton Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.RestartAlt"
                       OnClick="ResetAsync" Disabled="_resetting"
                       Style="background:var(--accent);color:var(--accent-on);font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.06em;">
                @(_resetting ? Loc["AdmResetting"] : Loc["ResetToDefaults"])
            </MudButton>
            <p class="ph-caption">
                @((MarkupString)Loc["AdmProfilesResetCaption",
                    "<code>HTTP`PROFILE`*</code>",
                    "<code>FN`*</code>"].Value)
            </p>
        }
    }
</div>

@code {
    private record AttributeStatus(string Attribute, bool Present);
    private record HandlerStatus(bool Configured, int? HandlerDbref, string? HandlerName, bool HandlerExists, List<AttributeStatus> Attributes);
    private record ResetResult(int Written, List<string> Failed);

    private HandlerStatus? _status;
    private bool _loading = true;
    private bool _resetting;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var http = HttpClientFactory.CreateClient("api");
            _status = await http.GetFromJsonAsync<HandlerStatus>("api/admin/profile-handler");
        }
        catch (HttpRequestException)
        {
            _status = null;
        }
        _loading = false;
    }

    private async Task ResetAsync()
    {
        _resetting = true;
        try
        {
            var http = HttpClientFactory.CreateClient("api");
            var response = await http.PostAsync("api/admin/profile-handler/reset", null);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ResetResult>();
                Snackbar.Add(Loc["AdmProfilesResetComplete", result?.Written ?? 0], Severity.Success);
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(Loc["AdmProfilesResetFailedStatus", (int)response.StatusCode], Severity.Error);
            }
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(Loc["AdmProfilesResetFailedError", ex.Message], Severity.Error);
        }
        _resetting = false;
    }
}
