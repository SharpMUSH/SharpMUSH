@page "/admin/profiles"
@attribute [Authorize(Policy = "players.moderate")]
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["ProfileHandler"] — @Loc["AdmBreadcrumb"] — @Loc["AppTitle"]</PageTitle>

<div class="page-stack page-stack--padded adm-profiles">
    <PlainPageHeader Kicker="@Loc["AdmGroupPortal"]" Title="@Loc["ProfileHandler"]">
        <DescriptionContent>
            @((MarkupString)Loc["AdmProfilesSubtitle",
                "<code>http_handler</code>",
                "<code>GET`CHARACTERS</code> / <code>GET`PROFILE</code>",
                "<code>&amp;FN`CHARVIS …</code>"].Value)
        </DescriptionContent>
        <Actions>
            @* The reset rewrites the handler's wizard softcode; the server takes packages.admin for it,
               so a moderator who can read the status is not offered a button that can only 403. *@
            @if (_status?.HandlerExists == true)
            {
                <AuthorizeView Policy="packages.admin">
                    <CapsuleButton Primary="true" Icon="@Icons.Material.Filled.RestartAlt" Disabled="_resetting" OnClick="ResetAsync">
                        @(_resetting ? Loc["AdmResetting"] : Loc["ResetToDefaults"])
                    </CapsuleButton>
                </AuthorizeView>
            }
        </Actions>
    </PlainPageHeader>

    <LoadState TValue="HandlerStatus" Value="_status" Loading="_loading" ProgressColor="Color.Primary" Context="status">
        <Missing>
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@Loc["AdmProfilesStatusLoadFailed"]</MudAlert>
        </Missing>
        <ChildContent>
            <KitCard Title="@Loc["AdmStatus"]">
                <div class="adm-profiles-status">
                    <div class="adm-profiles-status-row">
                        <span class="adm-profiles-status-label">@Loc["AdmProfilesConfigured"]</span>
                        <span class="adm-profiles-status-value">@(status.Configured ? Loc["AdmYes"] : Loc["AdmProfilesNotConfiguredValue"])</span>
                    </div>
                    @if (status.Configured)
                    {
                        <div class="adm-profiles-status-row">
                            <span class="adm-profiles-status-label">@Loc["AdmProfilesHandler"]</span>
                            <span class="adm-profiles-status-value">
                                @(status.HandlerExists
                                    ? $"{status.HandlerName} (#{status.HandlerDbref})"
                                    : Loc["AdmProfilesHandlerNotFound", status.HandlerDbref?.ToString() ?? string.Empty].Value)
                            </span>
                        </div>
                    }
                </div>
            </KitCard>

            @if (status.HandlerExists)
            {
                <KitCard Title="@Loc["AdmProfilesAttributesTitle"]">
                    <div class="adm-profiles-attrs-head">
                        <span>@Loc["AdmAttribute"]</span>
                        <span>@Loc["AdmStatus"]</span>
                    </div>
                    @foreach (var attr in status.Attributes)
                    {
                        <div class="adm-profiles-attrs-row">
                            <code>@attr.Attribute</code>
                            @if (attr.Present)
                            {
                                <Pill Tag="true" Class="adm-profiles-present">@Loc["AdmPresent"]</Pill>
                            }
                            else
                            {
                                <Pill Tag="true" Warn="true">@Loc["AdmMissing"]</Pill>
                            }
                        </div>
                    }
                    <AuthorizeView Policy="packages.admin">
                        <Authorized>
                            <p class="adm-profiles-caption">
                                @((MarkupString)Loc["AdmProfilesResetCaption",
                                    "<code>GET`*</code>",
                                    "<code>FN`*</code>"].Value)
                            </p>
                        </Authorized>
                        <NotAuthorized>
                            <p class="adm-profiles-caption">@Loc["AdmProfilesResetNeedsPackagesAdmin"]</p>
                        </NotAuthorized>
                    </AuthorizeView>
                </KitCard>
            }
        </ChildContent>
    </LoadState>
</div>

@code {
    private record AttributeStatus(string Attribute, bool Present);
    private record HandlerStatus(bool Configured, int? HandlerDbref, string? HandlerName, bool HandlerExists, List<AttributeStatus> Attributes);
    private record ResetResult(int Written, List<string> Failed);

    private HandlerStatus? _status;
    private bool _loading = true;
    private bool _resetting;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var http = HttpClientFactory.CreateClient("api");
            _status = await http.GetFromJsonAsync<HandlerStatus>("api/admin/profile-handler");
        }
        catch (HttpRequestException)
        {
            _status = null;
        }
        _loading = false;
    }

    private async Task ResetAsync()
    {
        _resetting = true;
        try
        {
            var http = HttpClientFactory.CreateClient("api");
            using var response = await http.PostAsync("api/admin/profile-handler/reset", null);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ResetResult>();
                // A 200 still names the attributes it could not write. The status reload below only
                // shows presence, so a failed overwrite of an edited attribute would otherwise go unseen.
                if (result?.Failed is { Count: > 0 } failed)
                {
                    Snackbar.Add(Loc["AdmProfilesResetFailedError", string.Join(", ", failed)], Severity.Error);
                }
                else
                {
                    Snackbar.Add(Loc["AdmProfilesResetComplete", result?.Written ?? 0], Severity.Success);
                }
                await LoadAsync();
            }
            else
            {
                // The server says why it refused (a version mismatch, a blocked plan); pass that on.
                var failure = ApiFailure.FromStatus(response.StatusCode, await response.Content.ReadAsStringAsync());
                Snackbar.Add(Loc["AdmProfilesResetFailedError", failure.Message], Severity.Error);
            }
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(Loc["AdmProfilesResetFailedError", ex.Message], Severity.Error);
        }
        _resetting = false;
    }
}
