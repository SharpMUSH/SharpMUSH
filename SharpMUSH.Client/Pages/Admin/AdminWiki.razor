@page "/admin/wiki"
@attribute [Authorize(Policy = "wiki.admin")]
@using SharpMUSH.Client.Models
@using SharpMUSH.Client.Resources
@using SharpMUSH.Client.Services
@using SharpMUSH.Library.Services
@using SharpMUSH.Client.Components.Wiki
@using SharpMUSH.Client.Models.Wiki
@inject WikiService Wiki
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["WikiAdmin"] — @Loc["AdmBreadcrumb"] — @Loc["AppTitle"]</PageTitle>

<div class="page-stack page-stack--padded adminwiki">
    <PlainPageHeader Kicker="@Loc["ResAdminWikiKicker"]" Title="@Loc["WikiAdmin"]" Description="@Loc["WikiAdminDescription"]" />

    <AdminStats>
        @* Tile labels are resource keys — a collection initializer cannot reach the injected Loc. *@
        @foreach (var tile in new[] {
            ("pages",        _totalPages, "ResWikiStatTotalPages", Icons.Material.Filled.Article,    false),
            ("published",    _published,  "WikiPublished",         Icons.Material.Filled.Visibility, false),
            ("drafts",       _drafts,     "ResWikiStatDrafts",     Icons.Material.Filled.EditNote,   true),
            ("restricted",   _restricted, "WikiRestricted",        Icons.Material.Filled.Lock,       true),
            ("translations", _coverage.Values.Sum(v => v.Count), "ResWikiStatTranslations", Icons.Material.Filled.Translate, false),
        })
        {
            var (key, val, labelKey, icon, warn) = tile;
            <AdminStat Key="@key" Icon="@icon" Label="@Loc[labelKey]" Warn="@warn" Value="@(_statsLoaded ? val.ToString() : "—")" />
        }
    </AdminStats>

    <KitCard Title="@Loc["WikiPagesTitle"]" Sub="@Loc["WikiPagesSub"]" Class="adminwiki-pages">
        <Controls>
            <MudTooltip Text="@Loc["Refresh"]">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" aria-label="@Loc["Refresh"]"
                               OnClick="@ReloadAsync" />
            </MudTooltip>
        </Controls>
        <ChildContent>
            <div class="adminwiki-filters">
                <TypeChips Items="@NamespaceOptions" Selected="@_namespaceFilter" SelectedChanged="@OnNamespaceFilterChanged"
                           AriaLabel="@Loc["WikiNamespaceFilter"]" />
                <div class="adminwiki-filters-fields">
                    <MudTextField @bind-Value="_searchText" Immediate="true"
                                  Placeholder="@Loc["ResSearchTitlesPlaceholder"]"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                  Class="adminwiki-filter adminwiki-filter--search" />
                    <MudSelect T="string"
                               Value="@_localeFilter"
                               ValueChanged="@SetLocaleFilterAsync"
                               Label="@Loc["WikiLocaleFilter"]"
                               Dense="true"
                               Margin="Margin.Dense"
                               Variant="Variant.Outlined"
                               Class="adminwiki-filter adminwiki-filter--locale">
                        @foreach (var option in LocaleFilterOptions)
                        {
                            var optionValue = option.Value;
                            <MudSelectItem T="string" Value="@optionValue">@option.Label</MudSelectItem>
                        }
                    </MudSelect>
                </div>
            </div>

            @if (_selected.Count > 0)
            {
                @* Bulk actions appear once there is something to act on. *@
                <div class="adminwiki-selection" role="toolbar" aria-label="@Loc["WikiSelectionActions"]">
                    <span class="adminwiki-selection-count">@Loc.Plural("WikiSelectedCount", "count", _selected.Count)</span>
                    <MudSpacer />
                    <MudTooltip Text="@Loc["WikiAddToCategory"]">
                        <MudIconButton Icon="@Icons.Material.Outlined.NewLabel" Size="Size.Small" Color="Color.Primary"
                                       aria-label="@Loc["WikiAddToCategory"]" Disabled="@_busy" OnClick="@OpenBulkCategoryDialog" />
                    </MudTooltip>
                    <MudTooltip>
                        <TooltipContent>
                            <div class="adminwiki-tip"><strong>@Loc["WikiProtect"]</strong><span>@Loc["WikiProtectHelp"]</span></div>
                        </TooltipContent>
                        <ChildContent>
                            <MudIconButton Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Color="Color.Warning"
                                           aria-label="@Loc["WikiProtect"]" Disabled="@_busy" OnClick="@(() => BatchProtectAsync(true))" />
                        </ChildContent>
                    </MudTooltip>
                    <MudTooltip>
                        <TooltipContent>
                            <div class="adminwiki-tip"><strong>@Loc["WikiUnprotect"]</strong><span>@Loc["WikiUnprotectHelp"]</span></div>
                        </TooltipContent>
                        <ChildContent>
                            <MudIconButton Icon="@Icons.Material.Filled.LockOpen" Size="Size.Small" Color="Color.Info"
                                           aria-label="@Loc["WikiUnprotect"]" Disabled="@_busy" OnClick="@(() => BatchProtectAsync(false))" />
                        </ChildContent>
                    </MudTooltip>
                    <MudTooltip Text="@Loc["WikiDelete"]">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       aria-label="@Loc["WikiDelete"]" Disabled="@_busy" OnClick="@(() => _showDeleteConfirm = true)" />
                    </MudTooltip>
                    <span class="adminwiki-selection-rule" aria-hidden="true"></span>
                    <MudTooltip Text="@Loc["WikiClearSelection"]">
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                       aria-label="@Loc["WikiClearSelection"]" OnClick="@(() => _selected = [])" />
                    </MudTooltip>
                </div>
            }

            <div class="adminwiki-grid-scroll">
            <MudDataGrid @ref="_grid"
                         T="WikiPageSummary"
                         ServerData="LoadServerData"
                         MultiSelection="true"
                         @bind-SelectedItems="_selected"
                         Dense="true"
                         Hover="true"
                         Class="mush-dark-grid adminwiki-grid"
                         Elevation="0">
                <Columns>
                    <SelectColumn T="WikiPageSummary" />
                    <TemplateColumn Title="@Loc["WikiTitle"]" Sortable="false">
                        <CellTemplate>
                            <div class="adminwiki-title">
                                <div class="adminwiki-title-line">
                                    @if (context.Item.IsRestricted)
                                    {
                                        <MudTooltip Text="@Loc["WikiRestricted"]">
                                            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Color="Color.Warning" Class="adminwiki-lock" />
                                        </MudTooltip>
                                    }
                                    <MudLink Href="@PageHref(context.Item)" Class="adminwiki-title-link">@context.Item.Title</MudLink>
                                </div>
                                <span class="adminwiki-title-ref">@context.Item.Namespace.ToLowerInvariant() / @context.Item.Slug</span>
                            </div>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="@Loc["NavWikiCategories"]" Sortable="false">
                        <CellTemplate>
                            <div class="adminwiki-cats">
                                @foreach (var category in context.Item.Categories)
                                {
                                    <a class="adminwiki-cat" href="@WikiCategories.Route(category)">@WikiHelpers.CategoryLabel(category, _categoryNames)</a>
                                }
                            </div>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="@Loc["WikiPublished"]" Sortable="false">
                        <CellTemplate>
                            <Pill Tag="true" Warn="@(!context.Item.Published)">
                                @(context.Item.Published ? Loc["WikiPublished"] : Loc["ResDraft"])
                            </Pill>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="@Loc["WikiUpdated"]" Sortable="false">
                        <CellTemplate>
                            <div class="adminwiki-updated">
                                <span>@context.Item.UpdatedAt.LocalDateTime.ToString("MMM d, yyyy")</span>
                                <span class="adminwiki-rev">@string.Format(Loc["WikiRevisionShort"], context.Item.RevisionNumber)</span>
                            </div>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="@Loc["WikiTranslations"]" Sortable="false">
                        <CellTemplate>
                            @{
                                var locales = CoverageFor(context.Item);
                            }
                            <span class="@($"admin-wiki-coverage{(locales.Count == 0 ? " admin-wiki-coverage-none" : "")}")">
                                @if (locales.Count == 0)
                                {
                                    <MudTooltip Text="@Loc["WikiUntranslatedOnly"]">
                                        <MudIcon Icon="@Icons.Material.Outlined.Translate" Size="Size.Small" Color="Color.Warning"
                                                 Class="adminwiki-untranslated" />
                                    </MudTooltip>
                                }
                                else
                                {
                                    @foreach (var locale in locales)
                                    {
                                        <span class="adminwiki-locale">@locale</span>
                                    }
                                }
                            </span>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Sortable="false" CellClass="adminwiki-actions-cell">
                        <CellTemplate>
                            <div class="adminwiki-actions">
                                <MudTooltip Text="@Loc["WikiEdit"]">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="@Loc["WikiEdit"]"
                                                   Href="@($"{WikiHref(context.Item)}/edit")" />
                                </MudTooltip>
                                <MudTooltip Text="@Loc["WikiEditMetadata"]">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Label" Size="Size.Small" aria-label="@Loc["WikiEditMetadata"]"
                                                   OnClick="@(() => OpenMetadataDialog(context.Item))" />
                                </MudTooltip>
                                <MudTooltip Text="@Loc["ResHistory"]">
                                    <MudIconButton Icon="@Icons.Material.Filled.History" Size="Size.Small" aria-label="@Loc["ResHistory"]"
                                                   Href="@($"{WikiHref(context.Item)}/history")" />
                                </MudTooltip>
                            </div>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <NoRecordsContent>
                    <MudText Color="Color.Secondary">@Loc["WikiNoPages"]</MudText>
                </NoRecordsContent>
                <PagerContent>
                    <MudDataGridPager T="WikiPageSummary" />
                </PagerContent>
            </MudDataGrid>
            </div>
        </ChildContent>
    </KitCard>

    <KitCard Title="@Loc["NavWikiCategories"]" Sub="@Loc["WikiCategoriesSub"]" Class="adminwiki-categories">
        <form class="adminwiki-newcat" @onsubmit="@CreateCategoryAsync" @onsubmit:preventDefault="true">
            <MudTextField T="string" @bind-Value="_newCategoryName" Immediate="true"
                          Label="@Loc["WikiNewCategoryName"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Class="adminwiki-newcat-name" />
            <MudTextField T="string" @bind-Value="_newCategoryDescription" Immediate="true"
                          Label="@Loc["WikiNewCategoryDescription"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Class="adminwiki-newcat-desc" />
            <MudTooltip Text="@Loc["WikiCreateCategory"]">
                <MudIconButton Icon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary"
                               ButtonType="ButtonType.Submit" aria-label="@Loc["WikiCreateCategory"]"
                               Disabled="@(_busy || WikiCategories.Key(_newCategoryName).Length == 0 || NewCategoryExists)" />
            </MudTooltip>
        </form>
        @if (NewCategoryExists)
        {
            <div class="adminwiki-newcat-note">@string.Format(Loc["WikiCategoryExists"], _newCategoryName.Trim())</div>
        }

        @if (_categories is null)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
        }
        else if (_categories.Count == 0)
        {
            <div class="adminwiki-empty">@Loc["WikiNoCategories"]</div>
        }
        else
        {
            <div class="adminwiki-catlist">
                @foreach (var category in _categories)
                {
                    var c = category;
                    <div class="@($"adminwiki-catcard{(c.HasPage ? null : " adminwiki-catcard--nopage")}")">
                        <a class="adminwiki-catcard-link" href="@WikiCategories.Route(c.Key)"
                           title="@(c.HasPage ? null : Loc["WikiCategoryNoPage"].Value)">
                            <MudIcon Icon="@(c.HasPage ? Icons.Material.Filled.Label : Icons.Material.Outlined.Label)" Size="Size.Small"
                                     Class="adminwiki-catcard-icon" />
                            <span class="adminwiki-catcard-name">@c.Name</span>
                            <span class="adminwiki-catcard-count">@c.Pages</span>
                        </a>
                        <WikiCategoryPinButton Category="@c.Key" Name="@c.Name" Pinned="@c.Pinned" Compact="true"
                                               PinnedChanged="@(pinned => SetPinned(c.Key, pinned))" />
                    </div>
                }
            </div>
        }
    </KitCard>

    @* What each namespace requires, editable here; categories and pages are edited on their own pages and
       listed here so an admin can find every rule in one place. *@
    <KitCard Title="@Loc["WikiRequirementsTitle"]" Sub="@Loc["WikiRequirementsAdminSub"]" Class="adminwiki-requirements">
        @if (_requirements is not null)
        {
            <div class="adminwiki-requirements-grid">
                @foreach (var key in RequirementNamespaces)
                {
                    <WikiRequirementsEditor @key="@("namespace/" + key)" Scope="namespace" Key="@key" Editable="true"
                                            Kicker="@Loc["WikiRequirementsKindNamespace"]" Heading="@NamespaceName(key)"
                                            Sub="@Loc[NamespaceSubKey(key)]"
                                            Set="@_requirements.FirstOrDefault(r => r.Scope == "namespace" && r.Key == key)"
                                            SetChanged="@(_ => LoadRequirementsAsync())" />
                }
                @foreach (var rule in _requirements.Where(r => r.Scope != "namespace"))
                {
                    <WikiRequirementsEditor @key="@(rule.Scope + "/" + rule.Key)" Scope="@rule.Scope" Key="@rule.Key" Set="@rule" Editable="true"
                                            Kicker="@Loc[rule.Scope == "category" ? "WikiRequirementsKindCategory" : "WikiRequirementsKindPage"]"
                                            Heading="@(rule.Scope == "category" ? WikiHelpers.CategoryLabel(rule.Key, _categoryNames) : rule.Label)"
                                            SetChanged="@(_ => LoadRequirementsAsync())" />
                }
            </div>
        }
    </KitCard>
</div>

<ConfirmDialog @bind-Visible="_showDeleteConfirm" Title="@Loc["WikiDeleteConfirmTitle"]" ConfirmText="@Loc["WikiDelete"]"
               Busy="_busy" OnConfirm="BatchDeleteAsync">
    <MudText>@Loc.Plural("WikiDeleteConfirmText", "count", _selected.Count)</MudText>
</ConfirmDialog>

<MudDialog @bind-Visible="_showMetadataDialog" Options="@DialogOptions">
    <TitleContent>
        <div class="adminwiki-dialog-title">
            <span class="adminwiki-dialog-kicker">@Loc["WikiEditMetadata"]</span>
            <span>@_metadataTarget?.Title</span>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="adminwiki-dialog-body">
            <div class="adminwiki-dialog-label">@Loc["NavWikiCategories"]</div>
            <WikiCategoryPicker Categories="@_metaCategories" Known="@(_categories ?? [])" CategoriesChanged="@StateHasChanged" />
            <MudSwitch T="bool" @bind-Value="_metaPublished" Color="Color.Success" Label="@Loc["WikiPublished"]" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showMetadataDialog = false)">@Loc["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@_busy" OnClick="@SaveMetadataAsync">
            @Loc["Save"]
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_showBulkCategoryDialog" Options="@DialogOptions">
    <TitleContent>
        <div class="adminwiki-dialog-title">
            <span class="adminwiki-dialog-kicker">@Loc["WikiAddToCategory"]</span>
            <span>@Loc.Plural("WikiSelectedCount", "count", _selected.Count)</span>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="adminwiki-dialog-body">
            <div class="adminwiki-dialog-hint">@Loc["WikiAddToCategoryHint"]</div>
            <WikiCategoryPicker Categories="@_bulkCategories" Known="@(_categories ?? [])" CategoriesChanged="@StateHasChanged" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showBulkCategoryDialog = false)">@Loc["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_busy || _bulkCategories.Count == 0)"
                   OnClick="@SaveBulkCategoriesAsync">
            @Loc["WikiAddToCategory"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudDataGrid<WikiPageSummary>? _grid;
    private HashSet<WikiPageSummary> _selected = [];
    private string _namespaceFilter = string.Empty;
    private string _searchText = string.Empty;
    private bool _busy;

    /// <summary>
    /// Translation locales per page ref, loaded after paging. One extra request per visible row: the grid
    /// pages at 25–50, and the spec is explicit that a denormalized coverage cache must be measured for
    /// before it is added.
    /// </summary>
    private readonly Dictionary<string, IReadOnlyList<string>> _coverage = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>Empty = every page; "fr" = pages having fr; "fr:missing" = pages lacking fr.</summary>
    private string _localeFilter = string.Empty;

    private const string MissingSuffix = ":missing";

    /// <summary>The filter value selecting pages that lack <paramref name="locale"/>.</summary>
    private static string MissingFilterValue(string locale) => $"{locale}{MissingSuffix}";

    /// <summary>
    /// The locale filter's options: "all", then each portal locale and its "missing only" companion.
    /// </summary>
    /// <remarks>
    /// Public because a MudSelect does not render its items into the DOM until its popover opens, so a
    /// component test asserting on markup cannot see them. Reading the option set directly asserts what
    /// the filter actually offers instead of what happens to have been rendered.
    /// </remarks>
    public IReadOnlyList<(string Value, string Label)> LocaleFilterOptions =>
    [
        (string.Empty, Loc["WikiAllLocales"]),
        .. PortalLocales.Codes.SelectMany(locale => new[]
        {
            (locale, PortalLocales.DisplayName(locale)),
            (MissingFilterValue(locale), $"{PortalLocales.DisplayName(locale)} — {Loc["WikiUntranslatedOnly"]}"),
        }),
    ];

    private static readonly DialogOptions DialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };

    /// <summary>The namespace filter's chips: every page, then each namespace.</summary>
    private IReadOnlyList<(string Key, string Label)> NamespaceOptions =>
    [
        (string.Empty, Loc["WikiAllNamespaces"]),
        .. Enum.GetValues<SharpMUSH.Library.Models.Wiki.WikiNamespace>()
            .Select(ns => (WikiHelpers.NamespaceName(ns), ns.ToString())),
    ];

    private bool _showDeleteConfirm;
    private bool _showMetadataDialog;
    private WikiPageSummary? _metadataTarget;
    private bool _metaPublished = true;
    private List<string> _metaCategories = [];

    private bool _showBulkCategoryDialog;
    private List<string> _bulkCategories = [];

    /// <summary>Every category, with its name and page count; null until loaded.</summary>
    private List<WikiCategorySummaryDto>? _categories;

    private string _newCategoryName = string.Empty;
    private string _newCategoryDescription = string.Empty;

    /// <summary>True when the name being typed is a category that already has its page.</summary>
    private bool NewCategoryExists =>
        WikiCategories.Key(_newCategoryName) is { Length: > 0 } key && _categories?.Any(c => c.Key == key && c.HasPage) == true;

    private bool _statsLoaded;
    private int _totalPages;
    private int _published;
    private int _drafts;
    private int _restricted;

    /// <summary>Each category's name (its category page's title); a category with no page shows its key.</summary>
    private IReadOnlyDictionary<string, string>? _categoryNames;

    private static readonly string[] RequirementNamespaces = ["main", "help", "character", "system", "category"];

    private static string NamespaceName(string key) => char.ToUpperInvariant(key[0]) + key[1..];

    private static string NamespaceSubKey(string key) => key switch
    {
        "main" => "WikiNsMainSub",
        "help" => "WikiNsHelpSub",
        "character" => "WikiNsCharacterSub",
        "system" => "WikiNsSystemSub",
        _ => "WikiNsCategorySub",
    };

    /// <summary>Every requirement set; null until loaded.</summary>
    private List<WikiRequirementSetDto>? _requirements;

    protected override async Task OnInitializedAsync()
    {
        var categories = LoadCategoriesAsync();
        var requirements = LoadRequirementsAsync();
        await LoadStatsAsync();
        await categories;
        await requirements;
    }

    /// <summary>Keeps the card's row in step with a pin the server accepted.</summary>
    private void SetPinned(string key, bool pinned)
    {
        if (_categories?.FindIndex(c => c.Key == key) is { } index and >= 0)
            _categories[index] = _categories[index] with { Pinned = pinned };
    }

    private async Task LoadCategoriesAsync()
    {
        if (await Wiki.GetCategoriesAsync() is not List<WikiCategorySummaryDto> categories) return;
        _categories = categories;
        _categoryNames = categories.Where(c => c.HasPage).ToDictionary(c => c.Key, c => c.Name, StringComparer.Ordinal);
    }

    /// <summary>
    /// Makes a category: its page in the category namespace, titled with the name exactly as typed, with the
    /// description as its text.
    /// </summary>
    private async Task CreateCategoryAsync()
    {
        var name = _newCategoryName.Trim();
        if (WikiCategories.Key(name).Length == 0 || NewCategoryExists || _busy) return;
        _busy = true;
        try
        {
            switch (await Wiki.CreatePageAsync(name, _newCategoryDescription.Trim(), "category"))
            {
                case WikiArticle:
                    Snackbar.Add(string.Format(Loc["WikiCategoryCreated"], name), Severity.Success);
                    _newCategoryName = string.Empty;
                    _newCategoryDescription = string.Empty;
                    break;
                case ApiFailure failure:
                    Snackbar.Add(string.Format(Loc["WikiCategoryCreateFailed"], failure.Message), Severity.Error);
                    break;
            }

            await LoadCategoriesAsync();
            await ReloadAsync();
        }
        finally { _busy = false; }
    }

    private async Task LoadRequirementsAsync()
    {
        if (await Wiki.GetAllRequirementsAsync() is List<WikiRequirementSetDto> sets)
            _requirements = sets;
    }

    private async Task LoadStatsAsync()
    {
        if (await Wiki.GetCountsAsync() is WikiPageCountsDto counts)
        {
            _totalPages = counts.Total;
            _published = counts.Published;
            _drafts = counts.Drafts;
            _restricted = counts.Restricted;
            _statsLoaded = true;
        }
    }

    private async Task<GridData<WikiPageSummary>> LoadServerData(GridState<WikiPageSummary> state, CancellationToken _)
    {
        var ns = string.IsNullOrEmpty(_namespaceFilter) ? null : _namespaceFilter;
        var (items, total) = await Wiki.GetAllPagesAsync(
            skip: state.Page * state.PageSize,
            take: state.PageSize,
            ns: ns);

        await LoadCoverageAsync(items);

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var q = _searchText;
            var filtered = ApplyLocaleFilter(items.Where(p => p.Title.Contains(q, StringComparison.OrdinalIgnoreCase)
                                         || p.Slug.Contains(q, StringComparison.OrdinalIgnoreCase))).ToList();
            return new GridData<WikiPageSummary> { Items = filtered, TotalItems = filtered.Count };
        }

        if (_localeFilter.Length > 0)
        {
            // Filtering after paging makes the total the filtered page's own count, exactly as the search
            // box above already does. Coverage is not on the page row, so the server cannot filter on it.
            var byLocale = ApplyLocaleFilter(items).ToList();
            return new GridData<WikiPageSummary> { Items = byLocale, TotalItems = byLocale.Count };
        }

        return new GridData<WikiPageSummary> { Items = items, TotalItems = total };
    }

    /// <summary>Public so component tests can drive the filter without simulating MudSelect internals.</summary>
    public async Task SetLocaleFilterAsync(string value)
    {
        _localeFilter = value;
        await ReloadAsync();
    }

    private IReadOnlyList<string> CoverageFor(WikiPageSummary page) =>
        _coverage.TryGetValue(RefFor(page), out var locales) ? locales : [];

    /// <summary>Applies the locale filter to an already-paged set of rows.</summary>
    private IEnumerable<WikiPageSummary> ApplyLocaleFilter(IEnumerable<WikiPageSummary> pages)
    {
        if (_localeFilter.Length == 0) return pages;

        var missing = _localeFilter.EndsWith(MissingSuffix, StringComparison.Ordinal);
        var locale = missing ? _localeFilter[..^MissingSuffix.Length] : _localeFilter;

        return pages.Where(p =>
        {
            var has = CoverageFor(p).Any(l => WikiHelpers.SameLanguage(l, locale));
            return missing ? !has : has;
        });
    }

    /// <summary>Fills <see cref="_coverage"/> for the rows currently on screen.</summary>
    private async Task LoadCoverageAsync(IEnumerable<WikiPageSummary> pages)
    {
        foreach (var page in pages)
        {
            var reference = RefFor(page);
            if (_coverage.ContainsKey(reference)) continue;
            var translations = await Wiki.GetTranslationsAsync(page.Slug, page.Namespace);
            _coverage[reference] = translations.Select(t => t.Locale).ToList();
        }
    }

    /// <summary>Where the page is read — the profile alias for character biographies.</summary>
    private static string PageHref(WikiPageSummary page) =>
        WikiRoutes.PathFor(page.Namespace, page.Slug);

    /// <summary>Base for the management actions. /edit and /history exist only under /wiki,
    /// so these must not be built from a page's profile alias.</summary>
    private static string WikiHref(WikiPageSummary page) =>
        WikiRoutes.WikiPathFor(page.Namespace, page.Slug);

    private static string RefFor(WikiPageSummary page) =>
        $"{page.Namespace.ToLowerInvariant()}/{page.Slug}";

    private async Task OnNamespaceFilterChanged(string value)
    {
        _namespaceFilter = value;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _selected = [];
        await LoadStatsAsync();
        if (_grid is not null)
            await _grid.ReloadServerData();
    }

    private async Task BatchProtectAsync(bool isProtected)
    {
        if (_selected.Count == 0) return;
        _busy = true;
        try
        {
            var result = await Wiki.BatchProtectAsync(_selected.Select(RefFor), isProtected);
            ReportBatchResult(result);
            await ReloadAsync();
            await LoadRequirementsAsync();
        }
        finally { _busy = false; }
    }

    private async Task BatchDeleteAsync()
    {
        if (_selected.Count == 0) return;
        _busy = true;
        try
        {
            var result = await Wiki.BatchDeleteAsync(_selected.Select(RefFor));
            ReportBatchResult(result);
            _showDeleteConfirm = false;
            await LoadCategoriesAsync();
            await ReloadAsync();
        }
        finally { _busy = false; }
    }

    private void ReportBatchResult(ApiResult<WikiBatchResult> result)
    {
        switch (result)
        {
            case WikiBatchResult ok:
                if (ok.Succeeded.Count > 0)
                    Snackbar.Add(Loc.Plural("WikiBatchSucceeded", "count", ok.Succeeded.Count), Severity.Success);
                if (ok.Failed.Count > 0)
                    Snackbar.Add(Loc.Plural("WikiBatchFailed", "count", ok.Failed.Count), Severity.Error);
                break;
            case ApiFailure failure:
                Snackbar.Add(failure.Message, Severity.Error);
                break;
        }
    }

    private void OpenMetadataDialog(WikiPageSummary page)
    {
        _metadataTarget = page;
        _metaPublished = page.Published;
        _metaCategories = [.. page.Categories];
        _showMetadataDialog = true;
    }

    private void OpenBulkCategoryDialog()
    {
        _bulkCategories = [];
        _showBulkCategoryDialog = true;
    }

    /// <summary>Files every selected page in the chosen categories too, keeping the ones it is already in.</summary>
    private async Task SaveBulkCategoriesAsync()
    {
        if (_selected.Count == 0 || _bulkCategories.Count == 0) return;
        _busy = true;
        try
        {
            int succeeded = 0, failed = 0;
            foreach (var page in _selected)
            {
                var categories = new List<string>(page.Categories);
                foreach (var category in _bulkCategories) WikiCategories.Add(categories, category);
                if (await Wiki.SetMetadataAsync(page.Slug, categories, page.Published, page.Namespace) is WikiArticle) succeeded++;
                else failed++;
            }

            if (succeeded > 0) Snackbar.Add(Loc.Plural("WikiBatchSucceeded", "count", succeeded), Severity.Success);
            if (failed > 0) Snackbar.Add(Loc.Plural("WikiBatchFailed", "count", failed), Severity.Error);
            _showBulkCategoryDialog = false;
            await LoadCategoriesAsync();
            await ReloadAsync();
        }
        finally { _busy = false; }
    }

    private async Task SaveMetadataAsync()
    {
        if (_metadataTarget is null) return;
        _busy = true;
        try
        {
            var result = await Wiki.SetMetadataAsync(_metadataTarget.Slug, _metaCategories, _metaPublished, _metadataTarget.Namespace);
            switch (result)
            {
                case WikiArticle:
                    Snackbar.Add(string.Format(Loc["WikiMetadataSaved"], _metadataTarget.Title), Severity.Success);
                    break;
                case ApiFailure failure:
                    Snackbar.Add(string.Format(Loc["WikiMetadataSaveFailed"], failure.Message), Severity.Error);
                    break;
            }
            _showMetadataDialog = false;
            await LoadCategoriesAsync();
            await ReloadAsync();
        }
        finally { _busy = false; }
    }
}
