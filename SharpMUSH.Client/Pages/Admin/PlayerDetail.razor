@page "/admin/players/{Id:int}"
@attribute [Authorize(Policy = "players.view")]
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["AdmPlayerNumber", Id] — @Loc["AdmBreadcrumb"] — @Loc["AppTitle"]</PageTitle>

<div style="padding:var(--cpad);">
    <div class="ph-header">
        <div class="ph-kicker">@Loc["AdmPlayerDetailKicker"]</div>
        <h1 class="ph-title">@Loc["AdmPlayerNumber", Id]</h1>
    </div>

    <div class="ph-empty">
        <MudIcon Icon="@Icons.Material.Filled.Person" Class="ph-empty-icon" />
        <div class="ph-empty-text">@Loc["AdmPlayerDetailComingSoon"]</div>
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }
}
