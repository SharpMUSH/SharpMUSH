@page "/admin/players/{Id:int}"
@attribute [Authorize(Policy = "players.view")]
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["AdmPlayerNumber", Id] — @Loc["AdmBreadcrumb"] — @Loc["AppTitle"]</PageTitle>

<AdminComingSoon Kicker="@Loc["AdmPlayerDetailKicker"]" Title="@Loc["AdmPlayerNumber", Id]" Icon="@Icons.Material.Filled.Person" Message="@Loc["AdmPlayerDetailComingSoon"]" />

@code {
    [Parameter]
    public int Id { get; set; }
}
