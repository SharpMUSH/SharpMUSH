@page "/admin/config/restrictions"
@layout ConfigLayout
@attribute [Authorize(Policy = "config.admin")]
@using SharpMUSH.Client.Components.Admin
@using SharpMUSH.Client.Services
@inject RestrictionsService RestrictionsService
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["Restrictions"] - @Loc["Configuration"]</PageTitle>

<div class="config-section-page">
    <PlainPageHeader Kicker="@Loc["ResConfigSectionKicker"]" Title="@Loc["CommandAndFunctionRestrictions"]" Description="@Loc["RestrictionsDescription"]" />

    @* The kit's chips switch the two lists, as on the media library. Only the chosen list is rendered,
       and each branch is its own component, so switching loads that list afresh. *@
    <div class="page-stack restr-body">
        <TypeChips Items="@Tables" Selected="@_table" SelectedChanged="@(t => _table = t)" AriaLabel="@Loc["Restrictions"]" />

        @if (_table == FunctionsTable)
        {
            <AdminKeyValueList Text="@FunctionText"
                               Load="@(() => RestrictionsService.GetFunctionRestrictionsAsync().AsEntriesAsync())"
                               Add="@RestrictionsService.AddFunctionRestrictionAsync"
                               Delete="@RestrictionsService.DeleteFunctionRestrictionAsync" />
        }
        else
        {
            <AdminKeyValueList Text="@CommandText"
                               Load="@(() => RestrictionsService.GetCommandRestrictionsAsync().AsEntriesAsync())"
                               Add="@RestrictionsService.AddCommandRestrictionAsync"
                               Delete="@RestrictionsService.DeleteCommandRestrictionAsync" />
        }
    </div>
</div>

@code {
    private const string CommandsTable = "commands";
    private const string FunctionsTable = "functions";

    private string _table = CommandsTable;

    private IReadOnlyList<(string Key, string Label)> Tables =>
    [
        (CommandsTable, Loc["CommandRestrictions"]),
        (FunctionsTable, Loc["FunctionRestrictions"]),
    ];

    // The two tables are the same list with the nouns swapped, which is why this page used to be its
    // own body written twice.
    private AdminKeyValueListText CommandText => new(
        AddTitle: Loc["AddCommandRestriction"],
        KeyLabel: Loc["CommandName"],
        KeyPlaceholder: Loc["CommandNameHelper"],
        AddButton: Loc["Add"],
        ListTitle: Loc["ConfiguredCommandRestrictions"],
        Empty: Loc["NoCommandRestrictions"],
        Added: name => string.Format(Loc["CommandRestrictionAdded"], name),
        Removed: name => string.Format(Loc["CommandRestrictionRemoved"], name),
        LoadFailed: failure => string.Format(Loc["ErrorLoadingRestrictions"], failure.Message),
        AddFailed: (_, failure) => string.Format(Loc["ErrorAddingCommandRestriction"], failure.Message),
        RemoveFailed: (_, failure) => string.Format(Loc["ErrorRemovingCommandRestriction"], failure.Message))
    {
        ValuesLabel = Loc["RestrictionsLabel"],
        ValuesPlaceholder = Loc["RestrictionsHelper"],
        ValuesRequired = Loc["AtLeastOneRestriction"],
    };

    private AdminKeyValueListText FunctionText => CommandText with
    {
        AddTitle = Loc["AddFunctionRestriction"],
        KeyLabel = Loc["FunctionName"],
        KeyPlaceholder = Loc["FunctionNameHelper"],
        ListTitle = Loc["ConfiguredFunctionRestrictions"],
        Empty = Loc["NoFunctionRestrictions"],
        Added = name => string.Format(Loc["FunctionRestrictionAdded"], name),
        Removed = name => string.Format(Loc["FunctionRestrictionRemoved"], name),
        ValuesPlaceholder = Loc["RestrictionsBuilderHelper"],
        AddFailed = (_, failure) => string.Format(Loc["ErrorAddingFunctionRestriction"], failure.Message),
        RemoveFailed = (_, failure) => string.Format(Loc["ErrorRemovingFunctionRestriction"], failure.Message),
    };
}
