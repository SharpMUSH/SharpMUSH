@page "/register"
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["AuthCreateAccount"] — @Loc["AppTitle"]</PageTitle>

@code {
    // Registration now lives solely in Login.razor's Register tab; this route stays for existing
    // links/bookmarks and forwards to the single chromeless auth surface.
    protected override void OnInitialized()
        => Nav.NavigateTo("/login?tab=register", replace: true);
}
