@page "/wiki/casefiles/{Key}"
@layout WikiLayout
@attribute [Authorize]
@using SharpMUSH.Library.DiscriminatedUnions
@using SharpMUSH.Client.Models.Wiki
@inject CasefileClient Casefiles
@inject WikiService Wiki
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@(_casefile?.Summary.Title ?? Loc["WkCasefile"]) — <GameName /></PageTitle>

@* One case file: a single wiki page in the Case Files category, shown here with who is in it. Contributors post the
   next development, which goes to the top of the page's Developments section, and edit the page in the wiki editor;
   leads also let people in and out. The page's own history and links work as on any wiki page. *@
<div class="casefile">
    @if (_missing)
    {
        <PageHeader Kicker="@Loc["WkCasefile"]" Title="@Loc["WkCasefileMissing"]" Description="@Loc["WkCasefileMissingSub"]">
            <Actions>
                <CapsuleButton Icon="@Icons.Material.Outlined.ChevronLeft" Href="/wiki/casefiles">@Loc["WkCasefiles"]</CapsuleButton>
            </Actions>
        </PageHeader>
    }
    else if (_loadError is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_loadError</MudAlert>
    }
    else if (_casefile is not { } casefile)
    {
        <RouteSkeleton />
    }
    else
    {
        <PageHeader Kicker="@Loc["WkCasefile"]" Title="@casefile.Summary.Title">
            <Actions>
                <CapsuleButton Icon="@Icons.Material.Outlined.ChevronLeft" Href="/wiki/casefiles">@Loc["WkCasefiles"]</CapsuleButton>
                <Pill Tag="true" Class="@($"casefile-level casefile-level--{casefile.Summary.Level}")">@Loc["WkCasefileYouAre"] @LevelLabel(casefile.Summary.Level)</Pill>
            </Actions>
        </PageHeader>

        <div class="casefile-columns">
            <div class="casefile-main">
                <KitCard Class="casefile-page-card" Title="@Loc["WkCasefilePage"]" Sub="@Loc["WkCasefilePageSub"]">
                    <Controls>
                        @if (casefile.CanContribute && !_posting)
                        {
                            <CapsuleButton Primary="true" Icon="@Icons.Material.Outlined.PostAdd" Class="casefile-post-open"
                                           OnClick="@(() => _posting = true)">@Loc["WkCasefilePost"]</CapsuleButton>
                        }
                        @if (casefile.CanContribute)
                        {
                            <CapsuleButton Icon="@Icons.Material.Outlined.Edit" Class="casefile-edit"
                                           Href="@(WikiRoutes.WikiPathFor("main", casefile.Summary.Key) + "/edit")">@Loc["WkCasefileEdit"]</CapsuleButton>
                        }
                        <CapsuleButton Icon="@Icons.Material.Outlined.History" Href="@(WikiRoutes.WikiPathFor("main", casefile.Summary.Key) + "/history")">@Loc["WkCasefileHistory"]</CapsuleButton>
                    </Controls>
                    <ChildContent>
                        @if (_posting)
                        {
                            <div class="casefile-form casefile-post-form">
                                <MudTextField T="string" @bind-Value="_postTitle" Immediate="true" Class="casefile-post-title" Margin="Margin.Dense"
                                              Variant="Variant.Outlined" Label="@Loc["WkCasefilePostTitle"]" Placeholder="@Loc["WkCasefilePostTitlePlaceholder"]" />
                                <MudTextField T="string" @bind-Value="_postText" Immediate="true" Class="casefile-post-text" Lines="5"
                                              Variant="Variant.Outlined" Label="@Loc["WkCasefilePostText"]" Placeholder="@Loc["WkCasefilePostTextPlaceholder"]" />
                                @if (_postError is not null)
                                {
                                    <MudAlert Severity="Severity.Warning" Dense="true" Class="casefile-error">@_postError</MudAlert>
                                }
                                <div class="casefile-buttons">
                                    <CapsuleButton Primary="true" Class="casefile-post-submit"
                                                   Disabled="@(string.IsNullOrWhiteSpace(_postTitle) || string.IsNullOrWhiteSpace(_postText) || _busy)"
                                                   OnClick="PostAsync">@Loc["WkCasefilePost"]</CapsuleButton>
                                    <CapsuleButton OnClick="ClosePost">@Loc["Cancel"]</CapsuleButton>
                                </div>
                            </div>
                        }
                        @if (_pageHtml is { Length: > 0 } html)
                        {
                            <div class="wiki-content casefile-html">@((MarkupString)html)</div>
                        }
                    </ChildContent>
                </KitCard>
            </div>

            <aside class="casefile-aside">
                <KitCard Aside="true" Class="casefile-members-card" Title="@Loc["WkCasefileMembers"]" Sub="@Loc["WkCasefileMembersSub"]">
                    <ul class="casefile-members">
                        @foreach (var member in casefile.Members)
                        {
                            <li class="casefile-member">
                                <MudIcon Icon="@(member.Kind == "role" ? Icons.Material.Outlined.Groups : Icons.Material.Outlined.Person)" Size="Size.Small" />
                                <span class="casefile-member-name">@(member.Kind == "role" ? string.Format(Loc["WkCasefileRoleMember"], member.Name) : member.Name)</span>
                                @if (casefile.CanLead)
                                {
                                    <select class="casefile-member-level" name="@($"member-level-{member.Principal}")" aria-label="@string.Format(Loc["WkCasefileLevelOf"], member.Name)"
                                            value="@member.Level" @onchange="@(e => SetLevelAsync(member, e.Value?.ToString()))">
                                        @foreach (var level in CasefileLevels.All)
                                        {
                                            <option value="@level">@LevelLabel(level)</option>
                                        }
                                    </select>
                                    <button type="button" class="casefile-member-remove" title="@Loc["WkCasefileRemove"]"
                                            aria-label="@string.Format(Loc["WkCasefileRemoveWho"], member.Name)" @onclick="@(() => RemoveAsync(member))">
                                        <MudIcon Icon="@Icons.Material.Outlined.PersonRemove" Size="Size.Small" />
                                    </button>
                                }
                                else
                                {
                                    <Pill Tag="true" Class="@($"casefile-level casefile-level--{member.Level}")">@LevelLabel(member.Level)</Pill>
                                }
                            </li>
                        }
                    </ul>
                    @if (casefile.CanLead)
                    {
                        <form class="casefile-inline-form casefile-add-member" @onsubmit="AddAsync" @onsubmit:preventDefault>
                            <input type="text" name="member-who" placeholder="@Loc["WkCasefileAddWho"]" aria-label="@Loc["WkCasefileAddWho"]"
                                   value="@_who" @oninput="@(e => _who = e.Value?.ToString() ?? string.Empty)" />
                            <select class="casefile-member-level" name="member-level" aria-label="@Loc["WkCasefileAddLevel"]" value="@_whoLevel"
                                    @onchange="@(e => _whoLevel = e.Value?.ToString() ?? "reader")">
                                @foreach (var level in CasefileLevels.All)
                                {
                                    <option value="@level">@LevelLabel(level)</option>
                                }
                            </select>
                            <CapsuleButton Icon="@Icons.Material.Outlined.PersonAdd" Disabled="@(string.IsNullOrWhiteSpace(_who) || _busy)" OnClick="AddAsync">@Loc["WkCasefileAdd"]</CapsuleButton>
                        </form>
                        <p class="casefile-hint">@Loc["WkCasefileAddHint"]</p>
                    }
                    @if (_memberError is not null)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="casefile-error">@_memberError</MudAlert>
                    }
                </KitCard>
            </aside>
        </div>
    }
</div>

@code {
    [Parameter] public string Key { get; set; } = string.Empty;

    private CasefileDto? _casefile;
    private bool _missing;
    private string? _loadError;
    private string? _pageHtml;

    private bool _busy;
    private bool _posting;
    private string _postTitle = string.Empty;
    private string _postText = string.Empty;
    private string? _postError;

    private string _who = string.Empty;
    private string _whoLevel = "reader";
    private string? _memberError;

    private string? _shownKey;

    protected override async Task OnParametersSetAsync()
    {
        // Moving from one case file to another reuses this page: nothing typed or refused on the last one carries over.
        if (_shownKey != Key)
        {
            _shownKey = Key;
            _casefile = null;
            _missing = false;
            _loadError = null;
            _pageHtml = null;
            _who = string.Empty;
            _memberError = null;
            ClosePost();
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        switch (await Casefiles.GetAsync(Key))
        {
            case CasefileDto casefile:
                _casefile = casefile;
                _pageHtml = await Wiki.GetWikiArticle(casefile.Summary.Key, "main") is WikiArticle page ? page.RenderedHtml : null;
                break;
            case SharpMUSH.Library.DiscriminatedUnions.NotFound:
                _missing = true;
                break;
            case Error<string> error:
                _loadError = error.Value;
                break;
        }
    }

    private void ClosePost()
    {
        _posting = false;
        _postError = null;
        _postTitle = string.Empty;
        _postText = string.Empty;
    }

    private async Task PostAsync()
    {
        _busy = true;
        _postError = null;
        switch (await Casefiles.PostAsync(Key, _postTitle.Trim(), _postText))
        {
            case bool:
                ClosePost();
                await LoadAsync();
                break;
            case Error<string> error:
                _postError = error.Value;
                break;
        }

        _busy = false;
    }

    private Task AddAsync() => ChangeAsync(_who.Trim(), _whoLevel, () => _who = string.Empty);

    private Task SetLevelAsync(CasefileMemberDto member, string? level)
        => level is null || level == member.Level ? Task.CompletedTask : ChangeAsync(member.Principal, level, null);

    private Task RemoveAsync(CasefileMemberDto member) => ChangeAsync(member.Principal, null, null);

    private async Task ChangeAsync(string who, string? level, Action? done)
    {
        if (who.Length == 0) return;
        _busy = true;
        _memberError = null;
        switch (await Casefiles.SetMemberAsync(Key, who, level))
        {
            case CasefileDto casefile:
                _casefile = casefile;
                done?.Invoke();
                break;
            case SharpMUSH.Library.DiscriminatedUnions.NotFound:
                // They took themselves out: the casefile is no longer theirs to see.
                Nav.NavigateTo("/wiki/casefiles");
                break;
            case Error<string> error:
                _memberError = error.Value;
                // A select that was changed shows the refused level until the casefile is read again.
                await LoadAsync();
                break;
        }

        _busy = false;
    }

    private string LevelLabel(string level) => Loc[CasefileLevels.ResourceKey(level)];
}
