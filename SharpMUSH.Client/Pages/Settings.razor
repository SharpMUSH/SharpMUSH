@page "/settings"
@layout SettingsLayout
@attribute [Authorize]
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["Settings"] — @Loc["AppTitle"]</PageTitle>

@* D1 §6.5 settings overview: the plain header and one linked card per settings page, the same
   destinations as the section sidebar. *@
<div class="settings-page">
    <PlainPageHeader Kicker="@($"{Loc["AppTitle"]} · {Loc["Settings"]}")" Title="@Loc["Settings"]" Description="@Loc["NavSettingsDescription"]" />

    <div class="settings-grid">
        @* Characters land on the Account page's characters card, which is where linking, unlinking
           and creating them has always actually happened. This row once pointed at a
           /settings/characters stub that said "Coming soon" and offered a link back to /account. *@
        @foreach (var card in Cards)
        {
            <a class="settings-link" href="@card.Href">
                <span class="settings-link-icon" aria-hidden="true"><MudIcon Icon="@card.Icon" Size="Size.Small" /></span>
                <span class="settings-link-body">
                    <span class="settings-link-title">@Loc[card.TitleKey]</span>
                    <span class="settings-link-desc">@Loc[card.DescKey]</span>
                </span>
                <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" Class="settings-link-arrow" />
            </a>
        }
    </div>
</div>

@code {
    private sealed record Card(string Href, string Icon, string TitleKey, string DescKey);

    private static readonly Card[] Cards =
    [
        new("/account", Icons.Material.Outlined.ManageAccounts, "AuthAccount", "NavSettingsAccountDescription"),
        new("/account#characters", Icons.Material.Outlined.People, "Characters", "NavSettingsCharactersDescription"),
        new("/settings/theme", Icons.Material.Outlined.Palette, "NavTheme", "NavSettingsThemeDescription"),
    ];
}
