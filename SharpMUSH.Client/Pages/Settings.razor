@page "/settings"
@attribute [Authorize]
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["Settings"] — @Loc["AppTitle"]</PageTitle>

<div class="settings-page">
    <header class="settings-header">
        <div class="settings-kicker">@Loc["AppTitle"] · @Loc["Settings"]</div>
        <h1 class="settings-title">@Loc["Settings"]</h1>
    </header>

    <div class="settings-nav">
        <button type="button" class="settings-nav-item" @onclick='() => Nav.NavigateTo("/account")'>
            <MudIcon Icon="@Icons.Material.Filled.ManageAccounts" Class="settings-nav-icon" />
            <div class="settings-nav-body">
                <span class="settings-nav-label">@Loc["AuthAccount"]</span>
                <span class="settings-nav-desc">@Loc["NavSettingsAccountDescription"]</span>
            </div>
            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Class="settings-nav-arrow" />
        </button>

        @* Characters land on /account, which is where linking, unlinking and creating them has
           always actually happened. This row used to point at a /settings/characters stub that
           said "Coming soon" and offered a link back to /account. *@
        <button type="button" class="settings-nav-item" @onclick='() => Nav.NavigateTo("/account")'>
            <MudIcon Icon="@Icons.Material.Filled.People" Class="settings-nav-icon" />
            <div class="settings-nav-body">
                <span class="settings-nav-label">@Loc["Characters"]</span>
                <span class="settings-nav-desc">@Loc["NavSettingsCharactersDescription"]</span>
            </div>
            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Class="settings-nav-arrow" />
        </button>

        <button type="button" class="settings-nav-item" @onclick='() => Nav.NavigateTo("/settings/theme")'>
            <MudIcon Icon="@Icons.Material.Filled.Palette" Class="settings-nav-icon" />
            <div class="settings-nav-body">
                <span class="settings-nav-label">@Loc["NavTheme"]</span>
                <span class="settings-nav-desc">@Loc["NavSettingsThemeDescription"]</span>
            </div>
            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Class="settings-nav-arrow" />
        </button>
    </div>
</div>
