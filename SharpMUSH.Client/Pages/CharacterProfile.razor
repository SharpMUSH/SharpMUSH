@page "/character/{Name}"
@layout CharactersLayout
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using SharpMUSH.Client.Models
@using SharpMUSH.Client.Models.Widgets
@using SharpMUSH.Client.Services
@using SharpMUSH.Library.API
@inject CharacterProfileService Profiles
@inject CharacterDirectoryService Directory
@inject GalleryService Gallery
@inject SceneService Scenes
@inject AccountAuthService AccountAuth
@inject ServerInfoService ServerInfo
@inject ISnackbar Snackbar
@implements IDisposable
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@DisplayName — @Loc["AppTitle"]</PageTitle>

@* D1 §6.3 character profile (boards 25–26). The banner's picture is the profile's banner field
   (IMAGE`BANNER), else the gallery's banner, else a gradient on the name's hue; the portrait is the
   image field (IMAGE), else the gallery's icon, else initials. Whoever may edit the profile changes
   either from here (Change banner, Remove banner, and Change avatar on the portrait); a change
   uploads a new image into the gallery or picks one already there, and the gallery widget follows. Below it the "profile" layout scope:
   MainContent (the character-header application as Details, WikiBody as Biography) beside the
   RightSidebar zone (Gallery, Recent scenes, Often plays with). *@
@if (_missing)
{
    <div class="char-profile-missing">
        <PlainPageHeader Title="@Name" Description="@string.Format(Loc["NavCharNotFound"], Name)" />
        <a href="/characters">@Loc["NavCharAll"]</a>
    </div>
}
else
{
    <div class="char-profile">
        @if (_unreadable)
        {
            @* The directory knows this name but its profile could not be read: say so, rather than
               drawing a profile of nothing that looks like one with nothing in it. *@
            <div class="char-profile-unavailable" role="status">@Loc["NavCharProfileUnavailable"]</div>
        }
        <GlassBanner Title="@DisplayName" ImageUrl="@BannerUrl" Alt="@DisplayName" Height="236" TitleSize="character" HeadingLevel="1"
                     TitleColor="@_profile?.Color" Hue="@NameHue.Of(DisplayName)" Minimisable="false">
            <Lead>
                <div class="char-profile-avatar">
                    @if (ImageUrlPolicy.IsRenderable(PortraitUrl))
                    {
                        <img class="char-profile-portrait" src="@ApiUrl.Resolve(PortraitUrl!)" alt="@DisplayName" />
                    }
                    else
                    {
                        <span class="char-profile-initials" style="@($"--portrait-hue:{NameHue.Of(DisplayName)};")" aria-hidden="true">@Initials.From(DisplayName)</span>
                    }
                    @if (CanEditImages)
                    {
                        <CapsuleButton Class="char-profile-change-avatar" Icon="@Icons.Material.Outlined.PhotoCamera" AriaLabel="@Loc["NavCharChangeAvatar"]" Disabled="_busy" OnClick="@(() => OpenPicker(GalleryUse.Avatar))" />
                    }
                </div>
            </Lead>
            <Secondary>
                @if (_profile?.Role is { } role)
                {
                    <div class="char-profile-role">@role</div>
                }
                <div class="char-profile-pills">
                    @if (_liveScene is { } scene)
                    {
                        <FeatureGate Feature="@GameFeatures.Scenes">
                            <a class="char-profile-pill--scene" href="/play">
                                <Pill Dot="var(--accent)">@string.Format(Loc["NavCharInScene"], SceneTitle(scene))</Pill>
                            </a>
                        </FeatureGate>
                    }
                    @if (_online)
                    {
                        <Pill Dot="var(--accent)" Class="char-profile-pill--online">@Loc["NavCharOnline"]</Pill>
                    }
                    @if (_profile?.Dbref is { } dbref)
                    {
                        <Pill Class="char-profile-pill--dbref">@dbref</Pill>
                    }
                </div>
            </Secondary>
            <Actions>
                @if (CanEditImages)
                {
                    <CapsuleButton Class="char-profile-change-banner" Icon="@Icons.Material.Outlined.Panorama" Disabled="_busy" OnClick="@(() => OpenPicker(GalleryUse.Banner))">@Loc["NavCharChangeBanner"]</CapsuleButton>
                    @if (_gallery.Any(g => g.IsBanner))
                    {
                        <CapsuleButton Class="char-profile-remove-banner" Icon="@Icons.Material.Outlined.HideImage" AriaLabel="@Loc["NavGalleryRemoveBanner"]" Disabled="_busy" OnClick="RemoveBannerAsync" />
                    }
                }
                @if (_viewerItems.Count > 0)
                {
                    <CapsuleButton Class="char-profile-full" Icon="@Icons.Material.Outlined.OpenInFull" OnClick="@(() => _viewerOpen = true)">@Loc["NavCharFullImage"]</CapsuleButton>
                }
            </Actions>
            <BottomActions>
                <CapsuleButton Icon="@Icons.Material.Outlined.MailOutline" Href="@($"/mail/compose?to={Uri.EscapeDataString(DisplayName)}")">@Loc["NavCharMail"]</CapsuleButton>
                <CapsuleButton Primary="true" Icon="@Icons.Material.Outlined.ChatBubbleOutline" Href="@PageHref">@Loc["NavCharPage"]</CapsuleButton>
            </BottomActions>
        </GlassBanner>

        @* The cascading context supplies the character (from the route) and edit rights to whatever
           widgets the admin places in the profile scope. *@
        <CascadingValue Value="_context" IsFixed="false">
            <div class="char-profile-body">
                <div class="char-profile-main">
                    <ScopedZone Scope="@LayoutScopes.Profile" Zone="WidgetZone.MainContent" />
                </div>
                <aside class="char-profile-aside" aria-label="@string.Format(Loc["NavCharAbout"], DisplayName)">
                    <ScopedZone Scope="@LayoutScopes.Profile" Zone="WidgetZone.RightSidebar" Grid="false" />
                </aside>
            </div>
        </CascadingValue>
    </div>

    <ImageViewer Items="@_viewerItems" @bind-Open="_viewerOpen" Label="@DisplayName" />
    @if (CanEditImages)
    {
        <GalleryImagePicker @bind-Open="_pickerOpen" Items="_gallery" Busy="_busy"
                            Title="@(_pickFor == GalleryUse.Avatar ? Loc["NavCharChangeAvatar"] : Loc["NavCharChangeBanner"])"
                            SelectedAssetId="@(_pickFor == GalleryUse.Avatar ? _gallery.FirstOrDefault(g => g.IsIcon)?.AssetId : _gallery.FirstOrDefault(g => g.IsBanner)?.AssetId)"
                            OnUpload="@(f => UploadAsync(f, _pickFor))" OnPick="PickAsync" />
    }
}

@code {
    [Parameter]
    public required string Name { get; set; }

    // Cascaded rather than read once from the provider: a sign-in or sign-out while this page is open
    // hands down a new task, so the edit affordances follow it.
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private ProfilePageContext _context = new(string.Empty, false);

    /// <summary>The gallery as this page's last write left it, handed to the gallery widget; null until one.</summary>
    private IReadOnlyList<GalleryEntry>? _written;
    private bool _busy;
    private CharacterProfileData? _profile;
    private IReadOnlyList<GalleryEntry> _gallery = [];
    private SceneSummary? _liveScene;
    private bool _online;
    private bool _missing;
    private bool _unreadable;
    private string? _loadedFor;

    /// <summary>Bumped on every load: an answer for an older load is dropped (A→B→C must show C).</summary>
    private int _generation;
    private bool _viewerOpen;

    private bool _pickerOpen;

    /// <summary>What the image picker chooses: the banner or the avatar. Kept after it closes, since
    /// it closes before the chosen write starts.</summary>
    private GalleryUse _pickFor = GalleryUse.Banner;
    private IReadOnlyList<ImageViewer.Item> _viewerItems = [];

    private string DisplayName => _profile?.Name is { Length: > 0 } name ? name : Name;

    private string? BannerUrl => _profile?.Banner ?? _gallery.FirstOrDefault(g => g.IsBanner)?.Url;

    private string? PortraitUrl => _profile?.Image ?? _gallery.FirstOrDefault(g => g.IsIcon)?.Url;

    /// <summary>A profile that could not be read has no gallery known to be the one to write.</summary>
    private bool CanEditImages => _context.CanEdit && _profile is not null;

    protected override void OnInitialized() =>
        _liveSceneReload.Watch(AccountAuth, () => _ = InvokeAsync(async () => { await LoadLiveSceneAsync(); StateHasChanged(); }), Scenes);

    public void Dispose() => _liveSceneReload.Dispose();

    private bool _guestCanPlay;

    /// <summary>
    /// Paging happens on Play. A signed-out visitor gets there only as a guest; when the game has none to
    /// hand out, Play is a dead end ("no guest characters available"), so they sign in first, as Mail does.
    /// </summary>
    private string PageHref
    {
        get
        {
            var play = $"/play?page={Uri.EscapeDataString(DisplayName)}";
            return AccountAuth.IsLoggedIn || _guestCanPlay ? play : $"/login?returnUrl={Uri.EscapeDataString(play)}";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _guestCanPlay = await ServerInfo.GuestLoginsEnabledAsync();
        var user = AuthState is null ? null : (await AuthState).User;
        var mine = user?.Identity?.IsAuthenticated == true && await AccountAuth.GetCharactersAsync() is IReadOnlyList<AccountAuthService.CharacterSummary> own
            ? own
            : [];
        var canEdit = ProfileEditRights.CanEdit(user, mine, Name);
        var owned = ProfileEditRights.Owns(user, mine, Name);

        if (string.Equals(_loadedFor, Name, StringComparison.OrdinalIgnoreCase))
        {
            _context = NewContext(canEdit, owned);
            return;
        }

        _written = null;
        _context = NewContext(canEdit, owned);

        _loadedFor = Name;
        var generation = ++_generation;
        // The previous character's live-scene read, still in flight, is not this one's.
        _liveSceneReload.Begin();
        (_profile, _gallery, _liveScene, _online, _missing, _unreadable, _viewerItems, _viewerOpen, _pickerOpen) = (null, [], null, false, false, false, [], false, false);

        var profile = Profiles.GetAsync(Name);
        var gallery = Gallery.ListAsync(Name);
        var online = Directory.ListOnlineAsync();

        var profileResult = await profile;
        if (generation != _generation) return;
        switch (profileResult)
        {
            case CharacterProfileData found:
                _profile = found;
                _context = _context with { Dbref = found.Dbref };
                break;
            case ApiFailure { Kind: ApiFailureKind.NotFound }:
                _missing = true;
                return;
            case ApiFailure:
                _unreadable = true;
                break;
        }

        var galleryResult = await gallery;
        var onlineResult = await online;
        if (generation != _generation) return;
        _gallery = galleryResult is List<GalleryEntry> entries ? entries : [];
        _online = onlineResult is IReadOnlyList<CharacterDirectoryService.CharacterSummary> here
            && here.Any(r => _profile is { } shown
                ? string.Equals(r.Objid, shown.Objid, StringComparison.Ordinal)
                : string.Equals(r.Name, DisplayName, StringComparison.OrdinalIgnoreCase));
        _viewerItems = ViewerItems();

        await LoadLiveSceneAsync();
    }

    /// <summary>
    /// The scene the character is in, from the scenes the acting character may see: a switch of
    /// character, or a scene this tab started, reads it again.
    /// </summary>
    private readonly ViewerScopedReload _liveSceneReload = new();

    private Task LoadLiveSceneAsync() => _profile?.Dbref is { } dbref
        ? _liveSceneReload.LoadAsync(() => Scenes.GetParticipantScenesAsync(dbref, 5),
            scenes => _liveScene = scenes is IReadOnlyList<SceneSummary> list ? list.FirstOrDefault(s => s.IsLive) : null)
        : Task.CompletedTask;

    private ProfilePageContext NewContext(bool canEdit, bool owned) =>
        new(Name, canEdit, _profile?.Dbref, _written, OnGalleryChanged, owned);

    /// <summary>
    /// A gallery widget changed the gallery: the banner and the avatar follow it, and so does every
    /// other gallery placement, whose next write would otherwise drop what this one added.
    /// </summary>
    private void OnGalleryChanged(IReadOnlyList<GalleryEntry> gallery)
    {
        _written = gallery;
        _context = _context with { Gallery = gallery };
        ShowGallery(gallery);
        StateHasChanged();
    }

    private Task UploadAsync(IBrowserFile? file, GalleryUse use) =>
        file is null ? Task.CompletedTask : WriteAsync(Gallery.UploadAsync(Name, file, use), "GalleryUploadFailed");

    private void OpenPicker(GalleryUse use) => (_pickFor, _pickerOpen) = (use, true);

    /// <summary>An image already in the gallery becomes the banner or the avatar.</summary>
    private Task PickAsync(GalleryEntry item) => _pickFor == GalleryUse.Avatar
        ? WriteAsync(Gallery.ReplaceAsync(Name, GalleryService.WithIcon(_gallery, item.AssetId)), "GallerySetIconFailed")
        : WriteAsync(Gallery.ReplaceAsync(Name, GalleryService.WithBanner(_gallery, item.AssetId)), "GallerySetBannerFailed");

    private Task RemoveBannerAsync() =>
        WriteAsync(Gallery.ReplaceAsync(Name, GalleryService.WithBanner(_gallery, null)), "GallerySetBannerFailed");

    private async Task WriteAsync(Task<ApiResult<List<GalleryEntry>>> write, string failedKey)
    {
        // A write that answers after the page moved to another character is that character's, not this one's.
        var generation = _generation;
        _busy = true;
        ApiResult<List<GalleryEntry>> result;
        try { result = await write; }
        finally { _busy = false; }
        if (generation != _generation) return;

        switch (result)
        {
            case List<GalleryEntry> updated:
                _written = updated;
                _context = _context with { Gallery = updated };
                ShowGallery(updated);
                break;
            case ApiFailure failure:
                Snackbar.Add(Loc[failedKey, failure.Message], Severity.Error);
                break;
        }
    }

    /// <summary>
    /// The server mirrors the gallery's avatar and banner into <c>IMAGE</c> and <c>IMAGE`BANNER</c>, which
    /// the profile's image and banner fields read, so the page shows the gallery's without reading the
    /// profile again.
    /// </summary>
    private void ShowGallery(IReadOnlyList<GalleryEntry> gallery)
    {
        _gallery = gallery;
        _profile = _profile is null ? null : _profile with
        {
            Image = gallery.FirstOrDefault(g => g.IsIcon)?.Url,
            Banner = gallery.FirstOrDefault(g => g.IsBanner)?.Url,
        };
        _viewerItems = ViewerItems();
    }

    /// <summary>The banner, the portrait, then the rest of the gallery, each once and each renderable.</summary>
    private IReadOnlyList<ImageViewer.Item> ViewerItems()
    {
        var urls = new List<(string Url, string? Caption)>();
        if (BannerUrl is { } banner) urls.Add((banner, null));
        if (PortraitUrl is { } portrait) urls.Add((portrait, null));
        urls.AddRange(_gallery.Select(g => (g.Url, g.Caption)));
        return urls
            .Where(u => ImageUrlPolicy.IsRenderable(u.Url))
            .DistinctBy(u => u.Url)
            .Select(u => new ImageViewer.Item(u.Url, DisplayName, u.Caption ?? _gallery.FirstOrDefault(g => g.Url == u.Url)?.Caption))
            .ToList();
    }

    private string SceneTitle(SceneSummary scene) =>
        scene.Meta.TryGetValue("title", out var title) && !string.IsNullOrWhiteSpace(title) ? title : scene.RoomName;
}
