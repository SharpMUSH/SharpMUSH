@page "/character/{Name}"
@layout CharactersLayout
@using Microsoft.AspNetCore.Components.Authorization
@using SharpMUSH.Client.Models
@using SharpMUSH.Client.Models.Widgets
@using SharpMUSH.Client.Services
@using SharpMUSH.Library.API
@inject CharacterProfileService Profiles
@inject CharacterDirectoryService Directory
@inject GalleryService Gallery
@inject SceneService Scenes
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@DisplayName — @Loc["AppTitle"]</PageTitle>

@* D1 §6.3 character profile (boards 25–26). The banner's picture is the profile's banner field
   (IMAGE`BANNER), else the gallery's banner, else a gradient on the name's hue; the portrait is the
   image field (IMAGE), else the gallery's icon, else initials. Below it the "profile" layout scope:
   MainContent (the character-header application as Details, WikiBody as Biography) beside the
   RightSidebar zone (Gallery, Recent scenes, Often plays with). *@
@if (_missing)
{
    <div class="char-profile-missing">
        <PlainPageHeader Title="@Name" Description="@string.Format(Loc["NavCharNotFound"], Name)" />
        <a href="/characters">@Loc["NavCharAll"]</a>
    </div>
}
else
{
    <div class="char-profile">
        <GlassBanner Title="@DisplayName" ImageUrl="@BannerUrl" Alt="@DisplayName" Height="236" TitleSize="character" HeadingLevel="1"
                     TitleColor="@_profile?.Color" Hue="@NameHue.Of(DisplayName)" Minimisable="false">
            <Lead>
                @if (ImageUrlPolicy.IsRenderable(PortraitUrl))
                {
                    <img class="char-profile-portrait" src="@PortraitUrl!.Trim()" alt="@DisplayName" />
                }
                else
                {
                    <span class="char-profile-initials" style="@($"--portrait-hue:{NameHue.Of(DisplayName)};")" aria-hidden="true">@Initials.From(DisplayName)</span>
                }
            </Lead>
            <Secondary>
                @if (_profile?.Role is { } role)
                {
                    <div class="char-profile-role">@role</div>
                }
                <div class="char-profile-pills">
                    @if (_liveScene is { } scene)
                    {
                        <a class="char-profile-pill--scene" href="/play">
                            <Pill Dot="var(--accent)">@string.Format(Loc["NavCharInScene"], SceneTitle(scene))</Pill>
                        </a>
                    }
                    @if (_online)
                    {
                        <Pill Dot="var(--accent)" Class="char-profile-pill--online">@Loc["NavCharOnline"]</Pill>
                    }
                    @if (_profile?.Dbref is { } dbref)
                    {
                        <Pill Class="char-profile-pill--dbref">@dbref</Pill>
                    }
                </div>
            </Secondary>
            <Actions>
                @if (_viewerItems.Count > 0)
                {
                    <CapsuleButton Class="char-profile-full" Icon="@Icons.Material.Outlined.OpenInFull" OnClick="@(() => _viewerOpen = true)">@Loc["NavCharFullImage"]</CapsuleButton>
                }
            </Actions>
            <BottomActions>
                <CapsuleButton Icon="@Icons.Material.Outlined.MailOutline" Href="@($"/mail/compose?to={Uri.EscapeDataString(DisplayName)}")">@Loc["NavCharMail"]</CapsuleButton>
                <CapsuleButton Primary="true" Icon="@Icons.Material.Outlined.ChatBubbleOutline" Href="@($"/play?page={Uri.EscapeDataString(DisplayName)}")">@Loc["NavCharPage"]</CapsuleButton>
            </BottomActions>
        </GlassBanner>

        @* The cascading context supplies the character (from the route) and edit rights to whatever
           widgets the admin places in the profile scope. *@
        <CascadingValue Value="_context" IsFixed="false">
            <div class="char-profile-body">
                <div class="char-profile-main">
                    <ScopedZone Scope="@LayoutScopes.Profile" Zone="WidgetZone.MainContent" />
                </div>
                <aside class="char-profile-aside" aria-label="@string.Format(Loc["NavCharAbout"], DisplayName)">
                    <ScopedZone Scope="@LayoutScopes.Profile" Zone="WidgetZone.RightSidebar" Grid="false" />
                </aside>
            </div>
        </CascadingValue>
    </div>

    <ImageViewer Items="@_viewerItems" @bind-Open="_viewerOpen" Label="@DisplayName" />
}

@code {
    [Parameter]
    public required string Name { get; set; }

    // Cascaded rather than read once from the provider: a sign-in or sign-out while this page is open
    // hands down a new task, so the edit affordances follow it.
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private ProfilePageContext _context = new(string.Empty, false);
    private CharacterProfileData? _profile;
    private IReadOnlyList<GalleryEntry> _gallery = [];
    private SceneSummary? _liveScene;
    private bool _online;
    private bool _missing;
    private string? _loadedFor;
    private bool _viewerOpen;
    private IReadOnlyList<ImageViewer.Item> _viewerItems = [];

    private string DisplayName => _profile?.Name is { Length: > 0 } name ? name : Name;

    private string? BannerUrl => _profile?.Banner ?? _gallery.FirstOrDefault(g => g.IsBanner)?.Url;

    private string? PortraitUrl => _profile?.Image ?? _gallery.FirstOrDefault(g => g.IsIcon)?.Url;

    protected override async Task OnParametersSetAsync()
    {
        var canEdit = AuthState is not null && (await AuthState).User.Identity?.IsAuthenticated == true;
        _context = new ProfilePageContext(Name, canEdit);

        if (string.Equals(_loadedFor, Name, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _loadedFor = Name;
        (_profile, _gallery, _liveScene, _online, _missing) = (null, [], null, false, false);

        var profile = Profiles.GetAsync(Name);
        var gallery = Gallery.ListAsync(Name);
        var online = Directory.ListOnlineAsync();

        switch (await profile)
        {
            case CharacterProfileData found:
                _profile = found;
                break;
            case ApiFailure { Kind: ApiFailureKind.NotFound }:
                _missing = true;
                return;
        }

        _gallery = await gallery is List<GalleryEntry> entries ? entries : [];
        _online = await online is IReadOnlyList<CharacterDirectoryService.CharacterSummary> here
            && here.Any(r => string.Equals(r.Name, DisplayName, StringComparison.OrdinalIgnoreCase));
        _viewerItems = ViewerItems();

        if (_profile?.Dbref is { } dbref
            && await Scenes.GetParticipantScenesAsync(dbref, 5) is IReadOnlyList<SceneSummary> scenes)
        {
            _liveScene = scenes.FirstOrDefault(s => s.IsLive);
        }
    }

    /// <summary>The banner, the portrait, then the rest of the gallery, each once and each renderable.</summary>
    private IReadOnlyList<ImageViewer.Item> ViewerItems()
    {
        var urls = new List<(string Url, string? Caption)>();
        if (BannerUrl is { } banner) urls.Add((banner, null));
        if (PortraitUrl is { } portrait) urls.Add((portrait, null));
        urls.AddRange(_gallery.Select(g => (g.Url, g.Caption)));
        return urls
            .Where(u => ImageUrlPolicy.IsRenderable(u.Url))
            .DistinctBy(u => u.Url)
            .Select(u => new ImageViewer.Item(u.Url, DisplayName, u.Caption ?? _gallery.FirstOrDefault(g => g.Url == u.Url)?.Caption))
            .ToList();
    }

    private string SceneTitle(SceneSummary scene) =>
        scene.Meta.TryGetValue("title", out var title) && !string.IsNullOrWhiteSpace(title) ? title : scene.RoomName;
}
