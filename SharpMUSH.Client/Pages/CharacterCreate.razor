@page "/characters/new"
@page "/characters/claim"
@layout CharactersLayout
@attribute [Authorize]
@using SharpMUSH.Client.Services
@inject IStringLocalizer<SharedResource> Loc
@inject AccountAuthService AccountAuth
@inject ICharacterUpgradeService Upgrade
@inject NavigationManager Nav

<PageTitle>@(Claiming ? Loc["NavClaimCharacter"] : Loc["NavCreateCharacter"]) — @Loc["AppTitle"]</PageTitle>

<div class="charcreate-page">
    <MudPaper Elevation="0" Class="charcreate-card pa-6">
        @* An account with no character yet is mid-onboarding, not short of a permission. Login
           routes it straight here, and this line says why it landed here rather than the portal. *@
        @if (_onboarding)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4" id="onboarding-notice">
                @Loc["OnboardingCreateFirstCharacter"]
            </MudAlert>
        }

        <MudText Typo="Typo.h5" GutterBottom="true">@(Claiming ? Loc["NavClaimACharacter"] : Loc["NavCreateACharacter"])</MudText>
        <MudText Typo="Typo.body2" Style="color:var(--text-faint);">
            @(Claiming ? Loc["NavClaimCharacterBlurb"] : Loc["NavCreateCharacterBlurb"])
        </MudText>

        <MudTextField @bind-Value="_name" Label="@Loc["NavCharacterName"]"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-4" />
        <MudTextField @bind-Value="_password" Label="@Loc["AuthPassword"]" InputType="InputType.Password"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3" />

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
        }

        <div class="charcreate-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy"
                       OnClick="CreateAsync">@(Claiming ? Loc["NavClaimCharacter"] : Loc["NavCreateCharacter"])</MudButton>
            <MudButton Variant="Variant.Text" Href="/account">@Loc["Cancel"]</MudButton>
        </div>

        @* A character made at the connect screen, by staff or by an import has no account until its
           holder claims it, and the onboarding page is where a returning player lands. *@
        <MudText Typo="Typo.body2" Class="charcreate-switch">
            @if (Claiming)
            {
                <a href="/characters/new">@Loc["NavCreateInstead"]</a>
            }
            else
            {
                <a href="/characters/claim">@Loc["NavClaimInstead"]</a>
            }
        </MudText>
    </MudPaper>
</div>

@code {
    private string _name = string.Empty;
    private string _password = string.Empty;
    private string? _error;
    private bool _busy;
    private bool _onboarding;

    /// <summary>
    /// Loads the roster so the page knows whether this is the account's first character. A reloaded
    /// tab hydrates its session from sessionStorage but not its roster, so without this the local
    /// count is 0 for everyone — which would both show the onboarding line to an established player
    /// and make CreateAsync below mistake their second character for their first.
    /// A failed fetch is left alone: "we could not ask" must not render as "you have none".
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        _onboarding = await AccountAuth.GetCharactersAsync() is IReadOnlyList<AccountAuthService.CharacterSummary> { Count: 0 };
    }

    /// <summary>Switching between creating and claiming keeps the page; the other form's refusal goes.</summary>
    protected override void OnParametersSet() => _error = null;

    /// <summary>True on <c>/characters/claim</c>: the form links a character that already exists.</summary>
    private bool Claiming => Nav.ToBaseRelativePath(Nav.Uri).StartsWith("characters/claim", StringComparison.OrdinalIgnoreCase);

    private async Task CreateAsync()
    {
        _error = null;
        _busy = true;

        var result = Claiming
            ? await AccountAuth.ClaimCharacterAsync(_name, _password)
            : await AccountAuth.CreateCharacterAsync(_name, _password);

        _busy = false;
        if (result is not AccountAuthService.CharacterSummary character)
        {
            _error = result is ApiFailure failure ? failure.Message : null;
            return;
        }

        // A first character becomes the active one (a guest, or a fresh account) — start playing it
        // everywhere. Creating an additional character just adds it to the roster.
        if (AccountAuth.Characters.Count == 1)
        {
            await Upgrade.PlayAsAsync(character);
            Nav.NavigateTo("/play");
        }
        else
        {
            Nav.NavigateTo("/account");
        }
    }
}
