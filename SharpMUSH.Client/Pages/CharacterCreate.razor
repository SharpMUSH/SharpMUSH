@page "/characters/new"
@page "/characters/claim"
@layout CharactersLayout
@attribute [Authorize]
@using SharpMUSH.Client.Services
@using SharpMUSH.Library.Models.Portal.Onboarding
@inject IStringLocalizer<SharedResource> Loc
@inject AccountAuthService AccountAuth
@inject NativeCharacterCredentialsClient Native
@inject ICharacterUpgradeService Upgrade
@inject NavigationManager Nav
@inject ServerInfoService ServerInfo

<PageTitle>@(Claiming ? Loc["NavClaimCharacter"] : Loc["NavCreateCharacter"]) — <GameName /></PageTitle>

<div class="charcreate-page">
    <MudPaper Elevation="0" Class="charcreate-card pa-6">
        @* An account with no character yet is mid-onboarding, not short of a permission. Login
           routes it straight here, and this line says why it landed here rather than the portal. *@
        @if (_onboarding)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4" id="onboarding-notice">
                @Loc["OnboardingCreateFirstCharacter"]
            </MudAlert>
        }

        <MudText Typo="Typo.h5" HtmlTag="h1" GutterBottom="true">@(Claiming ? Loc["NavClaimACharacter"] : Loc["NavCreateACharacter"])</MudText>
        <MudText Typo="Typo.body2" Style="color:var(--text-faint);">
            @(Claiming ? Loc["NavClaimCharacterBlurb"] : Loc["NavCreateCharacterBlurb"])
        </MudText>

        <MudText Typo="Typo.body2" Class="mt-3 journey-identity">@Loc["AuthJourneyIdentity"]</MudText>
        <p class="charcreate-switch journey-character-links"><a href="/account">@Loc["NavCharYourCharacters"]</a> · <a href="/characters">@Loc["NavJourneyDirectory"]</a></p>

        @if (!Claiming && _characterGuide is { } guide)
        {
            <p class="charcreate-guide">@Loc["NavCharacterGuideLead"] <a href="@guide.Url">@guide.Title</a></p>
        }

        @if (_createdCharacter is null)
        {
        <MudTextField @bind-Value="_name" Label="@Loc["NavCharacterName"]"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-4" />
        @if (!Claiming)
        {
            <MudCheckBox @bind-Value="_withPassword" Label="@Loc["NavCharacterOwnPassword"]" />
        }
        @if (Claiming || _withPassword)
        {
        <MudTextField @bind-Value="_password" Label="@Loc["AuthCharacterPassword"]" InputType="InputType.Password"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3" />
        }

        }

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
        }

        @if (!_rosterReady && _createdCharacter is null)
        {
            <MudButton Disabled="_busy" OnClick="LoadRosterAsync">@Loc["GuideRetryRoster"]</MudButton>
        }
        <div class="charcreate-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || (!_rosterReady && _createdCharacter is null))"
                       OnClick="CreateAsync">@(_createdCharacter is not null ? Loc["GuideRetryConnection"] : Claiming ? Loc["NavClaimCharacter"] : Loc["NavCreateCharacter"])</MudButton>
            <MudButton Variant="Variant.Text" Href="/account">@Loc["Cancel"]</MudButton>
        </div>

        @* A character made at the connect screen, by staff or by an import has no account until its
           holder claims it, and the onboarding page is where a returning player lands. *@
        @if (_createdCharacter is null)
        {
        <MudText Typo="Typo.body2" Class="charcreate-switch">
            @if (Claiming)
            {
                <a href="@SwitchUrl(false)">@Loc["NavCreateInstead"]</a>
            }
            else
            {
                <a href="@SwitchUrl(true)">@Loc["NavClaimInstead"]</a>
            }
        </MudText>
        }
    </MudPaper>
</div>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    private string? GuideReturn => ReturnUrl is { } path && (path == "/welcome" || path.StartsWith("/welcome?", StringComparison.Ordinal)) && Welcome.LocalReturn(path) == path ? path : null;
    private string SwitchUrl(bool claim) => (claim ? "/characters/claim" : "/characters/new") + (GuideReturn is { } path ? "?returnUrl=" + Uri.EscapeDataString(path) : "");
    private string _name = string.Empty;
    private string _password = string.Empty;
    private string? _error;
    private bool _busy;
    /// <summary>Whether the new character also gets a password of its own, for a MU* client. Off by default: the
    /// account already signs in, and asking for a second password right after the first one is friction.</summary>
    private bool _withPassword;
    private GuideLink? _characterGuide;
    private bool _onboarding;
    private bool _rosterReady;
    private AccountAuthService.CharacterSummary? _createdCharacter;

    /// <summary>
    /// Loads the roster so the page knows whether this is the account's first character. A reloaded
    /// tab hydrates its session from sessionStorage but not its roster, so without this the local
    /// count is 0 for everyone — which would both show the onboarding line to an established player
    /// and make CreateAsync below mistake their second character for their first.
    /// A failed fetch is left alone: "we could not ask" must not render as "you have none".
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await LoadRosterAsync();
        _characterGuide = (await ServerInfo.OnboardingAsync())?.CharacterGuide;
    }

    private async Task LoadRosterAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            if (await AccountAuth.GetCharactersAsync() is IReadOnlyList<AccountAuthService.CharacterSummary> roster)
            {
                _rosterReady = true;
                _onboarding = roster.Count == 0;
            }
            else
            {
                _rosterReady = false;
                _error = Loc["GuideCharacterRosterUnavailable"];
            }
        }
        finally { _busy = false; }
    }

    /// <summary>Switching between creating and claiming keeps the page; the other form's refusal goes.</summary>
    private bool? _lastClaiming;
    protected override void OnParametersSet()
    {
        if (_lastClaiming.HasValue && _lastClaiming != Claiming) _error = null;
        _lastClaiming = Claiming;
    }

    /// <summary>True on <c>/characters/claim</c>: the form links a character that already exists.</summary>
    private bool Claiming => Nav.ToBaseRelativePath(Nav.Uri).StartsWith("characters/claim", StringComparison.OrdinalIgnoreCase);

    private async Task<ApiResult<AccountAuthService.CharacterSummary>> CreateWithoutPasswordAsync()
    {
        switch (await Native.CreateWithoutPasswordAsync(_name))
        {
            case AccountApiClient.CreateCharacterResponse created:
                // As AccountAuthService does after a create: the account's role comes from its characters.
                await AccountAuth.ReloadAuthorityAsync();
                return new AccountAuthService.CharacterSummary(created.DbrefNumber, created.CreationTime ?? 0, _name, created.Flags ?? "");
            case ApiFailure failure: return failure;
        }
        throw new InvalidOperationException("Unexpected character creation response.");
    }

    private async Task CreateAsync()
    {
        if (_busy || (!_rosterReady && _createdCharacter is null)) return;
        _error = null;
        _busy = true;
        try
        {
            if (_createdCharacter is not null)
            {
                await ConnectCreatedCharacterAsync();
                return;
            }

            if (Refusal() is { } refusal)
            {
                _error = refusal;
                return;
            }

            var result = !Claiming && !_withPassword
                ? await CreateWithoutPasswordAsync()
                : Claiming
                ? await AccountAuth.ClaimCharacterAsync(_name, _password)
                : await AccountAuth.CreateCharacterAsync(_name, _password);

            if (result is not AccountAuthService.CharacterSummary character)
            {
                _error = result is ApiFailure failure ? failure.Message : null;
                return;
            }

            // Keep the successful result even if the next roster or connection request fails.
            _createdCharacter = character;
            _password = string.Empty;
            await ConnectCreatedCharacterAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>What is missing from the form, said as what to do about it.</summary>
    private string? Refusal() => string.IsNullOrWhiteSpace(_name)
        ? Loc[Claiming ? "NavClaimNameRequired" : "NavCharacterNameRequired"].Value
        : (Claiming || _withPassword) && string.IsNullOrWhiteSpace(_password)
        ? Loc[Claiming ? "NavClaimPasswordRequired" : "NavCharacterPasswordRequired"].Value
        : null;

    private async Task ConnectCreatedCharacterAsync()
    {
        try
        {
            if (await AccountAuth.GetCharactersAsync() is not IReadOnlyList<AccountAuthService.CharacterSummary> roster
                || !roster.Any(item => item.DbrefNumber == _createdCharacter!.DbrefNumber && item.CreationTime == _createdCharacter.CreationTime))
            {
                _error = Loc["GuideCharacterRosterFailed"];
                return;
            }
            if (roster.Count > 1)
            {
                Nav.NavigateTo(GuideReturn ?? "/account");
                return;
            }
            if (await Upgrade.PlayAsAsync(_createdCharacter!))
            {
                Nav.NavigateTo(GuideReturn ?? "/play");
                return;
            }
        }
        catch (Exception ex) when (ex is System.Net.WebSockets.WebSocketException or HttpRequestException or OperationCanceledException)
        {
            // The character already exists. A transport failure must not offer creation again.
        }
        _error = Loc["GuideCharacterConnectionFailed"];
    }
}
