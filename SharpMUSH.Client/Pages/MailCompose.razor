@page "/mail/compose"
@layout MailLayout
@attribute [Authorize]
@using SharpMUSH.Client.Services
@using SharpMUSH.Library.DiscriminatedUnions
@inject IStringLocalizer<SharedResource> Loc
@inject MailService Mail
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>@Loc["ComposeMail"] — @Loc["AppTitle"]</PageTitle>

@* D1 §6.5 compose: the plain header, the message in a card, and the bottom bar (§4.11) with
   Urgent, Cancel and Send. ?to= and ?subject= fill it in (a reply); ?draft= takes a body staged
   in the mail service (a forward's quoted text). The message is the page's main text box (input-focus.js):
   typing on the page lands in it. Arriving focuses To when it is empty, else the message. *@
<div class="mail-compose-page">
    <PlainPageHeader Kicker="@Loc["Mail"]" Title="@Loc["ComposeMail"]" />

    <KitCard Class="mc-card">
        <div class="mc-fields">
            <MudTextField @bind-Value="_to" Label="@Loc["To"]" Variant="Variant.Outlined" InputId="mc-to"
                          Margin="Margin.Dense" Class="mc-field" Required="true" />
            <MudTextField @bind-Value="_subject" Label="@Loc["Subject"]" Variant="Variant.Outlined"
                          Margin="Margin.Dense" Class="mc-field" />
            <MudTextField @bind-Value="_body" Label="@Loc["Message"]" Variant="Variant.Outlined" InputId="mc-body"
                          Lines="10" Margin="Margin.Dense" Class="mc-field" />
        </div>
    </KitCard>

    <BottomBar Class="mc-actions">
        <div class="mc-bar">
            <MudCheckBox @bind-Value="_urgent" Label="@Loc["Urgent"]" Color="Color.Error" Dense="true" />
            <span class="mc-spacer"></span>
            <CapsuleButton Href="/mail" Disabled="_sending">@Loc["Cancel"]</CapsuleButton>
            <CapsuleButton Primary="true" Icon="@Icons.Material.Outlined.Send" OnClick="SendAsync"
                           Disabled="@(_sending || string.IsNullOrWhiteSpace(_to))">@Loc["Send"]</CapsuleButton>
        </div>
    </BottomBar>
</div>

@code {
    [SupplyParameterFromQuery(Name = "to")] public string? ToQuery { get; set; }
    [SupplyParameterFromQuery(Name = "subject")] public string? SubjectQuery { get; set; }
    [SupplyParameterFromQuery(Name = "draft")] public string? DraftQuery { get; set; }

    private string _to = string.Empty;
    private string _subject = string.Empty;
    private string _body = string.Empty;
    private bool _urgent;
    private bool _sending;

    /// <summary>The address the form was last filled from; a re-render at the same one keeps what was typed.</summary>
    private (string? To, string? Subject, string? Draft)? _filledFrom;

    protected override void OnParametersSet()
    {
        // Mirror the query params each navigation so a prior reply's recipient/subject
        // never persists when the user opens a blank compose form. A draft is taken once, so the
        // same address must not refill (and blank) the form.
        if (_filledFrom == (ToQuery, SubjectQuery, DraftQuery)) return;
        _filledFrom = (ToQuery, SubjectQuery, DraftQuery);
        _to = string.IsNullOrWhiteSpace(ToQuery) ? string.Empty : ToQuery!;
        _subject = string.IsNullOrWhiteSpace(SubjectQuery) ? string.Empty : SubjectQuery!;
        _body = DraftQuery is { Length: > 0 } draft && Mail.TakeDraft(draft) is string staged ? staged : string.Empty;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            await JS.InvokeVoidAsync("sharpmushInputFocus.mark", "mc-body", "start");
            await JS.InvokeVoidAsync("sharpmushInputFocus.arrive", string.IsNullOrWhiteSpace(_to) ? "mc-to" : "mc-body");
        }
        catch (JSException)
        {
            // No focus script: the fields are still there to click.
        }
    }

    private async Task SendAsync()
    {
        _sending = true;
        var result = await Mail.SendAsync(_to.Trim(), _subject, _body, _urgent);
        _sending = false;

        switch (result)
        {
            case Success:
                Snackbar.Add(Loc["MailSent"], Severity.Success);
                Nav.NavigateTo("/mail");
                break;
            case ApiFailure failure:
                Snackbar.Add(Loc["MailSendFailed", failure.Message], Severity.Error);
                break;
        }
    }
}
