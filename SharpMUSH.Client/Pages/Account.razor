@page "/account"
@layout SettingsLayout
@attribute [Authorize]
@using SharpMUSH.Client.Services
@using SharpMUSH.Library.DiscriminatedUnions
@using Microsoft.AspNetCore.Components.Authorization
@using SharpMUSH.Client.Components.Settings
@inject AccountAuthService AccountAuth
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject IStringLocalizer<SharedResource> Loc
@inject IDialogService DialogService
@inject AccountPasskeyService Passkeys

<PageTitle>@Loc["MyAccount"] — @Loc["AppTitle"]</PageTitle>

<div class="acct-page">

    @* [Authorize] hands anonymous visitors to RedirectToLogin, so reaching this page without an
       account session now means exactly one thing: a DebugAuth principal whose debug-OTT never
       produced one (development only). The old "not logged in — use the terminal login panel"
       card that stood here was the anonymous dead end, and is unreachable now. _isDebugAuth
       still gates the card so the logged-out re-render during LogoutAsync shows nothing at all
       rather than a stale Debug Mode alert. *@
    @if (!AccountAuth.IsLoggedIn)
    {
        @if (_isDebugAuth)
        {
            <KitCard Class="acct-debug">
                <div class="acct-section">
                    <MudAlert Severity="Severity.Info" Class="mb-3">
                        <strong>@Loc["AuthDebugMode"]</strong> — @Loc["AuthDebugModeBody", "DebugAdmin"]
                    </MudAlert>
                    <button class="acct-btn acct-btn-primary" @onclick='() => Nav.NavigateTo("/")'>@Loc["AuthGoToHome"]</button>
                </div>
            </KitCard>
        }
    }
    else
    {
        <PlainPageHeader Kicker="@($"{Loc["Settings"]} · {Loc["AuthAccount"]}")" Title="@(AccountAuth.Username ?? string.Empty)"
                         Description="@Loc["NavSettingsAccountDescription"]">
            <Actions>
                <button class="acct-btn acct-btn-danger" @onclick="LogoutAsync">@Loc["AuthLogOutOfAccount"]</button>
            </Actions>
        </PlainPageHeader>

        @if (AccountAuth.MustChangePassword)
        {
            <MudAlert Severity="Severity.Warning">
                <strong>@Loc["AuthPasswordChangeRequired"]</strong>
                @Loc["AuthPasswordChangeRequiredBody"]
            </MudAlert>
        }

        @* While a password change is forced, the password is the only thing on the page. *@
        <KitCard Title="@Loc[AccountAuth.MustChangePassword ? "AuthPassword" : "AuthProfile"]">
            <div class="acct-section">
                @if (!AccountAuth.MustChangePassword)
                {
                    <div class="acct-row">
                        @if (_editingUsername)
                        {
                            <MudTextField @bind-Value="_newUsername" Label="@Loc["AuthUsername"]"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="acct-input acct-grow" />
                            <button class="acct-btn acct-btn-primary" disabled="@_busy" @onclick="SaveUsernameAsync">@Loc["Save"]</button>
                            <button class="acct-btn acct-btn-ghost" @onclick="() => _editingUsername = false">@Loc["Cancel"]</button>
                        }
                        else
                        {
                            <div class="acct-value"><span class="acct-label">@Loc["AuthUsername"]</span> @AccountAuth.Username</div>
                            <button class="acct-btn acct-btn-outline"
                                    @onclick="() => { _newUsername = AccountAuth.Username ?? string.Empty; _editingUsername = true; }">
                                @Loc["AuthEdit"]
                            </button>
                        }
                    </div>
                }

                <div class="acct-row acct-row--password">
                    @if (_editingPassword)
                    {
                        <div class="acct-fields">
                            <MudTextField @bind-Value="_oldPassword" Label="@Loc["AuthCurrentPassword"]"
                                          InputType="InputType.Password"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="acct-input" />
                            <MudTextField @bind-Value="_newPassword" Label="@Loc["AuthNewPassword"]"
                                          InputType="InputType.Password"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="acct-input" />
                        </div>
                        <div class="acct-field-actions">
                            <button class="acct-btn acct-btn-primary" disabled="@_busy" @onclick="SavePasswordAsync">@Loc["Save"]</button>
                            <button class="acct-btn acct-btn-ghost" @onclick="() => _editingPassword = false">@Loc["Cancel"]</button>
                        </div>
                    }
                    else
                    {
                        <div class="acct-value"><span class="acct-label">@Loc["AuthPassword"]</span> ••••••••</div>
                        <button class="acct-btn acct-btn-outline" @onclick="() => _editingPassword = true">@Loc["AuthChange"]</button>
                    }
                </div>

                @if (_profileError is not null)
                {
                    <MudAlert Severity="Severity.Error" Class="mt-3">@_profileError</MudAlert>
                }
                @if (_profileSuccess is not null)
                {
                    <MudAlert Severity="Severity.Success" Class="mt-3">@_profileSuccess</MudAlert>
                }
            </div>
        </KitCard>

        @if (!AccountAuth.MustChangePassword)
        {
            <AccountCharacterTable Characters="AccountAuth.Characters" Loading="_loadingChars" Busy="_busy"
                                   OnRefresh="RefreshCharactersAsync"
                                   OnUnlink="@(character => UnlinkCharacterAsync(character.DbrefNumber, character.Name))" />

            <PasskeyList State="_passkeyList" @bind-Busy="_busy" />
        }
    }

</div>

@code {
    private bool _editingUsername;
    private bool _editingPassword;
    private string _newUsername = string.Empty;
    private string _oldPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string? _profileError;
    private string? _profileSuccess;
    private bool _busy;
    private bool _loadingChars;
    private bool _isDebugAuth;

    private readonly PasskeyListState _passkeyList = new();

    protected override async Task OnInitializedAsync()
    {
        await AccountAuth.InitAsync();
        // Read once, after hydration, to decide how this tab bootstraps its session. The cascaded task
        // could still be the one issued before InitAsync finished.
#pragma warning disable BL0013
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
#pragma warning restore BL0013

        // In debug mode, ensure the account session for #1 is established — unless the user
        // explicitly logged out in this tab (mirrors MainLayout's guard; without it, visiting
        // /account after logout would silently re-authenticate as the debug admin).
        if (!AccountAuth.ExplicitlyLoggedOut && authState.User.Identity?.IsAuthenticated == true && !AccountAuth.IsLoggedIn)
            await AccountAuth.GetDebugOttAsync();

        _isDebugAuth = !AccountAuth.ExplicitlyLoggedOut && authState.User.Identity?.IsAuthenticated == true && !AccountAuth.IsLoggedIn;
        if (AccountAuth.IsLoggedIn && AccountAuth.Characters.Count == 0)
        {
            // Past this method's first await, so ComponentBase does not render the loading state on
            // its own here, as it does when the refresh button calls RefreshCharactersAsync.
            _loadingChars = true;
            StateHasChanged();
            await RefreshCharactersAsync();
        }

        await LoadPasskeysAsync();
    }

    private async Task LoadPasskeysAsync()
    {
        if (!AccountAuth.IsLoggedIn || AccountAuth.MustChangePassword) return;
        await _passkeyList.LoadAsync(Passkeys);
    }

    private async Task RefreshCharactersAsync()
    {
        _loadingChars = true;
        await AccountAuth.GetCharactersAsync();
        _loadingChars = false;
    }

    private async Task SaveUsernameAsync()
    {
        ClearMessages();
        _busy = true;
        var result = await AccountAuth.ChangeUsernameAsync(_newUsername);
        _busy = false;
        _editingUsername = result is not Success;
        if (result is ApiFailure failure) _profileError = failure.Message;
        else _profileSuccess = Loc["AuthUsernameUpdated"];
    }

    private async Task SavePasswordAsync()
    {
        ClearMessages();
        _busy = true;
        var result = await AccountAuth.ChangePasswordAsync(_oldPassword, _newPassword);
        _busy = false;
        _editingPassword = result is not Success;
        _oldPassword = string.Empty;
        _newPassword = string.Empty;
        if (result is ApiFailure failure) _profileError = failure.Message;
        else _profileSuccess = Loc["AuthPasswordUpdated"];
        // A forced change hid the rest of the page, the passkeys with it.
        if (result is Success && _passkeyList.Passkeys is null) await LoadPasskeysAsync();
    }

    private async Task UnlinkCharacterAsync(int dbrefNumber, string name)
    {
        // One click took the character off the account at once, and with it whatever role it carried:
        // unlinking #1 left the administrator a Guest. Linking it back needs its in-game password.
        if (!await DialogService.ConfirmAsync(Loc, Loc["AuthUnlinkConfirmTitle", name], Loc["AuthUnlinkConfirm", name],
            Loc["AuthUnlinkCharacter"])) return;

        _busy = true;
        var result = await AccountAuth.UnlinkCharacterAsync(dbrefNumber);
        _busy = false;
        // An advisory is not a failure: the unlink landed, but something after it did not (the
        // session could not be rebound), and the player has to know to pick a character.
        _profileError = result switch
        {
            AccountAuthService.CharacterUnlinked unlinked => unlinked.Advisory,
            ApiFailure failure => failure.Message,
        };
        StateHasChanged();
    }

    private async Task LogoutAsync()
    {
        await AccountAuth.LogoutAsync();
        // _isDebugAuth is computed once in OnInitializedAsync and otherwise stays true after
        // logout, which would keep this page's "Debug Mode" alert showing the stale DebugAdmin
        // identity during the re-render that AuthStateChanged triggers before we navigate away
        // — reset it directly here.
        // (NavMenu's HandleLogoutAsync has no flag of its own to mirror: it just navigates away.
        // Ending the game terminals is handled inside AccountAuth.LogoutAsync for every caller.)
        // Land on "/" (the anonymous home) rather than /login:
        // logging out returns a visitor to anonymous browsing, not a forced sign-in screen. This
        // won't re-trigger debug re-auth since AccountAuth.LogoutAsync above latches ExplicitlyLoggedOut.
        _isDebugAuth = false;
        Nav.NavigateTo("/", forceLoad: false);
    }

    private void ClearMessages() { _profileError = null; _profileSuccess = null; }
}
