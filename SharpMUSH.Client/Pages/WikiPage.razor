@page "/wiki/{Ns}/{Slug}"
@layout WikiLayout
@using SharpMUSH.Client.Components
@using SharpMUSH.Client.Models.Wiki
@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> Loc
@implements IDisposable

@if (!_redirecting)
{
    <PageTitle>@Slug — Wiki — SharpMUSH</PageTitle>
    <PalettePage Kind="wiki" Subject="@($"{Ns}/{Slug}")" Rows="@PaletteRows" />

    <WikiView @key="(Ns, Slug, Lang, ExpectedPageId)" Slug="@Slug" Namespace="@Ns"
              Locale="@Lang" ExpectedPageId="@ExpectedPageId" BrowseState="@_browseState" MembersCollection="@_membersCollection" MembersSkip="@_membersSkip"
              Mode="WikiView.WikiMode.View" />
}

@code {
    [Parameter] public required string Slug { get; set; }
    [Parameter] public required string Ns { get; set; }

    /// <summary>
    /// The locale from <c>?lang=</c>. Part of the <c>WikiView</c> <c>@key</c> above: without it a language
    /// switch reuses the same component instance and never re-fetches.
    /// </summary>
    [SupplyParameterFromQuery(Name = "lang")]
    public string? Lang { get; set; }

    /// <summary>An exact-incarnation constraint from a collection entrance; never an authorization grant.</summary>
    [SupplyParameterFromQuery(Name = "expectedPageId")]
    public string? ExpectedPageId { get; set; }

    private bool _redirecting;
    private bool _disposed;
    private WikiBrowseState? _browseState;
    private string? _membersCollection;
    private int _membersSkip;

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    private void ReadJourney()
    {
        var query = WikiBrowseState.ReadQuery(Nav.Uri);
        Lang = WikiLocaleLinks.FromUri(Nav.Uri);
        ExpectedPageId = query.GetValueOrDefault("expectedPageId");
        _browseState = !string.IsNullOrWhiteSpace(query.GetValueOrDefault("browseCollection"))
            ? new WikiBrowseState(query["browseCollection"], query.GetValueOrDefault("browseQ"), query.GetValueOrDefault("browseCategory"),
                WikiBrowseState.ParseSkip(query.GetValueOrDefault("browseSkip")), Lang).Normalize()
            : null;
        _membersCollection = string.IsNullOrWhiteSpace(query.GetValueOrDefault("membersCollection")) ? null : query["membersCollection"].Trim();
        _membersSkip = WikiBrowseState.ParseSkip(query.GetValueOrDefault("membersSkip"));
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _ = InvokeAsync(() =>
        {
            if (_disposed || new Uri(args.Location).AbsolutePath != WikiRoutes.WikiPathFor(Ns, Slug)) return;
            ReadJourney();
            StateHasChanged();
        });
    }

    public void Dispose() { _disposed = true; Nav.LocationChanged -= OnLocationChanged; }

    private IReadOnlyList<PaletteRow> PaletteRows =>
    [
        PaletteRow.Go($"{WikiRoutes.WikiPathFor(Ns, Slug)}/edit", Icons.Material.Outlined.Edit, Loc["WikiEdit"]),
        PaletteRow.Go($"{WikiRoutes.WikiPathFor(Ns, Slug)}/history", Icons.Material.Outlined.History, Loc["WkRevisionHistory"])
    ];

    // Backstop for links this app no longer produces: bookmarks, external links, hand-typed URLs,
    // and wiki markup rendered before character links became aliases. Cold loads are caught
    // earlier by CanonicalUrlMiddleware's 301, but that never sees a client-side navigation, so
    // the check has to exist here as well.
    //
    // replace: true keeps the wiki URL out of the history stack — otherwise Back lands on it and
    // is bounced straight forward again, trapping the user on the profile.
    protected override void OnParametersSet()
    {
        ReadJourney();
        _redirecting = WikiRoutes.IsCharacterProfile(Ns);
        if (_redirecting)
        {
            Nav.NavigateTo(WikiRoutes.PathFor(Ns, Slug), replace: true);
        }
    }
}
