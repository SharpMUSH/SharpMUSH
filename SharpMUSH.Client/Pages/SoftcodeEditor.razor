@page "/softcode"
@layout BuildLayout
@attribute [Authorize(Policy = "softcode.use")]
@using BlazorMonaco
@using BlazorMonaco.Editor
@using SharpMUSH.Client.Components
@using SharpMUSH.Client.Models
@using SharpMUSH.Client.Services
@inject ITerminalService Terminal
@inject MushQueryService QueryService
@inject GameCommandService Commands
@inject ObjectApiService ObjectApi
@inject IJSRuntime JsRuntime
@inject ILogger<SoftcodeEditor> Logger
@inject IStringLocalizer<SharedResource> Loc
@implements IAsyncDisposable

<PageTitle>@Loc["TermSoftcodeEditorTitle"] — @Loc["AppTitle"]</PageTitle>

@* Three-pane layout. IMPORTANT: no CSS transition on widths — Chrome freezes when
   transitioning between px and 1fr. Collapse is an instant class swap. *@
<div class="sc-shell full-height sc-shell--@(_mobilePane.ToString().ToLowerInvariant())">

    @* Mobile-only pane switcher: the three IDE panes can't coexist on a phone, so show one at
       a time. Selecting an object/attribute drills forward automatically (see handlers). *@
    <div class="sc-mobilebar">
        @* Objects and Attributes are icons so the open attribute's name gets the width. *@
        <button type="button" class="sc-mobiletab sc-mobiletab--icon @(_mobilePane == MobilePane.Objects ? "sc-mobiletab--on" : "")"
                title="@Loc["TermObjects"]" aria-label="@Loc["TermObjects"]"
                @onclick="@(() => _mobilePane = MobilePane.Objects)">
            <MudIcon Icon="@Icons.Material.Filled.Inventory2" Style="font-size:1.125rem;" />
        </button>
        <button type="button" class="sc-mobiletab sc-mobiletab--icon @(_mobilePane == MobilePane.Attrs ? "sc-mobiletab--on" : "")"
                title="@AttributesPaneLabel" aria-label="@AttributesPaneLabel"
                @onclick="@(() => _mobilePane = MobilePane.Attrs)">
            <MudIcon Icon="@Icons.Material.Filled.AccountTree" Style="font-size:1.125rem;" />
        </button>
        <button type="button" class="sc-mobiletab sc-mobiletab--editor @(_mobilePane == MobilePane.Editor ? "sc-mobiletab--on" : "")"
                title="@(ActiveTab is not null ? $"#{ActiveTab.Obj.Dbref}/{ActiveTab.Attr.Name}" : Loc["TermEditor"].Value)"
                @onclick="@(() => _mobilePane = MobilePane.Editor)"
                disabled="@(ActiveTab is null)">
            <MudIcon Icon="@Icons.Material.Filled.Code" Style="font-size:1rem;flex-shrink:0;" />
            @if (ActiveTab is null)
            {
                <span>@Loc["TermEditor"]</span>
            }
            else
            {
                @* The whole name, clipped from its outermost branch when short of room. *@
                <span class="sc-crumb-trail">&amp;@TabBranch(ActiveTab)</span>
                <span class="sc-crumb-leaf">@SoftcodeAttributeTree.Segment(ActiveTab.Attr.Name)</span>
            }
        </button>
    </div>

    <div class="sc-panel sc-pane-objects @(_objCollapsed ? "sc-pane--collapsed" : "")">
        <div style="display:flex;align-items:center;padding:0.5rem 0.5rem 0.375rem;border-bottom:1px solid var(--border-soft);gap:0.375rem;flex-shrink:0;">
            @if (!_objCollapsed)
            {
                <MudText Class="section-kicker" Style="flex:1;">@Loc["TermObjects"]</MudText>
                <MudTooltip Text="@Loc["TermCreateThing"]">
                    <MudIconButton aria-label="@Loc["TermCreateThing"]" Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" OnClick="@(() => ShowCreateObjectDialog(MushObjectType.Thing))" />
                </MudTooltip>
                <MudTooltip Text="@Loc["TermCreateRoom"]">
                    <MudIconButton aria-label="@Loc["TermCreateRoom"]" Icon="@Icons.Material.Filled.MeetingRoom" Size="Size.Small" OnClick="@(() => ShowCreateObjectDialog(MushObjectType.Room))" />
                </MudTooltip>
                <MudTooltip Text="@Loc["TermCreateExit"]">
                    <MudIconButton aria-label="@Loc["TermCreateExit"]" Icon="@Icons.Material.Filled.CallMade" Size="Size.Small" OnClick="@(() => ShowCreateObjectDialog(MushObjectType.Exit))" />
                </MudTooltip>
            }
            <MudIconButton Icon="@(_objCollapsed ? Icons.Material.Filled.ChevronRight : Icons.Material.Filled.ChevronLeft)"
                           Size="Size.Small" OnClick="@(() => _objCollapsed = !_objCollapsed)"
                           title="@(_objCollapsed ? Loc["TermExpandObjects"] : Loc["TermCollapseObjects"])"
                           aria-label="@(_objCollapsed ? Loc["TermExpandObjects"] : Loc["TermCollapseObjects"])" />
        </div>

        @if (_objCollapsed)
        {
            <div style="display:flex;flex-direction:column;align-items:center;padding:0.625rem 0;gap:0.5rem;">
                <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" Color="Color.Primary" />
                @if (_selectedObject is not null)
                {
                    <MudText Style="font-size:0.625rem;font-family:var(--font-mono);color:var(--accent);writing-mode:vertical-rl;text-orientation:mixed;">
                        #@_selectedObject.Dbref
                    </MudText>
                }
            </div>
        }
        else
        {
            <div style="flex:1;overflow:hidden;padding:0.25rem;">
                <ObjectBrowser @ref="_objectBrowser" OnObjectSelected="@(dbref => OnObjectSelected(dbref))" />
            </div>

            @if (_createObjectType.HasValue)
            {
                <div style="padding:0.375rem 0.5rem;background:var(--surface);border-top:1px solid var(--border);display:flex;gap:0.25rem;align-items:center;flex-shrink:0;">
                    <MudText Style="font-family:var(--font-mono);font-size:0.6875rem;color:var(--accent);white-space:nowrap;">
                        @(_createObjectType switch { MushObjectType.Room => "@dig", MushObjectType.Exit => "@open", _ => "@create" })
                    </MudText>
                    <MudTextField @bind-Value="_createObjectName" Placeholder="@Loc["TermObjectNamePlaceholder"]"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Style="flex:1;font-size:0.75rem;" OnKeyDown="OnCreateObjectKeyDown" />
                    <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success" OnClick="ExecuteCreateObjectAsync" aria-label="@Loc["Create"]" />
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CancelCreateObject" aria-label="@Loc["Cancel"]" />
                </div>
            }
        }
    </div>

    <div class="sc-panel sc-pane-attrs @(_attrCollapsed ? "sc-pane--collapsed" : "")">
        <div style="display:flex;align-items:center;padding:0.625rem 0.625rem 0.375rem;gap:0.375rem;flex-shrink:0;">
            @if (!_attrCollapsed)
            {
                <MudText Class="section-kicker" Style="flex:1;display:flex;align-items:center;gap:0.375rem;">
                    <span>@Loc["Attributes"]</span>
                    @if (_selectedObject is not null)
                    {
                        <span style="color:var(--accent);">· #@(_selectedObject?.Dbref)</span>
                    }
                </MudText>
                <button type="button" class="sc-add-btn" @onclick="ShowCreateAttr"
                        disabled="@(_selectedObject is null)" title="@Loc["TermAddAttribute"]">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Style="font-size:0.8125rem;" /> @Loc["Add"]
                </button>
            }
            <MudIconButton Icon="@(_attrCollapsed ? Icons.Material.Filled.ChevronRight : Icons.Material.Filled.ChevronLeft)"
                           Size="Size.Small" OnClick="@(() => _attrCollapsed = !_attrCollapsed)"
                           title="@(_attrCollapsed ? Loc["TermExpandAttributes"] : Loc["TermCollapseAttributes"])"
                           aria-label="@(_attrCollapsed ? Loc["TermExpandAttributes"] : Loc["TermCollapseAttributes"])" />
        </div>

        @if (_attrCollapsed)
        {
            <div style="display:flex;flex-direction:column;align-items:center;padding:0.625rem 0;gap:0.5rem;">
                <MudIcon Icon="@Icons.Material.Filled.Code" Size="Size.Small" Color="Color.Primary" />
                @if (ActiveTab is not null)
                {
                    <MudText Style="font-size:0.625rem;font-family:var(--font-mono);color:var(--accent);writing-mode:vertical-rl;text-orientation:mixed;">
                        &amp;@ActiveTab.Attr.Name
                    </MudText>
                }
            </div>
        }
        else
        {
            <div class="sc-search">
                <MudIcon Icon="@Icons.Material.Filled.Search" Style="font-size:0.875rem;color:var(--text-faint);" />
                <input value="@_attrSearch" @oninput="@(e => _attrSearch = e.Value?.ToString() ?? string.Empty)"
                       placeholder="@Loc["TermFilterAttributes"]" aria-label="@Loc["TermFilterAttributes"]" class="sc-search-input" />
                @if (!string.IsNullOrEmpty(_attrSearch))
                {
                    <button type="button" class="sc-search-clear" @onclick="@(() => _attrSearch = string.Empty)" title="@Loc["TermClear"]">
                        <MudIcon Icon="@Icons.Material.Filled.Close" Style="font-size:0.75rem;" />
                    </button>
                }
            </div>

            <div style="flex:1;overflow-y:auto;min-height:0;padding:0.5rem;">
                @if (_showCreateAttr)
                {
                    <div class="sc-add-row">
                        <span class="sc-add-amp">&amp;</span>
                        <input @ref="_newAttrInput" value="@_newAttrName" aria-label="@Loc["TermNewAttributeName"]"
                               @oninput="@(e => _newAttrName = e.Value?.ToString() ?? string.Empty)"
                               @onkeydown="OnCreateAttrKeyDown"
                               placeholder="ATTR`NAME" class="sc-add-input" />
                        <button type="button" class="sc-add-icon" @onclick="ExecuteCreateAttrAsync" title="@Loc["Create"]" aria-label="@Loc["Create"]">
                            <MudIcon Icon="@Icons.Material.Filled.Check" Style="font-size:0.875rem;" />
                        </button>
                        <button type="button" class="sc-add-icon" @onclick="CancelCreateAttr" title="@Loc["Cancel"]" aria-label="@Loc["Cancel"]">
                            <MudIcon Icon="@Icons.Material.Filled.Close" Style="font-size:0.875rem;" />
                        </button>
                    </div>
                }

                @if (_loadingAttrs)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                }
                else if (_selectedObject is null)
                {
                    <div style="padding:0.875rem;color:var(--text-faint);font-size:0.75rem;">@Loc["TermSelectAnObject"]</div>
                }
                else
                {
                    var rows = SoftcodeAttributeTree.Rows(AttributeTree, _expandedBranches, _attrSearch).ToList();
                    var filtering = !string.IsNullOrWhiteSpace(_attrSearch);

                    @* The attribute tree: FOO`BAR`BAZ sits under BAR, under FOO. A branch is still an
                       attribute of its own, so its name opens it and only the chevron folds it. *@
                    @foreach (var row in rows)
                    {
                        var node = row;
                        var a = node.Attribute;
                        var isActive = a is not null && ActiveTab is not null && ActiveTab.Obj.Dbref == _selectedObject.Dbref
                                       && string.Equals(ActiveTab.Attr.Name, a.Name, StringComparison.OrdinalIgnoreCase);
                        var isOpen = filtering || _expandedBranches.Contains(node.Path);
                        <div class="sc-tree-row @(node.Depth > 0 ? "sc-tree-row--nested" : "")" style="--sc-depth:@node.Depth;">
                            @if (node.IsBranch)
                            {
                                <button type="button" class="sc-tree-toggle" disabled="@filtering"
                                        aria-expanded="@(isOpen ? "true" : "false")"
                                        title="@Loc[isOpen ? "TermCollapseBranch" : "TermExpandBranch", node.Path]"
                                        aria-label="@Loc[isOpen ? "TermCollapseBranch" : "TermExpandBranch", node.Path]"
                                        @onclick="() => ToggleBranch(node.Path)">
                                    <MudIcon Icon="@(isOpen ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)" Style="font-size:0.875rem;" />
                                </button>
                            }
                            else
                            {
                                <span class="sc-tree-spacer"></span>
                            }
                            @if (a is not null)
                            {
                                <button type="button" class="sc-attr-item @(isActive ? "sc-attr-item--on" : "")"
                                        title="@a.Name" @onclick="() => OnAttributeSelected(a)">
                                    <span class="sc-attr-row1">
                                        <span class="sc-kind-badge" style="@KindBadgeStyle(a)" title="@Loc[AttrKindLabelKey(a)]">@AttrKindBadge(a)</span>
                                        <span class="sc-attr-name">@node.Segment</span>
                                        @if (node.IsBranch && !isOpen)
                                        {
                                            <span class="sc-tree-count" aria-hidden="true">@node.DescendantCount</span>
                                        }
                                    </span>
                                </button>
                            }
                            else
                            {
                                @* Listed only through what is beneath it: nothing to open, so the name folds too. *@
                                <button type="button" class="sc-attr-item sc-attr-item--bare" title="@node.Path"
                                        disabled="@filtering" @onclick="() => ToggleBranch(node.Path)">
                                    <span class="sc-attr-row1">
                                        <span class="sc-attr-name">@node.Segment</span>
                                        @if (!isOpen)
                                        {
                                            <span class="sc-tree-count" aria-hidden="true">@node.DescendantCount</span>
                                        }
                                    </span>
                                </button>
                            }
                        </div>
                    }

                    @if (rows.Count == 0 && !_showCreateAttr)
                    {
                        <div style="padding:0.75rem;color:var(--text-faint);font-size:0.75rem;text-align:center;font-family:var(--font-mono);">
                            @(string.IsNullOrWhiteSpace(_attrSearch) ? Loc["TermNoAttributes"] : Loc["TermNoMatch"])
                        </div>
                    }
                }
            </div>
        }
    </div>

    <div class="sc-panel sc-pane-editor">

        <div class="sc-editor-toolbar">
            @if (ActiveTab is not null)
            {
                <span class="sc-kind-badge" style="@KindBadgeStyle(ActiveTab.Attr)" title="@Loc[AttrKindLabelKey(ActiveTab.Attr)]">@AttrKindBadge(ActiveTab.Attr)</span>
                @* The tab strip below already names the object by dbref and marks unsaved edits, so
                   this line carries only what it adds: the object's name and links to the branches. *@
                <span class="sc-crumb-obj" title="@($"{ActiveTab.Obj.Name} (#{ActiveTab.Obj.Dbref})")">@ActiveTab.Obj.Name</span>
                <span class="sc-crumb-chevron">›</span>
                @* The name reads exactly as typed, backticks included; each branch above the
                   attribute links to that branch where this object has it. Short of room, the
                   branches give way from the outermost in and the attribute's own name stays. *@
                <span class="sc-crumbs" title="&amp;@ActiveTab.Attr.Name">
                    <span class="sc-crumb-trail">
                    <span>&amp;</span>
                    @foreach (var crumb in Breadcrumbs(ActiveTab))
                    {
                        var target = crumb.Attribute;
                        if (target is null)
                        {
                            <span class="sc-crumb-part">@crumb.Segment</span>
                        }
                        else
                        {
                            <button type="button" class="sc-crumb-link" title="@crumb.Path"
                                    @onclick="() => OnAttributeSelected(target)">@crumb.Segment</button>
                        }
                        <span class="sc-crumb-sep">`</span>
                    }
                    </span>
                    <span class="sc-crumb-leaf">@SoftcodeAttributeTree.Segment(ActiveTab.Attr.Name)</span>
                </span>
                @foreach (var flag in ActiveTab.Attr.AttributeFlags.Take(3))
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Style="height:18px;font-size:0.625rem;padding:0 0.3125rem;border-color:var(--border);">@flag</MudChip>
                }
            }
            else
            {
                <MudText Style="font-size:0.75rem;color:var(--text-faint);">@Loc["TermNoAttributeSelected"]</MudText>
            }
            <MudSpacer />
            <MudTooltip Text="@Loc["TermEvalTooltip"]">
                <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small"
                               OnClick="RunBufferAsync" Disabled="@(_evaluating || ActiveTab is null)"
                               aria-label="@Loc["TermEvalTooltip"]" Class="sc-eval" />
            </MudTooltip>
            <MudTooltip Text="@Loc["TermConsole"]">
                <MudIconButton Icon="@Icons.Material.Filled.Terminal" Size="Size.Small"
                               Color="@(_consoleOpen ? Color.Primary : Color.Default)"
                               OnClick="ToggleConsole" aria-label="@Loc["TermConsole"]"
                               aria-pressed="@(_consoleOpen ? "true" : "false")" Class="sc-console-toggle" />
            </MudTooltip>
            @* Icons alone: a floppy and a bin need no label, and the toolbar's width belongs to
               the attribute's name. The tooltip and aria-label still name them. *@
            <MudTooltip Text="@Loc["Save"]">
                <MudIconButton Icon="@Icons.Material.Filled.Save" Variant="Variant.Filled" Color="Color.Primary"
                               Size="Size.Small" OnClick="SaveAsync" Disabled="@(ActiveTab is null)"
                               aria-label="@Loc["Save"]" Class="sc-save" />
            </MudTooltip>
            <MudTooltip Text="@Loc["Delete"]">
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Variant="Variant.Outlined" Color="Color.Error"
                               Size="Size.Small" OnClick="DeleteAsync" Disabled="@(ActiveTab is null)"
                               aria-label="@Loc["Delete"]" Class="sc-delete" />
            </MudTooltip>
            <MudTooltip Text="@Loc["TermMushHelp"]">
                <MudIconButton aria-label="@Loc["TermMushHelp"]" Icon="@Icons.Material.Filled.MenuBook" Size="Size.Small"
                               OnClick="@(() => _helpDrawer?.Open())" />
            </MudTooltip>
            @if (_selectedObject is not null)
            {
                <MudTooltip Text="@Loc["TermRefreshAttributes"]">
                    <MudIconButton aria-label="@Loc["TermRefreshAttributes"]" Icon="@Icons.Material.Filled.Refresh" Size="Size.Small"
                                   OnClick="RefreshAttributesAsync" />
                </MudTooltip>
            }
        </div>

        @if (_tabs.Count > 0)
        {
            <div class="sc-tabstrip">
                @for (int i = 0; i < _tabs.Count; i++)
                {
                    var idx = i;
                    var tab = _tabs.Tabs[i];
                    // '#8/DESCRIBE' is how softcode itself addresses an attribute — get(), u(), @force.
                    // The '&' sigil belongs to the '&DESCRIBE #8=…' set syntax, so '#8&DESCRIBE' is
                    // neither form and reads as a typo.
                    var reference = $"#{tab.Obj.Dbref}/{tab.Attr.Name}";
                    <div class="sc-tab @(idx == _tabs.ActiveIndex ? "sc-tab--on" : "")">
                        <button type="button" class="sc-tab-label" title="@reference"
                                @onclick="() => SwitchTabAsync(idx)"><span class="sc-tab-ref">#@tab.Obj.Dbref/@TabBranch(tab)</span><span class="sc-tab-leaf">@SoftcodeAttributeTree.Segment(tab.Attr.Name)</span></button>
                        @if (tab.IsDirty)
                        {
                            @* role="img" + aria-label, not aria-hidden: the dot is the only thing
                               distinguishing a tab with unsaved edits, so hiding it from assistive
                               tech would leave that state with no representation at all. A bare
                               aria-label on a <span> is not reliably announced without the role. *@
                            <span class="sc-tab-dirty" role="img"
                                  title="@Loc["TermUnsaved"]" aria-label="@Loc["TermUnsaved"]">●</span>
                        }
                        @* A button of its own, not a click handler on a wrapper around a MudIconButton:
                           MudBlazor's buttons stop click propagation unconditionally, so a handler on
                           any ancestor of one never fires and the 'x' did nothing at all. *@
                        <button type="button" class="sc-tab-close"
                                @onclick="() => CloseTabAsync(idx)"
                                title="@Loc["TermCloseTab", reference]" aria-label="@Loc["TermCloseTab", reference]">
                            <MudIcon Icon="@Icons.Material.Filled.Close" Style="font-size:0.75rem;" />
                        </button>
                    </div>
                }
            </div>
        }

        <div style="flex:1;min-height:0;">
            @* Monaco is 3.67 MB and this is the only page that uses it, so it is fetched when this
               page opens rather than by every visitor of the home page. The editor is not rendered
               until the bundle is usable: BlazorMonaco's interop reaches for window.monaco as soon
               as the component initialises, and Monaco's AMD loader defines that global some time
               after its script finishes loading. *@
            @if (_editorAssetsFailed)
            {
                <EmptyState>
                    <MudText>@Loc["TermEditorAssetsUnavailable"]</MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Class="mt-2"
                               OnClick="LoadEditorAssetsAsync">@Loc["NavTryAgain"]</MudButton>
                </EmptyState>
            }
            else if (!_editorAssetsReady)
            {
                <div style="display:flex;align-items:center;justify-content:center;height:100%;">
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                </div>
            }
            else
            {
                <StandaloneCodeEditor @ref="_monacoEditor"
                                      Id="mush-editor"
                                      ConstructionOptions="BuildEditorOptions"
                                      OnDidInit="OnEditorInitAsync"
                                      OnDidChangeModelContent="OnEditorChanged"
                                      CssClass="mush-editor-fill" />
            }
        </div>

        @if (_consoleOpen)
        {
            var repl = Repl;
            <section class="sc-console" aria-label="@Loc["TermConsole"]">
                <div class="sc-console-head">
                    <span class="sc-console-title">@Loc["TermConsole"]</span>
                    @* Who the code runs as is the question every softcode author asks first, so the
                       panel says it rather than leaving it to be found out. *@
                    <span class="sc-console-hint">@(ActiveTab is { } runTab
                        ? Loc["TermConsoleSemantics", $"{runTab.Obj.Name}(#{runTab.Obj.Dbref})"]
                        : Loc["TermConsoleAsYou"])</span>
                    <MudSpacer />
                    <MudTooltip Text="@Loc["TermConsoleClear"]">
                        <MudIconButton Icon="@Icons.Material.Filled.ClearAll" Size="Size.Small"
                                       OnClick="repl.Clear" Disabled="@(repl.Entries.Count == 0)"
                                       aria-label="@Loc["TermConsoleClear"]" Class="sc-console-clear" />
                    </MudTooltip>
                </div>
                <div class="sc-console-args">
                    @for (var i = 0; i < repl.Arguments.Count; i++)
                    {
                        var index = i;
                        <label class="sc-console-arg">
                            <span class="sc-console-arg-name">%@index</span>
                            <input class="sc-console-arg-input" value="@repl.Arguments[index]" spellcheck="false"
                                   @oninput="e => repl.SetArgument(index, e.Value?.ToString() ?? string.Empty)" />
                        </label>
                    }
                    @if (repl.Arguments.Count < SoftcodeConsole.MaxArguments)
                    {
                        <button type="button" class="sc-console-argbtn sc-console-addarg" @onclick="repl.AddArgument"
                                title="@Loc["TermConsoleAddArgument", $"%{repl.Arguments.Count}"]"
                                aria-label="@Loc["TermConsoleAddArgument", $"%{repl.Arguments.Count}"]">
                            <MudIcon Icon="@Icons.Material.Filled.Add" Style="font-size:0.875rem;" />
                        </button>
                    }
                    @if (repl.Arguments.Count > 0)
                    {
                        <button type="button" class="sc-console-argbtn sc-console-removearg" @onclick="repl.RemoveArgument"
                                title="@Loc["TermConsoleRemoveArgument", $"%{repl.Arguments.Count - 1}"]"
                                aria-label="@Loc["TermConsoleRemoveArgument", $"%{repl.Arguments.Count - 1}"]">
                            <MudIcon Icon="@Icons.Material.Filled.Remove" Style="font-size:0.875rem;" />
                        </button>
                    }
                </div>
                <div class="sc-console-log" id="@ConsoleLogId" role="log" aria-live="polite">
                    @foreach (var entry in repl.Entries)
                    {
                        <div class="sc-console-entry">
                            <div class="sc-console-src">
                                <span class="sc-console-sigil" aria-hidden="true">@(entry.IsBuffer ? "▶" : "›")</span>
                                <span class="sc-console-code">@entry.Source</span>
                                @if (entry.Unsaved)
                                {
                                    <span class="sc-console-unsaved">@Loc["TermUnsaved"]</span>
                                }
                            </div>
                            @if (entry.Arguments.Count > 0)
                            {
                                <div class="sc-console-argline">@string.Join("  ", entry.Arguments.Select((a, n) => $"%{n}={a}"))</div>
                            }
                            @foreach (var line in entry.Output)
                            {
                                <div class="sc-console-out">@line</div>
                            }
                            @if (entry.Error is not null)
                            {
                                <div class="sc-console-error">@Loc["TermErrorLine", entry.Error]</div>
                            }
                            else if (!string.IsNullOrEmpty(entry.Result))
                            {
                                <div class="sc-console-result">@entry.Result</div>
                            }
                            else if (entry.Output.Count == 0)
                            {
                                <div class="sc-console-none">@Loc["TermNoOutput"]</div>
                            }
                        </div>
                    }
                </div>
                @if (_evaluating)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Success" Style="height:2px;flex-shrink:0;" />
                }
                <div class="sc-console-input">
                    <span class="sc-console-prompt" aria-hidden="true">›</span>
                    <input class="sc-console-line" value="@_consoleInput" spellcheck="false"
                           @oninput="OnConsoleInput" @onkeydown="OnConsoleKeyDown"
                           placeholder="@Loc["TermConsoleInputPlaceholder"]"
                           aria-label="@Loc["TermConsoleInputPlaceholder"]" />
                    <button type="button" class="sc-console-send" @onclick="EvaluateInputAsync"
                            disabled="@_evaluating" title="@Loc["TermConsoleEvaluate"]" aria-label="@Loc["TermConsoleEvaluate"]">
                        <MudIcon Icon="@Icons.Material.Filled.KeyboardReturn" Style="font-size:0.875rem;" />
                    </button>
                </div>
            </section>
        }

        @if (_saveMessage is not null)
        {
            <MudAlert Severity="@_saveSeverity" Dense="true" ShowCloseIcon="true"
                      CloseIconClicked="() => _saveMessage = null" Style="flex-shrink:0;">
                @_saveMessage
            </MudAlert>
        }
    </div>
</div>

<HelpDrawer @ref="_helpDrawer" />

@code {
    // The open tabs and their unsaved state; this page only moves text between them and Monaco.
    private readonly SoftcodeTabs _tabs = new();
    private SoftcodeTab? ActiveTab => _tabs.Active;

    private StandaloneCodeEditor? _monacoEditor;

    // Whether Monaco has been fetched and its globals are usable. Both start false so the editor is
    // never rendered against a half-loaded bundle.
    private bool _editorAssetsReady;
    private bool _editorAssetsFailed;

    /// <summary>
    /// Fetches the Monaco bundle for this page. Idempotent on the JS side — the loader hands every
    /// caller the same promise — so a retry after a failed network attempt costs one more try, not a
    /// duplicate set of script tags.
    /// </summary>
    private async Task LoadEditorAssetsAsync()
    {
        _editorAssetsFailed = false;

        try
        {
            await JsRuntime.InvokeVoidAsync("SharpMUSH.Assets.ensure", "monaco");
            _editorAssetsReady = true;
        }
        catch (JSException)
        {
            // The asset did not load or did not initialise in time. Say so and offer a retry rather
            // than rendering an editor that cannot work.
            _editorAssetsFailed = true;
        }

    }
    private ObjectBrowser? _objectBrowser;
    private HelpDrawer? _helpDrawer;
    private MushObject? _selectedObject;
    private bool _loadingAttrs;
    private string? _saveMessage;
    private Severity _saveSeverity = Severity.Success;
    private bool _evaluating;
    private bool _consoleOpen;
    private string _consoleInput = string.Empty;
    private const string ConsoleLogId = "sc-console-log";

    // Typed expressions, oldest first, for Up and Down. Kept in memory only, for as long as the page is
    // open: an expression can carry a secret anywhere in it (checkpass(me,...), decrypt(...,key)), which
    // no rule about a leading verb catches, so none of it goes to localStorage as the terminal's does.
    private readonly List<string> _consoleHistory = [];
    private readonly HistoryWalk _consoleWalk = new();

    private void RememberExpression(string line)
    {
        if (_consoleHistory.Count > 0 && _consoleHistory[^1] == line) return;
        _consoleHistory.Add(line);
        if (_consoleHistory.Count > CommandHistory.Capacity) _consoleHistory.RemoveAt(0);
    }

    // With no tab open, typed expressions still run; their scrollback lives here until one is.
    private readonly SoftcodeConsole _looseRepl = new();

    /// <summary>The console the panel shows: the active tab's, or the page's own with none open.</summary>
    private SoftcodeConsole Repl => ActiveTab?.Repl ?? _looseRepl;

    private bool _objCollapsed;
    private bool _attrCollapsed;

    // Which pane the mobile switcher shows. Inert on desktop (all three panes render there).
    private enum MobilePane { Objects, Attrs, Editor }
    private MobilePane _mobilePane = MobilePane.Objects;

    private string _attrSearch = string.Empty;

    private string AttributesPaneLabel => _selectedObject is null
        ? Loc["Attributes"].Value
        : $"{Loc["Attributes"].Value} · #{_selectedObject.Dbref}";

    // The selected object's attributes arranged by name, rebuilt only when a read replaces them.
    private List<MushAttribute>? _treeSource;
    private IReadOnlyList<SoftcodeAttributeNode> _attributeTree = [];

    private IReadOnlyList<SoftcodeAttributeNode> AttributeTree
    {
        get
        {
            var source = _selectedObject?.Attributes;
            if (!ReferenceEquals(source, _treeSource))
            {
                _treeSource = source;
                _attributeTree = source is null ? [] : SoftcodeAttributeTree.Build(source);
            }

            return _attributeTree;
        }
    }

    // Branches shown open in the attribute pane. Every branch starts folded, so a large object
    // reads as its top level first; opening an attribute unfolds the branches above it.
    private readonly HashSet<string> _expandedBranches = new(StringComparer.OrdinalIgnoreCase);

    private void ToggleBranch(string path)
    {
        if (!_expandedBranches.Remove(path))
            _expandedBranches.Add(path);
    }

    private void RevealInTree(SoftcodeTab tab)
    {
        if (_selectedObject?.Dbref != tab.Obj.Dbref) return;
        foreach (var ancestor in SoftcodeAttributeTree.Ancestors(tab.Attr.Name))
            _expandedBranches.Add(ancestor);
    }

    /// <summary>The branches above <paramref name="tab"/>'s attribute, each with the attribute to open for it where the selected object has one.</summary>
    private IEnumerable<(string Path, string Segment, MushAttribute? Attribute)> Breadcrumbs(SoftcodeTab tab)
    {
        var attributes = _selectedObject is { } selected && selected.Dbref == tab.Obj.Dbref ? selected.Attributes : [];
        return SoftcodeAttributeTree.Ancestors(tab.Attr.Name).Select(path => (
            path,
            SoftcodeAttributeTree.Segment(path),
            attributes.FirstOrDefault(a => string.Equals(a.Name, path, StringComparison.OrdinalIgnoreCase))));
    }

    /// <summary>The branch part of a tab's attribute name, backtick included: <c>FOO`</c> for <c>FOO`BAR</c>.</summary>
    private static string TabBranch(SoftcodeTab tab)
    {
        var cut = tab.Attr.Name.LastIndexOf(SoftcodeAttributeTree.Separator);
        return cut < 0 ? string.Empty : tab.Attr.Name[..(cut + 1)];
    }

    private MushObjectType? _createObjectType;
    private string _createObjectName = string.Empty;

    private bool _showCreateAttr;
    private string _newAttrName = string.Empty;
    private ElementReference _newAttrInput;
    private bool _focusNewAttr;

    private static readonly HashSet<string> FunctionBranches =
        new(["FN", "FUN", "FUNC", "FUNCS", "FUNCTION", "FUNCTIONS", "UFUN"], StringComparer.OrdinalIgnoreCase);

    private static string AttrKindBadge(MushAttribute attr)
    {
        if (attr.Value.TrimStart().StartsWith('$')) return "$";
        if (attr.Value.TrimStart().StartsWith('^')) return "^";
        // The tree already shows that an attribute is nested, so nesting alone no longer marks a
        // function: a branch named for functions does (FN`ROW, FUN`HEADER), as SAFE does.
        if (attr.AttributeFlags.Contains("SAFE", StringComparer.OrdinalIgnoreCase)
            || attr.Name.Split(SoftcodeAttributeTree.Separator).SkipLast(1).Any(FunctionBranches.Contains))
            return "ƒ";
        return attr.Value.Length > 0 && (char.IsDigit(attr.Value[0]) || attr.Value == "0" || attr.Value.StartsWith("#-"))
            ? "•"
            : "¶";
    }

    private static string AttrKindColor(MushAttribute attr) => AttrKindBadge(attr) switch
    {
        "$" => "var(--accent)",
        "ƒ" => "#5aa9ff",
        "^" => "#b39cff",
        "•" => "#d9a23a",
        _   => "var(--text-faint)",
    };

    private static string AttrKindLabelKey(MushAttribute attr) => AttrKindBadge(attr) switch
    {
        "$" => "TermAttrKindCommand",
        "ƒ" => "TermAttrKindFunction",
        "^" => "TermAttrKindListen",
        "•" => "TermAttrKindData",
        _   => "TermAttrKindText",
    };

    private static string AttrKindGlow(MushAttribute attr) => AttrKindBadge(attr) switch
    {
        "$" => "var(--glow)",
        "ƒ" => "90,169,255",
        "^" => "179,156,255",
        "•" => "217,162,58",
        _   => "95,104,112",
    };

    private static string KindBadgeStyle(MushAttribute attr)
        => $"background:rgba({AttrKindGlow(attr)},0.14);border:1px solid rgba({AttrKindGlow(attr)},0.3);color:{AttrKindColor(attr)};";

    protected override Task OnInitializedAsync() => LoadEditorAssetsAsync();

    // No init on first render. SharpMUSH.Monaco lives in the Monaco bundle, which is fetched on
    // demand now, so on the render where the editor is still loading — or the one where it failed to
    // and is never shown — that global does not exist and the call throws. OnDidInit below does the
    // same init at the only moment it can work: when the editor has actually mounted.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusNewAttr)
        {
            _focusNewAttr = false;
            try { await _newAttrInput.FocusAsync(); }
            catch { /* element may have been dismissed before focus */ }
        }
    }

    private StandaloneEditorConstructionOptions BuildEditorOptions(StandaloneCodeEditor editor) => new()
    {
        Language = "plaintext",
        Theme = "vs-dark",
        AutomaticLayout = true,
        Value = ActiveTab?.WorkingContent ?? string.Empty,
        FontFamily = "var(--font-mono)",
        FontSize = 13,
        LineNumbers = "on",
        WordWrap = "on",
        Minimap = new EditorMinimapOptions { Enabled = false },
        ScrollBeyondLastLine = false,
        SuggestOnTriggerCharacters = true,
        FixedOverflowWidgets = true,
    };

    private async Task OnEditorInitAsync()
    {
        try
        {
            await JsRuntime.InvokeVoidAsync("SharpMUSH.Monaco.initEditor", "mush-editor");
        }
        catch (JSException ex)
        {
            // The editor still edits; it only loses MUSH highlighting and completion.
            Logger.LogWarning(ex, "Monaco MUSH language setup failed");
        }
    }

    private async Task SetEditorValueAsync(string value)
    {
        if (_monacoEditor is null) return;
        await _monacoEditor.SetValue(value);
    }

    /// <summary>
    /// Keeps the active tab's buffer in step with Monaco; whether it is unsaved follows from that
    /// (see <see cref="SoftcodeTab.IsDirty"/>), however and whenever Monaco raises this event.
    /// </summary>
    private async Task OnEditorChanged(ModelContentChangedEvent e)
    {
        if (_monacoEditor is null || ActiveTab is null) return;

        _tabs.Capture(await _monacoEditor.GetValue());
    }

    /// <summary>Keeps what the editor holds as the active tab's buffer before the active tab changes.</summary>
    private async Task CaptureEditorAsync()
    {
        if (_monacoEditor is not null && ActiveTab is not null)
            _tabs.Capture(await _monacoEditor.GetValue());
    }

    private async Task OnAttributeSelected(MushAttribute? attr)
    {
        if (attr is null || _selectedObject is null) return;
        _saveMessage = null;

        await CaptureEditorAsync();

        var tab = _tabs.Open(_selectedObject, attr);
        RevealInTree(tab);
        await SetEditorValueAsync(tab.WorkingContent);

        // Mobile drill-down: picking an attribute advances to the editor.
        _mobilePane = MobilePane.Editor;

        StateHasChanged();
    }

    private async Task SwitchTabAsync(int idx)
    {
        if (idx == _tabs.ActiveIndex) return;
        await CaptureEditorAsync();
        _tabs.Switch(idx);
        if (ActiveTab is not null)
        {
            RevealInTree(ActiveTab);
            await SetEditorValueAsync(ActiveTab.WorkingContent);
        }
        StateHasChanged();
    }

    private async Task CloseTabAsync(int idx)
    {
        // The editor is reloaded from the tab left active, so its unsaved text is captured first
        // even when the tab being closed is another one.
        await CaptureEditorAsync();
        var active = _tabs.Close(idx);
        if (active is not null)
            RevealInTree(active);
        if (_monacoEditor is not null)
            await SetEditorValueAsync(active?.WorkingContent ?? string.Empty);
        StateHasChanged();
    }

    // advanceMobilePane: only true for a direct object pick. Internal refreshes
    // (Save, Refresh attributes) reuse this method and must NOT yank the mobile user
    // out of the editor back to the attributes pane.
    /// <summary>
    /// Monotonic ticket for object loads. Clicking a second object before the first responds must
    /// not let the older, slower answer land on top of the newer selection.
    /// </summary>
    private int _objectLoadGeneration;

    private async Task OnObjectSelected(int dbref, bool advanceMobilePane = true)
    {
        var generation = ++_objectLoadGeneration;

        _loadingAttrs = true;
        _saveMessage = null;
        _showCreateAttr = false;
        StateHasChanged();

        try
        {
            var result = await ObjectApi.GetObjectAsync(dbref);

            // Someone selected something else while this was in flight; that request owns the
            // state now, including the loading flag it set on its own way in.
            if (generation != _objectLoadGeneration) return;

            switch (result)
            {
                case MushObject obj:
                    // A different object's branches share nothing with this one's; a re-read of
                    // the same object keeps what the reader had unfolded.
                    if (_selectedObject?.Dbref != obj.Dbref)
                        _expandedBranches.Clear();
                    _selectedObject = obj;
                    // Mobile drill-down: picking an object advances to its attributes.
                    if (advanceMobilePane)
                        _mobilePane = MobilePane.Attrs;
                    break;
                case ApiFailure failure:
                    // The selection is deliberately left alone. This runs on the reload after a
                    // successful save too, and blanking the panes because a re-read failed would
                    // throw away work the user can still see and re-save.
                    _saveMessage = Loc["TermErrorLoadingObject", failure.Message];
                    _saveSeverity = Severity.Error;
                    break;
            }
        }
        finally
        {
            // Only the newest request owns the flag; an older one clearing it would unstick the
            // spinner while the current load is still running.
            if (generation == _objectLoadGeneration)
            {
                _loadingAttrs = false;
                StateHasChanged();
            }
        }
    }

    /// <summary>
    /// Re-reads the selected object and re-syncs its open tabs.
    /// </summary>
    /// <returns>
    /// Whether the reload actually landed. A caller that is about to report its own success needs
    /// to know: overwriting a "could not re-read the object" message with "saved" hides the fact
    /// that what is on screen is now stale.
    /// </returns>
    private async Task<bool> RefreshAttributesAsync()
    {
        if (_selectedObject is null) return false;

        // Captured before the await: the user may select a different object while the reload runs,
        // and this refresh must only ever touch tabs belonging to the object it started on.
        var dbref = _selectedObject.Dbref;

        await OnObjectSelected(dbref, advanceMobilePane: false);

        if (_selectedObject is not null && _selectedObject.Dbref == dbref)
            _tabs.Refresh(_selectedObject);
        if (ActiveTab is not null)
            await SetEditorValueAsync(ActiveTab.WorkingContent);

        return _selectedObject is not null && _selectedObject.Dbref == dbref;
    }

    private async Task SaveAsync()
    {
        if (ActiveTab is null || _monacoEditor is null) return;

        // The tab itself is captured, not just its name and dbref: the user can switch tabs while
        // the PUT is in flight, and the result belongs to the tab that initiated it. Writing back
        // through ActiveTab marked whichever tab happened to be active as clean, handing it another
        // tab's saved baseline — so it read as saved when it was not, and the next refresh
        // overwrote it.
        var tab = ActiveTab;
        var value = await _monacoEditor.GetValue();

        // GetValue is interop and yields. A tab switch during it loads the other tab's text into
        // Monaco, so `value` may be that tab's content — writing it to `tab` would PUT one
        // attribute's text over another's.
        if (!ReferenceEquals(ActiveTab, tab)) return;

        _tabs.Capture(value);

        // Sent verbatim — newlines included. The API carries the value in a JSON body, so there is
        // nothing to escape and nothing for the server to decode.
        var result = await ObjectApi.SetAttributeAsync(tab.Obj.Dbref, tab.Attr.Name, value);
        if (result is ApiFailure failure)
        {
            _saveMessage = failure.Message;
            _saveSeverity = Severity.Error;
            StateHasChanged();
            return;
        }

        // The buffer is now what the database holds, so that tab is clean by definition.
        tab.MarkSaved(value);

        // Only claim success once the re-read confirms it. If the reload failed it has already put
        // its own error on screen, and overwriting that with "saved" would leave the user looking
        // at stale panes believing everything is current.
        if (await RefreshAttributesAsync())
        {
            _saveMessage = Loc["TermSavedAttribute", tab.Attr.Name, tab.Obj.Dbref];
            _saveSeverity = Severity.Success;
        }

    }

    private async Task DeleteAsync()
    {
        if (ActiveTab is null) return;

        // Captured for the same reason as SaveAsync: on return we must close the tab we deleted
        // from, not whichever one the user switched to meanwhile.
        var tab = ActiveTab;

        var result = await ObjectApi.DeleteAttributeAsync(tab.Obj.Dbref, tab.Attr.Name);
        if (result is ApiFailure failure)
        {
            _saveMessage = failure.Message;
            _saveSeverity = Severity.Error;
            StateHasChanged();
            return;
        }

        var tabIdx = _tabs.IndexOf(tab);
        if (tabIdx >= 0) await CloseTabAsync(tabIdx);

        // After the refresh, not before: RefreshAttributesAsync goes through OnObjectSelected,
        // which clears _saveMessage on its way in, so a confirmation set earlier never renders.
        if (await RefreshAttributesAsync())
        {
            _saveMessage = Loc["TermDeletedAttribute", tab.Attr.Name];
            _saveSeverity = Severity.Info;
        }

    }

    private void ToggleConsole() => _consoleOpen = !_consoleOpen;

    /// <summary>
    /// Runs the editor's buffer as it stands, unsaved edits included, as the object holding the attribute:
    /// what <c>u()</c> would do with it once saved, with the console's arguments as <c>%0</c> onward.
    /// </summary>
    private async Task RunBufferAsync()
    {
        if (_monacoEditor is null || ActiveTab is null) return;

        var tab = ActiveTab;
        var value = await _monacoEditor.GetValue() ?? string.Empty;
        // As in SaveAsync: a tab switch during the interop call loads another tab's text into Monaco.
        if (!ReferenceEquals(ActiveTab, tab)) return;
        _tabs.Capture(value);

        _consoleOpen = true;
        await EvaluateAsync(tab.Repl, $"#{tab.Obj.Dbref}/{tab.Attr.Name}", isBuffer: true, tab.IsDirty, value, tab.Obj.Dbref);
    }

    private void OnConsoleInput(ChangeEventArgs e)
    {
        _consoleInput = e.Value?.ToString() ?? string.Empty;
        _consoleWalk.Reset();
    }

    /// <summary>Enter evaluates; Up and Down walk the console's history, as the terminal's input line does.</summary>
    private async Task OnConsoleKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Enter":
                await EvaluateInputAsync();
                break;
            case "ArrowUp":
                if (_consoleWalk.Older(_consoleHistory, _consoleInput) is { } older) _consoleInput = older;
                break;
            case "ArrowDown":
                if (_consoleWalk.Newer(_consoleHistory) is { } newer) _consoleInput = newer;
                break;
        }
    }

    /// <summary>Evaluates the typed expression as the character, with the console's arguments.</summary>
    private async Task EvaluateInputAsync()
    {
        var line = _consoleInput.Trim();
        if (line.Length == 0 || _evaluating) return;

        _consoleInput = string.Empty;
        _consoleWalk.Reset();
        RememberExpression(line);
        await EvaluateAsync(Repl, line, isBuffer: false, unsaved: false, line, objectDbref: null);
    }

    /// <summary>Evaluates <paramref name="expression"/> and adds what came back to <paramref name="console"/>.</summary>
    /// <remarks>
    /// The console is captured by the caller, not read back afterwards: the reader may switch tabs while
    /// the request is out, and the answer belongs with the tab that asked.
    /// </remarks>
    private async Task EvaluateAsync(SoftcodeConsole console, string source, bool isBuffer, bool unsaved,
        string expression, int? objectDbref)
    {
        var arguments = console.ArgumentsToSend;
        // An empty buffer has nothing to evaluate, and the server would refuse it as a bad request.
        if (string.IsNullOrWhiteSpace(expression))
        {
            console.Add(new SoftcodeConsoleEntry(source, isBuffer, unsaved, arguments, [], string.Empty, null, false));
            await ScrollConsoleAsync();
            return;
        }

        _evaluating = true;
        StateHasChanged();
        try
        {
            var answer = await Commands.EvaluateAsync(expression, arguments.Count > 0 ? arguments : null, objectDbref);
            console.Add(answer switch
            {
                PortalCommandResponse response => new SoftcodeConsoleEntry(source, isBuffer, unsaved, arguments,
                    response.Output, response.Result, null, response.Truncated),
                ApiFailure failure => new SoftcodeConsoleEntry(source, isBuffer, unsaved, arguments, [], null, failure.Message, false),
            });
        }
        finally
        {
            _evaluating = false;
        }

        StateHasChanged();
        await ScrollConsoleAsync();
    }

    private async Task ScrollConsoleAsync()
    {
        try { await JsRuntime.InvokeVoidAsync("SharpMUSH.Terminal.jumpToLatest", ConsoleLogId); }
        catch (JSException) { /* the newest entry is still there to scroll to */ }
    }

    private void ShowCreateObjectDialog(MushObjectType type)
    {
        _createObjectType = type;
        _createObjectName = string.Empty;
    }

    private void CancelCreateObject() => _createObjectType = null;

    private async Task ExecuteCreateObjectAsync()
    {
        if (_createObjectType is null || string.IsNullOrWhiteSpace(_createObjectName)) return;
        var type = _createObjectType.Value;
        var name = _createObjectName.Trim();
        _createObjectType = null;
        _createObjectName = string.Empty;
        switch (await ObjectApi.CreateObjectAsync(name, type))
        {
            case int newDbref:
                if (_objectBrowser is not null)
                {
                    await _objectBrowser.RefreshAsync();
                    await _objectBrowser.SelectDbrefAsync(newDbref);
                }
                break;
            case ApiFailure failure:
                _saveMessage = failure.Message;
                _saveSeverity = Severity.Error;
                break;
        }
    }

    private async Task OnCreateObjectKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ExecuteCreateObjectAsync();
        else if (e.Key == "Escape") CancelCreateObject();
    }

    private void ShowCreateAttr() { _showCreateAttr = true; _newAttrName = string.Empty; _focusNewAttr = true; }
    private void CancelCreateAttr() => _showCreateAttr = false;

    private async Task ExecuteCreateAttrAsync()
    {
        if (_selectedObject is null || string.IsNullOrWhiteSpace(_newAttrName)) return;
        var attrName = _newAttrName.Trim().ToUpperInvariant();
        _showCreateAttr = false;
        _newAttrName = string.Empty;
        // 'null()' rather than an empty value: with empty_attrs off the engine treats an empty set
        // as a clear, so a genuinely empty attribute could not be created to open a tab on.
        // Captured before the await: a refresh must target the object the attribute was created
        // on, not whichever one is selected by the time the request comes back.
        var targetDbref = _selectedObject.Dbref;

        var result = await ObjectApi.SetAttributeAsync(targetDbref, attrName, "null()");
        if (result is ApiFailure failure)
        {
            _saveMessage = failure.Message;
            _saveSeverity = Severity.Error;
            StateHasChanged();
            return;
        }

        // Read into a local after each await and work from that. Comparing the dbref rather than
        // the instance is deliberate — a refresh legitimately replaces _selectedObject with a fresh
        // read of the same object — and the local keeps the null check honestly nullable instead of
        // a condition the compiler can fold away.
        var selectedAfterCreate = _selectedObject;
        if (selectedAfterCreate is null || selectedAfterCreate.Dbref != targetDbref) return;

        await RefreshAttributesAsync();

        var selectedAfterRefresh = _selectedObject;
        if (selectedAfterRefresh is null || selectedAfterRefresh.Dbref != targetDbref) return;

        var created = selectedAfterRefresh.Attributes.FirstOrDefault(a =>
            string.Equals(a.Name, attrName, StringComparison.OrdinalIgnoreCase));
        if (created is not null)
            await OnAttributeSelected(created);
    }

    private async Task OnCreateAttrKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ExecuteCreateAttrAsync();
        else if (e.Key == "Escape") CancelCreateAttr();
    }

    public ValueTask DisposeAsync() => ValueTask.CompletedTask;
}
