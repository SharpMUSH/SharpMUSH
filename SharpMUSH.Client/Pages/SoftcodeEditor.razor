@page "/softcode"
@attribute [Authorize(Policy = "softcode.use")]
@using BlazorMonaco
@using BlazorMonaco.Editor
@using SharpMUSH.Client.Components
@using SharpMUSH.Client.Models
@using SharpMUSH.Client.Services
@inject ITerminalService Terminal
@inject MushQueryService QueryService
@inject ObjectApiService ObjectApi
@inject IJSRuntime JsRuntime
@inject IStringLocalizer<SharedResource> Loc
@implements IAsyncDisposable

<PageTitle>@Loc["TermSoftcodeEditorTitle"] — @Loc["AppTitle"]</PageTitle>

@* Three-pane layout. IMPORTANT: no CSS transition on widths — Chrome freezes when
   transitioning between px and 1fr. Collapse is an instant class swap. *@
<div class="sc-shell full-bleed full-height sc-shell--@(_mobilePane.ToString().ToLowerInvariant())">

    @* Mobile-only pane switcher: the three IDE panes can't coexist on a phone, so show one at
       a time. Selecting an object/attribute drills forward automatically (see handlers). *@
    <div class="sc-mobilebar">
        <button type="button" class="sc-mobiletab @(_mobilePane == MobilePane.Objects ? "sc-mobiletab--on" : "")"
                @onclick="@(() => _mobilePane = MobilePane.Objects)">@Loc["TermObjects"]</button>
        <button type="button" class="sc-mobiletab @(_mobilePane == MobilePane.Attrs ? "sc-mobiletab--on" : "")"
                @onclick="@(() => _mobilePane = MobilePane.Attrs)">
            @Loc["Attributes"]@(_selectedObject is not null ? $" · #{_selectedObject.Dbref}" : "")
        </button>
        <button type="button" class="sc-mobiletab @(_mobilePane == MobilePane.Editor ? "sc-mobiletab--on" : "")"
                @onclick="@(() => _mobilePane = MobilePane.Editor)"
                disabled="@(ActiveTab is null)">
            @Loc["TermEditor"]@(ActiveTab is not null ? $" · &{ActiveTab.Attr.Name}" : "")
        </button>
    </div>

    <div class="sc-panel sc-pane-objects @(_objCollapsed ? "sc-pane--collapsed" : "")">
        <div style="display:flex;align-items:center;padding:0.5rem 0.5rem 0.375rem;border-bottom:1px solid var(--border-soft);gap:0.375rem;flex-shrink:0;">
            @if (!_objCollapsed)
            {
                <MudText Class="section-kicker" Style="flex:1;">@Loc["TermObjects"]</MudText>
                <MudTooltip Text="@Loc["TermCreateThing"]">
                    <MudIconButton Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" OnClick="@(() => ShowCreateObjectDialog(MushObjectType.Thing))" />
                </MudTooltip>
                <MudTooltip Text="@Loc["TermCreateRoom"]">
                    <MudIconButton Icon="@Icons.Material.Filled.MeetingRoom" Size="Size.Small" OnClick="@(() => ShowCreateObjectDialog(MushObjectType.Room))" />
                </MudTooltip>
                <MudTooltip Text="@Loc["TermCreateExit"]">
                    <MudIconButton Icon="@Icons.Material.Filled.CallMade" Size="Size.Small" OnClick="@(() => ShowCreateObjectDialog(MushObjectType.Exit))" />
                </MudTooltip>
            }
            <MudIconButton Icon="@(_objCollapsed ? Icons.Material.Filled.ChevronRight : Icons.Material.Filled.ChevronLeft)"
                           Size="Size.Small" OnClick="@(() => _objCollapsed = !_objCollapsed)"
                           title="@(_objCollapsed ? Loc["TermExpandObjects"] : Loc["TermCollapseObjects"])" />
        </div>

        @if (_objCollapsed)
        {
            <div style="display:flex;flex-direction:column;align-items:center;padding:0.625rem 0;gap:0.5rem;">
                <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" Color="Color.Primary" />
                @if (_selectedObject is not null)
                {
                    <MudText Style="font-size:0.625rem;font-family:var(--font-mono);color:var(--accent);writing-mode:vertical-rl;text-orientation:mixed;">
                        #@_selectedObject.Dbref
                    </MudText>
                }
            </div>
        }
        else
        {
            <div style="flex:1;overflow:hidden;padding:0.25rem;">
                <ObjectBrowser @ref="_objectBrowser" OnObjectSelected="@(dbref => OnObjectSelected(dbref))" />
            </div>

            @if (_createObjectType.HasValue)
            {
                <div style="padding:0.375rem 0.5rem;background:var(--surface);border-top:1px solid var(--border);display:flex;gap:0.25rem;align-items:center;flex-shrink:0;">
                    <MudText Style="font-family:var(--font-mono);font-size:0.6875rem;color:var(--accent);white-space:nowrap;">
                        @(_createObjectType switch { MushObjectType.Room => "@dig", MushObjectType.Exit => "@open", _ => "@create" })
                    </MudText>
                    <MudTextField @bind-Value="_createObjectName" Placeholder="@Loc["TermObjectNamePlaceholder"]"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Style="flex:1;font-size:0.75rem;" OnKeyDown="OnCreateObjectKeyDown" />
                    <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success" OnClick="ExecuteCreateObjectAsync" />
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CancelCreateObject" />
                </div>
            }
        }
    </div>

    <div class="sc-panel sc-pane-attrs @(_attrCollapsed ? "sc-pane--collapsed" : "")">
        <div style="display:flex;align-items:center;padding:0.625rem 0.625rem 0.375rem;gap:0.375rem;flex-shrink:0;">
            @if (!_attrCollapsed)
            {
                <MudText Class="section-kicker" Style="flex:1;display:flex;align-items:center;gap:0.375rem;">
                    <span>@Loc["Attributes"]</span>
                    @if (_selectedObject is not null)
                    {
                        <span style="color:var(--accent);">· #@(_selectedObject?.Dbref)</span>
                    }
                </MudText>
                <button type="button" class="sc-add-btn" @onclick="ShowCreateAttr"
                        disabled="@(_selectedObject is null)" title="@Loc["TermAddAttribute"]">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Style="font-size:0.8125rem;" /> @Loc["Add"]
                </button>
            }
            <MudIconButton Icon="@(_attrCollapsed ? Icons.Material.Filled.ChevronRight : Icons.Material.Filled.ChevronLeft)"
                           Size="Size.Small" OnClick="@(() => _attrCollapsed = !_attrCollapsed)"
                           title="@(_attrCollapsed ? Loc["TermExpandAttributes"] : Loc["TermCollapseAttributes"])" />
        </div>

        @if (_attrCollapsed)
        {
            <div style="display:flex;flex-direction:column;align-items:center;padding:0.625rem 0;gap:0.5rem;">
                <MudIcon Icon="@Icons.Material.Filled.Code" Size="Size.Small" Color="Color.Primary" />
                @if (ActiveTab is not null)
                {
                    <MudText Style="font-size:0.625rem;font-family:var(--font-mono);color:var(--accent);writing-mode:vertical-rl;text-orientation:mixed;">
                        &amp;@ActiveTab.Attr.Name
                    </MudText>
                }
            </div>
        }
        else
        {
            <div class="sc-search">
                <MudIcon Icon="@Icons.Material.Filled.Search" Style="font-size:0.875rem;color:var(--text-faint);" />
                <input value="@_attrSearch" @oninput="@(e => _attrSearch = e.Value?.ToString() ?? string.Empty)"
                       placeholder="@Loc["TermFilterAttributes"]" class="sc-search-input" />
                @if (!string.IsNullOrEmpty(_attrSearch))
                {
                    <button type="button" class="sc-search-clear" @onclick="@(() => _attrSearch = string.Empty)" title="@Loc["TermClear"]">
                        <MudIcon Icon="@Icons.Material.Filled.Close" Style="font-size:0.75rem;" />
                    </button>
                }
            </div>

            <div style="flex:1;overflow-y:auto;min-height:0;padding:0.5rem;">
                @if (_showCreateAttr)
                {
                    <div class="sc-add-row">
                        <span class="sc-add-amp">&amp;</span>
                        <input @ref="_newAttrInput" value="@_newAttrName"
                               @oninput="@(e => _newAttrName = e.Value?.ToString() ?? string.Empty)"
                               @onkeydown="OnCreateAttrKeyDown"
                               placeholder="ATTR`NAME" class="sc-add-input" />
                        <button type="button" class="sc-add-icon" @onclick="ExecuteCreateAttrAsync" title="@Loc["Create"]">
                            <MudIcon Icon="@Icons.Material.Filled.Check" Style="font-size:0.875rem;" />
                        </button>
                        <button type="button" class="sc-add-icon" @onclick="CancelCreateAttr" title="@Loc["Cancel"]">
                            <MudIcon Icon="@Icons.Material.Filled.Close" Style="font-size:0.875rem;" />
                        </button>
                    </div>
                }

                @if (_loadingAttrs)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                }
                else if (_selectedObject is null)
                {
                    <div style="padding:0.875rem;color:var(--text-faint);font-size:0.75rem;">@Loc["TermSelectAnObject"]</div>
                }
                else
                {
                    var filteredAttrs = string.IsNullOrWhiteSpace(_attrSearch)
                        ? _selectedObject.Attributes
                        : _selectedObject.Attributes.Where(a => a.Name.Contains(_attrSearch, StringComparison.OrdinalIgnoreCase)).ToList();

                    @foreach (var attr in filteredAttrs)
                    {
                        var a = attr;
                        var isActive = ActiveTab?.Attr.Name == a.Name && ActiveTab?.Obj.Dbref == _selectedObject.Dbref;
                        <button type="button" class="sc-attr-item @(isActive ? "sc-attr-item--on" : "")"
                                @onclick="() => OnAttributeSelected(a)">
                            <span class="sc-attr-row1">
                                <span class="sc-kind-badge" style="@KindBadgeStyle(a)" title="@Loc[AttrKindLabelKey(a)]">@AttrKindBadge(a)</span>
                                <span class="sc-attr-name">@a.Name</span>
                            </span>
                            <span class="sc-attr-desc">@(AttrPreview(a) ?? Loc["TermAttrEmpty"].Value)</span>
                        </button>
                    }

                    @if (filteredAttrs.Count == 0 && !_showCreateAttr)
                    {
                        <div style="padding:0.75rem;color:var(--text-faint);font-size:0.75rem;text-align:center;font-family:var(--font-mono);">
                            @(string.IsNullOrWhiteSpace(_attrSearch) ? Loc["TermNoAttributes"] : Loc["TermNoMatch"])
                        </div>
                    }
                }
            </div>
        }
    </div>

    <div class="sc-panel sc-pane-editor">

        <div class="sc-editor-toolbar">
            @if (ActiveTab is not null)
            {
                <span class="sc-kind-badge" style="@KindBadgeStyle(ActiveTab.Attr)" title="@Loc[AttrKindLabelKey(ActiveTab.Attr)]">@AttrKindBadge(ActiveTab.Attr)</span>
                <MudText Style="font-size:0.75rem;font-family:var(--font-mono);color:var(--text-dim);">
                    @ActiveTab.Obj.Name
                </MudText>
                <MudText Style="font-size:0.75rem;color:var(--text-faint);">›</MudText>
                <MudText Style="font-size:0.75rem;font-family:var(--font-mono);color:var(--accent);font-weight:600;">
                    &amp;@ActiveTab.Attr.Name
                </MudText>
                <MudText Style="font-size:0.6875rem;font-family:var(--font-mono);color:var(--text-faint);">
                    #@ActiveTab.Obj.Dbref
                </MudText>
                @foreach (var flag in ActiveTab.Attr.AttributeFlags.Take(3))
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Style="height:18px;font-size:0.625rem;padding:0 0.3125rem;border-color:var(--border);">@flag</MudChip>
                }
                @if (ActiveTab.IsDirty)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning"
                             Style="height:18px;font-size:0.625rem;padding:0 0.3125rem;">@Loc["TermUnsaved"]</MudChip>
                }
            }
            else
            {
                <MudText Style="font-size:0.75rem;color:var(--text-faint);">@Loc["TermNoAttributeSelected"]</MudText>
            }
            <MudSpacer />
            <MudTooltip Text="@Loc["TermTestTooltip"]">
                <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.PlayArrow"
                           OnClick="EvalAsync"
                           Disabled="@(_evalLoading || ActiveTab is null)">
                    @Loc["TermTest"]
                </MudButton>
            </MudTooltip>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveAsync"
                       Disabled="@(ActiveTab is null)">
                @Loc["Save"]
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Delete"
                       OnClick="DeleteAsync"
                       Disabled="@(ActiveTab is null)">
                @Loc["Delete"]
            </MudButton>
            <MudTooltip Text="@Loc["TermMushHelp"]">
                <MudIconButton Icon="@Icons.Material.Filled.MenuBook" Size="Size.Small"
                               OnClick="@(() => _helpDrawer?.Open())" />
            </MudTooltip>
            @if (_selectedObject is not null)
            {
                <MudTooltip Text="@Loc["TermRefreshAttributes"]">
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small"
                                   OnClick="RefreshAttributesAsync" />
                </MudTooltip>
            }
        </div>

        @if (_openTabs.Count > 0)
        {
            <div style="display:flex;overflow-x:auto;background:var(--surface-3);border-bottom:1px solid var(--border);min-height:30px;align-items:stretch;flex-shrink:0;">
                @for (int i = 0; i < _openTabs.Count; i++)
                {
                    var idx = i;
                    var tab = _openTabs[i];
                    var isActive = idx == _activeTabIndex;
                    <div style="@($"display:flex;align-items:center;gap:0.25rem;padding:0 0.625rem 0 0.75rem;cursor:pointer;white-space:nowrap;border-right:1px solid var(--border);font-size:0.6875rem;font-family:var(--font-mono);background:{(isActive ? "var(--surface)" : "transparent")};color:{(isActive ? "var(--accent)" : "var(--text-faint)")};border-top:{(isActive ? "2px solid var(--accent)" : "2px solid transparent")}")"
                         @onclick="() => SwitchTabAsync(idx)">
                        <span>#@tab.Obj.Dbref&amp;@tab.Attr.Name@(tab.IsDirty ? " ●" : "")</span>
                        <span @onclick:stopPropagation="true" @onclick="() => CloseTabAsync(idx)">
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                           Style="padding:0;min-width:14px;height:14px;width:14px;"
                                           Color="@(tab.IsDirty ? Color.Warning : Color.Default)" />
                        </span>
                    </div>
                }
            </div>
        }

        <div style="flex:1;min-height:0;">
            <StandaloneCodeEditor @ref="_monacoEditor"
                                  Id="mush-editor"
                                  ConstructionOptions="BuildEditorOptions"
                                  OnDidInit="OnEditorInitAsync"
                                  OnDidChangeModelContent="OnEditorChanged"
                                  CssClass="mush-editor-fill" />
        </div>

        @if (_evalLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Success" Style="height:2px;flex-shrink:0;" />
        }
        else if (_evalOutput is not null)
        {
            <div class="mush-eval-output" style="flex-shrink:0;">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.25rem;">
                    <MudText Typo="Typo.caption" Color="Color.Success">▶ @Loc["TermEvalResult"]</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                   Style="padding:0;min-width:0;height:16px;" Color="Color.Default"
                                   OnClick="@(() => { _evalOutput = null; StateHasChanged(); })" />
                </div>
                @_evalOutput
            </div>
        }

        @if (_saveMessage is not null)
        {
            <MudAlert Severity="@_saveSeverity" Dense="true" ShowCloseIcon="true"
                      CloseIconClicked="() => _saveMessage = null" Style="flex-shrink:0;">
                @_saveMessage
            </MudAlert>
        }
    </div>
</div>

<HelpDrawer @ref="_helpDrawer" />

@code {
    private sealed class AttrTab(MushObject obj, MushAttribute attr)
    {
        public MushObject Obj { get; } = obj;
        public MushAttribute Attr { get; } = attr;
        // Verbatim: the stored value IS what the author typed. This used to translate every
        // stored %r into a newline, which was the mirror of the save-side rewrite and made the
        // two indistinguishable — an intentional %r looked like formatting and a real newline
        // came back as %r on the next save.
        public string WorkingContent { get; set; } = attr.Value;

        /// <summary>What the database holds. Dirty is derived from this, never tracked by hand.</summary>
        public string SavedContent { get; set; } = attr.Value;

        public bool IsDirty { get; set; }
    }

    private readonly List<AttrTab> _openTabs = [];
    private int _activeTabIndex = -1;
    private AttrTab? ActiveTab => _activeTabIndex >= 0 && _activeTabIndex < _openTabs.Count
        ? _openTabs[_activeTabIndex]
        : null;

    private StandaloneCodeEditor? _monacoEditor;
    private ObjectBrowser? _objectBrowser;
    private HelpDrawer? _helpDrawer;
    private MushObject? _selectedObject;
    private bool _loadingAttrs;
    private string? _saveMessage;
    private Severity _saveSeverity = Severity.Success;
    private string? _evalOutput;
    private bool _evalLoading;

    private bool _objCollapsed;
    private bool _attrCollapsed;

    // Which pane the mobile switcher shows. Inert on desktop (all three panes render there).
    private enum MobilePane { Objects, Attrs, Editor }
    private MobilePane _mobilePane = MobilePane.Objects;

    private string _attrSearch = string.Empty;

    private MushObjectType? _createObjectType;
    private string _createObjectName = string.Empty;

    private bool _showCreateAttr;
    private string _newAttrName = string.Empty;
    private ElementReference _newAttrInput;
    private bool _focusNewAttr;

    private static string AttrKindBadge(MushAttribute attr)
    {
        if (attr.Value.TrimStart().StartsWith('$')) return "$";
        if (attr.Value.TrimStart().StartsWith('^')) return "^";
        if (attr.Name.Contains('`', StringComparison.Ordinal) || attr.AttributeFlags.Contains("SAFE", StringComparer.OrdinalIgnoreCase))
            return "ƒ";
        return attr.Value.Length > 0 && (char.IsDigit(attr.Value[0]) || attr.Value == "0" || attr.Value.StartsWith("#-"))
            ? "•"
            : "¶";
    }

    private static string AttrKindColor(MushAttribute attr) => AttrKindBadge(attr) switch
    {
        "$" => "var(--accent)",
        "ƒ" => "#5aa9ff",
        "^" => "#b39cff",
        "•" => "#d9a23a",
        _   => "var(--text-faint)",
    };

    private static string AttrKindLabelKey(MushAttribute attr) => AttrKindBadge(attr) switch
    {
        "$" => "TermAttrKindCommand",
        "ƒ" => "TermAttrKindFunction",
        "^" => "TermAttrKindListen",
        "•" => "TermAttrKindData",
        _   => "TermAttrKindText",
    };

    private static string AttrKindGlow(MushAttribute attr) => AttrKindBadge(attr) switch
    {
        "$" => "var(--glow)",
        "ƒ" => "90,169,255",
        "^" => "179,156,255",
        "•" => "217,162,58",
        _   => "95,104,112",
    };

    private static string KindBadgeStyle(MushAttribute attr)
        => $"background:rgba({AttrKindGlow(attr)},0.14);border:1px solid rgba({AttrKindGlow(attr)},0.3);color:{AttrKindColor(attr)};";

    /// <summary>One-line preview of an attribute's value, or <c>null</c> when it has none — the
    /// caller renders the localized empty marker, which a static helper cannot reach.</summary>
    private static string? AttrPreview(MushAttribute attr)
    {
        var v = (attr.Value ?? string.Empty).Replace('\n', ' ').Replace('\r', ' ').Trim();
        if (v.Length == 0) return null;
        return v.Length > 60 ? v[..60] + "…" : v;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JsRuntime.InvokeVoidAsync("SharpMUSH.Monaco.initEditor", "mush-editor");

        if (_focusNewAttr)
        {
            _focusNewAttr = false;
            try { await _newAttrInput.FocusAsync(); }
            catch { /* element may have been dismissed before focus */ }
        }
    }

    private StandaloneEditorConstructionOptions BuildEditorOptions(StandaloneCodeEditor editor) => new()
    {
        Language = "plaintext",
        Theme = "vs-dark",
        AutomaticLayout = true,
        Value = ActiveTab?.WorkingContent ?? string.Empty,
        FontFamily = "var(--font-mono)",
        FontSize = 13,
        LineNumbers = "on",
        WordWrap = "on",
        Minimap = new EditorMinimapOptions { Enabled = false },
        ScrollBeyondLastLine = false,
        SuggestOnTriggerCharacters = true,
        FixedOverflowWidgets = true,
    };

    private async Task OnEditorInitAsync()
        => await JsRuntime.InvokeVoidAsync("SharpMUSH.Monaco.initEditor", "mush-editor");

    private async Task SetEditorValueAsync(string value)
    {
        if (_monacoEditor is null) return;
        await _monacoEditor.SetValue(value);
    }

    /// <summary>
    /// Dirty means "the buffer differs from what the database holds" — compared, not tracked.
    /// </summary>
    /// <remarks>
    /// Monaco raises OnDidChangeModelContent for SetValue as well as for typing, so loading an
    /// attribute, switching tabs or refreshing used to mark the tab unsaved with no user input,
    /// which in turn made RefreshAttributesAsync skip those tabs forever (it only refreshes clean
    /// ones). A "this write was mine" flag fixes that but is fragile in both directions: it stays
    /// armed if SetValue throws, and again if Monaco raises no event because the text was already
    /// identical — and an armed flag swallows the user's next real edit while the tab reads clean,
    /// so the next refresh silently overwrites their work. Comparing sidesteps the whole question:
    /// it needs no assumption about when the event fires, and it also clears the flag when an edit
    /// is undone back to the stored text.
    /// </remarks>
    private async Task OnEditorChanged(ModelContentChangedEvent e)
    {
        if (_monacoEditor is null || ActiveTab is null) return;

        var current = await _monacoEditor.GetValue();
        ActiveTab.WorkingContent = current;

        var dirty = !string.Equals(current, ActiveTab.SavedContent, StringComparison.Ordinal);
        if (dirty == ActiveTab.IsDirty) return;

        ActiveTab.IsDirty = dirty;
        StateHasChanged();
    }

    private async Task OnAttributeSelected(MushAttribute? attr)
    {
        if (attr is null || _selectedObject is null) return;
        _saveMessage = null;

        if (_monacoEditor is not null && ActiveTab is not null)
            ActiveTab.WorkingContent = await _monacoEditor.GetValue();

        var existing = _openTabs.FindIndex(t => t.Obj.Dbref == _selectedObject.Dbref
            && string.Equals(t.Attr.Name, attr.Name, StringComparison.OrdinalIgnoreCase));
        if (existing >= 0)
        {
            _activeTabIndex = existing;
        }
        else
        {
            _openTabs.Add(new AttrTab(_selectedObject, attr));
            _activeTabIndex = _openTabs.Count - 1;
        }

        await SetEditorValueAsync(ActiveTab!.WorkingContent);

        // Mobile drill-down: picking an attribute advances to the editor.
        _mobilePane = MobilePane.Editor;

        StateHasChanged();
    }

    private async Task SwitchTabAsync(int idx)
    {
        if (idx == _activeTabIndex) return;
        if (_monacoEditor is not null && ActiveTab is not null)
            ActiveTab.WorkingContent = await _monacoEditor.GetValue();
        _activeTabIndex = idx;
        if (ActiveTab is not null)
            await SetEditorValueAsync(ActiveTab.WorkingContent);
        StateHasChanged();
    }

    private async Task CloseTabAsync(int idx)
    {
        if (idx == _activeTabIndex && _monacoEditor is not null && ActiveTab is not null)
            ActiveTab.WorkingContent = await _monacoEditor.GetValue();
        _openTabs.RemoveAt(idx);
        if (_openTabs.Count == 0)
        {
            _activeTabIndex = -1;
            if (_monacoEditor is not null)
                await SetEditorValueAsync(string.Empty);
        }
        else
        {
            _activeTabIndex = Math.Clamp(_activeTabIndex, 0, _openTabs.Count - 1);
            if (_monacoEditor is not null)
                await SetEditorValueAsync(ActiveTab!.WorkingContent);
        }
        StateHasChanged();
    }

    // advanceMobilePane: only true for a direct object pick. Internal refreshes
    // (Save, Refresh attributes) reuse this method and must NOT yank the mobile user
    // out of the editor back to the attributes pane.
    /// <summary>
    /// Monotonic ticket for object loads. Clicking a second object before the first responds must
    /// not let the older, slower answer land on top of the newer selection.
    /// </summary>
    private int _objectLoadGeneration;

    private async Task OnObjectSelected(int dbref, bool advanceMobilePane = true)
    {
        var generation = ++_objectLoadGeneration;

        _loadingAttrs = true;
        _saveMessage = null;
        _showCreateAttr = false;
        StateHasChanged();

        try
        {
            var result = await ObjectApi.GetObjectAsync(dbref);

            // Someone selected something else while this was in flight; that request owns the
            // state now, including the loading flag it set on its own way in.
            if (generation != _objectLoadGeneration) return;

            result.Switch(
                obj =>
                {
                    _selectedObject = obj;
                    // Mobile drill-down: picking an object advances to its attributes.
                    if (advanceMobilePane)
                        _mobilePane = MobilePane.Attrs;
                },
                failure =>
                {
                    // The selection is deliberately left alone. This runs on the reload after a
                    // successful save too, and blanking the panes because a re-read failed would
                    // throw away work the user can still see and re-save.
                    _saveMessage = Loc["TermErrorLoadingObject", failure.Message];
                    _saveSeverity = Severity.Error;
                });
        }
        finally
        {
            // Only the newest request owns the flag; an older one clearing it would unstick the
            // spinner while the current load is still running.
            if (generation == _objectLoadGeneration)
            {
                _loadingAttrs = false;
                StateHasChanged();
            }
        }
    }

    /// <summary>
    /// Re-reads the selected object and re-syncs its open tabs.
    /// </summary>
    /// <returns>
    /// Whether the reload actually landed. A caller that is about to report its own success needs
    /// to know: overwriting a "could not re-read the object" message with "saved" hides the fact
    /// that what is on screen is now stale.
    /// </returns>
    private async Task<bool> RefreshAttributesAsync()
    {
        if (_selectedObject is null) return false;

        // Captured before the await: the user may select a different object while the reload runs,
        // and this refresh must only ever touch tabs belonging to the object it started on.
        var dbref = _selectedObject.Dbref;

        await OnObjectSelected(dbref, advanceMobilePane: false);

        if (_selectedObject is not null && _selectedObject.Dbref == dbref)
        {
            foreach (var tab in _openTabs.Where(t => t.Obj.Dbref == dbref))
            {
                var refreshed = _selectedObject.Attributes.FirstOrDefault(a =>
                    string.Equals(a.Name, tab.Attr.Name, StringComparison.OrdinalIgnoreCase));
                if (refreshed is null) continue;

                // The freshly-read value is authoritative for what the database holds, whether or
                // not the tab has unsaved edits sitting on top of it.
                tab.SavedContent = refreshed.Value;
                if (!tab.IsDirty)
                    tab.WorkingContent = refreshed.Value;

                // Derived, never carried over: a tab whose buffer now matches what was just read is
                // clean by definition, even if it was dirty a moment ago (someone else saving the
                // same text, or our own save round-tripping).
                tab.IsDirty = !string.Equals(tab.WorkingContent, tab.SavedContent, StringComparison.Ordinal);
            }
        }
        if (ActiveTab is not null)
            await SetEditorValueAsync(ActiveTab.WorkingContent);

        return _selectedObject is not null && _selectedObject.Dbref == dbref;
    }

    private async Task SaveAsync()
    {
        if (ActiveTab is null || _monacoEditor is null) return;

        // The tab itself is captured, not just its name and dbref: the user can switch tabs while
        // the PUT is in flight, and the result belongs to the tab that initiated it. Writing back
        // through ActiveTab marked whichever tab happened to be active as clean, handing it another
        // tab's saved baseline — so it read as saved when it was not, and the next refresh
        // overwrote it.
        var tab = ActiveTab;
        var value = await _monacoEditor.GetValue();

        // GetValue is interop and yields. A tab switch during it loads the other tab's text into
        // Monaco, so `value` may be that tab's content — writing it to `tab` would PUT one
        // attribute's text over another's.
        if (!ReferenceEquals(ActiveTab, tab)) return;

        tab.WorkingContent = value;

        // Sent verbatim — newlines included. The API carries the value in a JSON body, so there is
        // nothing to escape and nothing for the server to decode.
        var result = await ObjectApi.SetAttributeAsync(tab.Obj.Dbref, tab.Attr.Name, value);
        if (result.TryPickT1(out var failure, out _))
        {
            _saveMessage = failure.Message;
            _saveSeverity = Severity.Error;
            StateHasChanged();
            return;
        }

        // The buffer is now what the database holds, so that tab is clean by definition.
        tab.SavedContent = value;
        tab.IsDirty = false;

        // Only claim success once the re-read confirms it. If the reload failed it has already put
        // its own error on screen, and overwriting that with "saved" would leave the user looking
        // at stale panes believing everything is current.
        if (await RefreshAttributesAsync())
        {
            _saveMessage = Loc["TermSavedAttribute", tab.Attr.Name, tab.Obj.Dbref];
            _saveSeverity = Severity.Success;
        }

        StateHasChanged();
    }

    private async Task DeleteAsync()
    {
        if (ActiveTab is null) return;

        // Captured for the same reason as SaveAsync: on return we must close the tab we deleted
        // from, not whichever one the user switched to meanwhile.
        var tab = ActiveTab;

        var result = await ObjectApi.DeleteAttributeAsync(tab.Obj.Dbref, tab.Attr.Name);
        if (result.TryPickT1(out var failure, out _))
        {
            _saveMessage = failure.Message;
            _saveSeverity = Severity.Error;
            StateHasChanged();
            return;
        }

        var tabIdx = _openTabs.IndexOf(tab);
        if (tabIdx >= 0) await CloseTabAsync(tabIdx);

        // After the refresh, not before: RefreshAttributesAsync goes through OnObjectSelected,
        // which clears _saveMessage on its way in, so a confirmation set earlier never renders.
        if (await RefreshAttributesAsync())
        {
            _saveMessage = Loc["TermDeletedAttribute", tab.Attr.Name];
            _saveSeverity = Severity.Info;
        }

        StateHasChanged();
    }

    private async Task EvalAsync()
    {
        if (_monacoEditor is null || ActiveTab is null) return;
        _evalLoading = true;
        _evalOutput = null;
        StateHasChanged();
        try
        {
            var lines = await QueryService.EvalAsync($"#{ActiveTab.Obj.Dbref}", ActiveTab.Attr.Name);
            _evalOutput = lines.Length > 0
                ? string.Join("\n", lines.Where(l => !string.IsNullOrEmpty(l)))
                : Loc["TermNoOutput"];
        }
        catch (Exception ex)
        {
            _evalOutput = Loc["TermErrorLine", ex.Message];
        }
        finally
        {
            _evalLoading = false;
            StateHasChanged();
        }
    }

    private void ShowCreateObjectDialog(MushObjectType type)
    {
        _createObjectType = type;
        _createObjectName = string.Empty;
    }

    private void CancelCreateObject() => _createObjectType = null;

    private async Task ExecuteCreateObjectAsync()
    {
        if (_createObjectType is null || string.IsNullOrWhiteSpace(_createObjectName)) return;
        var type = _createObjectType.Value;
        var name = _createObjectName.Trim();
        _createObjectType = null;
        _createObjectName = string.Empty;
        var result = await ObjectApi.CreateObjectAsync(name, type);
        if (result.TryPickT1(out var failure, out var newDbref))
        {
            _saveMessage = failure.Message;
            _saveSeverity = Severity.Error;
            StateHasChanged();
            return;
        }

        if (_objectBrowser is not null)
        {
            await _objectBrowser.RefreshAsync();
            await _objectBrowser.SelectDbrefAsync(newDbref);
        }
    }

    private async Task OnCreateObjectKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ExecuteCreateObjectAsync();
        else if (e.Key == "Escape") CancelCreateObject();
    }

    private void ShowCreateAttr() { _showCreateAttr = true; _newAttrName = string.Empty; _focusNewAttr = true; }
    private void CancelCreateAttr() => _showCreateAttr = false;

    private async Task ExecuteCreateAttrAsync()
    {
        if (_selectedObject is null || string.IsNullOrWhiteSpace(_newAttrName)) return;
        var attrName = _newAttrName.Trim().ToUpperInvariant();
        _showCreateAttr = false;
        _newAttrName = string.Empty;
        // 'null()' rather than an empty value: with empty_attrs off the engine treats an empty set
        // as a clear, so a genuinely empty attribute could not be created to open a tab on.
        // Captured before the await: a refresh must target the object the attribute was created
        // on, not whichever one is selected by the time the request comes back.
        var targetDbref = _selectedObject.Dbref;

        var result = await ObjectApi.SetAttributeAsync(targetDbref, attrName, "null()");
        if (result.TryPickT1(out var failure, out _))
        {
            _saveMessage = failure.Message;
            _saveSeverity = Severity.Error;
            StateHasChanged();
            return;
        }

        // Read into a local after each await and work from that. Comparing the dbref rather than
        // the instance is deliberate — a refresh legitimately replaces _selectedObject with a fresh
        // read of the same object — and the local keeps the null check honestly nullable instead of
        // a condition the compiler can fold away.
        var selectedAfterCreate = _selectedObject;
        if (selectedAfterCreate is null || selectedAfterCreate.Dbref != targetDbref) return;

        await RefreshAttributesAsync();

        var selectedAfterRefresh = _selectedObject;
        if (selectedAfterRefresh is null || selectedAfterRefresh.Dbref != targetDbref) return;

        var created = selectedAfterRefresh.Attributes.FirstOrDefault(a =>
            string.Equals(a.Name, attrName, StringComparison.OrdinalIgnoreCase));
        if (created is not null)
            await OnAttributeSelected(created);
    }

    private async Task OnCreateAttrKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ExecuteCreateAttrAsync();
        else if (e.Key == "Escape") CancelCreateAttr();
    }

    public ValueTask DisposeAsync() => ValueTask.CompletedTask;
}
