@page "/help"
@layout HelpLayout
@using SharpMUSH.Client.Components.Help
@inject GameHelpService HelpFiles
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> Loc
@implements IDisposable

@* The index of the help files the server ships — the same corpus `help` answers from at a telnet
   prompt. It is not a wiki page: nothing here is editable from the portal, and a fresh game shows
   the full index rather than an invitation to write one. In the D1 kit: the plain header, the index
   entry in a card, the topic list in a card with its filter (which /help?q= sets, from the sidebar's
   search), and the admin corpus in its own card for Wizard and God. *@

<PageTitle>@Loc["Help"] — @Loc["AppTitle"]</PageTitle>

<div class="help-page">
    <PlainPageHeader Kicker="@Loc["AdmHelpKicker"]" Title="@Loc["Help"]" Description="@Loc["AdmHelpSubtitle"]" />

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }
    else if (_index is null)
    {
        <MudAlert Severity="Severity.Error" Dense="true">@Loc["HelpLoadFailed"] @_error</MudAlert>
    }
    else
    {
        <KitCard>
            <article class="help-entry">@((MarkupString)(_index.Html ?? string.Empty))</article>
        </KitCard>

        <KitCard Title="@string.Format(Loc["HelpAllTopics"], _index.Topics.Count)">
            <Controls>
                <input class="help-filter" type="search" placeholder="@Loc["HelpFilterTopics"]" aria-label="@Loc["HelpFilterTopics"]"
                       value="@_filter" @oninput="@(e => _filter = e.Value?.ToString() ?? string.Empty)" />
            </Controls>
            <ChildContent>
                <div class="help-topics">
                    @if (Filtered.Count == 0)
                    {
                        <p class="help-empty">@Loc["HelpNoTopicsMatch"]</p>
                    }
                    else
                    {
                        <ul class="help-topic-list">
                            @foreach (var topic in Filtered)
                            {
                                <li><a href="/help/@Uri.EscapeDataString(topic)">@topic</a></li>
                            }
                        </ul>
                    }
                </div>
            </ChildContent>
        </KitCard>

        <AuthorizeView Roles="Wizard,God">
            <Authorized>
                @if (_adminError is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="help-admin">@Loc["HelpLoadFailed"] @_adminError</MudAlert>
                }
                else if (_adminIndex is not null)
                {
                    <KitCard Class="help-admin" Title="@Loc["HelpAdminTitle"]" Sub="@Loc["HelpAdminSubtitle"]">
                        <div class="help-topics">
                            <ul class="help-topic-list">
                                @foreach (var topic in _adminIndex.Topics)
                                {
                                    <li><a href="/help/admin/@Uri.EscapeDataString(topic)">@topic</a></li>
                                }
                            </ul>
                        </div>
                    </KitCard>
                }
            </Authorized>
        </AuthorizeView>
    }
</div>

@code {
    private GameHelpIndex? _index;
    private GameHelpIndex? _adminIndex;
    private string? _error;
    private string? _adminError;
    private bool _loading = true;
    private string _filter = string.Empty;

    // 1500+ topics is far too many to scroll, and far too few to need paging: filter in the browser.
    private IReadOnlyList<string> Filtered =>
        _index is null
            ? []
            : string.IsNullOrWhiteSpace(_filter)
                ? _index.Topics
                : _index.Topics.Where(t => t.Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        _filter = HelpQuery.From(Nav.Uri);

        var result = await HelpFiles.GetIndexAsync();
        (_index, _error) = result switch
        {
            GameHelpIndex index => (index, null),
            ApiFailure failure => ((GameHelpIndex?)null, failure.Message)
        };

        // Only staff ask for the admin corpus. The gate that matters is the server's 403 on
        // /api/help/admin — this check just keeps every anonymous page view from spending a
        // rejected request to learn what it already knows.
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            if (user.IsInRole("Wizard") || user.IsInRole("God"))
            {
                var admin = await HelpFiles.GetAdminIndexAsync();
                (_adminIndex, _adminError) = admin switch
                {
                    GameHelpIndex index => (index, null),
                    ApiFailure failure => ((GameHelpIndex?)null, failure.Message)
                };
            }
        }

        _loading = false;
    }

    /// <summary>The sidebar's search changes only the query, so the page stays mounted and takes the new term.</summary>
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _filter = HelpQuery.From(e.Location);
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
