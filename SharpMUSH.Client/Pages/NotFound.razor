@page "/not-found"
@layout MainLayout
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["NotFound"] — <GameName /></PageTitle>

@* The same centred panel as App.razor's Not Authorized: it had no page padding (flush to the screen edge
   on a phone), no h1 for FocusOnNavigate, and no way back. *@
<div class="not-authorized">
    <div class="not-authorized-card">
        <div class="not-authorized-icon">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Style="font-size:var(--text-2xl);" />
        </div>
        <h1>@Loc["NotFound"]</h1>
        <p>@Loc["NotFoundDescription"]</p>
        <a class="not-authorized-home" href="/">
            <MudIcon Icon="@Icons.Material.Filled.Home" Style="font-size:var(--text-base);" /> @Loc["NotAuthorizedBackHome"]
        </a>
    </div>
</div>
