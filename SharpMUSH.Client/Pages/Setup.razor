@page "/setup"
@layout OnboardingLayout
@using SharpMUSH.Client.Layout
@using SharpMUSH.Client.Services
@using SharpMUSH.Library.DiscriminatedUnions
@using SharpMUSH.Library.Authorization
@inject AccountAuthService AccountAuth
@inject SetupWizardService Wizard
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> Loc
@inject IJSRuntime JS
@inject ServerInfoService ServerInfo
@implements IDisposable

<PageTitle>@Loc["AuthFirstRunSetup"] — <GameName /></PageTitle>

@* The first-run wizard: claim the administrator account, then — as that administrator — bring in a
   PennMUSH database with its mush.cnf or start fresh, set the HTTP and event handlers the bundled packages
   build on, and choose the packages. Everything after the claim is pending on the server until the last
   step, so an administrator who closes the tab comes back here to the step they left (the database import
   page links back with ?step=identity). *@
<div class="setup-page">
    <div class="setup-brand">
        <img src="assets/Logo.svg" alt="@Loc["AppTitle"]" class="setup-logo" />
        <h1 class="setup-brand-title">@Loc["AuthSetupWelcome", Loc["AppTitle"]]</h1>
    </div>

    @switch (_step)
    {
        case Step.Resolving:
            @* Nothing about the game's claim state is knowable until api/setup/status answers, so the
               claim form is not rendered yet. On a cold load that check took ~12 seconds, during which
               an already-claimed game told every visitor it was unclaimed and invited them to become
               its administrator (the POST was safely rejected with a 409, but the copy was a lie).
               It is also what shows while a claimed game's redirect is on its way out. *@
            <div class="setup-card setup-card--resolving">
                <div class="setup-kicker">@Loc["AuthFirstRunSetup"]</div>
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                <p class="setup-lead">@Loc["Loading"]</p>
            </div>
            break;

        case Step.SignIn:
            <div class="setup-card">
                <div class="setup-kicker">@Loc["AuthFirstRunSetup"]</div>
                <h2 class="setup-title">@Loc["AuthSetupComplete"]</h2>
                <!-- Claim succeeded but post-claim auto-login enrichment degraded server-side
                     (see SetupController.Complete's try/catch) — no session was minted, so send
                     the claimer to a normal sign-in, which brings them back here to finish. -->
                <p class="setup-lead">
                    @Loc["AuthSetupAdminLinked", _completedUsername]
                    @Loc["AuthSetupSignInToManage"]
                </p>
                <a class="setup-submit setup-signin" href="/login?returnUrl=%2Fsetup">@Loc["AuthSignIn"]</a>
            </div>
            break;

        case Step.Import:
            <div class="setup-card">
                <div class="setup-kicker">@Loc["AdmSetupStepOf", 2, 5]</div>
                @if (_completedUsername.Length > 0)
                {
                    <p class="setup-claimed" role="status">
                        @Loc["AuthSetupAdminLinked", _completedUsername]
                        @Loc["AuthSetupSignedInAs", _completedUsername]
                    </p>
                }
                <h2 class="setup-title">@Loc["AdmSetupImportTitle"]</h2>
                <p class="setup-lead">@Loc["AdmSetupImportLead"]</p>

                <a class="setup-submit setup-import" href="/admin/import?setup=1">@Loc["AdmSetupImportPenn"]</a>
                <button class="setup-secondary setup-fresh" type="button" @onclick="StartFresh">@Loc["AdmSetupStartFresh"]</button>
            </div>
            break;

        case Step.Identity:
            <div class="setup-card">
                <div class="setup-kicker">@Loc["AdmSetupStepOf", 3, 5]</div>
                <h2 class="setup-title">@Loc["GuideSetupIdentity"]</h2>
                <p class="setup-lead">@Loc["GuideSetupIdentityLead"]</p>
                <SharpMUSH.Client.Components.Onboarding.GameIdentityForm SaveLabel="@Loc["GuideSetupIdentitySave"].Value" OnSaved="ContinueFromIdentity" />
                <button class="setup-secondary setup-defer-identity" type="button" @onclick="ContinueFromIdentity">@Loc["GuideSetupIdentityLater"]</button>
            </div>
            break;

        case Step.Handlers:
            <div class="setup-card">
                <div class="setup-kicker">@Loc["AdmSetupStepOf", 4, 5]</div>
                <h2 class="setup-title">@Loc["AdmSetupHandlersTitle"]</h2>
                <p class="setup-lead">@Loc["AdmSetupHandlersLead"]</p>

                @if (_error is not null)
                {
                    <div class="setup-error" role="alert">@_error</div>
                }

                <ul class="setup-handler-summary">
                    @foreach (var handler in _handlers)
                    {
                        <li @key="handler.Kind"><strong>@HandlerTitle(handler.Kind)</strong> @HandlerNow(handler)</li>
                    }
                </ul>

                @* The shipped handlers suit a new game; changing them is for a game that brings its own objects. *@
                <details class="setup-advanced" open="@HandlersNeedAttention">
                <summary class="setup-advanced-summary">@Loc["AdmSetupHandlersAdvanced"]</summary>
                <p class="setup-lead">@Loc["AdmSetupHandlersAdvancedLead"]</p>
                @foreach (var handler in _handlers)
                {
                    var kind = handler.Kind;
                    var choice = _handlerChoices[kind];
                    <section class="setup-handler" id="setup-handler-@kind" @key="kind">
                        <h3 class="setup-handler-title">@HandlerTitle(kind)</h3>
                        <p class="setup-handler-desc">@HandlerDescription(kind)</p>
                        <p class="setup-handler-now">
                            @HandlerNow(handler)
                            @if (handler is { Name: not null, Packages.Count: > 0 })
                            {
                                @* One text node: Blazor drops the whitespace-only one a leading space would be. *@
                                <span>@($" {Loc["AdmSetupHandlerCarries", string.Join(", ", handler.Packages.Select(PackageTitle))]}")</span>
                            }
                        </p>

                        <div class="setup-handler-choices" role="radiogroup" aria-label="@HandlerTitle(kind)">
                            @if (handler.Name is not null)
                            {
                                <label class="setup-choice">
                                    <input type="radio" name="handler-@kind" value="keep" checked="@(choice.Mode == Keep)"
                                           disabled="@_busy" @onchange="() => Choose(kind, Keep)" />
                                    <span>@Loc["AdmSetupHandlerKeep"]</span>
                                </label>
                            }
                            <label class="setup-choice">
                                <input type="radio" name="handler-@kind" value="use" checked="@(choice.Mode == HandlerModes.Use)"
                                       disabled="@_busy" @onchange="() => Choose(kind, HandlerModes.Use)" />
                                <span>@Loc["AdmSetupHandlerUse"]</span>
                                <input class="setup-dbref" id="setup-handler-@kind-dbref" type="text" inputmode="numeric"
                                       placeholder="#" value="@choice.Dbref" disabled="@(_busy || choice.Mode != HandlerModes.Use)"
                                       aria-label="@Loc["AdmSetupHandlerUse"]"
                                       @onchange="e => SetDbref(kind, e.Value as string)" />
                            </label>
                            <label class="setup-choice">
                                <input type="radio" name="handler-@kind" value="create" checked="@(choice.Mode == HandlerModes.Create)"
                                       disabled="@_busy" @onchange="() => Choose(kind, HandlerModes.Create)" />
                                <span>@Loc["AdmSetupHandlerCreate"]</span>
                            </label>
                            <label class="setup-choice">
                                <input type="radio" name="handler-@kind" value="none" checked="@(choice.Mode == HandlerModes.None)"
                                       disabled="@_busy" @onchange="() => Choose(kind, HandlerModes.None)" />
                                <span>@Loc["AdmSetupHandlerNone"]</span>
                            </label>
                        </div>

                        @if (choice.Mode == Keep && !handler.IsWizard)
                        {
                            <p class="setup-handler-warn" role="note">@Loc["AdmSetupHandlerNotWizard"]</p>
                        }

                        @* Building onto an object that already has some of the packages' attributes keeps the
                           object's own, so those parts of the packages run the game's code instead. Said before
                           anything is changed, and only gone past with an explicit choice. *@
                        @if (choice.Mode is Keep or HandlerModes.Use && choice.Clashes is { Count: > 0 } clashes)
                        {
                            <div class="setup-handler-clashes" role="alert">
                                <p>@Loc["AdmSetupHandlerClashes", clashes.Count]</p>
                                <ul>
                                    @foreach (var clash in clashes.Take(ClashesShown))
                                    {
                                        <li><code>@clash.Attribute</code> — @PackageTitle(clash.Package)</li>
                                    }
                                    @if (clashes.Count > ClashesShown)
                                    {
                                        <li>@Loc["AdmSetupHandlerClashesMore", clashes.Count - ClashesShown]</li>
                                    }
                                </ul>
                                <label class="setup-choice">
                                    <input id="setup-handler-@kind-accept" type="checkbox" checked="@choice.Accepted"
                                           disabled="@_busy" @onchange="e => Accept(kind, e.Value is true)" />
                                    <span>@Loc["AdmSetupHandlerClashAccept"]</span>
                                </label>
                            </div>
                        }
                    </section>
                }
                </details>

                <button class="setup-submit setup-save-handlers" type="button" disabled="@_busy" @onclick="SaveHandlersAsync">
                    @(_busy ? Loc["AdmSetupSaving"] : Loc["AdmSetupContinueStep"])
                </button>
                <button class="setup-secondary" type="button" disabled="@_busy" @onclick="() => _step = Step.Import">@Loc["AdmSetupBack"]</button>
            </div>
            break;

        case Step.Packages:
            <div class="setup-card">
                <div class="setup-kicker">@Loc["AdmSetupStepOf", 5, 5]</div>
                <h2 class="setup-title">@Loc["AdmSetupPackagesTitle"]</h2>
                <p class="setup-lead">@Loc["AdmSetupPackagesLead"]</p>

                @if (_error is not null)
                {
                    <div class="setup-error" role="alert">@_error</div>
                }

                <div class="setup-pkg-tools">
                    <input id="setup-pkg-search" class="setup-pkg-search" type="search" value="@_search"
                           placeholder="@Loc["AdmSetupPkgSearch"]" aria-label="@Loc["AdmSetupPkgSearch"]"
                           @oninput="@(e => _search = e.Value as string ?? string.Empty)" />
                    @if (string.IsNullOrWhiteSpace(_search))
                    {
                        <button class="setup-secondary setup-pkg-all" type="button" aria-pressed="@(_showAll ? "true" : "false")"
                                @onclick="() => _showAll = !_showAll">
                            @(_showAll ? Loc["AdmSetupPkgShowRecommended"] : Loc["AdmSetupPkgShowAll", _packages.Count])
                        </button>
                    }
                </div>
                <p class="setup-pkg-summary" role="status">@Loc["AdmSetupPkgSummary", Effective.Count, _packages.Count]</p>

                @if (!PackageGroups.Any())
                {
                    <p class="setup-pkg-none">@Loc["AdmSetupPkgNoMatch", _search.Trim()]</p>
                }

                @foreach (var group in PackageGroups)
                {
                    <h3 class="setup-group-title">
                        @group.Title
                        <span class="setup-group-count">@Loc["AdmSetupPkgGroupCount", group.Packages.Count(p => Effective.Contains(p.Package.Id)), group.Packages.Count]</span>
                    </h3>
                    <ul class="setup-apps">
                        @foreach (var (package, addOn) in group.Packages)
                        {
                            var id = package.Id;
                            var needed = NeededBy(id);
                            var on = Effective.Contains(id);
                            <li class="setup-app @(addOn ? "setup-app--addon" : null) @(package.Available ? null : "setup-app--unavailable")" @key="id">
                                <label class="setup-app-label">
                                    <input id="setup-pkg-@id" class="setup-app-check" type="checkbox"
                                           checked="@on" disabled="@(_busy || needed is not null || (!package.Available && !on) || (package.Bridge && !Joined(package)))"
                                           @onchange="@(e => Choose(id, e.Value is true))" />
                                    <span class="setup-app-text">
                                        <span class="setup-app-title">@PackageTitle(package)</span>
                                        <span class="setup-app-desc">@PackageDescription(package)</span>
                                        @if (needed is not null)
                                        {
                                            <span class="setup-app-note">@Loc["AdmSetupPkgNeededBy", PackageTitle(needed)]</span>
                                        }
                                        else if (!package.Available)
                                        {
                                            <span class="setup-app-note">@Unavailable(package)</span>
                                        }
                                    </span>
                                </label>
                            </li>
                        }
                    </ul>
                }

                <h3 class="setup-group-title">@Loc["AdmSetupWorldGroup"]</h3>
                <ul class="setup-apps">
                    <li class="setup-app">
                        <label class="setup-app-label">
                            <input id="setup-starter-world" class="setup-app-check" type="checkbox"
                                   checked="@(_starterWorld || _starterWorldApplied)" disabled="@(_busy || _starterWorldApplied)"
                                   @onchange="@(e => _starterWorld = e.Value is true)" />
                            <span class="setup-app-text">
                                <span class="setup-app-title">@Loc["AdmSetupStarterWorldTitle"]</span>
                                <span class="setup-app-desc">@Loc["AdmSetupStarterWorldDesc"]</span>
                                @if (_starterWorldApplied)
                                {
                                    <span class="setup-app-note">@Loc["AdmSetupStarterWorldApplied"]</span>
                                }
                            </span>
                        </label>
                    </li>
                </ul>

                <h3 class="setup-group-title">@Loc["AdmSetupWikiGroup"]</h3>
                <ul class="setup-apps">
                    <li class="setup-app">
                        <label class="setup-app-label">
                            <input id="setup-starter-wiki" class="setup-app-check" type="checkbox"
                                   checked="@(_starterWiki || _starterWikiApplied)" disabled="@(_busy || _starterWikiApplied)"
                                   @onchange="@(e => _starterWiki = e.Value is true)" />
                            <span class="setup-app-text">
                                <span class="setup-app-title">@Loc["AdmSetupStarterWikiTitle"]</span>
                                <span class="setup-app-desc">@Loc["AdmSetupStarterWikiDesc"]</span>
                                @if (_starterWikiApplied)
                                {
                                    <span class="setup-app-note">@Loc["AdmSetupStarterWikiApplied"]</span>
                                }
                            </span>
                        </label>
                    </li>
                </ul>

                <button class="setup-submit setup-save" type="button" disabled="@_busy" @onclick="SavePackagesAsync">
                    @(_busy ? Loc["AdmSetupSaving"] : Loc["AdmSetupSaveContinue"])
                </button>
                <button class="setup-secondary" type="button" disabled="@_busy" @onclick="() => _step = Step.Handlers">@Loc["AdmSetupBack"]</button>
            </div>
            break;

        case Step.Done:
            <div class="setup-card">
                <div class="setup-kicker">@Loc["AuthFirstRunSetup"]</div>
                <h2 class="setup-title">@Loc["AuthSetupComplete"]</h2>
                <p class="setup-lead">@Loc["AdmSetupDoneLead"]</p>
                <p class="setup-lead">@Loc["AdmSetupDoneStaff"]</p>
                @* The checklist is the next thing to do, so it is the filled button; the portal is the way out. *@
                <a class="setup-submit setup-signin setup-checklist" href="/admin/onboarding">@Loc["AdmSetupDoneChecklist"]</a>
                <button class="setup-secondary setup-enter" type="button" @onclick="EnterPortal">@Loc["AuthEnterPortal"]</button>
            </div>
            break;

        case Step.Claim:
            <div class="setup-card">
                <div class="setup-kicker">@Loc["AdmSetupStepOf", 1, 5]</div>
                <h2 class="setup-title">@Loc["AuthClaimAdminTitle"]</h2>
                <p class="setup-lead">@Loc["AuthClaimAdminLead"]</p>

                @if (_error is not null)
                {
                    <div class="setup-error" role="alert">@_error</div>
                }

                @* Same field treatment as /login, which is one click away inside the same
                   OnboardingLayout: outlined + dense MudTextField, floating label, leading adornment
                   icon, real password inputs. *@
                <MudTextField id="setup-username" @bind-Value="_username" Label="@Loc["AuthUsername"]"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Person"
                              Disabled="_busy" autocomplete="username" Immediate="true" OnKeyDown="OnClaimKeyDown" />

                <MudTextField id="setup-password" @bind-Value="_password" Label="@Loc["AuthPassword"]"
                              InputType="InputType.Password"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Lock"
                              Disabled="_busy" autocomplete="new-password" Immediate="true" OnKeyDown="OnClaimKeyDown" />

                <MudTextField id="setup-confirm" @bind-Value="_confirm" Label="@Loc["AuthConfirmPassword"]"
                              InputType="InputType.Password"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Lock"
                              Disabled="_busy" autocomplete="new-password" Immediate="true" OnKeyDown="OnClaimKeyDown" />

                <button class="setup-submit" type="button" disabled="@_busy" @onclick="SubmitAsync">
                    @(_busy ? Loc["AuthSettingUp"] : Loc["AuthCreateAdminAccount"])
                </button>
            </div>
            break;
    }
</div>

@code {
    private enum Step { Resolving, Claim, SignIn, Import, Identity, Handlers, Packages, Done }

    /// <summary>The handler choice that changes nothing.</summary>
    private const string Keep = "keep";

    /// <summary>
    /// A handler's choice on the handlers step: a <see cref="HandlerModes"/> value or <see cref="Keep"/>, the object
    /// typed for <see cref="HandlerModes.Use"/>, and — once checked — the attributes building on that object would
    /// keep in place of the packages' own (<paramref name="CheckedFor"/> is the object they were checked for), and
    /// whether the administrator chose to go ahead regardless.
    /// </summary>
    private sealed record HandlerChoice(string Mode, string? Dbref, IReadOnlyList<HandlerClash>? Clashes = null,
        int? CheckedFor = null, bool Accepted = false);

    /// <summary>How many clashing attributes are listed before the rest are counted.</summary>
    private const int ClashesShown = 8;

    /// <summary>
    /// <c>?step=handlers</c> (or <c>packages</c>): where the database import sends the administrator back to.
    /// </summary>
    [SupplyParameterFromQuery(Name = "step")] public string? StepParameter { get; set; }

    private Step _step = Step.Resolving;
    private Step _shownStep = Step.Resolving;

    private string _username = string.Empty;
    private string _password = string.Empty;
    private string _confirm = string.Empty;
    private string? _error;
    private bool _busy;
    private string _completedUsername = string.Empty;

    private IReadOnlyList<HandlerState> _handlers = [];
    private readonly Dictionary<string, HandlerChoice> _handlerChoices = new(StringComparer.Ordinal);
    private IReadOnlyList<BundledPackageState> _packages = [];

    /// <summary>The packages the administrator ticked; what gets installed adds what they depend on.</summary>
    private readonly HashSet<string> _chosen = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>The bridges the administrator turned off. Any other bridge goes in wherever the packages it joins do.</summary>
    private readonly HashSet<string> _bridgesOff = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>Whether the administrator wants the starter wiki pages; ticked until they untick it. A reload
    /// after a failed save keeps their choice.</summary>
    private bool _starterWiki = true;

    /// <summary>Whether the game already has the starter wiki pages, which are offered once.</summary>
    private bool _starterWikiApplied;

    /// <summary>Whether the administrator wants the starting room described, an exit and a Newbie channel;
    /// ticked until they untick it.</summary>
    private bool _starterWorld = true;

    /// <summary>Whether the starter world was already applied, which is offered once.</summary>
    private bool _starterWorldApplied;

    /// <summary>What the administrator typed to find a package; it searches every package, shown or not.</summary>
    private string _search = string.Empty;

    /// <summary>
    /// Whether every bundled package is listed. Until then the step lists the recommended ones and whatever is
    /// installed or ticked, which is what a new game starts with; the rest are a search or one click away.
    /// </summary>
    private bool _showAll;

    /// <summary>
    /// Each step starts at its top. The shell, not the window, scrolls, and it kept the offset of the step
    /// before: a long step (handlers) left the next one opening below its heading.
    /// </summary>
    /// <summary>
    /// The heading names the game, and naming it is step 3: once a step has told the server something new,
    /// ask again and draw the heading with the answer.
    /// </summary>
    private void OnServerInfoChanged() => _ = InvokeAsync(async () =>
    {
        await ServerInfo.GameNameAsync();
        StateHasChanged();
    });

    public void Dispose() => ServerInfo.Changed -= OnServerInfoChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_step == _shownStep) return;
        var moved = _shownStep != Step.Resolving;
        _shownStep = _step;
        try
        {
            await JS.InvokeVoidAsync("SharpMUSH.scrollToTop", ".onboarding-shell");
            // A new step's heading takes focus, as a page would; the first step the page opens on leaves it at the top.
            if (moved) await JS.InvokeVoidAsync("SharpMUSH.focusHeading", ".setup-card .setup-title");
        }
        catch (JSException) { /* no portal-interop.js (tests): nothing scrolled */ }
    }

    protected override async Task OnInitializedAsync()
    {
        ServerInfo.Changed += OnServerInfoChanged;

        // "Have we asked yet?" and "what did the server say?" are separate questions: NeedsSetupAsync
        // answers the second three ways — needed / not needed / couldn't ask — and Resolving is the
        // first. Only a definitive "already claimed" leaves the claim form; a check that came back and
        // failed still shows it, since this is the only place first-run setup can be completed and the
        // submit's own error handling surfaces a real server problem.
        if (await AccountAuth.NeedsSetupAsync() is not bool needsSetup || needsSetup)
        {
            _step = Step.Claim;
            return;
        }

        // Claimed. Only the administrator with the wizard still pending has anything left to do here;
        // for anyone else (signed out, not staff, or finished) the server refuses or says not pending.
        if (await Wizard.GetAsync() is not SetupWizardResponse { Pending: true } wizard)
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }

        Load(wizard);
        _step = StepParameter?.ToLowerInvariant() switch
        {
            "identity" => Step.Identity,
            "handlers" => Step.Handlers,
            "packages" => Step.Packages,
            _ => Step.Import
        };
    }

    /// <summary>Takes the server's view of the handlers and packages as the starting choices.</summary>
    private void Load(SetupWizardResponse wizard)
    {
        _handlers = wizard.Handlers;
        _handlerChoices.Clear();
        foreach (var handler in wizard.Handlers)
        {
            _handlerChoices[handler.Kind] = new HandlerChoice(
                handler.Name is not null ? Keep : HandlerModes.Create, null);
        }

        // What the game has, and what a new game would have that it is missing — after a PennMUSH import, the
        // packages built on the handlers it removed — wherever that can go on now.
        _packages = wizard.Packages;
        _chosen.Clear();
        _chosen.UnionWith(wizard.Packages.Where(p => !p.Bridge && (p.Installed || p is { Recommended: true, Available: true })).Select(p => p.Id));
        // A bridge that is missing while the packages it joins are installed was turned off.
        var installed = wizard.Packages.Where(p => p.Installed).Select(p => p.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);
        _bridgesOff.Clear();
        _bridgesOff.UnionWith(wizard.Packages.Where(p => p is { Bridge: true, Installed: false } && p.DependsOn.All(installed.Contains)).Select(p => p.Id));

        _starterWikiApplied = wizard.StarterWikiApplied;
        _starterWorldApplied = wizard.StarterWorldApplied;
    }

    /// <summary>The two refusals the claim page words itself; anything else is the server's own sentence.</summary>
    private string ClaimRefusal(string message) => message switch
    {
        _ when message.Contains("already been completed", StringComparison.OrdinalIgnoreCase) => Loc["AuthSetupAlreadyCompleted"],
        _ when message.Contains("already taken", StringComparison.OrdinalIgnoreCase) => Loc["AuthUsernameTaken"],
        _ => message,
    };

    private async Task OnClaimKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_busy)
            await SubmitAsync();
    }

    private async Task SubmitAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_username)) { _error = Loc["AuthUsernameRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_password)) { _error = Loc["AuthPasswordRequired"]; return; }
        if (_password != _confirm) { _error = Loc["AuthPasswordsDoNotMatch"]; return; }
        if (!AccountPasswordRule.Accepts(_password)) { _error = Loc["AuthPasswordTooShort"]; return; }

        _busy = true;

        var result = await AccountAuth.CompleteSetupAsync(_username, _password);

        if (result is not AccountAuthService.SetupClaimed claimed)
        {
            _busy = false;
            _error = result is ApiFailure failure ? ClaimRefusal(failure.Message) : Loc["AuthSetupFailed"];
            return;
        }

        _completedUsername = _username;
        if (!claimed.SignedIn)
        {
            _busy = false;
            _step = Step.SignIn;
            return;
        }

        // Signed in as the new administrator: the rest of the wizard is theirs. If its state cannot be
        // read, the claim still stands and the remaining steps are optional — finish rather than strand them.
        var wizard = await Wizard.GetAsync();
        _busy = false;
        if (wizard is SetupWizardResponse state)
        {
            Load(state);
            _step = Step.Import;
        }
        else
        {
            _step = Step.Done;
        }
    }

    private void StartFresh()
    {
        _error = null;
        _step = Step.Identity;
        Nav.NavigateTo("/setup?step=identity", replace: true);
    }

    private void ContinueFromIdentity()
    {
        _step = Step.Handlers;
        Nav.NavigateTo("/setup?step=handlers", replace: true);
    }

    // A different choice is a different object, so whatever was checked and accepted no longer applies.
    private void Choose(string kind, string mode)
        => _handlerChoices[kind] = _handlerChoices[kind] with { Mode = mode, Clashes = null, CheckedFor = null, Accepted = false };

    private void SetDbref(string kind, string? value)
        => _handlerChoices[kind] = _handlerChoices[kind] with { Dbref = value, Clashes = null, CheckedFor = null, Accepted = false };

    private void Accept(string kind, bool accepted) => _handlerChoices[kind] = _handlerChoices[kind] with { Accepted = accepted };

    /// <summary>The existing object a choice builds the packages onto, or null for a new one or none.</summary>
    private int? ExistingTarget(string kind, HandlerChoice choice) => choice.Mode switch
    {
        Keep => _handlers.FirstOrDefault(h => h.Kind == kind)?.Dbref,
        HandlerModes.Use => ParseDbref(choice.Dbref),
        _ => null
    };

    /// <summary>Applies each handler choice that changes something, then moves on to the packages.</summary>
    private async Task SaveHandlersAsync()
    {
        _error = null;
        var requests = new List<(string Kind, SetHandlerRequest Request)>();
        foreach (var (kind, choice) in _handlerChoices)
        {
            switch (choice.Mode)
            {
                case Keep:
                    continue;
                case HandlerModes.Use when ParseDbref(choice.Dbref) is not { } number:
                    _error = Loc["AdmSetupHandlerDbrefRequired", HandlerTitle(kind)];
                    return;
                case HandlerModes.Use:
                    requests.Add((kind, new SetHandlerRequest(HandlerModes.Use, ParseDbref(choice.Dbref))));
                    break;
                default:
                    requests.Add((kind, new SetHandlerRequest(choice.Mode)));
                    break;
            }
        }

        // Building onto an existing object: say what it already has that the packages would write, and go no
        // further until the administrator has seen it and chosen to go ahead or picked something else.
        _busy = true;
        var unresolved = false;
        foreach (var (kind, choice) in _handlerChoices.ToList())
        {
            if (ExistingTarget(kind, choice) is not { } target)
            {
                continue;
            }

            if (choice.CheckedFor != target)
            {
                switch (await Wizard.GetClashesAsync(kind, target))
                {
                    case List<HandlerClash> clashes:
                        _handlerChoices[kind] = choice with { Clashes = clashes, CheckedFor = target, Accepted = false };
                        break;
                    case ApiFailure failure:
                        _error = Loc["AdmSetupHandlerFailed", HandlerTitle(kind), failure.Message];
                        _busy = false;
                        return;
                }
            }

            if (_handlerChoices[kind] is { Clashes.Count: > 0, Accepted: false })
            {
                unresolved = true;
            }
        }

        if (unresolved)
        {
            _busy = false;
            return;
        }

        foreach (var (kind, request) in requests)
        {
            if (await Wizard.SetHandlerAsync(kind, request) is ApiFailure failure)
            {
                _error = Loc["AdmSetupHandlerFailed", HandlerTitle(kind), failure.Message];
                break;
            }
        }

        // Some may have gone through before one failed: show what the game has now either way.
        if (await Wizard.GetAsync() is SetupWizardResponse current)
        {
            Load(current);
        }

        _busy = false;
        if (_error is null)
        {
            _step = Step.Packages;
            Nav.NavigateTo("/setup?step=packages", replace: true);
        }
    }

    private static int? ParseDbref(string? text)
        => int.TryParse(text?.Trim().TrimStart('#'), out var number) && number >= 0 ? number : null;

    private void Choose(string id, bool on)
    {
        var (set, add) = _packages.FirstOrDefault(p => p.Id == id) is { Bridge: true } ? (_bridgesOff, !on) : (_chosen, on);
        if (add) set.Add(id);
        else set.Remove(id);
    }

    /// <summary>
    /// What will be installed: the ticked packages, every bundled package they depend on, and the bridges between them
    /// that the administrator has not turned off.
    /// </summary>
    private HashSet<string> Effective
    {
        get
        {
            var effective = Closure(_chosen);
            effective.UnionWith(_packages.Where(p => p.Bridge && !_bridgesOff.Contains(p.Id) && p.DependsOn.All(effective.Contains)).Select(p => p.Id));
            return effective;
        }
    }

    /// <summary>Whether every package <paramref name="bridge"/> joins will be installed.</summary>
    private bool Joined(BundledPackageState bridge) => bridge.DependsOn.All(Closure(_chosen).Contains);

    private HashSet<string> Closure(IEnumerable<string> ids)
    {
        var closure = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var pending = new Stack<string>(ids);
        while (pending.TryPop(out var id))
        {
            if (closure.Add(id) && _packages.FirstOrDefault(p => p.Id == id) is { } package)
            {
                foreach (var dependency in package.DependsOn) pending.Push(dependency);
            }
        }

        return closure;
    }

    /// <summary>A ticked package that needs <paramref name="id"/>, which then cannot be unticked; null when none does.</summary>
    private BundledPackageState? NeededBy(string id)
        => _packages.FirstOrDefault(p => p.Id != id && _chosen.Contains(p.Id) && Closure([p.Id]).Contains(id));

    private async Task SavePackagesAsync()
    {
        _error = null;
        _busy = true;

        var packages = await Wizard.SetPackagesAsync(Effective.ToList());
        // The packages bring permissions (discord.admin, say) that open pages in the admin menu.
        if (packages is SetupWizardResponse)
        {
            await AccountAuth.ReloadAuthorityAsync();
        }
        var starterWorld = packages is SetupWizardResponse && _starterWorld && !_starterWorldApplied
            ? await Wizard.ApplyStarterWorldAsync()
            : new Success();
        var starterWiki = packages is SetupWizardResponse && _starterWiki && !_starterWikiApplied
            ? await Wizard.ApplyStarterWikiAsync()
            : new Success();

        switch (packages)
        {
            case SetupWizardResponse when starterWorld is ApiFailure failure:
                if (await Wizard.GetAsync() is SetupWizardResponse reloaded)
                {
                    Load(reloaded);
                }

                // The starter wiki was asked for after the world; when it failed too, say both.
                _error = starterWiki is ApiFailure wikiFailure
                    ? $"{Loc["AdmSetupStarterWorldFailed", failure.Message]} {Loc["AdmSetupStarterWikiFailed", wikiFailure.Message]}"
                    : Loc["AdmSetupStarterWorldFailed", failure.Message];
                break;
            case SetupWizardResponse when starterWiki is ApiFailure failure:
                // The packages are saved and the pages that could be written were. The step stays open with the
                // reason; saving again finishes the wizard.
                if (await Wizard.GetAsync() is SetupWizardResponse refreshed)
                {
                    Load(refreshed);
                }

                _error = Loc["AdmSetupStarterWikiFailed", failure.Message];
                break;
            case SetupWizardResponse:
                // The applications are saved either way; a wizard the server still counts as unfinished comes
                // back at the next sign-in, so say so here rather than show it as done.
                switch (await Wizard.FinishAsync())
                {
                    case Success:
                        _step = Step.Done;
                        break;
                    case ApiFailure failure:
                        _error = Loc["AdmSetupFinishFailed", failure.Message];
                        break;
                }

                break;
            case ApiFailure failure:
                // Some changes may have gone through; show what the game has now beside the reason.
                if (await Wizard.GetAsync() is SetupWizardResponse current)
                {
                    Load(current);
                }

                _error = Loc["AdmSetupAppsFailed", failure.Message];
                break;
        }

        _busy = false;
    }

    private IReadOnlyList<SetupPackageGroup> PackageGroups => SetupPackageGroups.For(ListedPackages, Loc["AdmSetupPkgGroupUncategorized"]);

    /// <summary>The packages the step lists: those matching the search, else all or the recommended and ticked ones.</summary>
    private IReadOnlyList<BundledPackageState> ListedPackages => _search.Trim() is { Length: > 0 } search
        ? _packages.Where(p => Matches(p, search)).ToList()
        : _showAll
        ? _packages
        : _packages.Where(p => p.Recommended || p.Installed || Effective.Contains(p.Id)).ToList();

    private bool Matches(BundledPackageState package, string search)
        => new[] { package.Id, PackageTitle(package), PackageDescription(package), package.Category ?? string.Empty }
            .Any(text => text.Contains(search, StringComparison.OrdinalIgnoreCase));

    /// <summary>
    /// The handlers section opens by itself when something there needs a decision: a handler that is not set, not
    /// there or not a wizard, a choice other than keeping it, or a refused save.
    /// </summary>
    private bool HandlersNeedAttention => _error is not null || _handlers.Any(handler =>
        handler.Name is null || !handler.IsWizard || _handlerChoices[handler.Kind].Mode != Keep);

    private string HandlerNow(HandlerState handler) => handler switch
    {
        { Dbref: { } number, Name: { } name } => Loc["AdmSetupHandlerNow", $"#{number}", name],
        { Dbref: { } missing } => Loc["AdmSetupHandlerMissing", $"#{missing}"],
        _ => Loc["AdmSetupHandlerUnset"],
    };

    private string HandlerTitle(string kind) => kind == HandlerKinds.Http
        ? Loc["AdmSetupHandlerHttpTitle"]
        : Loc["AdmSetupHandlerEventTitle"];

    private string HandlerDescription(string kind) => kind == HandlerKinds.Http
        ? Loc["AdmSetupHandlerHttpDesc"]
        : Loc["AdmSetupHandlerEventDesc"];

    private string Unavailable(BundledPackageState package) => package.Requires switch
    {
        HandlerKinds.Http => Loc["AdmSetupPkgNeedsHttp"],
        HandlerKinds.Event => Loc["AdmSetupPkgNeedsEvent"],
        _ => Loc["AdmSetupAppUnavailable"],
    };

    private string PackageTitle(string id) => _packages.FirstOrDefault(p => p.Id == id) is { } package
        ? PackageTitle(package)
        : id;

    private static string PackageTitle(BundledPackageState package) => package.Title;

    private string PackageDescription(BundledPackageState package) => package.Id switch
    {
        "http-handler" => Loc["AdmSetupPkgHttpHandlerDesc"],
        "profile-handler" => Loc["AdmSetupPkgProfileHandlerDesc"],
        "room-contents" => Loc["AdmSetupPkgRoomContentsDesc"],
        "comm-feed" => Loc["AdmSetupPkgCommFeedDesc"],
        "plus-help" => Loc["AdmSetupPkgPlusHelpDesc"],
        "plus-config" => Loc["AdmSetupPkgPlusConfigDesc"],
        "scene" => Loc["AdmSetupAppScenesDesc"],
        "wiki-reader" => Loc["AdmSetupAppWikiReaderDesc"],
        "jobs" => Loc["AdmSetupPkgJobsDesc"],
        "jobs-app" => Loc["AdmSetupPkgJobsAppDesc"],
        "chargen" => Loc["AdmSetupPkgChargenDesc"],
        "chargen-app" => Loc["AdmSetupPkgChargenAppDesc"],
        "bboards" => Loc["AdmSetupPkgBBoardsDesc"],
        "bboards-app" => Loc["AdmSetupPkgBBoardsAppDesc"],
        "messages" => Loc["AdmSetupPkgMessagesDesc"],
        _ => package.Description,
    };

    private void EnterPortal() => Nav.NavigateTo("/");
}
