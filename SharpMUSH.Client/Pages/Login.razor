@page "/login"
@layout OnboardingLayout
@using SharpMUSH.Client.Layout
@using SharpMUSH.Client.Services
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> Loc
@inject AccountAuthService AccountAuth
@inject ITerminalService Terminal

<PageTitle>@Loc["AuthSignIn"] — @Loc["AppTitle"]</PageTitle>

@* Single centered card — no marketing hero, no scrolling. Mirrors Setup.razor's visual family
   (logo + title above a card) inside OnboardingLayout's shell, which already supplies the
   full-viewport gradient background and glow. *@
<div class="login-page">
    <div class="login-brand">
        <img src="assets/Logo.svg" alt="@Loc["AppTitle"]" class="login-logo" />
        <h1 class="login-brand-title">@Loc["AppTitle"]</h1>
    </div>

    <MudPaper Elevation="4" Class="login-card">

        <MudTabs @bind-ActivePanelIndex="_tabIndex" Elevation="0" Rounded="true" Centered="true" Class="mb-3">
            <MudTabPanel Text="@Loc["AuthSignIn"]">
                <div class="pa-0 pt-3">
                    <MudTextField id="login-username" @bind-Value="_loginIdentifier" Label="@Loc["AuthUsernameOrEmail"]"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Person"
                                  Disabled="_busy" OnKeyDown="OnKeyDown" />
                    <MudTextField id="login-password" @bind-Value="_loginPassword" Label="@Loc["AuthPassword"]"
                                  InputType="InputType.Password"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Lock"
                                  Disabled="_busy" OnKeyDown="OnKeyDown" />

                    @if (_error is not null)
                    {
                        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
                    }

                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                               Disabled="_busy" OnClick="LoginAsync" Class="login-submit"
                               Style="font-weight:600;font-size:0.9375rem;height:42px;">
                        @if (_busy) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                        @Loc["Connect"]
                    </MudButton>
                </div>
            </MudTabPanel>

            <MudTabPanel Text="@Loc["AuthRegister"]">
                <div class="pa-0 pt-3">
                    <MudTextField @bind-Value="_regUsername" Label="@Loc["AuthUsername"]"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Person"
                                  Disabled="_busy" />
                    <MudTextField @bind-Value="_regEmail" Label="@Loc["AuthEmailOptional"]"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Email"
                                  Disabled="_busy" />
                    <MudTextField @bind-Value="_regPassword" Label="@Loc["AuthPassword"]"
                                  InputType="InputType.Password"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Lock"
                                  Disabled="_busy" />

                    @if (_error is not null)
                    {
                        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
                    }

                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                               Disabled="_busy" OnClick="RegisterAsync" Class="register-submit"
                               Style="font-weight:600;font-size:0.9375rem;height:42px;">
                        @if (_busy) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                        @Loc["AuthCreateAccount"]
                    </MudButton>
                </div>
            </MudTabPanel>
        </MudTabs>

        <MudDivider Class="my-3" />
        <MudText Align="Align.Center" Style="font-size:0.8125rem;color:var(--text-faint);">
            @Loc["AuthConnectDirectly"]
            <MudLink Href="/play" Style="color:var(--accent);">@Loc["AuthTerminalLink"]</MudLink>
        </MudText>
    </MudPaper>
</div>

@code {
    private const int SignInTabIndex = 0;
    private const int RegisterTabIndex = 1;

    /// <summary>
    /// Where an account with no character yet lands. "Registered, no character" is a step in
    /// onboarding, not a degraded permission tier: dropping such an account into the full portal
    /// shows it a shell where every gated surface refuses without saying why, while telnet's
    /// `login` names the exact next command. This routes it to the one page that resolves the
    /// state, which explains itself on arrival.
    /// </summary>
    private const string OnboardingUrl = "/characters/new";

    private int _tabIndex = SignInTabIndex;
    private bool _busy;
    private string? _error;

    private string _loginIdentifier = string.Empty;
    private string _loginPassword = string.Empty;

    private string _regUsername = string.Empty;
    private string _regEmail = string.Empty;
    private string _regPassword = string.Empty;

    private string? _returnUrl;

    protected override void OnInitialized()
    {
        // Populated when RedirectToLogin sent an anonymous visitor here off an [Authorize] page
        // (see App.razor's NotAuthorized branch / RedirectToLogin.razor), and the ?tab=register
        // hint set by /register's redirect. Parsed by hand rather than via
        // [SupplyParameterFromQuery] or QueryHelpers: this page isn't always reached through the
        // Router's own query-binding path (bUnit renders it directly in tests), and
        // Microsoft.AspNetCore.WebUtilities isn't a package this WASM client references.
        _returnUrl = GetQueryParam(Nav.Uri, "returnUrl");
        if (string.Equals(GetQueryParam(Nav.Uri, "tab"), "register", StringComparison.OrdinalIgnoreCase))
            _tabIndex = RegisterTabIndex;
    }

    private static string? GetQueryParam(string uri, string key)
    {
        var query = new Uri(uri).Query;
        if (string.IsNullOrEmpty(query)) return null;

        foreach (var pair in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            if (parts.Length == 2 && parts[0] == key)
                return Uri.UnescapeDataString(parts[1]);
        }
        return null;
    }

    /// <summary>
    /// Where to send the user after a successful login/registration. Only ever a same-origin
    /// relative path — a bare "/..." not "//..." or "/\..." (both of which browsers/some user
    /// agents treat as protocol-relative, i.e. an open redirect to an attacker-controlled host).
    /// Anything else (absolute URLs, external hosts, garbage) falls back to "/".
    /// </summary>
    private string SuccessUrl()
    {
        var url = _returnUrl;
        if (string.IsNullOrEmpty(url)) return "/";
        if (!url.StartsWith('/')) return "/";
        if (url.StartsWith("//") || url.StartsWith("/\\")) return "/";
        return url;
    }

    private async Task LoginAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_loginIdentifier) || string.IsNullOrWhiteSpace(_loginPassword))
        {
            _error = Loc["AuthEnterCredentials"];
            return;
        }
        _busy = true;
        StateHasChanged();
        var (success, error, characters) = await AccountAuth.LoginAsync(_loginIdentifier, _loginPassword);
        _busy = false;
        if (success)
            Nav.NavigateTo(characters.Count == 0 ? OnboardingUrl : SuccessUrl());
        else
            _error = error ?? Loc["AuthLoginFailed"];
        StateHasChanged();
    }

    private async Task RegisterAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_regUsername) || string.IsNullOrWhiteSpace(_regPassword))
        {
            _error = Loc["AuthUsernamePasswordRequired"];
            return;
        }
        _busy = true;
        StateHasChanged();
        // A fresh account never has a character, so registration always continues into onboarding.
        var (success, error, characters) = await AccountAuth.RegisterAsync(_regUsername, _regEmail, _regPassword);
        _busy = false;
        if (success)
            Nav.NavigateTo(characters.Count == 0 ? OnboardingUrl : SuccessUrl());
        else
            _error = error ?? Loc["AuthRegistrationFailed"];
        StateHasChanged();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await LoginAsync();
    }
}
