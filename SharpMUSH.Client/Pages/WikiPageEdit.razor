@page "/wiki/{Ns}/{Slug}/edit"
@using SharpMUSH.Client.Components
@attribute [Authorize(Policy = "wiki.edit")]
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["WikiEdit"]: @Slug — <GameName /></PageTitle>

<div class="full-height wiki-edit-host">
    <WikiView @key="@($"{Ns}:{Slug}:{Lang}")" Slug="@Slug" Namespace="@Ns"
              Locale="@Lang" NewTitle="@NewTitle" NewCategory="@NewCategory" Mode="WikiView.WikiMode.Edit" />
</div>

@code {
    [Parameter]
    public required string Slug { get; set; }

    [Parameter]
    public required string Ns { get; set; }


    /// <summary>
    /// The locale to edit, from <c>?lang=</c> — the deep link the reader's "Translate this page" points at.
    /// Part of the <c>@key</c> above so switching locale re-creates the host and reloads that locale's row.
    /// </summary>
    [SupplyParameterFromQuery(Name = "lang")]
    public string? Lang { get; set; }

    /// <summary>
    /// The title a creator typed before the editor opened (<c>?title=</c>, from the sidebar's New page).
    /// Only a page that does not exist yet starts from it; the route carries just the slug made from it.
    /// </summary>
    [SupplyParameterFromQuery(Name = "title")]
    public string? NewTitle { get; set; }

    /// <summary>
    /// A category a new page starts in (<c>?category=</c>, from an empty category's "Write a page here"). Like
    /// <see cref="NewTitle"/>, only a page that does not exist yet takes it.
    /// </summary>
    [SupplyParameterFromQuery(Name = "category")]
    public string? NewCategory { get; set; }
}
