@page "/map"
@page "/map/{Id:int}"
@using SharpMUSH.Client.Components.Map
@using SharpMUSH.Library.API
@inject WorldMapService Maps
@inject IAccountAuthState AccountAuth
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> Loc
@inject GameCommandService Commands
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IConnectionStateService Hub
@implements IDisposable

<PageTitle>@(_layout?.Map.Map.Name ?? Loc["NavWorldMap"].Value) — <GameName /></PageTitle>

@* The World map (the world-map package): the game's maps beside the one on show, a level at a time. A map is an
   object with MAP`KIND, and its rooms are the rooms zoned to it; the server sends only what the acting character
   may see. Choosing a room lists its exits; an exit to another map opens that map. Choosing a room on the map you are
   on also shows the way there, as one walk line to paste into any client or to walk from here. The map follows the
   character as it moves, to another map when it leaves this one. *@
<FeatureGate Feature="@GameFeatures.WorldMap">
<ChildContent>
<div class="map-page">
    <PlainPageHeader Title="@(_layout?.Map.Map.Name ?? Loc["NavWorldMap"].Value)" Kicker="@(_layout is null ? null : Loc["NavWorldMap"].Value)"
                     Description="@(_layout is null ? null : KindLabel(_layout.Map.Map.Kind))">
        <Actions>
            @if (_layout is not null)
            {
                <CapsuleButton Icon="@Icons.Material.Outlined.ZoomOut" AriaLabel="@Loc["NavMapZoomOut"]" Disabled="@(_zoom <= MinZoom)"
                               OnClick="() => ZoomBy(1 / ZoomStep)" />
                <CapsuleButton Icon="@Icons.Material.Outlined.ZoomIn" AriaLabel="@Loc["NavMapZoomIn"]" Disabled="@(_zoom >= MaxZoom)"
                               OnClick="() => ZoomBy(ZoomStep)" />
                <CapsuleButton Icon="@Icons.Material.Outlined.FitScreen" AriaLabel="@Loc["NavMapZoomFit"]" OnClick="FitAsync" />
                @if (_layout.Map.CanEdit && !_editing)
                {
                    <CapsuleButton Icon="@Icons.Material.Outlined.Edit" OnClick="StartEditing">@Loc["NavMapEdit"]</CapsuleButton>
                }
                else if (_editing)
                {
                    <CapsuleButton Icon="@Icons.Material.Outlined.Close" OnClick="StopEditing">
                        @(_plan?.Changes.Count > 0 ? Loc["NavMapDiscard"] : Loc["NavMapLeaveEdit"])
                    </CapsuleButton>
                }
                @if (_layout.Map.Here is { } here && !_editing)
                {
                    <CapsuleButton Icon="@Icons.Material.Outlined.MyLocation" OnClick="() => GoToRoomAsync(here)">@Loc["NavMapYouAreHere"]</CapsuleButton>
                }
            }
        </Actions>
    </PlainPageHeader>

    @if (AccountAuth.ActiveCharacter is null)
    {
        <EmptyState Class="map-note">@Loc["NavMapNeedsCharacter"]</EmptyState>
    }
    else
    {
        <div class="map-panes">
            <nav class="map-list" aria-label="@Loc["NavMapMaps"]">
                @if (_maps is null)
                {
                    @for (var i = 0; i < 3; i++) { <MudSkeleton Height="32px" Class="mb-1" /> }
                }
                else if (_maps.Count == 0)
                {
                    <p class="map-note">@(_listFailed ? Loc["WidUnavailable"] : Loc["NavMapNone"])</p>
                }
                else
                {
                    @Tree(null)
                }
                @NewMap()
            </nav>

            <div class="map-main">
                @if (Id is null)
                {
                    @if (_maps is { Count: > 0 })
                    {
                        <p class="map-note">
                            @if (_here is { Map: null } here)
                            {
                                @Loc["NavMapHereOffMap", here.Name]
                                @(" ")
                            }
                            @Loc["NavMapPick"]
                        </p>
                    }
                }
                else if (_loading)
                {
                    <MudSkeleton Height="320px" />
                }
                else if (_layout is null)
                {
                    <EmptyState Class="map-note">@(_missing ? Loc["NavMapMissing"] : Loc["WidUnavailable"])</EmptyState>
                }
                else
                {
                    @if (Trail() is { Count: > 0 } trail)
                    {
                        <nav class="map-trail" aria-label="@Loc["NavMapTrail"]">
                            <ol>
                                @foreach (var map in trail)
                                {
                                    <li><a href="@($"/map/{map.Id[1..]}")">@map.Name</a></li>
                                }
                                <li aria-current="page">@_layout.Map.Map.Name</li>
                            </ol>
                        </nav>
                    }
                    @if (_editing)
                    {
                        <p class="map-editing" role="status">@Loc["NavMapEditing", _layout.Map.Map.Name] @Loc["NavMapEditNote"]</p>
                    }
                    @if (_applied is { } applied)
                    {
                        <KitCard Class="map-applied" Title="@Loc["NavMapAppliedTitle"]">
                            <ol class="map-applied-list">
                                @foreach (var change in applied)
                                {
                                    <li class="map-applied--@change.State.ToString().ToLowerInvariant()">
                                        @change.Title:
                                        @(change.State switch
                                        {
                                            MapAppliedState.Done => Loc["NavMapApplied"],
                                            MapAppliedState.Failed => Loc["NavMapFailed", change.Error ?? ""],
                                            _ => Loc["NavMapNotRun"],
                                        })
                                    </li>
                                }
                            </ol>
                        </KitCard>
                    }
                    @if (Shown.Levels.Count > 1)
                    {
                        var at = Shown.Levels.ToList().IndexOf(_level);
                        <div class="map-levels">
                            <CapsuleButton Icon="@Icons.Material.Outlined.ArrowDownward" AriaLabel="@Loc["NavMapLevelDown"]"
                                           Disabled="@(at <= 0)" OnClick="() => StepLevel(-1)" />
                            <CapsuleButton Icon="@Icons.Material.Outlined.ArrowUpward" AriaLabel="@Loc["NavMapLevelUp"]"
                                           Disabled="@(at >= Shown.Levels.Count - 1)" OnClick="() => StepLevel(1)" />
                            <TypeChips Items="@LevelChips" Selected="@_level.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                       SelectedChanged="SelectLevel" AriaLabel="@Loc["NavMapLevels"]" />
                        </div>
                    }
                    @if (_layout.Map.Truncated)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="map-truncated">@Loc["NavMapTruncated"]</MudAlert>
                    }
                    @if (Shown.Rooms.Count == 0 && Shown.Space is null && !_editing)
                    {
                        <EmptyState Class="map-note">@Loc["NavMapEmpty"]</EmptyState>
                    }
                    else
                    {
                        <MapCanvas @ref="_canvas" Layout="Shown" Level="_level" Zoom="_zoom" Selected="@_selected" OnSelect="Select"
                                   Route="@(!_editing && _route?.Steps is { Count: > 0 } steps ? steps : null)"
                                   Editing="_editing" Cell="_cell" OnCell="SelectCell" OnZoomAt="ZoomBy"
                                   Cells="_cells" OnView="ViewAsync" SelectedPlace="_place" OnPlace="SelectPlace" />
                        @Legend()
                        @if (_editing && _plan is not null)
                        {
                            <KitCard Class="map-room-panel" Title="@Loc["NavMapBuilder"]">
                                <MapBuilder Plan="_plan" Layout="Shown" Level="_level" Selected="@_selected" Cell="_cell"
                                            Character="@CharacterId" OnChanged="PlanChangedAsync" OnApplied="AppliedAsync" />
                            </KitCard>
                        }
                        else
                        {
                            @RoomPanel()
                            @PlacePanel()
                        }
                    }
                }
            </div>
        </div>
    }
</div>
</ChildContent>
<Otherwise>
    <div class="map-page"><EmptyState>@Loc["NavMapNotEnabled"]</EmptyState></div>
</Otherwise>
</FeatureGate>

@code {
    [Parameter] public int? Id { get; set; }

    private const double ZoomStep = 1.25;
    private const double MinZoom = 0.1;
    private const double MaxZoom = 4;

    /// <summary>The most a map is enlarged to fit its frame, so a map of two rooms is not drawn as two posters.</summary>
    private const double MaxFit = 2;

    private IReadOnlyList<MapSummaryDto>? _maps;
    private IReadOnlyDictionary<string, string?> _parents = new Dictionary<string, string?>();
    private bool _listFailed;
    private MapLayout? _layout;
    private bool _editing;
    private MapPlan? _plan;
    private MapLayout? _preview;
    private (double X, double Y)? _cell;
    private IReadOnlyList<MapApplied>? _applied;

    /// <summary>The map on show: as the plan will leave it while editing, else as it is.</summary>
    private MapLayout Shown => _editing && _preview is not null ? _preview : _layout!;

    private string? CharacterId => AccountAuth.ActiveCharacter is { } acting ? $"#{acting.DbrefNumber}:{acting.CreationTime}" : null;

    private void StartEditing()
    {
        if (_layout is null) return;
        (_editing, _plan, _cell, _applied) = (true, new MapPlan(_layout.Map), null, null);
        ForgetRoute();
        _preview = new MapLayout(_plan.Preview());
    }

    private void StopEditing() => (_editing, _plan, _preview, _cell) = (false, null, null, null);

    private void SelectCell((double X, double Y) cell) => _cell = cell;

    /// <summary>The plan changed: draw the map as it now will be, and choose the room it names, on its level.</summary>
    private Task PlanChangedAsync(string? room)
    {
        if (_plan is null) return Task.CompletedTask;
        _preview = new MapLayout(_plan.Preview());
        _cell = null;
        if (room is not null && _preview.Rooms.TryGetValue(room, out var placed))
        {
            (_selected, _level) = (room, placed.Placed ? placed.Level : _level);
        }
        if (!_preview.Levels.Contains(_level) && _preview.Rooms.Count > 0) _level = _preview.Levels[0];
        return Task.CompletedTask;
    }

    /// <summary>The plan ran, all of it or up to a failed step: read the map again and keep editing it from there.</summary>
    private async Task AppliedAsync(IReadOnlyList<MapApplied> applied)
    {
        var (level, selected) = (_level, _selected);
        await LoadMapAsync();
        (_applied, _fit) = (applied, false);
        if (_layout is null) return;
        if (_layout.Levels.Contains(level)) _level = level;
        if (selected is not null && _layout.Rooms.ContainsKey(selected)) _selected = selected;
        StartEditing();
        _applied = applied;
    }
    private bool _loading;
    private bool _missing;
    private int _level;
    private double _zoom = 1;
    private bool _fit;

    /// <summary>The room to bring to the middle of the view once the map is drawn.</summary>
    private string? _centre;
    private string? _selected;
    private int? _shown;
    private MapCanvas? _canvas;
    private MapRouteDto? _route;
    private MapHereDto? _here;
    private string? _description;
    private bool _noRoute;
    private bool _walking;
    private string? _walkError;
    private int _routeAsked;

    /// <summary>The stored places read around the view, the view they were read for, and the place chosen for its panel.</summary>
    private MapCellsDto? _cells;
    private (int Left, int Bottom, int Right, int Top)? _view;
    private (int X, int Y)? _place;
    private int _cellsAsked;

    protected override async Task OnInitializedAsync()
    {
        AccountAuth.ActiveCharacterChanged += OnActingChanged;
        Hub.OnCharacterMoved += OnMoved;
        // Not awaited: the map does not wait for the live connection, which only tells it when the character moves.
        _ = Hub.ConnectAsync();
        await Task.WhenAll(LoadListAsync(), LoadHereAsync());
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Id == _shown) return;
        _shown = Id;
        await LoadMapAsync();
    }

    /// <summary>
    /// Where the character stands. With no map chosen, a character on a map is taken to it; one on no map is told so.
    /// </summary>
    private async Task LoadHereAsync()
    {
        _here = await Maps.HereAsync() switch
        {
            MapHereDto here => here,
            _ => null,
        };
        if (Id is null && _here?.Map is { } map) Nav.NavigateTo($"/map/{map.Id[1..]}", replace: true);
    }

    private async Task LoadListAsync()
    {
        if (AccountAuth.ActiveCharacter is null) return;
        var result = await Maps.ListAsync();
        (_maps, _listFailed) = result switch
        {
            IReadOnlyList<MapSummaryDto> maps => (maps, false),
            _ => ((IReadOnlyList<MapSummaryDto>)[], true),
        };
        _parents = MapTree.Parents(_maps);
    }

    private async Task LoadMapAsync()
    {
        (_layout, _selected, _missing, _applied) = (null, null, false, null);
        (_cells, _view, _place) = (null, null, null);
        ForgetRoute();
        StopEditing();
        if (Id is not { } id || AccountAuth.ActiveCharacter is null) return;
        _loading = true;
        var result = await Maps.GetAsync(id);
        _loading = false;
        switch (result)
        {
            case MapDto map:
                (_layout, _fit, _centre) = (new MapLayout(map), true, map.Here);
                _selected = map.Here;
                _level = map.Here is { } here && _layout.Rooms.TryGetValue(here, out var room)
                    ? room.Level
                    : map.Level is { } level && _layout.Levels.Contains(level) ? level
                    : _layout.Levels.Contains(0) ? 0 : _layout.Levels[0];
                _view = FirstView(_layout);
                await ReadCellsAsync();
                break;
            case ApiFailure failure:
                _missing = failure.Status == System.Net.HttpStatusCode.NotFound;
                break;
        }
    }

    private void OnActingChanged() => _ = InvokeAsync(async () =>
    {
        _shown = null;
        _maps = null;
        StateHasChanged();
        await Task.WhenAll(LoadListAsync(), LoadHereAsync());
        _shown = Id;
        await LoadMapAsync();
        StateHasChanged();
    });

    private IReadOnlyList<(string Key, string Label)> LevelChips =>
        _layout is null ? [] : Shown.Levels.Select(level => (level.ToString(System.Globalization.CultureInfo.InvariantCulture), LevelName(level))).ToList();

    private string LevelName(int level) =>
        _layout?.Map.LevelNames.TryGetValue(level, out var name) == true ? name : Loc["NavMapLevel", level].Value;

    /// <summary>The level <paramref name="by"/> places above (or below) the one on show, among the levels that have rooms or places.</summary>
    private async Task StepLevel(int by)
    {
        if (_layout is null) return;
        var at = Shown.Levels.ToList().IndexOf(_level) + by;
        if (at < 0 || at >= Shown.Levels.Count) return;
        _level = Shown.Levels[at];
        await ReadCellsAsync();
    }

    /// <summary>The regions this map is inside, outermost first.</summary>
    private List<MapSummaryDto> Trail()
    {
        var trail = new List<MapSummaryDto>();
        if (_maps is null || _layout is null) return trail;
        var byId = _maps.ToDictionary(map => map.Id);
        for (var at = _parents.GetValueOrDefault(_layout.Map.Map.Id); at is not null && byId.TryGetValue(at, out var map);
             at = _parents.GetValueOrDefault(at))
        {
            trail.Insert(0, map);
        }
        return trail;
    }

    private async Task SelectLevel(string key)
    {
        if (!int.TryParse(key, System.Globalization.CultureInfo.InvariantCulture, out var level)) return;
        _level = level;
        await ReadCellsAsync();
    }

    /// <summary>
    /// The cells to read places for before the frame reports its view: around the character's room when the map places
    /// it, else the middle of the stored places. Null for a map of rooms alone.
    /// </summary>
    private static (int Left, int Bottom, int Right, int Top)? FirstView(MapLayout layout)
    {
        if (layout.Space is not { } space) return null;
        var (x, y) = layout.Map.Here is { } here && layout.Rooms.TryGetValue(here, out var room) && room.Placed
            ? ((int)layout.Spot(room).X, (int)layout.Spot(room).Y)
            : ((int)(((long)space.Left + space.Right) / 2), (int)(((long)space.Bottom + space.Top) / 2));
        return (x - 8, y - 8, x + 8, y + 8);
    }

    /// <summary>The frame's view settled on other cells: read the places around it, unless those read already hold them.</summary>
    private async Task ViewAsync((int Left, int Bottom, int Right, int Top) view)
    {
        _view = view;
        await ReadCellsAsync();
    }

    /// <summary>
    /// Reads the stored places around the view on the level on show. A read still out is dropped once another starts or
    /// the places already read hold the view, as they do on going back to a level before its read for elsewhere returns.
    /// </summary>
    private async Task ReadCellsAsync()
    {
        if (_layout is null || Id is not { } id || _view is not { } view) return;
        var (asked, level) = (++_cellsAsked, _level);
        if (Shown.Holds(_cells, level, view) || Shown.Window(view) is not var (left, bottom, right, top)) return;
        if (await Maps.CellsAsync(id, level, left, bottom, right, top) is MapCellsDto cells && asked == _cellsAsked) _cells = cells;
    }

    private void SelectPlace(MapCellDto place)
    {
        (_place, _selected) = ((place.X, place.Y), null);
        ForgetRoute();
    }

    /// <summary>
    /// The chosen place: what it is called and its terrain, whether it may be entered, its picture and the values its
    /// data gives, who is there, and the room standing on it when the map draws that room.
    /// </summary>
    private RenderFragment PlacePanel() => __builder =>
    {
        if (_selected is not null || _place is not var (x, y) || _cells?.Level != _level
            || _cells.Cells.FirstOrDefault(cell => cell.X == x && cell.Y == y) is not { } place) return;
        var terrain = Shown.Map.Legend.FirstOrDefault(entry => entry.Type == place.Type);
        var name = place.Name ?? place.Label ?? terrain?.Label ?? place.Type;
        <KitCard Class="map-room-panel" Title="@name" Sub="@(name == terrain?.Label ? null : terrain?.Label)">
            <div class="map-room-body">
                @if (place.Closed)
                {
                    <p class="map-place-closed">@(place.Reason ?? Loc["NavMapClosed"].Value)</p>
                }
                @if (ImageUrlPolicy.IsRenderable(place.Image))
                {
                    <img class="map-place-image" src="@ApiUrl.Resolve(place.Image!)" alt="" loading="lazy" />
                }
                @if (place.Info.Count > 0)
                {
                    <dl class="map-place-info">
                        @foreach (var info in place.Info)
                        {
                            <dt>@info.Label</dt>
                            <dd>@info.Value</dd>
                        }
                    </dl>
                }
                @if (place.People > 0)
                {
                    <p class="map-room-people">@Loc["NavMapPeopleCount", place.People]</p>
                }
                @if (place.Room is { } room && _layout?.Rooms.ContainsKey(room) == true)
                {
                    <MudButton Variant="Variant.Outlined" OnClick="() => GoToRoomAsync(room)">@Loc["NavMapPlaceRoom"]</MudButton>
                }
            </div>
        </KitCard>
    };

    private void ZoomBy(double factor) => _zoom = Math.Clamp(_zoom * factor, MinZoom, MaxZoom);

    /// <summary>
    /// A map just opened is drawn to fit its frame, which it has only once it is drawn; then the room the character
    /// stands in comes to the middle of the view, which matters when the map is too big to fit.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_canvas is null) return;
        if (_fit)
        {
            _fit = false;
            await FitAsync();
            StateHasChanged();
            return;
        }
        if (_centre is { } room)
        {
            _centre = null;
            await _canvas.CentreAsync(room, focus: false);
        }
    }

    private async Task FitAsync()
    {
        if (_canvas is not null && await _canvas.FitAsync() is { } fit) _zoom = Math.Clamp(fit, MinZoom, MaxFit);
    }

    private async Task Select(string id)
    {
        (_selected, _cell, _place) = (id, null, null);
        if (!_editing) await LoadRouteAsync(id);
    }

    /// <summary>
    /// The room's description, evaluated for the character from the attribute <c>look</c> would show them (a reality
    /// layer's own, or DESCRIBE); null while asked, when it has none, or when the character may not read it. Asked with
    /// the route, so a stale reply is dropped too.
    /// </summary>
    private async Task LoadDescriptionAsync(string id, int asked)
    {
        if (await Maps.DescriptionAsync(id) is not MapDescriptionDto described || asked != _routeAsked) return;
        var result = await Commands.EvaluateAsync($"u({id}/{described.Attribute})");
        if (asked != _routeAsked) return;
        _description = result is PortalCommandResponse { Result: { Length: > 0 } text } && !text.StartsWith("#-1", StringComparison.Ordinal)
            ? text
            : null;
    }

    /// <summary>
    /// Asks the server the way from where the character stands to room <paramref name="id"/>: it sees every map, so a
    /// route may start or pass through another one. A reply asked before another room, map or character was chosen is
    /// dropped.
    /// </summary>
    private async Task LoadRouteAsync(string id)
    {
        var asked = ForgetRoute();
        if (_layout?.Rooms.TryGetValue(id, out var room) != true || room!.Region) return;
        var description = LoadDescriptionAsync(id, asked);
        var result = await Maps.RouteAsync(id);
        await description;
        if (asked != _routeAsked) return;
        (_route, _noRoute) = result switch
        {
            MapRouteDto route => (route, false),
            ApiFailure failure => (null, failure.Status == System.Net.HttpStatusCode.NotFound),
        };
    }

    /// <summary>Clears the route on show, and makes any reply still on its way stale.</summary>
    private int ForgetRoute()
    {
        (_route, _noRoute, _walkError, _description) = (null, false, null, null);
        return ++_routeAsked;
    }

    private async Task CopyAsync(string command)
    {
        try
        {
            // Rejected outside a secure context, or when the browser withholds clipboard permission.
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", command);
            Snackbar.Add(Loc["NavMapRouteCopied"], Severity.Info);
        }
        catch (JSException)
        {
            Snackbar.Add(Loc["WkCopyFailed"], Severity.Error);
        }
    }

    /// <summary>
    /// Walks the route as the acting character, then reads the map again: they stand somewhere new, at the end of the
    /// route or at the exit that refused them. What a refusal said is shown under the route.
    /// </summary>
    private async Task WalkAsync(string command, string to)
    {
        if (AccountAuth.ActiveCharacter is not { } acting || Id is null) return;
        (_walking, _walkError) = (true, null);
        try
        {
            var outcome = await Commands.RunAsync(command, "loc(%#)", $"#{acting.DbrefNumber}:{acting.CreationTime}");
            var error = outcome switch
            {
                PortalCommandResponse { Result: { } arrived } when arrived == to => null,
                PortalCommandResponse refused => refused.Output.LastOrDefault() ?? Loc["NavMapWalkStopped"].Value,
                ApiFailure failure => failure.Message,
            };
            var chosen = _selected;
            await LoadMapAsync();
            _selected = chosen;
            if (chosen is not null) await LoadRouteAsync(chosen);
            _walkError = error;
        }
        finally
        {
            _walking = false;
        }
    }

    /// <summary>Selects a room on this map, changing to its level, and moves focus to it.</summary>
    private async Task GoToRoomAsync(string id)
    {
        if (_layout?.Rooms.TryGetValue(id, out var room) != true) return;
        (_selected, _level, _place) = (id, room!.Level, null);
        await ReadCellsAsync();
        StateHasChanged();
        await Task.Yield();
        if (_canvas is not null) await _canvas.CentreAsync(id);
        await LoadRouteAsync(id);
    }

    private bool _creating;
    private bool _making;
    private string _newName = "";
    private string _newKind = MapKinds.Compass;
    private string? _newError;

    /// <summary>
    /// Makes a map as the character's own commands: <c>@create</c> an object, which stays in their inventory, and give it
    /// <c>MAP`KIND</c>. The new map opens in builder mode's reach once the list has it.
    /// </summary>
    private RenderFragment NewMap() => __builder =>
    {
        if (!_creating)
        {
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.Add" Class="map-new" OnClick="() => (_creating, _newError) = (true, null)">
                @Loc["NavMapNewMap"]
            </MudButton>
            return;
        }
        var problem = MapPlan.RoomNameProblem(_newName);
        <section class="map-new-form" aria-labelledby="map-new-title">
            <h3 id="map-new-title" class="map-new-title">@Loc["NavMapNewMap"]</h3>
            <MudTextField T="string" @bind-Value="_newName" Label="@Loc["NavMapNewName"]" Variant="Variant.Outlined" Immediate="true" />
            <MudSelect T="string" @bind-Value="_newKind" Label="@Loc["NavMapNewKind"]" Variant="Variant.Outlined">
                @foreach (var kind in MapKinds.All)
                {
                    <MudSelectItem Value="@kind">@KindLabel(kind)</MudSelectItem>
                }
            </MudSelect>
            <p class="map-note">@Loc["NavMapNewNote"]</p>
            @if (_newError is not null)
            {
                <p class="map-new-error" role="alert">@_newError</p>
            }
            <div class="map-new-actions">
                <MudButton Variant="Variant.Text" Disabled="_making" OnClick="() => _creating = false">@Loc["NavMapCancel"]</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_making || problem is not null)" OnClick="CreateMapAsync">
                    @Loc["NavMapCreate"]
                </MudButton>
            </div>
        </section>
    };

    private async Task CreateMapAsync()
    {
        if (MapPlan.RoomNameProblem(_newName) is not null) return;
        _making = true;
        try
        {
            var made = await Commands.RunAsync($"@create {_newName.Trim()}", "%>", CharacterId) switch
            {
                PortalCommandResponse { Result: { } dbref } when MapPlan.IsDbref(dbref) => dbref.Trim().Split(':')[0],
                PortalCommandResponse answer => Fail(answer.Output.LastOrDefault()),
                ApiFailure failure => Fail(failure.Message),
            };
            if (made is null) return;
            var kind = await Commands.RunAsync($"&MAP`KIND {made}={_newKind}", $"get({made}/MAP`KIND)", CharacterId) switch
            {
                PortalCommandResponse { Result: { } value } when value.Trim() == _newKind => made,
                PortalCommandResponse answer => Fail(answer.Output.LastOrDefault()),
                ApiFailure failure => Fail(failure.Message),
            };
            if (kind is null) return;
            (_creating, _newName) = (false, "");
            await LoadListAsync();
            Nav.NavigateTo($"/map/{made[1..]}");
        }
        finally
        {
            _making = false;
        }
    }

    private string? Fail(string? error)
    {
        _newError = error ?? Loc["NavMapNewFailed"].Value;
        return null;
    }

    private string KindLabel(string kind) => kind switch
    {
        MapKinds.Coordinates => Loc["NavMapKindCoordinates"],
        MapKinds.Compass => Loc["NavMapKindCompass"],
        _ => Loc["NavMapKindGraph"],
    };

    private RenderFragment Tree(string? parent) => __builder =>
    {
        var level = _maps!.Where(m => _parents[m.Id] == parent).ToList();
        if (level.Count == 0) return;
        <ul class="map-tree">
            @foreach (var map in level)
            {
                var current = Id is { } id && map.Id == $"#{id}";
                <li>
                    <a class="map-tree-link @(current ? "map-tree-link--on" : null)" href="@($"/map/{map.Id[1..]}")"
                       aria-current="@(current ? "page" : null)">@map.Name</a>
                    @Tree(map.Id)
                </li>
            }
        </ul>
    };

    private RenderFragment RoomPanel() => __builder =>
    {
        if (_selected is null || _layout?.Rooms.TryGetValue(_selected, out var room) != true) return;
        var exits = _layout.Map.Exits.Where(e => e.Source == _selected).OrderBy(e => e.Name, StringComparer.OrdinalIgnoreCase).ToList();
        <KitCard Class="map-room-panel" Title="@room!.Room.Name"
                 Sub="@(_selected == _layout.Map.Here ? Loc["NavMapYouAreHere"].Value : room.Placed ? null : Loc["NavMapUnplaced"].Value)">
            <div class="map-room-body">
                @if (_description is { } description)
                {
                    <p class="map-room-desc">@description</p>
                }
                @if (room.Room.People.Count > 0)
                {
                    <p class="map-room-people">@Loc["NavMapPeopleHere", string.Join(", ", room.Room.People)]</p>
                }
                @if (exits.Count == 0)
                {
                    <p class="map-note">@Loc["NavMapNoExits"]</p>
                }
                else
                {
                    <ul class="map-exits" aria-label="@Loc["NavMapExits"]">
                        @foreach (var exit in exits)
                        {
                            <li>
                                <span class="map-exit-name">@exit.Name</span>
                                @if (exit.DestinationMap is { } other)
                                {
                                    <a class="map-exit-to" href="@($"/map/{other.Id[1..]}")">@Loc["NavMapToMap", other.Name]</a>
                                }
                                else if (exit.Destination is { } to && _layout.Rooms.TryGetValue(to, out var target))
                                {
                                    <button type="button" class="map-exit-to" @onclick="() => GoToRoomAsync(to)">@target.Room.Name</button>
                                }
                                else if (exit.DestinationName is { } name)
                                {
                                    <span class="map-exit-to map-exit-to--off">@Loc["NavMapOffMap", name]</span>
                                }
                                else
                                {
                                    <span class="map-exit-to map-exit-to--unknown">@Loc["NavMapUnknown"]</span>
                                }
                            </li>
                        }
                    </ul>
                }
                @GettingThere()
            </div>
        </KitCard>
    };

    /// <summary>The kinds of place on this map that its legend names, each with its colour and icon.</summary>
    private RenderFragment Legend() => __builder =>
    {
        var used = Shown.Map.Rooms.Select(room => room.Environment)
            .Concat(_cells?.Level == _level ? _cells.Cells.Select(place => place.Type) : []).ToHashSet();
        var kinds = Shown.Map.Legend.Where(entry => used.Contains(entry.Type)).ToList();
        if (kinds.Count == 0) return;
        <ul class="map-legend" aria-label="@Loc["NavMapLegend"]">
            @foreach (var kind in kinds)
            {
                <li style="@MapLegendStyle.Style(kind)">
                    <span class="map-legend-swatch @(MapLegendStyle.Style(kind) is null ? null : "map-legend-swatch--toned")" aria-hidden="true">
                        @if (MapLegendStyle.Svg(kind.Icon) is { } svg)
                        {
                            <MudIcon Icon="@svg" Size="Size.Small" />
                        }
                        else
                        {
                            @MapLegendStyle.Glyph(kind.Icon)
                        }
                    </span>
                    @kind.Label
                </li>
            }
        </ul>
    };

    private RenderFragment GettingThere() => __builder =>
    {
        if (_layout is null || _selected is not { } to || (!_noRoute && _route?.Steps is not { Count: > 0 })) return;
        <section class="map-route" aria-labelledby="map-route-title">
            <h3 id="map-route-title" class="map-route-title">@Loc["NavMapGettingThere"]</h3>
            @if (_route is null)
            {
                <p class="map-note">@Loc["NavMapNoRoute"]</p>
            }
            else
            {
                <ol class="map-route-steps">
                    @for (var i = 0; i < _route.Steps.Count; i++)
                    {
                        var step = _route.Steps[i];
                        // A step onto another map than the one before it names that map, which opens it.
                        var entered = step.Map is { } map && map.Id != (i == 0 ? null : _route.Steps[i - 1].Map?.Id) ? map : null;
                        <li>
                            @Loc["NavMapRouteStep", step.Name, step.DestinationName]
                            @if (entered is not null && (i > 0 || entered.Id != _layout.Map.Map.Id))
                            {
                                @(" ")
                                <a class="map-route-map" href="@($"/map/{entered.Id[1..]}")">@Loc["NavMapRouteOnMap", entered.Name]</a>
                            }
                        </li>
                    }
                </ol>
                @if (_route.Command is { } command)
                {
                    <div class="map-route-command">
                        <code>@command</code>
                        <CapsuleButton Icon="@Icons.Material.Outlined.ContentCopy" AriaLabel="@Loc["NavMapCopyRoute"]" OnClick="() => CopyAsync(command)" />
                    </div>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_walking" OnClick="() => WalkAsync(command, to)">
                        @Loc["NavMapWalkThere"]
                    </MudButton>
                }
                else
                {
                    <p class="map-note">@Loc["NavMapRouteNoCommand"]</p>
                }
            }
            @if (_walkError is not null)
            {
                <p class="map-route-error" role="alert">@_walkError</p>
            }
        </section>
    };

    private void OnMoved(CharacterMovedMessage moved) => _ = InvokeAsync(() => FollowAsync(moved.Room.Split(':')[0]));

    /// <summary>How often, and how far apart, the map asks again for a move the server has not finished telling it of.</summary>
    private const int FollowTries = 4;
    private static readonly TimeSpan FollowWait = TimeSpan.FromMilliseconds(250);

    /// <summary>
    /// The character moved. The map follows: to the map it reached, or on this one to its room, which comes to the
    /// middle of the view (and is chosen, unless the reader had chosen another). A map being edited stays as it is.
    /// </summary>
    private async Task FollowAsync(string room)
    {
        if (_editing || AccountAuth.ActiveCharacter is null) return;
        // The move is told as it happens, so the first answer can still have the character where it was.
        for (var tries = 1; ; tries++)
        {
            _here = await Maps.HereAsync() switch
            {
                MapHereDto told => told,
                _ => null,
            };
            if (_here?.Room == room || tries == FollowTries) break;
            await Task.Delay(FollowWait);
        }
        if (_here?.Map is not { } map || _editing) return;
        if (map.Id != _layout?.Map.Map.Id)
        {
            Nav.NavigateTo($"/map/{map.Id[1..]}");
            return;
        }
        var fresh = await ReadMapAsync();
        for (var tries = 1; fresh is not null && fresh.Here != room && tries < FollowTries; tries++)
        {
            await Task.Delay(FollowWait);
            fresh = await ReadMapAsync();
        }
        if (fresh is null || _editing || fresh.Map.Id != _layout.Map.Map.Id) return;
        var followSelection = _selected is null || _selected == _layout.Map.Here;
        _layout = new MapLayout(fresh);
        if (fresh.Here is { } here && _layout.Rooms.TryGetValue(here, out var placed))
        {
            (_level, _centre) = (placed.Level, here);
            if (followSelection) await Select(here);
        }
        StateHasChanged();

        async Task<MapDto?> ReadMapAsync() => await Maps.GetAsync(Id!.Value) switch
        {
            MapDto read => read,
            _ => null,
        };
    }

    public void Dispose()
    {
        AccountAuth.ActiveCharacterChanged -= OnActingChanged;
        Hub.OnCharacterMoved -= OnMoved;
    }
}
