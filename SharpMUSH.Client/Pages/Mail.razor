@page "/mail"
@layout MailLayout
@attribute [Authorize]
@using SharpMUSH.Client.Components.Mail
@using SharpMUSH.Client.Services
@inject IStringLocalizer<SharedResource> Loc
@inject ITerminalService Terminal
@inject IAccountAuthState AccountAuth
@inject MailService MailApi
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>@Loc["Mail"] — @Loc["AppTitle"]</PageTitle>

@* D1 §6.5 mailbox: the folders are the section sidebar's, so the folder on screen is the address's
   (?folder=, the inbox by default). The page is the plain header over the folder's list card and a
   reading card beside it; below the narrow tier they stack. *@
@if (!_characterActive)
{
    <div class="mail-page">
        <PlainPageHeader Kicker="@Loc["AppTitle"]" Title="@Loc["Mail"]" />
        <KitCard Class="mail-needs-character">
            <div class="mail-note">
                <p>@Loc["MailNeedsCharacter"]</p>
                <CapsuleButton Href="/characters" Icon="@Icons.Material.Outlined.Groups">@Loc["Characters"]</CapsuleButton>
            </div>
        </KitCard>
    </div>
}
else
{
    <div class="mail-page full-height">
        <PlainPageHeader Kicker="@Loc["AppTitle"]" Title="@Loc["Mail"]">
            <Actions>
                <CapsuleButton Primary="true" Href="/mail/compose" Icon="@Icons.Material.Outlined.Edit">@Loc["Compose"]</CapsuleButton>
            </Actions>
        </PlainPageHeader>

        <div class="mail-panes">
            <KitCard Class="mail-list" Title="@_folder" Sub="@(_messages.Count > 0 ? Loc.Plural("NavMailMessageCount", "count", _messages.Count) : null)">
                <div class="mail-list-body">
                    @if (_loading)
                    {
                        <div class="mail-note">
                            @for (var i = 0; i < 5; i++) { <MudSkeleton Height="52px" Class="mb-1" /> }
                        </div>
                    }
                    else if (_listError is not null)
                    {
                        <div class="mail-note mail-list-error">@_listError</div>
                    }
                    else if (_messages.Count == 0)
                    {
                        <div class="mail-note mail-list-empty">@Loc["MailEmpty"]</div>
                    }
                    else
                    {
                        @foreach (var m in _messages)
                        {
                            <button type="button" class="mail-row @(_selected?.Number == m.Number ? "mail-row--selected" : null) @(m.Read ? null : "mail-row--unread")"
                                    aria-current="@(_selected?.Number == m.Number ? "true" : null)" @onclick="() => SelectMessageAsync(m)">
                                <CharacterAvatar Class="mail-avatar mail-row-avatar" Name="@m.From" Character="@m.From" />
                                <span class="mail-row-top">
                                    @if (!m.Read)
                                    {
                                        <StatusDot Label="@Loc["NavMailUnread"]" />
                                    }
                                    @if (m.Urgent)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.PriorityHigh" Color="Color.Error" Size="Size.Small" Title="@Loc["Urgent"]" />
                                    }
                                    <span class="mail-row-from">@m.From</span>
                                    <span class="mail-row-date">@m.DateSent.LocalDateTime.ToString("MMM d")</span>
                                </span>
                                <span class="mail-row-subject">@m.Subject</span>
                            </button>
                        }
                    }
                </div>
            </KitCard>

            <KitCard Class="mail-reading">
                @if (_selected is null)
                {
                    <div class="mail-reading-none">@Loc["NavMailSelectMessage"]</div>
                }
                else
                {
                    <div class="mail-reading-head">
                        <CharacterAvatar Class="mail-avatar mail-reading-avatar" Name="@_selected.From" Character="@_selected.From" />
                        <div class="mail-reading-meta">
                            <div class="mail-reading-subject">@_selected.Subject</div>
                            <div class="mail-reading-from">@Loc["From"]: @_selected.From</div>
                            <div class="mail-reading-date">@_selected.DateSent.LocalDateTime.ToString("dddd, MMMM d yyyy, h:mm tt")</div>
                        </div>
                    </div>
                    <div class="mail-reading-body">
                        @if (_bodyLoading)
                        {
                            <MudSkeleton Height="18px" Class="mb-1" />
                            <MudSkeleton Height="18px" Width="80%" Class="mb-1" />
                            <MudSkeleton Height="18px" Width="60%" />
                        }
                        else if (_body is null)
                        {
                            <div class="mail-reading-missing">@(_bodyError ?? Loc["MailNotFound"])</div>
                        }
                        else
                        {
                            <div class="mail-reading-text">@_body</div>
                        }
                    </div>
                    <div class="mail-reading-actions">
                        <CapsuleButton Class="mail-reply" Href="@ReplyHref(_selected)" Icon="@Icons.Material.Outlined.Reply">@Loc["Reply"]</CapsuleButton>
                        @if (_body is not null)
                        {
                            <CapsuleButton Class="mail-forward" OnClick="@(() => Forward(_selected, _body))" Icon="@Icons.Material.Outlined.Forward">@Loc["NavMailForward"]</CapsuleButton>
                        }
                        <CapsuleButton Class="mail-open" Href="@DetailHref(_selected)" Icon="@Icons.Material.Outlined.OpenInFull">@Loc["NavMailReadFullMessage"]</CapsuleButton>
                    </div>
                }
            </KitCard>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "folder")]
    public string? FolderQuery { get; set; }

    private bool _characterActive;
    private string _folder = MailSidebar.Inbox;
    private IReadOnlyList<MailService.MailSummary> _messages = [];
    private MailService.MailSummary? _selected;
    private string? _body;
    private string? _bodyError;
    private string? _listError;
    private bool _bodyLoading;
    private bool _loading;

    /// <summary>The folder whose list is on screen (or loading); a query change reloads.</summary>
    private string? _loadedFolder;

    // A fetch is identified by ticket, not by what it fetched: INBOX, then SENT, then INBOX again
    // gives two requests the same folder name, so comparing names lets the older one win.
    private long _folderTicket;
    private long _readTicket;

    protected override void OnInitialized()
    {
        _characterActive = Terminal.IsConnected;
        Terminal.ConnectionStateChanged += OnConnectionChanged;
        AccountAuth.ActiveCharacterChanged += OnActingChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        _folder = string.IsNullOrWhiteSpace(FolderQuery) ? MailSidebar.Inbox : FolderQuery;
        if (_characterActive && !string.Equals(_loadedFolder, _folder, StringComparison.Ordinal))
            await LoadFolderAsync(_folder);
    }

    private async Task LoadFolderAsync(string folder)
    {
        var ticket = ++_folderTicket;
        _readTicket++;
        _loadedFolder = folder;
        _selected = null;
        _body = null;
        _loading = true;

        var messages = await MailApi.ListAsync(folder);

        if (ticket != _folderTicket) return;

        (_messages, _listError) = messages switch
        {
            IReadOnlyList<MailService.MailSummary> rows => (rows, (string?)null),
            ApiFailure failure => ([], failure.Message),
        };
        _loading = false;
    }

    /// <summary>Selecting a row fetches the body, the same way <c>/mail/{number}</c> does.</summary>
    private async Task SelectMessageAsync(MailService.MailSummary msg)
    {
        var ticket = ++_readTicket;
        _selected = msg;
        _body = null;
        _bodyError = null;
        _bodyLoading = true;

        var result = await MailApi.ReadAsync(msg.Folder, msg.Number, wasUnread: !msg.Read);

        if (ticket != _readTicket) return;

        var message = result is MailService.MailMessage read ? read : null;
        _body = message?.Body;
        _bodyError = result is ApiFailure { Kind: not ApiFailureKind.NotFound } failure ? failure.Message : null;
        _bodyLoading = false;

        // Reading marks it read server-side; match that in the list.
        if (message is not null && !msg.Read)
        {
            _messages = _messages
                .Select(m => m.Number == msg.Number && m.Folder == msg.Folder ? m with { Read = true } : m)
                .ToList();
            _selected = _selected with { Read = true };
        }
    }

    /// <summary>A reply is addressed to the sender, its subject prefixed once.</summary>
    public static string ReplyHref(MailService.MailSummary message)
    {
        var subject = message.Subject.StartsWith("Re:", StringComparison.OrdinalIgnoreCase) ? message.Subject : $"Re: {message.Subject}";
        return $"/mail/compose?to={Uri.EscapeDataString(message.From)}&subject={Uri.EscapeDataString(subject)}";
    }

    /// <summary>
    /// A forward opens compose with the subject in the address and the quoted text staged in the mail
    /// service; the reader chooses who it goes to.
    /// </summary>
    private void Forward(MailService.MailSummary message, string body)
    {
        var subject = message.Subject.StartsWith("Fwd:", StringComparison.OrdinalIgnoreCase) ? message.Subject : $"Fwd: {message.Subject}";
        var draft = MailApi.StageDraft($"{Loc["NavMailForwardedFrom", message.From]}\n{body}");
        Nav.NavigateTo($"/mail/compose?subject={Uri.EscapeDataString(subject)}&draft={draft}");
    }

    private static string DetailHref(MailService.MailSummary message) =>
        $"/mail/{message.Number}?folder={Uri.EscapeDataString(message.Folder)}";

    private void OnConnectionChanged(bool connected)
        => InvokeAsync(async () =>
        {
            _characterActive = connected;
            _loadedFolder = null;
            if (connected) await LoadFolderAsync(_folder);
            StateHasChanged();
        });

    /// <summary>
    /// A character switch rebinds the REST session to the new character without reconnecting the
    /// terminal: the list and the open message are the previous character's until the folder is read
    /// again, which also puts the open message away.
    /// </summary>
    private void OnActingChanged()
        => InvokeAsync(async () =>
        {
            if (!_characterActive) return;
            // The open message and the list are the previous character's: they go before the new
            // character's folder is asked for, not when it answers.
            (_messages, _selected, _body) = ([], null, null);
            _loading = true;
            StateHasChanged();
            await LoadFolderAsync(_folder);
            StateHasChanged();
        });

    public void Dispose()
    {
        Terminal.ConnectionStateChanged -= OnConnectionChanged;
        AccountAuth.ActiveCharacterChanged -= OnActingChanged;
    }
}
