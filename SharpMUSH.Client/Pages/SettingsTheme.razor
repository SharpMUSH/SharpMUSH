@page "/settings/theme"
@layout SettingsLayout
@attribute [Authorize]
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["NavTheme"] — @Loc["Settings"] — @Loc["AppTitle"]</PageTitle>

<div class="settings-theme-page">
    <PlainPageHeader Kicker="@($"{Loc["AppTitle"]} · {Loc["Settings"]}")" Title="@Loc["NavTheme"]" Description="@Loc["NavSettingsThemeDescription"]" />

    <KitCard Title="@Loc["ComingSoon"]">
        <p class="settings-theme-text">@Loc["NavThemeComingSoon"]</p>
    </KitCard>
</div>
