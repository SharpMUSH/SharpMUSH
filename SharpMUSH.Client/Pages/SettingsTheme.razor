@page "/settings/theme"
@layout SettingsLayout
@attribute [Authorize]
@implements IDisposable
@inject IStringLocalizer<SharedResource> Loc
@inject AccountAuthService AccountAuth
@inject IThemeService Themes
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject NavigationManager Navigation

@* Each of the account's characters with its own colour vision, theme, accent and image filters. The look is stored with the character, so
   it follows the player to every device, and the acting character's is the one the portal wears. An accent
   that would be too faint on the chosen theme is shown moved toward white or black until it reads. No browser reports
   a reader's colour vision, so the player says it here; with no theme chosen it picks that vision's theme for the
   browser's light or dark setting. Each theme is shown as a small page in it, and "Try it" paints the whole portal
   in that theme until the player keeps it, stops, or leaves the page; nothing is saved until then. One character is
   open at a time, the acting one first, or the one a link names (#theme-7); the others show only their name and look,
   so the page draws one set of previews, not one per character. A preview stands still (ThemePreview Still). *@

<PageTitle>@Loc["NavTheme"] — @Loc["Settings"] — <GameName /></PageTitle>

<div class="settings-theme-page" @ref="_root">
    <PageHeader Kicker="@Loc["Settings"]" Title="@Loc["NavTheme"]" Description="@Loc["NavThemeIntro"]" />

    @if (_trying is { } trying && _shown is { } shown)
    {
        var keeping = _saving.Contains(trying.Dbref);
        <div class="settings-theme-trying" role="status" id="theme-trying">
            <MudIcon Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small" aria-hidden="true" />
            <span class="settings-theme-trying-text">@Loc["NavThemeTrying", shown.Name, trying.CharacterName]</span>
            <span class="settings-theme-trying-actions">
                <CapsuleButton Primary="true" Icon="@Icons.Material.Outlined.Check" OnClick="KeepAsync" Disabled="keeping" Class="settings-theme-keep">@Loc["NavThemeTryKeep"]</CapsuleButton>
                <CapsuleButton Icon="@Icons.Material.Outlined.Close" OnClick="StopTrying" Disabled="keeping" Class="settings-theme-stop">@Loc["NavThemeTryStop"]</CapsuleButton>
            </span>
        </div>
    }

    @if (AccountAuth.Characters.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.Palette">
            <ChildContent>@Loc["NavThemeNoCharacters"]</ChildContent>
            <Action><CapsuleButton Primary="true" Icon="@Icons.Material.Outlined.PersonAdd" Href="/characters/new">@Loc["NavCreateCharacter"]</CapsuleButton></Action>
        </EmptyState>
    }
    else
    {
        @foreach (var character in Ordered)
        {
            var look = Resolve(character);
            var busy = _saving.Contains(character.DbrefNumber);
            var open = IsOpen(character);
            <KitCard Class="settings-theme-card">
                <div class="settings-theme-char @(open ? "is-open" : null)" id="@($"theme-{character.DbrefNumber}")" data-character="@character.DbrefNumber">
                    <button type="button" class="settings-theme-head" aria-expanded="@(open ? "true" : "false")"
                            aria-controls="@($"theme-body-{character.DbrefNumber}")" @onclick="() => Toggle(character)">
                        <ThemeSwatch Theme="look" Still="true" />
                        <span class="settings-theme-name">
                            <span class="settings-theme-title">@character.Name</span>
                            <span class="settings-theme-sub">@look.Name · @Loc[look.Dark ? "NavThemeDark" : "NavThemeLight"]</span>
                        </span>
                        @if (character.IsActing)
                        {
                            <Pill Tag="true" Dot="@look.Accent">@Loc["NavThemeActing"]</Pill>
                        }
                        <MudIcon Icon="@Icons.Material.Outlined.ExpandMore" Size="Size.Small" Class="settings-theme-chevron" aria-hidden="true" />
                    </button>

                    @if (open)
                    {
                        <div class="settings-theme-body" id="@($"theme-body-{character.DbrefNumber}")">
                            <div class="settings-theme-field">
                                <span class="settings-theme-label" id="@($"vision-label-{character.DbrefNumber}")">@Loc["NavThemeVision"]</span>
                                <div class="settings-theme-choices settings-theme-visions" role="radiogroup" aria-labelledby="@($"vision-label-{character.DbrefNumber}")"
                                     aria-describedby="@($"vision-note-{character.DbrefNumber}")">
                                    @foreach (var vision in ThemeVision.All)
                                    {
                                        var chosen = ThemeVision.Chosen(vision);
                                        var on = character.Vision == chosen;
                                        <button type="button" role="radio" class="settings-theme-vision @(on ? "is-on" : null)" aria-checked="@(on ? "true" : "false")"
                                                data-vision="@vision" disabled="@busy" @onclick="() => SaveAsync(character, character.ThemeId, character.Accent, chosen)">
                                            <span class="settings-theme-vision-name">@Loc[VisionKey(vision)]</span>
                                            <span class="settings-theme-vision-what">@Loc[VisionKey(vision) + "What"]</span>
                                        </button>
                                    }
                                </div>
                                <span class="settings-theme-note" id="@($"vision-note-{character.DbrefNumber}")">
                                    @Loc[character.Vision is null ? "NavThemeVisionNote" : character.ThemeId is null ? "NavThemeVisionFollows" : "NavThemeVisionKept"]
                                </span>
                            </div>

                            <div class="settings-theme-field">
                                <span class="settings-theme-label" id="@($"filters-label-{character.DbrefNumber}")">@Loc["NavThemeImageFilters"]</span>
                                <div class="settings-theme-accents settings-theme-filters" role="radiogroup" aria-labelledby="@($"filters-label-{character.DbrefNumber}")"
                                     aria-describedby="@($"filters-note-{character.DbrefNumber}")">
                                    @foreach (var on in new[] { true, false })
                                    {
                                        var chosen = character.ImageFilters == on;
                                        <button type="button" role="radio" class="settings-theme-own @(chosen ? "is-on" : null)" aria-checked="@(chosen ? "true" : "false")"
                                                data-image-filters="@(on ? "on" : "off")" disabled="@busy"
                                                @onclick="() => SaveAsync(character, character.ThemeId, character.Accent, character.Vision, on)">
                                            @Loc[on ? "NavThemeImageFiltersOn" : "NavThemeImageFiltersOff"]
                                        </button>
                                    }
                                </div>
                                <span class="settings-theme-note" id="@($"filters-note-{character.DbrefNumber}")">@Loc["NavThemeImageFiltersNote"]</span>
                            </div>

                            <div class="settings-theme-field">
                                <span class="settings-theme-label" id="@($"motion-label-{character.DbrefNumber}")">@Loc["NavThemeReduceMotion"]</span>
                                <div class="settings-theme-accents settings-theme-motion" role="radiogroup" aria-labelledby="@($"motion-label-{character.DbrefNumber}")"
                                     aria-describedby="@($"motion-note-{character.DbrefNumber}")">
                                    @foreach (var on in new[] { true, false })
                                    {
                                        var chosen = character.ReduceMotion == on;
                                        <button type="button" role="radio" class="settings-theme-own @(chosen ? "is-on" : null)" aria-checked="@(chosen ? "true" : "false")"
                                                data-reduce-motion="@(on ? "on" : "off")" disabled="@busy"
                                                @onclick="() => SaveAsync(character, character.ThemeId, character.Accent, character.Vision, reduceMotion: on)">
                                            @Loc[on ? "NavThemeReduceMotionOn" : "NavThemeReduceMotionOff"]
                                        </button>
                                    }
                                </div>
                                <span class="settings-theme-note" id="@($"motion-note-{character.DbrefNumber}")">@Loc["NavThemeReduceMotionNote"]</span>
                            </div>

                            <div class="settings-theme-field">
                                <span class="settings-theme-label" id="@($"theme-label-{character.DbrefNumber}")">@Loc["NavThemeTheme"]</span>
                                <div class="settings-theme-choices" role="radiogroup" aria-labelledby="@($"theme-label-{character.DbrefNumber}")">
                                    @ThemeChoice(character, null, DefaultLabel(character), busy)
                                    @foreach (var theme in Published)
                                    {
                                        @ThemeChoice(character, theme.Id, theme.Name, busy)
                                    }
                                </div>
                                @if (character.ThemeId is null && character.Vision is null && Themes.Defaults.DarkThemeId != Themes.Defaults.LightThemeId)
                                {
                                    <span class="settings-theme-note">@Loc["NavThemeFollowsDevice"]</span>
                                }
                            </div>

                            <div class="settings-theme-field">
                                <span class="settings-theme-label" id="@($"accent-label-{character.DbrefNumber}")">@Loc["NavThemeAccent"]</span>
                                <div class="settings-theme-accents" role="radiogroup" aria-labelledby="@($"accent-label-{character.DbrefNumber}")">
                                    <button type="button" role="radio" class="settings-theme-own @(character.Accent is null ? "is-on" : null)"
                                            aria-checked="@(character.Accent is null ? "true" : "false")" disabled="@busy"
                                            @onclick="() => SaveAsync(character, character.ThemeId, null, character.Vision)">
                                        @Loc["NavThemeAccentThemeOwn"]
                                    </button>
                                    @foreach (var (name, hex) in BuiltInThemes.AccentSwatches)
                                    {
                                        var on = string.Equals(character.Accent, hex, StringComparison.OrdinalIgnoreCase);
                                        <button type="button" role="radio" class="settings-theme-dot @(on ? "is-on" : null)" title="@name"
                                                aria-label="@name" aria-checked="@(on ? "true" : "false")" disabled="@busy"
                                                style="@($"--dot:{hex}")" @onclick="() => SaveAsync(character, character.ThemeId, hex, character.Vision)"></button>
                                    }
                                    <label class="settings-theme-custom @(IsCustom(character) ? "is-on" : null)" title="@Loc["NavThemeAccentCustom"]">
                                        <input name="accent" type="color" value="@(character.Accent ?? look.Accent)" aria-label="@Loc["NavThemeAccentCustom"]" disabled="@busy"
                                               @onchange="e => SaveAsync(character, character.ThemeId, e.Value?.ToString(), character.Vision)" />
                                        <span>@Loc["NavThemeAccentCustom"]</span>
                                    </label>
                                </div>
                                @if (look.AccentAdjusted)
                                {
                                    <span class="settings-theme-note" data-adjusted="true">@Loc["NavThemeAccentAdjusted"]</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </KitCard>
        }
    }
</div>

@code {
    private ElementReference _root;
    private readonly HashSet<int> _saving = [];

    /// <summary>A theme the portal is painted in for a look, not yet saved: the character and theme choice it would save.</summary>
    private sealed record Trial(int Dbref, string CharacterName, string? ThemeId);

    private Trial? _trying;

    /// <summary>The look the trial last painted the portal in, so a change of accent or vision paints it again.</summary>
    private ResolvedTheme? _shown;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await JS.InvokeVoidAsync("sharpmushLayout.radioKeys", _root);
        }
        catch (JSException)
        {
            // Without the helper every native button remains reachable with Tab and Space.
        }
    }

    /// <summary>The character whose settings are open, once the player has opened or closed one; null when all are closed.</summary>
    private int? _open;

    /// <summary>False until the player opens or closes a character, or a link names one: the first character is open.</summary>
    private bool _openChosen;

    private bool IsOpen(AccountAuthService.CharacterSummary character) =>
        (_openChosen ? _open : Ordered.FirstOrDefault()?.DbrefNumber) == character.DbrefNumber;

    /// <summary>Opens a character's settings and closes the others; opening the open one closes it.</summary>
    private void Toggle(AccountAuthService.CharacterSummary character)
    {
        _open = IsOpen(character) ? null : character.DbrefNumber;
        _openChosen = true;
    }

    private IEnumerable<AccountAuthService.CharacterSummary> Ordered =>
        AccountAuth.Characters.OrderByDescending(c => c.IsActing).ThenBy(c => c.Name, StringComparer.OrdinalIgnoreCase);

    private IEnumerable<PortalTheme> Published => Themes.Themes.Where(t => t.Published);

    // "Phosphor / Daylight": the game default follows the browser's light or dark setting. With a colour vision chosen,
    // the pair is that vision's: "Deutan Dark / Deutan Light".
    private string DefaultLabel(AccountAuthService.CharacterSummary character)
    {
        string Name(string id) => Themes.Themes.FirstOrDefault(t => t.Id == id)?.Name ?? id;
        if (character.Vision is { } vision && ThemeVision.ThemeId(vision, false) is { } visionDark && ThemeVision.ThemeId(vision, true) is { } visionLight
            && Published.Any(t => t.Id == visionDark) && Published.Any(t => t.Id == visionLight))
        {
            return Loc["NavThemeVisionDefault", $"{Name(visionDark)} / {Name(visionLight)}"].Value;
        }

        var (dark, light) = (Themes.Defaults.DarkThemeId, Themes.Defaults.LightThemeId);
        return Loc["NavThemeGameDefault", dark == light ? Name(dark) : $"{Name(dark)} / {Name(light)}"].Value;
    }

    /// <summary>"deutan" is "NavThemeVisionDeutan".</summary>
    private static string VisionKey(string vision) => "NavThemeVision" + char.ToUpperInvariant(vision[0]) + vision[1..];

    protected override void OnInitialized()
    {
        // The account's character list links to a character's settings as /settings/theme#theme-7.
        if (new Uri(Navigation.Uri).Fragment is ['#', .. var fragment] && fragment.StartsWith("theme-", StringComparison.Ordinal)
            && int.TryParse(fragment["theme-".Length..], out var linked))
        {
            _open = linked;
            _openChosen = true;
        }

        Themes.OnThemeChanged += Changed;
        AccountAuth.AppearanceChanged += Changed;
    }

    protected override async Task OnInitializedAsync() => await AccountAuth.GetCharactersAsync();

    private ResolvedTheme Resolve(AccountAuthService.CharacterSummary character) =>
        ThemeResolver.Resolve(ThemeResolver.Pick(Published.ToList(), Themes.Defaults, Themes.PrefersLight, character.ThemeId, character.Vision),
            character.Accent, character.Vision);

    private static bool IsCustom(AccountAuthService.CharacterSummary character) =>
        character.Accent is { } accent && !BuiltInThemes.AccentSwatches.Any(s => string.Equals(s.Hex, accent, StringComparison.OrdinalIgnoreCase));

    // A theme as a small page in it, named under the picture, with "Try it" beside the name. The radio is the picture
    // and the name; "Try it" is a button of its own after it, so arrow keys move between themes and Tab reaches it.
    private RenderFragment ThemeChoice(AccountAuthService.CharacterSummary character, string? themeId, string label, bool busy) => __builder =>
    {
        var on = character.ThemeId == themeId;
        var theme = ThemeResolver.Resolve(ThemeResolver.Pick(Published.ToList(), Themes.Defaults, Themes.PrefersLight, themeId, character.Vision),
            character.Accent, character.Vision);
        var trying = _trying is { } t && t.Dbref == character.DbrefNumber && t.ThemeId == themeId;
        <div class="settings-theme-option @(trying ? "is-trying" : null)" data-theme="@(themeId ?? "default")">
            <button type="button" role="radio" class="settings-theme-choice @(on ? "is-on" : null)" aria-checked="@(on ? "true" : "false")"
                    disabled="@busy" @onclick="() => ChooseAsync(character, themeId)">
                <ThemePreview Theme="theme" Still="true" />
                <span class="settings-theme-choice-name">@label</span>
            </button>
            <button type="button" class="settings-theme-try" aria-pressed="@(trying ? "true" : "false")"
                    aria-label="@Loc["NavThemeTryNamed", label]" disabled="@busy" @onclick="() => Try(character, themeId)">
                <MudIcon Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small" aria-hidden="true" />
                <span>@Loc["NavThemeTry"]</span>
            </button>
        </div>
    };

    /// <summary>Paints the portal in a theme without saving it; trying the same one again stops.</summary>
    private void Try(AccountAuthService.CharacterSummary character, string? themeId)
    {
        if (_trying is { } current && current.Dbref == character.DbrefNumber && current.ThemeId == themeId)
        {
            StopTrying();
            return;
        }

        _trying = new Trial(character.DbrefNumber, character.Name, themeId);
        _shown = null;
        ShowTrial();
    }

    /// <summary>
    /// Paints the trial with the character's accent and vision as they are now, so changing either while trying shows
    /// what keeping would save. Only a look that differs is sent, since sending one is itself a change this page hears.
    /// </summary>
    private void ShowTrial()
    {
        if (_trying is not { } trying || AccountAuth.Characters.FirstOrDefault(c => c.DbrefNumber == trying.Dbref) is not { } character) return;
        var theme = ThemeResolver.Resolve(ThemeResolver.Pick(Published.ToList(), Themes.Defaults, Themes.PrefersLight, trying.ThemeId, character.Vision),
            character.Accent, character.Vision);
        if (_shown is { } shown && shown.ThemeId == theme.ThemeId && shown.Css == theme.Css) return;
        _shown = theme;
        Themes.Preview(theme);
    }

    private void StopTrying()
    {
        if (_trying is null) return;
        _trying = null;
        _shown = null;
        Themes.Preview(null);
    }

    private async Task KeepAsync()
    {
        if (_trying is not { } trying || AccountAuth.Characters.FirstOrDefault(c => c.DbrefNumber == trying.Dbref) is not { } character) return;
        await ChooseAsync(character, trying.ThemeId);
    }

    /// <summary>
    /// Saves the theme choice. Once it is saved a trial ends, since the saved look is now worn; until then the trial
    /// stays on, so the portal does not flash back, and a save that fails leaves it to keep or stop.
    /// </summary>
    private async Task ChooseAsync(AccountAuthService.CharacterSummary character, string? themeId)
    {
        if (await SaveAsync(character, themeId, character.Accent, character.Vision))
        {
            StopTrying();
        }
    }

    /// <summary>
    /// Saves a character's look, keeping its image filters and reduced motion unless <paramref name="imageFilters"/> or
    /// <paramref name="reduceMotion"/> says otherwise; false
    /// when it was not saved (another save for it is under way, or it failed).
    /// </summary>
    private async Task<bool> SaveAsync(AccountAuthService.CharacterSummary character, string? themeId, string? accent, string? vision,
        bool? imageFilters = null, bool? reduceMotion = null)
    {
        if (!_saving.Add(character.DbrefNumber)) return false;
        try
        {
            var appearance = new CharacterAppearance(themeId, accent, vision)
            {
                ImageFilters = imageFilters ?? character.ImageFilters,
                ReduceMotion = reduceMotion ?? character.ReduceMotion,
            };
            if (await AccountAuth.SetAppearanceAsync(character.DbrefNumber, appearance) is ApiFailure failure)
            {
                Snackbar.Add(Loc["NavThemeSaveFailed", failure.Message], Severity.Error);
                return false;
            }

            return true;
        }
        finally
        {
            _saving.Remove(character.DbrefNumber);
        }
    }

    private void Changed() => InvokeAsync(() =>
    {
        ShowTrial();
        StateHasChanged();
    });

    public void Dispose()
    {
        if (_trying is not null)
        {
            Themes.Preview(null);
        }

        Themes.OnThemeChanged -= Changed;
        AccountAuth.AppearanceChanged -= Changed;
    }
}
