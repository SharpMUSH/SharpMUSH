@page "/help/{Topic}"
@layout HelpLayout
@using SharpMUSH.Client.Components.Help
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Topic — @Loc["Help"] — @Loc["AppTitle"]</PageTitle>

@* One topic of the shipped help corpus: the plain header under "Help", the entry in a card, and a way
   back to the index for a reader whose sidebar is folded into the drawer. *@
<div class="help-page">
    <PlainPageHeader Kicker="@Loc["Help"]" Title="@Topic">
        <Actions>
            <CapsuleButton Href="/help" Icon="@Icons.Material.Outlined.MenuBook">@Loc["NavHelpIndex"]</CapsuleButton>
        </Actions>
    </PlainPageHeader>

    <KitCard>
        <div class="help-body">
            <HelpEntryPanel Topic="@Topic" />
        </div>
    </KitCard>
</div>

@code {
    /// <summary>
    /// The help topic, decoded from the route. Topics are the markdown headers inside the
    /// helpfiles — <c>@@mail</c>, <c>getting started</c>, <c>mail-sending</c> — not filenames, so
    /// this arrives percent-decoded and is passed through verbatim.
    /// </summary>
    [Parameter]
    public string Topic { get; set; } = string.Empty;
}
