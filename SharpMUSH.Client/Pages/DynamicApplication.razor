@page "/apps/{Slug}"
@page "/apps/{Slug}/{**Rest}"
@implements IDisposable
@using SharpMUSH.Client.Components.Schema
@using SharpMUSH.Client.Components.Admin
@using SharpMUSH.Client.Models.Applications
@using SharpMUSH.Client.Services
@using SharpMUSH.Library.Authorization
@inject IStringLocalizer<SharedResource> Loc
@inject ApplicationRegistryClient Registry
@inject SchemaAppService Schema
@inject PluginComponentLoader ComponentLoader
@inject AccountAuthService AccountAuth
@inject NavigationManager Nav

<PageTitle>@(_app?.DisplayName ?? Loc["NavApplication"])</PageTitle>

<AppSectionFrame App="_app">
<div class="app-page">
    <header class="app-header">
        <div class="app-kicker">@Loc["NavApplication"]</div>
        <h1 class="app-title">@(_app?.DisplayName ?? Loc["NavApplication"])</h1>
    </header>

    @if (_loading)
    {
        <div class="app-card app-loading">
            <MudProgressLinear Color="Color.Secondary" Indeterminate="true" />
            <span class="app-loading-text">@Loc["NavLoadingApplication"]</span>
        </div>
    }
    else if (_app is null)
    {
        <div class="app-alert app-alert-warning">
            @Loc["NavNoApplicationRegistered", $"/apps/{Slug}"]
        </div>
    }
    else if (!_authorized)
    {
        <div class="app-alert app-alert-error">
            @Loc["NavNoApplicationAccess"]
        </div>
    }
    else if (_needsCharacter)
    {
        @* This application's routes carry an {objid}/{character} token, and only an acting character
           can fill it. Rendering the schema anyway is what produced the reported bug: the page
           fetched /http/profile?objid=%7Bobjid%7D with the placeholder intact and reported the
           inevitable empty answer as "Nothing to display." Say what is actually missing instead. *@
        <div class="app-alert app-alert-warning">
            @Loc["NavApplicationNeedsCharacter"]
            @if (AccountAuth.IsLoggedIn)
            {
                <a class="app-alert-link" href="/characters/new">@Loc["NavCreateCharacter"]</a>
            }
            else
            {
                <a class="app-alert-link" href="/login">@Loc["AuthSignIn"]</a>
            }
        </div>
    }
    else if (_app.IsComponent)
    {
        @if (_componentType is not null)
        {
            <DynamicComponent Type="_componentType" />
        }
        else
        {
            <div class="app-alert app-alert-error">
                @Loc["NavApplicationComponentLoadFailed"]
            </div>
        }
    }
    else if (_schema is null)
    {
        <div class="app-alert app-alert-error">
            @Loc["NavApplicationSchemaLoadFailed", _app.SchemaUrl]
        </div>
    }
    else if (_schema.IsForm)
    {
        @* Keyed by what was fetched, so /apps/jobs/12 → /apps/jobs/13 starts a fresh form rather than
           carrying the values typed on the previous record. *@
        <SchemaFormRenderer @key="_loadedFrom" Document="_schema" Data="_data" />
    }
    else
    {
        <SchemaViewRenderer @key="_loadedFrom" Document="_schema" Data="_data" />
    }
</div>
</AppSectionFrame>

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    /// <summary>The sub-path after the slug (<c>/apps/jobs/12</c> → <c>12</c>), filling <c>{path}</c> in the app's routes.</summary>
    [Parameter] public string? Rest { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _loading = true;
    private bool _authorized;
    private bool _needsCharacter;
    private PortalApplication? _app;
    private PortalSchemaDocument? _schema;
    private SchemaData? _data;
    private Type? _componentType;

    // What the showing page was loaded for: the address (sub-path and query included) and the
    // signed-in state. A load is skipped when both are unchanged, so the parameter set and the
    // location change one navigation raises do not fetch twice.
    private string? _loadedUri;
    private Task<AuthenticationState>? _loadedAuth;
    private string? _loadedFrom;
    private int _generation;

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    /// <summary>
    /// A query-only navigation (<c>/apps/jobs</c> → <c>/apps/jobs?status=open</c>) passes the page the same
    /// parameters, which Blazor does not re-deliver, so the address change itself triggers the reload.
    /// </summary>
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (Location() is { } location && string.Equals(location.Slug, Slug, StringComparison.OrdinalIgnoreCase)
            && !string.Equals(Nav.Uri, _loadedUri, StringComparison.Ordinal))
        {
            _ = InvokeAsync(async () =>
            {
                await LoadAsync();
                StateHasChanged();
            });
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (string.Equals(Nav.Uri, _loadedUri, StringComparison.Ordinal) && ReferenceEquals(AuthState, _loadedAuth)
            && string.Equals(_app?.Slug, Slug, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var generation = ++_generation;
        _loadedUri = Nav.Uri;
        _loadedAuth = AuthState;
        _loading = true;
        _schema = null;
        _data = null;
        _componentType = null;
        _needsCharacter = false;
        var app = await Registry.GetAsync(Slug);
        if (generation != _generation) return;
        _app = app;

        // Each await below can let a newer load start; this one publishes nothing once it is stale.
        if (app is not null)
        {
            var authorized = await IsAuthorizedAsync(app);
            if (generation != _generation) return;
            _authorized = authorized;
            if (authorized)
            {
                if (app.IsComponent)
                {
                    // Compiled-component app: fetch + load the plugin assembly and resolve the Type by
                    // reflection (no plugin types referenced here). The loader no-ops when the gate is off.
                    if (!string.IsNullOrWhiteSpace(app.ComponentAssemblyUrl)
                        && !string.IsNullOrWhiteSpace(app.ComponentTypeName))
                    {
                        var componentType = await ComponentLoader.ResolveComponentAsync(
                            app.ComponentAssemblyUrl!, app.ComponentTypeName!);
                        if (generation != _generation) return;
                        _componentType = componentType;
                    }
                }
                else
                {
                    await LoadSchemaAppAsync(generation);
                }
            }
        }

        if (generation != _generation) return;
        _loading = false;
    }

    /// <summary>
    /// The slug, sub-path segments and query of the current address when it is an /apps/ address. The
    /// segments come back unescaped, ready to be escaped once each into a route.
    /// </summary>
    private (string Slug, IReadOnlyList<string> Segments, string Query)? Location()
    {
        var relative = Nav.ToBaseRelativePath(Nav.Uri);
        var fragment = relative.IndexOf('#');
        if (fragment >= 0) relative = relative[..fragment];
        var queryStart = relative.IndexOf('?');
        var query = queryStart >= 0 ? relative[(queryStart + 1)..] : string.Empty;
        var path = queryStart >= 0 ? relative[..queryStart] : relative;
        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
        if (segments.Length < 2 || !string.Equals(segments[0], "apps", StringComparison.OrdinalIgnoreCase))
        {
            return null;
        }

        return (Uri.UnescapeDataString(segments[1]), segments.Skip(2).Select(Uri.UnescapeDataString).ToList(), query);
    }

    /// <summary>
    /// The sub-path and query that fill this application's routes: read from the address when it is this
    /// app's, else from the <see cref="Rest"/> parameter with no query.
    /// </summary>
    private (IReadOnlyList<string> Segments, string Query) PathAndQuery()
        => Location() is { } location && string.Equals(location.Slug, Slug, StringComparison.OrdinalIgnoreCase)
            ? (location.Segments, location.Query)
            : ((Rest ?? string.Empty).Split('/', StringSplitOptions.RemoveEmptyEntries), string.Empty);

    /// <summary>
    /// Fetches the schema and (optionally) the data document, filling any page-context token in
    /// their routes first. This is the standalone-route counterpart to <c>SchemaWidget</c>: the
    /// widget fills <c>{objid}</c>/<c>{character}</c> from the cascading <c>ProfilePageContext</c>
    /// (the character whose profile it is being rendered on), which does not exist here — /apps/{slug}
    /// has no character in scope but the viewer's own. Without this the seeded character-header app
    /// requested <c>/http/profile?objid=%7Bobjid%7D</c> literally, for every persona, and reported the
    /// empty answer as "Nothing to display."
    /// </summary>
    private async Task LoadSchemaAppAsync(int generation)
    {
        var objid = await ActingObjidAsync();
        var (segments, query) = PathAndQuery();
        var schemaUrl = Substitute(_app!.SchemaUrl, objid) is { } schemaRoute ? SchemaRendering.ApplyPath(schemaRoute, segments, query) : null;
        var dataUrl = string.IsNullOrWhiteSpace(_app.DataUrl) ? null
            : Substitute(_app.DataUrl!, objid) is { } dataRoute ? SchemaRendering.ApplyPath(dataRoute, segments, query) : null;

        // A route we cannot fill is not a route we should fetch.
        if (schemaUrl is null || (_app.DataUrl is { Length: > 0 } && dataUrl is null))
        {
            _needsCharacter = true;
            return;
        }

        var schemaRead = Schema.GetSchemaAsync(schemaUrl);
        var dataRead = dataUrl is null ? null : Schema.GetDataAsync(dataUrl);
        var schema = await schemaRead is PortalSchemaDocument document ? document : null;
        var data = dataRead is not null && await dataRead is SchemaData payload ? payload : null;
        if (generation != _generation) return;

        (_schema, _data, _loadedFrom) = (schema, data, $"{schemaUrl}\n{dataUrl}");
    }

    /// <summary>
    /// The acting character's objid, or null when this viewer has none (anonymous, an account that
    /// owns no character, or a session the server is acting as nobody for). Built from the roster
    /// entry rather than looked up by name through the character directory the way SchemaWidget has
    /// to: the account API hands back the dbref and creation time that <em>are</em> the objid
    /// (<c>#N:creation</c>, see DBRef.ToString), so there is nothing to resolve and no ambiguity if
    /// two characters ever shared a name.
    /// </summary>
    /// <remarks>
    /// <see cref="AccountAuthService.ActiveCharacter"/> is the only admissible answer: it is set
    /// solely from the entry the server marked as acting, and an unmarked roster means this
    /// session's token is bound to nobody (see AccountAuthService.SetCharacters). Falling back to
    /// the first roster entry would fill <c>{objid}</c> with a character the server will not honour
    /// — on an account with several characters that is somebody else's profile rendered under this
    /// viewer's session, which is worse than the "needs a character" card the null returns.
    /// </remarks>
    private async Task<string?> ActingObjidAsync()
    {
        await AccountAuth.InitAsync();
        if (!AccountAuth.IsLoggedIn) return null;

        // A session restored from sessionStorage carries no roster, so a reloaded tab has to ask.
        if (AccountAuth.ActiveCharacter is null && AccountAuth.Characters.Count == 0)
            await AccountAuth.GetCharactersAsync();

        var character = AccountAuth.ActiveCharacter;
        return character is null ? null : $"#{character.DbrefNumber}:{character.CreationTime}";
    }

    /// <summary>
    /// Fills <c>{objid}</c>/<c>{character}</c> in a route; null when an <c>{objid}</c> token cannot be
    /// filled. Mirrors <c>SchemaWidget.Substitute</c> — same tokens, same escaping, same "null means
    /// don't fetch" contract — so an application behaves identically as a widget and standalone.
    /// </summary>
    private string? Substitute(string route, string? objid)
    {
        var result = route;

        if (result.Contains("{objid}", StringComparison.Ordinal))
        {
            if (string.IsNullOrWhiteSpace(objid)) return null;
            result = result.Replace("{objid}", Uri.EscapeDataString(objid), StringComparison.Ordinal);
        }

        if (result.Contains("{character}", StringComparison.Ordinal))
        {
            // Same acting-character-only rule as ActingObjidAsync: a name the server is not acting
            // as would address the request to the wrong persona.
            var name = AccountAuth.ActiveCharacter?.Name;
            if (string.IsNullOrWhiteSpace(name)) return null;
            result = result.Replace("{character}", Uri.EscapeDataString(name), StringComparison.Ordinal);
        }

        return result;
    }

    /// <summary>The viewer's role meets the app's minimum and, when it names one, they hold its permission.</summary>
    private async Task<bool> IsAuthorizedAsync(PortalApplication app)
        => app.Admits(AuthState is null ? null : (await AuthState).User);
}
