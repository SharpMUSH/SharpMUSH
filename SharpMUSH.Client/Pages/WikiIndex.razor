@page "/wiki"
@layout WikiLayout
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["Wiki"] — @Loc["AppTitle"]</PageTitle>

@* D1 §6.1: the wiki home is the admin-composed wiki-index scope — MainContent (the WikiIndex widget)
   beside a RightSidebar zone (Recently changed, Live now) rendered inside the page, as the profile
   already does with its own right zone. *@
<div class="wiki-index-page">
    <div class="wiki-index-main">
        <ScopedZone Scope="@LayoutScopes.WikiIndex" Zone="WidgetZone.MainContent" />
    </div>
    <aside class="wiki-index-aside">
        <ScopedZone Scope="@LayoutScopes.WikiIndex" Zone="WidgetZone.RightSidebar" Grid="false" />
    </aside>
</div>
