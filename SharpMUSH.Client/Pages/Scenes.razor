@page "/scenes"
@using SharpMUSH.Client.Models
@using SharpMUSH.Client.Services
@inject IStringLocalizer<SharedResource> Loc
@inject SceneService SceneService
@inject ITerminalService Terminal
@implements IDisposable

<PageTitle>@Loc["SceneArchive"] — @Loc["AppTitle"]</PageTitle>

<div class="scenes-page">
    <MudText Typo="Typo.h4" Style="font-weight:700;margin-bottom:0.25rem;">@Loc["SceneArchive"]</MudText>
    <MudText Style="color:var(--text-dim);font-size:0.875rem;margin-bottom:1.5rem;">@Loc["ResScenesSubtitle"]</MudText>

    @* Starting a scene goes down the terminal websocket, which is already open as this character —
       the same channel the live compose box posts through. Shown only when that connection exists,
       because without it there is nothing to send the verb down. *@
    @if (Terminal.IsConnected)
    {
        <div class="scene-start">
            @if (!_starting)
            {
                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="@(() => _starting = true)">@Loc["RolStartScene"]</MudButton>
            }
            else
            {
                <div class="scene-start-form">
                    <MudTextField T="string" @bind-Value="_newTitle" Immediate="true"
                                  Class="scene-start-title" Margin="Margin.Dense"
                                  Variant="Variant.Outlined" Label="@Loc["RolSceneTitleLabel"]" />
                    <MudCheckBox T="bool" @bind-Value="_newPublic" Dense="true"
                                 Class="scene-start-public" Label="@Loc["RolSceneLetAnyoneWatch"]" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               Class="scene-start-submit"
                               Disabled="@(string.IsNullOrWhiteSpace(_newTitle) || _busy)"
                               OnClick="StartSceneAsync">@Loc["RolStartScene"]</MudButton>
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               OnClick="@(() => { _starting = false; _newTitle = string.Empty; })">@Loc["Cancel"]</MudButton>
                </div>
            }
        </div>
    }

    <MudTabs Elevation="0" Rounded="false" @bind-ActivePanelIndex="_tab">
        <MudTabPanel Text="@Loc["ResTabRecent"]" BadgeData="@(_recent?.Count)" BadgeColor="Color.Default">
            @SceneList(_recent)
        </MudTabPanel>
        <MudTabPanel Text="@Loc["ResTabLive"]" BadgeData="@(_active?.Count)" BadgeColor="Color.Success">
            @SceneList(_active)
        </MudTabPanel>
    </MudTabs>
</div>

@code {
    private int _tab;
    private bool _loading = true;
    private bool _starting;
    private bool _busy;
    private string _newTitle = string.Empty;

    // Matches what the engine now does when nobody specifies. The box is not here to ask for the
    // default; it is here so the choice is visible at the moment a scene is started, and so the
    // exception can be made without knowing a command.
    private bool _newPublic = true;
    private IReadOnlyList<SceneSummary>? _recent;
    private IReadOnlyList<SceneSummary>? _active;

    // The websocket may still be coming up when this page renders — MainLayout opens it, and a
    // player can arrive here before it finishes. Reading IsConnected once and never listening left
    // the start button permanently absent for exactly those arrivals.
    protected override void OnInitialized() => Terminal.ConnectionStateChanged += OnConnectionChanged;

    public void Dispose() => Terminal.ConnectionStateChanged -= OnConnectionChanged;

    private void OnConnectionChanged(bool _) => InvokeAsync(StateHasChanged);

    protected override async Task OnInitializedAsync()
    {
        var recentTask = SceneService.GetRecentScenesAsync(50);
        var activeTask = SceneService.GetActiveScenesAsync();
        _recent = await recentTask;
        _active = await activeTask;
        _loading = false;
    }

    private async Task StartSceneAsync()
    {
        var title = _newTitle.Trim();
        if (title.Length == 0) return;

        _busy = true;
        try
        {
            var before = _active?.Count ?? 0;
            await Terminal.SendAsync($"+scene/create {title}");

            // The verb travels to the engine and back over NATS, so the scene is not in the API the
            // instant the send returns. Poll briefly for it rather than guessing at a sleep long
            // enough to cover the round trip: whichever happens first, the page stops waiting.
            var created = false;
            for (var attempt = 0; attempt < 6 && !created; attempt++)
            {
                await Task.Delay(250);
                _active = await SceneService.GetActiveScenesAsync();
                created = _active is not null && _active.Count > before;
            }

            // Only the exception needs saying, and only once there is something to say it about.
            // +scene/private acts on the focused scene, and creation is what focuses the new one — so
            // sending it before knowing a scene was created would, on a refusal, make whatever the
            // player was already focused on private instead.
            if (created && !_newPublic)
            {
                await Terminal.SendAsync("+scene/private");
            }

            _recent = await SceneService.GetRecentScenesAsync(50);

            if (created)
            {
                _starting = false;
                _newTitle = string.Empty;
                _newPublic = true;
            }
        }
        finally
        {
            // In a finally because a send that throws would otherwise leave the form disabled with no
            // way back other than reloading the page.
            _busy = false;
        }
    }

    private RenderFragment SceneList(IReadOnlyList<SceneSummary>? scenes) => __builder =>
    {
        if (_loading)
        {
            for (var i = 0; i < 4; i++)
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="72px" Class="mb-2" Style="border-radius:var(--radius);" />
            }
        }
        else if (scenes is null || scenes.Count == 0)
        {
            <EmptyState>@Loc["ResNoScenesFound"]</EmptyState>
        }
        else
        {
            <div style="display:flex;flex-direction:column;gap:0.625rem;">
                @foreach (var scene in scenes)
                {
                    <MudPaper Elevation="0" Class="scene-card">
                        <div style="flex:1;min-width:0;">
                            <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.1875rem;">
                                @if (scene.IsLive)
                                {
                                    <MudChip T="string" Color="Color.Success" Size="Size.Small"
                                             Style="font-size:0.625rem;letter-spacing:0.06em;height:20px;padding:0 0.4375rem;">@Loc["RolLiveBadge"]</MudChip>
                                }
                                <MudText Style="font-size:0.875rem;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                    @SceneTitle(scene)
                                </MudText>
                            </div>
                            <div class="scene-meta-row">
                                <MudText Style="font-size:0.75rem;color:var(--text-dim);">
                                    <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" Style="vertical-align:middle;margin-right:0.125rem;font-size:0.8125rem;" />
                                    @scene.RoomName
                                </MudText>
                                <MudText Style="font-size:0.75rem;color:var(--text-faint);">
                                    <MudIcon Icon="@Icons.Material.Filled.Notes" Size="Size.Small" Style="vertical-align:middle;margin-right:0.125rem;font-size:0.8125rem;" />
                                    @Loc.Plural("RolPoseCount", "count", scene.PoseCount)
                                </MudText>
                                <MudText Style="font-size:0.75rem;color:var(--text-faint);">
                                    @scene.LastActivityAtUtc.ToLocalTime().ToString("MMM d, yyyy HH:mm")
                                </MudText>
                            </div>
                        </div>
                        <div class="scene-actions" style="display:flex;gap:0.5rem;flex-shrink:0;">
                            <MudButton Variant="Variant.Text" Size="Size.Small"
                                       Color="Color.Primary" Href="@($"/scenes/{scene.Id}")">
                                @Loc["ResRead"]
                            </MudButton>
                            @if (scene.IsLive)
                            {
                                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                           Style="border-color:var(--accent);color:var(--accent);"
                                           Href="@($"/scenes/{scene.Id}/live")">
                                    @Loc["ResJoin"]
                                </MudButton>
                            }
                        </div>
                    </MudPaper>
                }
            </div>
        }
    };

    private string SceneTitle(SceneSummary s) =>
        s.Meta.TryGetValue("title", out var t) && !string.IsNullOrWhiteSpace(t)
            ? t
            : Loc["RolSceneIn", s.RoomName];
}
