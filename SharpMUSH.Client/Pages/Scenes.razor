@page "/scenes"
@layout ScenesLayout
@using SharpMUSH.Client.Components.Scenes
@inject IStringLocalizer<SharedResource> Loc
@inject SceneService SceneService
@inject GameCommandService Commands
@inject AccountAuthService AccountAuth
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>@Loc["SceneArchive"] — @Loc["AppTitle"]</PageTitle>

@* The scene archive in the D1 kit: the plain header with Schedule and Start scene, and the scenes as cards. Which
   scenes is the address the sidebar links to (ScenesFilter): every scene, the acting character's
   (?mine=1), the scheduled ones (as an agenda by day and time) or the finished ones. The live list is its own page, /scenes/active. *@
<div class="scenes-page">
    <PlainPageHeader Kicker="@Loc["SceneArchive"]" Title="@Heading" Description="@Description">
        <Actions>
            @* Starting a scene runs +scene/create as the character this tab acts as (POST api/commands),
               so it is offered only while one is. No terminal is needed: the command answers the page. *@
            @if (_acting is not null && !_starting && !_scheduling)
            {
                @* Scheduling runs +scene/schedule the same way: a scene for later, with no room until it starts. *@
                <CapsuleButton Icon="@Icons.Material.Outlined.EditCalendar" Class="scene-schedule-open"
                               OnClick="OpenSchedule">@Loc["RolScheduleScene"]</CapsuleButton>
                <div class="scene-start">
                    <CapsuleButton Primary="true" Icon="@Icons.Material.Outlined.Add" OnClick="@(() => { _starting = true; _scheduledNote = null; })">@Loc["RolStartScene"]</CapsuleButton>
                </div>
            }
        </Actions>
    </PlainPageHeader>

    @if (_acting is not null && _starting)
    {
        <KitCard Class="scene-start" Title="@Loc["RolStartScene"]">
            <div class="scene-start-form">
                <MudTextField T="string" @bind-Value="_newTitle" Immediate="true"
                              Class="scene-start-title" Margin="Margin.Dense"
                              Variant="Variant.Outlined" Label="@Loc["RolSceneTitleLabel"]" />
                <MudCheckBox T="bool" @bind-Value="_newPublic" Dense="true"
                             Class="scene-start-public" Label="@Loc["RolSceneLetAnyoneWatch"]" />
                @if (_startError is not null)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="scene-start-error">@_startError</MudAlert>
                }
                <div class="scene-start-buttons">
                    <CapsuleButton Primary="true" Class="scene-start-submit"
                                   Disabled="@(string.IsNullOrWhiteSpace(_newTitle) || _busy)"
                                   OnClick="StartSceneAsync">@Loc["RolStartScene"]</CapsuleButton>
                    <CapsuleButton OnClick="@(() => { _starting = false; _newTitle = string.Empty; })">@Loc["Cancel"]</CapsuleButton>
                </div>
            </div>
        </KitCard>
    }

    @if (_acting is not null && _scheduling)
    {
        <KitCard Class="scene-schedule" Title="@Loc["RolScheduleScene"]">
            <div class="scene-schedule-form">
                <MudTextField T="string" @bind-Value="_schedTitle" Immediate="true"
                              Class="scene-schedule-title" Margin="Margin.Dense"
                              Variant="Variant.Outlined" Label="@Loc["RolSceneTitleLabel"]" />
                <div class="scene-schedule-when">
                    <MudDatePicker @bind-Date="_schedDate" Label="@Loc["RolSceneDate"]" MinDate="@DateTime.Today"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Class="scene-schedule-date" />
                    <MudTimePicker @bind-Time="_schedTime" Label="@Loc["RolPauseTime"]"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Class="scene-schedule-time" />
                </div>
                <MudTextField T="string" @bind-Value="_schedPitch" Label="@Loc["RolScenePitchLabel"]"
                              HelperText="@Loc["RolScenePitchHint"]" Lines="3"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="scene-schedule-pitch" />
                <MudCheckBox T="bool" @bind-Value="_schedPublic" Dense="true"
                             Class="scene-schedule-public" Label="@Loc["RolSceneLetAnyoneWatch"]" />
                <p class="scene-schedule-hint">@Loc["RolScheduleSceneHint"]</p>
                @if (_scheduleError is not null)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="scene-schedule-error">@_scheduleError</MudAlert>
                }
                <div class="scene-start-buttons">
                    <CapsuleButton Primary="true" Icon="@Icons.Material.Outlined.EditCalendar" Class="scene-schedule-submit"
                                   Disabled="@(string.IsNullOrWhiteSpace(_schedTitle) || _schedDate is null || _schedTime is null || _busy)"
                                   OnClick="ScheduleSceneAsync">@Loc["RolScheduleScene"]</CapsuleButton>
                    <CapsuleButton OnClick="CloseSchedule">@Loc["Cancel"]</CapsuleButton>
                </div>
            </div>
        </KitCard>
    }

    @if (_scheduledNote is not null)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" ShowCloseIcon="true" CloseIconClicked="@(() => _scheduledNote = null)"
                  Class="scene-scheduled-note">@_scheduledNote</MudAlert>
    }

    @if (_loading)
    {
        <div class="scenes-list" aria-busy="true">
            @for (var i = 0; i < 4; i++)
            {
                <SkeletonCard Height="72" />
            }
        </div>
    }
    else if (_filter == ScenesFilter.Mine && _acting is null)
    {
        <EmptyBox Class="scenes-mine-none">@Loc["NavScenesMineNone"]</EmptyBox>
    }
    else if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="scene-list-error">@_error</MudAlert>
    }
    else if (_scenes is null || _scenes.Count == 0)
    {
        <EmptyBox>@Loc["ResNoScenesFound"]</EmptyBox>
    }
    else if (_filter == ScenesFilter.Scheduled)
    {
        <ScheduleAgenda Scenes="_scenes" />
    }
    else
    {
        <div class="scenes-list">
            @foreach (var scene in _scenes)
            {
                <SceneCard @key="scene.Id" Scene="scene" CanJoin="@(_acting is not null)" />
            }
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private bool _starting;
    private bool _busy;
    private string _newTitle = string.Empty;

    /// <summary>Why the last Start did not go out, shown in the form.</summary>
    private string? _startError;

    // Matches the engine's default. Here so the choice is visible when a scene is started, and so
    // the exception can be made without knowing a command.
    private bool _newPublic = true;

    private string _filter = ScenesFilter.All;
    private IReadOnlyList<SceneSummary>? _scenes;
    private string? _error;

    /// <summary>Bumped by every load; only the newest load's answer is shown.</summary>
    private int _loadGeneration;

    /// <summary>The character this tab acts as: whose scenes "Your scenes" lists, and who can join a live one.</summary>
    private AccountAuthService.CharacterSummary? _acting;

    private string Heading => _filter switch
    {
        ScenesFilter.Mine => Loc["NavScenesMine"],
        ScenesFilter.Scheduled => Loc["NavScenesScheduled"],
        ScenesFilter.Finished => Loc["NavScenesFinished"],
        _ => Loc["NavScenesArchiveTitle"],
    };

    private string Description => _filter switch
    {
        ScenesFilter.Mine when _acting is { } acting => string.Format(Loc["NavScenesMineDesc"], acting.Name),
        ScenesFilter.Scheduled => Loc["NavScenesScheduledDesc"],
        ScenesFilter.Finished => Loc["NavScenesFinishedDesc"],
        _ => Loc["ResScenesSubtitle"],
    };

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        AccountAuth.ActiveCharacterChanged += OnActingChanged;
        _filter = ScenesFilter.FromUri(Nav.Uri);
        await AccountAuth.InitAsync();
        _acting = ActingCharacter();
        await LoadAsync();
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        AccountAuth.ActiveCharacterChanged -= OnActingChanged;
    }

    /// <summary>A sidebar link changes only the query, so the page stays mounted and reloads its list.</summary>
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var filter = ScenesFilter.FromUri(e.Location);
        if (filter == _filter) return;
        _filter = filter;
        _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    private void OnActingChanged() => _ = InvokeAsync(async () =>
    {
        _acting = ActingCharacter();
        await LoadAsync();
        StateHasChanged();
    });

    private AccountAuthService.CharacterSummary? ActingCharacter() =>
        AccountAuth.IsLoggedIn ? AccountAuth.ActiveCharacter : null;

    private async Task LoadAsync()
    {
        _loading = true;
        var generation = ++_loadGeneration;
        var filter = _filter;
        (var scenes, var error) = filter switch
        {
            ScenesFilter.Mine when _acting is { } acting => Listed(await SceneService.GetParticipantScenesAsync($"#{acting.DbrefNumber}", ScenesFilter.PageSize)),
            ScenesFilter.Mine => (null, null),
            ScenesFilter.Scheduled or ScenesFilter.Finished => Listed(await SceneService.ListScenesAsync(filter, ScenesFilter.PageSize)),
            _ => Listed(await SceneService.GetRecentScenesAsync(ScenesFilter.PageSize)),
        };

        // A slower answer must not overwrite a newer one: the reader may have left the filter, or — on
        // "Your scenes", where the filter stays the same — switched the character it lists.
        if (generation != _loadGeneration) return;
        (_scenes, _error) = (scenes, error);
        _loading = false;
    }

    /// <summary>What <c>scenefocus()</c> says before a scene was made and after: an id, or a <c>#-1</c> error.</summary>
    private const string FocusedScene = "scenefocus(me)";

    private async Task StartSceneAsync()
    {
        var title = _newTitle.Trim();
        if (title.Length == 0 || _acting is not { } acting) return;

        _busy = true;
        _startError = null;
        try
        {
            // Every command here runs as the character the account session is bound to, and answers this
            // page alone — so the scene is that character's, and whether it was made is a question about
            // that character, not about the roster. Each one names the character the form was started as:
            // if the tab switches character part-way, the server refuses the rest rather than making the
            // other character's scene private.
            //
            // +scene/create focuses the scene it makes, and focus moves only by that character's own
            // commands. A focus that differs after the create from what it was just before is the new
            // scene; an unchanged one means nothing was made, and the create's own output says why.
            var character = $"#{acting.DbrefNumber}:{acting.CreationTime}";
            _startError = await Commands.RunAsync("think", FocusedScene, character) switch
            {
                PortalCommandResponse asked => await CreateSceneAsync(title, asked.Result, character),
                ApiFailure failure => failure.Message,
            };
        }
        finally
        {
            // A send that throws would otherwise leave the form disabled until a page reload.
            _busy = false;
        }
    }

    /// <summary>Runs the create, and answers why no scene came of it, or null when one did.</summary>
    /// <param name="before">What the character was focused on just before.</param>
    /// <param name="character">The objid of the character the form was started as.</param>
    private async Task<string?> CreateSceneAsync(string title, string? before, string character) =>
        await Commands.RunAsync($"+scene/create {title}", FocusedScene, character) switch
        {
            PortalCommandResponse { Result: { } focus } when IsScene(focus) && focus != before => await SceneCreatedAsync(character),
            PortalCommandResponse refused => Refusal(refused, Loc["RolSceneNotStarted"]),
            ApiFailure failure => failure.Message,
        };

    /// <summary>
    /// The new scene is the one in focus, which is what +scene/private acts on — so it goes out only
    /// once a scene is known to have been made, and never onto a scene the character had before.
    /// </summary>
    private async Task<string?> SceneCreatedAsync(string character)
    {
        var error = _newPublic ? null : await MakePrivateAsync(character);

        await LoadAsync();

        // The section sidebar read its counts when the layout mounted, and nothing here remounts it.
        SceneService.ReportChanged();
        _starting = error is not null;
        _newTitle = string.Empty;
        _newPublic = true;
        return error;
    }

    /// <summary>
    /// Runs +scene/private and asks the scene, in the same queue entry, whether it is now private: the
    /// command can refuse in its output, and an answer that came back is not a scene that changed.
    /// </summary>
    private async Task<string?> MakePrivateAsync(string character) =>
        await Commands.RunAsync("+scene/private", $"scene({FocusedScene},public)", character) switch
        {
            PortalCommandResponse { Result: "0" } => null,
            PortalCommandResponse refused => Refusal(refused, Loc["RolSceneNotPrivate"]),
            ApiFailure failure => failure.Message,
        };

    /// <summary>What a command that did not do its job said, or <paramref name="fallback"/> when it said nothing.</summary>
    private static string Refusal(PortalCommandResponse refused, string fallback) =>
        refused.Output.Count > 0 ? string.Join(" ", refused.Output) : fallback;

    private static bool IsScene(string focus) => focus.Length > 0 && !focus.StartsWith("#-1", StringComparison.Ordinal);

    /// <summary>The schedule form is open.</summary>
    private bool _scheduling;
    private string _schedTitle = string.Empty;
    private string _schedPitch = string.Empty;
    private DateTime? _schedDate;
    private TimeSpan? _schedTime;
    private bool _schedPublic = true;

    /// <summary>Why the last Schedule did not go out, shown in the form.</summary>
    private string? _scheduleError;

    /// <summary>A scene was scheduled, but a detail sent after it (pitch, privacy, title) did not take.</summary>
    private string? _scheduledNote;

    /// <summary>The evening slot most scenes are planned for; the reader changes it.</summary>
    private static readonly TimeSpan DefaultScheduleTime = new(20, 0, 0);

    private void OpenSchedule()
    {
        _scheduling = true;
        _scheduleError = null;
        _scheduledNote = null;
        _schedTime ??= DefaultScheduleTime;
    }

    private void CloseSchedule()
    {
        _scheduling = false;
        _scheduleError = null;
        _schedTitle = string.Empty;
        _schedPitch = string.Empty;
        _schedDate = null;
        _schedTime = null;
        _schedPublic = true;
    }

    /// <summary>The chosen date and time as epoch seconds, read in the browser's time zone.</summary>
    private long? ScheduledAt() => _schedDate is { } date && _schedTime is { } time
        ? new DateTimeOffset(DateTime.SpecifyKind(date.Date + time, DateTimeKind.Local)).ToUnixTimeSeconds()
        : null;

    /// <summary>The scenes the character belongs to, which a scene it schedules joins as owner.</summary>
    private const string MemberScenes = "scenelist(mine)";

    /// <summary>
    /// Runs +scene/schedule as the acting character, then the pitch and privacy the form asked for, each on
    /// the new scene by id. Every step names the character the form was opened as, so a tab that switches
    /// character part-way has the rest refused rather than run as someone else.
    /// </summary>
    private async Task ScheduleSceneAsync()
    {
        var title = _schedTitle.Trim();
        if (title.Length == 0 || _acting is not { } acting || ScheduledAt() is not { } at) return;
        if (at <= DateTimeOffset.UtcNow.ToUnixTimeSeconds())
        {
            _scheduleError = Loc["RolScheduleTimePast"];
            return;
        }

        _busy = true;
        _scheduleError = null;
        try
        {
            // +scene/schedule answers only in words, and does not focus the scene it makes. The scene joins
            // the character's own list as its owner, so the new one is the id on that list that was not there
            // just before.
            var character = $"#{acting.DbrefNumber}:{acting.CreationTime}";
            _scheduleError = await Commands.RunAsync("think", MemberScenes, character) switch
            {
                PortalCommandResponse asked => await CreateScheduledAsync(title, at, asked.Result ?? string.Empty, character),
                ApiFailure failure => failure.Message,
            };
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Runs the schedule, and answers why no scene came of it, or null when one did.</summary>
    /// <param name="before">The ids of the character's scenes just before.</param>
    private async Task<string?> CreateScheduledAsync(string title, long at, string before, string character)
    {
        // The verb is `+scene/schedule <title>=<when>` and splits at the first =, so a title carrying one goes
        // out without it and is set whole by +scene/title afterwards, which takes the scene id first.
        var scheduled = MushComposeEncoder.Encode(title.Replace('=', ' ').Trim());
        var known = before.Split(' ', StringSplitOptions.RemoveEmptyEntries).Where(IsSceneId);
        return await Commands.RunAsync($"+scene/schedule {scheduled}={at}",
                NewlyScheduled(known), character) switch
            {
                PortalCommandResponse { Result: { } added } when IsSceneId(added.Trim()) =>
                    await SceneScheduledAsync(added.Trim(), title, character),
                PortalCommandResponse refused => Refusal(refused, Loc["RolSceneNotScheduled"]),
                ApiFailure failure => failure.Message,
            };
    }

    /// <summary>
    /// The ids on the character's list that were not there before and are a scheduled scene it owns: a scene
    /// the character joined from another tab meanwhile also joins the list, but is neither.
    /// </summary>
    private static string NewlyScheduled(IEnumerable<string> before) =>
        $"squish(iter(setdiff({MemberScenes},{string.Join(' ', before)}),if(and(strmatch(scene(##,status),scheduled),strmatch(scene(##,owner),%#)),##)))";

    /// <summary>
    /// Sends what <c>+scene/schedule</c> does not take: the title when it held an =, the pitch, and privacy.
    /// Each is asked back from the scene in the same queue entry, since a verb refuses in its output.
    /// </summary>
    private async Task<string?> SceneScheduledAsync(string id, string title, string character)
    {
        // Privacy goes first: the steps stop at the first that fails, and a scene asked to be private must
        // not stay watchable because a pitch was refused.
        var changes = new List<(string Command, string Result, string Expected)>();
        if (!_schedPublic)
            changes.Add(($"+scene/private {id}", $"scene({id},public)", "0"));
        if (title.Contains('='))
            changes.Add(($"+scene/title {id}={MushComposeEncoder.Encode(title)}", $"scene({id},title)", title));
        var pitch = _schedPitch.Trim();
        if (pitch.Length > 0)
            changes.Add(($"+scene/pitch {id}={MushComposeEncoder.Encode(pitch)}", $"scene({id},summary)", pitch));

        string? note = null;
        foreach (var (command, result, expected) in changes)
        {
            note = await Commands.RunAsync(command, result, character) switch
            {
                PortalCommandResponse { Result: { } value } when Same(value, expected) => null,
                PortalCommandResponse refused => Refusal(refused, Loc["RolSceneNotSaved"]),
                ApiFailure failure => failure.Message,
            };
            if (note is not null) break;
        }

        // The scene exists either way, so the form closes: sending it again would schedule a second one.
        // What did not take is said on the page, and the scene's own page edits it.
        _scheduledNote = note is null ? null : string.Format(Loc["RolSceneScheduledPartly"], note);
        CloseSchedule();
        SceneService.ReportChanged();

        var scheduled = ScenesFilter.Href(ScenesFilter.Scheduled);
        if (_filter == ScenesFilter.Scheduled) await LoadAsync();
        else Nav.NavigateTo(scheduled);
        return null;
    }

    private static bool IsSceneId(string id) => id.Length > 0 && id.All(char.IsAsciiDigit);

    /// <summary>A value read back is the one sent, give or take line endings and the edges' whitespace.</summary>
    private static bool Same(string value, string expected) =>
        string.Equals(value.Replace("\r\n", "\n").Trim(), expected.Replace("\r\n", "\n").Trim(), StringComparison.Ordinal);

    /// <summary>
    /// A list that could not be fetched keeps its reason: "no scenes" and "the archive did not answer"
    /// are different facts, and only one of them is something the portal knows.
    /// </summary>
    private static (IReadOnlyList<SceneSummary>? Scenes, string? Error) Listed(
        ApiResult<IReadOnlyList<SceneSummary>> result) => result switch
    {
        IReadOnlyList<SceneSummary> scenes => (scenes, null),
        ApiFailure failure => (null, failure.Message),
    };
}
