@page "/scenes"
@layout ScenesLayout
@using SharpMUSH.Client.Components.Scenes
@inject IStringLocalizer<SharedResource> Loc
@inject SceneService SceneService
@inject GameCommandService Commands
@inject AccountAuthService AccountAuth
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>@Loc["SceneArchive"] — @Loc["AppTitle"]</PageTitle>

@* The scene archive in the D1 kit: the plain header with Start scene, and the scenes as cards. Which
   scenes is the address the sidebar links to (ScenesFilter): every scene, the acting character's
   (?mine=1), the scheduled ones (as an agenda by day and time) or the finished ones. The live list is its own page, /scenes/active. *@
<div class="scenes-page">
    <PlainPageHeader Kicker="@Loc["SceneArchive"]" Title="@Heading" Description="@Description">
        <Actions>
            @* Starting a scene runs +scene/create as the character this tab acts as (POST api/commands),
               so it is offered only while one is. No terminal is needed: the command answers the page. *@
            @if (_acting is not null && !_starting)
            {
                <div class="scene-start">
                    <CapsuleButton Primary="true" Icon="@Icons.Material.Outlined.Add" OnClick="@(() => _starting = true)">@Loc["RolStartScene"]</CapsuleButton>
                </div>
            }
        </Actions>
    </PlainPageHeader>

    @if (_acting is not null && _starting)
    {
        <KitCard Class="scene-start" Title="@Loc["RolStartScene"]">
            <div class="scene-start-form">
                <MudTextField T="string" @bind-Value="_newTitle" Immediate="true"
                              Class="scene-start-title" Margin="Margin.Dense"
                              Variant="Variant.Outlined" Label="@Loc["RolSceneTitleLabel"]" />
                <MudCheckBox T="bool" @bind-Value="_newPublic" Dense="true"
                             Class="scene-start-public" Label="@Loc["RolSceneLetAnyoneWatch"]" />
                @if (_startError is not null)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="scene-start-error">@_startError</MudAlert>
                }
                <div class="scene-start-buttons">
                    <CapsuleButton Primary="true" Class="scene-start-submit"
                                   Disabled="@(string.IsNullOrWhiteSpace(_newTitle) || _busy)"
                                   OnClick="StartSceneAsync">@Loc["RolStartScene"]</CapsuleButton>
                    <CapsuleButton OnClick="@(() => { _starting = false; _newTitle = string.Empty; })">@Loc["Cancel"]</CapsuleButton>
                </div>
            </div>
        </KitCard>
    }

    @if (_loading)
    {
        <div class="scenes-list" aria-busy="true">
            @for (var i = 0; i < 4; i++)
            {
                <SkeletonCard Height="72" />
            }
        </div>
    }
    else if (_filter == ScenesFilter.Mine && _acting is null)
    {
        <EmptyBox Class="scenes-mine-none">@Loc["NavScenesMineNone"]</EmptyBox>
    }
    else if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="scene-list-error">@_error</MudAlert>
    }
    else if (_scenes is null || _scenes.Count == 0)
    {
        <EmptyBox>@Loc["ResNoScenesFound"]</EmptyBox>
    }
    else if (_filter == ScenesFilter.Scheduled)
    {
        <ScheduleAgenda Scenes="_scenes" />
    }
    else
    {
        <div class="scenes-list">
            @foreach (var scene in _scenes)
            {
                <SceneCard @key="scene.Id" Scene="scene" CanJoin="@(_acting is not null)" />
            }
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private bool _starting;
    private bool _busy;
    private string _newTitle = string.Empty;

    /// <summary>Why the last Start did not go out, shown in the form.</summary>
    private string? _startError;

    // Matches the engine's default. Here so the choice is visible when a scene is started, and so
    // the exception can be made without knowing a command.
    private bool _newPublic = true;

    private string _filter = ScenesFilter.All;
    private IReadOnlyList<SceneSummary>? _scenes;
    private string? _error;

    /// <summary>Bumped by every load; only the newest load's answer is shown.</summary>
    private int _loadGeneration;

    /// <summary>The character this tab acts as: whose scenes "Your scenes" lists, and who can join a live one.</summary>
    private AccountAuthService.CharacterSummary? _acting;

    private string Heading => _filter switch
    {
        ScenesFilter.Mine => Loc["NavScenesMine"],
        ScenesFilter.Scheduled => Loc["NavScenesScheduled"],
        ScenesFilter.Finished => Loc["NavScenesFinished"],
        _ => Loc["NavScenesArchiveTitle"],
    };

    private string Description => _filter switch
    {
        ScenesFilter.Mine when _acting is { } acting => string.Format(Loc["NavScenesMineDesc"], acting.Name),
        ScenesFilter.Scheduled => Loc["NavScenesScheduledDesc"],
        ScenesFilter.Finished => Loc["NavScenesFinishedDesc"],
        _ => Loc["ResScenesSubtitle"],
    };

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        AccountAuth.ActiveCharacterChanged += OnActingChanged;
        _filter = ScenesFilter.FromUri(Nav.Uri);
        await AccountAuth.InitAsync();
        _acting = ActingCharacter();
        await LoadAsync();
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        AccountAuth.ActiveCharacterChanged -= OnActingChanged;
    }

    /// <summary>A sidebar link changes only the query, so the page stays mounted and reloads its list.</summary>
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var filter = ScenesFilter.FromUri(e.Location);
        if (filter == _filter) return;
        _filter = filter;
        _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    private void OnActingChanged() => _ = InvokeAsync(async () =>
    {
        _acting = ActingCharacter();
        await LoadAsync();
        StateHasChanged();
    });

    private AccountAuthService.CharacterSummary? ActingCharacter() =>
        AccountAuth.IsLoggedIn ? AccountAuth.ActiveCharacter : null;

    private async Task LoadAsync()
    {
        _loading = true;
        var generation = ++_loadGeneration;
        var filter = _filter;
        (var scenes, var error) = filter switch
        {
            ScenesFilter.Mine when _acting is { } acting => Listed(await SceneService.GetParticipantScenesAsync($"#{acting.DbrefNumber}", ScenesFilter.PageSize)),
            ScenesFilter.Mine => (null, null),
            ScenesFilter.Scheduled or ScenesFilter.Finished => Listed(await SceneService.ListScenesAsync(filter, ScenesFilter.PageSize)),
            _ => Listed(await SceneService.GetRecentScenesAsync(ScenesFilter.PageSize)),
        };

        // A slower answer must not overwrite a newer one: the reader may have left the filter, or — on
        // "Your scenes", where the filter stays the same — switched the character it lists.
        if (generation != _loadGeneration) return;
        (_scenes, _error) = (scenes, error);
        _loading = false;
    }

    /// <summary>What <c>scenefocus()</c> says before a scene was made and after: an id, or a <c>#-1</c> error.</summary>
    private const string FocusedScene = "scenefocus(me)";

    private async Task StartSceneAsync()
    {
        var title = _newTitle.Trim();
        if (title.Length == 0 || _acting is not { } acting) return;

        _busy = true;
        _startError = null;
        try
        {
            // Every command here runs as the character the account session is bound to, and answers this
            // page alone — so the scene is that character's, and whether it was made is a question about
            // that character, not about the roster. Each one names the character the form was started as:
            // if the tab switches character part-way, the server refuses the rest rather than making the
            // other character's scene private.
            //
            // +scene/create focuses the scene it makes, and focus moves only by that character's own
            // commands. A focus that differs after the create from what it was just before is the new
            // scene; an unchanged one means nothing was made, and the create's own output says why.
            var character = $"#{acting.DbrefNumber}:{acting.CreationTime}";
            _startError = await Commands.RunAsync("think", FocusedScene, character) switch
            {
                PortalCommandResponse asked => await CreateSceneAsync(title, asked.Result, character),
                ApiFailure failure => failure.Message,
            };
        }
        finally
        {
            // A send that throws would otherwise leave the form disabled until a page reload.
            _busy = false;
        }
    }

    /// <summary>Runs the create, and answers why no scene came of it, or null when one did.</summary>
    /// <param name="before">What the character was focused on just before.</param>
    /// <param name="character">The objid of the character the form was started as.</param>
    private async Task<string?> CreateSceneAsync(string title, string? before, string character) =>
        await Commands.RunAsync($"+scene/create {title}", FocusedScene, character) switch
        {
            PortalCommandResponse { Result: { } focus } when IsScene(focus) && focus != before => await SceneCreatedAsync(character),
            PortalCommandResponse refused => Refusal(refused, Loc["RolSceneNotStarted"]),
            ApiFailure failure => failure.Message,
        };

    /// <summary>
    /// The new scene is the one in focus, which is what +scene/private acts on — so it goes out only
    /// once a scene is known to have been made, and never onto a scene the character had before.
    /// </summary>
    private async Task<string?> SceneCreatedAsync(string character)
    {
        var error = _newPublic ? null : await MakePrivateAsync(character);

        await LoadAsync();

        // The section sidebar read its counts when the layout mounted, and nothing here remounts it.
        SceneService.ReportChanged();
        _starting = error is not null;
        _newTitle = string.Empty;
        _newPublic = true;
        return error;
    }

    /// <summary>
    /// Runs +scene/private and asks the scene, in the same queue entry, whether it is now private: the
    /// command can refuse in its output, and an answer that came back is not a scene that changed.
    /// </summary>
    private async Task<string?> MakePrivateAsync(string character) =>
        await Commands.RunAsync("+scene/private", $"scene({FocusedScene},public)", character) switch
        {
            PortalCommandResponse { Result: "0" } => null,
            PortalCommandResponse refused => Refusal(refused, Loc["RolSceneNotPrivate"]),
            ApiFailure failure => failure.Message,
        };

    /// <summary>What a command that did not do its job said, or <paramref name="fallback"/> when it said nothing.</summary>
    private static string Refusal(PortalCommandResponse refused, string fallback) =>
        refused.Output.Count > 0 ? string.Join(" ", refused.Output) : fallback;

    private static bool IsScene(string focus) => focus.Length > 0 && !focus.StartsWith("#-1", StringComparison.Ordinal);

    /// <summary>
    /// A list that could not be fetched keeps its reason: "no scenes" and "the archive did not answer"
    /// are different facts, and only one of them is something the portal knows.
    /// </summary>
    private static (IReadOnlyList<SceneSummary>? Scenes, string? Error) Listed(
        ApiResult<IReadOnlyList<SceneSummary>> result) => result switch
    {
        IReadOnlyList<SceneSummary> scenes => (scenes, null),
        ApiFailure failure => (null, failure.Message),
    };
}
