<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<!-- NU1510: transitive dependency pinning; NU1702: BlazorMonaco targets net9 but is WASM/JS, fully compatible -->
		<NoWarn>NU1510;NU1702</NoWarn>
		<!-- IL trimming is safe now that the client no longer references the server-side
		     SharpMUSH.Library or its TelnetNegotiationCore dependency. -->
		<PublishTrimmed>true</PublishTrimmed>
		<!-- Full ICU. Blazor ships one of four prebuilt CLDR shards and they do not compose; the
		     portal's target locales span all three partial sets (de/es/fr are EFIGS, most of the rest
		     are no_CJK, zh-Hans is CJK), so no partial shard covers them. ~1 MB more than EFIGS,
		     fetched once and cached. See docs/localization/adding-languages.md.
		     This is not a completeness nicety: the shard governs CultureInfo, not resource lookup.
		     Satellite assemblies resolve regardless, so on a sharded build an unshard-covered locale
		     renders fully translated and still formats its dates and numbers in English, with no test
		     failing. AdminRoles.razor's ToString("MMM d, yyyy HH:mm") is exactly that case. -->
		<BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
		<!-- Satellite assemblies for every locale PortalLocales.Codes offers. Without this,
		     PublishTrimmed can drop resources the app only reaches by culture lookup at runtime — a
		     failure that appears only in a published build, so no Debug-configuration test sees it.
		     PortalSurfacesTests keeps this list and PortalLocales.Codes in step. -->
		<SatelliteResourceLanguages>en;bg;da;de;es;fr;hr;hu;nb;nl;pl;pt-BR;ro;ru;sv;zh-Hans</SatelliteResourceLanguages>
	</PropertyGroup>

	<ItemGroup>
		<!-- Compiled plugin Blazor components (gated, off-by-default; see
		     docs/superpowers/specs/2026-06-22-plugin-wasm-components-design.md) are Assembly.Load()ed at
		     runtime, so the trimmer cannot see what they use. Root the shared UI surface a plugin
		     component compiles against — the component-model assemblies, MudBlazor, and the app's own
		     contract/markup assemblies — so trimming never strips members those components rely on.
		     The BCL stays trimmed: a plugin needing an exotic BCL member is the accepted residual risk. -->
		<TrimmerRootAssembly Include="Microsoft.AspNetCore.Components" />
		<TrimmerRootAssembly Include="Microsoft.AspNetCore.Components.Web" />
		<TrimmerRootAssembly Include="Microsoft.AspNetCore.Components.Forms" />
		<TrimmerRootAssembly Include="Microsoft.JSInterop" />
		<TrimmerRootAssembly Include="MudBlazor" />
		<TrimmerRootAssembly Include="SharpMUSH.Contracts" />
		<TrimmerRootAssembly Include="MarkupString" />
		<TrimmerRootAssembly Include="MarkupString.Ansi" />
		<TrimmerRootAssembly Include="MarkupString.Html" />

		<!-- Widget config models: reflected over by JsonSerializer and WidgetConfigSchema, including
		     list element types the trimmer cannot follow. See the file's own comment. -->
		<TrimmerRootDescriptor Include="ILLink.Descriptors.xml" />
	</ItemGroup>

	<ItemGroup>
		<!-- Content-hash the portal's own scripts so the server can let browsers keep them for a year
		     (MapStaticAssets serves a fingerprinted route as immutable). index.html names them as
		     js/name#[.{fingerprint}].js and OverrideHtmlAssetPlaceholders writes the hash in on build;
		     without this pattern a publish only strips the marker. JS only: the SDK task that resolves
		     the markers considers .js/.mjs endpoints and nothing else, so the stylesheets stay unhashed
		     and revalidate. The fingerprint is part of the file name on disk; the plain name
		     (js/mermaid.min.js, which lazy-assets.js loads) remains a route in the endpoints manifest,
		     so a server must serve the portal through that manifest (PortalStaticFiles). -->
		<StaticWebAssetFingerprintPattern Include="JSModule" Pattern="*.js" Expression="#[.{fingerprint}]!" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="BlazorMonaco" Version="3.5.0" />
		<PackageReference Include="MessageFormat" Version="8.0.0" />
		<!-- AuthenticationStateProvider / CascadingAuthenticationState / [Authorize] on routable
		     components. Referenced directly: it used to arrive transitively through
		     Microsoft.AspNetCore.Components.WebAssembly.Authentication, which was only ever needed by
		     the OIDC RemoteAuthenticatorView page and went away with it. -->
		<PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="$(DotNetPackageVersion)" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(DotNetPackageVersion)" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="$(DotNetPackageVersion)" PrivateAssets="all" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="$(DotNetPackageVersion)" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="$(DotNetPackageVersion)" />
		<PackageReference Include="MudBlazor" Version="9.9.0" />
		<PackageReference Include="System.Private.Uri" Version="4.3.2" />
		<PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Include="Components\WikiDisplay.razor" />
		<AdditionalFiles Include="Components\WikiEdit.razor" />
		<AdditionalFiles Include="Components\WikiView.razor" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SharpMUSH.Configuration\SharpMUSH.Configuration.csproj" />
		<ProjectReference Include="..\SharpMUSH.Contracts\SharpMUSH.Contracts.csproj" />
		<PackageReference Include="MarkupString" Version="$(MarkupStringVersion)" />
		<PackageReference Include="MarkupString.Ansi" Version="$(MarkupStringVersion)" />
		<PackageReference Include="MarkupString.Html" Version="$(MarkupStringVersion)" />
	</ItemGroup>

	<!-- The softcode editor's data files (data/mush-defs.json, data/mush-functions.json,
	     data/mush-commands.json) are built by tools/ClientData from the [SharpFunction]/[SharpCommand]
	     attributes and the shipped helpfiles, into wwwroot/data, which .gitignore leaves out. They are
	     not checked in: a checked-in copy went stale with every help change and conflicted on every
	     merge. -->
	<PropertyGroup>
		<ClientDataHelpfiles>$(MSBuildThisFileDirectory)..\SharpMUSH.Documentation\Helpfiles\SharpMUSH</ClientDataHelpfiles>
	</PropertyGroup>

	<ItemGroup>
		<!-- Built, never referenced: its output lands in @(ClientDataTool), the way an analyzer's does. -->
		<ProjectReference Include="..\tools\ClientData\ClientData.csproj" ReferenceOutputAssembly="false" Private="false"
			OutputItemType="ClientDataTool" SkipGetTargetFrameworkProperties="true" />
	</ItemGroup>

	<Target Name="ResolveClientDataInputs" DependsOnTargets="ResolveProjectReferences">
		<PropertyGroup>
			<ClientDataTool>@(ClientDataTool)</ClientDataTool>
			<ClientDataOutput>$(MSBuildProjectDirectory)\wwwroot\data\</ClientDataOutput>
			<ClientDataHost>$(DOTNET_HOST_PATH)</ClientDataHost>
			<ClientDataHost Condition="'$(ClientDataHost)' == ''">dotnet</ClientDataHost>
		</PropertyGroup>
		<!-- Every helpfile, every assembly beside the tool (an attribute change rebuilds the
		     implementation without relinking the tool), and a list of the helpfile names, which
		     changes when one is added or deleted. -->
		<ItemGroup>
			<_ClientDataHelpfile Include="$(ClientDataHelpfiles)\**\*.md" />
		</ItemGroup>
		<WriteLinesToFile File="$(IntermediateOutputPath)clientdata.inputs" Lines="@(_ClientDataHelpfile)"
			Overwrite="true" WriteOnlyWhenDifferent="true" />
		<ItemGroup>
			<FileWrites Include="$(IntermediateOutputPath)clientdata.inputs" />
			<_ClientDataInput Include="@(_ClientDataHelpfile);$(IntermediateOutputPath)clientdata.inputs" />
			<_ClientDataInput Include="$([System.IO.Path]::GetDirectoryName('$(ClientDataTool)'))\*.dll" />
		</ItemGroup>
	</Target>

	<Target Name="GenerateClientData" DependsOnTargets="ResolveClientDataInputs" Condition="'$(NoBuild)' != 'true'"
		Inputs="@(_ClientDataInput)"
		Outputs="$(ClientDataOutput)mush-defs.json;$(ClientDataOutput)mush-functions.json;$(ClientDataOutput)mush-commands.json">
		<Exec Command="&quot;$(ClientDataHost)&quot; &quot;$(ClientDataTool)&quot; &quot;$(ClientDataHelpfiles)&quot; &quot;$(ClientDataOutput.TrimEnd('\'))&quot;" />
	</Target>

	<Target Name="IncludeClientData" DependsOnTargets="GenerateClientData" BeforeTargets="ResolveProjectStaticWebAssets"
		Condition="'$(NoBuild)' != 'true'">
		<ItemGroup>
			<!-- On a clean checkout the files did not exist when wwwroot/** was globbed into Content. -->
			<_ClientDataFile Include="wwwroot\data\mush-defs.json;wwwroot\data\mush-functions.json;wwwroot\data\mush-commands.json" />
			<Content Remove="@(_ClientDataFile)" />
			<Content Include="@(_ClientDataFile)" />
			<FileWrites Include="@(_ClientDataFile)" />
		</ItemGroup>
	</Target>

</Project>
