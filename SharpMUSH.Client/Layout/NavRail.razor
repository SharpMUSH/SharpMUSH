@using SharpMUSH.Client.Services
@using SharpMUSH.Client.Models.Applications
@using SharpMUSH.Library.Authorization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using SharpMUSH.Library.Models.Portal.Navigation
@inject IStringLocalizer<SharedResource> Loc
@inject ITerminalService Terminal
@inject IPlayTerminalService PlayTerminal
@inject NavigationManager Nav
@inject ApplicationRegistryClient Registry
@inject ServerInfoService ServerInfo
@inject IAuthorizationService Authorization
@inject PortalNavigation Navigation
@inject IJSRuntime JS
@implements IDisposable

@* D1 §3 rail (desktop): 72px, the logo (the link home), the game's navigation groups (PortalNavigation:
   an inline group is a labelled list with one icon per destination, a section group one icon for its first
   destination, a pop-out group one button opening its list beside the rail; the groups scroll when the rail is
   too short for them, and the current page's button is scrolled into view), then Build & manage when anything in it is visible to the viewer, search (the
   command palette), the terminal toggle, the language, and the account. Each item is 44×44, radius 14; the
   current section is filled --surface-2 with an accent icon and carries aria-current="page". Mobile hides
   the rail and keeps the drawer (NavMenu) and bottom tab bar. *@
<nav class="phosphor-rail" aria-label="@Loc["NavSections"]">
    <a href="/" class="phosphor-rail-logo @(IsHome ? "phosphor-rail-logo--on" : null)"
       aria-current="@(IsHome ? "page" : null)" aria-label="@HomeLabel" title="@HomeLabel">
        <GameLogo />
    </a>
    <div class="phosphor-rail-sep" aria-hidden="true"></div>

    <ul class="phosphor-rail-groups" @ref="_groupList">
        @for (var i = 0; i < _nav.Groups.Count; i++)
        {
            var group = _nav.Groups[i];
            <li class="phosphor-rail-group" data-group="@group.Id" @key="group.Id">
                @if (group.Mode == NavGroupModes.Inline)
                {
                    <span class="phosphor-rail-group-label" aria-hidden="true">@group.Label</span>
                    <ul class="phosphor-rail-group-items" aria-label="@group.Label">
                        @foreach (var item in group.Items)
                        {
                            <li @key="item.Key">@Destination(item)</li>
                        }
                    </ul>
                }
                else if (group.Mode == NavGroupModes.Flyout)
                {
                    <NavRailFlyout Group="group" Icon="@(group.OwnIcon ? group.OutlineIcon : null)" Path="@_path" />
                }
                else
                {
                    @Item(group.Items[0].Href, group.OutlineIcon, group.Label, group.IsCurrent(_path))
                }
            </li>
        }
    </ul>

    @if (_build.Count > 0)
    {
        <a href="@_build[0].Href" class="phosphor-rail-item phosphor-rail-build @(IsBuildSection ? "phosphor-rail-item--on" : null)"
           aria-current="@(IsBuildSection ? "page" : null)" aria-label="@Loc["NavBuildManage"]" title="@Loc["NavBuildManage"]">
            <MudIcon Icon="@Icons.Material.Outlined.Construction" />
        </a>
    }
    <button type="button" class="phosphor-rail-item phosphor-rail-search" aria-label="@Loc["NavSearchOpen"]" title="@Loc["NavSearchOpen"]"
            aria-haspopup="dialog" @onclick="OnSearch">
        <MudIcon Icon="@Icons.Material.Outlined.Search" />
    </button>
    <button type="button" class="phosphor-rail-item phosphor-rail-terminal @(TerminalOpen ? "phosphor-rail-item--on" : null)"
            aria-pressed="@(TerminalOpen ? "true" : "false")" aria-label="@Loc["NavCommandTerminal"]" title="@Loc["NavCommandTerminal"]"
            @onclick="OnToggleTerminal">
        <MudIcon Icon="@Icons.Material.Outlined.Terminal" />
    </button>
    <div class="phosphor-rail-lang"><LanguagePicker AnchorOrigin="Origin.CenterRight" TransformOrigin="Origin.CenterLeft" /></div>
    <AccountButton Compact="true" />
</nav>

@code {
    /// <summary>Whether the command terminal drawer is open (the toggle shows pressed).</summary>
    [Parameter] public bool TerminalOpen { get; set; }
    [Parameter] public EventCallback OnToggleTerminal { get; set; }

    /// <summary>Opens the command palette.</summary>
    [Parameter] public EventCallback OnSearch { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private ResolvedNav _nav = ResolvedNav.Empty;

    // The groups list scrolls; after a render that changed the page or the groups, layout.js scrolls the
    // current page's button into view.
    private ElementReference _groupList;
    private bool _reveal = true;
    private IReadOnlyList<BuildNavCatalog.Entry> _build = [];
    private IReadOnlyList<PortalApplication> _buildApps = [];
    private bool _playActive;
    private bool _playUnread;
    private string _gameName = "SharpMUSH";
    private string _path = "/";

    private static readonly string PlayKey = NavKeys.Core("play");

    private string HomeLabel => $"{_gameName} · {Loc["Home"]}";

    private string PlayLabel(string label) => _playActive
        ? $"{label} · {(_playUnread ? Loc["NavPlayUnreadActivity"] : Loc["NavPlaySessionActive"])}"
        : label;

    private RenderFragment Item(string href, string icon, string label, bool current) =>
        @<a href="@href" class="phosphor-rail-item @(current ? "phosphor-rail-item--on" : null)"
            aria-current="@(current ? "page" : null)" aria-label="@label" title="@label">
            <MudIcon Icon="@icon" />
        </a>;

    /// <summary>
    /// One destination's button. Play carries the session dot; a link to another site opens in a new tab.
    /// </summary>
    private RenderFragment Destination(NavDestination item)
    {
        var current = item.IsCurrent(_path);
        if (item.External)
        {
            return @<a href="@item.Href" class="phosphor-rail-item" target="_blank" rel="noopener"
                       aria-label="@item.Label" title="@item.Label">
                <MudIcon Icon="@item.OutlineIcon" />
            </a>;
        }
        if (!string.Equals(item.Key, PlayKey, StringComparison.OrdinalIgnoreCase))
        {
            return Item(item.Href, item.OutlineIcon, item.Label, current);
        }
        var label = PlayLabel(item.Label);
        return @<a href="@item.Href" class="phosphor-rail-item @(current ? "phosphor-rail-item--on" : null)"
                   aria-current="@(current ? "page" : null)" aria-label="@label" title="@label">
            <MudIcon Icon="@item.OutlineIcon" />
            @if (_playActive)
            {
                <span class="phosphor-rail-dot @(_playUnread ? "phosphor-rail-dot--unread" : null)" aria-hidden="true"></span>
            }
        </a>;
    }

    private bool IsHome => _path == "/";

    private bool IsUnder(string prefix) =>
        _path.Equals(prefix, StringComparison.OrdinalIgnoreCase)
        || _path.StartsWith(prefix + "/", StringComparison.OrdinalIgnoreCase);

    /// <summary>The Build &amp; manage section: its catalogue pages and its applications.</summary>
    private bool IsBuildSection =>
        IsUnder("/admin") || IsUnder("/softcode") || _buildApps.Any(a => IsUnder($"/apps/{a.Slug}"));

    protected override void OnInitialized()
    {
        ServerInfo.Changed += OnServerInfoChanged;
        Navigation.Changed += OnNavigationChanged;
        Terminal.ConnectionStateChanged += OnConnectionChanged;
        _playActive = PlayTerminal.IsConnected;
        PlayTerminal.ConnectionStateChanged += OnPlayConnectionChanged;
        PlayTerminal.LineReceived += OnPlayLine;
        Nav.LocationChanged += OnLocationChanged;
        Locate();
    }

    private Task<AuthenticationState>? _gatesFor;
    private bool _gatesKnown;

    protected override async Task OnParametersSetAsync()
    {
        // The gates depend only on who is signed in; a parent re-render (a terminal toggle, a palette opening)
        // passes new callbacks and would otherwise re-ask every policy. A sign-in or sign-out cascades a new
        // AuthState and recomputes them.
        if (_gatesKnown && ReferenceEquals(AuthState, _gatesFor)) return;
        (_gatesFor, _gatesKnown) = (AuthState, true);
        await LoadAsync();
    }

    protected override async Task OnInitializedAsync() => _gameName = await ServerInfo.GameNameAsync();

    private async Task LoadAsync()
    {
        var user = AuthState is null ? new System.Security.Claims.ClaimsPrincipal() : (await AuthState).User;
        _nav = await Navigation.ResolveAsync(user);
        _reveal = true;
        _build = await BuildNavCatalog.VisibleAsync(Authorization, user, ServerInfo);
        var apps = await Registry.ListAsync();
        _buildApps = [.. PortalNavSections.AppsForSection(apps, user, "Build"), .. PortalNavSections.AppsForSection(apps, user, "Manage")];
    }

    private void Locate()
    {
        var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
        _path = path.Length == 0 ? "/" : path;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(() =>
    {
        Locate();
        _reveal = true;
        if (IsUnder("/play")) _playUnread = false;
        StateHasChanged();
    });

    /// <summary>Mail is there only while a character is connected.</summary>
    private void OnConnectionChanged(bool connected) => _ = InvokeAsync(ReloadAsync);

    /// <summary>Staff in this tab saved the layout.</summary>
    private void OnNavigationChanged() => _ = InvokeAsync(ReloadAsync);

    private async Task ReloadAsync()
    {
        await LoadAsync();
        StateHasChanged();
    }

    private void OnPlayConnectionChanged(bool connected) => InvokeAsync(() =>
    {
        _playActive = connected;
        if (!connected) _playUnread = false;
        StateHasChanged();
    });

    private void OnPlayLine(TerminalLine _) => InvokeAsync(() =>
    {
        if (IsUnder("/play")) return;
        _playUnread = true;
        StateHasChanged();
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_reveal) return;
        _reveal = false;
        try
        {
            await JS.InvokeVoidAsync("sharpmushLayout.revealRailCurrent", _groupList);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or JSDisconnectedException)
        {
            // No layout script (a test): the list stays where it is.
        }
    }

    public void Dispose()
    {
        Terminal.ConnectionStateChanged -= OnConnectionChanged;
        PlayTerminal.ConnectionStateChanged -= OnPlayConnectionChanged;
        PlayTerminal.LineReceived -= OnPlayLine;
        Nav.LocationChanged -= OnLocationChanged;
        ServerInfo.Changed -= OnServerInfoChanged;
        Navigation.Changed -= OnNavigationChanged;
    }

    /// <summary>
    /// A newer server answer (the guest roster, the game's name or its applications changed): the brand, the
    /// destinations and the Build &amp; manage entries follow it.
    /// </summary>
    private void OnServerInfoChanged() => _ = InvokeAsync(async () =>
    {
        _gameName = await ServerInfo.GameNameAsync();
        await LoadAsync();
        StateHasChanged();
    });
}
