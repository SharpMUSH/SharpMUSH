@inherits LayoutComponentBase
@layout MainLayout
@using SharpMUSH.Client.Components.Wiki
@inject IStringLocalizer<SharedResource> Loc

@* The wiki pages (/wiki, a page, its history, recent changes, a category): the D1 page sidebar
   beside the page body. Phase 1 moves the sidebar into the shell's page-sidebar slot. *@
<SectionShell Class="wiki-shell" NavLabel="@Loc["Wiki"]">
    <Nav><WikiSidebar /></Nav>
    <ChildContent>@Body</ChildContent>
</SectionShell>
