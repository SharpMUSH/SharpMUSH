@using SharpMUSH.Client.Services
@inject IStringLocalizer<SharedResource> Loc
@inject CharacterSessionRegistry Sessions
@inject AccountAuthService AccountAuth
@inject CharacterSwitchService CharacterSwitch
@inject ClientCharacters ClientCharacters
@inject ServerInfoService ServerInfo
@inject ISnackbar Snackbar
@implements IDisposable

@* The client's rail: the account's characters, the one in front ringed in the accent, each with a status dot and,
   while another is in front, its unread count (or a dot for new lines), the way a chat app lists its servers. A
   click brings one to the front, connecting it first when it is not. On a desktop it stands where the site rail
   stands (the logo still goes home); on a phone (Strip) it is a row at the top of Play's menu. *@
@if (Strip)
{
    <div class="client-strip" role="group" aria-label="@Loc["NavClientCharacters"]">
        <span class="client-strip-label" aria-hidden="true">@Loc["NavClientCharacters"]</span>
        <div class="client-strip-row">
            @foreach (var entry in Entries())
            {
                @Item(entry)
            }
        </div>
    </div>
}
else
{
    <nav class="phosphor-rail client-rail" aria-label="@Loc["NavClientCharacters"]">
        <a href="/" class="phosphor-rail-logo" aria-label="@HomeLabel" title="@HomeLabel">
            <GameLogo />
        </a>
        <div class="phosphor-rail-sep" aria-hidden="true"></div>
        <ul class="client-rail-list">
            @foreach (var entry in Entries())
            {
                <li @key="entry.Key">@Item(entry)</li>
            }
        </ul>
        <AccountButton Compact="true" />
    </nav>
}

@code {
    /// <summary>A row at the top of Play's menu on a phone, instead of the desktop rail.</summary>
    [Parameter] public bool Strip { get; set; }

    private readonly HashSet<CharacterSession> _watched = [];
    private bool _busy;

    /// <summary>The last portrait clicked while a switch was under way, brought forward once it is done.</summary>
    private Entry? _next;
    private string _gameName = "SharpMUSH";

    private string HomeLabel => $"{_gameName} · {Loc["Home"]}";

    /// <summary>One portrait: an account character, with the session playing it once it has one.</summary>
    private sealed record Entry(AccountAuthService.CharacterSummary? Character, CharacterSession? Session)
    {
        public object Key => (object?)Character?.Objid ?? Session!;
    }

    protected override async Task OnInitializedAsync()
    {
        Sessions.Changed += OnSessionsChanged;
        AccountAuth.RosterChanged += OnRosterChanged;
        Watch();
        _gameName = await ServerInfo.GameNameAsync();
    }

    /// <summary>
    /// The account's characters in its order, then any session playing no character of it (a guest, a typed login).
    /// </summary>
    private IEnumerable<Entry> Entries()
    {
        var shown = ClientCharacters.Shown;
        foreach (var character in shown) yield return new Entry(character, SessionOf(character));
        foreach (var session in Sessions.Sessions)
        {
            var character = CharacterOf(session);
            if (character is null || shown.All(other => other.Objid != character.Objid)) yield return new Entry(character, session);
        }
    }

    private RenderFragment Item(Entry entry) => __builder =>
    {
        var session = entry.Session;
        var character = entry.Character;
        var front = session is not null && ReferenceEquals(session, Sessions.Focused);
        var name = character?.Name ?? session?.Terminal.ConnectedPlayerName ?? string.Empty;
        var connected = session?.Terminal.IsConnected ?? false;
        var unread = front || session is null ? 0 : Unread(session);
        var unseen = !front && unread == 0 && session is { Unseen: > 0 };
        <button type="button"
                class="client-char @(front ? "client-char--on" : null) @(connected ? null : "client-char--off")"
                aria-current="@(front ? "true" : null)" aria-label="@Label(name, connected, unread, unseen)" title="@name"
                @onclick="() => FocusAsync(entry)">
            <CharacterAvatar Class="client-char-pic" Name="@name" Character="@(character?.Objid)" />
            <span class="client-char-dot" aria-hidden="true"></span>
            @if (unread > 0)
            {
                <span class="client-char-count" aria-hidden="true">@(unread > 99 ? "99+" : unread.ToString())</span>
            }
            else if (unseen)
            {
                <span class="client-char-new" aria-hidden="true"></span>
            }
        </button>
    };

    private string Label(string name, bool connected, int unread, bool unseen)
    {
        var parts = new List<string> { name, connected ? Loc["Connected"] : Loc["Disconnected"] };
        if (unread > 0) parts.Add(Loc.Plural("NavUnreadCount", "count", unread));
        else if (unseen) parts.Add(Loc["NavClientNewLines"]);
        return string.Join(" · ", parts);
    }

    private static int Unread(CharacterSession session) =>
        session.Comms.Channels.Where(channel => channel.Joined).Sum(channel => channel.Unread)
        + session.Comms.Conversations.Sum(conversation => conversation.Unread);

    /// <summary>The account's character a session plays; the acting one for the session in front before it connects.</summary>
    private AccountAuthService.CharacterSummary? CharacterOf(CharacterSession session) =>
        session.Identity is { } identity
            ? AccountAuth.Characters.FirstOrDefault(character => character.Objid == identity.Character)
            : ReferenceEquals(session, Sessions.Focused) ? AccountAuth.ActiveCharacter : null;

    private CharacterSession? SessionOf(AccountAuthService.CharacterSummary character) =>
        Sessions.Sessions.FirstOrDefault(session => CharacterOf(session) is { } playing && playing.Objid == character.Objid);

    /// <summary>
    /// Brings an entry to the front: the tab acts as its character from then on, connected first when it has no session.
    /// A click while a switch is under way waits for it, and only the last such click is kept.
    /// </summary>
    private async Task FocusAsync(Entry entry)
    {
        if (_busy)
        {
            _next = entry;
            return;
        }

        _busy = true;
        try
        {
            for (var current = entry; current is not null; current = TakeNext()) await BringForwardAsync(current);
        }
        finally
        {
            _busy = false;
            _next = null;
        }
    }

    private Entry? TakeNext()
    {
        var next = _next;
        _next = null;
        return next;
    }

    /// <summary>Brings <paramref name="entry"/> to the front, and says so when its character could not come.</summary>
    private async Task BringForwardAsync(Entry entry)
    {
        if (entry.Session is { } session && ReferenceEquals(session, Sessions.Focused)) return;
        if (entry.Character is not { } character)
        {
            if (entry.Session is { } other && Sessions.Sessions.Contains(other)) Sessions.Focus(other);
            return;
        }

        if (!await CharacterSwitch.SwitchAsync(character))
            Snackbar.Add(Loc["NavClientSwitchFailed", character.Name], Severity.Error);
    }

    private void OnSessionsChanged() => InvokeAsync(() =>
    {
        Watch();
        StateHasChanged();
    });

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    private void OnRosterChanged() => InvokeAsync(StateHasChanged);

    private void OnConnectionChanged(bool _) => InvokeAsync(StateHasChanged);

    /// <summary>Listens to each session's counts and connection, and lets go of the ones that closed.</summary>
    private void Watch()
    {
        foreach (var session in Sessions.Sessions.Where(_watched.Add))
        {
            session.Comms.Changed += OnSessionChanged;
            session.Terminal.ConnectionStateChanged += OnConnectionChanged;
        }

        foreach (var gone in _watched.Except(Sessions.Sessions).ToList())
        {
            Unwatch(gone);
            _watched.Remove(gone);
        }
    }

    private void Unwatch(CharacterSession session)
    {
        session.Comms.Changed -= OnSessionChanged;
        session.Terminal.ConnectionStateChanged -= OnConnectionChanged;
    }

    public void Dispose()
    {
        Sessions.Changed -= OnSessionsChanged;
        AccountAuth.RosterChanged -= OnRosterChanged;
        foreach (var session in _watched) Unwatch(session);
    }
}
