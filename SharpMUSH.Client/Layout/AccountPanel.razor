@* Popover opened by the bottom-left nav profile card (NavMenu.razor). Two levels: root account
   actions, and a character-switch submenu that slides in as a second panel — the Slack/Discord/
   Linear pattern for an app-shell's persistent account block. Anchored ABOVE the card (it lives at
   the bottom of a scrolling sidebar) and Fixed so sidebar scroll never displaces it.

   Behavior: OnOpenInNewTab is exposed for the host to wire, not acted on here — NavMenu.razor's
   HandleOpenInNewTabAsync is what actually calls window.open, carrying the target
   character via a one-shot ?as=<dbref>-<creationTime> entry hint. *@

@inject IStringLocalizer<SharedResource> Loc
@inject IJSRuntime JS

<div>
    @if (IsOpen)
    {
        @* account-panel-scrim carries no CSS rule — it's a test hook, selected by AccountPanelTests. *@
        <MudOverlay Visible="true"
                    DarkBackground="false"
                    LightBackground="false"
                    Class="account-panel-scrim"
                    OnClick="ClosePanelAsync" />
        <MudPopover Open="true"
                    Fixed="true"
                    AnchorOrigin="Origin.TopLeft"
                    TransformOrigin="Origin.BottomLeft"
                    Paper="false">
            <div class="account-panel" tabindex="-1" @ref="_panelRef" @onkeydown="HandleKeyDownAsync">
                <div class="account-panel-track @(_level == PanelLevel.Submenu ? "account-panel-track--submenu" : "")">

                    @* ── Root level ── *@
                    <div class="account-panel-level account-panel-level--root" inert="@(_level == PanelLevel.Submenu)">
                        @if (HasCharacters)
                        {
                            <button type="button" class="account-panel-item account-panel-switch-btn" @onclick="OpenSubmenu">
                                <span class="account-panel-item-icon" aria-hidden="true">&#8644;</span>
                                <span class="account-panel-item-label">@Loc["AuthSwitchCharacter"]</span>
                            </button>
                        }
                        else
                        {
                            <div class="account-panel-item account-panel-item--inert">
                                <span class="account-panel-item-icon" aria-hidden="true">&#8644;</span>
                                <span class="account-panel-item-label">@Loc["AuthNoCharacter"]</span>
                            </div>
                        }
                        <a href="/account" class="account-panel-item" @onclick="ClosePanelAsync">
                            <span class="account-panel-item-icon" aria-hidden="true">&#9881;</span>
                            <span class="account-panel-item-label">@Loc["AuthAccountManagement"]</span>
                        </a>
                        @* The look of each character (theme and accent) is per character, so it sits beside
                           the character switch rather than only behind Account management's sidebar. *@
                        <a href="/settings/theme" class="account-panel-item account-panel-theme" @onclick="ClosePanelAsync">
                            <span class="account-panel-item-icon" aria-hidden="true">&#9680;</span>
                            <span class="account-panel-item-label">@Loc["NavTheme"]</span>
                        </a>
                        <div class="account-panel-divider"></div>
                        <button type="button" class="account-panel-item account-panel-item--danger" @onclick="HandleLogoutAsync">
                            <span class="account-panel-item-icon" aria-hidden="true">&#9211;</span>
                            <span class="account-panel-item-label">@Loc["AuthLogout"]</span>
                        </button>
                    </div>

                    @* ── Character submenu — entirely absent when there is nothing to switch to. ── *@
                    @if (HasCharacters)
                    {
                        <div class="account-panel-level account-panel-level--submenu" inert="@(_level == PanelLevel.Root)">
                            <button type="button" class="account-panel-back" @onclick="BackToRoot">
                                <span class="account-panel-item-icon" aria-hidden="true">&#8249;</span>
                                <span>@Loc["AuthSwitchCharacter"]</span>
                            </button>
                            <div class="account-panel-characters">
                                @foreach (var character in Characters)
                                {
                                    var isActive = IsActive(character);
                                    @* Two buttons side by side, never one inside the other: the row's own click is for the
                                       mouse, over its padding, and the name button is what a keyboard and a reader use. *@
                                    <div class="account-panel-character @(isActive ? "account-panel-character--active" : "")"
                                         @onclick="() => SelectCharacterAsync(character)">
                                        <button type="button" class="account-panel-character-pick" aria-current="@(isActive ? "true" : null)"
                                                @onclick="() => SelectCharacterAsync(character)" @onclick:stopPropagation="true">
                                            <span class="account-panel-character-check" aria-hidden="true">@(isActive ? "✓" : "")</span>
                                            <span class="account-panel-character-name">@character.Name</span>
                                            <span class="account-panel-character-dbref">#@character.DbrefNumber</span>
                                        </button>
                                        <button type="button"
                                                class="account-panel-newtab"
                                                title="@Loc["AuthOpenInNewTab", character.Name]"
                                                aria-label="@Loc["AuthOpenInNewTab", character.Name]"
                                                @onclick="() => OnOpenInNewTab.InvokeAsync(character)"
                                                @onclick:stopPropagation="true">
                                            <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Style="font-size:0.8125rem;" />
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </MudPopover>
    }
</div>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public IReadOnlyList<AccountAuthService.CharacterSummary> Characters { get; set; } = [];
    [Parameter] public AccountAuthService.CharacterSummary? ActiveCharacter { get; set; }
    [Parameter] public EventCallback<AccountAuthService.CharacterSummary> OnSwitchCharacter { get; set; }
    [Parameter] public EventCallback<AccountAuthService.CharacterSummary> OnOpenInNewTab { get; set; }
    [Parameter] public EventCallback OnLogout { get; set; }

    private enum PanelLevel { Root, Submenu }

    private PanelLevel _level = PanelLevel.Root;
    private ElementReference _panelRef;
    private bool _wasOpen;

    private bool HasCharacters => Characters.Count > 0;

    private bool IsActive(AccountAuthService.CharacterSummary character)
        => ActiveCharacter is not null
           && ActiveCharacter.DbrefNumber == character.DbrefNumber
           && ActiveCharacter.CreationTime == character.CreationTime;

    protected override void OnParametersSet()
    {
        // A parent-driven close (e.g. re-clicking the card) bypasses ClosePanelAsync, so the level
        // reset has to happen here too — otherwise the next open silently resumes mid-submenu.
        if (!IsOpen)
        {
            _level = PanelLevel.Root;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Move real keyboard focus onto the panel exactly once per open — not every render, or a
        // re-render triggered while the panel is open (e.g. switching levels) would keep stealing
        // focus back from whatever the user just interacted with. Needed so a mouse-opened panel is
        // still Escape-able without an extra Tab: the browser has to actually be focused on this
        // element for a real keydown to reach it (bUnit's synthetic KeyDown bypasses this, but a
        // live browser does not).
        if (IsOpen && !_wasOpen)
        {
            try
            {
                await _panelRef.FocusAsync();
            }
            catch (Exception ex) when (ex is JSException or InvalidOperationException)
            {
                // Best-effort: focus is a UX nicety, not load-bearing for correctness. A live browser
                // failure surfaces as JSException; an ElementReference not wired up to JS interop
                // (e.g. MudPopoverProvider missing from the render tree) surfaces as
                // InvalidOperationException ("ElementReference has not been configured correctly") —
                // both are non-fatal here.
            }
        }

        if (IsOpen && (!_wasOpen || _levelChanged))
        {
            // Up and Down move between the panel's controls; a switch of level puts focus on the new level's
            // first, since the control that was focused is now inert.
            var levelChanged = _levelChanged;
            _levelChanged = false;
            try
            {
                await JS.InvokeVoidAsync("sharpmushLayout.arrowFocus", _panelRef);
                if (levelChanged) await JS.InvokeVoidAsync("sharpmushLayout.focusFirst", _panelRef);
            }
            catch (Exception ex) when (ex is JSException or InvalidOperationException)
            {
                // No layout script: Tab still reaches every control.
            }
        }

        _wasOpen = IsOpen;
    }

    private bool _levelChanged;

    private void OpenSubmenu() => SetLevel(PanelLevel.Submenu);

    private void BackToRoot() => SetLevel(PanelLevel.Root);

    private void SetLevel(PanelLevel level)
    {
        _levelChanged = level != _level;
        _level = level;
    }

    private async Task ClosePanelAsync()
    {
        _level = PanelLevel.Root;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task SelectCharacterAsync(AccountAuthService.CharacterSummary character)
    {
        await OnSwitchCharacter.InvokeAsync(character);
        await ClosePanelAsync();
    }

    private async Task HandleLogoutAsync()
    {
        await OnLogout.InvokeAsync();
        await ClosePanelAsync();
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await ClosePanelAsync();
        }
    }
}
