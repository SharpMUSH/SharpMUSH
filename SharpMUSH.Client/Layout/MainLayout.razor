@using SharpMUSH.Client.Components
@using Microsoft.AspNetCore.Components.Sections
@using SharpMUSH.Client.Services
@using Microsoft.AspNetCore.Components.Authorization
@using SharpMUSH.Library.Models.Portal.Widgets
@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResource> Loc
@inject TerminalServiceHost Terminal
@inject TerminalLoginService TerminalLogin
@inject AccountAuthService AccountAuth
@inject AuthenticationStateProvider AuthStateProvider
@inject ServerInfoService ServerInfo
@inject ILayoutService LayoutService
@inject IJSRuntime JS

<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@* Forces a hard browser refresh whenever the server unloads/reloads a plugin DLL (generic signal). *@
<PluginChangeReloader />

@* WCAG 2.4.1: the first two tab stops skip the navigation, to the page or to its main text box
   (input-focus.js handles both, so the router does not treat them as navigation). *@
<div class="skip-links">
    <a class="skip-link" href="#main-content" data-skip="main">@Loc["NavSkipToContent"]</a>
    <a class="skip-link skip-link--input" href="#main-content" data-skip="input">@Loc["NavSkipToTextBox"]</a>
</div>

<div class="phosphor-shell @(_mobileNavOpen ? "phosphor-shell--nav-open" : "") @(_pagebarOpen ? "phosphor-shell--pagebar-open" : "") @(_isPlayRoute ? "" : "phosphor-shell--bottomnav")">

    @* Touch chrome only: tapping the dimmed backdrop closes the off-canvas drawer or section panel. *@
    <div class="phosphor-nav-backdrop" @onclick="CloseMobilePanels"></div>

    @* D1 §3: the rail on a desktop; the grouped drawer (NavMenu) on touch chrome. shell.css shows one. *@
    <NavRail TerminalOpen="_terminalOpen" OnToggleTerminal="ToggleTerminal" OnSearch="OpenPalette" />
    <NavMenu IsCollapsed="false" ShowTools="_isPlayRoute" TerminalOpen="_terminalOpen" OnSectionMenu="TogglePagebar" OnSearch="OpenPaletteFromDrawer"
             OnToggleTerminal="ToggleTerminalFromDrawer" />

    @* D1 §3 page-sidebar slot: a section's layout fills it through SectionShell. The column shows only
       while a sidebar is mounted (shell.css :has), 232px or the 62px strip; on touch chrome it is the
       off-canvas section panel. *@
    <aside class="phosphor-pagebar">
        <SectionOutlet SectionName="@PageSidebarSlot.Name" />
    </aside>

    @if (_layout is not null && _layout.Settings.LeftSidebarEnabled && !_isConfigRoute)
    {
        <div class="phosphor-widget-aside" style="@($"width:{_layout.Settings.LeftSidebarWidth};")">
            <ZoneRenderer Zone="WidgetZone.LeftSidebar" Layout="_layout" Grid="true" />
        </div>
    }

    <div class="phosphor-content-col">

        @* Touch chrome keeps a slim header: the drawer, this section's panel, search, the language and
           the terminal. A desktop has no top bar in D1 (Q1): those live in the rail. *@
        <header class="phosphor-topbar">
            <button class="phosphor-icon-btn" @onclick="ToggleMobileNav" aria-expanded="@(_mobileNavOpen ? "true" : "false")"
                    aria-label="@Loc["NavToggleNavigation"]" title="@Loc["NavToggleNavigation"]">
                <MudIcon Icon="@Icons.Material.Filled.Menu" Style="font-size:1.25rem;" />
            </button>
            <button class="phosphor-icon-btn phosphor-pagebar-btn" @onclick="TogglePagebar" aria-expanded="@(_pagebarOpen ? "true" : "false")"
                    aria-label="@Loc["NavSectionMenu"]" title="@Loc["NavSectionMenu"]">
                <MudIcon Icon="@Icons.Material.Outlined.ViewSidebar" Style="font-size:1.25rem;" />
            </button>
            <div style="flex:1;"></div>
            <button class="phosphor-icon-btn" @onclick="OpenPalette" aria-haspopup="dialog" aria-label="@Loc["NavSearchOpen"]" title="@Loc["NavSearchOpen"]">
                <MudIcon Icon="@Icons.Material.Outlined.Search" Style="font-size:1.25rem;" />
            </button>
            <span class="phosphor-lang"><LanguagePicker /></span>
            <button class="@($"phosphor-icon-btn{(_terminalOpen ? " phosphor-icon-btn--active" : "")}")"
                    @onclick="ToggleTerminal" aria-pressed="@(_terminalOpen ? "true" : "false")"
                    aria-label="@Loc["NavCommandTerminal"]" title="@(_terminalOpen ? Loc["NavCloseTerminal"] : Loc["NavOpenTerminal"])">
                <MudIcon Icon="@Icons.Material.Filled.Terminal" Style="font-size:1.125rem;" />
            </button>
        </header>

        @* The global TopBar zone (QuickLinks by default) as a slim strip above main, only when an admin
           has put something in it (Q1). *@
        @if (_layout is not null && _layout.Zones.TryGetValue(WidgetZone.TopBar, out var topBar) && topBar.Count > 0)
        {
            <div class="phosphor-topzone">
                <ZoneRenderer Zone="WidgetZone.TopBar" Layout="_layout" />
            </div>
        }

        <main id="main-content" tabindex="-1" class="phosphor-main @(_terminalOpen ? "phosphor-main--terminal" : "")">
            <div class="phosphor-page">
                <CascadingValue Value="_shellNavigation" IsFixed="true">
                    @Body
                </CascadingValue>
            </div>
        </main>

        @if (_layout is not null && _layout.Settings.FooterEnabled)
        {
            <div class="phosphor-footer">
                <ZoneRenderer Zone="WidgetZone.Footer" Layout="_layout" Grid="true" />
            </div>
        }

        @* Always mounted so the command terminal auto-logs in on load; hidden until opened. *@
        <div class="phosphor-terminal" style="@(_terminalOpen ? null : "display:none;")">
            <div class="phosphor-terminal-header">
                <MudIcon Icon="@Icons.Material.Filled.Terminal" Style="font-size:0.9375rem;color:var(--accent);margin-right:0.5625rem;" />
                <span style="font-family:var(--font-mono);font-size:0.75rem;color:var(--accent);letter-spacing:0.05em;">@Loc["NavCommandTerminal"]</span>
                <span style="font-family:var(--font-mono);font-size:0.6875rem;color:var(--text-faint);margin-left:0.5rem;">
                    · @(Terminal.IsConnected ? Loc["Connected"] : Loc["Disconnected"])
                </span>
                <div style="flex:1;"></div>
                <button class="phosphor-icon-btn" @onclick="ToggleTerminal" title="@Loc["NavCloseTerminal"]">
                    <MudIcon Icon="@Icons.Material.Filled.Close" Style="font-size:1.125rem;" />
                </button>
            </div>
            <div style="flex:1;min-height:0;overflow:hidden;display:flex;flex-direction:column;">
                <GlobalTerminal Terminal="Terminal" Interactive="false" />
            </div>
        </div>

        @* Mobile-only hybrid bottom navigation. The primary destinations stay visible (the
           research-backed pattern for engagement/discoverability); "Menu" opens the full
           grouped drawer for the long tail. Suppressed on /play so it doesn't fight that
           page's terminal input at the bottom of the screen. *@
        @if (!_isPlayRoute)
        {
            <nav class="phosphor-bottomnav">
                @BottomTab("/", Icons.Material.Filled.Home, Loc["Home"], exact: true)
                @if (_showPlay)
                {
                    @BottomTab("/play", Icons.Material.Filled.SportsEsports, Loc["Play"])
                }
                @BottomTab("/wiki", Icons.Material.Filled.MenuBook, Loc["Wiki"])
                @BottomTab("/characters", Icons.Material.Filled.Groups, Loc["NavCharsShort"])
                <button type="button"
                        class="phosphor-bottomtab @(_mobileNavOpen ? "phosphor-bottomtab--on" : "")"
                        @onclick="ToggleMobileNav">
                    <MudIcon Icon="@Icons.Material.Filled.Menu" Class="phosphor-bottomtab-icon" />
                    <span class="phosphor-bottomtab-label">@Loc["NavMenuLabel"]</span>
                </button>
            </nav>
        }
    </div>

    <CommandPalette @bind-Open="_paletteOpen" />

    @if (_layout is not null && _layout.Settings.RightSidebarEnabled && !_isConfigRoute)
    {
        <div class="phosphor-widget-aside phosphor-widget-aside--right" style="@($"width:{_layout.Settings.RightSidebarWidth};")">
            <ZoneRenderer Zone="WidgetZone.RightSidebar" Layout="_layout" Grid="true" />
        </div>
    }
</div>

@code {
    private bool _mobileNavOpen = false;
    private bool _pagebarOpen = false;
    private bool _paletteOpen = false;
    private bool _isConfigRoute = false;
    private bool _isPlayRoute = false;
    private bool _terminalOpen = false;
    private bool _characterActive = false;

    // Logged-in users can Play as their character; anonymous visitors can Play only when the
    // server accepts guests. Defaults to the config default (true) until the fetch settles.
    private bool _guestsEnabled = true;
    private bool _showPlay => AccountAuth.IsLoggedIn || _guestsEnabled;
    private bool _isDebugAuth;
    private LayoutConfiguration? _layout;
    private string? _pendingHintStrip;

    /// <summary>
    /// Strips the consumed <c>?as=</c> hint from the URL once rendering has settled. Nulling the
    /// field first makes this one-shot; it cannot run during <c>OnInitializedAsync</c> (see
    /// <see cref="ConsumeCharacterHintAsync"/>), and the first render happens before that method's
    /// awaits complete, so this deliberately does not gate on <c>firstRender</c>.
    /// </summary>
    private DotNetObjectReference<MainLayout>? _selfRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _selfRef = DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("sharpmushLayout.registerPaletteHotkey", _selfRef);
        }
        catch (JSException)
        {
            // No layout.js (prerender, tests): the rail's search button still opens the palette.
        }
    }

    /// <summary>⌘K / Ctrl+K from layout.js.</summary>
    [JSInvokable]
    public Task OpenPaletteFromHotkey() => InvokeAsync(() =>
    {
        _paletteOpen = true;
        StateHasChanged();
    });

    protected override void OnAfterRender(bool firstRender)
    {
        if (_pendingHintStrip is null) return;

        var target = _pendingHintStrip;
        _pendingHintStrip = null;
        NavigationManager.NavigateTo(target, replace: true);
    }

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        // Mirror the sidebar's Play gating on the bottom nav: a character session is
        // "active" when the command terminal is connected.
        _characterActive = Terminal.IsConnected;
        Terminal.ConnectionStateChanged += OnCharacterConnectionChanged;
        UpdateConfigRouteState();
        LayoutService.OnLayoutChanged += HandleLayoutChanged;
        ServerInfo.Changed += OnServerInfoChanged;

        // None of these depend on who is signed in, so they go out now, alongside session restore,
        // instead of one after another behind it: each is a round trip the shell's zones, the Play
        // tab or the /setup redirect would otherwise wait on in turn.
        var globalLayout = LoadGlobalLayoutAsync();
        var guestLogins = LoadGuestLoginsEnabledAsync();
        var setupStatus = AccountAuth.NeedsSetupAsync();

        await AccountAuth.InitAsync();
        // Read once, after hydration, to decide how this tab bootstraps its session. The cascaded task
        // could still be the one issued before InitAsync finished.
#pragma warning disable BL0013
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
#pragma warning restore BL0013

        // Guarded by ExplicitlyLoggedOut: without this, a dev who logs out would be silently
        // re-authenticated as the debug admin on the very next reload/navigation, since the
        // debug identity is always "authenticated" in Development. The latch sticks until the
        // next real login (via /login, or a fresh tab — sessionStorage is tab-scoped).
        if (!AccountAuth.ExplicitlyLoggedOut && authState.User.Identity?.IsAuthenticated == true && !AccountAuth.IsLoggedIn)
        {
            // Kept for its side effect: refreshes the dev session so the routing below sees the
            // logged-in admin. The always-mounted GlobalTerminal does the terminal connect itself.
            await AccountAuth.GetDebugOttAsync();
        }

        // Same latch here: the "Dev Mode" topbar this field once guarded is gone, but the field
        // isn't dead — it's read by the /setup routing gate below (EnsureAccountRoutingAsync), which
        // must NOT funnel a debug-authenticated dev to /setup on an unclaimed game. Without the
        // latch, an explicit logout here would still read as "authenticated" via the debug
        // identity (its IsAuthenticated never flips to false on its own) and wrongly reach that
        // gate as if a real anonymous visitor had shown up.
        _isDebugAuth = !AccountAuth.ExplicitlyLoggedOut && authState.User.Identity?.IsAuthenticated == true && !AccountAuth.IsLoggedIn;

        await Task.WhenAll(
            RestoreCharacterAsync(),
            EnsureAccountRoutingAsync(setupStatus),
            globalLayout,
            guestLogins);
    }

    /// <summary>The roster, then the <c>?as=</c> hint that picks a character from it.</summary>
    private async Task RestoreCharacterAsync()
    {
        if (AccountAuth.IsLoggedIn && AccountAuth.Characters.Count == 0)
            await AccountAuth.GetCharactersAsync();

        await ConsumeCharacterHintAsync();
    }

    private async Task LoadGlobalLayoutAsync()
    {
        _layout = await LayoutService.GetLayoutAsync(LayoutScopes.Global);
        StateHasChanged();
    }

    private async Task LoadGuestLoginsEnabledAsync()
    {
        _guestsEnabled = await ServerInfo.GuestLoginsEnabledAsync();
        StateHasChanged();
    }

    /// <summary>A newer server answer (the guest roster changed): the Play tab follows it.</summary>
    private void OnServerInfoChanged() => _ = InvokeAsync(LoadGuestLoginsEnabledAsync);

    private void HandleLayoutChanged(string scope)
    {
        if (!string.Equals(scope, LayoutScopes.Global, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            _layout = await LayoutService.GetLayoutAsync(LayoutScopes.Global);
            StateHasChanged();
        });
    }

    private async Task ConnectAsHintedCharacterAsync(AccountAuthService.CharacterSummary character)
    {
        AccountAuth.SetActiveCharacter(character);
        await TerminalLogin.ConnectAsCharacterAsync(character);
        StateHasChanged();
    }

    /// <summary>
    /// Consumes a one-shot <c>?as=&lt;dbref&gt;-&lt;creationTime&gt;</c> entry hint written by
    /// NavMenu's "open in new tab" affordance. A hint naming a character this account does not own is
    /// ignored — the roster (<see cref="AccountAuthService.Characters"/>) is the authority here, and
    /// the server would reject the switch anyway. A malformed hint is ignored without throwing.
    /// </summary>
    /// <remarks>
    /// The URL strip is deferred to the first render (<see cref="_pendingHintStrip"/>) rather than
    /// done here: navigating during <c>OnInitializedAsync</c> raises <c>LocationChanged</c>, which
    /// re-enters this layout's render while it is still initialising — with the always-mounted
    /// GlobalTerminal in the tree that re-entrant render recurses until the stack overflows. The hint
    /// is still parsed here, before <c>GlobalTerminal</c> mounts, so it auto-logs in as the hinted
    /// character; only the cosmetic strip waits for the first render.
    /// </remarks>
    private async Task ConsumeCharacterHintAsync()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var hint = System.Web.HttpUtility.ParseQueryString(uri.Query)["as"];
        if (string.IsNullOrEmpty(hint)) return;

        _pendingHintStrip = uri.GetLeftPart(UriPartial.Path);

        if (ShellRouting.ParseCharacterHint(hint) is not CharacterHint parsed)
            return;

        var target = AccountAuth.Characters
            .FirstOrDefault(c => c.DbrefNumber == parsed.Dbref && c.CreationTime == parsed.CreationTime);
        if (target is null) return;

        await ConnectAsHintedCharacterAsync(target);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            _mobileNavOpen = false;
            _pagebarOpen = false;
            UpdateConfigRouteState();
            await EnsureAccountRoutingAsync();
            // A page change is when an aged-out server answer is asked again (a fresh one costs nothing), so
            // a tab left open follows the guest roster without a reload; a changed answer reaches the menus
            // through ServerInfo.Changed.
            _guestsEnabled = await ServerInfo.GuestLoginsEnabledAsync();
            StateHasChanged();
        });
    }

    private void UpdateConfigRouteState()
    {
        _isConfigRoute = ShellRouting.IsConfigRoute(NavigationManager.Uri);
        _isPlayRoute = ShellRouting.IsPlayRoute(NavigationManager.Uri);
    }

    // Bottom-nav tab: a link that highlights when its route is active.
    private RenderFragment BottomTab(string href, string icon, string label, bool exact = false) =>
        @<a href="@href" class="phosphor-bottomtab @(IsNavActive(href, exact) ? "phosphor-bottomtab--on" : "")">
            <MudIcon Icon="@icon" Class="phosphor-bottomtab-icon" />
            <span class="phosphor-bottomtab-label">@label</span>
        </a>;

    private bool IsNavActive(string href, bool exact) => ShellRouting.IsNavActive(NavigationManager.Uri, href, exact);

    private void ToggleMobileNav()
    {
        _mobileNavOpen = !_mobileNavOpen;
        _pagebarOpen = false;
    }

    private void OnCharacterConnectionChanged(bool connected)
        => InvokeAsync(() =>
        {
            _characterActive = connected;
            StateHasChanged();
        });

    private bool? _needsSetup;

    /// <param name="setupStatus">A status request already in flight (the first call, from
    /// initialisation, starts it before session restore); later navigations ask afresh.</param>
    private async Task EnsureAccountRoutingAsync(Task<ApiResult<bool>>? setupStatus = null)
    {
        var currentPath = new Uri(NavigationManager.Uri).AbsolutePath;

        // First-run wizard: while the game is unclaimed, every route funnels to /setup.
        // Cache only the negative — once claimed, stop asking the server on each navigation.
        //
        // !_isDebugAuth is intentional, not a bug: in dev mode a debug-auth'd user who explicitly
        // logs out on an unclaimed game drops out of debug auth and lands here, which now routes
        // them to /setup. That's the correct destination — on an unclaimed game there's no
        // "anonymous portal" to fall back to, since onboarding is the only meaningful place to
        // send anyone. Do not special-case _isDebugAuth further to try to keep them off /setup.
        var setupPending = false;
        if (ShellRouting.ShouldCheckSetup(_needsSetup, _isDebugAuth))
        {
            // The failed arm means the status check couldn't reach or parse the server (transient
            // error, cold server, stale proxy, etc.) — leave _needsSetup as-is so the next
            // navigation retries instead of latching a false negative that would hide the wizard
            // for the rest of the session.
            if (await (setupStatus ?? AccountAuth.NeedsSetupAsync()) is bool needsSetup)
                _needsSetup = needsSetup;

            setupPending = _needsSetup == true;
        }

        if (ShellRouting.Redirect(currentPath, setupPending, AccountAuth.IsLoggedIn && AccountAuth.MustChangePassword) is string target)
            NavigationManager.NavigateTo(target);
    }

    /// <summary>The backdrop closes whichever touch-chrome panel is open.</summary>
    private void CloseMobilePanels()
    {
        _mobileNavOpen = false;
        _pagebarOpen = false;
    }

    private void TogglePagebar()
    {
        _pagebarOpen = !_pagebarOpen;
        _mobileNavOpen = false;
    }

    private void OpenPalette() => _paletteOpen = true;

    private void ToggleTerminal() => _terminalOpen = !_terminalOpen;

    /// <summary>The drawer's own copies of the header's buttons (Play, whose header is merged away) close it first.</summary>
    private void OpenPaletteFromDrawer()
    {
        _mobileNavOpen = false;
        _paletteOpen = true;
    }

    private void ToggleTerminalFromDrawer()
    {
        _mobileNavOpen = false;
        _terminalOpen = !_terminalOpen;
    }

    private ShellNavigation? _shellNavigationField;

    /// <summary>Cascaded to pages: Play's card header opens the drawer through it.</summary>
    private ShellNavigation _shellNavigation => _shellNavigationField ??= new ShellNavigation(() => _ = InvokeAsync(() =>
    {
        _mobileNavOpen = true;
        _pagebarOpen = false;
        StateHasChanged();
    }));

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("sharpmushLayout.unregisterPaletteHotkey");
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
        _selfRef?.Dispose();
        NavigationManager.LocationChanged -= OnLocationChanged;
        LayoutService.OnLayoutChanged -= HandleLayoutChanged;
        Terminal.ConnectionStateChanged -= OnCharacterConnectionChanged;
        ServerInfo.Changed -= OnServerInfoChanged;
    }
}
