@using SharpMUSH.Client.Services
@using SharpMUSH.Client.Models
@using SharpMUSH.Client.Models.Applications
@using SharpMUSH.Library.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using SharpMUSH.Library.Models.Portal.Navigation
@inject IStringLocalizer<SharedResource> Loc
@inject ITerminalService Terminal
@inject IPlayTerminalService PlayTerminal
@inject NavigationManager Nav
@inject ApplicationCatalog Applications
@inject ServerInfoService ServerInfo
@inject PortalNavigation Navigation
@implements IDisposable

<div class="phosphor-sidebar @(IsCollapsed ? "phosphor-sidebar--collapsed" : "")">

    @* The brand is the link home; the Play group has no Home item of its own. *@
    <NavLink href="/" class="phosphor-logo" Match="NavLinkMatch.All" title="@Loc["Home"]">
        <GameLogo Class="phosphor-logo-mark" />
        @if (!IsCollapsed)
        {
            <div style="line-height:1.1;overflow:hidden;">
                <div class="phosphor-brand">@_gameName</div>
            </div>
        }
    </NavLink>

    <nav class="phosphor-nav" aria-label="@Loc["NavMenuLabel"]">

        @* The game's navigation groups (PortalNavigation), in the rail's order. A section group lists all its
           destinations here: the drawer has room for their names. *@
        @foreach (var group in _nav.Groups)
        {
            <div class="nav-group" @key="group.Id">
                <div class="nav-group-label">@group.Label</div>
                @foreach (var item in group.Items)
                {
                    @Destination(item)
                }
            </div>
        }

        @* Build & manage, grouped as its sidebar and overview group it (BuildNavCatalog). A group with
           nothing the viewer may use hides its heading through the nav-group CSS rule. Applications
           placed in Manage keep a group of their own. *@
        <div class="nav-group">
            <div class="nav-group-label">@Loc["NavBuildManage"]</div>
            <BuildNavLinks Group="BuildNavCatalog.Group.Overview" IsCollapsed="IsCollapsed" />
        </div>

        <div class="nav-group">
            <div class="nav-group-label">@Loc["NavSectionBuild"]</div>
            <BuildNavLinks Group="BuildNavCatalog.Group.Build" IsCollapsed="IsCollapsed" />
            <ApplicationNavLinks IsCollapsed="IsCollapsed" Section="Build" Applications="_apps" />
        </div>

        @foreach (var group in StaffGroups)
        {
            <div class="nav-group" @key="group">
                <div class="nav-group-label">@Loc[BuildNavCatalog.GroupLabelKey(group)!]</div>
                <BuildNavLinks Group="group" IsCollapsed="IsCollapsed" />
            </div>
        }

        <div class="nav-group">
            <div class="nav-group-label">@Loc["NavSectionManage"]</div>
            <ApplicationNavLinks IsCollapsed="IsCollapsed" Section="Manage" Applications="_apps" />
        </div>

    </nav>

    @* The touch header's other buttons, for a page that merges that header into its own (Play). Rendered only
       on that route; shell.css shows it only while the play card is mounted. *@
    @if (ShowTools)
    {
        <div class="phosphor-drawer-tools">
            <button type="button" class="phosphor-icon-btn phosphor-pagebar-btn" aria-label="@Loc["NavSectionMenu"]" title="@Loc["NavSectionMenu"]"
                    @onclick="OnSectionMenu">
                <MudIcon Icon="@Icons.Material.Outlined.ViewSidebar" Style="font-size:1.25rem;" />
            </button>
            <button type="button" class="phosphor-icon-btn" aria-haspopup="dialog" aria-label="@Loc["NavSearchOpen"]" title="@Loc["NavSearchOpen"]"
                    @onclick="OnSearch">
                <MudIcon Icon="@Icons.Material.Outlined.Search" Style="font-size:1.25rem;" />
            </button>
            <span class="phosphor-lang"><LanguagePicker /></span>
            <button type="button" class="@($"phosphor-icon-btn{(TerminalOpen ? " phosphor-icon-btn--active" : "")}")"
                    aria-pressed="@(TerminalOpen ? "true" : "false")" aria-label="@Loc["NavCommandTerminal"]"
                    title="@Loc["NavCommandTerminal"]" @onclick="OnToggleTerminal">
                <MudIcon Icon="@Icons.Material.Filled.Terminal" Style="font-size:1.125rem;" />
            </button>
        </div>
    }

    <AccountButton Compact="IsCollapsed" />
</div>

@code {
    /// <summary>The staff groups after Build, each under its own heading.</summary>
    private static readonly BuildNavCatalog.Group[] StaffGroups =
    [
        BuildNavCatalog.Group.People,
        BuildNavCatalog.Group.Moderation,
        BuildNavCatalog.Group.Content,
        BuildNavCatalog.Group.Portal,
        BuildNavCatalog.Group.Server,
    ];

    [Parameter]
    public bool IsCollapsed { get; set; } = true;

    /// <summary>Whether to render the tools row: on Play, which merges the touch header into its card header.</summary>
    [Parameter] public bool ShowTools { get; set; }

    /// <summary>Whether the command terminal drawer is open (the tools row's toggle shows pressed).</summary>
    [Parameter] public bool TerminalOpen { get; set; }

    /// <summary>The tools row: open this section's panel, the command palette, and the command terminal.</summary>
    [Parameter] public EventCallback OnSectionMenu { get; set; }
    [Parameter] public EventCallback OnSearch { get; set; }
    [Parameter] public EventCallback OnToggleTerminal { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    // The registered Page apps, shared with the Build and Manage ApplicationNavLinks to avoid a registry call each.
    private IReadOnlyList<PortalApplication> _apps = [];

    // The game's navigation for this viewer: the same groups, in the same order, as the rail.
    private ResolvedNav _nav = ResolvedNav.Empty;

    private static readonly string PlayKey = NavKeys.Core("play");

    // The configured game name shown as the sidebar brand. Defaults to the config default until the
    // ServerInfo fetch settles.
    private string _gameName = "SharpMUSH";

    // Play-session terminal status, surfaced as a dot on the Play nav item.
    private bool _playActive;
    private bool _playUnread;

    /// <summary>One destination's link. Play carries the session dot; a link to another site opens in a new tab.</summary>
    private RenderFragment Destination(NavDestination item) =>
        @<text>
            @if (item.External)
            {
                <a class="phosphor-nav-link" href="@item.Href" target="_blank" rel="noopener">
                    <MudIcon Icon="@item.FillIcon" Class="phosphor-nav-icon" />
                    <span class="@(IsCollapsed ? "visually-hidden" : "phosphor-nav-text")">@item.Label</span>
                </a>
            }
            else
            {
                <NavLink class="phosphor-nav-link" href="@item.Href" Match="NavLinkMatch.Prefix">
                    <MudIcon Icon="@item.FillIcon" Class="phosphor-nav-icon" />
                    @* Collapsed to its icon, the link still says where it goes. *@
                    <span class="@(IsCollapsed ? "visually-hidden" : "phosphor-nav-text")">@item.Label</span>
                    @if (_playActive && string.Equals(item.Key, PlayKey, StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="phosphor-nav-dot @(_playUnread ? "phosphor-nav-dot--unread" : "")" aria-hidden="true"
                              title="@(_playUnread ? Loc["NavPlayUnreadActivity"] : Loc["NavPlaySessionActive"])"></span>
                        <span class="visually-hidden">@(_playUnread ? Loc["NavPlayUnreadActivity"] : Loc["NavPlaySessionActive"])</span>
                    }
                </NavLink>
            }
        </text>;

    protected override void OnInitialized()
    {
        ServerInfo.Changed += OnServerInfoChanged;
        Navigation.Changed += OnNavigationChanged;
        Terminal.ConnectionStateChanged += OnConnectionChanged;

        _playActive = PlayTerminal.IsConnected;
        PlayTerminal.ConnectionStateChanged += OnPlayConnectionChanged;
        PlayTerminal.LineReceived += OnPlayLine;
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        // Independent of the role and the application list, so it is not queued behind them.
        var serverInfo = LoadServerInfoAsync();
        await LoadSectionsAsync();
        await serverInfo;
    }

    // Signing in or out hands down a new AuthState; the sections depend on who is looking.
    protected override Task OnParametersSetAsync() =>
        ReferenceEquals(AuthState, _sectionsAuth) ? Task.CompletedTask : LoadSectionsAsync();

    private Task<AuthenticationState>? _sectionsAuth;

    private async Task LoadSectionsAsync()
    {
        _sectionsAuth = AuthState;
        var user = AuthState is null ? null : (await AuthState).User;

        _nav = await Navigation.ResolveAsync(user);
        // The startup catalog, not a second GET api/applications of our own: the list is the same
        // for every viewer (the caller filters by role), and the catalog is already fetching it.
        await Applications.Loaded;
        _apps = Applications.All;
    }

    private async Task LoadServerInfoAsync() => _gameName = await ServerInfo.GameNameAsync();

    // Mail is there only while a character is connected.
    private void OnConnectionChanged(bool connected) => _ = InvokeAsync(ResolveAsync);

    // Staff in this tab saved the layout.
    private void OnNavigationChanged() => _ = InvokeAsync(ResolveAsync);

    private async Task ResolveAsync()
    {
        _nav = await Navigation.ResolveAsync(AuthState is null ? null : (await AuthState).User);
        StateHasChanged();
    }

    private void OnPlayConnectionChanged(bool connected)
        => InvokeAsync(() =>
        {
            _playActive = connected;
            if (!connected)
            {
                _playUnread = false;
            }
            StateHasChanged();
        });

    // New play output while the player isn't looking at /play → mark the dot as unread (brighter glow).
    private void OnPlayLine(TerminalLine _)
        => InvokeAsync(() =>
        {
            if (!IsOnPlay())
            {
                _playUnread = true;
                StateHasChanged();
            }
        });

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
        => InvokeAsync(() =>
        {
            if (IsOnPlay() && _playUnread)
            {
                _playUnread = false;
                StateHasChanged();
            }
        });

    private bool IsOnPlay()
        => new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').Equals("/play", StringComparison.OrdinalIgnoreCase);


    public void Dispose()
    {
        Terminal.ConnectionStateChanged -= OnConnectionChanged;
        PlayTerminal.ConnectionStateChanged -= OnPlayConnectionChanged;
        PlayTerminal.LineReceived -= OnPlayLine;
        Nav.LocationChanged -= OnLocationChanged;
        ServerInfo.Changed -= OnServerInfoChanged;
        Navigation.Changed -= OnNavigationChanged;
    }

    /// <summary>A newer server answer (the guest roster, the game's name or its features changed): the brand and the destinations follow it.</summary>
    private void OnServerInfoChanged() => _ = InvokeAsync(async () =>
    {
        _gameName = await ServerInfo.GameNameAsync();
        await ResolveAsync();
    });
}
