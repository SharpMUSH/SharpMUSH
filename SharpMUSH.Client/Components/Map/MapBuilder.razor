    /// <summary>A terrain type is letters, digits, <c>_</c> and <c>-</c>, at most 32; empty erases.</summary>
    private bool PaintTypeValid => _paintType.Trim() is var type && type.Length <= 32 && type.All(c => char.IsAsciiLetterOrDigit(c) || c is '_' or '-');

    /// <summary>One paint covers at most 262144 places, as <c>@world/paint</c> allows.</summary>
    private bool PaintTooLarge => (Math.Abs((long)_paintX2 - _paintX) + 1) * (Math.Abs((long)_paintY2 - _paintY) + 1) > 262144;

