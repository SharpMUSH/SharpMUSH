    // ---- world map ------------------------------------------------------------------------------------------------

    private int _paintX, _paintY, _paintX2, _paintY2;
    private string _paintType = "";
    private string _placeName = "";
    private string _placeRoom = "";
    private string? _placeRoomProblem;
    private string _side = "n";

    /// <summary>The level whose places the place fields were read from; null while that level's places were not read.</summary>
    private int? _placeRead;
    private string _sideState = "open";
    private string _sideReason = "";
    private static readonly string[] SquareSides = ["n", "e", "s", "w", "u", "d"];
    private static readonly string[] HexSides = ["n", "ne", "se", "s", "sw", "nw", "u", "d"];
    private static readonly string[] PointyHexSides = ["ne", "e", "se", "sw", "w", "nw", "u", "d"];
    private string[] Sides => Layout.IsPointy ? PointyHexSides : Layout.IsHex ? HexSides : SquareSides;
    private static readonly string[] SideStates = ["open", "wall", "oneway", "lock"];

    /// <summary>The place at (x, y) on the level on show, as the view read it; null when it holds nothing or was not read.</summary>
    private MapCellDto? PlaceAt(int x, int y) =>
        Cells is { } cells && cells.Level == Level ? cells.Cells.FirstOrDefault(cell => cell.X == x && cell.Y == y) : null;

    /// <summary>
    /// A place was chosen: the paint box starts on it, and its fields start from what it holds. The side stays chosen
    /// when this map's places have it, and is the first of theirs when not (north is a corner on a pointy hex map).
    /// </summary>
    private void ChoosePlace(int x, int y)
    {
        var place = PlaceAt(x, y);
        _placeRead = Cells?.Level == Level ? Level : null;
        (_paintX, _paintY, _paintX2, _paintY2, _paintType) = (x, y, x, y, place?.Type ?? _paintType);
        (_placeName, _placeRoom, _placeRoomProblem) = (place?.Name ?? "", place?.Room ?? "", null);
        ChooseSide(Sides.Contains(_side) ? _side : Sides[0]);
    }

    /// <summary>
    /// The side's state and reason as the view read them: open when it lists no wall there. A wall or lock between two
    /// places on one level is listed once, on the north or east side of the one it belongs to (on a hex map, its north,
    /// north-east or south-east side, and on a pointy hex map its north-east, east or south-east side), so the other sides
    /// read it from the neighbour's; up and down sides are listed on the place itself; a one-way side is listed on the
    /// place it leads out of.
    /// </summary>
    private void ChooseSide(string side)
    {
        _side = side;
        MapWallDto? wall = null;
        if (Cell is var (cx, cy) && Cells is { } cells && cells.Level == Level)
        {
            var (x, y) = ((int)cx, (int)cy);
            var (ownerX, ownerY, ownerSide) = side switch
            {
                "s" => (x, y - 1, "n"),
                "w" => (x - 1, y, "e"),
                "sw" when Layout.IsPointy => (x, y - 1, "ne"),
                "sw" => (x - 1, y, "ne"),
                "nw" => (x - 1, y + 1, "se"),
                _ => (x, y, side),
            };
            wall = cells.Walls.FirstOrDefault(wall => wall.X == x && wall.Y == y && wall.Side == side && wall.Kind == MapWallKinds.OneWay)
                ?? cells.Walls.FirstOrDefault(wall => wall.X == ownerX && wall.Y == ownerY && wall.Side == ownerSide && wall.Kind is MapWallKinds.Wall or MapWallKinds.Lock);
        }
        (_sideState, _sideReason) = wall is { } found ? (found.Kind, found.Reason ?? "") : ("open", "");
    }

    private bool WorldPlanned => Plan.Changes.Any(change => change.Kind == MapChangeKind.CreateWorld);
    private bool WaysPlanned => Plan.Changes.Any(change => change.Kind == MapChangeKind.OpenWays);

