    /// <summary>Chooses the room a way leads to; on a grid, its names start from the direction between the two.</summary>
    private void ChooseJoin(MapPlacement room, string? to)
    {
        (_joinTo, _joinElsewhere) = (to, null);
        (_joinNames, _joinBack) = ("", "");
        if (Layout.IsGraph || to is null || !Layout.Rooms.TryGetValue(to, out var other) || !room.Placed || !other.Placed) return;
        var (fx, fy, fz) = Layout.Spot(room);
        var (tx, ty, tz) = Layout.Spot(other);
        if (MapPlan.DirectionNames((int)Math.Round(tx - fx), (int)Math.Round(ty - fy), tz - fz) is { To: var names, Back: var back })
        {
            (_joinNames, _joinBack) = (names, back);
        }
    }

    /// <summary>Chooses a room by its dbref, wherever it is, once the game says it is a room the character may see.</summary>
    private async Task ChooseJoinByIdAsync(MapPlacement room)
    {
        var id = _joinId.Trim();
        if (!MapPlan.IsDbref(id)) return;
        if (Layout.Rooms.ContainsKey(id))
        {
            ChooseJoin(room, id);
            (_joinId, _joinIdProblem) = ("", null);
            return;
        }
        if (await RoomAsync(id) is not var (name, controls))
        {
            _joinIdProblem = Loc["NavMapNoSuchRoom", id];
            return;
        }
        // A way back is an exit in that room, which only someone who controls it may open.
        (_joinTo, _joinElsewhere, _joinNames, _joinBack, _joinWayBack, _joinId, _joinIdProblem) = (id, name, "", "", controls, "", null);
    }

    private async Task JoinAsync(string from)
    {
        if (_joinTo is not { } to || JoinProblem(from) is not null) return;
        Plan.Join(from, to, _joinNames, _joinWayBack ? _joinBack : null, _joinElsewhere);
        (_joinTo, _joinElsewhere, _joinNames, _joinBack, _joinWayBack) = (null, null, "", "", true);
        await OnChanged.InvokeAsync(from);
    }

