    private async Task PlaceRoomAsync(int x, int y)
    {
        var room = _placeRoom.Trim();
        if (room.Length > 0)
        {
            _placeRoomProblem = await RoomAsync(room) switch
            {
                null => Loc["NavMapNoSuchRoom", room].Value,
                (_, false) => Loc["NavMapNotYourRoom", room].Value,
                _ => null,
            };
            if (_placeRoomProblem is not null) return;
        }
        _placeRoomProblem = null;
        Plan.PlaceRoom(x, y, Level, room);
        await OnChanged.InvokeAsync(null);
    }

