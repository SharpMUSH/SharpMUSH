@using System.Globalization
@using SharpMUSH.Library.API
@inject IStringLocalizer<SharedResource> Loc

@* One level of a map: each room a box at its place (on a picture, a pin unless it has a size), each region (a map inside this one) a dashed box that opens it, each exit between two rooms on the level a line (with an arrow
   when it runs one way only), and the rooms the map does not place in a dashed strip below. The drawing is a
   picture only; the rooms are buttons over it, so they take focus, read in order and scroll into view. The figure
   is drawn at Zoom pixels per drawing unit, over the map's backdrop when it has one, inside a scrolling frame, so panning is the browser's own scrolling,
   by wheel, trackpad or finger. *@
<div class="map-frame" tabindex="-1">
    <figure class="map-figure" style="width: @Px(_width * Zoom); height: @Px(_height * Zoom);">
        <svg viewBox="@Num(_left) @Num(_top) @Num(_width) @Num(_height)" class="map-svg" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <defs>
                <marker id="@ArrowId" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                    <path d="M0,0 L10,5 L0,10 z" class="map-arrow" />
                </marker>
            </defs>
            @if (_backdrop is not null)
            {
                <image class="map-backdrop" href="@_backdrop" x="0" y="0" width="@Num(Layout.Map.Size![0])" height="@Num(Layout.Map.Size[1])"
                       preserveAspectRatio="none" />
            }
            @if (!Layout.IsGraph)
            {
                @foreach (var line in GridLines())
                {
                    <line class="map-grid" x1="@Num(line.X1)" y1="@Num(line.Y1)" x2="@Num(line.X2)" y2="@Num(line.Y2)" />
                }
            }
            @foreach (var edge in _edges)
            {
                <line class="map-edge @(edge.Route ? "map-edge--route" : null)" x1="@Num(edge.X1)" y1="@Num(edge.Y1)" x2="@Num(edge.X2)" y2="@Num(edge.Y2)"
                      marker-end="@(edge.OneWay ? $"url(#{ArrowId})" : null)" />
            }
            @if (Cell is var (cellX, cellY) && Editing)
            {
                @if (Layout.IsGraph)
                {
                    <circle class="map-spot" cx="@Num(cellX)" cy="@Num(cellY)" r="10" />
                }
                else
                {
                    <rect class="map-spot" x="@Num(cellX * MapLayout.Cell + Inset)" y="@Num(-(cellY + 1) * MapLayout.Cell + Inset)"
                          width="@Num(MapLayout.Cell - 2 * Inset)" height="@Num(MapLayout.Cell - 2 * Inset)" rx="8" />
                }
            }
            @foreach (var room in _rooms)
            {
                @if (Pin(room))
                {
                    var (cx, cy) = Centre(room);
                    <circle class="@RoomClass(room) map-box--pin" style="@MapLegendStyle.Style(Kind(room))" cx="@Num(cx)" cy="@Num(cy)" r="9" />
                    continue;
                }
                <rect class="@RoomClass(room)" style="@MapLegendStyle.Style(Kind(room))" x="@Num(room.X + Inset)" y="@Num(room.Y + Inset)"
                      width="@Num(room.Width - 2 * Inset)" height="@Num(room.Height - 2 * Inset)" rx="8" />
                @if (_vertical.TryGetValue(room.Room.Id, out var vertical))
                {
                    @Vertical(room, vertical)
                }
                @if (_doors.Contains(room.Room.Id))
                {
                    <circle class="map-door" cx="@Num(room.X + room.Width - Inset - 9)" cy="@Num(room.Y + Inset + 9)" r="5" />
                }
            }
        </svg>
        <div class="map-rooms">
            @if (Editing && Layout.IsGraph)
            {
                @* A picture has no cells: choosing a spot is a click on it. The panel beside the map takes the same
                   point as numbers, for a keyboard. *@
                <div class="map-pick" @onclick="PickAsync"></div>
            }
            @foreach (var (x, y) in _empty)
            {
                var chosen = Cell == (x, y);
                <button type="button" class="map-cell @(chosen ? "map-cell--selected" : null)" style="@CellBox(x, y)"
                        aria-pressed="@(chosen ? "true" : "false")" aria-label="@Loc["NavMapCell", x, y]"
                        @onclick="() => OnCell.InvokeAsync((x, y))"></button>
            }
            @foreach (var room in _rooms.Where(room => room.Region))
            {
                var here = room.Room.Id == Layout.Map.HereRegion;
                <a class="map-room map-room--region @(here ? "map-room--here" : null)" style="@Box(room)"
                   href="@($"/map/{room.Room.Id[1..]}")" title="@room.Room.Name"
                   aria-label="@(here ? $"{Loc["NavMapRegion", room.Room.Name]}, {Loc["NavMapYouAreHere"]}" : Loc["NavMapRegion", room.Room.Name].Value)">
                    <span class="map-room-name">@room.Room.Name</span>
                </a>
            }
            @foreach (var room in _rooms.Where(room => !room.Region))
            {
                var here = room.Room.Id == Layout.Map.Here;
                <button type="button" class="map-room @(Pin(room) ? "map-room--pin" : null) @(Editing && !room.Room.Editable ? "map-room--locked" : null) @(room.Room.Id == Selected ? "map-room--selected" : null) @(here ? "map-room--here" : null)"
                        style="@Box(room)" aria-pressed="@(room.Room.Id == Selected ? "true" : "false")"
                        aria-label="@Label(room, here)"
                        title="@room.Room.Name" @onclick="() => OnSelect.InvokeAsync(room.Room.Id)"
                        @ref="_buttons[room.Room.Id]">
                    @if (Kind(room) is { } kind)
                    {
                        @* The icon says the kind without its colour, for a reader who cannot tell the colours apart. *@
                        @if (MapLegendStyle.Svg(kind.Icon) is { } svg)
                        {
                            <MudIcon Icon="@svg" Class="map-room-icon" Size="Size.Small" aria-hidden="true" />
                        }
                        else if (MapLegendStyle.Glyph(kind.Icon) is { } glyph)
                        {
                            <span class="map-room-icon" aria-hidden="true">@glyph</span>
                        }
                    }
                    <span class="map-room-name">@room.Room.Name</span>
                    @if (room.Room.People.Count > 0)
                    {
                        <span class="map-room-count" aria-hidden="true">
                            <MudIcon Icon="@Icons.Material.Outlined.Person" Size="Size.Small" />@room.Room.People.Count
                        </span>
                    }
                </button>
            }
        </div>
    </figure>
</div>

@code {
    [Parameter, EditorRequired] public MapLayout Layout { get; set; } = default!;
    [Parameter] public int Level { get; set; }

    /// <summary>Pixels per drawing unit.</summary>
    [Parameter] public double Zoom { get; set; } = 1;

    [Parameter] public string? Selected { get; set; }
    [Parameter] public EventCallback<string> OnSelect { get; set; }

    /// <summary>Builder mode: empty cells are buttons, and a click on a picture chooses a spot.</summary>
    [Parameter] public bool Editing { get; set; }

    /// <summary>The empty cell (or, on a picture, the point) chosen in builder mode.</summary>
    [Parameter] public (double X, double Y)? Cell { get; set; }

    [Parameter] public EventCallback<(double X, double Y)> OnCell { get; set; }

    /// <summary>The steps of the route on show, drawn over the lines they take on this map; null when there is none.</summary>
    [Parameter] public IReadOnlyList<MapStepDto>? Route { get; set; }

    private const double Inset = 6;
    private const double Margin = 24;

    private readonly string _arrowId = "map-arrow-" + Guid.NewGuid().ToString("N")[..8];
    private string ArrowId => _arrowId;

    private readonly Dictionary<string, ElementReference> _buttons = new();
    private List<MapPlacement> _rooms = [];
    private List<Edge> _edges = [];
    private readonly Dictionary<string, (bool Up, bool Down)> _vertical = new();
    private readonly HashSet<string> _doors = [];
    private double _left, _top, _width, _height;
    private string? _backdrop;
    private List<(double X, double Y)> _empty = [];
    private Dictionary<string, MapLegendDto> _legend = [];

    private sealed record Edge(double X1, double Y1, double X2, double Y2, bool OneWay, bool Route);

    protected override void OnParametersSet()
    {
        _rooms = [.. Layout.On(Level), .. Layout.Unplaced(Level)];
        _legend = Layout.Map.Legend.ToDictionary(entry => entry.Type);
        _backdrop = Layout.IsGraph && Layout.Map.Size is [> 0, > 0, ..] && ImageUrlPolicy.IsRenderable(Layout.Map.Backdrop)
            ? ApiUrl.Resolve(Layout.Map.Backdrop!)
            : null;
        var route = (Route ?? []).Select(step => Pair(step.Source, step.Destination)).ToHashSet();
        var bounds = Layout.Bounds(Level);
        _empty = Editing && !Layout.IsGraph ? EmptyCells() : [];
        if (_empty.Count > 0)
        {
            bounds = (Math.Min(bounds.Left, _empty.Min(c => c.X) * MapLayout.Cell), Math.Min(bounds.Top, _empty.Min(c => -(c.Y + 1)) * MapLayout.Cell),
                Math.Max(bounds.Right, (_empty.Max(c => c.X) + 1) * MapLayout.Cell), Math.Max(bounds.Bottom, -_empty.Min(c => c.Y) * MapLayout.Cell));
        }
        (_left, _top) = (bounds.Left - Margin, bounds.Top - Margin);
        (_width, _height) = (bounds.Right - bounds.Left + 2 * Margin, bounds.Bottom - bounds.Top + 2 * Margin);

        var shown = _rooms.ToDictionary(room => room.Room.Id);
        var links = Layout.Map.Exits.Where(exit => exit.Destination is not null)
            .Select(exit => (exit.Source, To: exit.Destination!)).ToHashSet();
        _edges = [];
        _vertical.Clear();
        _doors.Clear();
        var drawn = new HashSet<(string, string)>();
        foreach (var exit in Layout.Map.Exits)
        {
            if (!shown.TryGetValue(exit.Source, out var from)) continue;
            if (exit.DestinationMap is not null) _doors.Add(exit.Source);
            if (exit.Destination is not { } to) continue;
            if (Layout.Rooms.TryGetValue(to, out var target) && target.Placed && from.Placed && target.Level != from.Level)
            {
                var up = target.Level > from.Level;
                var (u, d) = _vertical.GetValueOrDefault(exit.Source);
                _vertical[exit.Source] = (u || up, d || !up);
                continue;
            }
            if (!shown.TryGetValue(to, out var end) || to == exit.Source) continue;
            var pair = Pair(exit.Source, to);
            if (!drawn.Add(pair)) continue;
            var oneWay = !links.Contains((to, exit.Source));
            var (x1, y1) = Centre(from);
            var (x2, y2) = Centre(end);
            // A one-way line stops at the edge of the room it points to, so the arrow shows.
            if (oneWay) (x2, y2) = Toward(x1, y1, end);
            _edges.Add(new(x1, y1, x2, y2, oneWay, route.Contains(pair)));
        }
        // The route is drawn last, so no other line crosses it.
        _edges = [.. _edges.OrderBy(edge => edge.Route)];
    }

    /// <summary>The cells of this level no room covers, within one cell of its rooms (around 0, 0 when it has none).</summary>
    private List<(double X, double Y)> EmptyCells()
    {
        var boxes = Layout.On(Level).Select(Box).ToList();
        var ring = boxes.Count == 0 ? Ring((0, -1, 1, 1)).Prepend((Column: 0, Row: -1)) : boxes.SelectMany(Ring);
        // Rows top to bottom and cells left to right, so the buttons read in the order the eye does.
        return
        [
            .. ring.Distinct()
                .Where(cell => !boxes.Any(box => Covers(box, cell)))
                .OrderBy(cell => cell.Row).ThenBy(cell => cell.Column)
                .Select(cell => ((double)cell.Column, (double)(-cell.Row - 1))),
        ];

        // The cells a room covers, as its top-left cell and its width and height in cells.
        static (int Column, int Row, int Columns, int Rows) Box(MapPlacement room) =>
            ((int)Math.Round(room.X / MapLayout.Cell), (int)Math.Round(room.Y / MapLayout.Cell),
                Math.Max(1, (int)Math.Round(room.Width / MapLayout.Cell)), Math.Max(1, (int)Math.Round(room.Height / MapLayout.Cell)));

        static bool Covers((int Column, int Row, int Columns, int Rows) box, (int Column, int Row) cell) =>
            cell.Column >= box.Column && cell.Column < box.Column + box.Columns && cell.Row >= box.Row && cell.Row < box.Row + box.Rows;

        // The cells around a box, one deep, so a map of distant rooms asks for no more than its rooms' edges.
        static IEnumerable<(int Column, int Row)> Ring((int Column, int Row, int Columns, int Rows) box)
        {
            var (left, top, right, bottom) = (box.Column - 1, box.Row - 1, box.Column + box.Columns, box.Row + box.Rows);
            for (var column = left; column <= right; column++)
            {
                yield return (column, top);
                yield return (column, bottom);
            }
            for (var row = top + 1; row < bottom; row++)
            {
                yield return (left, row);
                yield return (right, row);
            }
        }
    }

    private string CellBox(double x, double y) =>
        $"left: {Percent(x * MapLayout.Cell + Inset - _left, _width)}%; top: {Percent(-(y + 1) * MapLayout.Cell + Inset - _top, _height)}%; " +
        $"width: {Percent(MapLayout.Cell - 2 * Inset, _width)}%; height: {Percent(MapLayout.Cell - 2 * Inset, _height)}%;";

    /// <summary>A click on the picture, in its own pixels.</summary>
    private Task PickAsync(MouseEventArgs click) =>
        OnCell.InvokeAsync((Math.Round(_left + click.OffsetX / Zoom), Math.Round(_top + click.OffsetY / Zoom)));

    private static (string, string) Pair(string a, string b) => string.CompareOrdinal(a, b) < 0 ? (a, b) : (b, a);

    /// <summary>A room on a picture with no size of its own is a pin at its point, so the picture shows around it.</summary>
    private bool Pin(MapPlacement room) => _backdrop is not null && room.Placed && !room.Region && room.Room.Size is null;

    /// <summary>Moves focus to <paramref name="id"/>'s room, which scrolls it into view.</summary>
    public async Task FocusAsync(string id)
    {
        if (_buttons.TryGetValue(id, out var button)) await button.FocusAsync();
    }

    private RenderFragment Vertical(MapPlacement room, (bool Up, bool Down) vertical) => __builder =>
    {
        var x = room.X + Inset + 10;
        var y = room.Y + Inset + 6;
        <g class="map-vertical">
            @if (vertical.Up)
            {
                <path d="@($"M{Num(x)},{Num(y + 8)} l5,-8 l5,8 z")" />
            }
            @if (vertical.Down)
            {
                <path d="@($"M{Num(x + 12)},{Num(y)} l5,8 l5,-8 z")" />
            }
        </g>
    };

    private IEnumerable<(double X1, double Y1, double X2, double Y2)> GridLines()
    {
        var bounds = Layout.Bounds(Level, includeUnplaced: false);
        if (!Layout.On(Level).Any()) yield break;
        for (var x = bounds.Left; x <= bounds.Right + 0.5; x += MapLayout.Cell) yield return (x, bounds.Top, x, bounds.Bottom);
        for (var y = bounds.Top; y <= bounds.Bottom + 0.5; y += MapLayout.Cell) yield return (bounds.Left, y, bounds.Right, y);
    }

    /// <summary>The legend entry for <paramref name="room"/>'s kind, when it has one and the legend names it.</summary>
    private MapLegendDto? Kind(MapPlacement room) =>
        room.Room.Environment is { } environment && _legend.TryGetValue(environment, out var entry) ? entry : null;

    /// <summary>The room's name, then its kind and whether the reader is in it, as a screen reader hears it.</summary>
    private string Label(MapPlacement room, bool here) => string.Join(", ", new[]
    {
        room.Room.Name,
        Kind(room)?.Label,
        room.Room.People.Count > 0 ? Loc["NavMapPeopleCount", room.Room.People.Count].Value : null,
        here ? Loc["NavMapYouAreHere"].Value : null,
    }.Where(part => part is not null));

    private string RoomClass(MapPlacement room) => string.Join(' ', new[]
    {
        "map-box",
        room.Placed ? null : "map-box--unplaced",
        room.Region ? "map-box--region" : null,
        room.Room.Id == Layout.Map.Here || room.Room.Id == Layout.Map.HereRegion ? "map-box--here" : null,
        room.Room.Id == Selected ? "map-box--selected" : null,
        Route?.Any(step => step.Destination == room.Room.Id) == true ? "map-box--route" : null,
        MapLegendStyle.Style(Kind(room)) is not null ? "map-box--toned" : null,
    }.Where(c => c is not null));

    private static (double X, double Y) Centre(MapPlacement room) => (room.X + room.Width / 2, room.Y + room.Height / 2);

    /// <summary>Where the line from (x, y) to <paramref name="room"/>'s centre meets its box.</summary>
    private static (double X, double Y) Toward(double x, double y, MapPlacement room)
    {
        var (cx, cy) = Centre(room);
        var (dx, dy) = (cx - x, cy - y);
        var halfW = room.Width / 2 - Inset;
        var halfH = room.Height / 2 - Inset;
        var scale = Math.Max(Math.Abs(dx) / Math.Max(halfW, 1), Math.Abs(dy) / Math.Max(halfH, 1));
        return scale <= 1 ? (cx, cy) : (cx - dx / scale, cy - dy / scale);
    }

    private string Box(MapPlacement room) =>
        $"left: {Percent(room.X + Inset - _left, _width)}%; top: {Percent(room.Y + Inset - _top, _height)}%; " +
        $"width: {Percent(room.Width - 2 * Inset, _width)}%; height: {Percent(room.Height - 2 * Inset, _height)}%;";

    private static string Percent(double at, double of) => Num(of <= 0 ? 0 : at / of * 100);

    private static string Px(double value) => Num(value) + "px";

    private static string Num(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);
}
