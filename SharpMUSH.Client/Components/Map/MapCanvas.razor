@using System.Globalization
@using SharpMUSH.Library.API
@inject IStringLocalizer<SharedResource> Loc
@inject IJSRuntime JS
@implements IAsyncDisposable

@* One level of a map: each room a box at its place (on a picture, a pin unless it has a size), each region (a map inside this one) a dashed box that opens it, each exit between two rooms on the level a line (with an arrow
   when it runs one way only), and the rooms the map does not place in a dashed strip below. The drawing is a
   picture only; the rooms are buttons over it, so they take focus, read in order and scroll into view. The figure
   is drawn at Zoom pixels per drawing unit, over the map's backdrop when it has one, inside a scrolling frame, so panning is the browser's own scrolling,
   by wheel, trackpad or finger, or a mouse dragging it. A pinch, or the wheel with Ctrl, zooms about the point under
   it (OnZoomAt). Lines keep their width at any zoom; names grow with it. A room too small to hold its
   name carries it on a label below, as a pin does, and one smaller still keeps it for its tooltip and screen reader.
   A map whose places a map source stores draws the window of them it was given (Cells) under its rooms: each place
   in its terrain's tone, hatched when closed, and walls, one-way edges and locked ways on their sides. A place with
   something to say (a name, a room, a panel) is a button too. *@
<div class="map-frame @(Layout.IsGraph && _backdrop is null ? "map-frame--blank" : null)" tabindex="-1" @ref="_frame">
    <figure class="map-figure" style="width: @Px(_width * Zoom); height: @Px(_height * Zoom); --map-zoom: @Num(Zoom); --map-dots: @Px(DotSpacing);">
        <svg viewBox="@Num(_left) @Num(_top) @Num(_width) @Num(_height)" class="map-svg" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <defs>
                <marker id="@ArrowId" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                    <path d="M0,0 L10,5 L0,10 z" class="map-arrow" />
                </marker>
                <pattern id="@HatchId" width="12" height="12" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                    <line class="map-hatch" x1="0" y1="0" x2="0" y2="12" />
                </pattern>
            </defs>
            @if (_backdrop is not null)
            {
                <image class="map-backdrop" href="@_backdrop" x="0" y="0" width="@Num(Layout.Map.Size![0])" height="@Num(Layout.Map.Size[1])"
                       preserveAspectRatio="none" />
            }
            @if (!Layout.IsGraph && !Layout.IsHex && !Layout.HasWays)
            {
                @foreach (var line in GridLines())
                {
                    <line class="map-grid" x1="@Num(line.X1)" y1="@Num(line.Y1)" x2="@Num(line.X2)" y2="@Num(line.Y2)" />
                }
            }
            @foreach (var place in _places)
            {
                var (px, py, pw, ph) = Layout.PlaceBox(place.X, place.Y);
                var placeClass = $"map-place {(PlaceStyle(place) is null ? null : "map-place--toned")} {(SelectedPlace == (place.X, place.Y) ? "map-place--selected" : null)}";
                @if (Layout.IsHex)
                {
                    <polygon class="@placeClass" style="@PlaceStyle(place)" points="@Points(Layout.HexCorners(place.X, place.Y))" />
                    @if (place.Closed)
                    {
                        <polygon class="map-place-hatch" fill="url(#@HatchId)" points="@Points(Layout.HexCorners(place.X, place.Y))" />
                    }
                }
                else
                {
                    @* A graph map's places stand apart, joined only by its ways. *@
                    var round = Layout.HasWays ? 12 : 0;
                    <rect class="@placeClass" style="@PlaceStyle(place)" x="@Num(px)" y="@Num(py)" width="@Num(pw)" height="@Num(ph)" rx="@round" />
                    @if (place.Closed)
                    {
                        <rect class="map-place-hatch" fill="url(#@HatchId)" x="@Num(px)" y="@Num(py)" width="@Num(pw)" height="@Num(ph)" rx="@round" />
                    }
                }
                @if (!_marked.Contains(place) && MapLegendStyle.Svg(Icon(place)) is { } placeIcon)
                {
                    @* A place with no button of its own shows its icon on the ground, small and in its terrain's tone, so a painted area
                       reads as textured ground rather than a field of symbols. *@
                    var side = Math.Min(pw, ph) * 0.45;
                    <svg class="map-place-icon" style="@PlaceStyle(place)" x="@Num(px + (pw - side) / 2)" y="@Num(py + (ph - side) / 2)"
                         width="@Num(side)" height="@Num(side)" viewBox="0 0 24 24">@((MarkupString)placeIcon)</svg>
                }
                else if (!_marked.Contains(place) && MapLegendStyle.Glyph(Icon(place)) is { } glyph)
                {
                    @SvgText("map-place-glyph", px + pw / 2, py + ph / 2, glyph)
                }
                @if (place.Badge is { Length: > 0 } badge)
                {
                    @* A hexagon's corner is cut away: its badge sits in from the top of its north-east edge. *@
                    @SvgText("map-place-badge", px + pw - (Layout.IsHex ? MapLayout.HexSide / 2 : 0) - Inset, py + Inset, badge)
                }
            }
            @foreach (var wall in _walls)
            {
                @Wall(wall)
            }
            @foreach (var link in _links)
            {
                @Way(link)
            }
            @foreach (var edge in _edges)
            {
                <line class="map-edge @(edge.Route ? "map-edge--route" : null)" x1="@Num(edge.X1)" y1="@Num(edge.Y1)" x2="@Num(edge.X2)" y2="@Num(edge.Y2)"
                      marker-end="@(edge.OneWay ? $"url(#{ArrowId})" : null)" />
            }
            @if (Cell is var (cellX, cellY) && Editing)
            {
                @if (Layout.IsGraph)
                {
                    <circle class="map-spot" cx="@Num(cellX)" cy="@Num(cellY)" r="10" />
                }
                else if (Layout.IsHex)
                {
                    <polygon class="map-spot" points="@Points(Layout.HexCorners((int)cellX, (int)cellY, 1 - 2 * Inset / MapLayout.HexSide))" />
                }
                else
                {
                    <rect class="map-spot" x="@Num(cellX * MapLayout.Cell + Inset)" y="@Num(-(cellY + 1) * MapLayout.Cell + Inset)"
                          width="@Num(MapLayout.Cell - 2 * Inset)" height="@Num(MapLayout.Cell - 2 * Inset)" rx="8" />
                }
            }
            @foreach (var room in _rooms)
            {
                @if (Pin(room))
                {
                    var (cx, cy) = Centre(room);
                    <circle class="@RoomClass(room) map-box--pin" style="@MapLegendStyle.Style(Kind(room))" cx="@Num(cx)" cy="@Num(cy)" r="9" />
                    @if (_doors.Contains(room.Room.Id))
                    {
                        <circle class="map-door" cx="@Num(cx + 9)" cy="@Num(cy - 9)" r="5" />
                    }
                    continue;
                }
                @if (Layout.IsHex && room.Room.Position is [var hexX, var hexY, ..])
                {
                    @* A room on a hex map is the hexagon it stands on, drawn in from its sides so their walls show. *@
                    <polygon class="@RoomClass(room)" style="@MapLegendStyle.Style(Kind(room))"
                             points="@Points(Layout.HexCorners((int)Math.Round(hexX), (int)Math.Round(hexY), 1 - 2 * Inset / MapLayout.HexSide))" />
                }
                else
                {
                    <rect class="@RoomClass(room)" style="@MapLegendStyle.Style(Kind(room))" x="@Num(room.X + Inset)" y="@Num(room.Y + Inset)"
                          width="@Num(room.Width - 2 * Inset)" height="@Num(room.Height - 2 * Inset)" rx="8" />
                }
                @if (_vertical.TryGetValue(room.Room.Id, out var vertical))
                {
                    @Vertical(room, vertical)
                }
                @if (_doors.Contains(room.Room.Id))
                {
                    <circle class="map-door" cx="@Num(room.X + room.Width - Inset - 9)" cy="@Num(room.Y + Inset + 9)" r="5" />
                }
            }
            @* After the rooms, so an arrow reaching over a neighbour's room is not hidden under it. *@
            @for (var i = 0; i < _climbs.Count; i++)
            {
                var link = _climbs[i];
                @Climb(link, _stacks[i])
            }
        </svg>
        @if (_links.Count + _climbs.Count > 0)
        {
            @* The drawing is hidden from a screen reader; its ways are read from here. *@
            <ul class="visually-hidden">
                @foreach (var link in _links.Concat(_climbs))
                {
                    <li>@WayText(link)</li>
                }
            </ul>
        }
        <div class="map-rooms">
            @if (Editing && Layout.IsGraph)
            {
                @* A picture has no cells: choosing a spot is a click on it. The panel beside the map takes the same
                   point as numbers, for a keyboard. *@
                <div class="map-pick" @onclick="PickAsync"></div>
            }
            else if (Editing && Layout.Space is not null)
            {
                @* A world map reaches further than a button per cell would: a click chooses the place under it, and the
                   world tools take the same place as numbers, for a keyboard. *@
                <div class="map-pick" @onclick="PickPlaceAsync"></div>
            }
            @foreach (var (x, y) in _empty)
            {
                var chosen = Cell == (x, y);
                <button type="button" class="map-cell @(chosen ? "map-cell--selected" : null)" style="@CellBox(x, y)"
                        aria-pressed="@(chosen ? "true" : "false")" aria-label="@Loc["NavMapCell", x, y]"
                        @onclick="() => OnCell.InvokeAsync((x, y))"></button>
            }
            @foreach (var place in _marked)
            {
                var chosen = SelectedPlace == (place.X, place.Y);
                <button type="button" class="map-room map-room--place @(chosen ? "map-room--selected" : null)" style="@PlaceButtonBox(place.X, place.Y) @PlaceStyle(place)"
                        aria-pressed="@(chosen ? "true" : "false")" aria-label="@PlaceLabel(place)" title="@PlaceName(place)"
                        @onclick="() => OnPlace.InvokeAsync(place)">
                    @if (MapLegendStyle.Svg(Icon(place)) is { } svg)
                    {
                        <svg class="map-room-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">@((MarkupString)svg)</svg>
                    }
                    else if (MapLegendStyle.Glyph(Icon(place)) is { } glyph)
                    {
                        <span class="map-room-icon" aria-hidden="true">@glyph</span>
                    }
                    <span class="map-room-name">@PlaceName(place)</span>
                    @if (place.People > 0)
                    {
                        <span class="map-room-count" aria-hidden="true">
                            <MudIcon Icon="@Icons.Material.Outlined.Person" Size="Size.Small" />@place.People
                        </span>
                    }
                </button>
            }
            @foreach (var room in _rooms.Where(room => room.Region))
            {
                var here = room.Room.Id == Layout.Map.HereRegion;
                <a class="map-room map-room--region @(here ? "map-room--here" : null) @Fit(room)" style="@Box(room)"
                   href="@($"/map/{room.Room.Id[1..]}")" title="@room.Room.Name"
                   aria-label="@(here ? $"{Loc["NavMapRegion", room.Room.Name]}, {Loc["NavMapYouAreHere"]}" : Loc["NavMapRegion", room.Room.Name].Value)">
                    <span class="map-room-name">@room.Room.Name</span>
                </a>
            }
            @foreach (var room in _rooms.Where(room => !room.Region))
            {
                var here = room.Room.Id == Layout.Map.Here;
                <button type="button" class="map-room @(Pin(room) ? "map-room--pin" : null) @Fit(room) @(Editing && !room.Room.Editable ? "map-room--locked" : null) @(room.Room.Id == Selected ? "map-room--selected" : null) @(here ? "map-room--here" : null)"
                        style="@Box(room) @MapLegendStyle.Style(Kind(room))" aria-pressed="@(room.Room.Id == Selected ? "true" : "false")"
                        aria-label="@Label(room, here)"
                        title="@room.Room.Name" @onclick="() => OnSelect.InvokeAsync(room.Room.Id)"
                        @ref="_buttons[room.Room.Id]">
                    @if (Kind(room) is { } kind)
                    {
                        @* The icon says the kind without its colour, for a reader who cannot tell the colours apart. *@
                        @if (MapLegendStyle.Svg(kind.Icon) is { } svg)
                        {
                            <svg class="map-room-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">@((MarkupString)svg)</svg>
                        }
                        else if (MapLegendStyle.Glyph(kind.Icon) is { } glyph)
                        {
                            <span class="map-room-icon" aria-hidden="true">@glyph</span>
                        }
                    }
                    <span class="map-room-name">@room.Room.Name</span>
                    @if (room.Room.People.Count > 0)
                    {
                        <span class="map-room-count" aria-hidden="true">
                            <MudIcon Icon="@Icons.Material.Outlined.Person" Size="Size.Small" />@room.Room.People.Count
                        </span>
                    }
                </button>
            }
        </div>
    </figure>
</div>

@code {
    [Parameter, EditorRequired] public MapLayout Layout { get; set; } = default!;
    [Parameter] public int Level { get; set; }

    /// <summary>Pixels per drawing unit.</summary>
    [Parameter] public double Zoom { get; set; } = 1;

    [Parameter] public string? Selected { get; set; }
    [Parameter] public EventCallback<string> OnSelect { get; set; }

    /// <summary>Builder mode: empty cells are buttons, and a click on a picture chooses a spot.</summary>
    [Parameter] public bool Editing { get; set; }

    /// <summary>The empty cell (or, on a picture, the point) chosen in builder mode.</summary>
    [Parameter] public (double X, double Y)? Cell { get; set; }

    [Parameter] public EventCallback<(double X, double Y)> OnCell { get; set; }

    /// <summary>The steps of the route on show, drawn over the lines they take on this map; null when there is none.</summary>
    [Parameter] public IReadOnlyList<MapStepDto>? Route { get; set; }

    /// <summary>A pinch or Ctrl+wheel asked to zoom by Factor; the page sets the zoom, and the point under it holds still.</summary>
    [Parameter] public EventCallback<double> OnZoomAt { get; set; }

    /// <summary>The stored places read around the view; drawn when they are of this level. Null for a map of rooms alone.</summary>
    [Parameter] public MapCellsDto? Cells { get; set; }

    /// <summary>The view settled after a scroll or resize: the cells it shows, as (left, bottom, right, top).</summary>
    [Parameter] public EventCallback<(int Left, int Bottom, int Right, int Top)> OnView { get; set; }

    /// <summary>The place chosen for its panel, by position.</summary>
    [Parameter] public (int X, int Y)? SelectedPlace { get; set; }

    [Parameter] public EventCallback<MapCellDto> OnPlace { get; set; }

    private const double Inset = MapLayout.RoomInset;
    private const double Margin = 24;

    /// <summary>How far past its places a graph map's drawing reaches either side, for the names beside its ways.</summary>
    private const double WayRoom = 160;

    /// <summary>The narrowest a room is drawn, in pixels, with its name inside.</summary>
    private const double NameWidth = 44;

    /// <summary>The narrowest a room is drawn, in pixels, with its name on a label below it.</summary>
    private const double LabelWidth = 14;

    /// <summary>
    /// How far a builder may reach past the rooms of a graph map with no picture, in rooms: the map has no edge of its own,
    /// so this is the room there is to choose a spot in.
    /// </summary>
    private const double Reach = 4;

    private ElementReference _frame;
    private double _drawnZoom;

    /// <summary>The point in the frame the next zoom holds still; its middle when null.</summary>
    private (double X, double Y)? _anchor;

    private DotNetObjectReference<MapCanvas>? _self;
    private IJSObjectReference? _gestures;
    private IJSObjectReference? _viewport;
    private bool _disposed;

    private readonly string _arrowId = "map-arrow-" + Guid.NewGuid().ToString("N")[..8];
    private string ArrowId => _arrowId;
    private string HatchId => _arrowId.Replace("arrow", "hatch");

    private readonly Dictionary<string, ElementReference> _buttons = new();
    private List<MapPlacement> _rooms = [];
    private List<Edge> _edges = [];
    private readonly Dictionary<string, (bool Up, bool Down)> _vertical = new();
    private readonly HashSet<string> _doors = [];
    private double _left, _top, _width, _height;
    private string? _backdrop;
    private List<(double X, double Y)> _empty = [];
    private Dictionary<string, MapLegendDto> _legend = [];
    private IReadOnlyList<MapCellDto> _places = [];
    private IReadOnlyList<MapWallDto> _walls = [];

    /// <summary>The places with something to say beyond their terrain, which are buttons; a room the map draws stands for its own.</summary>
    private List<MapCellDto> _marked = [];

    private sealed record Edge(double X1, double Y1, double X2, double Y2, bool OneWay, bool Route);

    /// <summary>A graph map's ways on the level on show, and each as from, to, to know which have a way back.</summary>
    private List<MapLinkDto> _links = [];

    /// <summary>A graph map's ways out of the level on show, to a place on another level.</summary>
    private List<MapLinkDto> _climbs = [];
    private HashSet<(int, int, int, int)> _twoWay = [];

    /// <summary>How many climbs before each in <see cref="_climbs"/> are drawn as the same arrow, to stack its name under theirs.</summary>
    private int[] _stacks = [];

    /// <summary>The places on show by where they are, to name a way's ends.</summary>
    private Dictionary<(int X, int Y), MapCellDto> _placeAt = [];

    protected override void OnParametersSet()
    {
        _rooms = [.. Layout.On(Level), .. Layout.Unplaced(Level)];
        _legend = Layout.Map.Legend.ToDictionary(entry => entry.Type);
        (_places, _walls) = Layout.Space is not null && Cells is { } cells && cells.Level == Level ? (cells.Cells, cells.Walls) : ([], []);
        var ways = Layout.HasWays && Cells is { } read && read.Level == Level ? read.Links : [];
        _links = [.. ways.Where(link => link.ToZ == Level)];
        _climbs = [.. ways.Where(link => link.ToZ != Level)];
        _twoWay = _links.Select(link => (link.X, link.Y, link.ToX, link.ToY)).ToHashSet();
        var arrows = new Dictionary<(int, int, int, int), int>();
        _stacks = [.. _climbs.Select(link =>
        {
            var arrow = Arrow(link);
            var stack = arrows.GetValueOrDefault(arrow);
            arrows[arrow] = stack + 1;
            return stack;
        })];
        _placeAt = _places.GroupBy(place => (place.X, place.Y)).ToDictionary(group => group.Key, group => group.First());
        // Read in the order the eye does: rows top to bottom, cells left to right.
        _marked =
        [
            .. _places.Where(place => place.Name is not null || place.Info.Count > 0 || place.Image is not null
                                      || place.Room is { } room && !(Layout.Rooms.TryGetValue(room, out var drawn) && drawn.Placed))
                .OrderByDescending(place => place.Y).ThenBy(place => place.X),
        ];
        _backdrop = Layout.IsGraph && Layout.Map.Size is [> 0, > 0, ..] && ImageUrlPolicy.IsRenderable(Layout.Map.Backdrop)
            ? ApiUrl.Resolve(Layout.Map.Backdrop!)
            : null;
        var route = (Route ?? []).Select(step => Pair(step.Source, step.Destination)).ToHashSet();
        var bounds = Layout.Bounds(Level);
        _empty = Editing && !Layout.IsGraph && Layout.Space is null ? EmptyCells() : [];
        if (_empty.Count > 0)
        {
            bounds = (Math.Min(bounds.Left, _empty.Min(c => c.X) * MapLayout.Cell), Math.Min(bounds.Top, _empty.Min(c => -(c.Y + 1)) * MapLayout.Cell),
                Math.Max(bounds.Right, (_empty.Max(c => c.X) + 1) * MapLayout.Cell), Math.Max(bounds.Bottom, -_empty.Min(c => c.Y) * MapLayout.Cell));
        }
        if (Editing && Layout.IsGraph && _backdrop is null)
        {
            var reach = Reach * MapLayout.GraphRoom;
            bounds = (bounds.Left - reach, bounds.Top - reach, bounds.Right + reach, bounds.Bottom + reach);
        }
        if (Layout.HasWays)
        {
            // Every graph map leaves the same room, so the drawing does not shift as ways scroll in and out of view. A way's name stands beside its line, and a way to another level reaches out of its place: room for both.
            bounds = (bounds.Left - WayRoom, bounds.Top - MapLayout.Cell, bounds.Right + WayRoom, bounds.Bottom + MapLayout.Cell);
        }
        (_left, _top) = (bounds.Left - Margin, bounds.Top - Margin);
        (_width, _height) = (bounds.Right - bounds.Left + 2 * Margin, bounds.Bottom - bounds.Top + 2 * Margin);

        var shown = _rooms.ToDictionary(room => room.Room.Id);
        var links = Layout.Map.Exits.Where(exit => exit.Destination is not null)
            .Select(exit => (exit.Source, To: exit.Destination!)).ToHashSet();
        _edges = [];
        _vertical.Clear();
        _doors.Clear();
        var drawn = new HashSet<(string, string)>();
        foreach (var exit in Layout.Map.Exits)
        {
            if (!shown.TryGetValue(exit.Source, out var from)) continue;
            if (exit.DestinationMap is not null) _doors.Add(exit.Source);
            if (exit.Destination is not { } to) continue;
            if (Layout.Rooms.TryGetValue(to, out var target) && target.Placed && from.Placed && target.Level != from.Level)
            {
                var up = target.Level > from.Level;
                var (u, d) = _vertical.GetValueOrDefault(exit.Source);
                _vertical[exit.Source] = (u || up, d || !up);
                continue;
            }
            if (!shown.TryGetValue(to, out var end) || to == exit.Source) continue;
            var pair = Pair(exit.Source, to);
            if (!drawn.Add(pair)) continue;
            var oneWay = !links.Contains((to, exit.Source));
            var (x1, y1) = Centre(from);
            var (x2, y2) = Centre(end);
            // A one-way line stops at the edge of the room it points to, so the arrow shows.
            if (oneWay) (x2, y2) = Toward(x1, y1, end);
            _edges.Add(new(x1, y1, x2, y2, oneWay, route.Contains(pair)));
        }
        // The route is drawn last, so no other line crosses it.
        _edges = [.. _edges.OrderBy(edge => edge.Route)];
    }

    /// <summary>The cells of this level no room covers, within one cell of its rooms (around 0, 0 when it has none).</summary>
    private List<(double X, double Y)> EmptyCells()
    {
        var boxes = Layout.On(Level).Select(Box).ToList();
        var ring = boxes.Count == 0 ? Ring((0, -1, 1, 1)).Prepend((Column: 0, Row: -1)) : boxes.SelectMany(Ring);
        // Rows top to bottom and cells left to right, so the buttons read in the order the eye does.
        return
        [
            .. ring.Distinct()
                .Where(cell => !boxes.Any(box => Covers(box, cell)))
                .OrderBy(cell => cell.Row).ThenBy(cell => cell.Column)
                .Select(cell => ((double)cell.Column, (double)(-cell.Row - 1))),
        ];

        // The cells a room covers, as its top-left cell and its width and height in cells.
        static (int Column, int Row, int Columns, int Rows) Box(MapPlacement room) =>
            ((int)Math.Round(room.X / MapLayout.Cell), (int)Math.Round(room.Y / MapLayout.Cell),
                Math.Max(1, (int)Math.Round(room.Width / MapLayout.Cell)), Math.Max(1, (int)Math.Round(room.Height / MapLayout.Cell)));

        static bool Covers((int Column, int Row, int Columns, int Rows) box, (int Column, int Row) cell) =>
            cell.Column >= box.Column && cell.Column < box.Column + box.Columns && cell.Row >= box.Row && cell.Row < box.Row + box.Rows;

        // The cells around a box, one deep, so a map of distant rooms asks for no more than its rooms' edges.
        static IEnumerable<(int Column, int Row)> Ring((int Column, int Row, int Columns, int Rows) box)
        {
            var (left, top, right, bottom) = (box.Column - 1, box.Row - 1, box.Column + box.Columns, box.Row + box.Rows);
            for (var column = left; column <= right; column++)
            {
                yield return (column, top);
                yield return (column, bottom);
            }
            for (var row = top + 1; row < bottom; row++)
            {
                yield return (left, row);
                yield return (right, row);
            }
        }
    }

    private string CellBox(double x, double y) =>
        $"left: {Percent(x * MapLayout.Cell + Inset - _left, _width)}%; top: {Percent(-(y + 1) * MapLayout.Cell + Inset - _top, _height)}%; " +
        $"width: {Percent(MapLayout.Cell - 2 * Inset, _width)}%; height: {Percent(MapLayout.Cell - 2 * Inset, _height)}%;";

    /// <summary>A click on the picture, in its own pixels.</summary>
    private Task PickAsync(MouseEventArgs click) =>
        OnCell.InvokeAsync((Math.Round(_left + click.OffsetX / Zoom), Math.Round(_top + click.OffsetY / Zoom)));

    /// <summary>The button over a place, inside the box its cell or hexagon fits in.</summary>
    private string PlaceButtonBox(int x, int y)
    {
        if (!Layout.IsHex) return CellBox(x, y);
        // A hexagon's button keeps clear of its sides, so their walls show.
        var (left, top, width, height) = Layout.HexInside(x, y);
        return $"left: {Percent(left - _left, _width)}%; top: {Percent(top - _top, _height)}%; " +
               $"width: {Percent(width, _width)}%; height: {Percent(height, _height)}%;";
    }

    /// <summary>A click on a world map: the place under it.</summary>
    private Task PickPlaceAsync(MouseEventArgs click)
    {
        var (x, y) = Layout.PlaceAt(_left + click.OffsetX / Zoom, _top + click.OffsetY / Zoom);
        return OnCell.InvokeAsync((x, y));
    }

    private static (string, string) Pair(string a, string b) => string.CompareOrdinal(a, b) < 0 ? (a, b) : (b, a);

    /// <summary>A room on a picture with no size of its own is a pin at its point, so the picture shows around it.</summary>
    private bool Pin(MapPlacement room) => _backdrop is not null && room.Placed && !room.Region && room.Room.Size is null;

    /// <summary>
    /// A zoom keeps the middle of the view where it was: the frame scrolls by as much as the drawing grew or shrank.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await WatchGesturesAsync();
        if (firstRender) await WatchViewAsync();
        var (drawn, anchor) = (_drawnZoom, _anchor);
        (_drawnZoom, _anchor) = (Zoom, null);
        if (drawn <= 0 || Zoom == drawn) return;
        try
        {
            if (anchor is var (x, y)) await JS.InvokeVoidAsync("SharpMUSH.mapRescale", _frame, Zoom / drawn, x, y);
            else await JS.InvokeVoidAsync("SharpMUSH.mapRescale", _frame, Zoom / drawn);
        }
        catch (JSException)
        {
            // No portal-interop.js (tests): the view stays where the browser left it.
        }
    }

    private async Task WatchGesturesAsync()
    {
        _self = DotNetObjectReference.Create(this);
        try
        {
            _gestures = await JS.InvokeAsync<IJSObjectReference?>("SharpMUSH.mapGestures", _frame, _self);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException)
        {
            // Without them the frame still scrolls, and the buttons still zoom.
        }
        if (_disposed) await ReleaseGesturesAsync();
    }

    private async Task WatchViewAsync()
    {
        if (!OnView.HasDelegate) return;
        _self ??= DotNetObjectReference.Create(this);
        try
        {
            _viewport = await JS.InvokeAsync<IJSObjectReference?>("SharpMUSH.mapViewport", _frame, _self);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException)
        {
            // No portal-interop.js (tests): the page reads the places around the map's middle once.
        }
        if (_disposed) await ReleaseGesturesAsync();
    }

    /// <summary>The view settled at (x, y), width by height, in the figure's pixels.</summary>
    [JSInvokable]
    public Task ViewAt(double x, double y, double width, double height) =>
        Zoom <= 0 ? Task.CompletedTask : OnView.InvokeAsync(Layout.PlacesIn(_left + x / Zoom, _top + y / Zoom,
            _left + (x + width) / Zoom, _top + (y + height) / Zoom));

    /// <summary>A pinch or Ctrl+wheel: zoom by <paramref name="factor"/>, holding still the point (x, y) of the frame.</summary>
    [JSInvokable]
    public Task ZoomAt(double factor, double x, double y)
    {
        _anchor = (x, y);
        return OnZoomAt.InvokeAsync(factor);
    }

    private async Task ReleaseGesturesAsync()
    {
        if (_viewport is { } viewport)
        {
            _viewport = null;
            try
            {
                await viewport.InvokeVoidAsync("dispose");
                await viewport.DisposeAsync();
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException)
            {
                // The page is already gone, and its listeners with it.
            }
        }
        if (_gestures is { } gestures)
        {
            _gestures = null;
            try
            {
                await gestures.InvokeVoidAsync("dispose");
                await gestures.DisposeAsync();
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException)
            {
                // The page is already gone, and its listeners with it.
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await ReleaseGesturesAsync();
        _self?.Dispose();
    }

    /// <summary>The zoom that shows the whole level in the frame; null until the frame is drawn.</summary>
    public async Task<double?> FitAsync()
    {
        double[]? size;
        try
        {
            size = await JS.InvokeAsync<double[]?>("SharpMUSH.mapFrameSize", _frame);
        }
        catch (JSException)
        {
            return null;
        }
        if (size is not [> 0 and var width, > 0 and var height] || _width <= 0 || _height <= 0) return null;
        return Math.Min(width / _width, height / _height);
    }

    /// <summary>
    /// How far apart a blank graph map's dots are drawn, in pixels: half a room, or two rooms once the map is far enough
    /// out that half a room is a few pixels and the dots would read as a texture.
    /// </summary>
    private double DotSpacing => MapLayout.GraphRoom * Zoom is var room && room < 24 ? room * 2 : room / 2;

    /// <summary>Where <paramref name="room"/>'s name goes at this zoom: inside it (null), on a label below, or nowhere.</summary>
    private string? Fit(MapPlacement room) => Pin(room) ? null : ((room.Width - 2 * Inset) * Zoom) switch
    {
        < LabelWidth => "map-room--tiny",
        < NameWidth => "map-room--small",
        _ => null,
    };

    /// <summary>Scrolls <paramref name="id"/>'s room to the middle of the view, and moves focus to it when <paramref name="focus"/>.</summary>
    public async Task CentreAsync(string id, bool focus = true)
    {
        if (!_buttons.TryGetValue(id, out var button)) return;
        try
        {
            await JS.InvokeVoidAsync("SharpMUSH.mapCentre", _frame, button, focus);
        }
        catch (JSException)
        {
            // No portal-interop.js (tests): focus alone brings the room into view.
            if (focus) await button.FocusAsync();
        }
    }

    private RenderFragment Vertical(MapPlacement room, (bool Up, bool Down) vertical) => __builder =>
    {
        var x = room.X + Inset + 10;
        var y = room.Y + Inset + 6;
        <g class="map-vertical">
            @if (vertical.Up)
            {
                <path d="@($"M{Num(x)},{Num(y + 8)} l5,-8 l5,8 z")" />
            }
            @if (vertical.Down)
            {
                <path d="@($"M{Num(x + 12)},{Num(y)} l5,8 l5,-8 z")" />
            }
        </g>
    };

    /// <summary>
    /// A wall or a locked way along its side of its cell, or, for a one-way edge, an arrow across the side pointing
    /// the way it may be passed. A wall between levels has no side on a drawing of one level.
    /// </summary>
    private RenderFragment Wall(MapWallDto wall) => __builder =>
    {
        var (left, top) = (wall.X * MapLayout.Cell, -(wall.Y + 1) * MapLayout.Cell);
        var (right, bottom) = (left + MapLayout.Cell, top + MapLayout.Cell);
        var side = Layout.IsHex ? Layout.HexEdge(wall.X, wall.Y, wall.Side) : wall.Side switch
        {
            "n" => (left, top, right, top, 0, -1),
            "e" => (right, top, right, bottom, 1, 0),
            "s" => (left, bottom, right, bottom, 0, 1),
            "w" => (left, top, left, bottom, -1, 0),
            _ => null,
        };
        if (side is not var (x1, y1, x2, y2, dx, dy)) return;
        if (wall.Kind == MapWallKinds.OneWay)
        {
            var (mx, my) = ((x1 + x2) / 2, (y1 + y2) / 2);
            <line class="map-oneway" x1="@Num(mx - dx * 16)" y1="@Num(my - dy * 16)" x2="@Num(mx + dx * 16)" y2="@Num(my + dy * 16)"
                  marker-end="@($"url(#{ArrowId})")" />
            return;
        }
        <line class="map-wall @(wall.Kind == MapWallKinds.Lock ? "map-wall--lock" : null)" x1="@Num(x1)" y1="@Num(y1)" x2="@Num(x2)" y2="@Num(y2)" />
    };

    /// <summary>
    /// A graph map's way: a line from the edge of the place it leads out of toward the place it leads to, with an arrow
    /// when there is no way back, its first name a third of the way along. A way with a way back keeps to its own side
    /// of the pair, so both show. A wall is drawn as a wall is, and a lock broken, as on a grid.
    /// </summary>
    private RenderFragment Way(MapLinkDto link) => __builder =>
    {
        var (fromX, fromY) = Layout.PlaceCentre(link.X, link.Y);
        var (toX, toY) = Layout.PlaceCentre(link.ToX, link.ToY);
        var (dx, dy) = (toX - fromX, toY - fromY);
        var length = Math.Sqrt(dx * dx + dy * dy);
        if (length < MapLayout.Cell) return;
        var (ux, uy) = (dx / length, dy / length);
        var back = _twoWay.Contains((link.ToX, link.ToY, link.X, link.Y));
        // The right of the direction of travel, on screen: (−uy, ux) with y down.
        var (sx, sy) = back ? (-uy * 5, ux * 5) : (0.0, 0.0);
        var reach = MapLayout.Cell / 2;
        var (x1, y1) = (fromX + ux * reach + sx, fromY + uy * reach + sy);
        var (x2, y2) = (toX - ux * reach + sx, toY - uy * reach + sy);
        var kind = link.Kind switch
        {
            MapWallKinds.Wall => "map-way--wall",
            MapWallKinds.Lock => "map-way--lock",
            _ => null,
        };
        <line class="map-way @kind" x1="@Num(x1)" y1="@Num(y1)" x2="@Num(x2)" y2="@Num(y2)"
              marker-end="@(back ? null : $"url(#{ArrowId})")">
            <title>@(link.Reason is { } reason ? $"{link.Names.Split(';')[0]}: {reason}" : link.Names.Split(';')[0])</title>
        </line>
        // The name stands off the right of its line, so a way and the way back each keep a side, and reads away from it.
        var (nx, ny) = (-uy, ux);
        var anchor = nx > 0.4 ? "start" : nx < -0.4 ? "end" : "middle";
        @SvgText("map-way-name", x1 + (x2 - x1) / 3 + nx * 12, y1 + (y2 - y1) / 3 + ny * 12, link.Names.Split(';')[0], anchor)
    };

    /// <summary>
    /// A way to a place on another level: a short arrow out of its place toward where the other lies, or up the page
    /// when it lies straight above and down when straight below, named with the level it leads to.
    /// </summary>
    private RenderFragment Climb(MapLinkDto link, int stack) => __builder =>
    {
        var (fromX, fromY) = Layout.PlaceCentre(link.X, link.Y);
        var (toX, toY) = Layout.PlaceCentre(link.ToX, link.ToY);
        var (dx, dy) = (toX - fromX, toY - fromY);
        var length = Math.Sqrt(dx * dx + dy * dy);
        var (ux, uy) = length < 1 ? (0.0, link.ToZ > Level ? -1.0 : 1.0) : (dx / length, dy / length);
        var (x1, y1) = (fromX + ux * MapLayout.Cell / 2, fromY + uy * MapLayout.Cell / 2);
        var (x2, y2) = (x1 + ux * MapLayout.Cell * 0.6, y1 + uy * MapLayout.Cell * 0.6);
        var kind = link.Kind switch
        {
            MapWallKinds.Wall => "map-way--wall",
            MapWallKinds.Lock => "map-way--lock",
            _ => null,
        };
        var name = link.Names.Split(';')[0];
        var level = Layout.Map.LevelNames.GetValueOrDefault(link.ToZ) is { Length: > 0 } named ? named : Loc["NavMapLevel", link.ToZ].Value;
        var label = Loc["NavMapWayToLevel", name, level].Value;
        <line class="map-way map-way--climb @kind" x1="@Num(x1)" y1="@Num(y1)" x2="@Num(x2)" y2="@Num(y2)" marker-end="url(#@ArrowId)">
            <title>@(link.Reason is { } reason ? $"{label}: {reason}" : label)</title>
        </line>
        // Beside the arrow, on its right, as a way's name is.
        var (nx, ny) = (-uy, ux);
        var anchor = nx > 0.4 ? "start" : nx < -0.4 ? "end" : "middle";
        // Ways that share an arrow stack their names under one another.
        @SvgText("map-way-name", (x1 + x2) / 2 + nx * 12, (y1 + y2) / 2 + ny * 12 + stack * 14, label, anchor)
    };

    /// <summary>
    /// The arrow a way to another level is drawn as: its place and its heading, rounded so that ways toward places
    /// lying the same way share it, or straight up or down for a place right above or below.
    /// </summary>
    private (int, int, int, int) Arrow(MapLinkDto link)
    {
        if (link.ToX == link.X && link.ToY == link.Y) return (link.X, link.Y, 0, link.ToZ > Level ? -1 : 1);
        var (fromX, fromY) = Layout.PlaceCentre(link.X, link.Y);
        var (toX, toY) = Layout.PlaceCentre(link.ToX, link.ToY);
        var angle = Math.Atan2(toY - fromY, toX - fromX);
        return (link.X, link.Y, (int)Math.Round(angle * 180 / Math.PI), 2);
    }

    /// <summary>A way as words: the place it leaves, its name, and the place or level it leads to.</summary>
    private string WayText(MapLinkDto link)
    {
        var name = link.Names.Split(';')[0];
        var to = link.ToZ != Level
            ? Layout.Map.LevelNames.GetValueOrDefault(link.ToZ) is { Length: > 0 } named ? named : Loc["NavMapLevel", link.ToZ].Value
            : PlaceAt(link.ToX, link.ToY);
        var text = $"{PlaceAt(link.X, link.Y)}: {Loc["NavMapWayLeads", name, to]}";
        return link.Kind is { } kind ? $"{text}, {Loc[$"NavMapSideState{kind}"]}{(link.Reason is { } reason ? $": {reason}" : null)}" : text;
    }

    /// <summary>A way's end as words: the place's own name or its room's, else its terrain and where it is.</summary>
    private string PlaceAt(int x, int y) =>
        _placeAt.GetValueOrDefault((x, y)) is not { } place ? Loc["NavMapCell", x, y].Value
        : place.Name ?? place.Label
          ?? (place.Room is { } room && Layout.Rooms.TryGetValue(room, out var drawn) ? drawn.Room.Name : null)
          ?? Loc["NavMapWayPlace", Terrain(place)?.Label ?? place.Type, x, y].Value;

    /// <summary>An SVG <c>text</c> element, which Razor markup reserves for its own use.</summary>
    private static RenderFragment SvgText(string className, double x, double y, string content, string? anchor = null) => builder =>
    {
        builder.OpenElement(0, "text");
        builder.AddAttribute(1, "class", className);
        builder.AddAttribute(2, "x", Num(x));
        builder.AddAttribute(3, "y", Num(y));
        builder.AddAttribute(4, "text-anchor", anchor);
        builder.AddContent(5, content);
        builder.CloseElement();
    };

    /// <summary>The legend entry for a place's terrain, when the legend names it.</summary>
    private MapLegendDto? Terrain(MapCellDto place) => _legend.GetValueOrDefault(place.Type);

    private string? Icon(MapCellDto place) => place.Icon ?? Terrain(place)?.Icon;

    private string? PlaceStyle(MapCellDto place) => MapLegendStyle.Style(place.Tone ?? Terrain(place)?.Tone);

    /// <summary>What a place is called: its own name, else its label, else its terrain's.</summary>
    private string PlaceName(MapCellDto place) => place.Name ?? place.Label ?? Terrain(place)?.Label ?? place.Type;

    /// <summary>The place's name, then its terrain, whether it is closed and why, and who is there, as a screen reader hears it.</summary>
    private string PlaceLabel(MapCellDto place) => string.Join(", ", new[]
    {
        PlaceName(place),
        place.Name is not null ? Terrain(place)?.Label : null,
        place.Closed ? place.Reason ?? Loc["NavMapClosed"].Value : null,
        place.People > 0 ? Loc["NavMapPeopleCount", place.People].Value : null,
    }.Where(part => part is not null).Distinct());

    private IEnumerable<(double X1, double Y1, double X2, double Y2)> GridLines()
    {
        var bounds = Layout.Bounds(Level, includeUnplaced: false, includePlaces: false);
        if (!Layout.On(Level).Any()) yield break;
        for (var x = bounds.Left; x <= bounds.Right + 0.5; x += MapLayout.Cell) yield return (x, bounds.Top, x, bounds.Bottom);
        for (var y = bounds.Top; y <= bounds.Bottom + 0.5; y += MapLayout.Cell) yield return (bounds.Left, y, bounds.Right, y);
    }

    /// <summary>The legend entry for <paramref name="room"/>'s kind, when it has one and the legend names it.</summary>
    private MapLegendDto? Kind(MapPlacement room) =>
        room.Room.Environment is { } environment && _legend.TryGetValue(environment, out var entry) ? entry : null;

    /// <summary>The room's name, then its kind and whether the reader is in it, as a screen reader hears it.</summary>
    private string Label(MapPlacement room, bool here) => string.Join(", ", new[]
    {
        room.Room.Name,
        Kind(room)?.Label,
        room.Room.People.Count > 0 ? Loc["NavMapPeopleCount", room.Room.People.Count].Value : null,
        here ? Loc["NavMapYouAreHere"].Value : null,
    }.Where(part => part is not null));

    private string RoomClass(MapPlacement room) => string.Join(' ', new[]
    {
        "map-box",
        room.Placed ? null : "map-box--unplaced",
        room.Region ? "map-box--region" : null,
        room.Room.Id == Layout.Map.Here || room.Room.Id == Layout.Map.HereRegion ? "map-box--here" : null,
        room.Room.Id == Selected ? "map-box--selected" : null,
        Route?.Any(step => step.Destination == room.Room.Id) == true ? "map-box--route" : null,
        MapLegendStyle.Style(Kind(room)) is not null ? "map-box--toned" : null,
    }.Where(c => c is not null));

    private static (double X, double Y) Centre(MapPlacement room) => (room.X + room.Width / 2, room.Y + room.Height / 2);

    /// <summary>Where the line from (x, y) to <paramref name="room"/>'s centre meets its box.</summary>
    private static (double X, double Y) Toward(double x, double y, MapPlacement room)
    {
        var (cx, cy) = Centre(room);
        var (dx, dy) = (cx - x, cy - y);
        var halfW = room.Width / 2 - Inset;
        var halfH = room.Height / 2 - Inset;
        var scale = Math.Max(Math.Abs(dx) / Math.Max(halfW, 1), Math.Abs(dy) / Math.Max(halfH, 1));
        return scale <= 1 ? (cx, cy) : (cx - dx / scale, cy - dy / scale);
    }

    private string Box(MapPlacement room) =>
        $"left: {Percent(room.X + Inset - _left, _width)}%; top: {Percent(room.Y + Inset - _top, _height)}%; " +
        $"width: {Percent(room.Width - 2 * Inset, _width)}%; height: {Percent(room.Height - 2 * Inset, _height)}%;";

    private static string Percent(double at, double of) => Num(of <= 0 ? 0 : at / of * 100);

    private static string Px(double value) => Num(value) + "px";

    private static string Points(IEnumerable<(double X, double Y)> points) =>
        string.Join(' ', points.Select(point => $"{Num(point.X)},{Num(point.Y)}"));

    private static string Num(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);
}
