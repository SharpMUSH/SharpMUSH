@using SharpMUSH.Client.Services
@using SharpMUSH.Library.Models.Portal
@inject ICommFeed Feed
@inject ChannelBrowserService Commands
@inject IStringLocalizer<SharedResource> Loc
@implements IDisposable

@* The Play drawer's channel browser, as Discord's channel toggles: every channel the comm-feed package's
   comm.channels lists (the ones the character may see, joined or not), a switch to be on it or not, and a
   bell to gag one they are on. Each change is the @channel command a player would type, so the game's join
   rules and messages apply; the push that follows updates the list. *@
<div class="chan-browse" role="group" aria-label="@Loc["NavPlayChannelsBrowse"]">
    @if (Feed.Channels.Count == 0)
    {
        <SidebarNote Class="chan-browse-none">@Loc["NavPlayChannelsNone"]</SidebarNote>
    }
    @foreach (var listed in Feed.Channels)
    {
        var channel = Shown(listed);
        var name = channel.Name;
        var busy = _busy == name;
        <div class="chan-browse-row @(channel.Joined ? "chan-browse-row--on" : null)" data-channel="@name">
            <div class="chan-browse-text">
                <span class="chan-browse-name">#@name</span>
                @if (!string.IsNullOrWhiteSpace(channel.Description))
                {
                    <span class="chan-browse-desc">@channel.Description</span>
                }
                @if (channel.Members is { } members)
                {
                    <span class="chan-browse-count">@Loc.Plural("NavPlayChannelsMembers", "count", members)</span>
                }
            </div>
            @if (channel.Joined)
            {
                <button type="button" class="chan-browse-gag" aria-pressed="@(channel.Gagged ? "true" : "false")"
                        aria-label="@Loc["NavPlayChannelsGag", name]" title="@(channel.Gagged ? Loc["NavPlayChannelsGagged"] : Loc["NavPlayChannelsGagHint"])"
                        disabled="@busy" @onclick="() => GagAsync(channel)">
                    <MudIcon Icon="@(channel.Gagged ? Icons.Material.Outlined.NotificationsOff : Icons.Material.Outlined.Notifications)" Size="Size.Small" />
                </button>
            }
            <button type="button" role="switch" class="chan-browse-switch" aria-checked="@(channel.Joined ? "true" : "false")"
                    aria-label="@Loc["NavPlayChannelsJoin", name]" disabled="@busy" @onclick="() => ToggleAsync(channel)">
                <span class="chan-browse-thumb"></span>
            </button>
        </div>
    }
    @if (_error is not null)
    {
        <SidebarNote Class="chan-browse-error">@_error</SidebarNote>
    }
</div>

@code {
    private string? _error;

    /// <summary>The channel a command is running for; its controls wait for it.</summary>
    private string? _busy;

    /// <summary>
    /// A change the game made that the next <c>comm.channels</c> push has not shown yet, by channel: shown in
    /// its place until a push agrees with it, so the switch does not flick back while the push is on its way.
    /// </summary>
    private readonly Dictionary<string, (bool Joined, bool Gagged)> _made = new(StringComparer.Ordinal);

    protected override void OnInitialized() => Feed.Changed += OnFeedChanged;

    private CommChannel Shown(CommChannel listed) =>
        _made.TryGetValue(listed.Name, out var made) ? listed with { Joined = made.Joined, Gagged = made.Gagged } : listed;

    private void OnFeedChanged() => _ = InvokeAsync(() =>
    {
        var confirmed = Feed.Channels
            .Where(channel => _made.TryGetValue(channel.Name, out var made) && made == (channel.Joined, channel.Gagged))
            .Select(channel => channel.Name)
            .ToList();
        foreach (var name in confirmed)
        {
            _made.Remove(name);
        }
        StateHasChanged();
    });

    private Task ToggleAsync(CommChannel channel) =>
        RunAsync(channel, channel.Joined ? Commands.LeaveAsync(channel.Name) : Commands.JoinAsync(channel.Name),
            standing => standing.Joined != channel.Joined);

    private Task GagAsync(CommChannel channel) =>
        RunAsync(channel, Commands.GagAsync(channel.Name, !channel.Gagged), standing => standing.Gagged != channel.Gagged);

    /// <summary>
    /// Runs the command and reads the character's standing straight after it. A standing that did not change
    /// is a refusal, and what the command said is why (a join lock, a channel that will not take them).
    /// </summary>
    private async Task RunAsync(CommChannel channel, Task<ApiResult<PortalCommandResponse>> command,
        Func<(bool Joined, bool Gagged), bool> changed)
    {
        _busy = channel.Name;
        _error = null;
        try
        {
            switch (await command)
            {
                case ApiFailure failure:
                    _error = failure.Message;
                    break;
                case PortalCommandResponse response when ChannelBrowserService.ReadStanding(response.Result) is var standing:
                    if (changed(standing))
                    {
                        _made[channel.Name] = standing;
                    }
                    else
                    {
                        _error = response.Output.Count > 0 ? string.Join(" ", response.Output) : Loc["NavPlayChannelsUnchanged"];
                    }
                    break;
            }
        }
        finally
        {
            _busy = null;
        }
    }

    public void Dispose() => Feed.Changed -= OnFeedChanged;
}
