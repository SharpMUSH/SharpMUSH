@using SharpMUSH.Client.Models
@using SharpMUSH.Client.Services
@using System.Net
@using SharpMUSH.Library.DiscriminatedUnions
@inject IStringLocalizer<SharedResource> Loc
@inject HighlightRules Rules
@inject TerminalAlerts Alerts

@* Play's highlight rules, as a list the player edits and then saves to the account (HighlightRules). Each rule is a
   card: what to look for and how to read it, which lines, and what a match does. A line typed in "Try a line"
   shows what the unsaved rules would do to it. *@
<MudDialog Class="hl-dialog">
    <DialogContent>
        <div class="hl-body">
            <p class="hl-intro">@Loc["TermHlIntro"]</p>

            @if (_permission is NotificationPermission.Default && _draft.Any(r => r.Notify))
            {
                <div class="hl-notice" role="status">
                    <span>@Loc["TermHlAllowNotifications"]</span>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="AskPermissionAsync">@Loc["TermHlAllow"]</MudButton>
                </div>
            }
            else if (_permission is NotificationPermission.Denied && _draft.Any(r => r.Notify))
            {
                <div class="hl-notice hl-notice-warn" role="status">@Loc["TermHlNotificationsBlocked"]</div>
            }
            else if (_permission is NotificationPermission.Unsupported && _draft.Any(r => r.Notify))
            {
                <div class="hl-notice hl-notice-warn" role="status">@Loc["TermHlNotificationsUnsupported"]</div>
            }

            @if (_draft.Count == 0)
            {
                <p class="hl-empty">@Loc["TermHlEmpty"]</p>
            }

            <ol class="hl-list" aria-label="@Loc["TermHlRules"]">
                @for (var i = 0; i < _draft.Count; i++)
                {
                    var at = i;
                    var rule = _draft[at];
                    HighlightProblem? problem = HighlightMatcher.Validate(rule.ToRule()) is HighlightProblem found ? found : null;
                    var error = problem is HighlightProblem.Empty or HighlightProblem.TooLong or HighlightProblem.NotARegex ? Problem(problem.Value) : null;
                    <li @key="rule.Id" class="hl-rule @(rule.Enabled ? null : "hl-rule-off")">
                        <div class="hl-row hl-row-pattern">
                            <MudCheckBox T="bool" Value="rule.Enabled" ValueChanged="v => rule.Enabled = v" Dense="true"
                                         aria-label="@Loc["TermHlEnabled"]" title="@Loc["TermHlEnabled"]" Class="hl-check" />
                            <MudTextField T="string" Value="rule.Pattern" ValueChanged="v => rule.Pattern = v ?? string.Empty" Immediate="true"
                                          Label="@Loc["TermHlPattern"]" Placeholder="@Loc["TermHlPatternExample"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                          MaxLength="HighlightRule.MaxPatternLength" Error="@(error is not null && rule.Touched)" ErrorText="@error"
                                          OnBlur="() => rule.Touched = true" Class="hl-pattern" />
                            <MudSelect T="HighlightMatch" Value="rule.Match" ValueChanged="v => rule.Match = v" Label="@Loc["TermHlMatch"]"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="hl-match">
                                <MudSelectItem Value="HighlightMatch.Words">@Loc["TermHlMatchWords"]</MudSelectItem>
                                <MudSelectItem Value="HighlightMatch.Contains">@Loc["TermHlMatchContains"]</MudSelectItem>
                                <MudSelectItem Value="HighlightMatch.StartsWith">@Loc["TermHlMatchStartsWith"]</MudSelectItem>
                                <MudSelectItem Value="HighlightMatch.Glob">@Loc["TermHlMatchGlob"]</MudSelectItem>
                                <MudSelectItem Value="HighlightMatch.Regex">@Loc["TermHlMatchRegex"]</MudSelectItem>
                            </MudSelect>
                            <MudCheckBox T="bool" Value="rule.CaseSensitive" ValueChanged="v => rule.CaseSensitive = v" Dense="true"
                                         Label="@Loc["TermHlMatchCase"]" Class="hl-case hl-check" />
                            <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" OnClick="() => Remove(at)"
                                           aria-label="@Loc["TermHlRemove"]" title="@Loc["TermHlRemove"]" Class="hl-remove" />
                        </div>
                        <div class="hl-row hl-row-effects">
                            <MudSelect T="HighlightLines" Value="rule.Lines" ValueChanged="v => rule.Lines = v" Label="@Loc["TermHlLines"]"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                <MudSelectItem Value="HighlightLines.All">@Loc["TermHlLinesAll"]</MudSelectItem>
                                <MudSelectItem Value="HighlightLines.Pages">@Loc["TermHlLinesPages"]</MudSelectItem>
                                <MudSelectItem Value="HighlightLines.Channels">@Loc["TermHlLinesChannels"]</MudSelectItem>
                                <MudSelectItem Value="HighlightLines.Other">@Loc["TermHlLinesOther"]</MudSelectItem>
                            </MudSelect>
                            <MudSelect T="HighlightTarget" Value="rule.Target" ValueChanged="v => rule.Target = v" Label="@Loc["TermHlTarget"]"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="hl-target">
                                <MudSelectItem Value="HighlightTarget.Line">@Loc["TermHlTargetLine"]</MudSelectItem>
                                <MudSelectItem Value="HighlightTarget.Match">@Loc["TermHlTargetMatch"]</MudSelectItem>
                                <MudSelectItem Value="HighlightTarget.Group">@Loc["TermHlTargetGroup"]</MudSelectItem>
                            </MudSelect>
                            @if (rule.Target == HighlightTarget.Group)
                            {
                                <MudTextField T="string" Value="rule.Group" ValueChanged="v => rule.Group = v ?? string.Empty" Immediate="true"
                                              Label="@Loc["TermHlGroup"]" Placeholder="1" Variant="Variant.Outlined" Margin="Margin.Dense"
                                              MaxLength="32" Error="@(problem is HighlightProblem.NoSuchGroup)" Class="hl-group" />
                            }
                            <MudSelect T="HighlightColour" Value="rule.Colour" ValueChanged="v => rule.Colour = v" Label="@Loc["TermHlColour"]"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                @foreach (var colour in Enum.GetValues<HighlightColour>())
                                {
                                    <MudSelectItem Value="colour">
                                        <span class="hl-swatch @SwatchClass(colour)" aria-hidden="true"></span>@ColourName(colour)
                                    </MudSelectItem>
                                }
                            </MudSelect>
                            @* Toggles shown in the style they apply, as a text editor's are. *@
                            <div class="hl-styles" role="group" aria-label="@Loc["TermHlStyle"]">
                                @foreach (var style in Styles)
                                {
                                    var on = rule.Style.HasFlag(style);
                                    <button type="button" class="@($"hl-style hl-style-{style.ToString().ToLowerInvariant()}{(on ? " hl-style-on" : "")}")"
                                            aria-pressed="@(on ? "true" : "false")" aria-label="@Loc[$"TermHlStyle{style}"]" title="@Loc[$"TermHlStyle{style}"]"
                                            @onclick="() => rule.SetStyle(style, !on)">@StyleLetter(style)</button>
                                }
                            </div>
                            <div class="hl-sound">
                                <MudSelect T="HighlightSound" Value="rule.Sound" ValueChanged="v => SetSoundAsync(rule, v)" Label="@Loc["TermHlSound"]"
                                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                    @foreach (var sound in Enum.GetValues<HighlightSound>())
                                    {
                                        <MudSelectItem Value="sound">@SoundName(sound)</MudSelectItem>
                                    }
                                </MudSelect>
                                <MudIconButton Icon="@Icons.Material.Outlined.PlayArrow" Size="Size.Small" Disabled="@(rule.Sound == HighlightSound.None)"
                                               OnClick="() => Alerts.PreviewAsync(rule.Sound)" aria-label="@Loc["TermHlPreviewSound"]" title="@Loc["TermHlPreviewSound"]" />
                            </div>
                            <MudCheckBox T="bool" Value="rule.Notify" ValueChanged="v => SetNotifyAsync(rule, v)" Dense="true" Label="@Loc["TermHlNotify"]" Class="hl-check" />
                        </div>
                        @if (problem is HighlightProblem.NoSuchGroup)
                        {
                            @* Under the row, not under the narrow group field, so it reads as a sentence. *@
                            <p class="hl-error" role="alert">@Loc["TermHlErrNoGroup", rule.Group.Trim()]</p>
                        }
                        <button type="button" class="hl-advanced-toggle" aria-expanded="@(rule.ShowAdvanced ? "true" : "false")"
                                @onclick="() => rule.ShowAdvanced = !rule.ShowAdvanced">
                            <MudIcon Icon="@(rule.ShowAdvanced ? Icons.Material.Outlined.ExpandLess : Icons.Material.Outlined.ExpandMore)" Size="Size.Small" />
                            @Loc["TermHlAdvanced"]
                        </button>
                        @if (rule.ShowAdvanced)
                        {
                            <div class="hl-advanced">
                                <div class="hl-row">
                                    <MudSelect T="HighlightPaint" Value="rule.Paint" ValueChanged="v => rule.Paint = v" Label="@Loc["TermHlPaint"]"
                                               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="hl-paint">
                                        <MudSelectItem Value="HighlightPaint.Tint">@Loc["TermHlPaintTint"]</MudSelectItem>
                                        <MudSelectItem Value="HighlightPaint.Text">@Loc["TermHlPaintText"]</MudSelectItem>
                                    </MudSelect>
                                </div>
                                <MudTextField T="string" Value="rule.Rewrite" ValueChanged="v => rule.Rewrite = v ?? string.Empty" Immediate="true"
                                              Label="@Loc["TermHlRewrite"]" Placeholder="[OOC] $1" HelperText="@Loc["TermHlRewriteHelp"]"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="HighlightRule.MaxRewriteLength" Error="@(problem is HighlightProblem.RewriteTooLong)"
                                              ErrorText="@Loc["TermHlErrRewriteTooLong", HighlightRule.MaxRewriteLength]" Class="hl-rewrite" />
                                <div class="hl-row">
                                    <MudCheckBox T="bool" Value="rule.Hide" ValueChanged="v => rule.Hide = v" Dense="true" Label="@Loc["TermHlHide"]" Class="hl-check" />
                                    <MudCheckBox T="bool" Value="rule.Stop" ValueChanged="v => rule.Stop = v" Dense="true" Label="@Loc["TermHlStop"]" Class="hl-check" />
                                </div>
                            </div>
                        }
                        @if (!rule.ToRule().HasEffect)
                        {
                            <p class="hl-hint">@Loc["TermHlDoesNothing"]</p>
                        }
                    </li>
                }
            </ol>

            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Add" OnClick="Add"
                       Disabled="@(_draft.Count >= HighlightRule.MaxRules)">@Loc["TermHlAdd"]</MudButton>

            <div class="hl-try">
                <MudTextField T="string" @bind-Value="_sample" Immediate="true" Label="@Loc["TermHlTry"]" Placeholder="@Loc["TermHlTryExample"]"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
                @if (!string.IsNullOrWhiteSpace(_sample))
                {
                    @if (new HighlightMatcher(_draft.Select(d => d.ToRule())).Match(_sample, TerminalLineComm.None) is HighlightHit hit)
                    {
                        <div class="hl-sample sharp-terminal-output">
                            <div class="terminal-line @hit.Line.Classes(line: true) @(hit.Hide ? "hl-sample-hidden" : null)">@Preview(hit)</div>
                        </div>
                        <p class="hl-try-result" role="status">@Loc["TermHlTryMatched", hit.Rule.Pattern, Effects(hit)]@(hit.Hide ? " " + Loc["TermHlTryHidden"] : null)</p>
                    }
                    else
                    {
                        <p class="hl-try-result" role="status">@Loc["TermHlTryNoMatch"]</p>
                    }
                }
            </div>

            @if (_failed is { } failed)
            {
                <p class="hl-error" role="alert">@(failed == HighlightSave.TooLarge ? Loc["TermHlTooLarge"] : Loc["TermHlSaveFailed"])</p>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel">@Loc["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_saving">@Loc["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private List<Draft> _draft = [];
    private string? _sample;
    private bool _saving;
    private HighlightSave? _failed;
    private NotificationPermission _permission = NotificationPermission.Granted;

    protected override async Task OnInitializedAsync()
    {
        _draft = Rules.Rules.Select(Draft.From).ToList();
        _permission = await Alerts.PermissionAsync();
    }

    private bool Valid => _draft.All(d => HighlightMatcher.Validate(d.ToRule()) is NotFound);

    private void Add() => _draft.Add(Draft.From(HighlightRule.Create(string.Empty)));

    private void Remove(int at) => _draft.RemoveAt(at);

    private async Task SetSoundAsync(Draft rule, HighlightSound sound)
    {
        rule.Sound = sound;
        // Choosing a sound plays it: the click that chose it lets the browser play.
        await Alerts.PreviewAsync(sound);
    }

    private async Task SetNotifyAsync(Draft rule, bool notify)
    {
        rule.Notify = notify;
        // Asked from the click that turned it on, which is when a browser lets a page ask.
        if (notify && _permission is NotificationPermission.Default)
            await AskPermissionAsync();
    }

    private async Task AskPermissionAsync() => _permission = await Alerts.RequestPermissionAsync();

    private async Task SaveAsync()
    {
        foreach (var rule in _draft) rule.Touched = true;
        if (!Valid) return;
        _saving = true;
        _failed = null;
        var saved = await Rules.SaveAsync(_draft.Select(d => d.ToRule()).ToList());
        _saving = false;
        if (saved == HighlightSave.Saved)
            MudDialog.Close(DialogResult.Ok(true));
        else
            _failed = saved;
    }

    private void Cancel() => MudDialog.Cancel();

    private static string SwatchClass(HighlightColour colour) =>
        colour == HighlightColour.None ? "hl-swatch-none" : $"terminal-hl-{colour.ToString().ToLowerInvariant()}";

    private string Problem(HighlightProblem problem) => problem switch
    {
        HighlightProblem.Empty => Loc["TermHlErrEmpty"],
        HighlightProblem.TooLong => Loc["TermHlErrTooLong", HighlightRule.MaxPatternLength],
        HighlightProblem.RewriteTooLong => Loc["TermHlErrRewriteTooLong", HighlightRule.MaxRewriteLength],
        _ => Loc["TermHlErrRegex"]
    };

    private string ColourName(HighlightColour colour) => Loc[$"TermHlColour{colour}"];

    private string SoundName(HighlightSound sound) => Loc[$"TermHlSound{sound}"];

    private static readonly HighlightStyle[] Styles = [HighlightStyle.Bold, HighlightStyle.Italic, HighlightStyle.Underline, HighlightStyle.Strike];

    private static string StyleLetter(HighlightStyle style) => style switch
    {
        HighlightStyle.Bold => "B",
        HighlightStyle.Italic => "i",
        HighlightStyle.Underline => "u",
        _ => "S"
    };

    /// <summary>The sample line as the terminal would show it, its marks and rewrites in place.</summary>
    private MarkupString Preview(HighlightHit hit)
    {
        var html = WebUtility.HtmlEncode(_sample ?? string.Empty);
        return (MarkupString)(HighlightHtml.Apply(html, _sample ?? string.Empty, hit) is string marked ? marked : html);
    }

    private string Effects(HighlightHit hit)
    {
        var colour = hit.Line.Colour != HighlightColour.None ? hit.Line.Colour
            : hit.Marks.Select(m => m.Look.Colour).FirstOrDefault(c => c != HighlightColour.None);
        var styled = hit.Line.Style != HighlightStyle.None || hit.Marks.Any(m => m.Look.Style != HighlightStyle.None);
        return string.Join(", ", new[]
        {
            colour == HighlightColour.None ? null : ColourName(colour),
            styled ? Loc["TermHlEffectStyled"].Value : null,
            hit.Rewrite is not null || hit.Marks.Any(m => m.Rewrite is not null) ? Loc["TermHlEffectRewritten"].Value : null,
            hit.Sound == HighlightSound.None ? null : SoundName(hit.Sound),
            hit.Notify ? Loc["TermHlNotify"].Value : null,
            hit.Hide ? Loc["TermHlEffectHidden"].Value : null
        }.OfType<string>());
    }

    /// <summary>A rule as the dialog edits it, until Save.</summary>
    private sealed class Draft
    {
        public required string Id { get; init; }
        public string Pattern { get; set; } = string.Empty;
        public HighlightMatch Match { get; set; }
        public bool CaseSensitive { get; set; }
        public HighlightLines Lines { get; set; }
        public HighlightColour Colour { get; set; }
        public HighlightSound Sound { get; set; }
        public bool Notify { get; set; }
        public bool Enabled { get; set; }
        public HighlightTarget Target { get; set; }
        public string Group { get; set; } = "1";
        public HighlightPaint Paint { get; set; }
        public HighlightStyle Style { get; set; }
        public bool Hide { get; set; }
        public string Rewrite { get; set; } = string.Empty;
        public bool Stop { get; set; }

        /// <summary>The rule's Advanced choices are shown.</summary>
        public bool ShowAdvanced { get; set; }

        public void SetStyle(HighlightStyle style, bool on) => Style = on ? Style | style : Style & ~style;

        /// <summary>The player has left the pattern field, so a problem with it may be shown.</summary>
        public bool Touched { get; set; }

        public static Draft From(HighlightRule rule) => new()
        {
            Id = rule.Id,
            Pattern = rule.Pattern ?? string.Empty,
            Match = rule.Match,
            CaseSensitive = rule.CaseSensitive,
            Lines = rule.Lines,
            Colour = rule.Colour,
            Sound = rule.Sound,
            Notify = rule.Notify,
            Enabled = rule.Enabled,
            Target = rule.Target,
            Group = string.IsNullOrWhiteSpace(rule.Group) ? "1" : rule.Group,
            Paint = rule.Paint,
            Style = rule.Style,
            Hide = rule.Hide,
            Rewrite = rule.Rewrite ?? string.Empty,
            Stop = rule.Stop,
            ShowAdvanced = rule.Paint != HighlightPaint.Tint || rule.Hide || rule.Stop
                || !string.IsNullOrEmpty(rule.Rewrite),
            Touched = !string.IsNullOrEmpty(rule.Pattern)
        };

        public HighlightRule ToRule() => new(Id, Pattern, Match, CaseSensitive, Lines, Colour, Sound, Notify, Enabled,
            Target, Target == HighlightTarget.Group && Group.Trim() is { Length: > 0 } group ? group : null, Paint, Style, Hide,
            Rewrite.Length > 0 ? Rewrite : null, Stop);
    }
}
