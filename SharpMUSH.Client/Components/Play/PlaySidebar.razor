@using SharpMUSH.Client.Components.Scenes
@using SharpMUSH.Client.Models
@using SharpMUSH.Client.Services
@inherits SharpMUSH.Client.Components.Play.PlaySessionComponent
@inject CommGroups Groups
@inject CharacterDirectoryService Directory
@inject ApplicationRegistryClient Registry
@using SharpMUSH.Client.Models.Applications
@inject IStringLocalizer<SharedResource> Loc
@inject IServiceProvider Provider
@implements IDisposable

@* D1 §5.1 Play page sidebar (boards 01, 07): "Play · ● Connected as {name}", then In scene (a row per scene
   running in the room: the room's picture, the scene's title and its cast), Channels (# rows, bold with an unread pill) and Pages (one
   row per conversation: a portrait, or a stacked pair for a group page, ringed while that person is connected,
   dimmed while not, as the online list read every half minute says). Channels and pages come from
   the comm feed (§7.3). An empty group still shows its label and a line saying what will be there, so a
   new player learns the drawer holds scenes, channels and pages; the Scenes line only while the game has
   the Scene System. Channels' heading carries Browse, which shows the channel browser in place of the
   channel rows: every channel the character may see, with switches to join, leave and gag. The account's channel
   groups come first under Channels, each a row that opens one view over its channels, its unread count theirs
   together; while browsing, each group has an edit button and New group makes one. Collapsed keeps only the leads,
   so it drops an empty group. *@
<div class="play-side @(Collapsed ? "play-side--collapsed" : null)">
    @if (!Collapsed)
    {
        <SidebarHead Title="@Loc["Play"]">
            <Sub>
                <StatusDot On="@Connected" />
                <span>@(!Connected ? Loc["Disconnected"] : string.IsNullOrWhiteSpace(CharacterName) ? Loc["Connected"] : Loc["NavPlayConnectedAs", CharacterName])</span>
            </Sub>
        </SidebarHead>
    }
    @if (Room is { RunningScenes.Count: > 0 } withScenes)
    {
        @if (!Collapsed)
        {
            <SectionLabel>@Loc["NavPlayInScene"]</SectionLabel>
        }
        @* One row per scene running in the room: a room can run several at once. *@
        <nav class="play-side-scene" aria-label="@Loc["NavPlayInScene"]">
            @foreach (var scene in withScenes.RunningScenes)
            {
                var id = scene.Id;
                var state = StateOf(scene);
                <SidebarRow Lead="SidebarRow.SidebarLead.Image" ImageUrl="@withScenes.Image?.Url" Name="@SceneTitle(scene)"
                            Label="@SceneTitle(scene)" Count="@scene.Cast" IsCurrent="@(Current is null && id == withScenes.Scene?.Id)"
                            Class="@(state is null ? null : $"play-side-scene-row play-side-scene-row--{state.Value.Key}")"
                            SubContent="@(state is { } shown ? SceneStatus(shown) : null)" SubContentText="@state?.Text"
                            Collapsed="@Collapsed" OnClick="@(() => OnOpenScene.InvokeAsync(id))" />
            }
        </nav>
    }
    else if (Room is { } here)
    {
        @* No scene here: the room the play terminal is in, the way back to it from a channel or a conversation. *@
        <nav class="play-side-room" aria-label="@Loc["NavPlayBackToGame"]">
            <SidebarRow Lead="@(here.Image?.Url is { Length: > 0 } ? SidebarRow.SidebarLead.Image : SidebarRow.SidebarLead.Icon)"
                        ImageUrl="@here.Image?.Url" Icon="@Icons.Material.Outlined.Terminal" Name="@here.Name"
                        Label="@(string.IsNullOrWhiteSpace(here.Name) ? Loc["NavPlayTerminal"].Value : here.Name)"
                        IsCurrent="@(Current == string.Empty)" Collapsed="@Collapsed" OnClick="OnOpenGame" />
        </nav>
    }
    @if (Room is not { RunningScenes.Count: > 0 } && !Collapsed)
    {
        <FeatureGate Feature="@GameFeatures.Scenes">
            <SectionLabel>@Loc["NavPlayScenes"]</SectionLabel>
            <EmptyState Compact="true" Class="play-side-empty play-side-scene-empty" Icon="@Icons.Material.Outlined.TheaterComedy">@Loc["NavPlayScenesEmpty"]</EmptyState>
            @* scene-rooms: the Scenes page's start form, set to run the scene in a copy of this room. *@
            @if (CanCopyRoom)
            {
                <a class="play-side-scene-copy" href="@($"/scenes?{ScenesFilter.StartCopyQuery}")">
                    <MudIcon Icon="@Icons.Material.Outlined.ContentCopy" Size="Size.Small" />
                    <span>@Loc["NavPlayScenesStartCopy"]</span>
                </a>
            }
        </FeatureGate>
    }
    @if (!Collapsed)
    {
        <div class="play-side-head">
            <SectionLabel>@Loc["NavPlayChannels"]</SectionLabel>
            <button type="button" class="play-side-browse" aria-expanded="@(_browsing ? "true" : "false")"
                    aria-label="@(_browsing ? Loc["NavPlayChannelsBrowseClose"] : Loc["NavPlayChannelsBrowse"])"
                    @onclick="@(() => _browsing = !_browsing)">
                <MudIcon Icon="@(_browsing ? Icons.Material.Outlined.Check : Icons.Material.Outlined.PlaylistAdd)" Size="Size.Small" />
                <span>@(_browsing ? Loc["NavPlayChannelsDone"] : Loc["NavPlayChannelsBrowseShort"])</span>
            </button>
        </div>
    }
    @if (!Collapsed && _browsing)
    {
        @* Existing groups stay editable with no channels to list; a new group needs channels to choose from. *@
        @if (Feed.Channels.Count > 0 || Groups.Groups.Count > 0)
        {
            <div class="play-side-groups-edit" role="group" aria-label="@Loc["NavPlayGroups"]">
                @foreach (var group in Groups.Groups)
                {
                    var editing = group;
                    <div class="play-side-group-edit-row">
                        <MudIcon Icon="@GroupIcon" Size="Size.Small" />
                        <span class="play-side-group-edit-name">@group.Name</span>
                        <button type="button" class="play-side-group-edit" aria-label="@Loc["NavPlayGroupEdit", group.Name]"
                                title="@Loc["NavPlayGroupEdit", group.Name]" @onclick="() => OpenEditor(editing)">
                            <MudIcon Icon="@Icons.Material.Outlined.Tune" Size="Size.Small" />
                        </button>
                    </div>
                }
                @if (Feed.Channels.Count > 0)
                {
                    <button type="button" class="play-side-group-new" disabled="@(Groups.Groups.Count >= CommGroup.GroupLimit)"
                            @onclick="() => OpenEditor(null)">
                        <MudIcon Icon="@Icons.Material.Outlined.Add" Size="Size.Small" />
                        <span>@Loc["NavPlayGroupNew"]</span>
                    </button>
                }
            </div>
        }
        <ChannelBrowser />
    }
    else if (Channels.Count > 0 || Groups.Groups.Count > 0)
    {
        <nav class="play-side-channels" aria-label="@Loc["NavPlayChannels"]">
            @foreach (var group in Groups.Groups)
            {
                var key = group.Key;
                var named = group;
                @* A category, as Discord's: its heading opens the merged view, its chevron folds its channels away. *@
                var shown = !group.Folded && !Collapsed;
                <div class="play-side-category">
                    @if (!Collapsed)
                    {
                        <button type="button" class="play-side-fold" aria-expanded="@(shown ? "true" : "false")"
                                aria-label="@Loc[shown ? "NavPlayGroupFold" : "NavPlayGroupUnfold", group.Name]"
                                title="@Loc[shown ? "NavPlayGroupFold" : "NavPlayGroupUnfold", group.Name]"
                                @onclick="() => Groups.FoldAsync(named.Name, shown)">
                            <MudIcon Icon="@(shown ? Icons.Material.Outlined.ExpandMore : Icons.Material.Outlined.ChevronRight)" Size="Size.Small" />
                        </button>
                    }
                    <SidebarRow Lead="SidebarRow.SidebarLead.Icon" Icon="@GroupIcon" Label="@group.Name" Unread="@(shown ? 0 : UnreadOf(group))"
                                Class="play-side-group" IsCurrent="@(Current == key)" Collapsed="@Collapsed" OnClick="@(() => OnOpen.InvokeAsync(key))" />
                </div>
                @if (shown)
                {
                    <div class="play-side-category-channels" role="group" aria-label="@group.Name">
                        @foreach (var channel in Channels.Where(c => named.Holds(c.Name)))
                        {
                            var name = channel.Name;
                            <SidebarRow Lead="SidebarRow.SidebarLead.Channel" Label="@name" Unread="@channel.Unread" Class="play-side-in-group"
                                        IsCurrent="@(Current == name)" Collapsed="@Collapsed" OnClick="@(() => OnOpen.InvokeAsync(name))" />
                        }
                    </div>
                }
            }
            @foreach (var channel in Collapsed ? Channels : Channels.Where(c => !Groups.Groups.Any(g => g.Holds(c.Name))))
            {
                var name = channel.Name;
                <SidebarRow Lead="SidebarRow.SidebarLead.Channel" Label="@name" Unread="@channel.Unread"
                            IsCurrent="@(Current == name)" Collapsed="@Collapsed" OnClick="@(() => OnOpen.InvokeAsync(name))" />
            }
        </nav>
    }
    else if (!Collapsed)
    {
        <EmptyState Compact="true" Class="play-side-empty play-side-channels-empty" Icon="@Icons.Material.Outlined.Forum">@Loc["NavPlayChannelsEmpty"]</EmptyState>
    }
    @if (Feed.Conversations.Count > 0)
    {
        @if (!Collapsed)
        {
            <SectionLabel>@Loc["NavPlayPages"]</SectionLabel>
        }
        <nav class="play-side-pages" aria-label="@Loc["NavPlayPages"]">
            @foreach (var conversation in Feed.Conversations)
            {
                var key = conversation.Key;
                var group = conversation.With.Count > 1;
                <SidebarRow Lead="SidebarRow.SidebarLead.Avatar"
                            ImageUrl="@ImageOf(conversation, 0)" ImageUrl2="@(group ? ImageOf(conversation, 1) : null)"
                            Name="@conversation.With.FirstOrDefault()" Name2="@(group ? conversation.With[1] : null)"
                            Online="@OnlineAt(conversation, 0)" Online2="@(group ? OnlineAt(conversation, 1) : null)"
                            PresenceText="@PresenceOf(conversation)"
                            Label="@PageLabel(conversation)" Unread="@conversation.Unread"
                            IsCurrent="@(Current == key)" Collapsed="@Collapsed" OnClick="@(() => OnOpen.InvokeAsync(key))" />
            }
        </nav>
    }
    else if (!Collapsed)
    {
        <SectionLabel>@Loc["NavPlayPages"]</SectionLabel>
        <EmptyState Compact="true" Class="play-side-empty play-side-pages-empty" Icon="@Icons.Material.Outlined.Chat">@WithCommands(Loc["NavPlayPagesEmpty"])</EmptyState>
    }
    <CommGroupEditor @bind-Visible="_editorOpen" Editing="_editing" OnSaved="FollowRenameAsync" />
    @if (_apps.Count > 0)
    {
        @if (!Collapsed)
        {
            <SectionLabel>@Loc["NavPlayApps"]</SectionLabel>
        }
        <nav class="play-side-apps" aria-label="@Loc["NavPlayApps"]">
            @foreach (var app in _apps)
            {
                <SidebarRow Lead="SidebarRow.SidebarLead.Icon" Icon="@AppIcons.Outline(app.Icon, Icons.Material.Outlined.Apps)"
                            Label="@app.DisplayName" Href="@($"/apps/{Uri.EscapeDataString(app.Slug)}")" Collapsed="@Collapsed" />
            }
        </nav>
    }
    @if (OfferClient)
    {
        @* The way into the client, which keeps each of the account's characters connected with a rail to switch
           between them. Last, apart from the groups above: it changes the page, not what Play shows. *@
        <nav class="play-side-client" aria-label="@Loc["NavPlayClient"]">
            <SidebarRow Lead="SidebarRow.SidebarLead.Icon" Icon="@Icons.Material.Outlined.SwitchAccount" Label="@Loc["NavPlayClient"]"
                        Href="@SharpMUSH.Client.Layout.ShellRouting.ClientPath" Collapsed="@Collapsed" />
        </nav>
    }
</div>

@code {
    /// <summary>Only the leads, for the collapsed strip (board 07).</summary>
    [Parameter] public bool Collapsed { get; set; }

    /// <summary>Links to the client at the end: Play offers it where the account has more than one character.</summary>
    [Parameter] public bool OfferClient { get; set; }

    /// <summary>The character the play connection is logged in as, or null.</summary>
    [Parameter] public string? CharacterName { get; set; }

    [Parameter] public bool Connected { get; set; }

    /// <summary>
    /// The latest <c>room.info</c>: each running scene is an In scene row, its picture each row's image, and its
    /// <see cref="RoomInfo.Scene"/> the row that is current while the Story is shown.
    /// </summary>
    [Parameter] public RoomInfo? Room { get; set; }

    /// <summary>Offer to start a scene in a copy of this room (scene-rooms), while no scene runs here.</summary>
    [Parameter] public bool CanCopyRoom { get; set; }

    /// <summary>The channel or conversation key main is showing, or null for the scene/terminal.</summary>
    [Parameter] public string? Current { get; set; }

    /// <summary>A scene's row was chosen: its id.</summary>
    [Parameter] public EventCallback<string> OnOpenScene { get; set; }

    /// <summary>The room row, shown while no scene is: back to the terminal.</summary>
    [Parameter] public EventCallback OnOpenGame { get; set; }

    /// <summary>A channel's name or a conversation's key was chosen.</summary>
    [Parameter] public EventCallback<string> OnOpen { get; set; }

    private IReadOnlyList<CharacterDirectoryService.CharacterSummary> _directory = [];

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    /// <summary>README §7.4: page apps whose NavPlacement is "Play", as the viewer's role allows.</summary>
    private IReadOnlyList<PortalApplication> _apps = [];

    /// <summary>The channel browser is open under Channels.</summary>
    private bool _browsing;

    private IReadOnlyList<CommChannel> Channels => Feed.Channels.Where(c => c.Joined).ToList();

    /// <summary>A channel group's lead: stacked channels.</summary>
    private const string GroupIcon = Icons.Material.Outlined.DynamicFeed;

    /// <summary>A group's unread lines: its channels' together.</summary>
    private int UnreadOf(CommGroup group) => Channels.Where(c => group.Holds(c.Name)).Sum(c => c.Unread);

    private bool _editorOpen;
    private CommGroup? _editing;

    /// <summary>The group open in main was renamed here: open it again under its new name.</summary>
    private Task FollowRenameAsync(CommGroup saved) =>
        _editing is { } before && Current == before.Key && before.Key != saved.Key ? OnOpen.InvokeAsync(saved.Key) : Task.CompletedTask;

    private void OpenEditor(CommGroup? group)
    {
        _editing = group;
        _editorOpen = true;
    }

    protected override async Task OnInitializedAsync()
    {
        Feed.Changed += OnFeedChanged;
        Groups.Changed += OnFeedChanged;
        _ = Groups.LoadAsync();
        _ = WatchOnlineAsync(_closed.Token);
        // Portraits for page rows. A directory that could not be read leaves initials, which is what a
        // character without a picture shows anyway.
        if (await Directory.ListAsync() is IReadOnlyList<CharacterDirectoryService.CharacterSummary> rows)
        {
            _directory = rows;
        }
        await LoadAppsAsync();
    }

    // Signing in or out hands down a new AuthState; which apps show depends on who is looking.
    protected override Task OnParametersSetAsync() =>
        ReferenceEquals(AuthState, _appsAuth) ? Task.CompletedTask : LoadAppsAsync();

    private Task<AuthenticationState>? _appsAuth;

    private async Task LoadAppsAsync()
    {
        _appsAuth = AuthState;
        var user = AuthState is null ? null : (await AuthState).User;
        _apps = PortalNavSections.AppsForSection(await Registry.ListAsync(), user, "Play")
            .Where(a => a.KindEnum == SharpMUSH.Library.Models.Portal.Applications.ApplicationKind.Page)
            .ToList();
    }

    /// <summary>A hint whose `backticked` spans are commands to type, set as code that does not wrap.</summary>
    private static RenderFragment WithCommands(string hint) => __builder =>
    {
        var parts = hint.Split('`');
        for (var i = 0; i < parts.Length; i++)
        {
            if (i % 2 == 1)
            {
                <code class="play-side-command">@parts[i]</code>
            }
            else
            {
                @parts[i]
            }
        }
    };

    private void OnFeedChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>
    /// Whether the viewer's poses here go to this scene: <c>active</c> while they are focused on it (a filled
    /// check, in the success colour), else <c>inactive</c> for a member who is not, or <c>out</c> for someone
    /// not in it (an empty circle, dim). Null when an older handler did not say.
    /// </summary>
    private (string Key, string Icon, string Text)? StateOf(RoomScene scene) => scene.Focus switch
    {
        true => ("active", StateIcon(true), Loc["NavPlaySceneActive"]),
        false when scene.Role is not null => ("inactive", StateIcon(false), Loc["NavPlaySceneInactive"]),
        false => ("out", StateIcon(false), Loc["NavPlaySceneRowNotJoined"]),
        null => null,
    };

    private static string StateIcon(bool active) => active ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.RadioButtonUnchecked;

    private static RenderFragment SceneStatus((string Key, string Icon, string Text) state) => __builder =>
    {
        <span class="play-side-scene-status play-side-scene-status--@state.Key">
            <MudIcon Icon="@state.Icon" Size="Size.Small" Class="play-side-scene-mark" aria-hidden="true" />@state.Text
        </span>
    };

    private string SceneTitle(RoomScene scene) =>
        string.IsNullOrWhiteSpace(scene.Title) ? Room?.Name ?? string.Empty : scene.Title;

    /// <summary>One person: their full name. A group: first names, as the board's "Tomas, Dace".</summary>
    private static string PageLabel(CommConversation c) =>
        c.With.Count == 1 ? c.With[0] : string.Join(", ", c.With.Select(FirstName));

    private static string FirstName(string name) =>
        name.Split(' ', StringSplitOptions.RemoveEmptyEntries) is [var first, ..] ? first : name;

    /// <summary>The directory's picture for the n-th person, by objid when the feed has one, else by name.</summary>
    private string? ImageOf(CommConversation c, int index)
    {
        var objid = index < c.WithObjIds.Count ? c.WithObjIds[index] : null;
        var name = index < c.With.Count ? c.With[index] : null;
        var row = _directory.FirstOrDefault(r => objid is not null && string.Equals(r.Objid, objid, StringComparison.Ordinal))
            ?? _directory.FirstOrDefault(r => name is not null && string.Equals(r.Name, name, StringComparison.OrdinalIgnoreCase));
        return row?.Image;
    }

    /// <summary>How often the page rows' presence is read again.</summary>
    public static readonly TimeSpan OnlineInterval = TimeSpan.FromSeconds(30);

    /// <summary>Who is connected, or null while that could not be read: page rows then show no presence.</summary>
    private IReadOnlyList<CharacterDirectoryService.CharacterSummary>? _online;

    private readonly CancellationTokenSource _closed = new();

    private async Task WatchOnlineAsync(CancellationToken closed)
    {
        try
        {
            using var timer = new PeriodicTimer(OnlineInterval, Provider.GetService<TimeProvider>() ?? TimeProvider.System);
            do
            {
                var online = await Directory.ListOnlineAsync(closed);
                if (closed.IsCancellationRequested) return;
                _online = online is IReadOnlyList<CharacterDirectoryService.CharacterSummary> here ? here : null;
                await InvokeAsync(StateHasChanged);
            } while (await timer.WaitForNextTickAsync(closed));
        }
        catch (OperationCanceledException)
        {
            // Closed.
        }
    }

    private bool? OnlineAt(CommConversation c, int index) => ConversationPresence.OnlineAt(_online, c, index);

    /// <summary>The row's presence, read out after its label.</summary>
    private string? PresenceOf(CommConversation c) => ConversationPresence.Text(Loc, _online, c);

    public void Dispose()
    {
        Feed.Changed -= OnFeedChanged;
        Groups.Changed -= OnFeedChanged;
        _closed.Cancel();
        _closed.Dispose();
    }
}
