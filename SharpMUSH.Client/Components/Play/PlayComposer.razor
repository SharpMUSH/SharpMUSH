@using System.Text.Json
@using SharpMUSH.Client.Services
@inject IStringLocalizer<SharedResource> Loc
@inject IJSRuntime JS
@inject CommandHistory History
@implements IAsyncDisposable

@* D1 §5.8 / §4.11 the Play composer in the bottom bar: Say · OOC · Emit · Command, the field and Send.
   Say, OOC and Emit send say, the game's ooc command (the Scene plugin tags those poses "ooc", §7.2) and
   @emit, with the text encoded so the parser hands it back unchanged; Command sends the line as typed, and
   Up and Down walk the command history there as in the terminal. Enter sends and Shift+Enter is a new line,
   decided in layout.js per key; Ctrl/⌘+Enter also sends. The draft and the mode are kept per character
   (DraftKey), so neither switching to the terminal nor a reload loses a half-written post; the expand
   button gives the field most of the screen for a long one. The %r toggle (on by default, kept per browser)
   decides what a line break is: on, it travels as %r inside the one post or command; off, every line is sent
   as a post or command of its own. The field is a FormattedInput: Say, OOC and Emit are written as styled text
   (the format menu colours a selection) and sent as decompose() writes them, so what is shown is what is posed,
   brackets and percent signs included; the menu's softcode switch (kept per browser) sends what is typed as
   softcode instead, as Command always does, and there the menu wraps the selection in [ansi()]. The field is
   the page's main text box (FormattedInput.Primary): it is focused when the Story opens, typing anywhere on the
   page lands in it, and a click on the bar around it focuses it; Send hands focus back to it. *@
<BottomBar Class="@($"composer {(_expanded ? "composer--expanded" : null)}")">
    <div class="composer-scope" data-input-region>
        <div class="composer-grid">
            <div class="composer-chips">
                <TypeChips Items="_types" Selected="@_type" SelectedChanged="OnTypeChanged" AriaLabel="@Loc["NavPlayMessageType"]" />
            </div>
            <div class="composer-tools">
                @if (_field is not null)
                {
                    <FormatMenu Target="_field" ButtonClass="composer-tool" AlwaysRaw="@(_type == Command)" OnRawChanged="SetRawAsync" />
                }
                <button type="button" class="composer-tool composer-breaks" aria-pressed="@(_breaksAsR ? "true" : "false")"
                        aria-label="@Loc["NavPlayComposerBreaks"]" title="@BreaksHint" @onclick="ToggleBreaksAsync">
                    <MudIcon Icon="@Icons.Material.Outlined.WrapText" Size="Size.Small" />
                </button>
                <button type="button" class="composer-tool composer-expand" aria-pressed="@(_expanded ? "true" : "false")"
                        aria-label="@ExpandLabel" title="@ExpandLabel" @onclick="ToggleExpanded">
                    <MudIcon Icon="@(_expanded ? Icons.Material.Outlined.CloseFullscreen : Icons.Material.Outlined.OpenInFull)" Size="Size.Small" />
                </button>
            </div>
            <FormattedInput @ref="_field" Draft="_draft" Class="composer-field"
                            InputClass="@($"composer-input {(_type == Command ? "composer-input--command" : null)}")"
                            AriaLabel="@($"{Loc["NavPlayMessageType"]}: {Label(_type)}")" Placeholder="@Placeholder"
                            Primary="end" Autofocus="true" EnterKeyHint="send"
                            OnKeyDown="OnKeyDownAsync" OnRawRequested="@(_type == Command ? default : EventCallback.Factory.Create(this, () => SetRawAsync(true)))" />
            <button type="button" class="composer-send" disabled="@(!CanSend)" @onclick="SendFromButtonAsync">@Loc["Send"]</button>
        </div>
    </div>
</BottomBar>

@code {
    /// <summary>Whether the play connection is up; nothing is sent while it is not.</summary>
    [Parameter] public bool Connected { get; set; }

    /// <summary>The command line to send to the game.</summary>
    [Parameter] public EventCallback<string> OnSend { get; set; }

    /// <summary>
    /// Where the draft and the mode are kept (<c>localStorage</c>), per character; null keeps them only while
    /// the composer is on screen.
    /// </summary>
    [Parameter] public string? DraftKey { get; set; }

    private const string Say = "say";
    private const string Ooc = "ooc";
    private const string Emit = "emit";
    private const string Command = "command";

    private IReadOnlyList<(string Key, string Label)> _types = [];
    private string _type = Say;
    private readonly ComposerDraft _draft = new();
    private FormattedInput? _field;
    private bool _walking;
    // Reading a character's kept draft must not save it back first: an empty field saved under the new key
    // would delete the very draft about to be read.
    private bool _reading;
    private bool _rawPreferred;
    private bool _focusInput;
    private bool _expanded;
    private string? _loadedKey;
    private readonly HistoryWalk _historyWalk = new();
    private bool _breaksAsR = true;
    private bool _breaksLoaded;

    private const string BreaksKey = "play.composer.breaks";
    private const string RawKey = "play.composer.raw";

    private bool CanSend => Connected && !_draft.IsEmpty;

    /// <summary>Whether the field is softcode as typed: always for Command, else when the player switched to it.</summary>
    private bool Raw => _rawPreferred || _type == Command;

    private string ExpandLabel => _expanded ? Loc["NavPlayComposerShrink"] : Loc["NavPlayComposerExpand"];

    protected override void OnInitialized()
    {
        _types = [(Say, Label(Say)), (Ooc, Label(Ooc)), (Emit, Label(Emit)), (Command, Label(Command))];
        _draft.Changed += OnDraftChanged;
    }

    private void OnDraftChanged()
    {
        if (!_walking) _historyWalk.Reset();
        if (!_reading) _ = SaveDraftAsync();
        // Send's state follows the draft, which the field changes without this component rendering.
        _ = InvokeAsync(StateHasChanged);
    }

    private string Label(string type) => type switch
    {
        Say => Loc["NavPlayTypeSay"],
        Ooc => Loc["NavPlayTypeOoc"],
        Emit => Loc["NavPlayTypeEmit"],
        _ => Loc["NavPlayTypeCommand"],
    };

    private string Placeholder => _type switch
    {
        Say => Loc["NavPlayPlaceholderSay"],
        Ooc => Loc["NavPlayPlaceholderOoc"],
        Emit => Loc["NavPlayPlaceholderEmit"],
        _ => Loc["NavPlayPlaceholderCommand"],
    };

    private Task OnTypeChanged(string type)
    {
        _type = type;
        _historyWalk.Reset();
        _draft.SetRaw(Raw);
        return SaveDraftAsync();
    }

    /// <summary>The menu's softcode switch, or the field's offer to send what looks like softcode as softcode.</summary>
    private async Task SetRawAsync(bool raw)
    {
        _rawPreferred = raw;
        _draft.SetRaw(Raw);
        _focusInput = true;
        await JS.SetItemAsync(BrowserStore.Local, RawKey, raw ? "on" : "off");
    }

    private async Task LoadRawAsync()
    {
        if (_rawLoaded) return;
        _rawLoaded = true;
        if (await JS.GetItemAsync(BrowserStore.Local, RawKey) is not "on") return;
        _rawPreferred = true;
        _draft.SetRaw(Raw);
        StateHasChanged();
    }

    private bool _rawLoaded;

    private string BreaksHint => _breaksAsR ? Loc["NavPlayComposerBreaksOn"] : Loc["NavPlayComposerBreaksOff"];

    private async Task ToggleBreaksAsync()
    {
        _breaksAsR = !_breaksAsR;
        _focusInput = true;
        await JS.SetItemAsync(BrowserStore.Local, BreaksKey, _breaksAsR ? "on" : "off");
    }

    private async Task LoadBreaksAsync()
    {
        if (_breaksLoaded) return;
        _breaksLoaded = true;
        if (await JS.GetItemAsync(BrowserStore.Local, BreaksKey) is not "off") return;
        _breaksAsR = false;
        StateHasChanged();
    }

    private void ToggleExpanded()
    {
        _expanded = !_expanded;
        _focusInput = true;
    }

    /// <summary>A kept draft: its text, and when it was styled, the styled text (a serialized MString) too.</summary>
    private sealed record Draft(string Type, string Text, string? Markup = null);

    /// <summary>Keeps the draft and the mode for this character, so a reload or the terminal view loses neither.</summary>
    private async Task SaveDraftAsync()
    {
        if (DraftKey is not { } key) return;
        if (_draft.Value.Length == 0 && _type == Say)
        {
            await JS.RemoveItemAsync(BrowserStore.Local, key);
            return;
        }
        var markup = !_draft.Raw && !_draft.Text.Runs.IsDefaultOrEmpty ? MarkupTextSerializer.Serialize(_draft.Text) : null;
        await JS.SetItemAsync(BrowserStore.Local, key, JsonSerializer.Serialize(new Draft(_type, _draft.Value, markup)));
    }

    /// <summary>
    /// Reads the kept draft, once per character. When the character is first known, text typed before then
    /// stays. A switch to another character swaps the field for that character's own draft (the last one's is
    /// already kept under its key), so one character's words are never sent or saved as another's.
    /// </summary>
    private async Task LoadDraftAsync()
    {
        if (DraftKey is not { } key || key == _loadedKey) return;
        var switched = _loadedKey is not null;
        _loadedKey = key;
        if (switched)
        {
            _type = Say;
            Quietly(() => _draft.Load(MarkupText.Empty, Raw));
            _historyWalk.Reset();
            StateHasChanged();
        }
        else if (_draft.Value.Length > 0)
        {
            return;
        }
        if (await JS.GetItemAsync(BrowserStore.Local, key) is not { Length: > 0 } json) return;
        try
        {
            if (JsonSerializer.Deserialize<Draft>(json) is not { } draft) return;
            _type = _types.Any(t => t.Key == draft.Type) ? draft.Type : Say;
            Quietly(() => _draft.Load(Styled(draft) ?? MarkupText.Plain(draft.Text ?? string.Empty), Raw));
            StateHasChanged();
        }
        catch (JsonException)
        {
            // Not a draft this composer wrote: start empty.
        }
    }

    private void Quietly(Action load)
    {
        _reading = true;
        try
        {
            load();
        }
        finally
        {
            _reading = false;
        }
    }

    /// <summary>The kept styled text, when there is one and it still reads.</summary>
    private static MarkupText? Styled(Draft draft)
    {
        if (draft.Markup is not { Length: > 0 } markup) return null;
        try
        {
            var text = MarkupTextSerializer.Deserialize(markup);
            return text.Text == draft.Text ? text : null;
        }
        catch (JsonException)
        {
            return null;
        }
    }

    /// <summary>Starts a page to someone (the character sheet's Page): Command, with the page prefilled.</summary>
    /// <param name="command">The row's own Page action (<c>page #312=</c>, which survives a rename), when it has one.</param>
    public Task StartPageAsync(string name, string? command = null)
    {
        _type = Command;
        _draft.Load(MarkupText.Plain(command ?? $"page {name}="), raw: true);
        _focusInput = true;
        StateHasChanged();
        return SaveDraftAsync();
    }

    // Ctrl/⌘+Enter inserts nothing in a textarea, so it needs no preventDefault. Plain Enter is handled in
    // layout.js (SendFromEnter), which prevents the newline only for the Enter that sends.
    // In Command mode, Up and Down walk the command history while the line is one line, as the terminal's input
    // does; in a multi-line draft they move the caret.
    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && (e.CtrlKey || e.MetaKey))
        {
            await SendAsync();
            return;
        }
        if (_type != Command || _draft.Value.Contains('\n')) return;
        switch (e.Key)
        {
            case "ArrowUp":
                await History.LoadAsync();
                if (_historyWalk.Older(History.Entries, _draft.Value) is { } older) Walk(older);
                break;
            case "ArrowDown":
                if (_historyWalk.Newer(History.Entries) is { } newer) Walk(newer);
                break;
        }
    }

    private void Walk(string line)
    {
        _walking = true;
        try
        {
            _draft.Load(line);
        }
        finally
        {
            _walking = false;
        }
    }

    /// <summary>Send, clicked: the button goes disabled with the field emptied, so focus goes back to the field.</summary>
    private Task SendFromButtonAsync()
    {
        _focusInput = true;
        return SendAsync();
    }

    private async Task SendAsync()
    {
        if (!CanSend) return;
        var lines = Lines().ToList();
        if (_type == Command)
        {
            foreach (var line in lines) await History.AddAsync(line);
        }
        _historyWalk.Reset();
        _draft.Clear();
        await SaveDraftAsync();
        foreach (var line in lines) await OnSend.InvokeAsync(line);
    }

    /// <summary>
    /// What Send puts on the wire: one line with the breaks as <c>%r</c>, or, with the toggle off, one per line
    /// of the draft (blank lines skipped). Say, OOC and Emit send the draft as <see cref="ComposerDraft.ToSoftcode"/>
    /// writes it; Command text is sent as typed.
    /// </summary>
    private IEnumerable<string> Lines()
    {
        if (_type == Command)
        {
            var text = _draft.Value;
            IEnumerable<string> commands = _breaksAsR
                ? [text.Trim().Replace("\n", "%r")]
                : text.Split('\n').Where(l => !string.IsNullOrWhiteSpace(l));
            foreach (var command in commands) yield return command.Trim();
            yield break;
        }

        var verb = _type switch
        {
            Say => "say",
            Ooc => "ooc",
            _ => "@emit",
        };
        foreach (var part in _draft.ToSoftcode(splitLines: !_breaksAsR)) yield return $"{verb} {part}";
    }

    private DotNetObjectReference<PlayComposer>? _self;

    /// <summary>Enter, from layout.js's listener on the field.</summary>
    [JSInvokable]
    public Task SendFromEnter() => InvokeAsync(async () =>
    {
        await SendAsync();
        StateHasChanged();
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await LoadDraftAsync();
        await LoadBreaksAsync();
        await LoadRawAsync();
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            try
            {
                if (_field is not null) await JS.InvokeVoidAsync("sharpmushLayout.composerEnter", _field.Input, _self);
            }
            catch (JSException)
            {
                // No layout script: Ctrl+Enter and the Send button still send.
            }
            // The format menu needs the field, which exists from this render on.
            StateHasChanged();
        }
        if (!_focusInput || _field is null) return;
        _focusInput = false;
        await _field.FocusAsync();
    }

    public async ValueTask DisposeAsync()
    {
        _draft.Changed -= OnDraftChanged;
        if (_self is null || _field is null) return;
        try
        {
            await JS.InvokeVoidAsync("sharpmushLayout.uncomposerEnter", _field.Input);
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException)
        {
            // The page is going away with its listener.
        }
        _self.Dispose();
    }
}
