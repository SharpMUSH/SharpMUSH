@inject IStringLocalizer<SharedResource> Loc

@* The pre-terminal states, centred in the play area: a spinner while the roster resolves, then a card that
   says what is missing with the one action that fixes it. *@
<div class="play-gate full-height">
    @switch (State)
    {
        case PlayGateState.Resolving:
            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            break;
        case PlayGateState.RosterFailed:
            <EmptyState Class="play-gate-card" Failed="true">
                <ChildContent>@Loc["NavPlayRosterUnavailable"]</ChildContent>
                <Action><CapsuleButton Icon="@Icons.Material.Outlined.Refresh" OnClick="OnRetry">@Loc["NavTryAgain"]</CapsuleButton></Action>
            </EmptyState>
            break;
        case PlayGateState.NeedsCharacter:
            <EmptyState Class="play-gate-card" Icon="@Icons.Material.Outlined.PersonAdd">
                <ChildContent>@Loc["NavPlayNeedsCharacter"]</ChildContent>
                <Action><CapsuleButton Primary="true" Icon="@Icons.Material.Outlined.PersonAdd" Href="/characters/new">@Loc["NavCreateCharacter"]</CapsuleButton></Action>
            </EmptyState>
            break;
    }
</div>

@code {
    [Parameter, EditorRequired] public PlayGateState State { get; set; }

    /// <summary>Asks for the roster again, from the failed state.</summary>
    [Parameter] public EventCallback OnRetry { get; set; }
}
