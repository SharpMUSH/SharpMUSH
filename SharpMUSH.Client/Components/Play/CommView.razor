@using SharpMUSH.Client.Models
@using SharpMUSH.Client.Services
@inject ICommFeed Feed
@inject IChannelWho Who
@inject CommGroups Groups
@inject IStringLocalizer<SharedResource> Loc
@inject IJSRuntime JS
@inject GameCommandService Commands
@inject CharacterDirectoryService Directory
@inject IServiceProvider Provider
@implements IAsyncDisposable

@* D1 §5.1 / board 06 the channel view: one channel, or one page conversation, in main. Lines are grouped
   by day ("Today", "Yesterday", a date) and by author (a header per run of lines within five minutes), with
   a "New" divider where the lines unread at opening begin. A line that names no speaker (an @cemit) stands
   alone, without a header, and with the picture it was sent with (a character's or an image) when it has one. Bodies keep their colour when the game sent it (markup), else are text. The composer
   sends @chat to a channel, or page to the conversation's people by objid (a quoted name when there is no
   objid). A page runs through api/commands (through the terminal for a guest, who has no account session), and what else it told the pager (who it could not reach and why,
   an idle message) is shown in the conversation as the game's notice, at the time it came. The title's line
   says whether the people are connected. While open, the feed's Viewing is this key, so its lines do not count as unread. Opening a channel
   pulls its recent lines from the server, and opening a conversation its logged pages; live lines then append,
   a line already held kept once. A game that keeps no page log (page_log off) is said so in a conversation.
   A channel lists who is on it now beside the lines (@channel/who's list, kept live by comm.who): shown by
   default where there is room, behind the header's members button where there is not. The line is the page's
   main text box (input-focus.js): focused when a channel or conversation opens, and where typing on the page
   and a click in the lines go. A channel group (CommGroup) is shown the same way over each of its channels at once:
   its lines merged in time order, each labelled with its channel, a run of one author's lines broken where the
   channel changes, and a picker beside the composer for the channel to send to. It has no member list. *@
<section class="comm @(_membersToggled ? "comm--members-toggled" : null)" aria-labelledby="comm-title">
    <header class="comm-head">
        @Lead
        <div class="comm-titles">
            <h2 class="comm-title" id="comm-title">@Title</h2>
            <div class="comm-sub">@SubTitle@if (Presence is { } presence)
            {
                <span class="comm-presence @(AllOnline ? "comm-presence--on" : null)"> · @presence</span>
            }</div>
        </div>
        @if (IsChannel)
        {
            @* Pressed while the list is flipped from where the layout starts it: shown on a narrow screen,
               hidden on a wide one. The count is in the name, so it is read with it. *@
            <button type="button" class="comm-members-toggle" aria-controls="comm-members" title="@Loc["NavPlayMembers"]"
                    aria-label="@(Members is { } named ? Loc["NavPlayMembersCount", named.Count] : Loc["NavPlayMembers"])"
                    aria-pressed="@(_membersToggled ? "true" : "false")" @onclick="() => _membersToggled = !_membersToggled">
                <MudIcon Icon="@Icons.Material.Outlined.People" Size="Size.Small" />
                @if (Members is { } shown)
                {
                    <span class="comm-members-count" aria-hidden="true">@shown.Count</span>
                }
            </button>
        }
        @if (Group is { } shownGroup)
        {
            <button type="button" class="comm-members-toggle comm-group-edit" aria-label="@Loc["NavPlayGroupEdit", shownGroup.Name]"
                    title="@Loc["NavPlayGroupEdit", shownGroup.Name]" @onclick="() => _editing = true">
                <MudIcon Icon="@Icons.Material.Outlined.Tune" Size="Size.Small" />
            </button>
        }
        @* Back to the scene or the terminal, from anywhere in the view with Escape too: an arrow, and the key where there is room. *@
        <button type="button" class="comm-close" aria-label="@Loc["NavPlayBackToGame"]" title="@Loc["NavPlayBackToGame"] (Esc)"
                aria-keyshortcuts="Escape" @onclick="OnClose">
            <MudIcon Icon="@Icons.Material.Outlined.ArrowBack" Size="Size.Small" />
            <kbd class="comm-close-key" aria-hidden="true">Esc</kbd>
        </button>
    </header>
    <div class="comm-main">
        <div class="comm-scroll" data-input-region tabindex="0" role="region" aria-label="@Loc["NavPlayLinesOf", Target]">
            <LiveAnnouncer @ref="_announcer" Label="@Loc["NavPlayLinesOf", Target]" />
            <div class="comm-lines">
                @if (IsConversation && Feed.PageLogging == false)
                {
                    <div class="comm-unlogged" role="note">@Loc["NavPlayPageLogOff"]</div>
                }
                @{ var notices = Notices; var noticesShown = 0; }
                @if (_lines.Count == 0 && notices.Count == 0)
                {
                    <EmptyState Compact="true" Class="comm-empty" Icon="@Icons.Material.Outlined.ChatBubbleOutline">@Loc["NavPlayNothingYet"]</EmptyState>
                }
                @for (var i = 0; i < _lines.Count; i++)
                {
                    var line = _lines[i];
                    while (noticesShown < notices.Count && notices[noticesShown].At < line.Timestamp)
                    {
                        @NoticeView(notices[noticesShown++])
                    }
                    var day = line.Timestamp.ToLocalTime().Date;
                    if (i == 0 || _lines[i - 1].Timestamp.ToLocalTime().Date != day)
                    {
                        <div class="comm-day"><span>@DayLabel(day)</span></div>
                    }
                    if (i == _newAt)
                    {
                        <div class="comm-new" role="separator"><span>@Loc["NavPlayNewLines"]</span></div>
                    }
                    if (line.From.Length == 0 && line.Picture is { } picture)
                    {
                        @* An @cemit sent with a picture: the picture beside it, still with no name. *@
                        var persona = PersonaName(picture);
                        <div class="comm-group comm-emit--pictured @RunClass(line)" style="@RunStyle(line)">
                            <CharacterAvatar Class="comm-avatar" Name="@persona" Character="@(IsUrl(picture) ? null : picture)"
                                             ImageUrl="@(IsUrl(picture) ? picture : null)"
                                             Fallback="@(persona is null ? NoPicture : null)" />
                            <div class="comm-body">
                                <div class="comm-meta">@ChannelTag(line)<span class="comm-time">@DateDisplay.Time(line.Timestamp)</span></div>
                                <div class="comm-text">@Body(line)</div>
                            </div>
                        </div>
                    }
                    else if (line.From.Length == 0)
                    {
                        @* An @cemit names nobody: the line alone, as the terminal shows it. *@
                        <div class="comm-emit @RunClass(line)" style="@RunStyle(line)">
                            <span class="comm-time">@DateDisplay.Time(line.Timestamp)</span>
                            @ChannelTag(line)
                            <div class="comm-text">@Body(line)</div>
                        </div>
                    }
                    else if (StartsGroup(i))
                    {
                        var end = GroupEnd(i);
                        <div class="comm-group @RunClass(line)" style="@RunStyle(line)">
                            <CharacterAvatar Class="comm-avatar" Name="@line.From" Character="@line.FromObjId" />
                            <div class="comm-body">
                                <div class="comm-meta">
                                    @ChannelTag(line)
                                    <span class="comm-name">@line.From</span>
                                    <span class="comm-time">@DateDisplay.Time(line.Timestamp)</span>
                                </div>
                                @for (var j = i; j <= end; j++)
                                {
                                    <div class="comm-text">@Body(_lines[j])</div>
                                }
                            </div>
                        </div>
                    }
                }
                @while (noticesShown < notices.Count)
                {
                    @NoticeView(notices[noticesShown++])
                }
            </div>
        </div>
        @if (IsChannel)
        {
            <aside class="comm-members" id="comm-members" aria-label="@Loc["NavPlayMembers"]">
                @if (Members is { } members)
                {
                    <div class="comm-members-head">@Loc["NavPlayMembersOnline", members.Count]</div>
                    @if (members.Count == 0)
                    {
                        <EmptyState Compact="true" Class="comm-members-empty" Icon="@Icons.Material.Outlined.PeopleOutline">@Loc["NavPlayNobodyOn"]</EmptyState>
                    }
                    <ul class="comm-members-list">
                        @foreach (var member in members)
                        {
                            <li class="comm-member" @key="member.ObjId">
                                <CharacterAvatar Class="comm-avatar comm-avatar--small" Name="@member.Name" Character="@member.ObjId" />
                                <span class="comm-member-name">@member.Name</span>
                            </li>
                        }
                    </ul>
                }
            </aside>
        }
    </div>
    <div class="comm-compose">
        <BottomBar>
            <div class="comm-compose-row">
                @if (Group is not null && SendChannels.Count > 0)
                {
                    <select name="channel" class="comm-send-to" aria-label="@Loc["NavPlayGroupSendTo"]" value="@SendTo"
                            @onchange="e => _sendTo = e.Value?.ToString()">
                        @foreach (var channel in SendChannels)
                        {
                            <option value="@channel">#@channel</option>
                        }
                    </select>
                }
                <input name="message" @ref="_input" class="comm-input" type="text" data-primary-input="end" enterkeyhint="send" placeholder="@Loc["NavPlayMessageTo", Target]" aria-label="@Loc["NavPlayMessageTo", Target]"
                       value="@_text" @oninput="e => _text = e.Value?.ToString() ?? string.Empty" @onkeydown="OnKeyAsync" />
                <button type="button" class="comm-send" disabled="@(string.IsNullOrWhiteSpace(_text) || Group is not null && SendTo is null)" @onclick="SendFromButtonAsync">@Loc["Send"]</button>
            </div>
        </BottomBar>
    </div>
    <CommGroupEditor @bind-Visible="_editing" Editing="Group" OnSaved="OnGroupSavedAsync" OnRemoved="_ => OnClose.InvokeAsync()" />
</section>

@code {
    /// <summary>A channel's name, a conversation's key, or a channel group's (<see cref="CommGroup.Key"/>).</summary>
    [Parameter, EditorRequired] public string Key { get; set; } = string.Empty;

    /// <summary>Opens another key in this view's place: a group under its new name after it was renamed here.</summary>
    [Parameter] public EventCallback<string> OnOpen { get; set; }

    /// <summary>The group editor is open, from the header's edit button.</summary>
    private bool _editing;

    private Task OnGroupSavedAsync(CommGroup saved) =>
        saved.Key != Key ? OnOpen.InvokeAsync(saved.Key) : Task.CompletedTask;

    /// <summary>A command line to send (@chat or page).</summary>
    [Parameter] public EventCallback<string> OnSend { get; set; }

    /// <summary>Back to the scene or the terminal.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Leads the header: Play's menu button on touch chrome, where this header is the only bar.</summary>
    [Parameter] public RenderFragment? Lead { get; set; }

    /// <summary>A run of lines from one author within this long shares one header.</summary>
    private static readonly TimeSpan GroupGap = TimeSpan.FromMinutes(5);

    private IReadOnlyList<CommMessage> _lines = [];
    private string? _openedKey;
    private int _newAt = -1;

    /// <summary>The first line unread at opening; the divider follows it, not an index the trimmed history shifts.</summary>
    private CommMessage? _firstUnread;
    private string _text = string.Empty;

    /// <summary>The member list flipped from where it starts: shown where there is room, hidden where there is not.</summary>
    private bool _membersToggled;

    /// <summary>The channel's members, or null for a conversation or while the list is being read.</summary>
    private IReadOnlyList<CommParticipant>? Members => IsChannel ? Who.Members(Key) : null;

    /// <summary>The channel group this view shows, or null for one channel or conversation.</summary>
    private CommGroup? Group => Groups.Find(Key) is CommGroup group ? group : null;

    /// <summary>One channel: neither a conversation nor a group.</summary>
    private bool IsChannel => !IsConversation && !CommGroup.IsGroupKey(Key);

    /// <summary>
    /// The feed keys the view shows: the group's channels the character is on (a channel it is not on shows no
    /// lines, history included), else the one key.
    /// </summary>
    private IReadOnlyList<string> ViewKeys => Group is not null ? SendChannels
        : CommGroup.IsGroupKey(Key) ? []
        : [Key];

    /// <summary>The group's channels the character is on, in the group's order: where a line can be sent.</summary>
    private IReadOnlyList<string> SendChannels => Group is { } group
        ? group.Channels.Where(name => Feed.Channels.Any(c => c.Joined && string.Equals(c.Name, name, StringComparison.OrdinalIgnoreCase))).ToList()
        : [];

    /// <summary>The group's channels the character is not on: named under the title, as they bring no lines.</summary>
    private IReadOnlyList<string> MissingChannels => Group is { } group
        ? group.Channels.Where(name => !SendChannels.Contains(name, StringComparer.OrdinalIgnoreCase)).ToList()
        : [];

    /// <summary>The channel picked to send to in a group; the first the character is on until one is picked.</summary>
    private string? _sendTo;

    private string? SendTo => SendChannels.FirstOrDefault(c => string.Equals(c, _sendTo, StringComparison.OrdinalIgnoreCase))
        ?? SendChannels.FirstOrDefault();

    private CommConversation? Conversation => Feed.Conversations.FirstOrDefault(c => c.Key == Key);

    private bool IsConversation => Conversation is not null;

    /// <summary>Who is connected, or null while that could not be read (or for a channel).</summary>
    private IReadOnlyList<CharacterDirectoryService.CharacterSummary>? _online;

    private string? Presence => Conversation is { } c ? ConversationPresence.Text(Loc, _online, c) : null;

    private bool AllOnline => Conversation is { } c
        && Enumerable.Range(0, c.With.Count).All(i => ConversationPresence.OnlineAt(_online, c, i) == true);

    /// <summary>What the game told the pager besides the page itself, at the time it came.</summary>
    private sealed record Notice(DateTimeOffset At, IReadOnlyList<string> Lines);

    /// <summary>Each key's notices, kept while the view is open.</summary>
    private readonly Dictionary<string, List<Notice>> _notices = new(StringComparer.Ordinal);

    private IReadOnlyList<Notice> Notices => _notices.TryGetValue(Key, out var held) ? held : [];

    private TimeProvider Clock => Provider.GetService<TimeProvider>() ?? TimeProvider.System;

    private RenderFragment NoticeView(Notice notice) => __builder =>
    {
        <div class="comm-notice" role="note">
            <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" Class="comm-notice-mark" aria-hidden="true" />
            <div class="comm-notice-text">
                @foreach (var text in notice.Lines)
                {
                    <div>@text</div>
                }
            </div>
            <span class="comm-time">@DateDisplay.Time(notice.At)</span>
        </div>
    };

    /// <summary>Reads who is connected again, for the title's line; a channel has none.</summary>
    private async Task ReadPresenceAsync()
    {
        if (!IsConversation) return;
        _online = await Directory.ListOnlineAsync() is IReadOnlyList<CharacterDirectoryService.CharacterSummary> online ? online : null;
        await InvokeAsync(StateHasChanged);
    }

    private string Title => Conversation is { } c ? string.Join(", ", c.With)
        : Group is { } group ? group.Name
        : CommGroup.IsGroupKey(Key) ? Key[CommGroup.KeyPrefix.Length..]
        : $"# {Key}";

    /// <summary>What the composer says it writes to: "#Public", or the people; a group, the channel picked.</summary>
    private string Target => Conversation is { } c ? string.Join(", ", c.With)
        : Group is not null ? SendTo is { } channel ? $"#{channel}" : Title
        : $"#{Key}";

    /// <summary>Under the title: what kind of view it is; a group's channels, and those the character is not on.</summary>
    private string SubTitle => IsConversation ? Loc["NavPlayPagesSub"]
        : Group is { } group ? MissingChannels is { Count: > 0 } missing
            ? Loc["NavPlayGroupSubMissing", ChannelList(group.Channels), ChannelList(missing)]
            : Loc["NavPlayGroupSub", ChannelList(group.Channels)]
        : Loc["NavPlayChannelSub"];

    private static string ChannelList(IEnumerable<string> channels) => string.Join(", ", channels.Select(c => $"#{c}"));

    /// <summary>The theme hue of <paramref name="channel"/> in the open group, or null outside a group.</summary>
    private string? HueOf(string? channel) =>
        Group is { } group && channel is not null && group.HueOf(channel) is { } hue ? $"hue-{hue}" : null;

    /// <summary>A run of one channel's lines in a group: tinted and edged in the channel's hue.</summary>
    private string? RunClass(CommMessage line) => HueOf(line.Channel) is null ? null : "comm-run--channel";

    private string? RunStyle(CommMessage line) => HueOf(line.Channel) is { } hue ? $"--channel-hue: var(--{hue})" : null;

    /// <summary>A line's channel, first in its line's heading, in a group's view only.</summary>
    private RenderFragment ChannelTag(CommMessage line) => __builder =>
    {
        if (Group is not null && line.Channel is { } channel)
        {
            <span class="comm-channel">#@channel</span>
        }
    };

    protected override void OnInitialized()
    {
        Feed.Changed += OnFeedChanged;
        Who.Changed += OnWhoChanged;
        Groups.Changed += OnGroupsChanged;
        _ = Groups.LoadAsync();
    }

    protected override void OnParametersSet()
    {
        if (string.Equals(_openedKey, Key, StringComparison.Ordinal))
        {
            return;
        }

        // The "New" divider marks the lines that were unread when the view opened; they are read from now.
        if (_openedKey is not null) Who.Unwatch(_openedKey);
        _openedKey = Key;
        _arrived = false;
        _historyRead = false;
        _text = string.Empty;
        _sendTo = null;
        Open();
        if (IsChannel) _ = Who.WatchAsync(Key);
        _ = ReadPresenceAsync();
    }

    /// <summary>
    /// Takes in the view's lines and where the unread ones begin, then views and marks read each key. A group's
    /// unread lines are each channel's own last ones, the first of which in time order gets the divider.
    /// </summary>
    private void Open()
    {
        var keys = ViewKeys;
        _viewKeys = keys;
        _groupSeen = Group is not null;
        _lines = MergedLines(keys);
        var unread = new HashSet<CommMessage>();
        foreach (var key in keys)
        {
            var count = Conversation?.Unread ?? Feed.Channels.FirstOrDefault(c => string.Equals(c.Name, key, StringComparison.OrdinalIgnoreCase))?.Unread ?? 0;
            var held = Feed.Messages(key);
            // More unread than the bounded history keeps means every retained line is unread.
            if (count > 0) unread.UnionWith(held.Skip(Math.Max(0, held.Count - count)));
        }
        _firstUnread = _lines.FirstOrDefault(unread.Contains);
        _newAt = FirstUnreadIndex();
        Feed.Viewed = keys;
        foreach (var key in keys) Feed.MarkRead(key);
        // Each key's recent lines from the server; they arrive through Changed, filed with the live ones.
        _ = ReadHistoryAsync(++_opening, keys);
    }

    /// <summary>Counts the view's openings, so a history read answers only the opening that started it.</summary>
    private int _opening;

    /// <summary>The keys last viewed, to tell when an edited group's channels changed under the open view.</summary>
    private IReadOnlyList<string> _viewKeys = [];

    /// <summary>One key's lines as the feed holds them; several keys' merged in time order, then by id.</summary>
    private IReadOnlyList<CommMessage> MergedLines(IReadOnlyList<string> keys) => keys.Count == 1
        ? Feed.Messages(keys[0])
        : keys.SelectMany(Feed.Messages).OrderBy(l => l.Timestamp).ThenBy(l => l.Id ?? long.MaxValue).ToList();

    /// <summary>
    /// The groups were read in or changed. A group view opened before they were read, or whose channels were
    /// edited, opens again over its channels; one whose group was removed closes.
    /// </summary>
    private void OnGroupsChanged() => _ = InvokeAsync(async () =>
    {
        if (!CommGroup.IsGroupKey(Key) || _openedKey != Key) return;
        if (Group is null)
        {
            // Removed from this view's own editor: the editor closes first, then closes the view (OnRemoved).
            if (_groupSeen && !_editing) await OnClose.InvokeAsync();
            return;
        }
        _groupSeen = true;
        if (!ViewKeys.SequenceEqual(_viewKeys, StringComparer.OrdinalIgnoreCase))
        {
            _historyRead = false;
            Open();
        }
        StateHasChanged();
    });

    /// <summary>The group has been found since the view opened: it going missing now means it was removed.</summary>
    private bool _groupSeen;

    private bool _arrived;

    private DotNetObjectReference<CommView>? _self;
    private IJSObjectReference? _escape;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_arrived) return;
        _arrived = true;
        try
        {
            await JS.InvokeVoidAsync("sharpmushInputFocus.arrive", _input);
            _self = DotNetObjectReference.Create(this);
            _escape = await JS.InvokeAsync<IJSObjectReference>("sharpmushInputFocus.onEscape", _self);
        }
        catch (JSException)
        {
            // No focus script: the line is still there to click, and the view closes with its back button.
        }
        // Closed while that call was out: let go of the listener now.
        if (_disposed) await ReleaseEscapeAsync();
    }

    /// <summary>Escape on the page (input-focus.js onEscape): back to the game, as the back button does.</summary>
    [JSInvokable]
    public Task Escape() => InvokeAsync(() => OnClose.InvokeAsync());

    private async Task ReleaseEscapeAsync()
    {
        if (_escape is { } escape)
        {
            _escape = null;
            try
            {
                await escape.InvokeVoidAsync("dispose");
                await escape.DisposeAsync();
            }
            catch (Exception e) when (e is JSException or JSDisconnectedException or ObjectDisposedException) { }
        }
        _self?.Dispose();
        _self = null;
    }

    private int FirstUnreadIndex() => _firstUnread is null ? -1 : IndexOf(_lines, _firstUnread);

    private static int IndexOf(IReadOnlyList<CommMessage> lines, CommMessage line)
    {
        for (var i = 0; i < lines.Count; i++)
        {
            if (ReferenceEquals(lines[i], line) || lines[i] == line) return i;
        }
        return -1;
    }

    private LiveAnnouncer? _announcer;

    /// <summary>
    /// The channel's history has been read in: until then a line that turns up is history the view shows, not
    /// news to read out.
    /// </summary>
    private bool _historyRead;

    private void OnFeedChanged()
    {
        // The character joined or left one of the group's channels: open again over the ones it is on now.
        if (Group is not null && _openedKey == Key && !ViewKeys.SequenceEqual(_viewKeys, StringComparer.OrdinalIgnoreCase))
        {
            _historyRead = false;
            Open();
            _ = InvokeAsync(StateHasChanged);
            return;
        }
        // A reconnect clears the feed, and with it Viewing; this view is still open.
        if (_openedKey is not null && Feed.Viewed.Count == 0) Feed.Viewed = _viewKeys;
        var before = _lines;
        _lines = MergedLines(_viewKeys);
        AnnounceArrivals(before, _lines);
        // Opened before the feed caught up with the server: its history comes with this change or a later one.
        if (!_historyRead && !_historyReading && _openedKey is not null) _ = ReadHistoryAsync(_opening, _viewKeys);
        _newAt = FirstUnreadIndex();
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Reads out each line that arrived after the history was read in, with who said it: a line not held before
    /// and newer than every line that was.
    /// </summary>
    private void AnnounceArrivals(IReadOnlyList<CommMessage> before, IReadOnlyList<CommMessage> now)
    {
        if (_announcer is null || !_historyRead) return;
        var held = before.ToHashSet();
        var newest = before.Count == 0 ? DateTimeOffset.MinValue : before.Max(l => l.Timestamp);
        foreach (var line in now.Where(l => l.Timestamp >= newest && !held.Contains(l)))
        {
            _announcer.Announce(Group is not null && line.Channel is { } channel
                ? Loc["NavPlayGroupLineSaid", channel, line.From, line.Text]
                : Loc["NavPlayLineSaid", line.From, line.Text]);
        }
    }

    private bool _historyReading;

    /// <summary>Pulls each of <paramref name="keys"/>' history; read once every one of them could be pulled.</summary>
    private async Task ReadHistoryAsync(int opening, IReadOnlyList<string> keys)
    {
        _historyReading = true;
        var read = false;
        try
        {
            var pulled = await Task.WhenAll(keys.Select(Feed.LoadHistoryAsync));
            read = pulled.All(done => done);
        }
        finally
        {
            // A read the view reopened over (another key, or a group's channels changed) leaves the new one's state alone.
            if (opening == _opening)
            {
                _historyReading = false;
                if (read) _historyRead = true;
            }
        }
    }

    private void OnWhoChanged() => _ = InvokeAsync(StateHasChanged);

    private bool StartsGroup(int i) =>
        i == 0 || i == _newAt || !SameRun(_lines[i - 1], _lines[i]) || NoticeBefore(i);

    private int GroupEnd(int i)
    {
        var end = i;
        while (end + 1 < _lines.Count && end + 1 != _newAt && SameRun(_lines[end], _lines[end + 1])
            && !NoticeBefore(end + 1)) end++;
        return end;
    }

    /// <summary>A notice comes just before this line: it ends the run before it, as it is drawn between them.</summary>
    private bool NoticeBefore(int i)
    {
        var after = i > 0 ? _lines[i - 1].Timestamp : DateTimeOffset.MinValue;
        return Notices.Any(n => n.At >= after && n.At < _lines[i].Timestamp);
    }

    private static bool SameRun(CommMessage a, CommMessage b) =>
        a.From.Length > 0
        && string.Equals(a.Channel, b.Channel, StringComparison.OrdinalIgnoreCase)
        && string.Equals(a.From, b.From, StringComparison.Ordinal)
        && string.Equals(a.FromObjId, b.FromObjId, StringComparison.Ordinal)
        && a.Timestamp.ToLocalTime().Date == b.Timestamp.ToLocalTime().Date
        && b.Timestamp - a.Timestamp <= GroupGap;

    /// <summary>A picture given as an image URL rather than a character.</summary>
    private static bool IsUrl(string picture) => !picture.StartsWith('#');

    /// <summary>
    /// A character picture's name, for its initials when it has no picture: known when the character is on the
    /// channel's member list.
    /// </summary>
    private string? PersonaName(string picture) =>
        IsUrl(picture) ? null : Members?.FirstOrDefault(m => string.Equals(m.ObjId, picture, StringComparison.Ordinal))?.Name;

    /// <summary>The room a picture would take, empty: an image that did not load, or a character not on the list.</summary>
    private static readonly RenderFragment NoPicture = builder =>
    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "comm-avatar comm-avatar--none");
        builder.AddAttribute(2, "aria-hidden", "true");
        builder.CloseElement();
    };

    /// <summary>A line's body: its markup drawn as the terminal draws it, or its text when the game sent none.</summary>
    private static RenderFragment Body(CommMessage line) => builder =>
    {
        if (line.Markup is { } markup)
            builder.AddMarkupContent(0, SceneMarkupRenderer.ToHtml(markup));
        else
            builder.AddContent(0, line.Text);
    };

    private string DayLabel(DateTime day)
    {
        var today = DateTime.Now.Date;
        return day == today ? Loc["NavPlayToday"]
            : day == today.AddDays(-1) ? Loc["NavPlayYesterday"]
            : day.ToString("D");
    }

    // Enter in a one-line input inserts nothing, so it needs no preventDefault.
    private Task OnKeyAsync(KeyboardEventArgs e) => e.Key == "Enter" ? SendAsync() : Task.CompletedTask;

    private ElementReference _input;

    /// <summary>Send, clicked: the button goes disabled with the line emptied, so focus goes back to the line.</summary>
    private async Task SendFromButtonAsync()
    {
        await SendAsync();
        try
        {
            await _input.FocusAsync();
        }
        catch (InvalidOperationException)
        {
            // Closed in the meantime: nothing to focus.
        }
    }

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(_text)) return;
        // A group with none of its channels joined has nowhere to send: the draft stays.
        if (Group is not null && SendTo is null) return;
        var typed = _text;
        var text = MushComposeEncoder.Encode(_text.Trim());
        _text = string.Empty;
        if (Group is not null)
        {
            if (SendTo is { } channel) await OnSend.InvokeAsync($"@chat {ChannelBrowserService.Argument(channel)}={text}");
            return;
        }
        if (Conversation is not { } c)
        {
            await OnSend.InvokeAsync($"@chat {Key}={text}");
            return;
        }

        // The page itself comes back through the comm feed; the answer is what else the game told the pager.
        var key = Key;
        var page = $"page {PageTargets(c)}={text}";
        switch (await Commands.RunAsync(page))
        {
            case PortalCommandResponse { Output.Count: > 0 } answered:
                AddNotice(key, answered.Output);
                break;
            case ApiFailure { Kind: ApiFailureKind.Unauthenticated }:
                // No account session (a guest playing from the login screen): the page goes through the terminal,
                // where its answer shows.
                await OnSend.InvokeAsync(page);
                break;
            case ApiFailure failure:
                AddNotice(key, [failure.Message]);
                // Refused, so it never ran: the words are given back, unless something new was typed meanwhile. A
                // lost or unreadable answer may follow a page that went out, so those words stay sent.
                if (failure.Kind is ApiFailureKind.NotFound or ApiFailureKind.Forbidden
                    && string.IsNullOrEmpty(_text) && string.Equals(Key, key, StringComparison.Ordinal)) _text = typed;
                break;
        }
        _ = ReadPresenceAsync();
    }

    private void AddNotice(string key, IReadOnlyList<string> lines)
    {
        if (!_notices.TryGetValue(key, out var held)) _notices[key] = held = [];
        held.Add(new Notice(Clock.GetUtcNow(), lines));
        if (string.Equals(Key, key, StringComparison.Ordinal)) _announcer?.Announce(string.Join(" ", lines));
        StateHasChanged();
    }

    /// <summary>
    /// Each person by full objid when known, else by name in quotes: a name may have spaces. Not the bare dbref:
    /// the conversation outlives its player, and the page command refuses an objid whose dbref was recycled.
    /// </summary>
    private static string PageTargets(CommConversation c) =>
        string.Join(' ', c.With.Select((name, i) =>
            i < c.WithObjIds.Count && c.WithObjIds[i] is { Length: > 0 } objid ? objid : $"\"{name}\""));

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await ReleaseEscapeAsync();
        Feed.Changed -= OnFeedChanged;
        Who.Changed -= OnWhoChanged;
        Groups.Changed -= OnGroupsChanged;
        if (_openedKey is not null) Who.Unwatch(_openedKey);
        if (_openedKey is not null && Feed.Viewed.SequenceEqual(_viewKeys, StringComparer.OrdinalIgnoreCase))
        {
            Feed.Viewed = [];
        }
    }
}
