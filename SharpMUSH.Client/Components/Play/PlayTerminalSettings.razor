@inject IStringLocalizer<SharedResource> Loc

@* Play's terminal settings menu: the width in columns and whether lines wrap there, how tall the input box grows, echo, pages and channels in the output, screen reader mode, the longer log and its export, Clear, and focus mode. The page
   keeps which menu is open, since several can be on it at once (PlaySettingsMenu). *@
<PopoverMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
             Open="Open" OpenChanged="OpenChanged">
    <Activator>
        <button type="button" class="play-settings-btn" @onclick="() => OpenChanged.InvokeAsync(!Open)" @onkeydown="CloseOnEscape"
                title="@Loc["NavTerminalSettings"]" aria-label="@Loc["NavTerminalSettings"]" aria-expanded="@(Open ? "true" : "false")">
            <MudIcon Icon="@Icons.Material.Outlined.Tune" Size="Size.Small" />
        </button>
    </Activator>
    <ChildContent>
        <div class="play-cfg" role="group" aria-label="@Loc["NavTerminalSettings"]" @onclick:stopPropagation="true">
            <div class="play-cfg-kicker">@Loc["Terminal"]</div>
            @* Each option is its name, with an (i) beside it whose details show on hover, focus or a tap (Info below). *@
            <div class="play-cfg-row">
                <span class="play-cfg-name"><label for="@Id("columns")">@Loc["NavTerminalWidthCols"]</label>@Info("columns", Loc["NavTerminalWidthTooltip"])</span>
                <input id="@Id("columns")" name="columns" class="play-cols-input" type="number" min="78" max="240" step="1"
                       aria-describedby="@What("columns")" value="@Columns" @onchange="e => ColumnsChanged.InvokeAsync(e.Value?.ToString())" />
            </div>
            @* Per browser, as the width is: lines stop at the width on a window wider than the font's largest size fills. *@
            @Check("wrap-at-width", Loc["NavWrapAtWidth"], Loc["NavWrapAtWidthTooltip"], WrapAtColumnsOn, WrapAtColumnsChanged)
            @* Per browser, as the width is: how tall the input box grows before it scrolls. *@
            <div class="play-cfg-row">
                <span class="play-cfg-name"><label for="@Id("input-lines")">@Loc["NavInputMaxLines"]</label>@Info("input-lines", Loc["NavInputMaxLinesTooltip"])</span>
                <input id="@Id("input-lines")" name="input-lines" class="play-cols-input" type="number" min="@MinInputLines" max="@MaxInputLines" step="1"
                       aria-describedby="@What("input-lines")" value="@InputLines" @onchange="e => InputLinesChanged.InvokeAsync(e.Value?.ToString())" />
            </div>
            @* Per browser, as the width is. Off hides the sent commands already in the output too. *@
            @Check("echo", Loc["NavEchoCommands"], Loc["NavEchoCommandsTooltip"], EchoOn, EchoChanged)
            @* Per browser, and only while the game files channels and pages in the sidebar: with nowhere else to read them,
               the main output keeps them. *@
            @if (CommsFiled)
            {
                @Check("hide-pages", Loc["NavHidePages"], Loc["NavHidePagesTooltip"], HidePagesOn, HidePagesChanged)
                @Check("hide-channels", Loc["NavHideChannels"], Loc["NavHideChannelsTooltip"], HideChannelsOn, HideChannelsChanged)
            }
            @* Per browser, and here rather than in Settings so a guest can turn it on too. *@
            @Check("screen-reader", Loc["NavScreenReaderMode"], Loc["NavScreenReaderModeTooltip"], ScreenReaderOn, ScreenReaderChanged)
            @* Off until the player turns it on, with what it keeps and where said beside it (TerminalLog). *@
            @Check("keep-logs", Loc["NavKeepLongerLogs"],
                Loc["NavKeepLongerLogsTooltip", TerminalLog.MaxLines.ToString("N0"), (int)TerminalLog.MaxAge.TotalDays], KeepLogsOn, KeepLogsChanged)
            @* While the longer log is on: save a stretch of it as a file (PlayLogExportDialog). *@
            @if (KeepLogsOn)
            {
                <button type="button" class="play-cfg-item" @onclick="OnExportLog">
                    <MudIcon Icon="@Icons.Material.Outlined.Download" Style="font-size:var(--text-md);" />
                    <span>@Loc["PlayLogExportOpen"]</span>
                </button>
            }
            <button type="button" class="play-cfg-item" @onclick="OnClear">
                <MudIcon Icon="@Icons.Material.Outlined.ClearAll" Style="font-size:var(--text-md);" />
                <span>@Loc["TermClearTerminal"]</span>
            </button>
            @* The header's focus button, for a phone where Play.razor.css folds it into this menu. *@
            <button type="button" class="play-cfg-item play-cfg-focus" @onclick="() => FocusChanged.InvokeAsync(!Focus)">
                <MudIcon Icon="@(Focus ? Icons.Material.Outlined.FullscreenExit : Icons.Material.Outlined.Fullscreen)" Style="font-size:var(--text-md);" />
                <span>@(Focus ? Loc["NavExitFocusMode"] : Loc["NavFocusMode"])</span>
            </button>
        </div>
    </ChildContent>
</PopoverMenu>

@code {
    /// <summary>Where this menu is offered; it keeps the ids of each one on the page apart.</summary>
    [Parameter, EditorRequired] public PlaySettingsMenu Menu { get; set; }

    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>Escape on the menu's button closes whichever menu is open.</summary>
    [Parameter] public EventCallback OnEscape { get; set; }

    /// <summary>The terminal's width in columns.</summary>
    [Parameter] public int Columns { get; set; }

    /// <summary>The width as typed, for the page to clamp and keep.</summary>
    [Parameter] public EventCallback<string?> ColumnsChanged { get; set; }

    /// <summary>Lines wrap at <see cref="Columns"/>, however wide the window.</summary>
    [Parameter] public bool WrapAtColumnsOn { get; set; }
    [Parameter] public EventCallback<bool> WrapAtColumnsChanged { get; set; }

    /// <summary>The most lines the input box grows to before it scrolls.</summary>
    [Parameter] public int InputLines { get; set; } = GlobalTerminal.DefaultInputMaxLines;

    /// <summary>The lines as typed, for the page to clamp and keep.</summary>
    [Parameter] public EventCallback<string?> InputLinesChanged { get; set; }

    /// <summary>The fewest and most lines the input box may be set to grow to.</summary>
    public const int MinInputLines = 1, MaxInputLines = 20;

    /// <summary>The terminal shows the commands the player sends.</summary>
    [Parameter] public bool EchoOn { get; set; } = true;
    [Parameter] public EventCallback<bool> EchoChanged { get; set; }

    /// <summary>The game files channels and pages in Play's sidebar, so the main output may leave them out.</summary>
    [Parameter] public bool CommsFiled { get; set; }

    /// <summary>The main output leaves out pages.</summary>
    [Parameter] public bool HidePagesOn { get; set; }
    [Parameter] public EventCallback<bool> HidePagesChanged { get; set; }

    /// <summary>The main output leaves out channel lines.</summary>
    [Parameter] public bool HideChannelsOn { get; set; }
    [Parameter] public EventCallback<bool> HideChannelsChanged { get; set; }

    [Parameter] public bool ScreenReaderOn { get; set; }
    [Parameter] public EventCallback<bool> ScreenReaderChanged { get; set; }

    /// <summary>The play terminal's longer log is on in this browser.</summary>
    [Parameter] public bool KeepLogsOn { get; set; }
    [Parameter] public EventCallback<bool> KeepLogsChanged { get; set; }

    /// <summary>Opens the export of the longer log; offered while it is on.</summary>
    [Parameter] public EventCallback OnExportLog { get; set; }

    [Parameter] public EventCallback OnClear { get; set; }

    [Parameter] public bool Focus { get; set; }
    [Parameter] public EventCallback<bool> FocusChanged { get; set; }

    /// <summary>An option's id, apart for each menu on the page.</summary>
    private string Id(string name) => $"play-cfg-{name}-{Menu}";

    /// <summary>The id of an option's details, which its control is described by.</summary>
    private string What(string name) => $"play-cfg-{name}-what-{Menu}";

    /// <summary>
    /// The (i) beside an option's name: its details in a tooltip on hover, focus or a tap, and in a hidden copy the
    /// option's control is described by, so a screen reader still reads them.
    /// </summary>
    private RenderFragment Info(string name, string details) => __builder =>
    {
        <span class="visually-hidden" id="@What(name)">@details</span>
        <MudTooltip Placement="Placement.Bottom" ShowOnHover="true" ShowOnFocus="true" ShowOnClick="true">
            <ChildContent>
                <span class="play-cfg-info" tabindex="0" role="img" aria-label="@details">
                    <MudIcon Icon="@Icons.Material.Outlined.Info" />
                </span>
            </ChildContent>
            <TooltipContent>
                <div class="play-cfg-tip">@details</div>
            </TooltipContent>
        </MudTooltip>
    };

    /// <summary>A checkbox option: its name, its (i), and the box.</summary>
    private RenderFragment Check(string name, string label, string details, bool on, EventCallback<bool> changed) => __builder =>
    {
        <div class="play-cfg-row">
            <span class="play-cfg-name"><label for="@Id(name)">@label</label>@Info(name, details)</span>
            <input id="@Id(name)" name="@name" class="play-cfg-check" type="checkbox" checked="@on"
                   aria-describedby="@What(name)" @onchange="e => changed.InvokeAsync(e.Value is true)" />
        </div>
    };

    private Task CloseOnEscape(KeyboardEventArgs e) => e.Key == "Escape" ? OnEscape.InvokeAsync() : Task.CompletedTask;
}
