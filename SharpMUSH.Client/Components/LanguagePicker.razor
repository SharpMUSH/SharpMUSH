@using System.Globalization
@using SharpMUSH.Client.Resources
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject ILogger<LanguagePicker> Logger
@inject IStringLocalizer<SharedResource> Loc

@* The language button and its list. Escape and a click outside close it (PopoverMenu); Up and Down move
   between the languages. *@
<PopoverMenu AnchorOrigin="AnchorOrigin" TransformOrigin="TransformOrigin" ArrowKeys="true" Open="_open" OpenChanged="v => _open = v">
    <Activator>
        <MudIconButton Icon="@Icons.Material.Filled.Language" Color="Color.Inherit" aria-label="@Loc["NavLanguage"]"
                       aria-expanded="@(_open ? "true" : "false")" OnClick="() => _open = !_open" @onkeydown="CloseOnEscape" />
    </Activator>
    <ChildContent>
        <div class="lang-list" role="group" aria-label="@Loc["NavLanguage"]">
            @foreach (var lang in _languages)
            {
                var current = lang.Code == _currentLocale;
                <button type="button" class="lang-item" lang="@lang.Code" aria-current="@(current ? "true" : null)"
                        @onclick="@(() => SetLanguageAsync(lang.Code))">
                    <span>@lang.DisplayName</span>
                    @if (current)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Secondary" aria-hidden="true" />
                    }
                </button>
            }
        </div>
    </ChildContent>
</PopoverMenu>

@code {
    /// <summary>Where the menu anchors: under the old top bar's icon by default; beside the rail's.</summary>
    [Parameter] public Origin AnchorOrigin { get; set; } = Origin.BottomRight;
    [Parameter] public Origin TransformOrigin { get; set; } = Origin.TopRight;

    private string _currentLocale = "en";
    private bool _open;

    private void CloseOnEscape(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _open = false;
    }

    private readonly record struct LanguageOption(string Code, string DisplayName);

    private static readonly LanguageOption[] _languages = PortalLocales.Codes
        .Select(code => new LanguageOption(code, PortalLocales.DisplayName(code)))
        .ToArray();

    // Program.cs has already read the stored locale and made it the UI culture (resetting a bad tag
    // to English), so that answer is taken from there rather than read from storage a second time.
    protected override void OnInitialized()
        => _currentLocale = CultureInfo.DefaultThreadCurrentUICulture?.Name is { Length: > 0 } name ? name : "en";

    private async Task SetLanguageAsync(string locale)
    {
        if (locale == _currentLocale) return;

        // The culture is read from storage at startup, so a locale that could not be stored would be
        // lost to the reload below; stay on the current one instead.
        if (!await JSRuntime.SetItemAsync(BrowserStore.Local, "locale", locale))
        {
            Logger.LogWarning("Could not store the locale {Locale}; keeping {Current}", locale, _currentLocale);
            return;
        }

        _currentLocale = locale;

        // Reload the app to apply new culture (Blazor WASM requires restart for culture change)
        NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
    }
}
