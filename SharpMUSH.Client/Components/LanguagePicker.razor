@using SharpMUSH.Client.Resources
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject ILogger<LanguagePicker> Logger

<MudMenu Icon="@Icons.Material.Filled.Language" Color="Color.Inherit" Dense="true" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
    @foreach (var lang in _languages)
    {
        <MudMenuItem OnClick="@(() => SetLanguageAsync(lang.Code))">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudText Typo="Typo.body2">@lang.DisplayName</MudText>
                @if (lang.Code == _currentLocale)
                {
                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Secondary" />
                }
            </MudStack>
        </MudMenuItem>
    }
</MudMenu>

@code {
    private string _currentLocale = "en";

    private readonly record struct LanguageOption(string Code, string DisplayName);

    private static readonly LanguageOption[] _languages = PortalLocales.Codes
        .Select(code => new LanguageOption(code, PortalLocales.DisplayName(code)))
        .ToArray();

    protected override async Task OnInitializedAsync()
    {
        var stored = await JSRuntime.GetItemAsync(BrowserStore.Local, "locale");
        _currentLocale = stored ?? "en";
    }

    private async Task SetLanguageAsync(string locale)
    {
        if (locale == _currentLocale) return;

        // The culture is read from storage at startup, so a locale that could not be stored would be
        // lost to the reload below; stay on the current one instead.
        if (!await JSRuntime.SetItemAsync(BrowserStore.Local, "locale", locale))
        {
            Logger.LogWarning("Could not store the locale {Locale}; keeping {Current}", locale, _currentLocale);
            return;
        }

        _currentLocale = locale;

        // Reload the app to apply new culture (Blazor WASM requires restart for culture change)
        NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
    }
}
