@* An admin page whose screen is not built yet: its header and one card saying what will be here. *@
<div class="page-stack page-stack--padded">
    <PlainPageHeader Kicker="@Kicker" Title="@Title" />

    <KitCard Title="@CardTitle">
        <div class="adm-soon">
            <MudIcon Icon="@Icon" Class="adm-soon-icon" />
            <div class="adm-soon-text">@Message</div>
        </div>
    </KitCard>
</div>

@code {
    [Parameter, EditorRequired] public string Kicker { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Icon { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Message { get; set; } = string.Empty;

    /// <summary>A heading on the card, when the page needs to say who it is for.</summary>
    [Parameter] public string? CardTitle { get; set; }
}
