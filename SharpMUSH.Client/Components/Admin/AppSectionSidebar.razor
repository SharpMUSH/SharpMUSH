@using SharpMUSH.Client.Services
@using SharpMUSH.Client.Models.Applications
@using SharpMUSH.Library.Authorization
@using Microsoft.AspNetCore.Components.Routing
@inject ApplicationRegistryClient Registry
@inject NavigationManager Nav
@implements IDisposable

@* The sidebar of a section that exists only because applications name it (README §3: a novel
   section gets a rail item and its apps are its sidebar). *@
<SidebarPanel Class="app-section-side" Collapsed="@Collapsed">
    @if (!Collapsed)
    {
        <SidebarHead Title="@Section" />
    }
    <SidebarGroup Label="@Section">
        @foreach (var app in _apps)
        {
            var a = app;
            var href = $"/apps/{a.Slug}";
            <SidebarRow Lead="SidebarRow.SidebarLead.Icon" Icon="@AppIcons.Outline(a.Icon, Icons.Material.Outlined.Apps)"
                        Label="@a.DisplayName" Href="@href" IsCurrent="@IsCurrent(href)" Collapsed="@Collapsed" />
        }
    </SidebarGroup>
</SidebarPanel>

@code {
    [Parameter, EditorRequired] public string Section { get; set; } = string.Empty;
    [Parameter] public bool Collapsed { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private IReadOnlyList<PortalApplication> _apps = [];
    private string _path = "/";

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        Locate();
    }

    protected override async Task OnParametersSetAsync()
    {
        var user = AuthState is null ? null : (await AuthState).User;
        _apps = PortalNavSections.AppsForSection(await Registry.ListAsync(), user, Section);
    }

    private bool IsCurrent(string href) =>
        _path.Equals(href, StringComparison.OrdinalIgnoreCase) || _path.StartsWith(href + "/", StringComparison.OrdinalIgnoreCase);

    private void Locate()
    {
        _path = SectionPath.Of(Nav).Path;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(() =>
    {
        Locate();
        StateHasChanged();
    });

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
