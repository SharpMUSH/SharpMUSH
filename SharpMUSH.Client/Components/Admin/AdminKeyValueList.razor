@using SharpMUSH.Client.Services
@using SharpMUSH.Library.DiscriminatedUnions
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> Loc

@*
    The admin config list: an add form, a sorted list of entries, a delete button per row.
    Sitelock rules, banned names and both restriction tables are this page with the nouns swapped,
    and each of them used to carry its own copy of the load/add/delete triple and its own snackbar
    handling. The text is passed in so each page keeps its own resource keys; the behaviour is here.
*@

@* D1 frame: the add form is a kit card of MudBlazor fields with the one primary capsule, the list a
   kit card of rows. The fields used to be raw inputs whose styling lived in each page's scoped CSS,
   which never reaches into this component, so they rendered as bare white boxes. *@
<div class="page-stack kvl">
    @if (_loading)
    {
        <MudProgressLinear Color="Color.Secondary" Indeterminate="true" />
    }
    else
    {
        <KitCard Title="@Text.AddTitle">
            <div class="kvl-add @(HasValues ? "kvl-add--pair" : null)">
                <MudTextField T="string" Value="@_newKey" ValueChanged="@(v => _newKey = v ?? string.Empty)"
                              Label="@Text.KeyLabel" Placeholder="@Text.KeyPlaceholder"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                              Class="kvl-field kvl-field--key"
                              OnKeyDown="HandleKeyDown" />
                @if (HasValues)
                {
                    <MudTextField T="string" Value="@_newValues" ValueChanged="@(v => _newValues = v ?? string.Empty)"
                                  Label="@Text.ValuesLabel" Placeholder="@Text.ValuesPlaceholder"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                                  Class="kvl-field kvl-field--values"
                                  OnKeyDown="HandleKeyDown" />
                }
                <CapsuleButton Primary="true" Icon="@Icons.Material.Filled.Add" Class="kvl-add-btn"
                               Disabled="@(!CanAdd)" OnClick="AddAsync">@Text.AddButton</CapsuleButton>
            </div>
        </KitCard>

        <KitCard Title="@Text.ListTitle">
            <Controls>
                <Pill Tag="true">@_entries.Count</Pill>
            </Controls>
            <ChildContent>
                @if (_entries.Count == 0)
                {
                    <p class="config-empty">@Text.Empty</p>
                }
                else
                {
                    <ul class="kvl-rows">
                        @foreach (var entry in _entries.OrderBy(e => e.Key, StringComparer.OrdinalIgnoreCase))
                        {
                            <li class="kvl-row">
                                <div class="kvl-row-text">
                                    <code class="config-list-name">@entry.Key</code>
                                    @if (Text.SingleValue)
                                    {
                                        var value = entry.Values.Count > 0 ? entry.Values[0] : string.Empty;
                                        <span class="config-list-sub">
                                            @if (value.Length == 0)
                                            {
                                                @Text.EmptyValue
                                            }
                                            else
                                            {
                                                <code style="white-space: pre">"@value"</code>
                                            }
                                        </span>
                                    }
                                    else if (entry.Values.Count > 0)
                                    {
                                        <span class="config-list-sub">@string.Join(", ", entry.Values)</span>
                                    }
                                </div>
                                <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Size="Size.Small" Color="Color.Error"
                                               Class="config-delete" aria-label="@Loc["Delete"]" title="@Loc["Delete"]"
                                               OnClick="@(() => DeleteAsync(entry.Key))" />
                            </li>
                        }
                    </ul>
                }
            </ChildContent>
        </KitCard>
    }
</div>

@code {
    /// <summary>Every string this list renders, so the page keeps its own resource keys.</summary>
    [Parameter, EditorRequired]
    public AdminKeyValueListText Text { get; set; } = default!;

    /// <summary>
    /// Reads the current rows. A row with no values renders bare. Rows, not a map: the server's
    /// lists are case-sensitive, so two keys differing only in case are two rows and both arrive.
    /// </summary>
    [Parameter, EditorRequired]
    public Func<Task<ApiResult<IReadOnlyList<AdminKeyValueEntry>>>> Load { get; set; } = default!;

    /// <summary>Adds one entry. The values array is empty for a key-only list.</summary>
    [Parameter, EditorRequired]
    public Func<string, string[], Task<ApiResult<Success>>> Add { get; set; } = default!;

    [Parameter, EditorRequired]
    public Func<string, Task<ApiResult<Success>>> Delete { get; set; } = default!;

    /// <summary>
    /// Whether an entry carries a comma-separated value list (sitelock access rules, restriction
    /// flags) or is a bare key (a banned name). It follows from the text: a list with no values has
    /// nothing to label them with.
    /// </summary>
    private bool HasValues => Text.ValuesLabel is not null;

    private bool CanAdd => !string.IsNullOrWhiteSpace(_newKey)
        && (!HasValues || Text.SingleValue || !string.IsNullOrWhiteSpace(_newValues));

    private bool _loading = true;
    private IReadOnlyList<AdminKeyValueEntry> _entries = [];
    private string _newKey = string.Empty;
    private string _newValues = string.Empty;

    protected override Task OnInitializedAsync() => ReloadAsync();

    /// <summary>Re-reads the list. Public so a page holding two of these can refresh one.</summary>
    public async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            _entries = await Load() switch
            {
                IReadOnlyList<AdminKeyValueEntry> loaded => loaded,
                ApiFailure failure => Failed(failure)
            };
        }
        finally
        {
            _loading = false;
        }

        IReadOnlyList<AdminKeyValueEntry> Failed(ApiFailure failure)
        {
            Snackbar.Add(Text.LoadFailed(failure), Severity.Error);
            return [];
        }
    }

    private async Task AddAsync()
    {
        if (!CanAdd) return;

        var key = _newKey.Trim();
        string[] values = !HasValues ? []
            : Text.SingleValue ? [_newValues]
            : _newValues.Split(',').Select(v => v.Trim()).Where(v => v.Length > 0).ToArray();

        if (HasValues && !Text.SingleValue && values.Length == 0)
        {
            Snackbar.Add(Text.ValuesRequired ?? Loc["AtLeastOneAccessRule"].Value, Severity.Warning);
            return;
        }

        switch (await Add(key, values))
        {
            case Success:
                Snackbar.Add(Text.Added(key), Severity.Success);
                _newKey = string.Empty;
                _newValues = string.Empty;
                await ReloadAsync();
                break;
            case ApiFailure failure:
                Snackbar.Add(Text.AddFailed(key, failure), Severity.Error);
                break;
        }
    }

    private async Task DeleteAsync(string key)
    {
        switch (await Delete(key))
        {
            case Success:
                Snackbar.Add(Text.Removed(key), Severity.Success);
                await ReloadAsync();
                break;
            case ApiFailure failure:
                Snackbar.Add(Text.RemoveFailed(key, failure), Severity.Error);
                break;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddAsync();
    }
}
