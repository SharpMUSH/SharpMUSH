@using SharpMUSH.Client.Services
@using SharpMUSH.Client.Models.Applications
@using SharpMUSH.Library.Authorization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Routing
@inject IStringLocalizer<SharedResource> Loc
@inject NavigationManager Nav
@inject ApplicationRegistryClient Registry
@inject IAuthorizationService Authorization
@implements IDisposable

@* D1 §3 Build & manage page sidebar: the overview, then each group of destinations the viewer may
   use (the same entries and gates as the rail, the drawer and the overview, from BuildNavCatalog) and,
   under Apps, the applications placed in Build or Manage. Collapsed keeps each row's icon. *@
<SidebarPanel Class="build-side" Collapsed="@Collapsed">
    @if (!Collapsed)
    {
        <SidebarHead Title="@Loc["NavBuildManage"]">
            <Sub>@Loc["NavBuildManageSub"]</Sub>
        </SidebarHead>
    }
    @foreach (var group in _entries.GroupBy(e => e.Group))
    {
        var label = BuildNavCatalog.GroupLabelKey(group.Key) is { } key ? Loc[key].Value : Loc["NavBuildManage"].Value;
        @if (!Collapsed && BuildNavCatalog.GroupLabelKey(group.Key) is not null)
        {
            <SectionLabel>@label</SectionLabel>
        }
        <SidebarGroup Label="@label">
            @foreach (var entry in group)
            {
                var e = entry;
                <SidebarRow Lead="SidebarRow.SidebarLead.Icon" Icon="@e.Icon" Label="@Loc[e.LabelKey]" Href="@e.Href"
                            IsCurrent="@IsCurrent(e.Href, e.ExactMatch)" Collapsed="@Collapsed" />
            }
        </SidebarGroup>
    }
    @if (_apps.Count > 0)
    {
        @if (!Collapsed)
        {
            <SectionLabel>@Loc["NavApps"]</SectionLabel>
        }
        <SidebarGroup Label="@Loc["NavApps"]">
            @foreach (var app in _apps)
            {
                var a = app;
                <SidebarRow Lead="SidebarRow.SidebarLead.Icon" Icon="@AppIcons.Outline(a.Icon, Icons.Material.Outlined.Apps)"
                            Label="@a.DisplayName" Href="@($"/apps/{a.Slug}")" IsCurrent="@IsCurrent($"/apps/{a.Slug}", false)" Collapsed="@Collapsed" />
            }
        </SidebarGroup>
    }
</SidebarPanel>

@code {
    [Parameter] public bool Collapsed { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private IReadOnlyList<BuildNavCatalog.Entry> _entries = [];
    private IReadOnlyList<PortalApplication> _apps = [];
    private string _path = "/";

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        Locate();
    }

    private Task<AuthenticationState>? _gatesFor;
    private bool _gatesKnown;

    protected override async Task OnParametersSetAsync()
    {
        // The gates depend only on who is signed in; a parent re-render (a terminal toggle, a palette
        // opening) passes new callbacks and would otherwise re-ask every policy.
        if (_gatesKnown && ReferenceEquals(AuthState, _gatesFor)) return;
        (_gatesFor, _gatesKnown) = (AuthState, true);
        var user = AuthState is null ? new System.Security.Claims.ClaimsPrincipal() : (await AuthState).User;
        _entries = await BuildNavCatalog.VisibleAsync(Authorization, user);
        var all = await Registry.ListAsync();
        _apps = [.. PortalNavSections.AppsForSection(all, user, "Build"), .. PortalNavSections.AppsForSection(all, user, "Manage")];
    }

    /// <summary>
    /// The row for this page; on an admin page the sidebar does not list (the design kit) the
    /// overview row stands for it.
    /// </summary>
    private bool IsCurrent(string href, bool exact) =>
        Matches(href, exact)
        || (href == Dashboard
            && _path.StartsWith(Dashboard + "/", StringComparison.OrdinalIgnoreCase)
            && !_entries.Any(e => Matches(e.Href, e.ExactMatch)));

    private const string Dashboard = "/admin";

    private bool Matches(string href, bool exact) =>
        _path.Equals(href, StringComparison.OrdinalIgnoreCase)
        || (!exact && _path.StartsWith(href + "/", StringComparison.OrdinalIgnoreCase));

    private void Locate()
    {
        _path = SectionPath.Of(Nav).Path;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(() =>
    {
        Locate();
        StateHasChanged();
    });

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
