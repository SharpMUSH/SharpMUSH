@using SharpMUSH.Client.Services
@using SharpMUSH.Library.Models
@using SharpMUSH.Library.DiscriminatedUnions
@inject NativeCharacterCredentialsClient Native
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> Loc
@implements IAsyncDisposable

<section class="acct-section" aria-label="@Loc["AuthNativeLoginTitle"]">
    <h3>@Loc["AuthNativeLoginFor", Character.Name]</h3>
    <p>@Loc["AuthNativeLoginExplanation"]</p>
    <RecentAccountProofPrompt Operation="AccountSecurityOperation.NativeLogin" OnProved="NativeProved" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || _nativeGrant is null)" OnClick="Generate">@Loc["AuthNativeGenerate"]</MudButton>
    <MudButton Variant="Variant.Text" OnClick="() => OnClose.InvokeAsync()">@Loc["AuthNativeClose"]</MudButton>
    @if (_error is not null) { <MudAlert Severity="Severity.Error" role="alert">@_error</MudAlert> }
    @if (_mint is { } minted && minted.ExpiresAt > _now)
    {
        <div role="status" class="mt-4">
            <p>@Loc["AuthNativeExpiresIn", Math.Max(0, (int)(minted.ExpiresAt - _now).TotalSeconds)]</p>
            <code>@($"connect token {minted.Secret}")</code>
            <MudButton OnClick="Copy">@Loc["AuthNativeCopy"]</MudButton>
        </div>
    }
    <p>@Loc["AuthNativeTransportAdvice"]</p>
    @if (Pending.Count != 0)
    {
        <h4>@Loc["AuthNativePending"]</h4>
        @foreach (var pending in Pending)
        {
            <div @key="pending.Id">
                <span>@Loc["AuthNativeExpiresIn", Math.Max(0, (int)(pending.ExpiresAt - _now).TotalSeconds)]</span>
                <MudButton Disabled="_busy" OnClick="() => Revoke(pending.Id)">@Loc["AuthNativeRevoke"]</MudButton>
            </div>
        }
    }
    <MudButton Variant="Variant.Outlined" Class="mt-4" OnClick="() => _showPassword = !_showPassword">@Loc["AuthNativeCharacterPassword"]</MudButton>
    @if (_showPassword)
    {
        <p>@Loc["AuthNativePasswordExplanation"]</p>
        <MudTextField Variant="Variant.Outlined" @bind-Value="_password" InputType="InputType.Password" Label="@Loc["AuthNewPassword"]" />
        <MudTextField Variant="Variant.Outlined" @bind-Value="_confirmation" InputType="InputType.Password" Label="@Loc["AuthConfirmPassword"]" />
        <MudCheckBox @bind-Value="_disconnectOthers" Label="@Loc["AuthNativeDisconnectOthers"]" />
        <RecentAccountProofPrompt Operation="AccountSecurityOperation.CharacterPassword" OnProved="PasswordProved" />
        <MudButton OnClick="SetPassword" Disabled="@(_busy || _passwordGrant is null)">@Loc["AuthNativeSetPassword"]</MudButton>
        @if (_passwordChanged) { <p role="status">@Loc["AuthNativePasswordChanged"]</p> }
    }
</section>

@code {
    [Parameter, EditorRequired] public AccountAuthService.CharacterSummary Character { get; set; } = null!;
    [Parameter] public EventCallback OnClose { get; set; }
    private readonly CancellationTokenSource _stop = new();
    private Task? _timer;
    private bool _busy, _showPassword, _passwordChanged, _disconnectOthers;
    private string? _nativeGrant, _passwordGrant, _error;
    private string _password = "", _confirmation = "";
    private NativeLoginSecretResponse? _mint;
    private IReadOnlyList<NativeLoginStatusResponse> _pending = [];
    private DateTimeOffset _now = DateTimeOffset.UtcNow;
    private IReadOnlyList<NativeLoginStatusResponse> Pending => _pending.Where(p => p.CharacterKey == Character.DbrefNumber && p.CharacterCreationTime == Character.CreationTime && p.ExpiresAt > _now).ToArray();

    protected override async Task OnInitializedAsync()
    {
        await Reload();
        _timer = Tick();
    }

    private async Task Tick()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(_stop.Token))
                await InvokeAsync(() => { _now = DateTimeOffset.UtcNow; if (_mint is { } mint && mint.ExpiresAt <= _now) _mint = null; StateHasChanged(); });
        }
        catch (OperationCanceledException) { }
    }

    private Task NativeProved(string grant) { _nativeGrant = grant; return Task.CompletedTask; }
    private Task PasswordProved(string grant) { _passwordGrant = grant; return Task.CompletedTask; }

    private async Task Reload()
    {
        switch (await Native.ListAsync())
        {
            case IReadOnlyList<NativeLoginStatusResponse> pending: _pending = pending; break;
            case ApiFailure failure: _error = failure.Message; break;
        }
    }

    private async Task Generate()
    {
        if (_nativeGrant is not { } grant) return;
        _nativeGrant = null;
        _mint = null;
        _busy = true;
        _error = null;
        try
        {
            switch (await Native.MintAsync(Character.DbrefNumber, Character.CreationTime, grant))
            {
                case NativeLoginSecretResponse mint: _mint = mint; break;
                case ApiFailure failure: _error = failure.Message; break;
            }
            await Reload();
        }
        finally { _busy = false; }
    }

    private async Task Copy()
    {
        if (_mint is not { } mint || mint.ExpiresAt <= DateTimeOffset.UtcNow) return;
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", $"connect token {mint.Secret}"); }
        catch (JSException) { _error = Loc["AuthNativeCopyFailed"]; }
    }

    private async Task Revoke(string id)
    {
        _busy = true;
        try
        {
            if (await Native.RevokeAsync(id) is ApiFailure failure) _error = failure.Message;
            else if (_mint?.Id == id) _mint = null;
            await Reload();
        }
        finally { _busy = false; }
    }

    private async Task SetPassword()
    {
        if (_passwordGrant is not { } grant) return;
        _passwordGrant = null;
        _busy = true;
        _passwordChanged = false;
        try
        {
            if (await Native.SetPasswordAsync(Character.DbrefNumber, Character.CreationTime, _password, _confirmation, grant, _disconnectOthers) is ApiFailure failure) _error = failure.Message;
            else { _passwordChanged = true; _mint = null; _password = ""; _confirmation = ""; }
            await Reload();
        }
        finally { _busy = false; }
    }

    public async ValueTask DisposeAsync()
    {
        await _stop.CancelAsync();
        if (_timer is not null) await _timer;
        _stop.Dispose();
        _mint = null;
        _nativeGrant = null;
        _passwordGrant = null;
        _password = "";
        _confirmation = "";
    }
}
