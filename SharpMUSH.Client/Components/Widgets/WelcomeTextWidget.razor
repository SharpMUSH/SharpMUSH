@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization
@using SharpMUSH.Client.Models.Widgets
@using Markdig

@* D1 §6.5: the admin's markdown as a card in the page's main column. *@
@if (_visible && !string.IsNullOrWhiteSpace(_html))
{
    <div class="welcome-text-widget">
        <KitCard>
            <div class="welcome-text-body">@((MarkupString)_html)</div>
        </KitCard>
    </div>
}

@code {
    [Parameter] public JsonElement? Config { get; set; }

    /// <summary>
    /// Injected by ZoneRenderer. Not used for rendering but must be declared so
    /// DynamicComponent does not throw for unmatched parameters.
    /// </summary>
    [Parameter] public string Zone { get; set; } = string.Empty;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string _html = string.Empty;
    private bool _visible = true;

    protected override async Task OnParametersSetAsync()
    {
        if (Config is null)
        {
            _html = string.Empty;
            return;
        }

        WelcomeTextConfig? cfg;
        try
        {
            cfg = Config.Value.Deserialize<WelcomeTextConfig>(
                new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });

            _html = cfg is not null && !string.IsNullOrWhiteSpace(cfg.Markdown)
                ? ApiUrl.ResolveHtml(Markdown.ToHtml(cfg.Markdown))
                : string.Empty;
        }
        catch (JsonException)
        {
            _html = string.Empty;
            return;
        }
        catch (NotSupportedException)
        {
            _html = string.Empty;
            return;
        }
        catch (ArgumentException)
        {
            // Invalid markdown input — fall back to empty
            _html = string.Empty;
            return;
        }

        // "Members only" welcome text: hide from signed-out visitors. With no cascading auth state
        // (e.g. a bare component test) treat the viewer as a guest, so the stricter setting wins.
        _visible = (cfg?.ShowToGuests ?? true) || await IsAuthenticatedAsync();
    }

    private async Task<bool> IsAuthenticatedAsync()
        => AuthState is not null && (await AuthState).User.Identity?.IsAuthenticated == true;
}
