@using System.Text.Json
@using SharpMUSH.Client.Models
@using SharpMUSH.Client.Services
@inject SceneService SceneService
@inject IStringLocalizer<SharedResource> Loc

@* D1 §6.1 "Live now · N" as an aside card: a tile per live scene (up to three) linking to its live
   view, with the room as the second line. Scenes carry no image yet, so the tile shows its icon
   fill until room images reach the scene summary. *@
<div class="active-scene-widget">
    <KitCard Aside="true" Title="@Loc.Plural("NavLiveNow", "count", _activeScenes?.Count ?? 0)">
        @if (_loading)
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="52px" Style="border-radius:var(--radius-tile);" />
        }
        else if (_activeScenes is { Count: > 0 })
        {
            <div class="active-scene-tiles">
                @foreach (var scene in _activeScenes.Take(3))
                {
                    var s = scene;
                    <ImageTile Label="@SceneTitle(s)" Sub="@s.RoomName" Count="@s.PoseCount" Icon="@Icons.Material.Outlined.Theaters" Href="@($"/scenes/{s.Id}/live")" />
                }
            </div>
        }
        else
        {
            <div class="active-scene-empty">
                @if (_error is not null)
                {
                    <span class="active-scene-widget-error">@_error</span>
                }
                else
                {
                    <span>@Loc["WidNoActiveScenes"]</span>
                }
            </div>
            <a class="active-scene-archive" href="/scenes">@Loc["WidBrowseArchive"]</a>
        }
    </KitCard>
</div>

@code {
    [Parameter] public JsonElement? Config { get; set; }
    [Parameter] public string Zone { get; set; } = string.Empty;

    private IReadOnlyList<SceneSummary>? _activeScenes;
    private string? _error;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        var result = await SceneService.GetActiveScenesAsync();
        (_activeScenes, _error) = result switch
        {
            IReadOnlyList<SceneSummary> scenes => (scenes, (string?)null),
            ApiFailure failure => (null, failure.Message),
        };
        _loading = false;
    }

    private string SceneTitle(SceneSummary s) =>
        s.Meta.TryGetValue("title", out var t) && !string.IsNullOrWhiteSpace(t)
            ? t
            : Loc["WidSceneIn", s.RoomName];
}
