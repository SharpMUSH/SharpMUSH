@using System.Text.Json
@using SharpMUSH.Client.Models
@using SharpMUSH.Client.Services
@inject SceneService SceneService
@inject IAccountAuthState AccountAuth
@implements IDisposable
@inject IStringLocalizer<SharedResource> Loc

@* D1 §6.1 "Live now · N" as an aside card: a tile per live scene (up to three) linking to its live
   view, with the room as the second line. Scenes carry no image yet, so the tile shows its icon
   fill until room images reach the scene summary. Placed in a page's main column (the home page)
   it takes the main card instead, its tiles across the width. *@
<div class="active-scene-widget">
    <KitCard Aside="@(!InMain)" Title="@Loc.Plural("NavLiveNow", "count", _activeScenes?.Count ?? 0)"
             Sub="@(InMain ? Loc["WidLiveNowSub"].Value : null)"
             Controls="@(InMain ? ArchiveLink : null)">
        <div class="@(InMain ? "active-scene-body--main" : null)">
            @if (_loading)
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="52px" Style="border-radius:var(--radius-tile);" />
            }
            else if (_activeScenes is { Count: > 0 })
            {
                <div class="active-scene-tiles @(InMain ? "active-scene-tiles--main" : null)">
                    @foreach (var scene in _activeScenes.Take(InMain ? 6 : 3))
                    {
                        <ImageTile Label="@SceneTitle(scene)" Sub="@scene.RoomName" Count="@scene.PoseCount" Icon="@Icons.Material.Outlined.Theaters" Href="@($"/scenes/{scene.Id}/live")" />
                    }
                </div>
            }
            else
            {
                <div class="active-scene-empty">
                    @if (_error is not null)
                    {
                        <span class="active-scene-widget-error">@_error</span>
                    }
                    else
                    {
                        <span>@Loc["WidNoActiveScenes"]</span>
                    }
                </div>
                @if (!InMain)
                {
                    <a class="active-scene-archive" href="/scenes">@Loc["WidBrowseArchive"]</a>
                }
            }
        </div>
    </KitCard>
</div>

@code {
    [Parameter] public JsonElement? Config { get; set; }
    [Parameter] public string Zone { get; set; } = string.Empty;

    /// <summary>In a page's main column the widget takes the main card rather than the aside one.</summary>
    private bool InMain => Zone == nameof(WidgetZone.MainContent);

    private RenderFragment ArchiveLink => __builder =>
    {
        <a class="active-scene-archive" href="/scenes">@Loc["WidBrowseArchive"]</a>
    };

    private IReadOnlyList<SceneSummary>? _activeScenes;
    private string? _error;
    private bool _loading = true;

    /// <summary>The list is the acting character's view; a switch, or a scene this tab started, reads it again.</summary>
    private readonly ViewerScopedReload _reload = new();

    protected override async Task OnInitializedAsync()
    {
        _reload.Watch(AccountAuth, () => _ = InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); }), SceneService);
        await LoadAsync();
    }

    private Task LoadAsync() => _reload.LoadAsync(() => SceneService.GetActiveScenesAsync(), result =>
    {
        (_activeScenes, _error) = result switch
        {
            IReadOnlyList<SceneSummary> scenes => (scenes, (string?)null),
            ApiFailure failure => (null, failure.Message),
        };
        _loading = false;
    });

    public void Dispose() => _reload.Dispose();

    private string SceneTitle(SceneSummary s) =>
        s.Meta.TryGetValue("title", out var t) && !string.IsNullOrWhiteSpace(t)
            ? t
            : Loc["WidSceneIn", s.RoomName];
}
