@using System.Text.Json
@using SharpMUSH.Client.Components.Schema
@using SharpMUSH.Client.Models.Applications
@using SharpMUSH.Client.Models.Widgets
@using SharpMUSH.Client.Services
@inject SchemaAppService Schema
@inject ApplicationCatalog Catalog
@inject ApplicationRegistryClient RegistryClient
@inject CharacterDirectoryService Directory
@inject IPlayTerminalService PlayTerminal
@implements IDisposable
@inject IStringLocalizer<SharedResource> Loc

@* A schema-driven widget (Area 21). Its schema/data routes come either from its config ({ schemaUrl,
   dataUrl }, for manually-placed schema widgets) or — when it is an application-backed palette widget —
   from the application catalog, resolved by the widget's slug (WidgetName). Page-context tokens such
   as {objid}/{character} are filled from the cascading ProfilePageContext, so e.g. the character header
   application renders the right character. The shared renderers display the result.
   An application with an OobPackage takes its data from the play connection's OOB store instead of its
   data route: the latest payload of that package, re-read on every push for it (README §7.4). *@

@if (_loading)
{
    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
}
else if (_schema is null)
{
    <MudText Typo="Typo.caption" Class="mud-text-secondary">@Loc["WidSchemaUnavailable"]</MudText>
}
else if (_schema.IsForm)
{
    <SchemaFormRenderer Document="_schema" Data="_data" />
}
else
{
    <SchemaViewRenderer Document="_schema" Data="_data" />
}

@code {
    [Parameter] public JsonElement? Config { get; set; }

    /// <summary>Injected by ZoneRenderer; declared so DynamicComponent does not throw on the extra parameter.</summary>
    [Parameter] public string Zone { get; set; } = string.Empty;

    /// <summary>Placement's widget name (slug). For application-backed widgets this resolves the app's routes.</summary>
    [Parameter] public string WidgetName { get; set; } = string.Empty;

    /// <summary>
    /// The application ZoneRenderer already fetched by slug to check its minimum role, when the catalog did not
    /// have it. Rendering from it spares a second fetch that could answer differently from the one the gate used.
    /// </summary>
    [Parameter] public PortalApplication? Application { get; set; }

    [CascadingParameter] private ProfilePageContext? PageContext { get; set; }

    private bool _loading = true;
    private PortalSchemaDocument? _schema;
    private SchemaData? _data;

    /// <summary>The OOB package this widget's data follows, or null when its data comes from a route.</summary>
    private string? _oobPackage;
    private IOobChannelStore? _subscribedStore;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _schema = null;
        _data = null;

        var (schemaUrl, dataUrl, oobPackage) = await ResolveRoutesAsync();
        FollowOobPackage(oobPackage);
        if (!string.IsNullOrWhiteSpace(schemaUrl))
        {
            // Fill page-context tokens (e.g. {objid}) before fetching, so the right character renders.
            var objid = await ResolveObjidIfNeededAsync(schemaUrl, dataUrl);

            var resolvedSchema = Substitute(schemaUrl!, objid);
            if (resolvedSchema is not null)
            {
                _schema = await Schema.GetSchemaAsync(resolvedSchema) is PortalSchemaDocument schema ? schema : null;
            }

            if (_schema is not null && _oobPackage is not null)
            {
                _data = ReadOobData();
            }
            else if (_schema is not null && !string.IsNullOrWhiteSpace(dataUrl))
            {
                var resolvedData = Substitute(dataUrl!, objid);
                // A data route needing {objid} we couldn't resolve → skip data (schema still renders).
                if (resolvedData is not null)
                {
                    _data = await Schema.GetDataAsync(resolvedData) is SchemaData data ? data : null;
                }
            }
        }

        _loading = false;
    }

    /// <summary>
    /// Schema/data routes from config, else from the application catalog by slug, else a lazy fetch of
    /// the application by slug (so an app-backed widget renders even if the startup snapshot was empty).
    /// </summary>
    private async Task<(string? SchemaUrl, string? DataUrl, string? OobPackage)> ResolveRoutesAsync()
    {
        var schemaUrl = ConfigString("schemaUrl");
        var dataUrl = ConfigString("dataUrl");
        if (!string.IsNullOrWhiteSpace(schemaUrl))
        {
            return (schemaUrl, dataUrl, null);
        }

        if (string.IsNullOrWhiteSpace(WidgetName))
        {
            return (null, null, null);
        }

        // The catalog loads alongside the first render; waiting for it costs no more than the fetch
        // below would, and spares the request when it has the app.
        if (Application is { } resolved)
        {
            return (resolved.SchemaUrl, resolved.DataUrl, string.IsNullOrWhiteSpace(resolved.OobPackage) ? null : resolved.OobPackage);
        }

        await Catalog.Loaded;
        var app = Catalog.Get(WidgetName) ?? await RegistryClient.GetAsync(WidgetName);
        return app is null
            ? (null, null, null)
            : (app.SchemaUrl, app.DataUrl, string.IsNullOrWhiteSpace(app.OobPackage) ? null : app.OobPackage);
    }

    /// <summary>Subscribes to the play connection's OOB pushes while this widget follows a package, and only then.</summary>
    private void FollowOobPackage(string? package)
    {
        _oobPackage = package;
        if (package is null)
        {
            Unsubscribe();
            return;
        }

        if (_subscribedStore is null)
        {
            _subscribedStore = PlayTerminal.OobChannels;
            _subscribedStore.ChannelUpdated += OnChannelUpdated;
        }
    }

    /// <summary>The package's latest payload as schema data; an absent or malformed one renders the schema without data.</summary>
    private SchemaData? ReadOobData() =>
        _oobPackage is { } package && SchemaAppService.ParseData(PlayTerminal.OobChannels.Get(package)) is SchemaData data
            ? data
            : null;

    private void OnChannelUpdated(string package)
    {
        if (!string.Equals(package, _oobPackage, StringComparison.Ordinal))
        {
            return;
        }

        _ = InvokeAsync(() =>
        {
            // Still loading the schema: OnParametersSetAsync reads the payload once the schema is in.
            if (_schema is null)
            {
                return;
            }

            _data = ReadOobData();
            StateHasChanged();
        });
    }

    private void Unsubscribe()
    {
        if (_subscribedStore is not null)
        {
            _subscribedStore.ChannelUpdated -= OnChannelUpdated;
            _subscribedStore = null;
        }
    }

    public void Dispose() => Unsubscribe();

    private async Task<string?> ResolveObjidIfNeededAsync(string schemaUrl, string? dataUrl)
    {
        var needsObjid = schemaUrl.Contains("{objid}", StringComparison.Ordinal)
            || (dataUrl?.Contains("{objid}", StringComparison.Ordinal) ?? false);
        if (!needsObjid || string.IsNullOrWhiteSpace(PageContext?.CharacterName))
        {
            return null;
        }

        // No such character and an unreadable directory are different facts, but this widget's
        // answer to an unfillable {objid} hole is the same either way: don't fetch. The failed read
        // is already logged by the directory service, so nothing is lost by not distinguishing here.
        var resolved = await Directory.ResolveObjidAsync(PageContext.CharacterName);
        return resolved is string objid ? objid : null;
    }

    /// <summary>
    /// Replaces {objid}/{character} tokens, and {path} with nothing (a widget has no sub-path). Returns null if
    /// an {objid} token can't be filled.
    /// </summary>
    private string? Substitute(string route, string? objid)
    {
        var result = SchemaRendering.ApplyPath(route, [], null);

        if (result.Contains("{objid}", StringComparison.Ordinal))
        {
            if (string.IsNullOrWhiteSpace(objid))
            {
                return null;
            }
            result = result.Replace("{objid}", Uri.EscapeDataString(objid), StringComparison.Ordinal);
        }

        if (result.Contains("{character}", StringComparison.Ordinal) && PageContext is not null)
        {
            result = result.Replace("{character}", Uri.EscapeDataString(PageContext.CharacterName), StringComparison.Ordinal);
        }

        return result;
    }

    private string? ConfigString(string property)
    {
        if (Config is not { } config || config.ValueKind != JsonValueKind.Object)
        {
            return null;
        }

        return config.TryGetProperty(property, out var value) && value.ValueKind == JsonValueKind.String
            ? value.GetString()
            : null;
    }
}
