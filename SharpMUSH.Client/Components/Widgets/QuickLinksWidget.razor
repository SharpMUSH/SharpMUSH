@using System.Text.Json
@using SharpMUSH.Client.Models.Widgets
@inject IStringLocalizer<SharedResource> Loc

@if (_links.Count > 0)
{
    <div class="quick-links-widget">
        @if (_isSidebar)
        {
            <MudNavMenu>
                @foreach (var link in _links)
                {
                    var picture = PictureOf(link);
                    <MudNavLink Href="@link.Url"
                                Target="@(link.NewTab ? "_blank" : "_self")"
                                Icon="@(picture is null ? SvgOf(link) : null)">
                        @if (picture is not null)
                        {
                            <img class="ql-icon" src="@ApiUrl.Resolve(picture)" alt="" />
                        }
                        @link.Label
                    </MudNavLink>
                }
            </MudNavMenu>
        }
        else
        {
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                @foreach (var link in _links)
                {
                    var picture = PictureOf(link);
                    <MudChip T="string"
                             Href="@link.Url"
                             Target="@(link.NewTab ? "_blank" : "_self")"
                             Icon="@(picture is null ? SvgOf(link) : null)"
                             Color="Color.Default"
                             Size="Size.Small"
                             Variant="Variant.Outlined">
                        @if (picture is not null)
                        {
                            <img class="ql-icon" src="@ApiUrl.Resolve(picture)" alt="" />
                        }
                        @link.Label
                    </MudChip>
                }
            </MudStack>
        }
    </div>
}
else
{
    @* No links configured yet — prompt admins (only) toward the layout editor where this widget's
       links are set. Regular visitors see nothing, as before. *@
    <AuthorizeView Policy="layout.admin">
        <Authorized>
            <MudChip T="string" Href="/admin/layout"
                     Icon="@Icons.Material.Outlined.Settings" Color="Color.Default"
                     Size="Size.Small" Variant="Variant.Text">
                @Loc["WidConfigureQuickLinks"]
            </MudChip>
        </Authorized>
    </AuthorizeView>
}

@code {
    [Parameter] public JsonElement? Config { get; set; }

    /// <summary>
    /// Injected by ZoneRenderer to tell the widget which zone it is in.
    /// Used to pick sidebar vs TopBar/Footer rendering style.
    /// </summary>
    [Parameter] public string Zone { get; set; } = string.Empty;

    private IReadOnlyList<QuickLink> _links = [];

    /// <summary>
    /// The link's icon as a picture to load (an uploaded file or an https address); null when the
    /// icon is inline SVG markup, unset, or an address the portal will not load.
    /// </summary>
    public static string? PictureOf(QuickLink link)
        => ImageUrlPolicy.IsRenderable(link.Icon) ? link.Icon : null;

    /// <summary>Inline SVG markup as MudBlazor draws it, else the generic link icon.</summary>
    public static string SvgOf(QuickLink link)
        => link.Icon is { } icon && IsSvgMarkup(icon) ? icon : Icons.Material.Outlined.Link;

    private static bool IsSvgMarkup(string icon) => icon.TrimStart().StartsWith('<');

    private bool _isSidebar;

    protected override void OnParametersSet()
    {
        _isSidebar = Zone is "LeftSidebar" or "RightSidebar";

        if (Config is null)
        {
            _links = [];
            return;
        }

        try
        {
            var cfg = Config.Value.Deserialize<QuickLinksConfig>(
                new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
            _links = cfg?.Links ?? (IReadOnlyList<QuickLink>)[];
        }
        catch (JsonException)
        {
            _links = [];
        }
        catch (NotSupportedException)
        {
            _links = [];
        }
    }
}
