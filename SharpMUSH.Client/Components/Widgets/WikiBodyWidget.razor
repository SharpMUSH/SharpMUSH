@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using SharpMUSH.Client.Components
@using SharpMUSH.Client.Models.Widgets
@using SharpMUSH.Library.Services
@inject IAuthorizationService Authorization
@inject IStringLocalizer<SharedResource> Loc

@* Renders one wiki page. Which page, in precedence order: an explicit slug in the widget config; a
   "character" shorthand in the config (the Character-namespace page whose slug is that name); or the
   character from the cascading ProfilePageContext when placed on the profile page. Explicit config
   outranks the context so a fixed page can sit on a profile. *@

@* A page that does not exist takes the frame with it: this widget ships in the default home layout,
   where the page is unwritten until someone writes it, and an empty bordered card under the stat
   tiles is worse than nothing. Someone who could write it still sees the offer. *@
@{
    // Captured per render, so the callback a WikiView is created with reports against the address
    // that WikiView was created for — see HandleLoaded.
    var address = _address;
}
@if (!string.IsNullOrWhiteSpace(_slug) && !NothingToShow)
{
    @* D1 §6.3: a card. On a profile it is the Biography, "Wiki page · edited …" under the title and
       History at the right; a page placed by config is titled with its own title. The home page's
       hero keeps its own presentation and gets no header. *@
    <div class="wiki-body-widget">
        <KitCard Class="wiki-body-card" Title="@CardTitle" Sub="@CardSub" Controls="@(IsHero || _article is null ? null : CardControls)">
            @* Keyed on the address: WikiView fetches once, on init, so a reconfigured widget has to
               remount to go and read the page it now points at. *@
            <WikiView @key="address" @ref="_view" Slug="@_slug" Namespace="@_namespace" Locale="@_locale"
                      @bind-Mode="_mode" Embedded="true" ShowTitle="@IsHero"
                      OnLoaded="@(found => HandleLoaded(address, found))"
                      OnArticle="@(article => HandleArticle(address, article))" />
        </KitCard>
    </div>
}

@code {
    [CascadingParameter] private ProfilePageContext? PageContext { get; set; }

    /// <summary>Supplied by App.razor's CascadingAuthenticationState; re-supplied on sign-in and sign-out.</summary>
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    [Parameter] public JsonElement? Config { get; set; }

    /// <summary>Injected by ZoneRenderer; declared so DynamicComponent does not throw for the unmatched parameter.</summary>
    [Parameter] public string Zone { get; set; } = string.Empty;

    private string? _slug;
    private string? _namespace;
    private string? _locale;

    /// <summary>The page address the current <see cref="_missing"/> answer was measured against.</summary>
    private string? _address;

    /// <summary>True once the configured page has been fetched and turned out not to exist.</summary>
    private bool _missing;

    /// <summary>The page on screen, once loaded: its title, editor and when name the card.</summary>
    private WikiArticle? _article;

    private WikiView? _view;

    /// <summary>
    /// Bound to the view rather than passed as a constant: every render of this widget hands the view
    /// its mode again, so a constant would throw the reader out of the editor the moment the card re-rendered.
    /// </summary>
    private WikiView.WikiMode _mode = WikiView.WikiMode.View;

    /// <summary>True when the viewer holds <c>wiki.create</c>, so a missing page is worth showing them.</summary>
    private bool _mayCreate;

    // Resolved on every parameter set rather than once at init. CascadingAuthenticationState hands
    // down a fresh task when the viewer signs in or out, so a one-shot answer would go on hiding a
    // missing page from someone who has since gained the right to write it — and go on offering it
    // to someone who has since signed out.
    protected override async Task OnParametersSetAsync()
    {
        if (AuthState is null) return;

        var state = await AuthState;
        _mayCreate = (await Authorization.AuthorizeAsync(state.User, null, "wiki.create")).Succeeded;
    }

    protected override void OnParametersSet()
    {
        var cfg = ParseConfig();

        // Blank is not the same as absent to WikiService — it defaults on null only, so a config with
        // "namespace": "" would build /api/wiki/ns//{slug}. Normalize before handing it over.
        var ns = Blank(cfg?.Namespace);
        var locale = Blank(cfg?.Locale);
        var slug = Blank(cfg?.Slug);

        if (slug is not null)
        {
            SetPage(slug, ns, locale);
            return;
        }

        // No explicit page — fall back to a character biography, from config or from the page context.
        var character = Blank(cfg?.Character) ?? Blank(PageContext?.CharacterName);

        SetPage(character, WikiRoutes.CharacterNamespace, locale);
    }

    /// <summary>
    /// Points the widget at a page, forgetting the previous page's found/missing answer whenever the
    /// address changes — otherwise a reconfigured widget stays hidden on the strength of the old page.
    /// </summary>
    private void SetPage(string? slug, string? ns, string? locale)
    {
        var address = string.Join('\u0000', slug, ns, locale);
        if (address != _address)
        {
            _address = address;
            _missing = false;
            _article = null;
            _mode = WikiView.WikiMode.View;
        }

        (_slug, _namespace, _locale) = (slug, ns, locale);
    }

    /// <summary>
    /// Records whether the configured page exists, so the frame can follow it. A WikiView displaced by
    /// a <c>@key</c> change can still land its fetch afterwards; its answer describes the page it was
    /// created for, so it must not decide the fate of whichever page is on screen by then.
    /// </summary>
    private void HandleLoaded(string? address, bool found)
    {
        if (address != _address) return;

        _missing = !found;
    }

    /// <summary>As <see cref="HandleLoaded"/>: only the page on screen may name the card.</summary>
    private void HandleArticle(string? address, WikiArticle? article)
    {
        if (address != _address) return;

        _article = article;
    }

    /// <summary>The home page renders as a hero with its own title; the card gives it no header.</summary>
    private bool IsHero => string.Equals(_slug, "home", StringComparison.OrdinalIgnoreCase)
        && (_namespace is null || string.Equals(_namespace, "main", StringComparison.OrdinalIgnoreCase));

    private bool IsBiography => WikiRoutes.IsCharacterProfile(_namespace);

    private string? CardTitle => IsHero ? null : IsBiography ? Loc["NavBiography"].Value : _article?.Title;

    private string? CardSub => IsHero || _article?.UpdatedAt is not { } edited
        ? null
        : string.Format(Loc["NavWikiPageEdited"], Loc.Format(edited));

    private string HistoryHref =>
        WikiRoutes.WikiPathFor(_namespace, _article?.Slug ?? _slug ?? string.Empty) + "/history";

    /// <summary>
    /// History, and Edit for whoever may edit. Embedded, the page has no header of its own to carry
    /// the wiki route's Edit button, and a biography's wiki route redirects to the profile, so this is
    /// the only place to start editing a page that already exists. Edit opens the editor in the card,
    /// as "Write a biography" does for one that does not.
    /// </summary>
    private RenderFragment CardControls => __builder =>
    {
        <a class="wiki-body-history" href="@HistoryHref">
            <MudIcon Icon="@Icons.Material.Outlined.History" Size="Size.Small" />
            <span>@Loc["ResHistory"]</span>
        </a>
        @if (_mode == WikiView.WikiMode.View && _article is not null)
        {
            @* The server decides, with the page's namespace, category and page requirements in hand. *@
            @if (_article.Access?.Edit == true)
            {
                <button type="button" class="wiki-body-history wiki-body-edit" @onclick="EditAsync">
                    <MudIcon Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" />
                    <span>@Loc["WikiEdit"]</span>
                </button>
            }
        }
    };

    private Task EditAsync() => _view?.ActivateEditMode() ?? Task.CompletedTask;

    /// <summary>
    /// True when the only thing left to frame is the wiki's "no such page" notice: honest wording on
    /// the <c>/wiki</c> route, but noise in a card under the stat tiles of a game whose home page
    /// nobody has written. A character biography is excluded — its absence has its own deliberate
    /// empty state ("has not written one yet"), which is a message worth framing.
    /// </summary>
    private bool NothingToShow =>
        _missing && !_mayCreate && !WikiRoutes.IsCharacterProfile(_namespace);

    /// <summary>Trims a config value, mapping blank to null so downstream defaults apply.</summary>
    private static string? Blank(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private WikiBodyConfig? ParseConfig()
    {
        if (Config is not { ValueKind: JsonValueKind.Object } cfg)
        {
            return null;
        }

        try
        {
            return cfg.Deserialize<WikiBodyConfig>(
                new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
        }
        catch (JsonException)
        {
            return null;
        }
        catch (NotSupportedException)
        {
            return null;
        }
    }
}
