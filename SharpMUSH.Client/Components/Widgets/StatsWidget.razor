@using System.Text.Json
@using SharpMUSH.Client.Models
@using SharpMUSH.Client.Services
@inject CharacterDirectoryService CharacterDirectory
@inject WikiService WikiService
@inject SceneService SceneService
@inject IAccountAuthState AccountAuth
@inject ServerInfoService ServerInfo
@implements IDisposable
@inject IStringLocalizer<SharedResource> Loc

@* D1 §6.5 stat tiles (board 31's count pills, at desktop size): one card per count, a mono label
   over the value in accent. The tiles wrap to fit the column rather than stepping at a width. *@
<div class="stats-widget">
    <div class="stats-tiles">
        @foreach (var tile in Tiles)
        {
            <div class="stats-tile">
                <div class="stats-tile-label">@Loc[tile.LabelKey]</div>
                @* The placeholder is the same dash whether the value is still loading or could not
                   be fetched; the title says which, without a banner or a spinner that never ends. *@
                <div class="stats-tile-value" title="@(tile.Failed ? Loc["WidUnavailable"].Value : null)">@tile.Value</div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public JsonElement? Config { get; set; }
    [Parameter] public string Zone { get; set; } = string.Empty;

    /// <summary>A count once it is known; null both while loading and when the fetch failed.</summary>
    private int? _recent;
    private int? _characters;
    private int? _online;
    private int? _activeScenes;

    /// <summary>Which counts failed to load, so their dash can be explained rather than left ambiguous.</summary>
    private bool _recentFailed;
    private bool _charactersFailed;
    private bool _onlineFailed;
    private bool _activeScenesFailed;

    /// <summary>A game without the Scene System has no scenes to count, so it has no tile for them.</summary>
    private bool _scenesOn = true;

    private (string LabelKey, string Value, bool Failed)[] Tiles =>
    [
        ("WidPlayersOnline", _online?.ToString() ?? "—", _onlineFailed),
        .. (_scenesOn ? [("WidActiveScenes", _activeScenes?.ToString() ?? "—", _activeScenesFailed)] : Array.Empty<(string, string, bool)>()),
        ("RecentChanges",    _recent?.ToString() ?? "—", _recentFailed),
        ("Characters",       _characters?.ToString() ?? "—", _charactersFailed),
    ];

    /// <summary>
    /// Only the active-scenes count depends on who is asking — the server counts the private scenes the
    /// acting character may see — so a switch, or a scene this tab started, recounts that tile alone.
    /// </summary>
    private readonly ViewerScopedReload _reload = new();

    protected override async Task OnInitializedAsync()
    {
        _reload.Watch(AccountAuth, () => _ = InvokeAsync(async () =>
        {
            await LoadActiveScenesAsync();
            if (AnyFailed) StartRetrying();
            StateHasChanged();
        }), SceneService);

        var scenesOnTask = ServerInfo.HasFeatureAsync(GameFeatures.Scenes);
        await Task.WhenAll(LoadRecentAsync(), LoadCharactersAsync(), LoadOnlineAsync(), LoadActiveScenesAsync(), scenesOnTask);
        _scenesOn = await scenesOnTask;
        if (AnyFailed) StartRetrying();
    }

    private bool AnyFailed => _recentFailed || _charactersFailed || _onlineFailed || (_scenesOn && _activeScenesFailed);

    // A tile that could not be fetched keeps the loading placeholder instead of printing 0:
    // "the game has no characters" and "the request never arrived" look identical as a count,
    // and only one of them is something the portal actually knows.
    private async Task LoadRecentAsync()
    {
        _recent = await WikiService.GetRecentChangesResultAsync(10) is IReadOnlyList<WikiPageSummary> recent ? recent.Count : null;
        _recentFailed = _recent is null;
    }

    private async Task LoadCharactersAsync()
    {
        _characters = await CharacterDirectory.ListAsync() is IReadOnlyList<CharacterDirectoryService.CharacterSummary> characters
            ? characters.Count
            : null;
        _charactersFailed = _characters is null;
    }

    private async Task LoadOnlineAsync()
    {
        _online = await CharacterDirectory.ListOnlineAsync() is IReadOnlyList<CharacterDirectoryService.CharacterSummary> online
            ? online.Count
            : null;
        _onlineFailed = _online is null;
    }

    /// <summary>How long to wait before asking again for the counts that failed; the last delay repeats.</summary>
    private static readonly TimeSpan[] RetryDelays =
        [TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(6), TimeSpan.FromSeconds(12), TimeSpan.FromSeconds(30)];

    private CancellationTokenSource? _retry;

    /// <summary>
    /// Asks again for the counts that failed (a game restarting answers nothing for a while), until all have
    /// arrived, so the tiles do not keep their dashes after the game is back.
    /// </summary>
    private void StartRetrying()
    {
        if (_retry is not null) return;
        _retry = new CancellationTokenSource();
        _ = RetryAsync(_retry);
    }

    private async Task RetryAsync(CancellationTokenSource retry)
    {
        try
        {
            await RetryUntilLoadedAsync(retry.Token);
        }
        finally
        {
            // Done (or disposed): a later failure, after a character switch say, starts a new loop.
            if (ReferenceEquals(_retry, retry)) _retry = null;
            retry.Dispose();
        }
    }

    private async Task RetryUntilLoadedAsync(CancellationToken token)
    {
        for (var attempt = 0; AnyFailed; attempt++)
        {
            try
            {
                await Task.Delay(RetryDelays[Math.Min(attempt, RetryDelays.Length - 1)], token);
            }
            catch (OperationCanceledException)
            {
                return;
            }
            await InvokeAsync(async () =>
            {
                await Task.WhenAll(
                    _recentFailed ? LoadRecentAsync() : Task.CompletedTask,
                    _charactersFailed ? LoadCharactersAsync() : Task.CompletedTask,
                    _onlineFailed ? LoadOnlineAsync() : Task.CompletedTask,
                    _activeScenesFailed ? LoadActiveScenesAsync() : Task.CompletedTask);
                StateHasChanged();
            });
        }
    }

    private Task LoadActiveScenesAsync() => _reload.LoadAsync(() => SceneService.GetActiveScenesAsync(), result =>
    {
        _activeScenes = result is IReadOnlyList<SceneSummary> scenes ? scenes.Count : null;
        _activeScenesFailed = _activeScenes is null;
    });

    public void Dispose()
    {
        _retry?.Cancel();
        _reload.Dispose();
    }
}
