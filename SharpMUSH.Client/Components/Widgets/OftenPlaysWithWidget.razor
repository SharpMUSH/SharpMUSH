@using System.Text.Json
@using SharpMUSH.Client.Models
@using SharpMUSH.Client.Models.Widgets
@using SharpMUSH.Client.Services
@inject SceneService Scenes
@inject CharacterDirectoryService Directory
@inject IAccountAuthState AccountAuth
@implements IDisposable
@inject IStringLocalizer<SharedResource> Loc

@* D1 §6.3 Often plays with (board 25): who shares the most scenes with this character, as portrait
   tiles two across, each linking to that profile. Counted on the server from scenes the viewer may see. *@
<div class="often-plays-widget">
    <KitCard Aside="true" Title="@Loc["NavOftenPlaysWith"]">
        @if (_loading)
        {
            <MudSkeleton Height="72px" />
        }
        else if (_partners is null)
        {
            <div class="often-plays-empty">@Loc["WidUnavailable"]</div>
        }
        else if (_partners.Count == 0)
        {
            <div class="often-plays-empty">@Loc["NavNoPartnersYet"]</div>
        }
        else
        {
            <div class="often-plays-grid">
                @foreach (var partner in _partners)
                {
                    <PortraitTile Name="@partner.Name" ImageUrl="@ImageOf(partner.Name)" Alt="@partner.Name" Label="@partner.Name"
                                  Href="@($"/character/{Uri.EscapeDataString(partner.Name)}")" />
                }
            </div>
        }
    </KitCard>
</div>

@code {
    [Parameter] public JsonElement? Config { get; set; }
    [Parameter] public string Zone { get; set; } = string.Empty;
    [CascadingParameter] private ProfilePageContext? PageContext { get; set; }

    private const int Shown = 4;

    /// <summary>Null when the partners could not be read — not the same as a character who plays alone.</summary>
    private IReadOnlyList<ScenePartner>? _partners;
    private IReadOnlyList<CharacterDirectoryService.CharacterSummary> _directory = [];
    private bool _loading = true;
    private string? _loadedFor;

    /// <summary>Partners are counted from the scenes the acting character may see; a switch reads them again.</summary>
    private readonly ViewerScopedReload _reload = new();

    protected override void OnInitialized() => _reload.Watch(AccountAuth, () => _ = InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); }));

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{ProfileCharacter.NameFrom(Config, PageContext)}\u0000{PageContext?.Dbref}";
        if (key == _loadedFor) return;
        _loadedFor = key;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (ProfileCharacter.NameFrom(Config, PageContext) is not { } name) return;
        var ticket = _reload.Begin();
        _loading = true;
        var directory = await Directory.ListAsync() is IReadOnlyList<CharacterDirectoryService.CharacterSummary> rows ? rows : null;
        var partners = await ProfileCharacter.DbrefOfAsync(Directory, name, PageContext) is { } dbref
            && await Scenes.GetPartnersAsync(dbref, Shown) is IReadOnlyList<ScenePartner> read
                ? read
                : null;
        if (!_reload.IsCurrent(ticket)) return;
        if (directory is not null) _directory = directory;
        (_partners, _loading) = (partners, false);
    }

    public void Dispose() => _reload.Dispose();

    private string? ImageOf(string name) =>
        _directory.FirstOrDefault(r => string.Equals(r.Name, name, StringComparison.OrdinalIgnoreCase))?.Image;
}
