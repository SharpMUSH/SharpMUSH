@using System.Text.Json
@using SharpMUSH.Library.API
@using Microsoft.AspNetCore.Components.Routing
@using SharpMUSH.Client.Models
@using SharpMUSH.Client.Models.Wiki
@using SharpMUSH.Client.Components.Wiki
@using SharpMUSH.Client.Services
@using SharpMUSH.Library.Services
@inject WikiService Wiki
@inject NavigationManager Nav
@inject IAccountAuthState AccountAuth
@inject IStringLocalizer<SharedResource> Loc
@implements IDisposable

@* D1 §6.1 wiki home (board 21): a glass hero (the home page's image, a search field, New page for
   creators) and category cards — a cover, the name and count, the top three pages with draft and
   locked tags, and "All N pages". Only the categories staff pinned get a card; a search looks through
   every category. Search reads ?q= from the address and submits a paginated search across all collections. *@
<div class="wiki-index-container">
    <div class="wiki-index">
        <GlassBanner Title="@Loc["NavWikiHeroTitle"]" Kicker="@string.Format(Loc["NavWikiHeroKicker"], Loc["AppTitle"])" ImageUrl="@_heroImage"
                     Height="180" TitleSize="hero" HeadingLevel="1" Minimisable="false">
            <Secondary>
                <div class="wiki-hero-row">
                    <p class="wiki-hero-blurb">@Loc["NavWikiHeroBlurb"]</p>
                    <form class="wiki-hero-search" role="search" @onsubmit="ApplySearch" @onsubmit:preventDefault>
                        <MudIcon Icon="@Icons.Material.Outlined.Search" Size="Size.Small" />
                        <input type="search" placeholder="@Loc["NavWikiSearch"]" aria-label="@Loc["NavWikiSearch"]" value="@_draft"
                               @oninput="@(e => _draft = e.Value?.ToString() ?? string.Empty)" />
                    </form>
                </div>
            </Secondary>
            <Actions>
                <AuthorizeView Policy="wiki.create">
                    <Authorized>
                        <CapsuleButton Primary="true" Icon="@Icons.Material.Outlined.Add" Href="@NewPageHref">@Loc["NavWikiNewPage"]</CapsuleButton>
                    </Authorized>
                </AuthorizeView>
            </Actions>
        </GlassBanner>

        @if (_navigation is { Collections.Count: > 0 } navigation && !Searching)
        {
            <section class="wiki-collections">
                <h2>@Loc["WikiCollections"]</h2>
                @foreach (var collection in navigation.Collections)
                {
                    <a class="wiki-collection-entry" href="@WikiLocaleLinks.WithLocale("/wiki/collections/" + Uri.EscapeDataString(collection.Id), _locale)">@collection.Name <span>@collection.Pages</span></a>
                }
            </section>
        }
        <a class="wiki-browse-all" href="@WikiLocaleLinks.WithLocale("/wiki/collections/game", _locale)">@Loc["WikiBrowseAllCategories"]</a>
        @if (_loadFailed)
        {
            <div class="wiki-empty" role="alert">@Loc["WikiLoadFailed"]</div>
        }
        else if (Searching)
        {
            <WikiCollectionBrowser Collection="all" Search="@_search" Category="@_browseCategory" Skip="@_browseSkip" Locale="@_locale" Embedded="true" />
        }
        else if (_loading)
        {
            <div class="wiki-cat-grid">
                @for (var i = 0; i < 3; i++)
                {
                    <div class="wiki-skeleton"></div>
                }
            </div>
        }
        else if (FilteredGroups.Count == 0)
        {
            <div class="wiki-empty">
                @(!Searching ? ((_navigation?.Total ?? 0) == 0 ? Loc["NavWikiNoPages"] : Loc["NavWikiNoPinned"]) : string.Format(Loc["NavWikiNoMatches"], _search))
                @if (!Searching && (_navigation?.Total ?? 0) > 0)
                {
                    <AuthorizeView Policy="wiki.admin">
                        <Authorized>
                            <div class="wiki-empty-hint">@Loc["WikiNoPinnedHint"]</div>
                        </Authorized>
                    </AuthorizeView>
                }
            </div>
        }
        else
        {
            <div class="wiki-cat-grid">
                @foreach (var g in FilteredGroups)
                {
                    var label = WikiCategories.Label(g.Key, Loc["NavWikiUncategorized"], _names);
                    <div class="wiki-cat-card">
                        <ThemeMarks />
                        @if (ImageUrlPolicy.IsRenderable(g.Cover))
                        {
                            <img class="wiki-cat-cover" src="@ApiUrl.Resolve(g.Cover!)" alt="" loading="lazy" />
                        }
                        else
                        {
                            <div class="wiki-cat-cover wiki-cat-cover-fallback" aria-hidden="true"><MudIcon Icon="@Icons.Material.Outlined.Description" /></div>
                        }
                        <div class="wiki-cat-body">
                            <div class="wiki-cat-head">
                                <h2 class="wiki-cat-name">@label</h2>
                                <span class="wiki-cat-count">@CountFor(g.Key)</span>
                                @if (!g.IsUncategorized)
                                {
                                    <AuthorizeView Policy="wiki.admin">
                                        <Authorized>
                                            <WikiCategoryPinButton Category="@g.Key" Name="@label" Pinned="@_pinned.Contains(g.Key)" Compact="true"
                                                                   PinnedChanged="@(pinned => SetPinned(g.Key, pinned))" />
                                        </Authorized>
                                    </AuthorizeView>
                                }
                            </div>
                            <div class="wiki-cat-pages">
                                @foreach (var page in g.Pages.Take(TopPages))
                                {
                                    var p = page;
                                    <a class="wiki-cat-page" href="@WikiLocaleLinks.WithLocale(WikiRoutes.PathFor(p.Namespace, p.Slug), _locale)">
                                        <span class="wiki-cat-page-title">@p.Title</span>
                                        @if (!p.Published)
                                        {
                                            <span class="wiki-cat-tag wiki-cat-tag--draft">@Loc["NavWikiDraft"]</span>
                                        }
                                        @if (p.IsRestricted)
                                        {
                                            <span class="wiki-cat-tag wiki-cat-tag--locked">@Loc["NavWikiLocked"]</span>
                                        }
                                    </a>
                                }
                            </div>
                            @if (!g.IsUncategorized)
                            {
                                <a class="wiki-cat-all" href="@WikiLocaleLinks.WithLocale("/wiki/collections/game?category=" + Uri.EscapeDataString(g.Key), _locale)">@Loc.Plural("NavWikiAllPages", "count", CountFor(g.Key))</a>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private const int TopPages = 3;

    [Parameter] public JsonElement? Config { get; set; }

    /// <summary>Injected by ZoneRenderer; declared so DynamicComponent does not throw for the unmatched parameter.</summary>
    [Parameter] public string Zone { get; set; } = string.Empty;

    private bool _loading = true;
    private string _search = string.Empty;
    private string _draft = string.Empty;
    private string? _browseCategory;
    private int _browseSkip;
    private string? _heroImage;
    private IReadOnlyList<WikiPageSummary> _pages = [];

    /// <summary>The keys of the categories pinned to the wiki home: the only ones with a card unless searching.</summary>
    private HashSet<string> _pinned = new(StringComparer.Ordinal);

    /// <summary>Navigation failure is visible rather than presenting incomplete category counts.</summary>
    private bool _loadFailed;
    private WikiNavigationDto? _navigation;

    private bool Searching => !string.IsNullOrWhiteSpace(_search);

    private string NewPageHref => WikiLocaleLinks.WithLocale("/wiki/main/new-page/edit", _locale);
    private string? _locale;
    private int _version;
    private bool _disposed;

    /// <summary>Each category's name in the reader's language; a category with no page shows its key.</summary>
    private IReadOnlyDictionary<string, string>? _names;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        AccountAuth.AuthStateChanged += OnReaderChanged;
        AccountAuth.ActiveCharacterChanged += OnReaderChanged;
        ReadQuery();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_disposed) return;
        var version = Interlocked.Increment(ref _version);
        var locale = _locale;
        ClearReaderData();
        if (await Wiki.GetNavigationAsync(lang: locale) is WikiNavigationDto navigation)
        {
            if (_disposed || version != _version) return;
            _navigation = navigation;
            _names = navigation.Categories.ToDictionary(row => row.Key, row => row.Name);
            _pinned = navigation.Categories.Where(row => row.Pinned).Select(row => row.Key).ToHashSet(StringComparer.Ordinal);
            // Every card's preview is read at once: one round trip for the grid, not one per pinned category.
            var results = await Task.WhenAll(_pinned.Select(category =>
                Wiki.GetCollectionPagesAsync("game", take: TopPages, category: category, lang: locale).AsTask()));
            if (_disposed || version != _version) return;
            var previews = new Dictionary<(string, string), WikiPageSummary>();
            foreach (var result in results)
            {
                if (result is not WikiPageBatch batch)
                { _loadFailed = true; break; }
                foreach (var page in batch.Pages) previews.TryAdd((page.Namespace, page.Slug), page);
            }
            _pages = previews.Values.ToList();
        }
        else
        {
            if (_disposed || version != _version) return;
            _loadFailed = true;
        }
        if (_disposed || version != _version) return;
        _loading = false;

        // The hero shows the home page's own image when it has one; nothing else in the data names one.
        if (await Wiki.GetWikiArticle("home", "main", lang: locale) is WikiArticle home && !_disposed && version == _version)
        {
            _heroImage = home.Image;
        }
    }

    private void ClearReaderData()
    {
        _navigation = null;
        _names = null;
        _pinned = new(StringComparer.Ordinal);
        _pages = [];
        _heroImage = null;
        _loading = true;
        _loadFailed = false;
    }

    private void OnReaderChanged()
    {
        if (_disposed) return;
        // Authority changes at the same URI must invalidate pending reads before dispatching
        // the refresh, and remove every label/image authorized for the previous reader.
        Interlocked.Increment(ref _version);
        ClearReaderData();
        _ = InvokeAsync(async () =>
        {
            if (_disposed) return;
            StateHasChanged();
            await LoadAsync();
            if (!_disposed) StateHasChanged();
        });
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            var previousLocale = _locale;
            ReadQuery();
            if (previousLocale != _locale) await LoadAsync();
            if (!_disposed) StateHasChanged();
        });
    }

    private void ReadQuery()
    {
        // Preserve legacy /wiki?q= links while using the same last-value and length policy as collection routes.
        var state = WikiBrowseState.FromUri(Nav.Uri, "all");
        _search = state.Search ?? string.Empty;
        _draft = _search;
        _browseCategory = state.Category;
        _browseSkip = state.Skip;
        _locale = state.Locale;
    }

    private void ApplySearch() => Nav.NavigateTo(WikiJourneyLinks.Collection(new WikiBrowseState("all", _draft, Locale: _locale)));

    private IReadOnlyList<WikiCategoryGroup> FilteredGroups
    {
        get
        {
            if (!Searching)
                return WikiCategories.Group(_pages).Where(g => _pinned.Contains(g.Key)).ToList();

            return WikiCategories.Group(_pages.Where(p => p.Title.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || p.Categories.Any(c => WikiHelpers.CategoryLabel(c, _names).Contains(_search, StringComparison.OrdinalIgnoreCase))));
        }
    }

    private int CountFor(string key) => _navigation?.Categories.FirstOrDefault(row => row.Key == key)?.Pages ?? 0;

    private void SetPinned(string key, bool pinned)
    {
        if (pinned) _pinned.Add(key);
        else _pinned.Remove(key);
    }

    public void Dispose()
    {
        _disposed = true;
        Interlocked.Increment(ref _version);
        Nav.LocationChanged -= OnLocationChanged;
        AccountAuth.AuthStateChanged -= OnReaderChanged;
        AccountAuth.ActiveCharacterChanged -= OnReaderChanged;
    }
}
