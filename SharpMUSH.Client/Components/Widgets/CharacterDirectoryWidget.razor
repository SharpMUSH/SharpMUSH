@using SharpMUSH.Client.Services
@inject CharacterDirectoryService Directory
@inject IStringLocalizer<SharedResource> Loc

@* D1 §6.5 the character directory as a widget: the same kit as the /characters page — a search
   field and the count, the game's categories (FN`CHARCAT, opaque to the portal) as chips, each
   category under a section label, and the characters as portrait tiles. *@
<div class="char-dir-widget">
    <div class="char-dir-bar">
        <input class="char-dir-search" type="search" placeholder="@Loc["SearchCharacters"]" aria-label="@Loc["SearchCharacters"]"
               value="@_search" @oninput="@(e => _search = e.Value?.ToString() ?? string.Empty)" />
        @if (!_loading && !_failed)
        {
            <span class="char-dir-count">@Loc.Plural("WidCharactersFound", "count", Filtered.Count)</span>
        }
    </div>

    @if (!_loading && _categories.Count > 1)
    {
        <TypeChips Items="@CategoryChips" Selected="@SelectedKey" SelectedChanged="SelectCategory" AriaLabel="@Loc["NavCharCategories"]" />
    }

    @if (_loading)
    {
        <div class="char-dir-grid" aria-busy="true">
            @for (var i = 0; i < 8; i++)
            {
                <SkeletonCard Height="124" />
            }
        </div>
    }
    else if (_failed)
    {
        @* The roster could not be read at all. "No characters found" would be a claim about the
           game rather than about this request. *@
        <EmptyBox>@Loc["WidUnavailable"]</EmptyBox>
    }
    else if (Filtered.Count == 0)
    {
        <EmptyBox>@Loc["NoCharactersFound"]</EmptyBox>
    }
    else
    {
        @foreach (var group in Grouped)
        {
            @* The blank category gets no invented heading; it simply comes last. *@
            @if (_selectedCategory is null && _categories.Count > 1 && group.Key.Length > 0)
            {
                <SectionLabel Class="char-dir-group">@group.Key</SectionLabel>
            }

            <div class="char-dir-grid">
                @foreach (var character in group)
                {
                    var ch = character;
                    <PortraitTile Name="@ch.Name" ImageUrl="@ch.Image" Label="@ch.Name" Height="96"
                                  Href="@($"/character/{Uri.EscapeDataString(ch.Name)}")" />
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public System.Text.Json.JsonElement? Config { get; set; }
    [Parameter] public string Zone { get; set; } = string.Empty;

    private IReadOnlyList<CharacterDirectoryService.CharacterSummary> _all = [];
    private bool _loading = true;
    private bool _failed;
    private string _search = string.Empty;
    private string? _selectedCategory;
    private List<string> _categories = [];

    private const string AllKey = "";
    private const string UncategorisedKey = "\u0000";

    private IReadOnlyList<(string Key, string Label)> CategoryChips =>
        [(AllKey, Loc["All"].Value), .. _categories.Select(c => c.Length == 0 ? (UncategorisedKey, Loc["WkKindOther"].Value) : (c, c))];

    private string SelectedKey => _selectedCategory switch
    {
        null => AllKey,
        "" => UncategorisedKey,
        var c => c,
    };

    private void SelectCategory(string key) =>
        _selectedCategory = key == AllKey ? null : key == UncategorisedKey ? string.Empty : key;

    private IReadOnlyList<CharacterDirectoryService.CharacterSummary> Filtered
    {
        get
        {
            var results = _all.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(_search))
                results = results.Where(c => c.Name.Contains(_search, StringComparison.OrdinalIgnoreCase));
            if (_selectedCategory is not null)
                results = results.Where(c => (c.Category?.Trim() ?? string.Empty) == _selectedCategory);
            return results.ToList();
        }
    }

    private IEnumerable<IGrouping<string, CharacterDirectoryService.CharacterSummary>> Grouped =>
        Filtered.GroupBy(c => c.Category?.Trim() ?? string.Empty)
            .OrderBy(g => g.Key.Length == 0 ? 1 : 0)
            .ThenBy(g => g.Key, StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        var result = await Directory.ListAsync();
        _failed = result is not IReadOnlyList<CharacterDirectoryService.CharacterSummary>;
        _all = result is IReadOnlyList<CharacterDirectoryService.CharacterSummary> rows ? rows : [];
        _categories = _all
            .Select(c => c.Category?.Trim() ?? string.Empty)
            .Distinct()
            .OrderBy(c => c.Length == 0 ? 1 : 0)
            .ThenBy(c => c, StringComparer.OrdinalIgnoreCase)
            .ToList();
        _loading = false;
    }
}
