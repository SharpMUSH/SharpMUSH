@using System.Text.Json
@using SharpMUSH.Client.Components.Scenes
@using SharpMUSH.Client.Models
@using SharpMUSH.Client.Models.Widgets
@using SharpMUSH.Client.Services
@inject SceneService SceneService
@inject IAccountAuthState AccountAuth
@implements IDisposable
@inject IStringLocalizer<SharedResource> Loc
@inject IServiceProvider Provider

@* The next few scheduled scenes the reader may see, soonest first, each with when it starts in the reader's time
   zone and linking to its page, and a link to the full schedule. The server decides what the reader may see: a
   private, invite-only scene is listed only to its owner, its members and the players invited to it. Beside Live
   now in an aside, or across the main column as a main card. *@
<FeatureGate Feature="@GameFeatures.Scenes">
<div class="upcoming-scenes-widget">
    <KitCard Aside="@(!InMain)" Title="@Loc["WidUpcomingScenes"]"
             Sub="@(InMain ? Loc["WidUpcomingScenesSub"].Value : null)"
             Controls="@ScheduleLink">
        @if (_loading)
        {
            <MudSkeleton Height="40px" />
        }
        else if (_error is not null)
        {
            <EmptyState Compact="true" Failed="true" Class="upcoming-scenes-empty upcoming-scenes-error">@_error</EmptyState>
        }
        else if (_scenes is not { Count: > 0 })
        {
            <EmptyState Compact="true" Class="upcoming-scenes-empty" Icon="@Icons.Material.Outlined.EventAvailable">@Loc["WidNoUpcomingScenes"]</EmptyState>
        }
        else
        {
            <CardRows Class="upcoming-scenes-rows">
                @foreach (var scene in _scenes)
                {
                    <SidebarRow @key="scene.Id" Lead="SidebarRow.SidebarLead.Image" Icon="@Icons.Material.Outlined.Event" ImageUrl="@SceneText.Image(scene)"
                                Name="@Loc.Title(scene)" Label="@Loc.Title(scene)" Sub="@UpcomingSceneList.When(Loc, scene.ScheduledForUtc!.Value, _now)"
                                Trail="@TrailOf(scene)" Href="@($"/scenes/{Uri.EscapeDataString(scene.Id)}")" />
                }
            </CardRows>
        }
    </KitCard>
</div>
</FeatureGate>

@code {
    [Parameter] public JsonElement? Config { get; set; }
    [Parameter] public string Zone { get; set; } = string.Empty;

    /// <summary>The clock the list is judged against.</summary>
    private TimeProvider Clock => Provider.GetService<TimeProvider>() ?? TimeProvider.System;

    /// <summary>In a page's main column the widget takes the main card rather than the aside one.</summary>
    private bool InMain => Zone == nameof(WidgetZone.MainContent);

    private RenderFragment ScheduleLink => __builder =>
    {
        <a class="upcoming-scenes-all" href="@ScenesFilter.Href(ScenesFilter.Scheduled)">@Loc["WidFullSchedule"]</a>
    };

    private IReadOnlyList<SceneSummary>? _scenes;
    private string? _error;
    private bool _loading = true;
    private DateTimeOffset _now;
    private UpcomingScenesConfig _config = new();

    /// <summary>The config the list was last read for; null before the first read.</summary>
    private UpcomingScenesConfig? _loadedFor;

    /// <summary>The list is the acting character's view; a switch, or a scene this tab scheduled, reads it again.</summary>
    private readonly ViewerScopedReload _reload = new();

    /// <summary>
    /// How often the list is read again: "Today", "Late" and which scenes are still to come follow the clock, and a scene
    /// someone else schedules or starts tells this tab nothing.
    /// </summary>
    public static readonly TimeSpan RefreshInterval = TimeSpan.FromMinutes(1);

    private readonly CancellationTokenSource _closed = new();

    protected override void OnInitialized()
    {
        _reload.Watch(AccountAuth, () => _ = InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); }), SceneService);
        _ = RefreshAsync(_closed.Token);
    }

    private async Task RefreshAsync(CancellationToken closed)
    {
        try
        {
            using var timer = new PeriodicTimer(RefreshInterval, Clock);
            while (await timer.WaitForNextTickAsync(closed))
            {
                await InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
            }
        }
        catch (OperationCanceledException)
        {
            // Closed.
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        var config = Read(Config);
        if (config == _loadedFor) return;
        (_config, _loadedFor) = (config, config);
        await LoadAsync();
    }

    // The schedule from the late-start grace on: no untimed scene and no paused one long past its time, so a page is
    // the scenes coming up, soonest first, and enough to fill the rows after the days window.
    private Task LoadAsync()
    {
        var now = Clock.GetUtcNow();
        return _reload.LoadAsync(() => SceneService.ListScenesAsync(ScenesFilter.Upcoming, ScenesFilter.PageSize, from: UpcomingSceneList.ReadFrom(now)), result => Show(result, now));
    }

    private void Show(ApiResult<IReadOnlyList<SceneSummary>> result, DateTimeOffset now)
    {
        _now = now;
        (_scenes, _error) = result switch
        {
            IReadOnlyList<SceneSummary> scenes => (UpcomingSceneList.Select(scenes, _config.Count, _config.Days, _now), (string?)null),
            ApiFailure failure => (null, failure.Message),
        };
        _loading = false;
    }

    public void Dispose()
    {
        _closed.Cancel();
        _closed.Dispose();
        _reload.Dispose();
    }

    /// <summary>Late when its time came without it starting, else private when it is; nothing for the rest.</summary>
    private string? TrailOf(SceneSummary scene) =>
        UpcomingSceneList.IsLate(scene, _now) ? Loc["RolScheduleLate"].Value
            : !scene.IsPublic ? Loc["NavScenePrivate"].Value
            : null;

    /// <summary>The widget's config, or the defaults when it has none or it does not read.</summary>
    private static UpcomingScenesConfig Read(JsonElement? config)
    {
        if (config is not { ValueKind: JsonValueKind.Object } cfg) return new();
        try
        {
            return cfg.Deserialize<UpcomingScenesConfig>(new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase }) ?? new();
        }
        catch (Exception ex) when (ex is JsonException or NotSupportedException)
        {
            return new();
        }
    }
}
