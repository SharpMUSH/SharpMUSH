@using System.Text.Json
@using SharpMUSH.Client.Models
@using SharpMUSH.Client.Services
@using SharpMUSH.Library.Services
@inject WikiService WikiService
@inject IStringLocalizer<SharedResource> Loc

@* D1 §6.1 "Recently changed" as an aside card: image rows with the page's first image as the
   thumbnail, the editor and when. Placeable in any zone; it is the wiki home's default aside. *@
<div class="recent-wiki-widget">
    <KitCard Aside="true" Title="@Loc["WidRecentWikiActivity"]">
        @if (_loading)
        {
            @for (var i = 0; i < 4; i++)
            {
                <MudSkeleton Height="40px" Class="mb-1" />
            }
        }
        else if (_recentChanges is { Count: > 0 })
        {
            <div class="recent-wiki-rows">
                @foreach (var wp in _recentChanges.Take(6))
                {
                    var entry = wp;
                    <SidebarRow Lead="SidebarRow.SidebarLead.Image" Icon="@Icons.Material.Outlined.Description" ImageUrl="@entry.Image" Name="@entry.Title" Label="@entry.Title"
                                Sub="@Meta(entry)" Href="@WikiRoutes.PathFor(entry.Namespace, entry.Category, entry.Slug)" />
                }
            </div>
        }
        else
        {
            <div class="recent-wiki-empty">@Loc["WidNoRecentWikiActivity"]</div>
        }
    </KitCard>
</div>

@code {
    [Parameter] public JsonElement? Config { get; set; }
    [Parameter] public string Zone { get; set; } = string.Empty;

    private IReadOnlyList<WikiPageSummary>? _recentChanges;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _recentChanges = await WikiService.GetRecentChangesAsync(10);
        _loading = false;
    }

    private string Meta(WikiPageSummary p)
    {
        var when = Loc.Format(p.UpdatedAt);
        return p.LastEditedBy is null ? when : string.Format(Loc["NavWikiEditedBy"], p.LastEditedBy, when);
    }
}
