@using System.Text.Json
@using SharpMUSH.Client.Models
@using SharpMUSH.Client.Services
@using SharpMUSH.Library.Services
@inject WikiService WikiService
@inject IStringLocalizer<SharedResource> Loc

@* D1 §6.1 "Recently changed" as an aside card: image rows with the page's first image as the
   thumbnail, the editor and when. Placeable in any zone; it is the wiki home's default aside. In a
   page's main column (the home page) it takes the main card, with All changes in its header. *@
<div class="recent-wiki-widget @(InMain ? "recent-wiki-widget--main" : null)">
    <KitCard Aside="@(!InMain)" Title="@Loc["WidRecentWikiActivity"]" Controls="@(InMain ? AllChanges : null)">
        @if (_loading)
        {
            @for (var i = 0; i < 4; i++)
            {
                <MudSkeleton Height="40px" Class="mb-1" />
            }
        }
        else if (_recentChanges is { Count: > 0 })
        {
            <CardRows>
                @foreach (var entry in _recentChanges.Take(6))
                {
                    <SidebarRow Lead="SidebarRow.SidebarLead.Image" Icon="@Icons.Material.Outlined.Description" ImageUrl="@entry.Image" Name="@entry.Title" Label="@entry.Title"
                                Sub="@Meta(entry)" Href="@WikiRoutes.PathFor(entry.Namespace, entry.Slug)" />
                }
            </CardRows>
        }
        else
        {
            <div class="recent-wiki-empty">@Loc["WidNoRecentWikiActivity"]</div>
        }
    </KitCard>
</div>

@code {
    [Parameter] public JsonElement? Config { get; set; }
    [Parameter] public string Zone { get; set; } = string.Empty;

    /// <summary>In a page's main column the widget takes the main card rather than the aside one.</summary>
    private bool InMain => Zone == nameof(WidgetZone.MainContent);

    private RenderFragment AllChanges => __builder =>
    {
        <a class="recent-wiki-all" href="/wiki/recent">@Loc["NavWikiRecentChanges"]</a>
    };

    private IReadOnlyList<WikiPageSummary>? _recentChanges;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _recentChanges = await WikiService.GetRecentChangesAsync(10);
        _loading = false;
    }

    private string Meta(WikiPageSummary p)
    {
        var when = Loc.Format(p.UpdatedAt);
        return p.LastEditedBy is null ? when : string.Format(Loc["NavWikiEditedBy"], p.LastEditedBy, when);
    }
}
