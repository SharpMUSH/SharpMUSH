@using System.Text.Json
@using SharpMUSH.Client.Services
@inject AccountAuthService AccountAuth

<MudPaper Elevation="0" Style="padding:1.25rem;border-radius:var(--radius);border:1px solid var(--border);background:var(--surface);height:100%;box-sizing:border-box;">
    <MudText Style="font-size:0.6875rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-faint);font-family:'JetBrains Mono',monospace;margin-bottom:0.625rem;">New Here?</MudText>

    @if (ShowCreateHero)
    {
        <MudText Style="font-size:0.9375rem;font-weight:600;color:var(--text);margin-bottom:0.375rem;">You don't have a character yet</MudText>
        <MudText Style="font-size:0.8125rem;color:var(--text-dim);margin-bottom:0.875rem;line-height:1.55;">
            Create your first character to start playing.
        </MudText>
        <MudButton Variant="Variant.Filled" Href="/characters/new" FullWidth="true" Size="Size.Small"
                   Style="justify-content:flex-start;background:var(--accent);color:var(--accent-on);font-weight:600;text-transform:none;margin-bottom:0.875rem;">
            <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Small" Class="mr-2" /> Create your character
        </MudButton>
    }
    else
    {
        <MudText Style="font-size:0.8125rem;color:var(--text-dim);margin-bottom:0.875rem;line-height:1.55;">
            Get started by reading the wiki, browsing characters, or jumping into a scene.
        </MudText>
    }

    <div style="display:flex;flex-direction:column;gap:0.375rem;">
        <MudButton Variant="Variant.Outlined" Href="/wiki" FullWidth="true" Size="Size.Small"
                   Style="justify-content:flex-start;border-color:var(--border);color:var(--text);">
            <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Small" Class="mr-2" /> Read the Wiki
        </MudButton>
        <MudButton Variant="Variant.Outlined" Href="/characters" FullWidth="true" Size="Size.Small"
                   Style="justify-content:flex-start;border-color:var(--border);color:var(--text);">
            <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Small" Class="mr-2" /> Browse Characters
        </MudButton>
        <MudButton Variant="Variant.Outlined" Href="/scenes" FullWidth="true" Size="Size.Small"
                   Style="justify-content:flex-start;border-color:var(--border);color:var(--text);">
            <MudIcon Icon="@Icons.Material.Filled.Movie" Size="Size.Small" Class="mr-2" /> Browse Scenes
        </MudButton>
        @if (ShowQuietCreate)
        {
            <MudButton Variant="Variant.Outlined" Href="/characters/new" FullWidth="true" Size="Size.Small"
                       Style="justify-content:flex-start;border-color:var(--accent);color:var(--accent);">
                <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" Class="mr-2" /> New character
            </MudButton>
        }
    </div>
</MudPaper>

@code {
    [Parameter] public JsonElement? Config { get; set; }
    [Parameter] public string Zone { get; set; } = string.Empty;

    private bool ShowCreateHero => AccountAuth.IsLoggedIn && AccountAuth.Characters.Count == 0;
    private bool ShowQuietCreate => AccountAuth.IsLoggedIn && AccountAuth.Characters.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        // Hydrate the session and roster before deciding which affordance to show: a logged-in
        // account whose characters haven't loaded yet must not be mistaken for the anonymous state.
        // GetCharactersAsync no-ops (no HTTP) for an anonymous tab and guards against nulls itself.
        await AccountAuth.GetCharactersAsync();
        StateHasChanged();
    }
}
