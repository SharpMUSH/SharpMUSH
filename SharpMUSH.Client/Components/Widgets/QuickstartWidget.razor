@using System.Text.Json
@using SharpMUSH.Client.Services
@inject AccountAuthService AccountAuth
@inject IStringLocalizer<SharedResource> Loc

@* D1 §6.5 "Getting started" (board 30) as an aside card. The first-visit offer depends on who is
   looking: an anonymous visitor is offered an account, an account with no character the character
   creator, and anyone else a quiet "New character" row among the ways in. *@
<div class="quickstart-widget">
    <KitCard Aside="true" Title="@Loc["WidNewHere"]">
        @if (ShowCreateHero)
        {
            <div class="quickstart-lead">@Loc["WidNoCharacterYet"]</div>
            <p class="quickstart-text">@Loc["WidCreateFirstCharacter"]</p>
            <CapsuleButton Primary="true" Class="quickstart-cta" Href="/characters/new" Icon="@Icons.Material.Outlined.PersonAdd">@Loc["WidCreateYourCharacter"]</CapsuleButton>
        }
        else if (ShowJoinHero)
        {
            @* The state the heading is actually addressed to. It had no affordance of its own: a
               first-time visitor was offered the wiki, the character list and the scene list — three
               ways to keep reading, and no way to join. *@
            <p class="quickstart-text">@Loc["WidQuickstartIntro"]</p>
            <CapsuleButton Primary="true" Class="quickstart-cta" Href="/login?tab=register" Icon="@Icons.Material.Outlined.PersonAdd">@Loc["AuthCreateAccount"]</CapsuleButton>
        }
        else
        {
            <p class="quickstart-text">@Loc["WidQuickstartIntro"]</p>
        }

        <nav class="quickstart-links" aria-label="@Loc["WidNewHere"]">
            <SidebarRow Lead="SidebarRow.SidebarLead.Icon" Icon="@Icons.Material.Outlined.MenuBook" Label="@Loc["WidReadTheWiki"]" Href="/wiki" />
            <SidebarRow Lead="SidebarRow.SidebarLead.Icon" Icon="@Icons.Material.Outlined.Groups" Label="@Loc["WidBrowseCharacters"]" Href="/characters" />
            <SidebarRow Lead="SidebarRow.SidebarLead.Icon" Icon="@Icons.Material.Outlined.Theaters" Label="@Loc["WidBrowseScenes"]" Href="/scenes" />
            @if (ShowQuietCreate)
            {
                <SidebarRow Lead="SidebarRow.SidebarLead.Icon" Icon="@Icons.Material.Outlined.Add" Label="@Loc["WidNewCharacter"]" Href="/characters/new" />
            }
        </nav>
    </KitCard>
</div>

@code {
    [Parameter] public JsonElement? Config { get; set; }
    [Parameter] public string Zone { get; set; } = string.Empty;

    private bool ShowCreateHero => AccountAuth.IsLoggedIn && AccountAuth.Characters.Count == 0;
    private bool ShowQuietCreate => AccountAuth.IsLoggedIn && AccountAuth.Characters.Count > 0;
    private bool ShowJoinHero => !AccountAuth.IsLoggedIn;

    protected override async Task OnInitializedAsync()
    {
        // Hydrate the session and roster before deciding which affordance to show: a logged-in
        // account whose characters haven't loaded yet must not be mistaken for the anonymous state.
        // GetCharactersAsync no-ops (no HTTP) for an anonymous tab and guards against nulls itself.
        await AccountAuth.GetCharactersAsync();
    }
}
