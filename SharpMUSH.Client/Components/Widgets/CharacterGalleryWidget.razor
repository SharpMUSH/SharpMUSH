@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using SharpMUSH.Client.Models.Widgets
@using SharpMUSH.Client.Services
@inject GalleryService Gallery
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> Loc

<div class="character-gallery-widget">
    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mb-3" Spacing="2">
        <MudIcon Icon="@Icons.Material.Filled.PhotoLibrary" Color="Color.Primary" />
        <MudText Typo="Typo.h6">@Loc["Gallery"]</MudText>
        <MudSpacer />
        @if (EffectiveCanEdit)
        {
            <MudFileUpload T="IBrowserFile" FilesChanged="UploadAsync"
                           Accept="image/*" MaximumFileCount="1" MaxFileSize="GalleryService.MaxUploadBytes" />
        }
    </MudStack>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_error is not null)
    {
        <MudText Typo="Typo.body2" Color="Color.Error" Class="character-gallery-error">@_error</MudText>
    }
    else if (_items.Count == 0)
    {
        <MudPaper Outlined="true" Class="pa-6 d-flex flex-column align-center justify-center" Style="border-style:dashed;">
            <MudIcon Icon="@Icons.Material.Filled.AddPhotoAlternate" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Loc["GalleryEmpty"]</MudText>
        </MudPaper>
    }
    else
    {
        <MudGrid Spacing="2">
            @foreach (var item in _items)
            {
                <MudItem xs="6" sm="4">
                    <MudPaper Outlined="true" Class="gallery-thumb" Style="position:relative;overflow:hidden;">
                        <MudImage Src="@item.Url" Alt="@item.FileName" Fluid="true"
                                  ObjectFit="ObjectFit.Cover" Height="120"
                                  Style="cursor:pointer;width:100%;"
                                  @onclick="@(() => OpenLightbox(item))" />
                        @if (item.IsIcon)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" Size="Size.Small"
                                     Style="position:absolute;top:4px;left:4px;" />
                        }
                        @if (EffectiveCanEdit)
                        {
                            <div style="position:absolute;top:0;right:0;display:flex;">
                                @if (!item.IsIcon)
                                {
                                    <MudTooltip Text="@Loc["SetAsIcon"]">
                                        <MudIconButton Icon="@Icons.Material.Filled.StarBorder" Size="Size.Small"
                                                       Color="Color.Warning"
                                                       OnClick="@(() => SetIconAsync(item))" Disabled="_busy" />
                                    </MudTooltip>
                                }
                                <MudTooltip Text="@Loc["Delete"]">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="@(() => DeleteAsync(item))" Disabled="_busy" />
                                </MudTooltip>
                            </div>
                        }
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }
</div>

<MudOverlay Visible="_lightbox is not null" DarkBackground="true" AutoClose="true"
            OnClick="@(() => _lightbox = null)">
    @if (_lightbox is not null)
    {
        <MudImage Src="@_lightbox.Url" Alt="@_lightbox.FileName" Fluid="true"
                  Style="max-height:90vh;max-width:90vw;" />
    }
</MudOverlay>

@code {
    [Parameter] public string? CharacterName { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public JsonElement? Config { get; set; }
    [Parameter] public string Zone { get; set; } = string.Empty;

    [CascadingParameter] private ProfilePageContext? PageContext { get; set; }

    /// <summary>Edit controls show when the page passes CanEdit directly or via the profile page context.</summary>
    private bool EffectiveCanEdit => CanEdit || (PageContext?.CanEdit ?? false);

    private IReadOnlyList<GalleryService.GalleryItem> _items = [];
    private GalleryService.GalleryItem? _lightbox;
    private bool _loading = true;
    private bool _busy;

    /// <summary>Why the gallery could not be read — which is not the same as it having no images.</summary>
    private string? _error;
    private string? _resolvedName;

    protected override async Task OnParametersSetAsync()
    {
        var name = CharacterName ?? PageContext?.CharacterName ?? ConfigCharacter();
        if (string.IsNullOrWhiteSpace(name) || name == _resolvedName)
        {
            return;
        }
        _resolvedName = name;
        _loading = true;
        var result = await Gallery.ListAsync(name);
        (_items, _error) = result switch
        {
            List<GalleryService.GalleryItem> items => (items, (string?)null),
            ApiFailure failure => ([], failure.Message),
        };
        _loading = false;
    }

    private string? ConfigCharacter()
    {
        if (Config is { } cfg && cfg.ValueKind == JsonValueKind.Object
            && cfg.TryGetProperty("character", out var prop) && prop.ValueKind == JsonValueKind.String)
        {
            return prop.GetString();
        }
        return null;
    }

    private void OpenLightbox(GalleryService.GalleryItem item) => _lightbox = item;

    private async Task UploadAsync(IBrowserFile? file)
    {
        if (file is null || _resolvedName is null) return;
        await WriteAsync(Gallery.UploadAsync(_resolvedName, file), "GalleryUploadFailed");
    }

    private async Task DeleteAsync(GalleryService.GalleryItem item)
    {
        if (_resolvedName is null) return;
        await WriteAsync(Gallery.DeleteAsync(_resolvedName, item.AssetId), "GalleryDeleteFailed");
    }

    private async Task SetIconAsync(GalleryService.GalleryItem item)
    {
        if (_resolvedName is null) return;
        var reordered = _items.Select(i => i with { IsIcon = i.AssetId == item.AssetId }).ToList();
        await WriteAsync(Gallery.ReplaceAsync(_resolvedName, reordered), "GallerySetIconFailed");
    }

    /// <summary>
    /// Every write answers with the gallery as the server now holds it. A refused delete or icon change
    /// used to leave the page exactly as it was with nothing said, which reads as the click not landing.
    /// </summary>
    private async Task WriteAsync(Task<ApiResult<List<GalleryService.GalleryItem>>> write, string failedKey)
    {
        _busy = true;
        ApiResult<List<GalleryService.GalleryItem>> result;
        try { result = await write; }
        finally { _busy = false; }

        switch (result)
        {
            case List<GalleryService.GalleryItem> updated:
                _items = updated;
                _error = null;
                break;
            case ApiFailure failure:
                Snackbar.Add(Loc[failedKey, failure.Message], Severity.Error);
                break;
        }
    }
}
