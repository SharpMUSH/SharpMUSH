@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using SharpMUSH.Client.Models.Widgets
@using SharpMUSH.Client.Services
@using SharpMUSH.Library.API
@inject GalleryService Gallery
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> Loc

@* D1 §6.3 Gallery aside card (board 25): "Gallery · N" with View all; the portrait large with a star,
   two more small. Every image opens the viewer; the owner's actions (make portrait, use as banner,
   remove banner, delete) are in the viewer beside the image they act on, and Add image sits under
   the tiles. A gallery the server could not read says so rather than looking empty. *@
<div class="character-gallery-widget">
    <KitCard Aside="true" Title="@Title">
        <Controls>
            @if (_items.Count > 0)
            {
                <button type="button" class="gallery-view-all" @onclick="@(() => OpenViewer(0))">@Loc["NavGalleryViewAll"]</button>
            }
        </Controls>
        <ChildContent>
            @if (_loading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (_error is not null)
            {
                <div class="character-gallery-error">@_error</div>
            }
            else if (_items.Count == 0)
            {
                <div class="gallery-empty">@Loc["GalleryEmpty"]</div>
            }
            else
            {
                var hero = Hero;
                <button type="button" class="gallery-hero" aria-label="@(hero.Caption ?? hero.FileName)" @onclick="@(() => OpenViewer(IndexOf(hero)))">
                    @if (ImageUrlPolicy.IsRenderable(hero.Url))
                    {
                        <img src="@ApiUrl.Resolve(hero.Url)" alt="@(hero.Caption ?? string.Empty)" loading="lazy" />
                    }
                    @if (hero.IsIcon)
                    {
                        <span class="gallery-star" title="@Loc["NavGalleryPortrait"]">
                            <MudIcon Icon="@Icons.Material.Outlined.StarBorder" Size="Size.Small" />
                        </span>
                    }
                </button>
                @if (Small.Count > 0)
                {
                    <div class="gallery-small">
                        @foreach (var entry in Small)
                        {
                            var e = entry;
                            <button type="button" class="gallery-small-tile" aria-label="@(e.Caption ?? e.FileName)" @onclick="@(() => OpenViewer(IndexOf(e)))">
                                @if (ImageUrlPolicy.IsRenderable(e.Url))
                                {
                                    <img src="@ApiUrl.Resolve(e.Url)" alt="@(e.Caption ?? string.Empty)" loading="lazy" />
                                }
                            </button>
                        }
                    </div>
                }
            }
            @if (EffectiveCanEdit && _error is null && !_loading)
            {
                <div class="gallery-upload">
                    <MudFileUpload T="IBrowserFile" FilesChanged="UploadAsync" Accept="image/*" MaximumFileCount="1" MaxFileSize="GalleryService.MaxUploadBytes">
                        <CustomContent>
                            <CapsuleButton Class="gallery-add" Icon="@Icons.Material.Outlined.AddPhotoAlternate" Disabled="_busy" OnClick="@context.OpenFilePickerAsync">@Loc["NavGalleryAdd"]</CapsuleButton>
                        </CustomContent>
                    </MudFileUpload>
                </div>
            }
        </ChildContent>
    </KitCard>
</div>

<ImageViewer Items="@ViewerItems" @bind-Open="_viewerOpen" Index="@_viewerIndex" Label="@Title">
    <Actions>
        @if (EffectiveCanEdit && ByKey(context.Key) is { } entry)
        {
            @if (!entry.IsIcon)
            {
                <CapsuleButton Class="gallery-make-icon" Icon="@Icons.Material.Outlined.StarBorder" Disabled="_busy" OnClick="@(() => SetIconAsync(entry))">@Loc["SetAsIcon"]</CapsuleButton>
            }
            @if (entry.IsBanner)
            {
                <CapsuleButton Class="gallery-make-banner" Pressed="true" Icon="@Icons.Material.Outlined.Panorama" Disabled="_busy" OnClick="@(() => SetBannerAsync(null))">@Loc["NavGalleryRemoveBanner"]</CapsuleButton>
            }
            else
            {
                <CapsuleButton Class="gallery-make-banner" Pressed="false" Icon="@Icons.Material.Outlined.Panorama" Disabled="_busy" OnClick="@(() => SetBannerAsync(entry))">@Loc["NavGalleryMakeBanner"]</CapsuleButton>
            }
            <CapsuleButton Class="gallery-delete" Icon="@Icons.Material.Outlined.Delete" Disabled="_busy" OnClick="@(() => DeleteAsync(entry))">@Loc["Delete"]</CapsuleButton>
        }
    </Actions>
</ImageViewer>

@code {
    [Parameter] public string? CharacterName { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public JsonElement? Config { get; set; }
    [Parameter] public string Zone { get; set; } = string.Empty;

    [CascadingParameter] private ProfilePageContext? PageContext { get; set; }

    /// <summary>Edit controls show when the page passes CanEdit directly or via the profile page context.</summary>
    private bool EffectiveCanEdit => CanEdit || (PageContext?.CanEdit ?? false);

    private IReadOnlyList<GalleryEntry> _items = [];
    private bool _loading = true;
    private bool _busy;
    private bool _viewerOpen;
    private int _viewerIndex;

    /// <summary>Why the gallery could not be read — which is not the same as it having no images.</summary>
    private string? _error;
    private string? _resolvedName;

    private string Title => _items.Count == 0 ? Loc["Gallery"].Value : Loc.Plural("NavGalleryTitle", "count", _items.Count);

    /// <summary>The portrait, or the first image when (briefly) there is none.</summary>
    private GalleryEntry Hero => _items.FirstOrDefault(i => i.IsIcon) ?? _items[0];

    private IReadOnlyList<GalleryEntry> Small => _items.Where(i => i != Hero).Take(2).ToList();

    private IReadOnlyList<ImageViewer.Item> ViewerItems =>
        _items.Select(i => new ImageViewer.Item(i.Url, i.Caption, i.Caption, i.AssetId)).ToList();

    private int IndexOf(GalleryEntry entry) => Math.Max(0, _items.ToList().FindIndex(i => i.AssetId == entry.AssetId));

    private GalleryEntry? ByKey(string? assetId) => _items.FirstOrDefault(i => i.AssetId == assetId);

    private void OpenViewer(int index)
    {
        _viewerIndex = index;
        _viewerOpen = true;
    }

    /// <summary>The page's last gallery write this widget took on, so each is taken once.</summary>
    private IReadOnlyList<GalleryEntry>? _fromPage;

    /// <summary>Bumped when the page's gallery is taken on: a read begun before it is older and is dropped.</summary>
    private int _generation;

    protected override async Task OnParametersSetAsync()
    {
        // The banner's Change banner and Change avatar write the gallery from the page: show what they left.
        if (PageContext?.Gallery is { } fromPage && !ReferenceEquals(fromPage, _fromPage))
        {
            _fromPage = fromPage;
            _generation++;
            (_items, _error, _loading) = (fromPage, null, false);
        }

        var name = CharacterName ?? PageContext?.CharacterName ?? ConfigCharacter();
        if (string.IsNullOrWhiteSpace(name) || name == _resolvedName)
        {
            return;
        }
        _resolvedName = name;
        _loading = true;
        var generation = ++_generation;
        var result = await Gallery.ListAsync(name);
        if (generation != _generation) return;
        (_items, _error) = result switch
        {
            List<GalleryEntry> items => (items, (string?)null),
            ApiFailure failure => ([], failure.Message),
        };
        _loading = false;
    }

    private string? ConfigCharacter()
    {
        if (Config is { } cfg && cfg.ValueKind == JsonValueKind.Object
            && cfg.TryGetProperty("character", out var prop) && prop.ValueKind == JsonValueKind.String)
        {
            return prop.GetString();
        }
        return null;
    }

    private async Task UploadAsync(IBrowserFile? file)
    {
        if (file is null || _resolvedName is null) return;
        await WriteAsync(Gallery.UploadAsync(_resolvedName, file), "GalleryUploadFailed");
    }

    private async Task DeleteAsync(GalleryEntry item)
    {
        if (_resolvedName is null) return;
        await WriteAsync(Gallery.DeleteAsync(_resolvedName, item.AssetId), "GalleryDeleteFailed");
    }

    private async Task SetIconAsync(GalleryEntry item)
    {
        if (_resolvedName is null) return;
        await WriteAsync(Gallery.ReplaceAsync(_resolvedName, GalleryService.WithIcon(_items, item.AssetId)), "GallerySetIconFailed");
    }

    /// <summary>Makes <paramref name="item"/> the banner, or removes the banner when it is null.</summary>
    private async Task SetBannerAsync(GalleryEntry? item)
    {
        if (_resolvedName is null) return;
        await WriteAsync(Gallery.ReplaceAsync(_resolvedName, GalleryService.WithBanner(_items, item?.AssetId)), "GallerySetBannerFailed");
    }

    /// <summary>
    /// Every write answers with the gallery as the server now holds it. A refused delete or icon change
    /// used to leave the page exactly as it was with nothing said, which reads as the click not landing.
    /// </summary>
    private async Task WriteAsync(Task<ApiResult<List<GalleryEntry>>> write, string failedKey)
    {
        _busy = true;
        ApiResult<List<GalleryEntry>> result;
        try { result = await write; }
        finally { _busy = false; }

        switch (result)
        {
            case List<GalleryEntry> updated:
                _items = updated;
                _error = null;
                if (_items.Count == 0) _viewerOpen = false;
                PageContext?.GalleryChanged?.Invoke(updated);
                break;
            case ApiFailure failure:
                Snackbar.Add(Loc[failedKey, failure.Message], Severity.Error);
                break;
        }
    }
}
