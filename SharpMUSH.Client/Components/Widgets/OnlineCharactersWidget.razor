@using System.Text.Json
@using SharpMUSH.Client.Services
@inject CharacterDirectoryService CharacterDirectory
@inject IStringLocalizer<SharedResource> Loc

@* D1 §6.5 "Online now · N" (board 30) as an aside card: avatar rows linking each profile, then
   "See everyone" to the directory's online filter. Everyone here came from lwho(), so the row's
   dot is always the connected one. Placed in a page's main column (a pre-D1 home layout) it takes
   the main card, See everyone in its header and the rows across the width. *@
<div class="online-characters-widget @(InMain ? "online-characters-widget--main" : null)">
    <KitCard Aside="@(!InMain)" Title="@(_characters is { Count: > 0 } ? Loc.Plural("WidOnlineNowCount", "count", _characters.Count) : Loc["WidOnlineNow"].Value)"
             Controls="@(InMain && _characters is { Count: > 0 } ? SeeEveryone : null)">
        @if (_loading)
        {
            @for (var i = 0; i < 4; i++) { <MudSkeleton Height="32px" Class="mb-1" /> }
        }
        @* Three states, not two: the list failed to load is not the same claim as "nobody is here",
           and saying the latter for the former is the more damaging of the two mistakes. *@
        else if (_characters is null)
        {
            <div class="online-characters-note">@Loc["WidUnavailable"]</div>
        }
        else if (_characters is { Count: > 0 })
        {
            <div class="online-characters-rows @(InMain ? "online-characters-rows--main" : null)">
                @foreach (var row in _characters.Take(Shown))
                {
                    <SidebarRow Lead="SidebarRow.SidebarLead.Avatar" ImageUrl="@row.Image" Name="@row.Name" Label="@row.Name"
                                Class="online-characters-row" Href="@($"/character/{Uri.EscapeDataString(row.Name)}")" />
                }
            </div>
            @if (!InMain)
            {
                @SeeEveryone
            }
        }
        else
        {
            <div class="online-characters-note">@Loc["WidNobodyConnected"]</div>
        }
    </KitCard>
</div>

@code {
    [Parameter] public JsonElement? Config { get; set; }
    [Parameter] public string Zone { get; set; } = string.Empty;

    private const int Shown = 8;

    /// <summary>In a page's main column the widget takes the main card rather than the aside one.</summary>
    private bool InMain => Zone == nameof(WidgetZone.MainContent);

    private RenderFragment SeeEveryone => __builder =>
    {
        <a class="online-characters-all" href="/characters?online=1">@Loc["WidSeeEveryone"]</a>
    };

    /// <summary>The connected characters, or null when the fetch failed. Empty means nobody is on.</summary>
    private IReadOnlyList<CharacterDirectoryService.CharacterSummary>? _characters;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _characters = await CharacterDirectory.ListOnlineAsync()
            is IReadOnlyList<CharacterDirectoryService.CharacterSummary> rows ? rows : null;
        _loading = false;
    }
}
