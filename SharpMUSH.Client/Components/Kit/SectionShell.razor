@* D1 §3 page sidebar beside a section's body: the shape every section with sub-navigation uses
   (Config, Wiki, Characters, and the §6.5 sections). The sidebar is sticky inside the scroll
   container and stacks above the body at the medium tier. Phase 1 moves it into the shell's
   page-sidebar slot; until then each section layout hosts one of these. *@
<div class="kit-section @Class">
    <aside class="kit-section-nav" aria-label="@NavLabel">
        @Nav
    </aside>
    <div class="kit-section-body">
        @ChildContent
    </div>
</div>

@code {
    /// <summary>The section's sidebar.</summary>
    [Parameter, EditorRequired] public RenderFragment? Nav { get; set; }

    /// <summary>The page body.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Names the sidebar landmark ("Characters", "Wiki", ...).</summary>
    [Parameter] public string? NavLabel { get; set; }

    [Parameter] public string? Class { get; set; }
}
