@* One action in a RowMenu. A Danger item is drawn in the danger colour and should ask before it acts. *@
<button type="button" role="menuitem" class="kit-rowmenu-item @(Danger ? "kit-rowmenu-item--danger" : null)"
        disabled="@Disabled" @onclick="ChooseAsync">
    @if (Icon is not null)
    {
        <MudIcon Icon="@Icon" Size="Size.Small" />
    }
    <span>@ChildContent</span>
</button>

@code {
    [CascadingParameter] public RowMenu? Menu { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public bool Danger { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private async Task ChooseAsync()
    {
        Menu?.Close();
        await OnClick.InvokeAsync();
    }
}
