@using SharpMUSH.Client.Resources
@inject IStringLocalizer<SharedResource> Loc
@* D1 §4.2 sidebar row: one shape, the lead changes with the content (30px image, 28px avatar or a
   stacked pair, 30px icon tile, or a mono #). An <a> when it navigates, a <button> when it acts.
   The current item carries aria-current="page"; a collapsed strip keeps only the lead and moves
   the label to title/aria-label. *@
@if (Href is not null)
{
    <a class="@RowClass" href="@Href" aria-current="@(IsCurrent ? "page" : null)" title="@(Collapsed ? Label : null)" aria-label="@CollapsedName">
        @Inner
    </a>
}
else
{
    <button type="button" class="@RowClass" aria-current="@(IsCurrent ? "page" : null)" title="@(Collapsed ? Label : null)" aria-label="@CollapsedName" @onclick="OnClick">
        @Inner
    </button>
}

@code {
    public enum SidebarLead { Image, Avatar, Icon, Channel }

    [Parameter] public SidebarLead Lead { get; set; } = SidebarLead.Icon;
    [Parameter] public string? ImageUrl { get; set; }

    /// <summary>A second avatar, stacked behind the first, for a group page.</summary>
    [Parameter] public string? ImageUrl2 { get; set; }

    /// <summary>The name initials and the tint come from; defaults to <see cref="Label"/>.</summary>
    [Parameter] public string? Name { get; set; }

    /// <summary>The second person of a group page: their initials stand in when <see cref="ImageUrl2"/> is absent.</summary>
    [Parameter] public string? Name2 { get; set; }

    /// <summary>A MudBlazor icon for the icon lead.</summary>
    [Parameter] public string? Icon { get; set; }
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    /// <summary>A dim second line under the label ("Wren · 2h ago"); the row grows to fit it.</summary>
    [Parameter] public string? Sub { get; set; }

    /// <summary>Extra classes on the row element, so a page can address its own rows.</summary>
    [Parameter] public string? Class { get; set; }
    [Parameter] public int? Count { get; set; }

    /// <summary>A short dim word at the row's end when there is no count ("you", "in scene", "away").</summary>
    [Parameter] public string? Trail { get; set; }
    [Parameter] public int Unread { get; set; }
    [Parameter] public bool IsCurrent { get; set; }
    [Parameter] public bool Dim { get; set; }

    /// <summary>The label in the mono face, for names spelled as the game spells them (help topics).</summary>
    [Parameter] public bool Mono { get; set; }
    [Parameter] public bool Collapsed { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private bool IsGroup => Lead == SidebarLead.Avatar && (ImageUrl2 is not null || Name2 is not null);

    /// <summary>Collapsed, a channel keeps its first letter so the strip can tell them apart (board 07).</summary>
    private string ChannelMark => Collapsed && Label.Length > 0 ? $"#{char.ToUpperInvariant(Label[0])}" : "#";

    private string RowClass => string.Join(' ', new[]
    {
        "kit-row",
        $"kit-row--{Lead.ToString().ToLowerInvariant()}",
        IsCurrent ? "kit-row--current" : null,
        Unread > 0 ? "kit-row--unread" : null,
        Dim ? "kit-row--dim" : null,
        Mono ? "kit-row--mono" : null,
        Collapsed ? "kit-row--collapsed" : null,
        Sub is not null ? "kit-row--two-line" : null,
        Class,
    }.Where(c => !string.IsNullOrEmpty(c)));

    private string UnreadText => Loc.Plural("NavUnreadCount", "count", Unread);

    /// <summary>Collapsed rows replace their accessible name with aria-label, so the unread count is folded in.</summary>
    private string? CollapsedName => !Collapsed ? null : Unread > 0 ? $"{Label}, {UnreadText}" : Label;

    private string FallbackInitials => Initials.From(Name ?? Label);

    private RenderFragment Inner => __builder =>
    {
        <span class="kit-row-lead @(IsGroup ? "kit-row-lead--group" : null)" aria-hidden="true">
            @switch (Lead)
            {
                case SidebarLead.Image:
                    @if (ImageUrlPolicy.IsRenderable(ImageUrl))
                    {
                        <img class="kit-row-img" src="@ApiUrl.Resolve(ImageUrl!)" alt="" />
                    }
                    else if (Icon is not null)
                    {
                        <span class="kit-row-img kit-row-fallback"><MudIcon Icon="@Icon" Size="Size.Small" /></span>
                    }
                    else
                    {
                        <span class="kit-row-img kit-row-fallback">@FallbackInitials</span>
                    }
                    break;
                case SidebarLead.Avatar:
                    <CharacterAvatar Class="kit-row-avatar" FallbackClass="kit-row-fallback" Name="@(Name ?? Label)" ImageUrl="@ImageUrl" />
                    @if (IsGroup)
                    {
                        <CharacterAvatar Class="kit-row-avatar kit-row-avatar--second" FallbackClass="kit-row-fallback" Name="@Name2" ImageUrl="@ImageUrl2" />
                    }
                    break;
                case SidebarLead.Icon:
                    <span class="kit-row-icon"><MudIcon Icon="@(Icon ?? Icons.Material.Outlined.Folder)" Size="Size.Small" /></span>
                    break;
                case SidebarLead.Channel:
                    <span class="kit-row-hash">@ChannelMark</span>
                    break;
            }
        </span>
        @if (!Collapsed)
        {
            @if (Sub is not null)
            {
                <span class="kit-row-text">
                    <span class="kit-row-label">@Label</span>
                    <span class="kit-row-sub">@Sub</span>
                </span>
            }
            else
            {
                <span class="kit-row-label">@Label</span>
            }
            @if (Unread > 0)
            {
                <span class="kit-row-unread" aria-label="@UnreadText">@Unread</span>
            }
            else if (Count is not null)
            {
                <span class="kit-row-count">@Count</span>
            }
            else if (Trail is not null)
            {
                <span class="kit-row-trail">@Trail</span>
            }
        }
        else if (Unread > 0)
        {
            <span class="kit-row-unread kit-row-unread--badge" aria-hidden="true">@Unread</span>
        }
    };
}
