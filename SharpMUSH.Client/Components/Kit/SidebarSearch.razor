@* D1 §3 page sidebar search: a 40px field with a leading icon. Submitting hands the trimmed term
   to OnSearch; the section decides where that goes (the wiki home, the character directory). *@
<form class="kit-side-search" role="search" aria-label="@Placeholder" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
    <MudIcon Icon="@Icons.Material.Outlined.Search" Size="Size.Small" />
    <input type="search" placeholder="@Placeholder" aria-label="@Placeholder" value="@_term"
           @oninput="@(e => _term = e.Value?.ToString() ?? string.Empty)" />
</form>

@code {
    [Parameter, EditorRequired] public string Placeholder { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> OnSearch { get; set; }

    private string _term = string.Empty;

    private Task SubmitAsync() => OnSearch.InvokeAsync(_term.Trim());
}
