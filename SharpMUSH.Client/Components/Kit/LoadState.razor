@typeparam TValue where TValue : class
@* A section that reads something before it can show it: the error above, then placeholder rows in its
   place while it loads, what stands in when nothing came back, the empty state, or the content for what did. *@
@if (Error is not null)
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="@ErrorClass">@Error</MudAlert>
}

@if (Loading)
{
    @if (LoadingContent is not null)
    {
        @LoadingContent
    }
    else
    {
        <SkeletonRows Count="LoadingRows" Height="LoadingRowHeight" />
    }
}
else if (Value is null)
{
    @(Missing ?? Empty)
}
else if (IsEmpty?.Invoke(Value) == true)
{
    @Empty
}
else
{
    @ChildContent?.Invoke(Value)
}

@code {
    /// <summary>What was read; null until it has been, or when it could not be.</summary>
    [Parameter] public TValue? Value { get; set; }

    /// <summary>Shows the placeholder rows in place of everything else.</summary>
    [Parameter] public bool Loading { get; set; }

    /// <summary>The failure shown above the section; leave it unset when <see cref="Missing"/> reports it.</summary>
    [Parameter] public string? Error { get; set; }

    [Parameter] public string? ErrorClass { get; set; }

    /// <summary>How many placeholder rows hold the section's place while it loads.</summary>
    [Parameter] public int LoadingRows { get; set; } = 4;

    /// <summary>The height of a placeholder row, in pixels: that of a row of what arrives.</summary>
    [Parameter] public int LoadingRowHeight { get; set; } = 44;

    /// <summary>Whether what was read has nothing to show, so <see cref="Empty"/> shows instead.</summary>
    [Parameter] public Func<TValue, bool>? IsEmpty { get; set; }

    [Parameter] public RenderFragment<TValue>? ChildContent { get; set; }
    [Parameter] public RenderFragment? Empty { get; set; }

    /// <summary>What shows when loading is over and nothing was read; <see cref="Empty"/> when unset.</summary>
    [Parameter] public RenderFragment? Missing { get; set; }

    /// <summary>Replaces the default placeholder rows.</summary>
    [Parameter] public RenderFragment? LoadingContent { get; set; }
}
