@using SharpMUSH.Client.Components.Wiki
@using SharpMUSH.Client.Models
@using SharpMUSH.Client.Models.Wiki
@using SharpMUSH.Client.Resources
@using SharpMUSH.Client.Services
@using SharpMUSH.Library.Services
@using System.Net
@using System.Text
@using System.Text.RegularExpressions
@inject IServiceProvider Services
@inject WikiService Wiki
@inject IStringLocalizer<SharedResource> Loc
@inject IJSRuntime JS
@inject ILogger<WikiDisplay> Logger
@inject NavigationManager Nav
@inject CharacterDirectoryService Characters

@if (Article is null && IsCharacterBiography)
{
    @* A character with no biography is the normal state of a new character, not a missing page.
       No alert, no "does not exist" wording, no back-link to a wiki the reader never navigated
       from — just the fact and, for anyone who may write one, the offer. *@
    <div class="wiki-article wiki-article--no-bio">
        <MudText Typo="Typo.body2" Class="mud-text-secondary">@Loc["WikiCharacterNoBio", Slug]</MudText>
        @if (OwnsBiography)
        {
            @WriteBioButton
        }
        else
        {
            <AuthorizeView Policy="wiki.create">
                <Authorized>@WriteBioButton</Authorized>
            </AuthorizeView>
        }
    </div>
}
else if (Article is null && IsCategoryPage)
{
    @* A category exists as soon as a page names it; its own page is only a description, so a category
       without one still lists its members, as MediaWiki's does. *@
    <div class="wiki-page">
        <div class="wiki-page-main">
            <PlainPageHeader Kicker="@Loc["NavWikiCategoryKicker"]" Title="@WikiHelpers.CategoryLabel(Slug, _categoryNames)">
                <Actions>
                    <CapsuleButton Icon="@Icons.Material.Outlined.ChevronLeft" Href="/wiki">@Loc["Wiki"]</CapsuleButton>
                    <AuthorizeView Policy="wiki.create">
                        <Authorized>
                            <CapsuleButton Primary="true" Icon="@Icons.Material.Outlined.Edit" OnClick="@(() => ActivateEditMode())">@Loc["WikiCategoryDescribe"]</CapsuleButton>
                        </Authorized>
                    </AuthorizeView>
                </Actions>
            </PlainPageHeader>
            <WikiCategoryMembers Category="@Slug" />
        </div>
        <aside class="wiki-page-aside">
            <AuthorizeView Policy="wiki.admin">
                <Authorized>
                    <WikiPermissionsCard Category="@WikiHelpers.CategoryKey(Slug)" />
                </Authorized>
            </AuthorizeView>
        </aside>
    </div>
}
else if (Article is null)
{
    <div class="wiki-article">
        @* Embedded on another page, there is no wiki the reader came from, so no way "back" to it. *@
        @if (!Embedded)
        {
            <BackLink Class="wiki-back" Href="/wiki">@Loc["Wiki"]</BackLink>
        }
        <MudAlert Severity="@Severity.Info" Variant="Variant.Outlined" Class="mt-2">
            <AuthorizeView Policy="wiki.create">
                <Authorized>
                    <MudText>@Loc["WikiPageNotExist"]</MudText>
                    <MudButton EndIcon="@Icons.Material.Filled.Create" Color="Color.Primary" Ripple="true"
                               Style="text-transform:none;"
                               OnClick="@ActivateEditMode">@Loc["CreateThisPage"]</MudButton>
                </Authorized>
                <NotAuthorized>
                    <MudText>@Loc["NothingToSeeHere"]</MudText>
                </NotAuthorized>
            </AuthorizeView>
        </MudAlert>
    </div>
}
else if (DisplayAsHero)
{
    <div class="WikiContent WikiContent--hero">
        @LocaleBanner
        <div class="mud-card-content">
            @RenderSegments
        </div>
    </div>
}
else
{
    @* D1 §6.2 (boards 23–24). Not embedded: a glass banner when the page opens with an image (its lead
       image, which the body then omits; an image further down stays in the body) or the plain header; the body in a 640px card;
       an aside with the table of contents and locales, the characters mentioned, and more pages in
       the category. Embedded (a biography on a profile) keeps the article alone with no chrome. *@
    <div class="wiki-page @(Embedded ? "wiki-page--embedded" : null)">
        <div class="wiki-page-main">
            @if (!Embedded)
            {
                @if (HasBanner)
                {
                    <GlassBanner Title="@Article.Title" Kicker="@Kicker" ImageUrl="@LeadImage" Alt="@Article.Title"
                                 Height="200" TitleSize="hero" HeadingLevel="1"
                                 Minimised="@_minimised" MinimisedChanged="@(v => _minimised = v)" Fact="@MinimisedFact">
                        <Secondary>@MetaLine</Secondary>
                        <Back>
                            <CapsuleButton Icon="@Icons.Material.Outlined.ChevronLeft" Href="/wiki">@Loc["Wiki"]</CapsuleButton>
                        </Back>
                        <Actions>@HeaderActions</Actions>
                    </GlassBanner>
                }
                else
                {
                    <PlainPageHeader Kicker="@Kicker" Title="@Article.Title">
                        <DescriptionContent>@MetaLine</DescriptionContent>
                        <Actions>
                            <CapsuleButton Icon="@Icons.Material.Outlined.ChevronLeft" Href="/wiki">@Loc["Wiki"]</CapsuleButton>
                            @HeaderActions
                        </Actions>
                    </PlainPageHeader>
                }
                @FallbackNotice
                @if (_hasBody)
                {
                    <KitCard Class="wiki-article-card">
                        <div class="WikiContent wiki-article-body" id="wiki-top">
                            <div class="mud-card-content">
                                @RenderSegments
                            </div>
                        </div>
                    </KitCard>
                }
                @CategoryBar
                @if (IsCategoryPage)
                {
                    <WikiCategoryMembers Category="@Slug" />
                }
            }
            else
            {
                <article class="wiki-article-main">
                    @if (ShowTitle)
                    {
                        <div class="wiki-article-kicker">@Kicker</div>
                        <h1 class="wiki-article-title">@Article.Title</h1>
                    }
                    @LocaleBanner
                    <div class="WikiContent wiki-article-body">
                        <div class="mud-card-content">
                            @RenderSegments
                        </div>
                    </div>
                </article>
            }
        </div>

        @if (!Embedded)
        {
            <aside class="wiki-page-aside">
                @if (Article.Access?.Manage == true)
                {
                    <WikiPermissionsCard Slug="@Slug" Namespace="@Namespace"
                                         Category="@(IsCategoryPage ? WikiHelpers.CategoryKey(Slug) : null)" />
                }
                @if (_toc.Count > 0 || OtherLocales.Any())
                {
                    <KitCard Aside="true" Title="@Loc["ResOnThisPage"]">
                        @if (_toc.Count > 0)
                        {
                            <nav class="wiki-toc" aria-label="@Loc["ResOnThisPage"]">
                                @foreach (var entry in _toc)
                                {
                                    var anchor = entry.Anchor;
                                    <a href="@TocHref(anchor)" aria-current="@(anchor == _tocCurrent ? "location" : null)"
                                       @onclick="@(() => _tocCurrent = anchor)">@entry.Text</a>
                                }
                            </nav>
                        }
                        @if (OtherLocales.Any())
                        {
                            <div class="wiki-locales">
                                <SectionLabel>@Loc["NavWikiAlsoIn"]</SectionLabel>
                                <div class="wiki-lang-chips" aria-label="@Loc["WikiAvailableTranslations"]">
                                    @foreach (var locale in OtherLocales)
                                    {
                                        <a class="wiki-lang-chip" href="@LocaleHref(locale)" lang="@locale">@PortalLocales.DisplayName(locale)</a>
                                    }
                                </div>
                            </div>
                        }
                    </KitCard>
                }
                @if (_mentioned.Count > 0)
                {
                    <KitCard Aside="true" Class="wiki-mentioned" Title="@Loc.Plural("NavWikiMentioned", "count", _mentioned.Count)">
                        <div class="wiki-mentioned-grid">
                            @foreach (var person in _mentioned)
                            {
                                var m = person;
                                <PortraitTile Name="@m.Name" ImageUrl="@MentionImage(m.Name)" Alt="@m.Name" Href="@m.Href" />
                            }
                        </div>
                    </KitCard>
                }
                @if (_more.Count > 0)
                {
                    <KitCard Aside="true" Class="wiki-more" Title="@string.Format(Loc["NavWikiMoreIn"], WikiHelpers.CategoryLabel(_moreLoadedFor!, _categoryNames))">
                        <Controls>
                            <a class="wiki-more-all" href="@WikiCategories.Route(_moreLoadedFor!)">@Loc.Plural("NavWikiAllShort", "count", _moreTotal)</a>
                        </Controls>
                        <ChildContent>
                        <CardRows>
                            @foreach (var sibling in _more)
                            {
                                var page2 = sibling;
                                <SidebarRow Lead="SidebarRow.SidebarLead.Image" Icon="@Icons.Material.Outlined.Description" ImageUrl="@page2.Image" Name="@page2.Title" Label="@page2.Title"
                                            Href="@WikiRoutes.PathFor(page2.Namespace, page2.Slug)" />
                            }
                        </CardRows>
                        </ChildContent>
                    </KitCard>
                }
            </aside>
        }
    </div>
}

@code {
    [Parameter]
    public required string Slug { get; init; }

    /// <summary>Wiki namespace (e.g. "help"); null means the Main namespace.</summary>
    [Parameter]
    public string? Namespace { get; init; }

    /// <summary>The locale the reader asked for via <c>?lang=</c>; null means their stored preference.</summary>
    [Parameter]
    public string? Locale { get; init; }

    [Parameter]
    public WikiArticle? Article { get; init; }

    /// <summary>
    /// True when this page is rendered inside another page (a layout widget) rather than as the
    /// <c>/wiki</c> route itself. Suppresses chrome that only makes sense on the wiki route.
    /// </summary>
    [Parameter]
    public bool Embedded { get; init; }

    /// <summary>False drops an embedded article's kicker and title (the host card's header names it).</summary>
    [Parameter]
    public bool ShowTitle { get; init; } = true;

    [Parameter]
    public required Func<Task> ActivateEditMode { get; init; }

    private sealed record TocEntry(string Text, string Anchor);

    private static readonly Regex DirectivePlaceholder = new(
        "<div class=\"wiki-directive\" data-directive=\"([a-z]+)\" data-arg=\"([^\"]*)\"></div>",
        RegexOptions.Compiled);

    private static readonly Regex WikiLinkHref = new(
        "<a href=\"/wiki/([^\"#?]+)\">",
        RegexOptions.Compiled);

    // Character biographies render as their /character/{slug} alias. HTML stored before that
    // change still carries the /wiki/character/... form, which WikiLinkHref above still matches,
    // so both shapes have to be recognised for redlink marking to survive the transition.
    private static readonly Regex CharacterLinkHref = new(
        "<a href=\"/character/([^\"#?/]+)\">",
        RegexOptions.Compiled);

    private IReadOnlyList<WikiBodyNode> _segments = [];
    private List<TocEntry> _toc = [];
    private string _tocCurrent = TopAnchor;
    private bool _hasBody = true;
    private const string TopAnchor = "wiki-top";

    /// <summary>A character the body links to: the link text and its /character/ href.</summary>
    private sealed record Mentioned(string Name, string Href);

    private static readonly Regex CharacterLinkWithText = new(
        "<a href=\"(/character/[^\"#?/]+)\"[^>]*>(.*?)</a>",
        RegexOptions.Compiled | RegexOptions.Singleline);

    private List<Mentioned> _mentioned = [];

    /// <summary>Directory rows for the Mentioned tiles' pictures (profile-handler 1.5's image column).</summary>
    private IReadOnlyList<CharacterDirectoryService.CharacterSummary> _characters = [];
    private List<WikiPageSummary> _more = [];
    private int _moreTotal;
    private bool _minimised;
    private string? _moreLoadedFor;

    /// <summary>The image the page opens with, which becomes its banner; null when it opens with text.</summary>
    private string? LeadImage => WikiImages.LeadImageUrl(Article?.RenderedHtml);

    private bool HasBanner => Article is not null && ImageUrlPolicy.IsRenderable(LeadImage);

    private string PagePath => WikiRoutes.WikiPathFor(Namespace, Slug);

    /// <summary>True for a category's own page, whose view lists the category's members after its text.</summary>
    private bool IsCategoryPage => string.Equals(Namespace, "category", StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// The line above the title: the namespace for a page outside Main ("Help", "Category"), else the
    /// page's first category, else nothing more specific than the wiki itself.
    /// </summary>
    private string Kicker =>
        WikiHelpers.ParseNamespace(Namespace) is { } ns and not SharpMUSH.Library.Models.Wiki.WikiNamespace.Main
            ? ns is SharpMUSH.Library.Models.Wiki.WikiNamespace.Category ? Loc["NavWikiCategoryKicker"] : WikiHelpers.CategoryLabel(ns.ToString())
            : Article?.Categories.FirstOrDefault() is { } category ? WikiHelpers.CategoryLabel(category, _categoryNames) : Loc["Wiki"];

    /// <summary>The page's categories under its body, each linking to its category page (MediaWiki's catlinks).</summary>
    private RenderFragment CategoryBar => __builder =>
    {
        @if (Article is { Categories.Count: > 0 })
        {
            <nav class="wiki-catlinks" aria-label="@Loc["NavWikiCategories"]">
                <span class="wiki-catlinks-label">@Loc["NavWikiCategories"]</span>
                @foreach (var category in Article.Categories)
                {
                    <a class="wiki-catlink" href="@WikiCategories.Route(category)">@WikiHelpers.CategoryLabel(category, _categoryNames)</a>
                }
            </nav>
        }
    };

    private string? EditedWhen => Article?.UpdatedAt is { } at ? Loc.Format(at) : null;

    private string MinimisedFact =>
        EditedWhen is null ? Kicker : $"{Kicker} · {string.Format(Loc["NavWikiEditedAgo"], EditedWhen)}";

    /// <summary>"Last edited by {mention} · when · anyone can edit" — the mention is a component, so the resx value is split around its placeholder.</summary>
    private RenderFragment MetaLine => __builder =>
    {
        @if (Article?.LastEditedBy is { } editor)
        {
            var parts = Loc["NavWikiLastEditedBy"].Value.Split("{0}");
            <span class="wiki-meta-edited">@parts[0]<Mention Name="@editor" />@(parts.Length > 1 ? parts[1] : string.Empty)</span>
            @if (EditedWhen is not null)
            {
                <span class="wiki-meta-sep"> · </span><span>@EditedWhen</span>
            }
            <span class="wiki-meta-sep"> · </span>
        }
        <span class="wiki-meta-edit">@(Article?.IsRestricted == true ? Loc["WikiRestrictedNote"] : Loc["ResAnyoneCanEdit"])</span>
    };

    private RenderFragment HeaderActions => __builder =>
    {
        <CapsuleButton Icon="@Icons.Material.Outlined.History" Href="@HistoryHref">@Loc["ResHistory"]</CapsuleButton>
        @* The server decides, with the page's namespace, category and page requirements in hand. *@
        @if (Article?.Access?.Edit == true)
        {
            <CapsuleButton Primary="true" Icon="@Icons.Material.Outlined.Edit" OnClick="@(() => ActivateEditMode())">@Loc["WikiEdit"]</CapsuleButton>
        }
    };

    private static List<Mentioned> FindMentioned(string html) =>
        CharacterLinkWithText.Matches(html)
            .Select(m => new Mentioned(WebUtility.HtmlDecode(Regex.Replace(m.Groups[2].Value, "<[^>]+>", string.Empty)).Trim(), m.Groups[1].Value))
            .Where(m => m.Name.Length > 0)
            .DistinctBy(m => m.Href, StringComparer.Ordinal)
            .ToList();

    /// <summary>Character links read as mentions (D1 §4.8): body colour, a thin underline. A redlinked one keeps its dashed red.</summary>
    private static string MarkMentions(string html)
    {
        html = CharacterLinkHref.Replace(html, m => $"<a href=\"/character/{m.Groups[1].Value}\" class=\"mention\">");
        return Regex.Replace(html, "<a href=\"(/character/[^\"#?/]+)\" class=\"wiki-redlink\">", "<a href=\"$1\" class=\"wiki-redlink mention\">");
    }

    /// <summary>
    /// True when this page is a character biography — served from /character/{slug}, where the wiki
    /// framing (and the "this page does not exist" wording) would misread as something broken.
    /// </summary>
    private bool IsCharacterBiography => WikiRoutes.IsCharacterProfile(Namespace);

    /// <summary>The profile this biography sits on, when it does: it says whether the viewer's account owns the character.</summary>
    [CascadingParameter] private SharpMUSH.Client.Models.Widgets.ProfilePageContext? Profile { get; set; }

    /// <summary>An account writes its own character's biography without wiki.create (the server decides by ownership).</summary>
    private bool OwnsBiography => IsCharacterBiography && Profile is { Owned: true } profile
        && string.Equals(WikiHelpers.Slugify(profile.CharacterName), WikiHelpers.Slugify(Slug), StringComparison.Ordinal);

    private RenderFragment WriteBioButton => @<MudButton EndIcon="@Icons.Material.Filled.Create" Color="Color.Primary" Ripple="true"
                                                       Class="mt-2" Style="text-transform:none;"
                                                       OnClick="@ActivateEditMode">@Loc["WikiCharacterWriteBio"]</MudButton>;

    private string HistoryHref => $"{PagePath}/history";

    /// <summary>
    /// Per-session only, deliberately: a translation gap should keep nagging on the next page view, so this
    /// is component state rather than anything persisted.
    /// </summary>
    private bool _fallbackDismissed;

    private bool ShowFallbackNotice => Article?.IsFallback == true && !_fallbackDismissed;

    /// <summary>Locales worth offering as a link — everything available except the one on screen.</summary>
    private IEnumerable<string> OtherLocales =>
        Article?.AvailableLocales
            .Where(l => !string.Equals(l, Article.Locale, StringComparison.OrdinalIgnoreCase))
        ?? [];

    private string LocaleHref(string locale) =>
        $"{PagePath}?lang={Uri.EscapeDataString(locale)}";

    /// <summary>
    /// The locale a "Translate this page" link should target. The raw <c>?lang=</c> wins over
    /// <see cref="WikiArticle.RequestedLocale"/>: a reader who asked for a locale the server normalised
    /// away must still land in an editor for the locale <em>they</em> asked for.
    /// </summary>
    private string TargetLocale =>
        string.IsNullOrWhiteSpace(Locale) ? Article?.RequestedLocale ?? string.Empty : Locale;

    /// <summary>
    /// The fallback notice and language chips. Defined once and rendered in both the hero and grid
    /// branches — duplicating the markup is how the home page ends up silently never showing it.
    /// </summary>
    /// <summary>The fallback notice alone; the language chips live in the aside when the page is not embedded.</summary>
    private RenderFragment FallbackNotice => __builder =>
    {
        @if (ShowFallbackNotice)
        {
            @LocaleBanner
        }
    };

    private RenderFragment LocaleBanner => @<div>
        @if (ShowFallbackNotice)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-2">
                <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;">
                    <span>
                        @string.Format(Loc["WikiFallbackNotice"],
                            PortalLocales.DisplayName(Article!.RequestedLocale),
                            PortalLocales.DisplayName(Article!.Locale))
                    </span>
                    @if (Article.Access?.Edit == true)
                    {
                        <MudLink Href="@($"{PagePath}/edit?lang={Uri.EscapeDataString(TargetLocale)}")"
                                 Typo="Typo.body2">
                            @Loc["WikiFallbackCreateTranslation"]
                        </MudLink>
                    }
                    <div style="flex:1;"></div>
                    <MudIconButton Class="wiki-fallback-dismiss"
                                   Icon="@Icons.Material.Filled.Close"
                                   Size="Size.Small"
                                   OnClick="@(() => _fallbackDismissed = true)" />
                </div>
            </MudAlert>
        }
        @if (OtherLocales.Any())
        {
            <div class="wiki-lang-chips">
                <span class="wiki-lang-chips-label">@Loc["WikiAvailableTranslations"]</span>
                @foreach (var locale in OtherLocales)
                {
                    <a href="@LocaleHref(locale)">@PortalLocales.DisplayName(locale)</a>
                }
            </div>
        }
    </div>;

    // The article HTML this display last marked, and the marking: a parent re-render hands the same
    // article back (often while the first check is still out), and asking the server again which of
    // its links exist would change nothing.
    private string? _markedFrom;
    private Task<string>? _marking;

    // Each category's name in the language the page is shown in: its category page's title, translated.
    // Categories are the page's, the same in every translation; only their names change.
    private IReadOnlyDictionary<string, string>? _categoryNames;
    private string? _categoryNamesFor;

    protected override async Task OnParametersSetAsync()
    {
        // The server renders the article; the Markdig pipeline is only for the rare page that arrives
        // without its HTML, so it is resolved (and its pipeline built) only then rather than by every
        // wiki view, the home page's included.
        var html = Article?.RenderedHtml
                   ?? (Article is not null
                       ? Services.GetRequiredService<WikiMarkdigPipeline>().RenderToHtml(Article.Content)
                       : string.Empty);

        // The banner shows the lead image; the body must not show it a second time.
        if (!Embedded && HasBanner)
        {
            html = WikiImages.StripFirstImage(html, LeadImage!);
        }
        html = ApiUrl.ResolveHtml(html);

        _hasBody = HasVisibleContent(html);
        _toc = BuildToc(html);
        _mentioned = Embedded ? [] : FindMentioned(html);

        if (html != _markedFrom || _marking is null)
        {
            _markedFrom = html;
            _marking = MarkRedlinksAsync(html);
        }

        var marking = _marking;
        // Unmarked until the redlink check answers; the lifecycle renders as soon as this awaits.
        _segments = WikiBody.Split(marking.IsCompletedSuccessfully ? MarkMentions(marking.Result) : html);

        var marked = MarkMentions(await marking);
        if (marking == _marking && marked != html)
        {
            _segments = WikiBody.Split(marked);
        }

        await LoadCategoryNamesAsync();
        await LoadMoreAsync();
        await LoadMentionImagesAsync();
    }

    private async Task LoadCategoryNamesAsync()
    {
        if (Article is not { Categories.Count: > 0 } && !IsCategoryPage)
        {
            return;
        }

        var lang = Article?.Locale ?? Locale ?? string.Empty;
        if (_categoryNames is not null && lang == _categoryNamesFor)
        {
            return;
        }

        _categoryNamesFor = lang;
        _categoryNames = await Wiki.GetCategoryNamesAsync(lang.Length == 0 ? null : lang);
    }

    /// <summary>
    /// The pictures for the Mentioned tiles, from the character directory; a failed read shows initials.
    /// </summary>
    private async Task LoadMentionImagesAsync()
    {
        if (_mentioned.Count == 0 || _characters.Count > 0)
        {
            return;
        }

        if (await Characters.ListAsync() is IReadOnlyList<CharacterDirectoryService.CharacterSummary> rows)
        {
            _characters = rows;
        }
    }

    private string? MentionImage(string name) =>
        _characters.FirstOrDefault(r => string.Equals(r.Name, name, StringComparison.OrdinalIgnoreCase))?.Image;

    /// <summary>
    /// Up to three other pages in the page's first category for the aside, plus the total for the "All N"
    /// link. A page in no category has no aside.
    /// </summary>
    private async Task LoadMoreAsync()
    {
        if (Embedded || Article?.Categories.FirstOrDefault() is not { } key)
        {
            _more = [];
            return;
        }

        if (key == _moreLoadedFor)
        {
            return;
        }

        _moreLoadedFor = key;
        var siblings = (await Wiki.GetAllByCategoryAsync(key))
            .Where(p => p.Namespace.Equals(Namespace, StringComparison.OrdinalIgnoreCase))
            .Where(p => !p.Slug.Equals(Slug, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(p => p.UpdatedAt)
            .ToList();
        _moreTotal = siblings.Count + 1;
        _more = siblings.Take(3).ToList();
    }

    /// <summary>
    /// After the article HTML is in the DOM, hand off to the client post-render pass
    /// (js/wiki-render.js): initialise mermaid once, then on every render turn any
    /// <c>```mermaid</c> blocks into SVG and honour a deep-link URL fragment.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Diagrams and fragment scrolling are enhancements; the article HTML is already on screen.
        try
        {
            if (firstRender)
            {
                await JS.InvokeVoidAsync("SharpMUSH.WikiRender.init");
            }

            if (Article is not null)
            {
                await JS.InvokeVoidAsync("SharpMUSH.WikiRender.render");
            }
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Wiki post-render pass failed");
        }
    }

    private RenderFragment RenderSegments => RenderNodes(_segments);

    /// <summary>The body's pieces: HTML as it is, a component for each live listing, and an element for
    /// each block that holds one (<see cref="WikiBody"/>).</summary>
    private static RenderFragment RenderNodes(IReadOnlyList<WikiBodyNode> nodes) => __builder =>
    {
        foreach (var node in nodes)
        {
            switch (node)
            {
                case WikiBodyHtml html:
                    @((MarkupString)html.Html)
                    break;
                case WikiBodyDirective directive:
                    <WikiDirectiveBlock Directive="@directive.Directive" Arg="@directive.Arg" />
                    break;
                case WikiBodyElement element:
                    <div @attributes="@element.Attributes">@RenderNodes(element.Children)</div>
                    break;
            }
        }
    };

    /// <summary>The h2 headings as Markdig rendered them (their ids are the anchors the body
    /// carries), led by an "Overview" entry for the intro (board 23). Empty when the page has no
    /// headings: a one-section page needs no table of contents.</summary>
    private List<TocEntry> BuildToc(string html)
    {
        if (string.IsNullOrEmpty(html)) return [];
        var headings = RenderedH2.Matches(html)
            .Select(m => new TocEntry(WebUtility.HtmlDecode(AnyTag.Replace(m.Groups[2].Value, string.Empty)).Trim(), m.Groups[1].Value))
            .Where(e => e.Text.Length > 0 && e.Anchor.Length > 0)
            .ToList();
        return headings.Count == 0 ? [] : [new TocEntry(Loc["NavWikiOverview"], TopAnchor), .. headings];
    }

    /// <summary>The link for a TOC entry: the page path with the query as addressed now (so a
    /// translated page keeps its <c>?lang=</c>) plus the anchor. A bare <c>#anchor</c> would resolve
    /// against <c>&lt;base href="/"&gt;</c> and leave the page.</summary>
    private string TocHref(string anchor) => $"{PagePath}{new Uri(Nav.Uri).Query}#{anchor}";

    /// <summary>Whether anything remains to show once the banner has taken the first image. A
    /// directive placeholder is an empty element the body hydrates into a listing, so it counts.</summary>
    private static bool HasVisibleContent(string html) =>
        !string.IsNullOrWhiteSpace(WebUtility.HtmlDecode(AnyTag.Replace(html, string.Empty)))
        || EmbeddedMedia.IsMatch(html)
        || DirectivePlaceholder.IsMatch(html);

    private static readonly Regex RenderedH2 = new(@"<h2\b[^>]*\bid\s*=\s*""([^""]*)""[^>]*>(.*?)</h2>", RegexOptions.IgnoreCase | RegexOptions.Singleline, TimeSpan.FromSeconds(1));
    private static readonly Regex AnyTag = new(@"<[^>]+>", RegexOptions.Singleline, TimeSpan.FromSeconds(1));
    private static readonly Regex EmbeddedMedia = new(@"<(img|video|audio|iframe|svg|table)\b", RegexOptions.IgnoreCase, TimeSpan.FromSeconds(1));

    /// <summary>An anchor found in rendered HTML: the href as written, and the wiki page
    /// reference ("ns/slug") whose existence decides whether it is a redlink.</summary>
    private readonly record struct LinkTarget(string Href, string Reference);

    private static List<LinkTarget> FindLinkTargets(string html) =>
        WikiLinkHref.Matches(html)
            .Select(m => new LinkTarget($"/wiki/{m.Groups[1].Value}", m.Groups[1].Value))
            .Concat(CharacterLinkHref.Matches(html)
                .Select(m => new LinkTarget(
                    $"/character/{m.Groups[1].Value}",
                    $"character/{m.Groups[1].Value}")))
            .DistinctBy(t => t.Href, StringComparer.Ordinal)
            .ToList();

    private async Task<string> MarkRedlinksAsync(string html)
    {
        var targets = FindLinkTargets(html);
        if (targets.Count == 0) return html;

        var exists = await Wiki.CheckExistsAsync(
            targets.Select(t => WebUtility.HtmlDecode(t.Reference)!).Distinct(StringComparer.Ordinal));

        foreach (var target in targets)
        {
            var decoded = WebUtility.HtmlDecode(target.Reference);
            if (exists.TryGetValue(decoded, out var found) && !found)
            {
                html = html.Replace(
                    $"<a href=\"{target.Href}\">",
                    $"<a href=\"{target.Href}\" class=\"wiki-redlink\">");
            }
        }

        return html;
    }

    /// <summary>
    /// True for the chrome-free framing the home page gets inside the front-page widget: its lead image
    /// centred as the banner, and centred text only where the page asks for it with <c>::: center</c>.
    /// Only when <see cref="Embedded"/>: on the <c>/wiki/...</c> route the home page is an article
    /// like any other, and the hero would strip the very edit and history controls it needs there.
    /// </summary>
    private bool DisplayAsHero => Embedded && Slug.Equals("home", StringComparison.InvariantCultureIgnoreCase);
}
