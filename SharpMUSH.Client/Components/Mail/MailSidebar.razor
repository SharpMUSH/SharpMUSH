@using Microsoft.AspNetCore.Components.Routing
@using SharpMUSH.Client.Services
@inject MailService MailApi
@inject MailWatch Watch
@inject ITerminalService Terminal
@inject IAccountAuthState AccountAuth
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> Loc
@implements IDisposable

@* D1 §6.5 Mail page sidebar: "Mail" and the inbox's unread count, then one row per folder (the inbox
   with its unread pill) and Sent, the mail the character sent, the list on screen marked. Mail belongs to the active
   character, so without one there is no mailbox to list and the sidebar says so. Collapsed keeps
   each row's icon. *@
<SidebarPanel Class="mail-side" Collapsed="@Collapsed">
    @if (!Collapsed)
    {
        <SidebarHead Title="@Loc["Mail"]">
            <Sub>
                @if (_connected && Watch.InboxUnread is int unread)
                {
                    <span>@Loc.Plural("NavUnreadCount", "count", unread)</span>
                }
            </Sub>
        </SidebarHead>
    }
    @if (!_connected)
    {
        @if (!Collapsed)
        {
            <SidebarNote Class="mail-side-empty">@Loc["MailNeedsCharacter"]</SidebarNote>
        }
    }
    else
    {
        @if (!Collapsed)
        {
            <SectionLabel>@Loc["NavMailFolders"]</SectionLabel>
        }
        <SidebarGroup Class="mail-side-folders" Label="@Loc["NavMailFolders"]">
            @foreach (var folder in _folders)
            {
                <SidebarRow Lead="SidebarRow.SidebarLead.Icon" Icon="@FolderIcon(folder)" Label="@FolderName(Loc, folder)"
                            Href="@FolderHref(folder)" IsCurrent="@IsCurrent(folder)"
                            Unread="@(folder == Inbox ? Watch.InboxUnread ?? 0 : 0)" Collapsed="@Collapsed" />
            }
            <SidebarRow Class="mail-side-sent" Lead="SidebarRow.SidebarLead.Icon" Icon="@Icons.Material.Outlined.Send" Label="@Loc["NavMailFolderSent"]"
                        Href="@SentHref" IsCurrent="@(_path == SentHref)" Collapsed="@Collapsed" />
        </SidebarGroup>
    }
</SidebarPanel>

@code {
    /// <summary>Only the icons, for the collapsed strip.</summary>
    [Parameter] public bool Collapsed { get; set; }

    public const string Inbox = "INBOX";

    /// <summary>The list of mail the character sent: not a folder, since what they sent is in other mailboxes.</summary>
    public const string SentHref = "/mail/sent";

    private bool _connected;
    private IReadOnlyList<string> _folders = [Inbox];
    private string _path = "/mail";
    private string? _folderQuery;

    /// <summary>Only the latest refresh may write: reads land in any order.</summary>
    private long _ticket;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        Terminal.ConnectionStateChanged += OnConnectionChanged;
        MailApi.Changed += OnMailChanged;
        Watch.Changed += OnUnreadChanged;
        AccountAuth.ActiveCharacterChanged += OnActingChanged;
        Locate();
        _connected = Terminal.IsConnected;
        if (_connected) await RefreshAsync();
    }

    /// <summary>The address of a folder's list.</summary>
    public static string FolderHref(string folder) => $"/mail?folder={Uri.EscapeDataString(folder)}";

    private async Task RefreshAsync()
    {
        var ticket = ++_ticket;
        var names = await MailApi.FoldersAsync() is IReadOnlyList<string> list && list.Count > 0 ? list : [Inbox];
        if (ticket != _ticket) return;
        _folders = names;
    }

    private bool IsCurrent(string folder)
    {
        if (_path is "/mail/compose" or SentHref) return false;
        if (_path != "/mail" && !_path.StartsWith("/mail/", StringComparison.Ordinal)) return false;
        return string.Equals(_folderQuery ?? Inbox, folder, StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>
    /// A folder's name as the reader sees it: the inbox and trash folders in the reader's language, any other as its
    /// owner named it. A folder named SENT keeps its name: Sent is the list of mail the character sent.
    /// </summary>
    public static string FolderName(IStringLocalizer<SharedResource> loc, string folder) => folder.ToUpperInvariant() switch
    {
        "INBOX" => loc["NavMailFolderInbox"],
        "TRASH" => loc["NavMailFolderTrash"],
        _ => folder,
    };

    private static string FolderIcon(string folder) => folder.ToUpperInvariant() switch
    {
        "INBOX" => Icons.Material.Outlined.Inbox,
        "TRASH" => Icons.Material.Outlined.Delete,
        _ => Icons.Material.Outlined.Folder,
    };

    private void Locate()
    {
        var at = SectionPath.Of(Nav);
        _path = at.Path;
        _folderQuery = QueryValue(at.Query, "folder");
    }

    private static string? QueryValue(string query, string name)
    {
        foreach (var part in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = part.IndexOf('=');
            if (eq > 0 && part[..eq] == name) return Uri.UnescapeDataString(part[(eq + 1)..]);
        }

        return null;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(() =>
    {
        Locate();
        StateHasChanged();
    });

    private void OnConnectionChanged(bool connected) => InvokeAsync(async () =>
    {
        _connected = connected;
        if (connected) await RefreshAsync();
        StateHasChanged();
    });

    /// <summary>
    /// A character switch rebinds the REST session to the new character without reconnecting the
    /// terminal, so the mailbox on screen is the previous character's until it is read again.
    /// </summary>
    private void OnActingChanged() => InvokeAsync(async () =>
    {
        if (!_connected) return;
        await RefreshAsync();
        StateHasChanged();
    });

    /// <summary>A read or a send changes no folder; a delete may empty one. The unread count is the watch's.</summary>
    private void OnMailChanged(MailService.MailChange change) => InvokeAsync(async () =>
    {
        if (!_connected || change.MarkedRead || change.Folder == MailService.SentList) return;
        await RefreshAsync();
        StateHasChanged();
    });

    private void OnUnreadChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        Terminal.ConnectionStateChanged -= OnConnectionChanged;
        MailApi.Changed -= OnMailChanged;
        Watch.Changed -= OnUnreadChanged;
        AccountAuth.ActiveCharacterChanged -= OnActingChanged;
    }
}
