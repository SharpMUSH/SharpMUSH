@inject IThemeService ThemeService
@implements IDisposable

@* The theme's tokens as a :root rule. It sits after tokens.css (and after the copy index.html applies
   from localStorage before the runtime starts), and is unlayered, so it overrides both. *@
<style id="sharp-theme">@_css</style>
<MudThemeProvider Theme="_theme" IsDarkMode="_isDarkMode" />
@ChildContent

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private MudTheme _theme = new();
    private bool _isDarkMode = true;
    private string _css = string.Empty;

    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += HandleThemeChanged;
        Refresh();
    }

    private void HandleThemeChanged()
        => InvokeAsync(() =>
        {
            Refresh();
            StateHasChanged();
        });

    private void Refresh()
    {
        var current = ThemeService.Current;
        _theme = current.ToMudTheme();
        _isDarkMode = current.Dark;
        _css = current.Css;
    }

    public void Dispose()
        => ThemeService.OnThemeChanged -= HandleThemeChanged;
}
