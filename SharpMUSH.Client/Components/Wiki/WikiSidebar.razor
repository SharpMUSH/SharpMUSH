@using SharpMUSH.Library.API
@using Microsoft.AspNetCore.Components.Routing
@using SharpMUSH.Client.Models
@using SharpMUSH.Client.Models.Wiki
@using SharpMUSH.Library.Services
@inject WikiService Wiki
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> Loc
@implements IDisposable

@* D1 §6.1 wiki page sidebar (board 21): "Wiki · Main namespace · N pages", a search that lands on
   the wiki home, Browse (Wiki home, Recent changes), the categories as image rows with counts, and
   a dashed New page button for those who may create. Collapsed keeps the category covers. Hosted
   by WikiLayout until the shell's page-sidebar slot exists (Phase 1). *@
<SidebarPanel Class="wiki-side" Collapsed="@Collapsed">
    @if (!Collapsed)
    {
        <SidebarHead Title="@Loc["Wiki"]">
            <Sub>@CollectionTitle · @Loc.Plural("NavWikiPagesCount", "count", (_navigation?.Total ?? 0))</Sub>
        </SidebarHead>
        <SidebarSearch Placeholder="@Loc["NavWikiSearch"]" OnSearch="Search" />
        <SectionLabel>@Loc["NavWikiBrowse"]</SectionLabel>
    }
    <SidebarGroup Class="wiki-side-browse" Label="@Loc["NavWikiBrowse"]">
        <SidebarRow Lead="SidebarRow.SidebarLead.Icon" Icon="@Icons.Material.Outlined.MenuBook" Label="@Loc["NavWikiHome"]" Href="@WikiLocaleLinks.WithLocale("/wiki", _locale)" IsCurrent="@(_path == "/wiki")" Collapsed="@Collapsed" />
        <SidebarRow Lead="SidebarRow.SidebarLead.Icon" Icon="@Icons.Material.Outlined.History" Label="@Loc["NavWikiRecentChanges"]" Href="@WikiLocaleLinks.WithLocale("/wiki/recent", _locale)" IsCurrent="@(_path == "/wiki/recent")" Collapsed="@Collapsed" />
    </SidebarGroup>
    @if (_failed)
    {
        <button type="button" class="wiki-side-new" @onclick="LoadNavigationAsync">@Loc["WikiLoadFailed"]</button>
    }
    @if (_navigation is { } navigation)
    {
        @if (!Collapsed)
        {
            <SectionLabel>@Loc["WikiCollections"]</SectionLabel>
        }
        <SidebarGroup Class="wiki-side-collections" Label="@Loc["WikiCollections"]">
            @foreach (var collection in navigation.Collections)
            {
                var route = "/wiki/collections/" + Uri.EscapeDataString(collection.Id);
                <SidebarRow Lead="SidebarRow.SidebarLead.Icon" Icon="@Icons.Material.Outlined.LibraryBooks" Label="@collection.Name" Count="@collection.Pages" Href="@WikiLocaleLinks.WithLocale(route, _locale)" IsCurrent="@(navigation.Collection == collection.Id)" Collapsed="@Collapsed" />
            }
        </SidebarGroup>
        @if (!Collapsed)
        {
            <SectionLabel>@Loc["NavWikiCategories"]</SectionLabel>
        }
        <SidebarGroup Class="wiki-side-cats" Label="@Loc["NavWikiCategories"]">
            @foreach (var category in navigation.Categories.Where(row => row.Pinned))
            {
                var route = "/wiki/collections/" + Uri.EscapeDataString(navigation.Collection) + "?category=" + Uri.EscapeDataString(category.Key);
                <SidebarRow Lead="SidebarRow.SidebarLead.Image" Icon="@Icons.Material.Outlined.Description" ImageUrl="@category.Image" Name="@category.Name" Label="@category.Name" Count="@category.Pages" Href="@WikiLocaleLinks.WithLocale(route, _locale)" IsCurrent="@(_category == category.Key)" Collapsed="@Collapsed" />
            }
            <SidebarRow Lead="SidebarRow.SidebarLead.Icon" Icon="@Icons.Material.Outlined.List" Label="@Loc["WikiBrowseAllCategories"]" Href="@WikiLocaleLinks.WithLocale("/wiki/collections/" + Uri.EscapeDataString(navigation.Collection), _locale)" Collapsed="@Collapsed" />
        </SidebarGroup>
    }
    <SidebarSpacer />
    <AuthorizeView Policy="wiki.create">
        <Authorized>
            @* The title form has no room in the strip, so the strip's button goes straight to a new page's
               editor, as the wiki home's own "New page" does; toggling the form here showed nothing. *@
            @if (Collapsed)
            {
                <SidebarRow Lead="SidebarRow.SidebarLead.Icon" Icon="@Icons.Material.Outlined.Add" Label="@Loc["NavWikiNewPage"]" Href="@NewPageHref" Collapsed="true" />
            }
            else if (_newOpen)
            {
                <form class="wiki-side-new-form" @onsubmit="CreatePage" @onsubmit:preventDefault>
                    <input type="text" placeholder="@Loc["NavWikiNewPageTitle"]" aria-label="@Loc["NavWikiNewPageTitle"]" value="@_newTitle" @oninput="@(e => _newTitle = e.Value?.ToString() ?? string.Empty)" />
                    <CapsuleButton Primary="true" Icon="@Icons.Material.Outlined.Add" AriaLabel="@Loc["NavWikiNewPage"]" OnClick="CreatePage" />
                </form>
            }
            else
            {
                <button type="button" class="wiki-side-new" @onclick="@(() => _newOpen = true)">
                    <MudIcon Icon="@Icons.Material.Outlined.Add" Size="Size.Small" /> @Loc["NavWikiNewPage"]
                </button>
            }
        </Authorized>
    </AuthorizeView>
</SidebarPanel>

@code {
    [Parameter] public bool Collapsed { get; set; }

    private WikiNavigationDto? _navigation;
    private bool _failed;
    private int _loadVersion;
    private bool _disposed;
    private string _path = "/wiki";
    private string? _category;
    private string? _locale;
    private string CollectionTitle => _navigation is { } navigation
        ? navigation.Collection == "all" ? Loc["WikiAllCollections"]
            : navigation.Collections.FirstOrDefault(row => row.Id == navigation.Collection)?.Name ?? Loc["WikiGameCollection"]
        : Loc["WikiGameCollection"];
    private bool _newOpen;
    private string NewPageHref => WikiLocaleLinks.WithLocale("/wiki/main/new-page/edit", _locale);
    private string _newTitle = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        Locate();
        await LoadNavigationAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        Locate();
        _ = InvokeAsync(async () => { await LoadNavigationAsync(); if (!_disposed) StateHasChanged(); });
    }

    private async Task LoadNavigationAsync()
    {
        var version = ++_loadVersion;
        string? collection = null;
        string? page = null;
        if (_path.StartsWith("/wiki/collections/", StringComparison.Ordinal))
            collection = Uri.UnescapeDataString(_path["/wiki/collections/".Length..]);
        else if (_path.StartsWith("/wiki/", StringComparison.Ordinal) && _path[6..].Split('/').Length == 2)
            page = _path[6..];
        var result = await Wiki.GetNavigationAsync(collection, page, lang: _locale);
        if (_disposed || version != _loadVersion) return;
        _navigation = result is WikiNavigationDto navigation ? navigation : null;
        _failed = _navigation is null;
    }

    private void Locate()
    {
        var path = "/" + Nav.ToBaseRelativePath(Nav.Uri);
        _category = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query)["category"];
        _locale = WikiLocaleLinks.FromUri(Nav.Uri);
        var cut = path.IndexOfAny(['?', '#']);
        _path = (cut >= 0 ? path[..cut] : path).TrimEnd('/');
        if (_path.Length == 0) _path = "/";
        if (_path.StartsWith("/wiki/category/", StringComparison.Ordinal))
            _category = WikiCategories.Key(Uri.UnescapeDataString(_path["/wiki/category/".Length..]));
    }

    private void Search(string term)
    {
        Nav.NavigateTo(WikiLocaleLinks.WithLocale(term.Length == 0 ? "/wiki" : $"/wiki?q={Uri.EscapeDataString(term)}", _locale));
    }

    private void CreatePage()
    {
        var title = _newTitle.Trim();
        if (title.Length == 0) return;
        _newOpen = false;
        _newTitle = string.Empty;
        Nav.NavigateTo(WikiLocaleLinks.WithLocale($"/wiki/main/{Uri.EscapeDataString(WikiHelpers.Slugify(title))}/edit?title={Uri.EscapeDataString(title)}", _locale));
    }

    public void Dispose() { _disposed = true; ++_loadVersion; Nav.LocationChanged -= OnLocationChanged; }
}
