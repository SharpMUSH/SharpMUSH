@using SharpMUSH.Client.Models
@using SharpMUSH.Client.Models.Wiki
@inject IStringLocalizer<SharedResource> Loc

@* The aside's card of other pages in the page's first category, with a link to all of them. *@
<KitCard Aside="true" Class="wiki-more" Title="@string.Format(Loc["NavWikiMoreIn"], CategoryLabel)">
    <Controls>
        <a class="wiki-more-all" href="@WikiCategories.Route(Category)">@Loc.Plural("NavWikiAllShort", "count", Total)</a>
    </Controls>
    <ChildContent>
    <CardRows>
        @foreach (var sibling in Pages)
        {
            var page2 = sibling;
            <SidebarRow Lead="SidebarRow.SidebarLead.Image" Icon="@Icons.Material.Outlined.Description" ImageUrl="@page2.Image" Name="@page2.Title" Label="@page2.Title"
                        Href="@WikiRoutes.PathFor(page2.Namespace, page2.Slug)" />
        }
    </CardRows>
    </ChildContent>
</KitCard>

@code {
    /// <summary>The category's key, for its route.</summary>
    [Parameter, EditorRequired] public string Category { get; set; } = string.Empty;

    /// <summary>The category's name as the page's language shows it.</summary>
    [Parameter, EditorRequired] public string CategoryLabel { get; set; } = string.Empty;

    [Parameter, EditorRequired] public IReadOnlyList<WikiPageSummary> Pages { get; set; } = [];

    /// <summary>How many pages the category holds, the shown page included.</summary>
    [Parameter] public int Total { get; set; }
}
