@using SharpMUSH.Library.API
@using SharpMUSH.Client.Models
@using SharpMUSH.Client.Models.Wiki
@using SharpMUSH.Library.Services
@inject NavigationManager Nav
@inject WikiService Wiki
@inject IStringLocalizer<SharedResource> Loc
@implements IDisposable

@* A category's members, under its page (MediaWiki's category listing): its subcategories — the category
   pages that are themselves in this category — as links, then the pages as image tiles with draft and
   locked tags where the home cards show them. *@
<div class="wiki-cat">
    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Style="height:2px;" />
    }
    else if (_failed)
    {
        <div role="alert">@Loc["WikiLoadFailed"]</div>
    }
    else if (_pages.Count == 0 && _subcategories.Count == 0)
    {
        <EmptyState Class="wiki-cat-empty">@Loc["NavWikiCategoryEmpty"]</EmptyState>
    }
    else
    {
        @if (_subcategories.Count > 0)
        {
            <SectionLabel>@Loc.Plural("NavWikiSubcategories", "count", _subcategories.Count)</SectionLabel>
            <nav class="wiki-cat-subs">
                @foreach (var sub in _subcategories)
                {
                    <a class="wiki-catlink" href="@WikiLocaleLinks.WithLocale(WikiCategories.Route(sub.Slug), EffectiveLocale)">@(string.IsNullOrEmpty(sub.Title) ? WikiHelpers.CategoryLabel(sub.Slug) : sub.Title)</a>
                }
            </nav>
        }
        @if (_pages.Count > 0)
        {
            <SectionLabel>@Loc.Plural("NavWikiCategoryPages", "count", _pages.Count)</SectionLabel>
            <div class="wiki-cat-grid">
                @foreach (var p in _pages)
                {
                    <ImageTile Label="@p.Title" ImageUrl="@p.Image" Height="76" Href="@WikiLocaleLinks.WithLocale(WikiRoutes.PathFor(p.Namespace, p.Slug), EffectiveLocale)"
                               Sub="@(p.LastEditedBy is null ? Loc.Format(p.UpdatedAt) : string.Format(Loc["NavWikiEditedBy"], p.LastEditedBy, Loc.Format(p.UpdatedAt)))">
                        <Overlay>
                            @if (!p.Published)
                            {
                                <Pill Tag="true" Warn="true" Class="wiki-cat-tag wiki-cat-tag--draft">@Loc["NavWikiDraft"]</Pill>
                            }
                            @if (p.IsRestricted)
                            {
                                <Pill Tag="true" Class="wiki-cat-tag wiki-cat-tag--locked">@Loc["NavWikiLocked"]</Pill>
                            }
                        </Overlay>
                    </ImageTile>
                }
            </div>
        }
    }
</div>

@code {
    /// <summary>The category, as its key or its name.</summary>
    [Parameter, EditorRequired] public string Category { get; set; } = string.Empty;

    [Parameter] public string? Locale { get; set; }
    private string? EffectiveLocale => Locale ?? WikiLocaleLinks.FromUri(Nav.Uri);

    private bool _loading = true;
    private bool _failed;
    private bool _disposed;
    private int _version;
    private IReadOnlyList<WikiPageSummary> _pages = [];
    private IReadOnlyList<WikiPageSummary> _subcategories = [];
    private string? _loadedCategory;

    protected override async Task OnParametersSetAsync()
    {
        var key = WikiCategories.Key(Category);
        var selection = key + "\n" + EffectiveLocale;
        if (selection == _loadedCategory) return;
        _loadedCategory = selection;
        _loading = true;
        _failed = false;
        var version = ++_version;
        try
        {
            if (await Wiki.GetNavigationAsync(page: "category/" + key, lang: EffectiveLocale) is not WikiNavigationDto navigation)
            {
                if (!_disposed && version == _version) _failed = true;
                return;
            }
            var members = new List<WikiPageSummary>();
            for (var skip = 0; ; skip += 200)
            {
                if (await Wiki.GetCollectionPagesAsync(navigation.Collection, skip, 200, category: key, lang: EffectiveLocale) is not WikiPageBatch batch)
                {
                    if (!_disposed && version == _version) _failed = true;
                    return;
                }
                if (_disposed || version != _version) return;
                members.AddRange(batch.Pages);
                if (skip + batch.Pages.Count >= batch.Total || batch.Pages.Count == 0) break;
            }
            _subcategories = members.Where(WikiCategories.IsCategoryPage)
                .OrderBy(p => p.Slug, StringComparer.Ordinal)
                .ToList();
            _pages = members.Where(p => !WikiCategories.IsCategoryPage(p))
                .OrderByDescending(p => p.UpdatedAt)
                .ToList();
        }
        finally
        {
            if (!_disposed && version == _version) _loading = false;
        }
    }
    public void Dispose() { _disposed = true; ++_version; }
}
