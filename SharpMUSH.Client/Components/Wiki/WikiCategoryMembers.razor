@using SharpMUSH.Library.API
@using SharpMUSH.Client.Models
@using SharpMUSH.Client.Models.Wiki
@using SharpMUSH.Library.Services
@inject NavigationManager Nav
@inject WikiService Wiki
@inject IAccountAuthState AccountAuth
@inject IStringLocalizer<SharedResource> Loc
@implements IDisposable

@* One authorized, title-ordered page of members. Scope and the reader's return destination are independent. *@
<div class="wiki-cat">
    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Style="height:2px;" />
    }
    else if (_failed)
    {
        <div role="alert">@Loc["WikiLoadFailed"] <button type="button" @onclick="ReloadAsync">@Loc["NavWikiBrowse"]</button></div>
    }
    else if (_batch is { } batch)
    {
        <SectionLabel>@Loc["NavWikiBrowse"] · @_collectionLabel</SectionLabel>
        <p class="wiki-cat-range" aria-live="polite" tabindex="-1" @ref="_range">@string.Format(Loc["WikiPageRange"], batch.Total == 0 ? 0 : _skip + 1, Math.Min((long)_skip + batch.Pages.Count, batch.Total), batch.Total)</p>
        @Pager
        @if (batch.Total == 0)
        {
            <EmptyState Class="wiki-cat-empty">@Loc["NavWikiCategoryEmpty"]</EmptyState>
        }
        <div class="wiki-cat-grid">
            @foreach (var entry in batch.Pages)
            {
                <ImageTile Label="@entry.Title" ImageUrl="@entry.Image" ShowPlaceholder="false" Height="76" Href="@MemberHref(entry)"
                           Sub="@(entry.LastEditedBy is null ? Loc.Format(entry.UpdatedAt) : string.Format(Loc["NavWikiEditedBy"], entry.LastEditedBy, Loc.Format(entry.UpdatedAt)))">
                    <Overlay>
                        @if (WikiCategories.IsCategoryPage(entry))
                        {
                            <Pill Tag="true" Class="wiki-cat-tag">@Loc["NavWikiCategoryKicker"]</Pill>
                        }
                        @if (!entry.Published)
                        {
                            <Pill Tag="true" Warn="true" Class="wiki-cat-tag wiki-cat-tag--draft">@Loc["NavWikiDraft"]</Pill>
                        }
                        @if (entry.IsRestricted)
                        {
                            <Pill Tag="true" Class="wiki-cat-tag wiki-cat-tag--locked">@Loc["NavWikiLocked"]</Pill>
                        }
                    </Overlay>
                </ImageTile>
            }
        </div>
        @Pager
    }
</div>

@code {
    [Parameter, EditorRequired] public string Category { get; set; } = string.Empty;
    [Parameter] public string? Locale { get; set; }
    [Parameter] public string? MembersCollection { get; set; }
    [Parameter] public int MembersSkip { get; set; }
    [Parameter] public WikiBrowseState? BrowseState { get; set; }
    /// <summary>Show members without links while the reader's return origin is still being checked.</summary>
    [Parameter] public bool HoldLinks { get; set; }
    private string? EffectiveLocale => Locale ?? WikiLocaleLinks.FromUri(Nav.Uri);
    private (string Category, string? Collection, string? Locale, int Skip, string? After, string? Before)? _loaded;
    private bool _loading = true;
    private bool _failed;
    private bool _disposed;
    private int _version;
    private int _skip;
    // The server's token for where the page starts; the URL carries it as membersAfter or membersBefore.
    private string? _after;
    private string? _before;
    private WikiPageBatch? _batch;
    private string? _collectionLabel;
    private ElementReference _range;
    private bool _focusRange;

    protected override void OnInitialized()
    {
        AccountAuth.AuthStateChanged += OnReaderChanged;
        AccountAuth.ActiveCharacterChanged += OnReaderChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        var query = WikiBrowseState.ReadQuery(Nav.Uri);
        var position = new WikiBrowseState("game", Skip: MembersSkip, After: query.GetValueOrDefault("membersAfter"),
            Before: query.GetValueOrDefault("membersBefore")).Normalize();
        var selection = (WikiCategories.Key(Category), string.IsNullOrWhiteSpace(MembersCollection) ? null : MembersCollection.Trim(), EffectiveLocale,
            position.Skip, position.After, position.Before);
        if (_loaded == selection) return;
        _loaded = selection;
        (_skip, _after, _before) = (position.Skip, position.After, position.Before);
        await ReloadAsync();
    }

    private void OnReaderChanged()
    {
        if (_disposed) return;
        Interlocked.Increment(ref _version);
        Clear();
        _ = InvokeAsync(async () =>
        {
            if (_disposed) return;
            StateHasChanged();
            await ReloadAsync();
            if (!_disposed) StateHasChanged();
        });
    }

    private void Clear()
    {
        _loading = true;
        _failed = false;
        _batch = null;
        _collectionLabel = null;
    }

    private async Task ReloadAsync()
    {
        if (_disposed || _loaded is not { } selection) return;
        var version = Interlocked.Increment(ref _version);
        var requestedUri = Nav.Uri;
        var offset = _skip;
        var (after, before) = (_after, _before);
        Clear();
        var navigationResult = selection.Collection is { } scope
            ? await Wiki.GetNavigationAsync(collection: scope, lang: selection.Locale)
            : await Wiki.GetNavigationAsync(page: "category/" + selection.Category, lang: selection.Locale);
        if (_disposed || version != _version) return;
        // A missing/refused owner may still have public game members. An outage is not evidence of a different owner.
        // Explicit scopes are never replaced, and an expired session or failed response remains retryable.
        if (selection.Collection is null && navigationResult is ApiFailure { Kind: ApiFailureKind.NotFound or ApiFailureKind.Forbidden })
        {
            navigationResult = await Wiki.GetNavigationAsync(collection: "game", lang: selection.Locale);
            if (_disposed || version != _version) return;
        }
        if (navigationResult is not WikiNavigationDto navigation || (selection.Collection is not null && navigation.Collection != selection.Collection))
        {
            _loading = false;
            _failed = true;
            return;
        }
        var result = await Wiki.GetCollectionPagesAsync(navigation.Collection, offset, WikiBrowseState.PageSize, selection.Category,
            lang: selection.Locale, after: after, before: before);
        if (_disposed || version != _version) return;
        // Read back to the start, the page is the first whatever offset the link said.
        if (result is WikiPageBatch { Previous: null } started && before is not null && started.Pages.Count > 0)
            (offset, before) = (0, null);
        if (result is WikiPageBatch changed && changed.Total > 0 && (offset >= changed.Total || changed.Pages.Count == 0 && after is not null))
        {
            offset = Math.Min(offset, ((changed.Total - 1) / WikiBrowseState.PageSize) * WikiBrowseState.PageSize);
            (after, before) = (null, null);
            result = await Wiki.GetCollectionPagesAsync(navigation.Collection, offset, WikiBrowseState.PageSize, selection.Category, lang: selection.Locale);
            if (_disposed || version != _version) return;
        }
        if (result is not WikiPageBatch batch)
        {
            _loading = false;
            _failed = true;
            return;
        }
        if (batch.Total == 0) offset = 0;
        // At most one corrective request: a second shrink is retryable, never a fabricated range.
        if (batch.Total > 0 && batch.Pages.Count == 0)
        {
            if (offset >= batch.Total) offset = ((batch.Total - 1) / WikiBrowseState.PageSize) * WikiBrowseState.PageSize;
            _failed = true;
        }
        else
        {
            _batch = batch;
            _collectionLabel = navigation.Collection == "game" ? Loc["WikiGameCollection"] : navigation.Collection == "all" ? Loc["WikiAllCollections"]
                : navigation.Collections.FirstOrDefault(collection => collection.Id == navigation.Collection)?.Name ?? Loc["WikiCollections"];
        }
        (_skip, _after, _before) = (offset, after, before);
        _loaded = (selection.Category, selection.Collection, selection.Locale, offset, after, before);
        _loading = false;
        // Canonical replacement must reuse this response and must never erase a newer route.
        if (requestedUri == Nav.Uri && new Uri(requestedUri).AbsolutePath == WikiCategories.Route(selection.Category))
        {
            var target = PageHref(offset, after, before);
            if (new Uri(requestedUri).PathAndQuery + new Uri(requestedUri).Fragment != target) Nav.NavigateTo(target, replace: true);
        }
    }

    private string? MemberHref(WikiPageSummary page) => HoldLinks ? null : WikiJourneyLinks.Page(page.Namespace, page.Slug, BrowseState,
        MembersCollection, _skip, EffectiveLocale);

    private string PageHref(int offset, string? after, string? before)
    {
        var current = new Uri(Nav.Uri);
        var query = WikiBrowseState.ReadQuery(Nav.Uri);
        query.Remove("membersSkip");
        query.Remove("membersAfter");
        query.Remove("membersBefore");
        if (offset > 0) query["membersSkip"] = offset.ToString(System.Globalization.CultureInfo.InvariantCulture);
        if (offset > 0 && after is not null) query["membersAfter"] = after;
        else if (offset > 0 && before is not null) query["membersBefore"] = before;
        return current.AbsolutePath + (query.Count == 0 ? string.Empty : "?" + string.Join('&', query.Select(pair => Uri.EscapeDataString(pair.Key) + "=" + Uri.EscapeDataString(pair.Value)))) + current.Fragment;
    }

    // The same controls before and after the tiles keep paging reachable without crossing fifty links.
    private RenderFragment Pager => __builder =>
    {
        @if (_batch is { } batch)
        {
            <nav class="wiki-cat-paging" aria-label="@Loc["WikiBrowseMembers"]">
                <button type="button" disabled="@(_skip == 0)" @onclick="PreviousAsync">@Loc["WikiPreviousPage"]</button>
                <button type="button" disabled="@((long)_skip + batch.Pages.Count >= batch.Total)" @onclick="NextAsync">@Loc["WikiNextPage"]</button>
            </nav>
        }
    };

    private Task PreviousAsync() => NavigateAsync(new WikiBrowseState("game", Skip: _skip).Previous(_batch?.Previous));

    private Task NextAsync() => NavigateAsync(new WikiBrowseState("game", Skip: _skip).Next(_batch?.Next));

    private async Task NavigateAsync(WikiBrowseState position)
    {
        if (_loaded is not { } selection || _disposed) return;
        (_skip, _after, _before) = (position.Skip, position.After, position.Before);
        _loaded = (selection.Category, selection.Collection, selection.Locale, position.Skip, position.After, position.Before);
        _focusRange = true;
        Nav.NavigateTo(PageHref(position.Skip, position.After, position.Before));
        await ReloadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusRange && !_loading && _batch is not null)
        {
            _focusRange = false;
            await _range.FocusAsync();
        }
    }

    public void Dispose()
    {
        _disposed = true;
        Interlocked.Increment(ref _version);
        AccountAuth.AuthStateChanged -= OnReaderChanged;
        AccountAuth.ActiveCharacterChanged -= OnReaderChanged;
    }
}
