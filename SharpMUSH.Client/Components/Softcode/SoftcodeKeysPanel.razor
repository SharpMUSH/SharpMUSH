@inject IStringLocalizer<SharedResource> Loc

@* The open attribute's read and write keys, under the editor: a key lets whoever passes it read or set
   this one attribute without controlling the object. Each field is a lock key; an empty field clears it. *@
<section class="sc-keys" aria-label="@Loc["TermAttributeKeys"]">
    <div class="sc-keys-head">
        <span class="sc-keys-title">@Loc["TermAttributeKeys"]</span>
        <span class="sc-keys-hint">@Loc["TermAttributeKeysHint"]</span>
    </div>
    <div class="sc-keys-fields">
        <label class="sc-keys-field">
            <span class="sc-keys-label">@Loc["TermReadKey"]</span>
            <input name="read-key" class="sc-keys-input" value="@_read" spellcheck="false" placeholder="role^builder" disabled="@Applying"
                   @oninput="e => _read = e.Value?.ToString() ?? string.Empty" />
        </label>
        <label class="sc-keys-field">
            <span class="sc-keys-label">@Loc["TermWriteKey"]</span>
            <input name="write-key" class="sc-keys-input" value="@_write" spellcheck="false" placeholder="role^xpclerk" disabled="@Applying"
                   @oninput="e => _write = e.Value?.ToString() ?? string.Empty" />
        </label>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="sc-keys-apply"
                   Disabled="@(Applying || !Changed)" OnClick="ApplyAsync">@Loc["TermApplyKeys"]</MudButton>
    </div>
</section>

@code {
    /// <summary>The attribute whose keys these are; its keys fill the fields whenever it changes.</summary>
    [Parameter, EditorRequired] public MushAttribute Attribute { get; set; } = null!;

    /// <summary>A save is out; the fields and the button wait for it, so a draft typed meanwhile is never overwritten.</summary>
    [Parameter] public bool Applying { get; set; }

    /// <summary>Saves the keys that changed: the read key (or null when unchanged), then the write key.</summary>
    [Parameter] public EventCallback<(string? Read, string? Write)> OnApply { get; set; }

    // What the fields were last filled from. A different attribute refills both; a new stored key (a save, a refresh)
    // refills only a field the reader has not edited since, or one this panel just sent.
    private MushAttribute? _shownAttribute;
    private string? _shownRead;
    private string? _shownWrite;
    private bool _sentRead;
    private bool _sentWrite;
    private string _read = string.Empty;
    private string _write = string.Empty;

    private bool Changed => _read != (Attribute.ReadKey ?? string.Empty) || _write != (Attribute.WriteKey ?? string.Empty);

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_shownAttribute, Attribute))
        {
            _shownAttribute = Attribute;
            _sentRead = _sentWrite = false;
            (_shownRead, _read) = (Attribute.ReadKey, Attribute.ReadKey ?? string.Empty);
            (_shownWrite, _write) = (Attribute.WriteKey, Attribute.WriteKey ?? string.Empty);
            return;
        }

        if (_shownRead != Attribute.ReadKey)
        {
            if (_sentRead || _read == (_shownRead ?? string.Empty)) _read = Attribute.ReadKey ?? string.Empty;
            (_shownRead, _sentRead) = (Attribute.ReadKey, false);
        }

        if (_shownWrite != Attribute.WriteKey)
        {
            if (_sentWrite || _write == (_shownWrite ?? string.Empty)) _write = Attribute.WriteKey ?? string.Empty;
            (_shownWrite, _sentWrite) = (Attribute.WriteKey, false);
        }
    }

    private Task ApplyAsync()
    {
        var read = _read != (Attribute.ReadKey ?? string.Empty) ? _read.Trim() : null;
        var write = _write != (Attribute.WriteKey ?? string.Empty) ? _write.Trim() : null;
        (_sentRead, _sentWrite) = (read is not null, write is not null);
        return OnApply.InvokeAsync((read, write));
    }
}
