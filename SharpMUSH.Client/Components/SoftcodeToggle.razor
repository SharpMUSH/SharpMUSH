@using SharpMUSH.Client.Services
@inject IStringLocalizer<SharedResource> Loc
@implements IDisposable

@* How one FormattedInput's draft is sent, as a two-part switch beside the field: Text (sent as shown) and
   Softcode (sent as typed). Both parts are always there and the chosen one is highlighted, as the type chips
   are. A text draft that looks like softcode (ComposerDraft.SoftcodeLookalike) puts a dot on Softcode, and
   its tooltip names what was found. A field that is always softcode (a command line) has Softcode chosen and
   Text unavailable. *@
<div class="@Class st" role="radiogroup" aria-label="@Loc["NavComposeSendAs"]">
    <button type="button" role="radio" class="st-part @(Draft.Raw ? null : "st-part--on")"
            aria-checked="@(Draft.Raw ? "false" : "true")" aria-disabled="@(AlwaysRaw ? "true" : null)"
            title="@(AlwaysRaw ? Loc["NavPlayComposerRawCommand"] : Loc["NavPlayComposerRawOff"])"
            @onmousedown:preventDefault @onclick="() => SetAsync(false)">
        <MudIcon Icon="@Icons.Material.Outlined.TextFields" Size="Size.Small" />
        <span class="st-label">@Loc["NavComposeText"]</span>
    </button>
    <button type="button" role="radio" class="st-part @(Draft.Raw ? "st-part--on" : null) @(Lookalike is null ? null : "st-part--hint")"
            aria-checked="@(Draft.Raw ? "true" : "false")"
            title="@(Lookalike is { } found ? Loc["NavPlayComposerRawLookalike", found] : Loc["NavPlayComposerRawOn"])"
            @onmousedown:preventDefault @onclick="() => SetAsync(true)">
        <MudIcon Icon="@Icons.Material.Outlined.Code" Size="Size.Small" />
        <span class="st-label">@Loc["NavComposeSoftcode"]</span>
    </button>
</div>

@code {
    /// <summary>The draft whose mode this shows and switches.</summary>
    [Parameter, EditorRequired] public ComposerDraft Draft { get; set; } = null!;

    /// <summary>Classes for the wrapper.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>The field is always softcode (a command line): Softcode is chosen and Text does nothing.</summary>
    [Parameter] public bool AlwaysRaw { get; set; }

    /// <summary>Switches the owner's field to softcode (true) or text (false).</summary>
    [Parameter] public EventCallback<bool> OnRawChanged { get; set; }

    private ComposerDraft? _subscribed;

    private string? Lookalike => AlwaysRaw ? null : Draft.SoftcodeLookalike;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_subscribed, Draft)) return;
        if (_subscribed is not null) _subscribed.Changed -= OnDraftChanged;
        _subscribed = Draft;
        Draft.Changed += OnDraftChanged;
    }

    private void OnDraftChanged() => InvokeAsync(StateHasChanged);

    private Task SetAsync(bool raw) => AlwaysRaw || raw == Draft.Raw ? Task.CompletedTask : OnRawChanged.InvokeAsync(raw);

    public void Dispose()
    {
        if (_subscribed is not null) _subscribed.Changed -= OnDraftChanged;
    }
}
