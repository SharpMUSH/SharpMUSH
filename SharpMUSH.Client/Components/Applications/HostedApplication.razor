@using System.Net.Http.Json
@using System.Text.Json
@using SharpMUSH.Library.API
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IHttpClientFactory HttpClients
@inject IJSRuntime JS
@inject ILogger<HostedApplication> Logger

@if (_error is not null)
{
    <div role="alert">@_error</div>
}
else
{
    <iframe id="@_frameId" title="@Title" sandbox="allow-scripts" style="width:100%;height:70vh;border:0;" />
}

@code {
    [Parameter, EditorRequired] public string Slug { get; set; } = string.Empty;
    [Parameter] public string Title { get; set; } = "Application";
    private readonly string _frameId = "hosted-" + Guid.NewGuid().ToString("N");
    private readonly CancellationTokenSource _lifetime = new();
    private JsonElement? _bootstrap;
    private string? _error;
    private IJSObjectReference? _module;
    private IJSObjectReference? _mount;
    private DotNetObjectReference<HostedApplication>? _reference;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var http = HttpClients.CreateClient("api");
            var bootstrap = await http.GetFromJsonAsync<JsonElement>($"api/applications/{Uri.EscapeDataString(Slug)}/host", _lifetime.Token);
            // The API base can differ from the portal origin. Use its existing client configuration.
            var payload = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(bootstrap.GetRawText())!;
            var entryUrl = new Uri(http.BaseAddress!, bootstrap.GetProperty("entryUrl").GetString()!);
            payload["entryUrl"] = JsonSerializer.SerializeToElement(entryUrl.AbsoluteUri);
            using var entryResponse = await http.GetAsync(entryUrl, _lifetime.Token);
            entryResponse.EnsureSuccessStatusCode();
            payload["html"] = JsonSerializer.SerializeToElement(await entryResponse.Content.ReadAsStringAsync(_lifetime.Token));
            _bootstrap = JsonSerializer.SerializeToElement(payload);
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or OperationCanceledException)
        {
            if (!_lifetime.IsCancellationRequested) _error = "Application configuration is unavailable or needs updating.";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_bootstrap is not { } bootstrap || _mount is not null || _error is not null) return;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/hosted-app.mjs");
            _reference = DotNetObjectReference.Create(this);
            _mount = await _module.InvokeAsync<IJSObjectReference>("mount", _frameId, bootstrap, _reference);
        }
        catch (JSException)
        {
            _error = "Application host could not load.";
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task<TopologyDto?> ReadTopology(int[] rooms, string[]? coordinates = null)
        => await HttpClients.CreateClient("api").GetFromJsonAsync<TopologyDto>("api/objects/topology?" + Selection(rooms, coordinates), _lifetime.Token);

    /// <summary>The selected rooms as a room document, or the server's reason for refusing one.</summary>
    [JSInvokable]
    public async Task<RoomDocumentResult> ReadRoomDocument(int[] rooms, string[]? coordinates = null)
    {
        using var response = await HttpClients.CreateClient("api").GetAsync("api/objects/topology/document?" + Selection(rooms, coordinates), _lifetime.Token);
        if (response.IsSuccessStatusCode)
            return new(await response.Content.ReadFromJsonAsync<RoomDocumentDto>(_lifetime.Token), null);
        var error = response.Content.Headers.ContentType?.MediaType == "application/json"
            ? (await response.Content.ReadFromJsonAsync<ApiErrorDto>(_lifetime.Token))?.Error
            : null;
        return new(null, error ?? "The rooms could not be exported with the current character.");
    }

    public sealed record RoomDocumentResult(RoomDocumentDto? Document, string? Error);

    private static string Selection(int[] rooms, string[]? coordinates)
    {
        if (rooms.Length is < 1 or > 100 || rooms.Any(id => id < 0)) throw new ArgumentException("Invalid room selection.");
        if (coordinates is not null && coordinates.Length != 3) throw new ArgumentException("Name three coordinate attributes.");
        return string.Join("&", rooms.Select(id => "rooms=" + id.ToString(System.Globalization.CultureInfo.InvariantCulture))
            .Concat((coordinates ?? []).Select(name => "coordinates=" + Uri.EscapeDataString(name))));
    }

    public async ValueTask DisposeAsync()
    {
        await _lifetime.CancelAsync();
        try
        {
            if (_mount is not null) { await _mount.InvokeVoidAsync("dispose"); await _mount.DisposeAsync(); }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException ex)
        {
            // A departing browser has no JS runtime left to release. Managed references still need cleanup.
            Logger.LogDebug(ex, "Hosted application JS runtime disconnected during disposal.");
        }
        finally
        {
            _reference?.Dispose();
            _lifetime.Dispose();
        }
    }
}
