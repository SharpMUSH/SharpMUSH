@using System.Net.Http.Json
@using System.Text.Json
@using SharpMUSH.Library.API
@using SharpMUSH.Library.Models.Portal
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IHttpClientFactory HttpClients
@inject IJSRuntime JS
@inject ILogger<HostedApplication> Logger
@inject ConnectedAppsService Apps
@inject IStringLocalizer<SharedResource> Loc

@if (_error is not null)
{
    <div role="alert">@_error</div>
}
else
{
    @if (_confirming is { } plan)
    {
        @* The host's own confirmation: the package cannot draw over it, skip it or change what it lists. *@
        <MudPaper Outlined="true" Class="pa-4 mb-3" role="dialog" aria-labelledby="@(_frameId + "-confirm")">
            <MudText Typo="Typo.h6" id="@(_frameId + "-confirm")">@Title asks to change the world</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">Each change is made as your character, through the game's own building commands.</MudText>
            <ul class="mb-2" style="padding-inline-start:1.5rem;">
                @foreach (var step in plan.Steps)
                {
                    <li>@step.Summary</li>
                }
            </ul>
            @foreach (var note in plan.Notes)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">@note</MudText>
            }
            <div class="d-flex gap-2 mt-3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Decide(true))">Make @plan.Steps.Count @(plan.Steps.Count == 1 ? "change" : "changes")</MudButton>
                <MudButton Variant="Variant.Text" OnClick="@(() => Decide(false))">Cancel</MudButton>
            </div>
        </MudPaper>
    }
    @if (_consent is { } consent)
    {
        @* The host asks, not the package: the frame cannot draw over this, answer it or see the token it leads to. *@
        <MudPaper Outlined="true" Class="pa-4 mb-3" role="dialog" aria-labelledby="@(_frameId + "-consent")">
            <MudText Typo="Typo.h6" id="@(_frameId + "-consent")">@Loc["OAuthConsentAsks", consent.App.Name]</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">@Loc["OAuthConsentCharacter", consent.Character]</MudText>
            <ul class="mb-2" style="padding-inline-start:1.5rem;">
                @foreach (var scope in OAuthScopeText.Shown(consent.Scopes))
                {
                    <li><strong>@OAuthScopeText.Name(Loc, scope, _scopeViews)</strong> @OAuthScopeText.Detail(Loc, scope, _scopeViews)</li>
                }
            </ul>
            <MudText Typo="Typo.body2">@Loc["OAuthConsentRevoke"]</MudText>
            <div class="d-flex gap-2 mt-3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Answer(true))">@Loc["OAuthConsentAllow"]</MudButton>
                <MudButton Variant="Variant.Text" OnClick="@(() => Answer(false))">@Loc["OAuthConsentDeny"]</MudButton>
            </div>
        </MudPaper>
    }
    <iframe id="@_frameId" title="@Title" sandbox="allow-scripts" style="width:100%;height:70vh;border:0;" />
}

@code {
    [Parameter, EditorRequired] public string Slug { get; set; } = string.Empty;
    [Parameter] public string Title { get; set; } = "Application";
    private readonly string _frameId = "hosted-" + Guid.NewGuid().ToString("N");
    private readonly CancellationTokenSource _lifetime = new();
    private JsonElement? _bootstrap;
    private string? _error;
    private IJSObjectReference? _module;
    private IJSObjectReference? _mount;
    private DotNetObjectReference<HostedApplication>? _reference;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var http = HttpClients.CreateClient("api");
            var bootstrap = await http.GetFromJsonAsync<JsonElement>($"api/applications/{Uri.EscapeDataString(Slug)}/host", _lifetime.Token);
            // The API base can differ from the portal origin. Use its existing client configuration.
            var payload = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(bootstrap.GetRawText())!;
            var entryUrl = new Uri(http.BaseAddress!, bootstrap.GetProperty("entryUrl").GetString()!);
            payload["entryUrl"] = JsonSerializer.SerializeToElement(entryUrl.AbsoluteUri);
            using var entryResponse = await http.GetAsync(entryUrl, _lifetime.Token);
            entryResponse.EnsureSuccessStatusCode();
            payload["html"] = JsonSerializer.SerializeToElement(await entryResponse.Content.ReadAsStringAsync(_lifetime.Token));
            _bootstrap = JsonSerializer.SerializeToElement(payload);
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or OperationCanceledException)
        {
            if (!_lifetime.IsCancellationRequested) _error = "Application configuration is unavailable or needs updating.";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_bootstrap is not { } bootstrap || _mount is not null || _error is not null) return;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/hosted-app.mjs");
            _reference = DotNetObjectReference.Create(this);
            _mount = await _module.InvokeAsync<IJSObjectReference>("mount", _frameId, bootstrap, _reference);
        }
        catch (JSException)
        {
            _error = "Application host could not load.";
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task<TopologyDto?> ReadTopology(int[] rooms, string[]? coordinates = null)
        => await HttpClients.CreateClient("api").GetFromJsonAsync<TopologyDto>("api/objects/topology?" + Selection(rooms, coordinates), _lifetime.Token);

    /// <summary>The selected rooms as a room document, or the server's reason for refusing one.</summary>
    [JSInvokable]
    public async Task<RoomDocumentResult> ReadRoomDocument(int[] rooms, string[]? coordinates = null)
    {
        using var response = await HttpClients.CreateClient("api").GetAsync("api/objects/topology/document?" + Selection(rooms, coordinates), _lifetime.Token);
        if (response.IsSuccessStatusCode)
            return new(await response.Content.ReadFromJsonAsync<RoomDocumentDto>(_lifetime.Token), null);
        var error = response.Content.Headers.ContentType?.MediaType == "application/json"
            ? (await response.Content.ReadFromJsonAsync<ApiErrorDto>(_lifetime.Token))?.Error
            : null;
        return new(null, error ?? "The rooms could not be exported with the current character.");
    }

    public sealed record RoomDocumentResult(RoomDocumentDto? Document, string? Error);

    private RoomPlanDto? _confirming;
    private TaskCompletionSource<bool>? _decision;

    /// <summary>What importing a room document would change.</summary>
    [JSInvokable]
    public async Task<RoomPlanDto?> PlanRoomDocument(JsonElement document)
    {
        using var response = await HttpClients.CreateClient("api").PostAsJsonAsync("api/objects/topology/plan", document, _lifetime.Token);
        response.EnsureSuccessStatusCode();
        return await response.Content.ReadFromJsonAsync<RoomPlanDto>(_lifetime.Token);
    }

    /// <summary>
    /// Imports a room document once the player has confirmed, in this component and not in the package's frame, the
    /// changes the server worked out. The server refuses the apply when the changes it works out then are different.
    /// </summary>
    [JSInvokable]
    public async Task<RoomImportResult> ApplyRoomDocument(JsonElement document)
    {
        if (_decision is not null) return new(null, null, "Another change is waiting to be confirmed.", false);
        var plan = await PlanRoomDocument(document);
        if (plan is null || plan.Problems.Count > 0 || plan.Steps.Count == 0) return new(plan, null, null, false);
        _confirming = plan;
        _decision = new(TaskCreationOptions.RunContinuationsAsynchronously);
        await InvokeAsync(StateHasChanged);
        bool confirmed;
        try { confirmed = await _decision.Task.WaitAsync(_lifetime.Token); }
        finally
        {
            _confirming = null;
            _decision = null;
            if (!_lifetime.IsCancellationRequested) await InvokeAsync(StateHasChanged);
        }
        if (!confirmed) return new(plan, null, null, true);
        using var response = await HttpClients.CreateClient("api").PostAsJsonAsync("api/objects/topology/apply",
            new { document, fingerprint = plan.Fingerprint }, _lifetime.Token);
        if (response.IsSuccessStatusCode)
            return new(plan, await response.Content.ReadFromJsonAsync<RoomApplyDto>(_lifetime.Token), null, false);
        var error = response.Content.Headers.ContentType?.MediaType == "application/json"
            ? (await response.Content.ReadFromJsonAsync<ApiErrorDto>(_lifetime.Token))?.Error
            : null;
        return new(plan, null, error ?? "The changes could not be made with the current character.", false);
    }

    private void Decide(bool confirmed) => _decision?.TrySetResult(confirmed);

    private OAuthHostedConsent? _consent;
    private IReadOnlyList<OAuthScopeView> _scopeViews = [];
    private TaskCompletionSource<bool>? _consentAnswer;
    private OAuthHostedToken? _token;
    private DateTimeOffset _tokenExpires;

    /// <summary>
    /// Runs one line as the player's character, with a token the player allowed this package and that this component
    /// keeps: the frame sends the line and gets the output, never the token. The first time, the player is asked here.
    /// </summary>
    [JSInvokable]
    public async Task<HostedCommandResult> RunCommand(string command)
    {
        if (await TokenAsync() is not { } token) return new(null, false, _tokenError ?? "The player did not allow it.");
        var result = await SendCommandAsync(token, command);
        if (result is not null) return result;
        // Revoked or expired since: one fresh token, then the answer stands.
        _token = null;
        return await TokenAsync() is { } fresh
            ? await SendCommandAsync(fresh, command) ?? new(null, false, "The game refused the package's access.")
            : new(null, false, _tokenError ?? "The player did not allow it.");
    }

    public sealed record HostedCommandResult(IReadOnlyList<string>? Output, bool Truncated, string? Error);

    private string? _tokenError;

    /// <summary>The package's token, asking the player first when they have not allowed what it asks for; null when refused.</summary>
    private async Task<OAuthHostedToken?> TokenAsync()
    {
        if (_token is { } held && DateTimeOffset.UtcNow < _tokenExpires) return held;
        _tokenError = null;
        var http = HttpClients.CreateClient("api");
        var slug = Uri.EscapeDataString(Slug);
        using (var response = await http.PostAsync($"api/applications/{slug}/token", null, _lifetime.Token))
        {
            if (response.IsSuccessStatusCode) return Keep(await response.Content.ReadFromJsonAsync<OAuthHostedToken>(_lifetime.Token));
            if (response.StatusCode != System.Net.HttpStatusCode.Forbidden
                    || response.Content.Headers.ContentType?.MediaType != "application/json"
                    || await response.Content.ReadFromJsonAsync<OAuthHostedConsent>(_lifetime.Token) is not { App: not null } consent)
            {
                _tokenError = "This package may not run commands.";
                return null;
            }

            if (_consentAnswer is not null) return null;
            _consent = consent;
        }

        if (_scopeViews.Count == 0 && await Apps.ScopesAsync() is List<OAuthScopeView> views) _scopeViews = views;

        _consentAnswer = new(TaskCreationOptions.RunContinuationsAsynchronously);
        await InvokeAsync(StateHasChanged);
        bool allowed;
        try { allowed = await _consentAnswer.Task.WaitAsync(_lifetime.Token); }
        finally
        {
            _consent = null;
            _consentAnswer = null;
            if (!_lifetime.IsCancellationRequested) await InvokeAsync(StateHasChanged);
        }

        if (!allowed) return null;
        using var allow = await http.PostAsync($"api/applications/{slug}/allow", null, _lifetime.Token);
        if (allow.IsSuccessStatusCode) return Keep(await allow.Content.ReadFromJsonAsync<OAuthHostedToken>(_lifetime.Token));
        _tokenError = "The game did not record the answer.";
        return null;
    }

    private OAuthHostedToken? Keep(OAuthHostedToken? token)
    {
        _token = token;
        // A minute early, so a slow request does not reach the server with a token that has just run out.
        _tokenExpires = DateTimeOffset.UtcNow.AddSeconds(Math.Max(0, (token?.ExpiresIn ?? 0) - 60));
        return token;
    }

    /// <summary>The command's answer, or null when the token was refused.</summary>
    private async Task<HostedCommandResult?> SendCommandAsync(OAuthHostedToken token, string command)
    {
        using var request = new HttpRequestMessage(HttpMethod.Post, "api/commands")
        {
            Content = JsonContent.Create(new PortalCommandRequest(command)),
        };
        request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token.AccessToken);
        using var response = await HttpClients.CreateClient("api").SendAsync(request, _lifetime.Token);
        if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized) return null;
        if (response.IsSuccessStatusCode && await response.Content.ReadFromJsonAsync<PortalCommandResponse>(_lifetime.Token) is { } answer)
            return new(answer.Output, answer.Truncated, null);
        return new(null, false, await response.Content.ReadAsStringAsync(_lifetime.Token) is { Length: > 0 and <= 500 } text
            ? text : "The game could not run the command.");
    }

    private void Answer(bool allowed) => _consentAnswer?.TrySetResult(allowed);

    /// <param name="Cancelled">The player turned the changes down.</param>
    public sealed record RoomImportResult(RoomPlanDto? Plan, RoomApplyDto? Applied, string? Error, bool Cancelled);

    private static string Selection(int[] rooms, string[]? coordinates)
    {
        if (rooms.Length is < 1 or > 100 || rooms.Any(id => id < 0)) throw new ArgumentException("Invalid room selection.");
        if (coordinates is not null && coordinates.Length != 3) throw new ArgumentException("Name three coordinate attributes.");
        return string.Join("&", rooms.Select(id => "rooms=" + id.ToString(System.Globalization.CultureInfo.InvariantCulture))
            .Concat((coordinates ?? []).Select(name => "coordinates=" + Uri.EscapeDataString(name))));
    }

    public async ValueTask DisposeAsync()
    {
        _decision?.TrySetResult(false);
        _consentAnswer?.TrySetResult(false);
        await _lifetime.CancelAsync();
        try
        {
            if (_mount is not null) { await _mount.InvokeVoidAsync("dispose"); await _mount.DisposeAsync(); }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException ex)
        {
            // A departing browser has no JS runtime left to release. Managed references still need cleanup.
            Logger.LogDebug(ex, "Hosted application JS runtime disconnected during disposal.");
        }
        finally
        {
            _reference?.Dispose();
            _lifetime.Dispose();
        }
    }
}
