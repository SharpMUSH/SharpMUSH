@using Microsoft.Extensions.Localization
@using SharpMUSH.Client.Models.Wiki
@using SharpMUSH.Client.Models
@using SharpMUSH.Client.Resources
@using SharpMUSH.Client.Services
@using SharpMUSH.Library.Services
@using SharpMUSH.Library.DiscriminatedUnions
@inject WikiService Wiki
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> Loc
@implements IDisposable

@if (_loading)
{
    <WikiPageSkeleton />
}
else if (_loadFailed)
{
    @* The server did not answer (a restart, a dropped connection): not a missing page, so no offer to
       create one, and nothing to edit yet. It tries again on its own and says so. *@
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-2 wiki-load-failed">
        <MudText>@Loc["WikiLoadFailed"]</MudText>
        <MudButton Variant="Variant.Text" Size="Size.Small" Style="text-transform:none;" OnClick="RetryNowAsync">@Loc["NavTryAgain"]</MudButton>
    </MudAlert>
}
else if (Mode == WikiMode.View)
{
    <WikiDisplay Slug="@Slug" Namespace="@Namespace" Locale="@Locale" Article="@_article"
                 Embedded="@Embedded" ShowTitle="@ShowTitle"
                 ActivateEditMode="ActivateEditMode" />
}
else
{
    @* Outside an embed the editor takes the page's full height (full-height passes a definite height
       down through the shell), so the source and preview panes fill the window and scroll inside it. *@
    <div class="wiki-view-edit @(Embedded ? null : "full-height")">
        <WikiEdit Article="@_editDraft"
                  SourceLocale="@_sourceLocale"
                  SelectedLocale="@_selectedLocale"
                  AvailableLocales="@_availableLocales"
                  CategoryNames="@_categoryNames"
                  OnLocaleChanged="@HandleLocaleChanged"
                  OnSaved="@HandleSave"
                  OnCancel="@HandleCancel" />
        @if (_saveError is not null)
        {
            <MudAlert Severity="@(_saveConflict ? Severity.Warning : Severity.Error)" Dense="true" Class="mt-2">
                @_saveError
                @if (_saveConflict)
                {
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               OnClick="@(() => Nav.NavigateTo(Nav.Uri, forceLoad: true))">
                        @Loc["WkTranslationReload"]
                    </MudButton>
                }
            </MudAlert>
        }
    </div>
}

@code {
    public enum WikiMode { View, Edit }

    [Parameter] public required string Slug { get; init; }
    [Parameter] public required WikiMode Mode { get; set; } = WikiMode.View;

    /// <summary>
    /// Raised when the view switches itself between reading and editing, so a host that binds
    /// <see cref="Mode"/> does not hand the old mode back on its next render.
    /// </summary>
    [Parameter] public EventCallback<WikiMode> ModeChanged { get; init; }

    /// <summary>Wiki namespace (e.g. "help"); null means the Main namespace.</summary>
    [Parameter] public string? Namespace { get; init; }


    /// <summary>The locale requested via <c>?lang=</c>; null means the reader's stored preference.</summary>
    [Parameter] public string? Locale { get; init; }

    /// <summary>The title a page that does not exist yet starts from; null or blank means its slug.</summary>
    [Parameter] public string? NewTitle { get; init; }

    /// <summary>
    /// True when this renders inside another page (a layout widget) rather than as the <c>/wiki</c>
    /// route itself, which drops chrome that only makes sense on that route.
    /// </summary>
    [Parameter] public bool Embedded { get; init; }

    /// <summary>
    /// Raised once the page has been fetched, with <c>true</c> when it exists. Lets an embedding
    /// component drop its own frame rather than wrap an empty or missing page in one.
    /// </summary>
    [Parameter] public EventCallback<bool> OnLoaded { get; init; }

    /// <summary>The loaded article (null when there is none), for a host that titles the page itself.</summary>
    [Parameter] public EventCallback<WikiArticle?> OnArticle { get; init; }

    /// <summary>False drops an embedded article's own kicker and title, for a host card whose header names it.</summary>
    [Parameter] public bool ShowTitle { get; init; } = true;

    private WikiArticle? _article;

    // A shallow copy of _article used while editing so the view copy is not mutated live.
    private WikiArticle? _editDraft;
    private string? _saveError;
    private bool _loading = true;

    private string _sourceLocale = "en";
    private string _selectedLocale = "en";

    /// <summary>Each category's name in the edited language, for the editor's category chips.</summary>
    private IReadOnlyDictionary<string, string>? _categoryNames;
    private IReadOnlyList<string> _availableLocales = [];

    /// <summary>
    /// Revision number of the row currently loaded, held for optimistic concurrency on save.
    /// </summary>
    private int _loadedRevision;

    /// <summary>Set when the server answered 409; drives the reload prompt instead of a plain error toast.</summary>
    private bool _saveConflict;

    public async Task ActivateEditMode()
    {
        _categoryNames = await Wiki.GetCategoryNamesAsync(_selectedLocale);
        _editDraft = BuildEditDraft();
        _saveError = null;
        await SetModeAsync(WikiMode.Edit);
        StateHasChanged();
    }

    private async Task SetModeAsync(WikiMode mode)
    {
        Mode = mode;
        await ModeChanged.InvokeAsync(mode);
    }

    private WikiArticle BuildEditDraft() =>
        _article is not null
            ? new WikiArticle(_article.Title, _article.Content, _article.Image, _article.RenderedHtml)
            {
                Id = _article.Id,
                Slug = _article.Slug,
                Categories = [.. _article.Categories],
                Published = _article.Published,
            }
            : new WikiArticle(string.IsNullOrWhiteSpace(NewTitle) ? Slug : NewTitle.Trim(), string.Empty, null);

    /// <summary>
    /// Switching locale in the editor is a navigation, not local state: <c>?lang=</c> stays the single
    /// source of truth for which locale is on screen, so a refresh or a back button lands where expected.
    /// </summary>
    private void HandleLocaleChanged(string locale)
    {
        Nav.NavigateTo($"{WikiRoutes.WikiPathFor(Namespace, Slug)}/edit?lang={Uri.EscapeDataString(locale)}");
    }

    /// <summary>
    /// The revision number to compare against on a translation save, or null for create-only.
    /// </summary>
    /// <remarks>
    /// Null when the loaded article is not this locale's own row — the reader was served a fallback because
    /// no translation exists yet, so its <c>RevisionNumber</c> belongs to a different stream and passing it
    /// would make the very first save look stale.
    /// </remarks>
    private int? ExpectedTranslationRevision =>
        _article is not null && WikiHelpers.SameLanguage(_article.Locale, _selectedLocale)
            ? _loadedRevision
            : null;

    private async Task HandleSave(WikiArticle draft)
    {
        _saveError = null;
        _saveConflict = false;

        if (!WikiHelpers.SameLanguage(_selectedLocale, _sourceLocale))
        {
            // A translation owns Title, body and Published; categories and requirements are inherited
            // structurally, so there is no metadata call to make here.
            var translationResult = await Wiki.UpsertTranslationAsync(
                draft.Slug, _selectedLocale, draft.Title, draft.Content, draft.Published,
                ExpectedTranslationRevision, editSummary: null, ns: Namespace);

            switch (translationResult)
            {
                case WikiTranslationInfo:
                    _editDraft = null;
                    Mode = WikiMode.View;
                    Nav.NavigateTo(
                        $"{WikiRoutes.WikiPathFor(Namespace, Slug)}?lang={Uri.EscapeDataString(_selectedLocale)}",
                        forceLoad: true);
                    break;
                case WikiTranslationSaveError err:
                    // On a conflict, prompt for a reload and STOP. Retrying — or silently re-reading the
                    // current revision and saving again — would re-apply this editor's stale markdown over
                    // the other translator's, which is precisely the loss expectedRevisionNumber prevents.
                    // The draft stays in the editor so its text can be copied out first.
                    _saveConflict = err.NeedsReload;
                    _saveError = err.NeedsReload ? Loc["WkTranslationConflict"] : err.Message;
                    break;
            }

            StateHasChanged();
            return;
        }

        ApiResult<WikiArticle> result;

        if (string.IsNullOrEmpty(draft.Slug))
        {
            result = await Wiki.CreatePageAsync(draft.Title, draft.Content, Namespace, draft.Categories);
        }
        else
        {
            result = await Wiki.UpdatePageAsync(draft.Slug, draft.Content, ns: Namespace);
        }

        if (result is WikiArticle saved
            && (saved.Published != draft.Published || !saved.Categories.Order().SequenceEqual(draft.Categories.Select(WikiCategories.Key).Distinct().Order())))
        {
            // Content save succeeded; categories and the published switch are page metadata, their own call.
            result = await Wiki.SetMetadataAsync(saved.Slug, draft.Categories, draft.Published, Namespace);
        }

        switch (result)
        {
            case WikiArticle updated:
                _article = updated;
                _editDraft = null;
                await SetModeAsync(WikiMode.View);
                // A host framing the page (the profile's Biography card) titles and dates it from these.
                await OnLoaded.InvokeAsync(true);
                await OnArticle.InvokeAsync(updated);
                break;
            case ApiFailure failure:
                _saveError = failure.Message;
                break;
        }
    }

    /// <summary>Swaps in the article returned by a successful history-dialog rollback.</summary>

    private async Task HandleCancel()
    {
        _editDraft = null;
        _saveError = null;
        await SetModeAsync(WikiMode.View);
    }

    /// <summary>Set while the last read failed for want of an answer; cleared by one that succeeds.</summary>
    private bool _loadFailed;
    private CancellationTokenSource? _retry;

    /// <summary>How long to wait between reads after one failed; the last delay repeats.</summary>
    private static readonly TimeSpan[] RetryDelays =
        [TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(6), TimeSpan.FromSeconds(12), TimeSpan.FromSeconds(30)];

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        if (!await LoadAsync()) StartRetrying();
        _loading = false;
        await base.OnInitializedAsync();
    }

    /// <summary>
    /// Reads the page. False when the server did not answer: the view then says so and keeps asking, so a
    /// game that restarts does not leave the page claiming it does not exist.
    /// </summary>
    private async Task<bool> LoadAsync()
    {
        switch (await Wiki.GetWikiArticle(Slug, Namespace, Locale))
        {
            case WikiArticle article:
                _article = article;
                break;
            case NotFound:
                _article = null;
                break;
            default:
                _loadFailed = true;
                return false;
        }
        _loadFailed = false;
        await ShowLoadedAsync();
        return true;
    }

    private void StartRetrying()
    {
        if (_retry is not null) return;
        _retry = new CancellationTokenSource();
        _ = RetryAndReleaseAsync(_retry);
    }

    private async Task RetryAndReleaseAsync(CancellationTokenSource retry)
    {
        try
        {
            await RetryAsync(retry.Token);
        }
        finally
        {
            if (ReferenceEquals(_retry, retry)) _retry = null;
            retry.Dispose();
        }
    }

    private async Task RetryAsync(CancellationToken token)
    {
        for (var attempt = 0; !token.IsCancellationRequested; attempt++)
        {
            try
            {
                await Task.Delay(RetryDelays[Math.Min(attempt, RetryDelays.Length - 1)], token);
            }
            catch (OperationCanceledException)
            {
                return;
            }
            if (!_loadFailed) return;
            var loaded = false;
            await InvokeAsync(async () =>
            {
                loaded = await LoadAsync();
                if (loaded) StateHasChanged();
            });
            if (loaded) return;
        }
    }

    private Task RetryNowAsync() => LoadAsync();

    public void Dispose() => _retry?.Cancel();

    private async Task ShowLoadedAsync()
    {
        if (_article is not null)
        {
            // The served locale is the source locale unless a translation won, in which case the source is
            // whichever available locale is not the served one. AvailableLocales is source-first.
            _availableLocales = _article.AvailableLocales;
            _sourceLocale = _article.AvailableLocales.FirstOrDefault() ?? _article.Locale;
            _selectedLocale = _article.Locale;
            _loadedRevision = _article.RevisionNumber;
        }

        if (Mode == WikiMode.Edit)
        {
            // A cold load into Edit mode never calls ActivateEditMode, so it must build the draft
            // itself or WikiEdit's `Article is not null` guard renders nothing.
            _categoryNames = await Wiki.GetCategoryNamesAsync(_selectedLocale);
            _editDraft = BuildEditDraft();
        }

        await OnLoaded.InvokeAsync(_article is not null);
        await OnArticle.InvokeAsync(_article);
    }
}
