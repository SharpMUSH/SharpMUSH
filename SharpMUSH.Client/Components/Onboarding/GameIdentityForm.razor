@using SharpMUSH.Configuration.Mssp
@using SharpMUSH.Client.Resources
@inject IStringLocalizer<SharedResource> Loc
@using SharpMUSH.Library.Models.Portal.Onboarding
@inject IHttpClientFactory Http
@inject ServerInfoService ServerInfo

<section class="identity-form" aria-label="@Loc["GuideIdentityLabel"]">
    @if (_error is not null) { <p role="alert">@_error</p> }
    @if (!_loaded)
    {
        @if (_busy) { <p role="status">@Loc["GuideIdentityLoading"]</p> }
        else { <button type="button" @onclick="Load">@Loc["GuideIdentityRetry"]</button> }
    }
    else
    {
        @* Kit fields, the same outlined MudBlazor controls the rest of setup uses: text fields,
           drop-downs for the genre and the art style, and a suggesting field for the subgenre,
           which also takes a value of the game's own. *@
        <fieldset disabled="@_busy">
            <MudTextField T="string" InputId="guide-game-name" Label="@Loc["GuideIdentityName"]" Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true"
                          MaxLength="128" Placeholder="Ravenmoor" Immediate="true" Disabled="_busy" Class="identity-field"
                          @bind-Value="_name" @bind-Value:after="MarkDirty" />
            <MudTextField T="string" InputId="guide-introduction" Label="@Loc["GuideIdentityIntroduction"]" Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true"
                          MaxLength="1000" Placeholder="@Loc["GuideIdentityIntroductionExample"]" Lines="3" Sizing="InputSizing.Auto" Immediate="true" Disabled="_busy" Class="identity-field"
                          @bind-Value="_introduction" @bind-Value:after="MarkDirty" />
            <p id="guide-welcome-starters-help">@Loc["GuideIdentityStarterHint"]</p>
            <div class="identity-starters" role="group" aria-label="@Loc["GuideIdentityStarters"]" aria-describedby="guide-welcome-starters-help">
                @foreach (var starter in WelcomeStarters)
                {
                    <button type="button" @onclick="() => ChooseWelcome(starter)">@Loc[$"GuideIdentityStarter{starter}"]</button>
                }
            </div>
            <div class="identity-columns">
                <MudSelect T="string" InputId="guide-genres" Label="@Loc["GuideIdentityGenres"]" Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true"
                           Disabled="_busy" Class="identity-field" AnchorOrigin="Origin.BottomLeft"
                           @bind-Value="_genres" @bind-Value:after="GenreChanged">
                    @if (!MsspCatalog.Find("GENRE")!.Choices.Contains(_genres)) { <MudSelectItem T="string" Value="@_genres" Disabled="true">@_genres</MudSelectItem> }
                    @foreach (var choice in MsspCatalog.Find("GENRE")!.Choices) { <MudSelectItem T="string" Value="@choice">@choice</MudSelectItem> }
                </MudSelect>
                <div>
                    <MudAutocomplete T="string" InputId="guide-subgenres" Label="@Loc["GuideIdentitySubgenres"]" Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true"
                                     MaxLength="@MsspCatalog.MaxValueLength" Disabled="_busy" Class="identity-field"
                                     SearchFunc="SearchSubgenres" CoerceValue="true" CoerceText="false" MaxItems="null"
                                     ShowProgressIndicator="false" AnchorOrigin="Origin.BottomLeft"
                                     aria-describedby="@(HasCustomSubgenre ? "guide-subgenre-custom" : null)"
                                     Value="_subgenres" ValueChanged="SubgenreChosen"
                                     Text="@_subgenres" TextChanged="SubgenreTyped" />
                    <div role="status">
                        @if (HasCustomSubgenre)
                        {
                            <p id="guide-subgenre-custom" class="identity-advisory">@Loc["GuideIdentityCustomSubgenre"]</p>
                        }
                    </div>
                </div>
            </div>
            <p>@Loc["GuideIdentityGenreHint"]</p>
            <MudSelect T="string" InputId="guide-art-style" Label="@Loc["GuideIdentityStyle"]" Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true"
                       Disabled="_busy" Class="identity-field" AnchorOrigin="Origin.BottomLeft" ToStringFunc="StyleName"
                       @bind-Value="_style" @bind-Value:after="MarkDirty">
                @foreach (var style in SharpieArtCatalog.Styles) { <MudSelectItem T="string" Value="@style">@StyleName(style)</MudSelectItem> }
            </MudSelect>
            <p>@Loc["AdmHomeHeaderArtworkHint"]</p>
            <MudTextField T="string" InputId="guide-welcome-page" Label="@Loc["GuideIdentityWelcomePage"]" Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true"
                          MaxLength="256" Placeholder="main/welcome" Immediate="true" Disabled="_busy" Class="identity-field"
                          @bind-Value="_welcome" @bind-Value:after="MarkDirty" />
            <MudTextField T="string" InputId="guide-rules-page" Label="@Loc["GuideIdentityRulesPage"]" Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true"
                          MaxLength="256" Placeholder="main/rules" Immediate="true" Disabled="_busy" Class="identity-field"
                          @bind-Value="_rules" @bind-Value:after="MarkDirty" />
            <MudTextField T="string" InputId="guide-character-page" Label="@Loc["GuideIdentityCharacterPage"]" Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true"
                          MaxLength="256" Placeholder="help/character_creation" Immediate="true" Disabled="_busy" Class="identity-field"
                          @bind-Value="_character" @bind-Value:after="MarkDirty" />
            <p>@Loc["GuideIdentityWikiHint"]</p>
            <section class="identity-preview" aria-label="@Loc["GuideIdentityPreviewLabel"]">
                <p class="identity-preview-label">@Loc["GuideIdentityPreview"]</p>
                <div class="identity-preview-content">
                    <div>
                        <h2>@Loc["GuideWelcomeGame", string.IsNullOrWhiteSpace(_name) ? Loc["GuideIdentityYourGame"].Value : _name]</h2>
                        @if (!string.IsNullOrWhiteSpace(_introduction)) { <p class="identity-preview-intro">@_introduction</p> }
                        <p>@Loc["GuideWelcomeIntro"]</p>
                    </div>
                    @if (PreviewArt is { } art)
                    {
                        <img src="@ApiUrl.Resolve(art.Url)" width="@art.Width" height="@art.Height" alt="" />
                    }
                </div>
                @if (PreviewArt is { Theme: "neutral" }) { <p>@Loc["GuideIdentityArtFallback"]</p> }
                @if (PreviewArt is null) { <p>@Loc["GuideIdentityNoArt"]</p> }
                <p>@Loc["GuideIdentityVisibility"]</p>
            </section>
            <HomeHeaderFields @ref="_header" Name="@_name" Sharpie="HeaderSharpie" OnChanged="MarkDirty" />
        </fieldset>
        <button type="button" class="identity-save" aria-disabled="@(_busy ? "true" : "false")" @onclick="Save">@(_busy ? Loc["GuideIdentitySaving"].Value : SaveLabel ?? Loc["GuideIdentitySave"].Value)</button>
        @if (_saved) { <p role="status">@Loc["GuideIdentitySaved"]</p> }
    }
</section>

@code {
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public string? SaveLabel { get; set; }
    private string _name = "", _introduction = "", _genres = "", _subgenres = "", _welcome = "", _rules = "", _character = "", _style = "minimalist", _override = "";
    private string[] _storedGenres = [], _storedSubgenres = [];
    private bool _genreChanged, _subgenreChanged;
    private bool HasCustomSubgenre => (_subgenreChanged ? new[] { _subgenres } : _storedSubgenres)
        .Any(value => !string.IsNullOrWhiteSpace(value) && !MsspCatalog.Find("SUBGENRE")!.Choices.Contains(value));
    private SharpieArt? PreviewArt => SharpieArtCatalog.Resolve(_style, _genres, _subgenres, _override, GuideImagery.Full, SharpieArtMoment.Welcome);
    // Home resolves Sharpie from the first stored genre and subgenre, so the header preview does too.
    private SharpieArt? HeaderSharpie => GameHero.GenreArtFor(_style,
        _genreChanged ? _genres : _storedGenres.FirstOrDefault() ?? "",
        _subgenreChanged ? _subgenres : _storedSubgenres.FirstOrDefault() ?? "", _override);
    private HomeHeaderFields? _header;
    private bool _loaded, _busy, _saved;
    private string? _error;
    protected override Task OnInitializedAsync() => Load();
    private async Task Load()
    {
        _busy = true; _error = null;
        switch (await Http.CreateClient("api").GetApiAsync<OnboardingSettings>("api/onboarding/settings", Loc["GuideIdentityLoadEmpty"].Value))
        {
            case OnboardingSettings settings:
                _name = settings.MudName; _introduction = settings.Introduction;
                AcceptGenres(settings);
                _welcome = settings.WelcomePage; _rules = settings.RulesPage; _character = settings.CharacterGuidePage;
                _style = settings.ArtStyle; _override = settings.ArtOverrideId; _loaded = true;
                break;
            case ApiFailure failure: _error = failure.Message; break;
        }
        _busy = false;
    }
    private static readonly string[] WelcomeStarters = ["Stories", "Adventure", "Relaxed", "NewPlayers"];
    private void ChooseWelcome(string starter)
    {
        var gameName = string.IsNullOrWhiteSpace(_name) ? Loc["GuideIdentityThisGame"].Value : _name.Trim();
        _introduction = Loc[$"GuideIdentityStarter{starter}Text", gameName].Value;
        MarkDirty();
    }
    private void MarkDirty() => _saved = false;
    private void GenreChanged() { _genreChanged = true; MarkDirty(); }
    private void SubgenreChanged() { _subgenreChanged = true; MarkDirty(); }
    private void SubgenreTyped(string? text)
    {
        if (text is null || text == _subgenres) return;
        _subgenres = text;
        SubgenreChanged();
    }
    private void SubgenreChosen(string? value)
    {
        if (value is null || value == _subgenres) return;
        _subgenres = value;
        SubgenreChanged();
    }
    private Task<IEnumerable<string>> SearchSubgenres(string? text, CancellationToken _)
    {
        var choices = MsspCatalog.Find("SUBGENRE")!.Choices;
        // The whole list while the field holds a value from it, so opening the list shows every choice.
        return Task.FromResult<IEnumerable<string>>(string.IsNullOrWhiteSpace(text) || choices.Contains(text)
            ? choices
            : choices.Where(choice => choice.Contains(text, StringComparison.OrdinalIgnoreCase)).ToList());
    }
    private void AcceptGenres(OnboardingSettings settings)
    {
        // The fields' labels are display values; they must never replace untouched arrays.
        _storedGenres = [.. settings.Genres]; _storedSubgenres = [.. settings.Subgenres];
        _genres = _storedGenres.Length == 0 ? "None" : string.Join(" / ", _storedGenres);
        _subgenres = _storedSubgenres.Length == 0 ? "None" : string.Join(" / ", _storedSubgenres);
        _genreChanged = _subgenreChanged = false;
    }
    private async Task Save()
    {
        if (_busy) return;
        _busy = true; _saved = false;
        // The header's options first: the server validates them, and a refusal leaves the identity unsaved too.
        _error = _header is null ? null : await _header.SaveAsync();
        if (_error is null) await SaveIdentityAsync();
        ServerInfo.Refresh();
        _busy = false;
    }
    private async Task SaveIdentityAsync()
    {
        var values = new OnboardingSettings(_name, _genreChanged ? [_genres] : [.. _storedGenres],
            _subgenreChanged ? [_subgenres] : [.. _storedSubgenres], _introduction, _welcome, _rules, _character, _style,
            SharpieArtCatalog.Approved.Any(art => art.Id == _override && art.Style == _style) ? _override : "");
        switch (await Http.CreateClient("api").PutApiAsync<OnboardingSettings, OnboardingSettings>("api/onboarding/settings", values, Loc["GuideIdentitySaveEmpty"].Value))
        {
            case OnboardingSettings settings: AcceptGenres(settings); _saved = true; await OnSaved.InvokeAsync(); break;
            case ApiFailure failure: _error = failure.Message; break;
        }
    }
    private string StyleName(string style) => Loc[$"GuideStyle_{style}"];
}
