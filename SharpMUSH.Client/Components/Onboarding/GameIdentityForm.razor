@using SharpMUSH.Configuration.Mssp
@using SharpMUSH.Client.Resources
@inject IStringLocalizer<SharedResource> Loc
@using SharpMUSH.Library.Models.Portal.Onboarding
@inject IHttpClientFactory Http
@inject ServerInfoService ServerInfo

<section class="identity-form" aria-label="@Loc["GuideIdentityLabel"]">
    @if (_error is not null) { <p role="alert">@_error</p> }
    @if (!_loaded)
    {
        @if (_busy) { <p role="status">@Loc["GuideIdentityLoading"]</p> }
        else { <button type="button" @onclick="Load">@Loc["GuideIdentityRetry"]</button> }
    }
    else
    {
        <fieldset disabled="@_busy">
            <label for="guide-game-name">@Loc["GuideIdentityName"]</label><input id="guide-game-name" @bind="_name" @bind:event="oninput" @bind:after="MarkDirty" maxlength="128" />
            <label for="guide-introduction">@Loc["GuideIdentityIntroduction"]</label><textarea id="guide-introduction" @bind="_introduction" @bind:event="oninput" @bind:after="MarkDirty" maxlength="1000" rows="3"></textarea>
            <p id="guide-welcome-starters-help">@Loc["GuideIdentityStarterHint"]</p>
            <div class="identity-starters" role="group" aria-label="@Loc["GuideIdentityStarters"]" aria-describedby="guide-welcome-starters-help">
                @foreach (var starter in WelcomeStarters)
                {
                    <button type="button" @onclick="() => ChooseWelcome(starter)">@Loc[$"GuideIdentityStarter{starter}"]</button>
                }
            </div>
            <div class="identity-columns">
                <div><label for="guide-genres">@Loc["GuideIdentityGenres"]</label><select id="guide-genres" @bind="_genres" @bind:after="MarkDirty">
                    @if (!MsspCatalog.Find("GENRE")!.Choices.Contains(_genres)) { <option value="@_genres" disabled>@_genres</option> }
                    @foreach (var choice in MsspCatalog.Find("GENRE")!.Choices) { <option value="@choice">@choice</option> }
                </select></div>
                <div><label for="guide-subgenres">@Loc["GuideIdentitySubgenres"]</label><select id="guide-subgenres" @bind="_subgenres" @bind:after="MarkDirty">
                    @if (!MsspCatalog.Find("SUBGENRE")!.Choices.Contains(_subgenres)) { <option value="@_subgenres" disabled>@_subgenres</option> }
                    @foreach (var choice in MsspCatalog.Find("SUBGENRE")!.Choices) { <option value="@choice">@choice</option> }
                </select></div>
            </div>
            <p>@Loc["GuideIdentityGenreHint"]</p>
            <label for="guide-art-style">@Loc["GuideIdentityStyle"]</label>
            <select id="guide-art-style" @bind="_style" @bind:after="MarkDirty">
                @foreach (var style in SharpieArtCatalog.Styles) { <option value="@style">@StyleName(style)</option> }
            </select>
            <p>@Loc["GuideIdentityArtworkHint"] <a href="/admin/config/Cosmetic">@Loc["GuideIdentityAppearance"]</a>.</p>
            <label for="guide-welcome-page">@Loc["GuideIdentityWelcomePage"]</label><input id="guide-welcome-page" @bind="_welcome" @bind:event="oninput" @bind:after="MarkDirty" maxlength="256" placeholder="main/welcome" />
            <label for="guide-rules-page">@Loc["GuideIdentityRulesPage"]</label><input id="guide-rules-page" @bind="_rules" @bind:event="oninput" @bind:after="MarkDirty" maxlength="256" placeholder="main/rules" />
            <label for="guide-character-page">@Loc["GuideIdentityCharacterPage"]</label><input id="guide-character-page" @bind="_character" @bind:event="oninput" @bind:after="MarkDirty" maxlength="256" placeholder="help/character_creation" />
            <p>@Loc["GuideIdentityWikiHint"]</p>
            <section class="identity-preview" aria-label="@Loc["GuideIdentityPreviewLabel"]">
                <p class="identity-preview-label">@Loc["GuideIdentityPreview"]</p>
                <div class="identity-preview-content">
                    <div>
                        <h2>@Loc["GuideWelcomeGame", string.IsNullOrWhiteSpace(_name) ? Loc["GuideIdentityYourGame"].Value : _name]</h2>
                        @if (!string.IsNullOrWhiteSpace(_introduction)) { <p class="identity-preview-intro">@_introduction</p> }
                        <p>@Loc["GuideWelcomeIntro"]</p>
                    </div>
                    @if (PreviewArt is { } art)
                    {
                        <img src="@ApiUrl.Resolve(art.Url)" width="@art.Width" height="@art.Height" alt="" />
                    }
                </div>
                @if (PreviewArt is { Theme: "neutral" }) { <p>@Loc["GuideIdentityArtFallback"]</p> }
                @if (PreviewArt is null) { <p>@Loc["GuideIdentityNoArt"]</p> }
                <p>@Loc["GuideIdentityVisibility"]</p>
            </section>
        </fieldset>
        <button type="button" class="identity-save" aria-disabled="@(_busy ? "true" : "false")" @onclick="Save">@(_busy ? Loc["GuideIdentitySaving"].Value : SaveLabel ?? Loc["GuideIdentitySave"].Value)</button>
        @if (_saved) { <p role="status">@Loc["GuideIdentitySaved"]</p> }
    }
</section>

@code {
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public string? SaveLabel { get; set; }
    private string _name = "", _introduction = "", _genres = "", _subgenres = "", _welcome = "", _rules = "", _character = "", _style = "minimalist", _override = "";
    private SharpieArt? PreviewArt => SharpieArtCatalog.Resolve(_style, _genres, _subgenres, _override, GuideImagery.Full);
    private bool _loaded, _busy, _saved;
    private string? _error;
    protected override Task OnInitializedAsync() => Load();
    private async Task Load()
    {
        _busy = true; _error = null;
        switch (await Http.CreateClient("api").GetApiAsync<OnboardingSettings>("api/onboarding/settings", Loc["GuideIdentityLoadEmpty"].Value))
        {
            case OnboardingSettings settings:
                _name = settings.MudName; _introduction = settings.Introduction;
                _genres = settings.Genres.Length == 0 ? "None" : string.Join(" / ", settings.Genres); _subgenres = settings.Subgenres.Length == 0 ? "None" : string.Join(" / ", settings.Subgenres);
                _welcome = settings.WelcomePage; _rules = settings.RulesPage; _character = settings.CharacterGuidePage;
                _style = settings.ArtStyle; _override = settings.ArtOverrideId; _loaded = true;
                break;
            case ApiFailure failure: _error = failure.Message; break;
        }
        _busy = false;
    }
    private static readonly string[] WelcomeStarters = ["Stories", "Adventure", "Relaxed", "NewPlayers"];
    private void ChooseWelcome(string starter)
    {
        var gameName = string.IsNullOrWhiteSpace(_name) ? Loc["GuideIdentityThisGame"].Value : _name.Trim();
        _introduction = Loc[$"GuideIdentityStarter{starter}Text", gameName].Value;
        MarkDirty();
    }
    private void MarkDirty() => _saved = false;
    private async Task Save()
    {
        if (_busy) return;
        _busy = true; _saved = false; _error = null;
        var values = new OnboardingSettings(_name, [_genres], [_subgenres], _introduction, _welcome, _rules, _character, _style,
            SharpieArtCatalog.Approved.Any(art => art.Id == _override && art.Style == _style) ? _override : "");
        switch (await Http.CreateClient("api").PutApiAsync<OnboardingSettings, OnboardingSettings>("api/onboarding/settings", values, Loc["GuideIdentitySaveEmpty"].Value))
        {
            case OnboardingSettings: _saved = true; ServerInfo.Refresh(); await OnSaved.InvokeAsync(); break;
            case ApiFailure failure: _error = failure.Message; break;
        }
        _busy = false;
    }
    private string StyleName(string style) => Loc[$"GuideStyle_{style}"];
}
