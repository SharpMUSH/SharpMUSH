@using SharpMUSH.Client.Models
@using SharpMUSH.Client.Models.Wiki
@using SharpMUSH.Client.Resources
@using SharpMUSH.Library.Services
@inject IJSRuntime JsRuntime
@inject ILogger<WikiEdit> Logger
@inject WikiMarkdigPipeline Pipeline
@inject IStringLocalizer<SharedResource> Loc

@if (Article is not null)
{
    <div class="wiki-edit">
        <div class="wiki-edit-header">
            <button type="button" class="wiki-edit-cancel" @onclick="OnCancel">
                <MudIcon Icon="@Icons.Material.Filled.Close" Style="font-size:0.9375rem;" /> @Loc["Cancel"]
            </button>
            <div style="flex:1;"></div>
            <span class="wiki-edit-mode">
                <MudIcon Icon="@Icons.Material.Filled.Visibility" Style="font-size:0.875rem;color:var(--accent);" /> @Loc["WkEditLivePreview"]
            </span>
        </div>

        <div class="wiki-edit-localerow">
            <MudIcon Icon="@Icons.Material.Filled.Language" Style="font-size:0.875rem;color:var(--text-faint);" />
            <MudSelect T="string"
                       Value="@SelectedLocale"
                       ValueChanged="@SelectLocaleAsync"
                       Label="@Loc["WkLocaleSelector"].Value"
                       Dense="true"
                       Margin="Margin.Dense"
                       Variant="Variant.Outlined"
                       Style="max-width:220px;">
                @foreach (var locale in AvailableLocales)
                {
                    <MudSelectItem T="string" Value="@locale">@LocaleLabel(locale)</MudSelectItem>
                }
            </MudSelect>
            @if (_addingLocale)
            {
                <input class="wiki-edit-localeinput" value="@_customLocale"
                       @oninput="@(e => _customLocale = e.Value?.ToString() ?? string.Empty)"
                       @onkeydown="@(async e => { if (e.Key == "Enter") await AddCustomLocaleAsync(); })"
                       placeholder="@Loc["WkCustomLocalePlaceholder"]" />
            }
            else
            {
                <MudButton Variant="Variant.Text" Size="Size.Small" Style="text-transform:none;"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="@(() => _addingLocale = true)">@Loc["WkAddTranslation"]</MudButton>
            }
        </div>

        <div class="wiki-edit-titlerow">
            <input @ref="_title" class="wiki-edit-title" value="@Article.Title" aria-label="@Loc["WkPageTitlePlaceholder"]"
                   @oninput="@(e => Article.Title = e.Value?.ToString() ?? string.Empty)"
                   placeholder="@Loc["WkPageTitlePlaceholder"]" />
        </div>

        <div class="wiki-edit-toolbar">
            <button type="button" title="@Loc["WkBold"]" @onclick="@(() => Wrap("**", "**", false))"><b>B</b></button>
            <button type="button" title="@Loc["WkItalic"]" @onclick="@(() => Wrap("*", "*", false))"><i>I</i></button>
            <button type="button" title="@Loc["WkHeading"]" @onclick="@(() => Wrap("## ", "", true))"><b>H</b></button>
            <button type="button" title="@Loc["WkListItem"]" @onclick="@(() => Wrap("- ", "", true))">
                <MudIcon Icon="@Icons.Material.Filled.FormatListBulleted" Style="font-size:0.9375rem;" />
            </button>
            <button type="button" title="@Loc["WkQuote"]" @onclick="@(() => Wrap("> ", "", true))">
                <MudIcon Icon="@Icons.Material.Filled.FormatQuote" Style="font-size:0.9375rem;" />
            </button>
            <button type="button" title="@Loc["WkLink"]" @onclick="@(() => Wrap("[", "](https://)", false))">
                <MudIcon Icon="@Icons.Material.Filled.Link" Style="font-size:0.9375rem;" />
            </button>
            <div class="wiki-edit-tooldiv"></div>
            <button type="button" title="@Loc["WkInsertImage"]" @onclick="@(() => _showAssetPicker = !_showAssetPicker)">
                <MudIcon Icon="@Icons.Material.Filled.Image" Style="font-size:0.9375rem;" />
            </button>
            <div style="flex:1;"></div>
            <span class="wiki-edit-md">Markdown</span>
        </div>

        @if (_showAssetPicker)
        {
            <div class="wiki-edit-assets">
                <WikiAssetPicker OnAssetSelected="@InsertAssetMarkdown" />
            </div>
        }

        <div class="wiki-edit-split">
            @* The page's main text box (input-focus.js): typing on the page lands here, caret at the top. *@
            <textarea @ref="_source" id="@_taId" class="wiki-edit-textarea" spellcheck="false" data-primary-input="start"
                      aria-label="@Loc["WkSourceLabel"]"
                      value="@Article.Content"
                      @oninput="@(e => Article.Content = e.Value?.ToString() ?? string.Empty)"></textarea>
            <div class="wiki-edit-preview WikiContent">
                <div class="mud-card-content">
                    @((MarkupString)Pipeline.RenderToHtml(Article.Content))
                </div>
            </div>
        </div>

        @if (MarkdownFenceCheck.Check(Article.Content) is { Count: > 0 } fenceIssues)
        {
            @* Markdown has no errors, so a ::: block that nests wrongly would otherwise just render wrongly. *@
            <ul class="wiki-edit-fences" role="status">
                @foreach (var issue in fenceIssues)
                {
                    <li>@Loc[FenceIssueKey(issue.Problem), issue.Line]</li>
                }
            </ul>
        }

        <div class="wiki-edit-tags">
            @* Categories are held by the page, not written in its text; a translation inherits them. *@
            <span class="wiki-edit-taglabel">@Loc["NavWikiCategories"]</span>
            @foreach (var category in Article.Categories)
            {
                var c = category;
                @if (IsNamespaceCategory(c))
                {
                    @* Every page in this namespace is in it; the server puts it back, so it has no remove button. *@
                    <span class="wiki-edit-tag wiki-edit-tag--fixed" title="@string.Format(Loc["WkCategoryFromNamespace"], NamespaceLabel)">
                        @WikiCategories.Display(c, CategoryNames)
                        <MudIcon Icon="@Icons.Material.Outlined.Lock" Size="Size.Small" aria-label="@string.Format(Loc["WkCategoryFromNamespace"], NamespaceLabel)" />
                    </span>
                }
                else
                {
                    <span class="wiki-edit-tag">@WikiCategories.Display(c, CategoryNames)
                        <button type="button" disabled="@IsTranslation" @onclick="@(() => RemoveCategory(c))">×</button>
                    </span>
                }
            }
            <input class="wiki-edit-taginput" value="@_categoryEntry"
                   disabled="@IsTranslation"
                   @oninput="@(e => _categoryEntry = e.Value?.ToString() ?? string.Empty)"
                   @onkeydown="OnCategoryKeyDown" placeholder="@Loc["WkAddCategory"]" />
            <div style="flex:1;"></div>
            <label class="wiki-edit-pub">
                <input type="checkbox" checked="@Article.Published"
                       @onchange="@(e => Article.Published = (bool)(e.Value ?? false))" />
                @Loc["WikiPublished"]
            </label>
        </div>

        @if (IsTranslation)
        {
            <div class="wiki-edit-inherited">
                <MudIcon Icon="@Icons.Material.Filled.Info" Style="font-size:0.75rem;" />
                <span>@Loc["WkInheritedFromSource"]</span>
            </div>
        }

        <div class="wiki-edit-savebar toolbar-row">
            <div class="wiki-edit-summary">
                <MudIcon Icon="@Icons.Material.Filled.Edit" Style="font-size:0.875rem;color:var(--text-faint);" />
                <input value="@_summary" @oninput="@(e => _summary = e.Value?.ToString() ?? string.Empty)"
                       placeholder="@Loc["WkSummaryPlaceholder"]" />
            </div>
            <button type="button" class="wiki-edit-minor" @onclick="@(() => _minor = !_minor)">
                <span class="wiki-edit-check @(_minor ? "on" : "")">
                    @if (_minor) { <MudIcon Icon="@Icons.Material.Filled.Check" Style="font-size:0.6875rem;color:var(--accent-on);" /> }
                </span>
                @Loc["WkMinorEdit"]
            </button>
            <span class="wiki-edit-delta" style="@(ByteDelta >= 0 ? "color:var(--accent);" : "color:var(--danger);")">
                @Loc.Plural("WkBytesDelta", "count", Math.Abs(ByteDelta), "signed", SignedByteDelta)
            </span>
            <div class="wiki-edit-savediv"></div>
            <button type="button" class="wiki-btn" @onclick="OnCancel" disabled="@_saving">@Loc["WkDiscard"]</button>
            <button type="button" class="wiki-edit-publish" @onclick="HandleSave" disabled="@_saving">
                <MudIcon Icon="@Icons.Material.Filled.Check" Style="font-size:0.875rem;" />
                @(_saving ? Loc["Saving"] : Loc["WkPublishChanges"])
            </button>
        </div>

        @if (_errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_errorMessage</MudAlert>
        }

        <div class="wiki-edit-foot">
            <span>@Loc["WkPublishNotice"]</span>
            <a href="/wiki/help/markdown_guide" target="_blank">@Loc["WkFormattingHelp"]</a>
        </div>
    </div>
}

@code {
    [Parameter] public required WikiArticle? Article { get; set; }

    /// <summary>
    /// Each category's name in the edited language (its category page's title, translated); a category
    /// with no page, or none given, shows its key.
    /// </summary>
    [Parameter] public IReadOnlyDictionary<string, string>? CategoryNames { get; set; }

    /// <summary>The page's namespace; the categories it puts every page in are shown fixed.</summary>
    [Parameter] public string? Namespace { get; set; }

    /// <summary>Invoked after a successful save with the updated article.</summary>
    [Parameter] public EventCallback<WikiArticle> OnSaved { get; set; }

    /// <summary>Invoked when the user clicks Cancel/Discard.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>The page's stamped source locale. Editing this locale edits the page itself.</summary>
    [Parameter] public string SourceLocale { get; set; } = "en";

    /// <summary>The locale currently being edited. Equal to <see cref="SourceLocale"/> for the source page.</summary>
    [Parameter] public string SelectedLocale { get; set; } = "en";

    /// <summary>Source locale plus every existing translation's locale.</summary>
    [Parameter] public IReadOnlyList<string> AvailableLocales { get; set; } = [];

    /// <summary>Raised when the editor switches to a different locale, so the host can load its content.</summary>
    [Parameter] public EventCallback<string> OnLocaleChanged { get; set; }

    /// <summary>Free-text tag for "Add a translation…", so a game can translate into any real locale.</summary>
    private string _customLocale = string.Empty;
    private bool _addingLocale;

    /// <summary>
    /// True when the selected locale is a different language from the source, i.e. we are editing an
    /// overlay row rather than the page. Categories and protection are inherited in that case, and
    /// <c>WikiTranslation</c> has no field for them — the disabled controls make that visible.
    /// </summary>
    private bool IsTranslation => !WikiHelpers.SameLanguage(SelectedLocale, SourceLocale);

    /// <summary>
    /// Public mirror of <see cref="IsTranslation"/> so the host and component tests can tell whether a save
    /// goes to the translation endpoint (and therefore carries an expected revision number) or to the
    /// page-update endpoint.
    /// </summary>
    public bool IsTranslationEdit => IsTranslation;

    /// <summary>Switches the editor to another locale. Public so component tests can drive it directly.</summary>
    public async Task SelectLocaleAsync(string locale)
    {
        _addingLocale = false;
        if (string.Equals(locale, SelectedLocale, StringComparison.OrdinalIgnoreCase)) return;
        await OnLocaleChanged.InvokeAsync(locale);
    }

    private async Task AddCustomLocaleAsync()
    {
        // The free-text field is a write path in spirit: whatever is typed here ends up as a stored Locale,
        // so it is canonicalised and rejected here rather than being sent for the server to refuse.
        // NormalizeLocale's Error case is silently ignored rather than surfaced, because the field is
        // validated as-you-type by the same rule and an empty selection is the visible feedback.
        if (WikiHelpers.NormalizeLocale(_customLocale) is not string normalized) return;
        _customLocale = string.Empty;
        await SelectLocaleAsync(normalized);
    }

    private string LocaleLabel(string locale) =>
        WikiHelpers.SameLanguage(locale, SourceLocale)
            ? string.Format(Loc["WkSourceLocaleLabel"], PortalLocales.DisplayName(locale))
            : PortalLocales.DisplayName(locale);

    private ElementReference _title;
    private ElementReference _source;
    private bool _arrived;

    /// <summary>Opening the editor focuses the title of a page that has none yet, else the source.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_arrived || Article is null) return;
        _arrived = true;
        try
        {
            await JsRuntime.InvokeVoidAsync("sharpmushInputFocus.arrive", string.IsNullOrWhiteSpace(Article.Title) ? _title : _source);
        }
        catch (JSException)
        {
            // No focus script: the fields are still there to click.
        }
    }

    private readonly string _taId = $"wiki-edit-ta-{Guid.NewGuid():N}";
    private bool _saving;
    private bool _showAssetPicker;
    private string? _errorMessage;
    private string _categoryEntry = string.Empty;
    private string _summary = string.Empty;
    private bool _minor;
    private int _initialBytes;

    protected override void OnParametersSet()
        => _initialBytes = Article is null ? 0 : System.Text.Encoding.UTF8.GetByteCount(Article.Content);

    private int ByteDelta => Article is null
        ? 0
        : System.Text.Encoding.UTF8.GetByteCount(Article.Content) - _initialBytes;

    private string SignedByteDelta => ByteDelta >= 0
        ? $"+{ByteDelta}"
        : ByteDelta.ToString(System.Globalization.CultureInfo.CurrentCulture);

    private async Task Wrap(string before, string after, bool block)
    {
        try
        {
            await JsRuntime.InvokeVoidAsync("SharpMUSH.Wiki.wrap", _taId, before, after, block);
        }
        catch (JSException ex)
        {
            // The toolbar is a convenience over typing the markdown by hand, which still works.
            Logger.LogWarning(ex, "Wiki editor toolbar could not wrap the selection");
        }
    }

    private void AddCategory()
    {
        if (Article is null) return;
        // Kept as typed: a new category's page is titled with it, so its capitals survive.
        WikiCategories.Add(Article.Categories, _categoryEntry);
        _categoryEntry = string.Empty;
    }

    private void RemoveCategory(string category) => Article?.Categories.Remove(category);

    private bool IsNamespaceCategory(string category) =>
        WikiHelpers.NamespaceCategories(Namespace).Contains(WikiCategories.Key(category));

    private string NamespaceLabel => WikiHelpers.CategoryLabel(Namespace ?? string.Empty);

    private void OnCategoryKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") AddCategory();
    }

    private static string FenceIssueKey(MarkdownFenceProblem problem) => problem switch
    {
        MarkdownFenceProblem.Unnamed => "WkFenceUnnamed",
        MarkdownFenceProblem.Unclosed => "WkFenceUnclosed",
        MarkdownFenceProblem.OutsideItem => "WkFenceOutsideItem",
        _ => "WkFenceItemOutsideFlex"
    };

    private void InsertAssetMarkdown(string snippet)
    {
        if (Article is null) return;
        var separator = Article.Content.Length == 0 || Article.Content.EndsWith('\n') ? "\n" : "\n\n";
        Article.Content += $"{separator}{snippet}\n";
        _showAssetPicker = false;
    }

    private async Task HandleSave()
    {
        if (Article is null) return;
        _saving = true;
        _errorMessage = null;
        try
        {
            await OnSaved.InvokeAsync(Article);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
