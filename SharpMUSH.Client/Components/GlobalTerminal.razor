@using SharpMUSH.Client.Models
@using SharpMUSH.Client.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Hosting
@using Microsoft.JSInterop
@inject IJSRuntime JsRuntime
@inject AccountAuthService AccountAuth
@inject IWebAssemblyHostEnvironment HostEnv
@inject NavigationManager Navigation
@inject ServerInfoService ServerInfo
@inject IStringLocalizer<SharedResource> Loc
@inject CommandHistory History
@inject ScreenReaderMode ScreenReader
@implements IAsyncDisposable

<div class="sharp-terminal-container" style="background:var(--surface-3);color:var(--text);font-family:var(--font-mono);font-size:0.84375rem;">

    @* With an input line, a plain click in the output focuses it, as a terminal does (input-focus.js).
       A log: a screen reader reads each new line as it arrives on the terminal the player types into, and
       the background terminal in the drawer stays quiet. It takes focus so the keyboard can scroll it. In
       Screen reader mode the announcer below reads instead, leaving out the player's own commands. *@
    <div id="@_outputId"
         class="sharp-terminal-output" data-input-region="@Interactive"
         role="log" aria-live="@(Interactive && !ScreenReader.On ? "polite" : "off")" aria-label="@Loc["TermOutputLabel"]" tabindex="0"
         style="flex:1;min-height:0;overflow:auto;white-space:pre-wrap;word-break:break-word;line-height:1.6;">
        @* When MinColumns is set (the /play terminal asks for 78), this inner track holds a
           floor width of that many characters. On a narrow screen the output scrolls
           horizontally rather than wrapping 78-col content down to the phone's ~50 columns —
           and the measured NAWS is floored to match (see OnTerminalResize). *@
        <div class="sharp-terminal-track" style="@(TargetColumns > 0 ? $"min-width:{TargetColumns}ch;" : "")">
            @* Keyed, so a full scrollback drops its oldest line instead of rewriting every line in place, which
               the log would read out again from the top. *@
            @foreach (var line in _transcript.Lines)
            {
                <div @key="line" class="@GetLineClass(line.Source)" title="@line.Timestamp.ToString("HH:mm:ss")">@((Microsoft.AspNetCore.Components.MarkupString)line.Html)</div>
            }
            <div id="@_bottomId"></div>
        </div>
    </div>
    @* Shown by portal-interop.js while the player has scrolled up to reread (sharp-terminal--reading); it
       says so when output has arrived meanwhile (sharp-terminal--new). *@
    <button type="button" class="sharp-terminal-jump" @onclick="JumpToLatestAsync">
        <MudIcon Icon="@Icons.Material.Filled.ArrowDownward" Style="font-size:1rem;" />
        <span class="sharp-terminal-jump-latest">@Loc["TermJumpLatest"]</span>
        <span class="sharp-terminal-jump-new">@Loc["TermNewLinesBelow"]</span>
    </button>

    @if (ShowConnectionBar)
    {
        <div class="sharp-terminal-connbar">
            <MudChip T="string"
                     Size="Size.Small"
                     Color="@(_connected ? Color.Success : Color.Error)"
                     Style="min-width:90px;justify-content:center;">
                @(_connected ? Loc["Connected"] : Loc["Disconnected"])
            </MudChip>

            @if (!_connected)
            {
                <div style="flex:1"></div>
                @if (AccountAuth.IsLoggedIn)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               OnClick="ConnectAsync">@Loc["Connect"]</MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                               OnClick='() => Navigation.NavigateTo("/login")'>@Loc["Login"]</MudButton>
                }
            }
            else
            {
                <MudText Typo="Typo.caption" Style="color:var(--text-faint);flex:1;">
                    @(_playerName ?? Loc["TermNotLoggedIn"].Value)
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                           OnClick="DisconnectAsync">@Loc["Disconnect"]</MudButton>
            }
        </div>
    }

    @if (Interactive)
    {
        <LiveAnnouncer @ref="_announcer" Label="@Loc["TermLatestLines"]" />
        <div class="sharp-terminal-input">
            <span class="term-prompt" aria-hidden="true">›</span>
            @* The page's main text box (input-focus.js): focused once the connection is up, and where typing on the
               page goes. Enter sends, so a touch keyboard labels it Send. *@
            @* data-review-keys: Alt and a number reads a recent line again (layout.js reviewKeys). *@
            <input class="term-input" @ref="_inputRef" data-primary-input="end" enterkeyhint="send"
                   data-review-keys="@(ScreenReader.On ? "on" : null)"
                   value="@_input"
                   @oninput="OnInput"
                   @onkeydown="OnInputKeyDown"
                   disabled="@(!_connected)" aria-label="@Loc["TermInputLabel"]"
                   placeholder="@Loc["TermInputPlaceholder"]" />
            <button type="button" class="term-send" @onclick="SendFromButtonAsync" disabled="@(!_connected)" title="@Loc["Send"]" aria-label="@Loc["Send"]">
                <MudIcon Icon="@Icons.Material.Filled.Send" Style="font-size:0.875rem;" />
            </button>
            @if (ShowClearButton)
            {
                <button type="button" class="term-clear" @onclick="ClearAsync" title="@Loc["TermClearTerminal"]" aria-label="@Loc["TermClearTerminal"]">
                    <MudIcon Icon="@Icons.Material.Filled.ClearAll" Style="font-size:0.9375rem;" />
                </button>
            }
        </div>
    }
</div>

@code {
    /// <summary>
    /// WebSocket endpoint the terminal connects to. When unset, it is derived from the portal's
    /// own origin: <c>wss://&lt;host&gt;/ws</c> on a deployed site (the edge routes <c>/ws</c> to
    /// the connection server — see deploy/README.md), or <c>ws://localhost:4202/ws</c> when the
    /// portal itself runs on localhost, where the connection server listens on its own port.
    /// </summary>
    [Parameter] public string? DefaultServerUri { get; set; }

    /// <summary>
    /// The terminal service this instance renders and drives. Required — each render site names its
    /// own terminal (the command terminal in the drawer, the play terminal on /play), so there is no
    /// ambient default that another caller could accidentally reach.
    /// </summary>
    [Parameter, EditorRequired] public ITerminalService Terminal { get; set; } = default!;

    /// <summary>
    /// Whether this terminal shows the connection/auto-login <c>[DBG]</c> diagnostic lines.
    /// These are useful on the command terminal while developing the auto-connect flow but
    /// are noise on the player-facing /play terminal, so it opts out. Diagnostics are
    /// additionally gated to the Development environment so production stays clean.
    /// </summary>
    [Parameter] public bool ShowDiagnostics { get; set; } = true;

    /// <summary>
    /// When set (the /play terminal), an anonymous visitor auto-connects as a temporary game guest
    /// (<c>connect guest</c>) instead of staying disconnected. The command terminal leaves this off —
    /// guests don't get a building/softcode surface.
    /// </summary>
    [Parameter] public bool AllowGuest { get; set; }

    /// <summary>Whether the inline Clear button shows in the input row. The /play terminal sets
    /// this false because Clear lives in its settings menu instead.</summary>
    [Parameter] public bool ShowClearButton { get; set; } = true;

    /// <summary>Whether the status, character and Connect/Disconnect row shows. The /play terminal sets
    /// this false because its card header carries them, through <see cref="ConnectAsync"/> and
    /// <see cref="DisconnectAsync"/>.</summary>
    [Parameter] public bool ShowConnectionBar { get; set; } = true;

    /// <summary>
    /// Whether this terminal accepts typed commands. The /play terminal is interactive; the
    /// always-mounted global/command terminal in the drawer is a read-only diagnostics view
    /// (a background portal-class query connection used for OOB queries), so it sets this false to
    /// drop the command input row. The output, scrollback, and connbar remain in both modes.
    /// </summary>
    [Parameter] public bool Interactive { get; set; } = true;

    /// <summary>
    /// The player's preferred terminal width in character columns (min 78). When set (the
    /// /play terminal), the font is auto-scaled so exactly this many columns fill the available
    /// width — bigger on a roomy screen, smaller on a tight one — and this column count is what
    /// is reported to the server over NAWS (so server-side <c>wrap()</c> / line layout matches
    /// what the player sees). The output gets a matching <c>{n}ch</c> min-width track. 0 = no
    /// preference, measure the natural grid at the base font.
    /// </summary>
    [Parameter] public int TargetColumns { get; set; }


    /// <summary>Writes a diagnostic line only when this terminal opted in and we are in dev.</summary>
    private void DebugLine(string text)
    {
        if (ShowDiagnostics && HostEnv.IsDevelopment())
            AddLocalLine(text, TerminalLineSource.System);
    }

    // Unique IDs per instance so multiple terminals on the same page don't conflict
    private readonly string _outputId = $"sharp-terminal-output-{Guid.NewGuid():N}";
    private readonly string _bottomId = $"sharp-terminal-bottom-{Guid.NewGuid():N}";

    private string _serverUri = string.Empty;
    private string _input = string.Empty;
    private bool _connected;

    /// <summary>
    /// The connbar's identity label, derived live rather than cached: caching this per-terminal was
    /// the root cause of two earlier stale-identity bugs — the connbar showing "not logged in" after
    /// <c>RecreateAsync</c>'s disconnect announcement during a character switch (nothing ever
    /// restored a nulled cache), and a remounted terminal showing the roster's first character
    /// instead of the actually-active one.
    /// <para>
    /// Prefers <c>Terminal.ConnectedPlayerName</c> when set, falling back to
    /// <see cref="AccountAuthService.ActiveCharacter"/>. Account-based connects (auto-login,
    /// dev-debug) never write <c>Terminal.ConnectedPlayerName</c> — see <see cref="SetPlayerName"/> —
    /// so they fall through to <c>ActiveCharacter</c>. A typed <c>connect &lt;name&gt; ...</c> sets
    /// only <c>Terminal.ConnectedPlayerName</c> and never touches <c>AccountAuth</c>, so it needs the
    /// primary read here.
    /// </para>
    /// </summary>
    private string? _playerName => string.IsNullOrEmpty(Terminal.ConnectedPlayerName)
        ? AccountAuth.ActiveCharacter?.Name
        : Terminal.ConnectedPlayerName;

    // Initialized with the service's lines in OnInitializedAsync; this terminal's view of them.
    private TerminalTranscript _transcript = new([]);
    private bool _autoScroll = true;

    private DotNetObjectReference<GlobalTerminal>? _selfRef;
    private IJSObjectReference? _cmdLinkHandle;
    private DotNetObjectReference<GlobalTerminal>? _metricsRef;
    private IJSObjectReference? _metricsHandle;
    private int _lastCols;
    private int _lastRows;
    private bool _hasMeasured;
    private int _observedTarget = -1;

    // When the player changes their preferred width, push it to the metrics observer so it
    // refits the font and reports the new column count over NAWS.
    protected override async Task OnParametersSetAsync()
    {
        if (_metricsHandle is not null && TargetColumns != _observedTarget)
        {
            _observedTarget = TargetColumns;
            try { await JsRuntime.InvokeVoidAsync("SharpMUSH.Metrics.setTarget", _outputId, TargetColumns); }
            catch (JSException) { /* ignore if JS not ready */ }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _serverUri = string.IsNullOrWhiteSpace(DefaultServerUri)
            ? TerminalEndpoint.Resolve(Navigation.BaseUri)
            : DefaultServerUri;
        _connected = Terminal.IsConnected;

        _transcript = new TerminalTranscript(Terminal.Lines);

        Terminal.LineReceived += OnLineReceived;
        Terminal.ConnectionStateChanged += OnConnectionChanged;
        ScreenReader.Changed += OnScreenReaderChanged;
        AccountAuth.ActiveCharacterChanged += OnActiveCharacterChanged;
        if (Terminal is TerminalServiceHost host) host.Recreated += OnRecreated;

        // Restore account session (sessionStorage is tab-scoped)
        await AccountAuth.InitAsync();

        DebugLine($"[DBG] init: connected={_connected} isLoggedIn={AccountAuth.IsLoggedIn}");

        // Every auto-connect below reaches the connection gateway, which is routinely down, restarting,
        // or simply not running in a partial dev stack. Letting that escape here is fatal out of all
        // proportion: this component mounts from MainLayout, so one refused socket replaces every page
        // in the app with Blazor's "unhandled error" bar. Report it the way the manual Connect button
        // already does and leave the terminal disconnected but usable.
        if (!_connected)
        {
            try
            {
                if (HostEnv.IsDevelopment() && !AccountAuth.IsLoggedIn && !AccountAuth.ExplicitlyLoggedOut)
                {
                    // In dev, the Blazor AuthStateProvider hasn't necessarily run yet, so
                    // AccountAuth.IsLoggedIn may still be false.  Call GetDebugOttAsync()
                    // directly — it both populates AccountSessionToken and returns the OTT
                    // in one round-trip, avoiding any ordering dependency.
                    // Guarded by ExplicitlyLoggedOut (mirrors MainLayout): GlobalTerminal is mounted
                    // on nearly every page via MainLayout, so without this guard, any reload/nav
                    // after an explicit logout would silently re-authenticate as the debug admin.
                    DebugLine("[DBG] dev path: fetching debug OTT");
                    var debugOtt = await AccountAuth.GetDebugOttAsync();
                    DebugLine($"[DBG] dev path: ott={(debugOtt?.Token is null ? "NULL" : "OK")} account={(debugOtt?.AccountId is null ? "NULL" : "OK")}");
                    if (debugOtt?.Token is not null)
                    {
                        SetPlayerName(debugOtt.PlayerName);
                        // The debug OTT is always for #1, so its name stands in for the character here.
                        var identity = debugOtt.AccountUsername is { } account
                            ? new TerminalIdentity(account, debugOtt.PlayerName)
                            : (TerminalIdentity?)null;
                        await Terminal.ConnectWithOttAsync(_serverUri, debugOtt.Token, identity);
                    }
                }
                else if (AccountAuth.IsLoggedIn)
                {
                    // Read the roster off the service rather than the call's result: it assigns
                    // Characters on success and leaves it untouched on failure, so a failed fetch
                    // leaves nothing to connect as — which is what should happen.
                    if (AccountAuth.Characters.Count == 0)
                        await AccountAuth.GetCharactersAsync();
                    var target = AccountAuth.ActiveCharacter ?? AccountAuth.Characters.FirstOrDefault();
                    if (target is not null)
                        await ConnectAsCharacterAsync(target);
                }
                else if (AllowGuest && await ServerInfo.GuestLoginsEnabledAsync())
                {
                    await Terminal.ConnectAsGuestAsync(_serverUri);
                }
            }
            catch (Exception ex) { AddLocalLine(Loc["TermErrorLine", ex.Message], TerminalLineSource.System); }
        }

        DebugLine($"[DBG] init done: connected={Terminal.IsConnected} isLoggedIn={AccountAuth.IsLoggedIn}");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            try
            {
                _cmdLinkHandle = await JsRuntime.InvokeAsync<IJSObjectReference>(
                    "SharpMUSH.Terminal.attachCommandLinks", _outputId, _selfRef);
            }
            catch (JSException) { /* ignore if JS not ready */ }
            // Disposed while that call was out (a route that mounts the terminal and leaves at once):
            // DisposeAsync found no handle to release, so this releases it.
            if (_disposed)
            {
                await ReleaseAsync(_cmdLinkHandle);
                return;
            }

            _metricsRef = DotNetObjectReference.Create(this);
            try
            {
                _metricsHandle = await JsRuntime.InvokeAsync<IJSObjectReference>(
                    "SharpMUSH.Metrics.observe", _outputId, _metricsRef, TargetColumns);
                _observedTarget = TargetColumns;
            }
            catch (JSException) { /* ignore if JS not ready */ }
            // Likewise: left attached, the resize observer goes on calling OnTerminalResize through a
            // reference DisposeAsync already let go of ("There is no tracked object with id ...").
            if (_disposed)
            {
                await ReleaseAsync(_metricsHandle);
                return;
            }
        }

        if (_autoScroll)
            await ScrollToBottomAsync();

        // The input line is enabled once the connection is up: that is when the page is ready to type in.
        if (Interactive && !_reviewKeys)
        {
            _reviewKeys = true;
            try { await JsRuntime.InvokeVoidAsync("sharpmushLayout.reviewKeys", _inputRef, _selfRef); }
            catch (JSException) { /* no layout script: the output can still be read with the reader's own keys */ }
        }

        if (Interactive && _connected && !_arrived)
        {
            _arrived = true;
            try { await JsRuntime.InvokeVoidAsync("sharpmushInputFocus.arrive", _inputRef); }
            catch (JSException) { /* no focus script: the input is still there to click */ }
        }
    }

    private bool _arrived;

    /// <summary>
    /// Invoked from JS when a command link (&lt;a xch_cmd="..."&gt;) is clicked in the
    /// terminal output. Sends the command exactly as if the player had typed it.
    /// </summary>
    [JSInvokable]
    public async Task RunCommandLinkAsync(string command)
    {
        if (string.IsNullOrWhiteSpace(command) || !_connected) return;
        await Terminal.SendAsync(command);
    }

    /// <summary>
    /// Invoked from JS (via SharpMUSH.Metrics.observe) when the terminal output
    /// element is resized. Sends a NAWS control frame so the server knows the
    /// client's character-grid dimensions.
    /// </summary>
    [JSInvokable]
    public async Task OnTerminalResize(int cols, int rows)
    {
        // cols already reflects the player's preferred width when TargetColumns is set (the fit
        // returns exactly that), so this is what we report to the server over NAWS.

        // Remember the grid even before the socket connects (the first measurement fires on
        // fonts-ready, which can precede connect). The remembered size is then sent once the
        // connection is established (see OnConnectionChanged), so a connection that never resizes
        // still reports its NAWS.
        _lastCols = cols;
        _lastRows = rows;
        _hasMeasured = true;
        if (Terminal.IsConnected)
            await SendNawsAsync(cols, rows);
    }

    private Task SendNawsAsync(int cols, int rows) =>
        Terminal.SendControlAsync(TerminalInput.NawsFrame(cols, rows));

    /// <summary>
    /// Records the connected player's name on the underlying terminal service. <c>_playerName</c>
    /// reads this back directly, preferring it over <c>AccountAuth.ActiveCharacter</c>, and
    /// Play.razor's page header reads it off the play terminal instance the same way
    /// (<c>PlayTerminal.ConnectedPlayerName ?? Loc["NavPlayTerminal"]</c>). Direct/manual "Character" tab
    /// and typed-<c>connect</c> flows depend on this write — they never touch <c>AccountAuth</c> at
    /// all. The single-character auto-login and dev-debug OTT paths call this too (matching the
    /// character they just resolved), but that is redundant rather than load-bearing: those paths
    /// also land on the same character via <c>AccountAuth.ActiveCharacter</c>, which
    /// <see cref="_playerName"/> falls back to. The multi-character picker/switch paths never call
    /// this, so they rely on the <c>ActiveCharacter</c> fallback outright.
    /// </summary>
    private void SetPlayerName(string? name) => Terminal.ConnectedPlayerName = name;

    /// <summary>Connects this terminal (the override on /play, else the command terminal) as the given character.</summary>
    private async Task<bool> ConnectAsCharacterAsync(AccountAuthService.CharacterSummary character)
    {
        if (await AccountAuth.GetOttForCharacterAsync(character) is not string ott) return false;

        AccountAuth.SetActiveCharacter(character);
        SetPlayerName(character.Name);
        await Terminal.ConnectWithOttAsync(_serverUri, ott, TerminalIdentity.Of(AccountAuth.Username, character));
        return true;
    }

    /// <summary>Connects as the active character, else the account's first; the connbar's Connect.</summary>
    public async Task ConnectAsync()
    {
        var target = AccountAuth.ActiveCharacter ?? AccountAuth.Characters.FirstOrDefault();
        if (target is null) return;

        try
        {
            await ConnectAsCharacterAsync(target);
        }
        catch (Exception ex) { AddLocalLine(Loc["TermErrorLine", ex.Message], TerminalLineSource.System); }
    }

    /// <summary>The connbar's Disconnect.</summary>
    public async Task DisconnectAsync()
    {
        SetPlayerName(null);
        await Terminal.DisconnectAsync();
    }

    /// <summary>Send, clicked: focus goes back to the input line for the next command.</summary>
    private async Task SendFromButtonAsync()
    {
        await SendAsync();
        try
        {
            await _inputRef.FocusAsync();
        }
        catch (InvalidOperationException)
        {
            // Not on the page any more: nothing to focus.
        }
    }

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(_input) || !_connected) return;

        // Track player name when a manual 'connect <name> ...' is typed
        if (TerminalInput.TypedConnectName(_input) is string typedName)
            SetPlayerName(typedName);

        await Terminal.SendAsync(_input);
        await History.AddAsync(_input);
        // Sending is reading the latest again, as in a telnet client.
        await JumpToLatestAsync();
        _historyWalk.Reset();
        _input = string.Empty;
    }

    private readonly HistoryWalk _historyWalk = new();

    private void OnInput(ChangeEventArgs e)
    {
        _input = e.Value?.ToString() ?? string.Empty;
        _historyWalk.Reset();
    }

    /// <summary>Clears the terminal's display buffer. Public so a host page (e.g. /play, which
    /// moves Clear into its settings menu) can trigger it via an @@ref.</summary>
    public void ClearOutput()
    {
        _transcript.Clear();
        StateHasChanged();
    }

    private ElementReference _inputRef;

    /// <summary>Puts <paramref name="text"/> in the input line and focuses it, for the player to finish (Play's "page Name=").</summary>
    public async Task SetInputAsync(string text)
    {
        _input = text;
        StateHasChanged();
        try
        {
            await _inputRef.FocusAsync();
        }
        catch (Exception e) when (e is InvalidOperationException or JSException)
        {
            // Not attached yet: the text is there, the focus stays where it was.
        }
    }

    private Task ClearAsync()
    {
        ClearOutput();
        return Task.CompletedTask;
    }

    /// <summary>Enter sends; Up and Down walk the command history, as a telnet client's input line does.</summary>
    private async Task OnInputKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Enter":
                await SendAsync();
                break;
            case "ArrowUp":
                await History.LoadAsync();
                if (_historyWalk.Older(History.Entries, _input) is { } older) _input = older;
                break;
            case "ArrowDown":
                if (_historyWalk.Newer(History.Entries) is { } newer) _input = newer;
                break;
        }
    }

    private void OnLineReceived(TerminalLine line)
    {
        _transcript.Add(line);
        // The player's own command is not read back: they have just typed it.
        if (ScreenReader.On && line.Source != TerminalLineSource.Client && Spoken(line) is { Length: > 0 } said)
            _announcer?.Announce(said);
        InvokeAsync(StateHasChanged);
    }

    private LiveAnnouncer? _announcer;
    private bool _reviewKeys;

    /// <summary>
    /// Alt and a number in the command box, in Screen reader mode (layout.js): reads the <paramref name="back"/>th
    /// newest line again, 1 the newest and 10 (Alt+0) the tenth. The player's own commands are not counted.
    /// </summary>
    [JSInvokable]
    public Task ReviewLine(int back) => InvokeAsync(() =>
    {
        var said = _transcript.Lines
            .Where(l => l.Source != TerminalLineSource.Client)
            .Reverse()
            .Select(Spoken)
            .Where(s => s.Length > 0)
            .Skip(back - 1)
            .FirstOrDefault();
        _announcer?.Announce(said ?? Loc["TermReviewNone"]);
    });

    /// <summary>
    /// What a screen reader hears for <paramref name="line"/>: its markup read as a page is (a picture's
    /// description, a separator's title, no drawn rules), by layout.js spokenText. The plain text when that is
    /// not to hand.
    /// </summary>
    private string Spoken(TerminalLine line)
    {
        if (JsRuntime is IJSInProcessRuntime js)
        {
            try
            {
                if (js.Invoke<string?>("sharpmushLayout.spokenText", line.Html) is { } said) return said;
            }
            // layout.js not loaded yet: the plain text is read instead.
            catch (JSException) { return line.Text.Trim(); }
        }
        return line.Text.Trim();
    }

    private void OnConnectionChanged(bool connected)
    {
        _connected = connected;
        if (!connected) SetPlayerName(null);
        // Report the grid for this connection now that it's up — covers the case where the initial
        // measurement happened before connect and the user never resizes afterward.
        else
        {
            if (_hasMeasured) _ = SendNawsAsync(_lastCols, _lastRows);
            _ = SendTerminalTypesAsync();
        }
        InvokeAsync(StateHasChanged);
    }

    /// <summary>Says what this terminal is, whether a screen reader reads it included (TerminalInput.TerminalTypesFrame).</summary>
    private async Task SendTerminalTypesAsync()
    {
        await ScreenReader.LoadAsync();
        if (Terminal.IsConnected) await Terminal.SendControlAsync(TerminalInput.TerminalTypesFrame(ScreenReader.On));
    }

    /// <summary>Screen reader mode turned on or off in Settings: the game is told at once.</summary>
    private void OnScreenReaderChanged()
    {
        _ = SendTerminalTypesAsync();
        // Who reads the output, the log or the announcer, and whether the review keys answer.
        _ = InvokeAsync(StateHasChanged);
    }

    // GlobalTerminal is a sibling of MainLayout's own AccountAuth reads, not a child of anything
    // that re-renders it when identity changes on its own — without this, a switch that doesn't
    // also flip the terminal's connection state (there is none today, but this mirrors NavMenu's
    // established pattern defensively) would leave the connbar stale until some unrelated render.
    private void OnActiveCharacterChanged() => InvokeAsync(StateHasChanged);

    /// <summary>A new session behind the facade (a character switch): the old character's lines go with the old one.</summary>
    private void OnRecreated() => InvokeAsync(() =>
    {
        _transcript = new TerminalTranscript(Terminal.Lines);
        StateHasChanged();
    });

    private void AddLocalLine(string text, TerminalLineSource source)
    {
        _transcript.Add(new TerminalLine(DateTime.Now, text, source));
        StateHasChanged();
    }

    /// <summary>Back to the newest line, following new output again.</summary>
    private async Task JumpToLatestAsync()
    {
        try { await JsRuntime.InvokeVoidAsync("SharpMUSH.Terminal.jumpToLatest", _outputId); }
        catch (JSException) { /* ignore if JS not ready */ }
    }

    private async Task ScrollToBottomAsync()
    {
        try { await JsRuntime.InvokeVoidAsync("SharpMUSH.Terminal.scrollToBottom", _outputId); }
        catch { /* ignore if JS not ready */ }
    }

    private static string GetLineClass(TerminalLineSource source) => source switch
    {
        TerminalLineSource.Client => "terminal-line terminal-sent",
        TerminalLineSource.System => "terminal-line terminal-system",
        _ => "terminal-line"
    };

    private bool _disposed;

    /// <summary>Detaches a JS-side helper (its own <c>dispose</c>) and drops the handle to it.</summary>
    private static async Task ReleaseAsync(IJSObjectReference? handle)
    {
        if (handle is null) return;
        try { await handle.InvokeVoidAsync("dispose"); }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException) { /* ignore during teardown */ }
        try { await handle.DisposeAsync(); }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException) { /* ignore during teardown */ }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Terminal.LineReceived -= OnLineReceived;
        Terminal.ConnectionStateChanged -= OnConnectionChanged;
        ScreenReader.Changed -= OnScreenReaderChanged;
        AccountAuth.ActiveCharacterChanged -= OnActiveCharacterChanged;
        if (Terminal is TerminalServiceHost host) host.Recreated -= OnRecreated;

        await ReleaseAsync(_cmdLinkHandle);
        _selfRef?.Dispose();

        await ReleaseAsync(_metricsHandle);
        _metricsRef?.Dispose();
    }
}
