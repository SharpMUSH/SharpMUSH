@* A small picture of a theme: its page with its texture, a card in its frame with "Aa" in its title face, a line
   in its dim text colour, and an accent button. It carries the theme's colours and parts itself, so the rules in
   css/themes/ draw a theme that is not the one in use. *@
<span class="theme-swatch @Class" style="@Style" aria-hidden="true" @attributes="Parts">
    <ThemeTexture Contained="true" />
    <span class="theme-swatch-card">
        <ThemeMarks />
        <span class="theme-swatch-face">Aa</span>
        <span class="theme-swatch-line"></span>
        <span class="theme-swatch-button"></span>
    </span>
</span>

@code {
    [Parameter, EditorRequired] public ResolvedTheme Theme { get; set; } = default!;
    [Parameter] public string? Class { get; set; }

    /// <summary>The colours the swatch and the parts' drawings paint with.</summary>
    private static readonly string[] Colors =
    [
        ThemeTokens.Background, ThemeTokens.Surface, ThemeTokens.Border, ThemeTokens.Text, ThemeTokens.TextDim,
        ThemeTokens.Warn, ThemeTokens.LinkMissing, ThemeTokens.Accent2, ThemeTokens.Accent3,
    ];

    private string Style => string.Concat(Colors.Select(c => $"--{c}:{Theme.Token(c)};")) + $"--accent:{Theme.Accent};";

    private Dictionary<string, object> Parts => Theme.Parts.ToDictionary(p => "data-" + p.Key, p => (object)p.Value);
}
