@using SharpMUSH.Library.Models.Packages
@inject IStringLocalizer<SharedResource> Loc

@* The badge reads lower-case by design; that is a visual treatment applied in CSS, never by
   lower-casing a translated word. *@
<MudTooltip Text="@Loc[TooltipKey]">
    <MudChip T="string" Size="Size.Small" Color="@BadgeColor" Variant="Variant.Filled"
             Style="text-transform:lowercase;">
        @Loc[LabelKey]
    </MudChip>
</MudTooltip>

@code {
    [Parameter] public PackageRemoteTrust Trust { get; set; }

    private Color BadgeColor => Trust switch
    {
        PackageRemoteTrust.Official => Color.Success,
        PackageRemoteTrust.Community => Color.Warning,
        _ => Color.Error
    };

    private string LabelKey => Trust switch
    {
        PackageRemoteTrust.Official => "WidTrustOfficial",
        PackageRemoteTrust.Community => "WidTrustCommunity",
        _ => "WidTrustUnknown"
    };

    private string TooltipKey => Trust switch
    {
        PackageRemoteTrust.Official => "WidTrustOfficialTooltip",
        PackageRemoteTrust.Community => "WidTrustCommunityTooltip",
        _ => "WidTrustUnknownTooltip"
    };
}
