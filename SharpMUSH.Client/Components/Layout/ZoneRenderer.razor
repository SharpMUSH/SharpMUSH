@using SharpMUSH.Library.Models.Portal.Widgets
@using SharpMUSH.Client.Components.Widgets
@using SharpMUSH.Client.Services
@using SharpMUSH.Client.Widgets
@using SharpMUSH.Library.Authorization

@if (_placements.Count > 0)
{
    @if (Grid)
    {
        @* Wrapper carries the container-type: an element is never its own query container. *@
        <div class="zone-grid-container">
            <div class="zone-grid">
                @foreach (var placement in _placements)
                {
                    var descriptor = Registry?.GetWidget(placement.WidgetName);
                    @if (descriptor is not null)
                    {
                        <div class="zone-grid-cell" style="@($"--zone-span:{ClampSpan(placement.Span)};")">
                            <WidgetErrorBoundary WidgetName="@placement.WidgetName">
                                <DynamicComponent Type="@descriptor.ComponentType"
                                                  Parameters="@BuildParams(placement, descriptor)" />
                            </WidgetErrorBoundary>
                        </div>
                    }
                }
            </div>
        </div>
    }
    else
    {
        @foreach (var placement in _placements)
        {
            var descriptor = Registry?.GetWidget(placement.WidgetName);
            @if (descriptor is not null)
            {
                <WidgetErrorBoundary WidgetName="@placement.WidgetName">
                    <DynamicComponent Type="@descriptor.ComponentType"
                                      Parameters="@BuildParams(placement, descriptor)" />
                </WidgetErrorBoundary>
            }
        }
    }
}

@* Grid styling (.zone-grid / .zone-grid-cell) is component-scoped in ZoneRenderer.razor.css; the CSS
   isolation bundle is linked from wwwroot/index.html. Keeping it out of this component's markup also
   keeps the rendered output empty when a zone has no placements. *@

@code {
    [Parameter, EditorRequired] public WidgetZone Zone { get; set; }
    [Parameter, EditorRequired] public LayoutConfiguration? Layout { get; set; }

    /// <summary>When true, widgets lay out in a 12-column grid honoring each placement's <c>Span</c>.</summary>
    [Parameter] public bool Grid { get; set; }

    [Inject] private IWidgetRegistry? Registry { get; set; }

    [Inject] private IServiceProvider Services { get; set; } = default!;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private IReadOnlyList<WidgetPlacement> _placements = [];

    /// <summary>The minimum-role gate, shared with the Play page's aside. Created on first use, since it needs the injected services.</summary>
    private ApplicationWidgetGate? _gate;

    private ApplicationWidgetGate Gate => _gate ??= new ApplicationWidgetGate(Registry, Services);

    /// <summary>Bumped per parameter set, so a resolution that finishes after a newer one is dropped.</summary>
    private int _generation;

    protected override async Task OnParametersSetAsync()
    {
        var generation = ++_generation;
        if (Layout is null)
        {
            _placements = [];
            return;
        }

        var role = AuthState is null
            ? PortalRole.Guest
            : PortalRoleHelper.CurrentRole((await AuthState).User);
        var ordered = Layout.Zones.TryGetValue(Zone, out var list)
            ? list.OrderBy(p => p.Order).ToList()
            : [];

        // An application the catalog has not delivered yet has no role to check. Everything else renders now;
        // such a placement joins once its application is found and admits this viewer.
        _placements = Visible(ordered, role);
        if (await Gate.ResolveAsync(ordered.Select(p => p.WidgetName)) && generation == _generation)
        {
            _placements = Visible(ordered, role);
        }
    }

    private IReadOnlyList<WidgetPlacement> Visible(List<WidgetPlacement> ordered, PortalRole role) =>
        ordered.Where(p => Gate.Admits(p.WidgetName, role)).ToList().AsReadOnly();

    private static int ClampSpan(int span) => span is >= 1 and <= 12 ? span : 12;

    private Dictionary<string, object> BuildParams(WidgetPlacement placement, IPortalWidget descriptor) =>
        Gate.Parameters(placement.WidgetName, descriptor, placement.Config, Zone.ToString());
}
