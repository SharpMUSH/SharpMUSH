@using SharpMUSH.Client.Models.Applications
@using SharpMUSH.Client.Services
@implements IDisposable
@inject IServiceProvider Services
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> Loc

@if (_state.Document is { } document)
{
    @if (!document.IsForm && _state.Form.GlobalError is { } error)
    {
        <div role="alert" class="my-2">@error</div>
    }
    @if (document.IsForm)
    {
        <SchemaFormRenderer Document="document" Data="_state.Data" State="_state.Form" Busy="_state.Busy" ActionHandler="Dispatch" />
    }
    else
    {
        <SchemaViewRenderer Document="document" Data="_state.Data" Busy="_state.Busy" ActionHandler="Dispatch" QuietWhenEmpty="QuietWhenEmpty" />
    }
}

else if (_state.Form.GlobalError is { } diagnostic)
{
    <div role="alert">@diagnostic</div>
}

@if (Nav.ToAbsoluteUri(Nav.Uri).AbsolutePath.StartsWith("/apps/", StringComparison.Ordinal))
{
    <ConfigOptionFocus Ready="@(_state.Document is not null)" />
}

@code {
    [Parameter] public PortalSchemaDocument? Document { get; set; }
    [Parameter] public SchemaData? Data { get; set; }
    [Parameter] public bool QuietWhenEmpty { get; set; }

    /// <summary>The data route, filled in, that the view's <c>refresh</c> fetches again. Without one it never refreshes.</summary>
    [Parameter] public string? DataUrl { get; set; }
    private readonly SchemaApplicationState _state = new();
    private PortalSchemaDocument? _loadedDocument;
    private SchemaData? _loadedData;
    private bool _disposed;
    private string _locationIdentity = string.Empty;
    private AccountAuthService? _auth;
    private string _instance = Guid.NewGuid().ToString("N");
    private IPortalVisibility? _visibility;
    private CancellationTokenSource? _timer;
    private (TimeSpan? Every, string? Url) _timed;
    private bool _refetching;

    protected override void OnInitialized()
    {
        _locationIdentity = SharpMUSH.Client.Models.Configuration.ConfigurationOptionLocation.LoadIdentity(Nav.Uri);
        Nav.LocationChanged += Leaving;
        _auth = Services.GetService<AccountAuthService>();
        if (_auth is not null) _auth.ActiveCharacterChanged += CharacterChanged;
        _visibility = Services.GetService<IPortalVisibility>();
    }
    private void CharacterChanged()
    {
        _instance = Guid.NewGuid().ToString("N");
        _state.Load(null, null);
        _ = InvokeAsync(StateHasChanged);
    }
    private void Leaving(object? sender, LocationChangedEventArgs args)
    {
        var identity = SharpMUSH.Client.Models.Configuration.ConfigurationOptionLocation.LoadIdentity(args.Location);
        if (_locationIdentity != identity)
        {
            _locationIdentity = identity;
            _instance = Guid.NewGuid().ToString("N");
            _state.Retire();
        }
        RevealOption();
        _ = InvokeAsync(StateHasChanged);
    }
    private void RevealOption()
    {
        if (SharpMUSH.Client.Models.Configuration.ConfigurationOptionLocation.Read(Nav.Uri) is { } key)
            _state.Form.ShowOption(key);
    }
    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(Document, _loadedDocument))
        {
            _instance = Guid.NewGuid().ToString("N");
            _state.Load(Document, Data);
            _loadedDocument = Document;
            _loadedData = Data;
        }
        else if (!ReferenceEquals(Data, _loadedData))
        {
            _state.UpdateData(Data);
            _loadedData = Data;
        }
        RevealOption();
        Time();
    }

    /// <summary>Starts, moves or stops the view's refresh timer to match its document and data route.</summary>
    private void Time()
    {
        var timed = (Document?.RefreshEvery, DataUrl);
        if (timed == _timed) return;
        _timed = timed;
        _timer?.Cancel();
        _timer = null;
        if (timed is not ({ } every, { Length: > 0 })) return;
        _timer = new CancellationTokenSource();
        _ = TickAsync(every, _timer.Token);
    }

    private async Task TickAsync(TimeSpan every, CancellationToken stop)
    {
        using var ticks = new PeriodicTimer(every, Services.GetService<TimeProvider>() ?? TimeProvider.System);
        try
        {
            while (await ticks.WaitForNextTickAsync(stop))
            {
                if (_visibility?.IsVisible ?? true) await InvokeAsync(RefetchAsync);
            }
        }
        catch (OperationCanceledException)
        {
            // Disposed: the page is gone, so the timer stops.
            return;
        }
    }

    /// <summary>
    /// Fetches the data route again and shows what it answers. A form keeps what the player typed, so only a view
    /// refetches; so does nothing while an action is on its way, or another refetch is.
    /// </summary>
    private async Task RefetchAsync()
    {
        if (_disposed || _refetching || _state.Busy || _state.Document is not { IsForm: false } || DataUrl is not { Length: > 0 } url) return;
        _refetching = true;
        try
        {
            if (await Services.GetRequiredService<SchemaAppService>().GetDataAsync(url) is SchemaData data && !_disposed && !_state.Busy)
            {
                _state.UpdateData(data);
                StateHasChanged();
            }
        }
        finally
        {
            _refetching = false;
        }
    }

    private async Task Dispatch(SchemaActionRequest request)
    {
        if (_disposed || _state.Form.Action(request.Action) is not { } action) return;
        var token = _state.Begin();
        if (token == Guid.Empty) return;
        var result = await Services.GetRequiredService<SchemaAppService>().SubmitAsync(action.Route!, _state.Form.Payload(request.Values), _instance);
        if (_disposed || !_state.Apply(token, action, result, Loc["WidActionFailed"])) return;
        if (_state.Skipped.Count > 0)
            Services.GetService<ILogger<SchemaApplicationHost>>()?.LogWarning(
                "[Schema] The reply to {Action} replaces {Keys}, which this page does not have", request.Action, string.Join(", ", _state.Skipped));
        if (_state.Redirect is { } redirect)
        {
            _state.Retire();
            Nav.NavigateTo(redirect);
            return;
        }
        if (_state.Toast is { Length: > 0 } toast) Snackbar.Add(toast, Severity.Success);
    }

    public void Dispose()
    {
        _disposed = true;
        _state.Retire();
        Nav.LocationChanged -= Leaving;
        if (_auth is not null) _auth.ActiveCharacterChanged -= CharacterChanged;
        _timer?.Cancel();
    }
}
