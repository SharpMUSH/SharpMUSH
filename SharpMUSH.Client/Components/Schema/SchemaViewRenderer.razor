@using System.Text.Json
@using SharpMUSH.Client.Models.Applications
@using SharpMUSH.Client.Services
@inject IStringLocalizer<SharedResource> Loc
@inject IServiceProvider Services
@inject ISnackbar Snackbar
@inject NavigationManager Nav

@* Renders a read-only Portal Schema Document (kind:"view"). Pure renderer: all values and their
   per-viewer visibility come from softcode via the data payload. See dynamic-applications.md.
   A view has no inputs, but its buttons and timeline actions still dispatch: they post their own
   values, and the answer may replace the data, the document, or move the page. *@

@if (_document?.Pages is null || !HasAnythingToShow)
{
    @* No document, or every field was filtered out (e.g. a character with no profile data set) — show
       a placeholder instead of collapsing to nothing, so the widget/page never silently disappears. *@
    <MudText Typo="Typo.body2" Class="mud-text-secondary">@Loc["WidNothingToDisplay"]</MudText>
}
else
{
    <div class="schema-view">
        @if (!string.IsNullOrWhiteSpace(_document.Title))
        {
            <h2 class="schema-title">@_document.Title</h2>
        }

        @foreach (var page in _document.Pages.OrderBy(p => p.Order))
        {
            @if (!string.IsNullOrWhiteSpace(page.Title) && _document.Pages.Count > 1)
            {
                <h3 class="schema-page-title">@(page.Title)</h3>
            }

            @foreach (var section in (page.Sections ?? []).OrderBy(s => s.Order))
            {
                var elements = VisibleElements(section).ToList();
                @if (elements.Count > 0)
                {
                    @* D1 §4.4: a section is a card titled with its name. Declared columns are a fixed
                       grid; undeclared, short fields flow into as many columns as fit (board 25's
                       Details row) and long content takes the whole row. *@
                    <KitCard Title="@(string.IsNullOrWhiteSpace(section.Name) ? null : section.Name)" Class="schema-section">
                        <div class="schema-grid @(section.Columns > 1 ? "schema-grid--cols" : "schema-grid--auto")"
                             style="@(section.Columns > 1 ? $"--schema-cols:{section.Columns};" : null)">
                            @foreach (var group in SchemaRendering.GroupButtons(elements))
                            {
                                @if (SchemaRendering.IsButton(group[0]))
                                {
                                    <div class="schema-cell schema-cell--wide schema-button-row">
                                        @foreach (var button in group)
                                        {
                                            @RenderElement(button)
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="schema-cell @(IsWide(group[0]) ? "schema-cell--wide" : null)" style="@SpanStyle(section, group[0])">
                                        @RenderElement(group[0])
                                    </div>
                                }
                            }
                        </div>
                    </KitCard>
                }
            }
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public PortalSchemaDocument? Document { get; set; }

    /// <summary>Data values keyed by field key (value + per-viewer visibility), à la the profile API.</summary>
    [Parameter] public SchemaData? Data { get; set; }

    // What is showing: the parameters, until an action answers with a replacement document or data.
    private PortalSchemaDocument? _document;
    private SchemaData? _data;
    private PortalSchemaDocument? _documentParameter;
    private SchemaData? _dataParameter;
    private bool _busy;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(Document, _documentParameter))
        {
            _document = _documentParameter = Document;
        }

        if (!ReferenceEquals(Data, _dataParameter))
        {
            _data = _dataParameter = Data;
        }
    }

    /// <summary>
    /// Posts a button's or timeline entry's values to its action route and applies the answer: replacement
    /// data or document, a toast, a redirect; errors surface as snackbars (a view has no fields to bind them to).
    /// </summary>
    private async Task DispatchAsync(SchemaActionRequest request)
    {
        if (_document?.Actions is not { } actions || !actions.TryGetValue(request.Action, out var action)
            || string.IsNullOrWhiteSpace(action.Route))
        {
            return;
        }

        // One action at a time: a second click, or a confirmation answered while the first is in
        // flight, is dropped rather than posted twice.
        if (_busy)
        {
            return;
        }

        _busy = true;
        var payload = (request.Values ?? new Dictionary<string, JsonElement>())
            .ToDictionary(kv => kv.Key, kv => (object?)kv.Value, StringComparer.Ordinal);
        SchemaActionResult result;
        try
        {
            result = await Services.GetRequiredService<SchemaAppService>().SubmitAsync(action.Route!, payload);
        }
        finally
        {
            _busy = false;
        }

        if (!result.Ok)
        {
            foreach (var (key, message) in result.Errors ?? new Dictionary<string, string> { ["_global"] = Loc["WidActionFailed"] })
            {
                Snackbar.Add(key == "_global" ? message : $"{key}: {message}", Severity.Error);
            }

            return;
        }

        if (result.Data is not null)
        {
            _data = result.Data;
        }

        if (result.Schema is not null)
        {
            _document = result.Schema;
        }

        if (!string.IsNullOrWhiteSpace(action.OnSuccess?.Toast) || !string.IsNullOrWhiteSpace(result.Message))
        {
            Snackbar.Add(action.OnSuccess?.Toast ?? result.Message!, Severity.Success);
        }

        if (!string.IsNullOrWhiteSpace(result.Redirect))
        {
            Nav.NavigateTo(result.Redirect!);
        }
        else if (!string.IsNullOrWhiteSpace(action.OnSuccess?.Navigate))
        {
            Nav.NavigateTo(action.OnSuccess!.Navigate!);
        }
    }

    /// <summary>True if a title or any visible element exists; otherwise the view would render empty.</summary>
    private bool HasAnythingToShow =>
        !string.IsNullOrWhiteSpace(_document?.Title)
        || (_document?.Pages?.Any(p => (p.Sections ?? []).Any(s => VisibleElements(s).Any())) ?? false);

    private IEnumerable<SchemaElement> VisibleElements(SchemaSection section)
        => (section.Elements ?? []).Where(IsVisible);

    // A declared span in a fixed grid, capped at the section's columns.
    private static string? SpanStyle(SchemaSection section, SchemaElement element)
        => section.Columns > 1 && element.Span > 1 ? $"--schema-span:{Math.Min(element.Span, section.Columns)};" : null;

    // Content too long for a grid cell takes the whole row of an auto grid.
    private static bool IsWide(SchemaElement element) => (element.Kind ?? "field").ToLowerInvariant() switch
    {
        "field" => string.Equals(element.Type, "mstring", StringComparison.OrdinalIgnoreCase),
        _ => true,
    };

    // A field element shows only if its datum exists and the softcode marked it visible. Non-field
    // display elements (markdown/divider/etc.) always show — they carry no per-viewer policy.
    private bool IsVisible(SchemaElement element)
    {
        if (!string.Equals(element.Kind, "field", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(element.Kind, "keyvalue", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        if (element.Kind == "keyvalue")
        {
            return (element.Fields ?? []).Any(IsKeyVisible);
        }

        return element.Key is not null && IsFieldVisible(element);
    }

    // A field shows if the softcode included it and marked it visible (privacy is preserved). When its
    // value is empty it shows only when ShowWhenEmpty (default true), rendering Default in its place.
    private bool IsFieldVisible(SchemaElement element)
    {
        if (_data?.Fields is null || element.Key is null
            || !_data.Fields.TryGetValue(element.Key, out var v) || !v.Visible)
        {
            return false;
        }

        return element.ShowWhenEmpty || !string.IsNullOrEmpty(ValueToString(v.Value));
    }

    private bool IsKeyVisible(string key)
        => _data?.Fields is not null
           && _data.Fields.TryGetValue(key, out var v)
           && v.Visible
           && !string.IsNullOrEmpty(ValueToString(v.Value));

    private RenderFragment RenderElement(SchemaElement element) => __builder =>
    {
        switch ((element.Kind ?? "field").ToLowerInvariant())
        {
            case var kind when SchemaDisplay.Kinds.Contains(kind):
                <SchemaDisplay Element="element" Data="_data" Actions="_document?.Actions" Busy="_busy" OnAction="DispatchAsync" />
                break;

            default:
                var raw = ValueToString(element.Key is not null ? Lookup(element.Key) : null);
                var display = string.IsNullOrEmpty(raw) ? ValueToString(element.Default) : raw;
                <div class="schema-field">
                    @if (!string.IsNullOrWhiteSpace(element.Label))
                    {
                        <div class="schema-label">@element.Label</div>
                    }
                    @if (string.Equals(element.Type, "mstring", StringComparison.OrdinalIgnoreCase))
                    {
                        @* mstring fields carry ANSI/MXP markup — render it the way the terminal does. *@
                        <div class="schema-value schema-value--markup">@((MarkupString)SchemaRendering.MarkupToHtml(display))</div>
                    }
                    else
                    {
                        <div class="schema-value">@display</div>
                    }
                </div>
                break;
        }
    };

    private JsonElement? Lookup(string key)
        => _data?.Fields is not null && _data.Fields.TryGetValue(key, out var v) ? v.Value : null;

    /// <summary>Renders any JSON value as display text (strings unquoted, scalars as written).</summary>
    internal static string ValueToString(JsonElement? value)
    {
        if (value is not { } element)
        {
            return string.Empty;
        }

        return element.ValueKind switch
        {
            JsonValueKind.String => element.GetString() ?? string.Empty,
            JsonValueKind.Null or JsonValueKind.Undefined => string.Empty,
            JsonValueKind.Number or JsonValueKind.True or JsonValueKind.False => element.ToString(),
            _ => element.GetRawText()
        };
    }
}
