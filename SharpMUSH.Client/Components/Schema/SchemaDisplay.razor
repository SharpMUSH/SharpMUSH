@using System.Text.Json
@using SharpMUSH.Client.Models.Applications
@using SharpMUSH.Client.Services
@using SharpMUSH.Library.Models.Portal
@inject IDialogService DialogService
@inject IStringLocalizer<SharedResource> Loc
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IServiceProvider Services

@* One display element of a Portal Schema Document — markdown, image, table, keyvalue, timeline, graph,
   divider, button — drawn from the data payload. Shared by SchemaViewRenderer and SchemaFormRenderer so a form can
   show the same tables and timelines a view does. It sends no requests: a button or a timeline action
   asks the renderer hosting it to dispatch, after confirming when the schema asks it to. *@

@switch (Kind)
{
    case "divider":
        <MudDivider Class="my-2" />
        break;

    case "markdown":
        @if (string.Equals(Element.Format, "mstring", StringComparison.OrdinalIgnoreCase))
        {
            <div class="schema-markdown schema-markup">@((MarkupString)SchemaRendering.MarkupToHtml(Element.Value))</div>
        }
        else
        {
            <div class="schema-markdown">@((MarkupString)SchemaRendering.MarkdownToHtml(Element.Value))</div>
        }
        break;

    case "image":
        var src = Element.SrcField is not null ? SchemaViewRenderer.ValueToString(Lookup(Element.SrcField)) : Element.Value;
        @if (ImageUrlPolicy.IsRenderable(src))
        {
            <img class="schema-image" src="@ApiUrl.Resolve(src!)" alt="@(Element.Alt ?? string.Empty)" loading="lazy" />
        }
        break;

    case "table":
        @RenderTable()
        break;

    case "keyvalue":
        <dl class="schema-kv">
            @foreach (var key in (Element.Fields ?? []).Where(IsKeyVisible))
            {
                <div class="schema-kv-row">
                    <dt class="schema-label">@key</dt>
                    <dd class="schema-value">@RenderKeyValue(key, Lookup(key))</dd>
                </div>
            }
        </dl>
        break;

    case "timeline":
        @RenderTimeline()
        break;

    case "stats":
        @RenderStats()
        break;

    case "chips":
        @RenderChips()
        break;

    case "graph":
        <SchemaGraph Element="Element" Value="@(Element.SrcField is null ? null : Lookup(Element.SrcField))" />
        break;

    case "button":
        <MudButton Variant="@ButtonKinds.Variant(SchemaRendering.ParseButtonKind(Element.Variant, Element.Color))"
                   Color="@ButtonKinds.Color(SchemaRendering.ParseButtonKind(Element.Variant, Element.Color))"
                   Class="mb-2 schema-button"
                   OnClick="@(() => PressAsync())"
                   Disabled="@(Busy || _pending || !CanPress)">
            @(Element.Label ?? Loc["WidAction"].Value)
        </MudButton>
        break;
}

@if (_output is { Count: > 0 } output)
{
    <pre class="schema-click-output" role="status">@string.Join('\n', output)</pre>
}

@code {
    /// <summary>The element kinds this component draws; anything else is the hosting renderer's (fields).</summary>
    public static IReadOnlySet<string> Kinds => SharpMUSH.Library.Models.Portal.Applications.PortalSchema.DisplayKinds;

    [Parameter, EditorRequired] public SchemaElement Element { get; set; } = default!;

    /// <summary>The data payload tables, timelines, images and keyvalues read from.</summary>
    [Parameter] public SchemaData? Data { get; set; }

    /// <summary>The document's actions; a button or timeline action naming one it lacks is disabled.</summary>
    [Parameter] public IReadOnlyDictionary<string, SchemaAction>? Actions { get; set; }

    /// <summary>True while the hosting renderer has an action in flight.</summary>
    [Parameter] public bool Busy { get; set; }

    /// <summary>Raised, after any confirmation, with the action to dispatch and the values to merge in.</summary>
    [Parameter] public EventCallback<SchemaActionRequest> OnAction { get; set; }

    /// <summary>Raised when a click ran the element's command or its dialog was answered.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>What the element's command printed when last clicked, shown under it.</summary>
    private IReadOnlyList<string>? _output;

    private bool Clicks => Element.Command is { Length: > 0 } || Element.Dialog is { Length: > 0 };

    /// <summary>True when a click on the value <paramref name="datum"/> describes has something to run.</summary>
    private bool Clickable(IReadOnlyDictionary<string, string> datum) =>
        Element.Dialog is { Length: > 0 } dialog
            ? SchemaClick.DialogUrl(dialog, datum.GetValueOrDefault("key")) is not null
            : Element.Command is { Length: > 0 } command && SchemaClick.Fill(command, datum) is not null;

    private bool CanPress => CanDispatch(Element.Action) || (string.IsNullOrWhiteSpace(Element.Action) && Clickable(SchemaClick.Datum(Element)));

    private Task PressAsync() => CanDispatch(Element.Action)
        ? RequestAsync(Element.Action, Element.Values, Element.Confirm, Element.Label)
        : ClickAsync(SchemaClick.Datum(Element));

    /// <summary>
    /// A click on a value: opens the element's dialog for it, or runs its command as the viewer and shows what that
    /// printed. Either way the page is told, so it can fetch what changed.
    /// </summary>
    private async Task ClickAsync(IReadOnlyDictionary<string, string> datum)
    {
        if (_pending || Busy || !Clickable(datum)) return;
        _pending = true;
        try
        {
            if (Element.Dialog is { Length: > 0 } dialog)
            {
                var shown = await DialogService.ShowAsync<SchemaDialog>(datum.GetValueOrDefault("label") ?? Element.Label ?? string.Empty,
                    new DialogParameters<SchemaDialog> { { x => x.Url, SchemaClick.DialogUrl(dialog, datum.GetValueOrDefault("key"))! } },
                    new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
                if (await shown.Result is not { Canceled: false }) return;
            }
            else
            {
                _output = await Services.GetRequiredService<GameCommandService>().RunAsync(SchemaClick.Fill(Element.Command!, datum)!) switch
                {
                    PortalCommandResponse response => response.Output,
                    ApiFailure failure => [failure.Message],
                };
            }
            await OnChanged.InvokeAsync();
        }
        finally
        {
            _pending = false;
        }
    }

    /// <summary>A value drawn as a button when a click on it has something to run, else as itself.</summary>
    private RenderFragment Click(IReadOnlyDictionary<string, string> datum, RenderFragment content) => __builder =>
    {
        @if (Clicks && Clickable(datum))
        {
            <button type="button" class="schema-click" disabled="@(Busy || _pending)" @onclick="@(() => ClickAsync(datum))">@content</button>
        }
        else
        {
            @content
        }
    };

    private string Kind => (Element.Kind ?? string.Empty).ToLowerInvariant();

    private bool CanDispatch(string? action)
        => !string.IsNullOrWhiteSpace(action) && Actions?.ContainsKey(action) == true;

    /// <summary>True from a click until its action is answered, so a double click asks and posts once.</summary>
    private bool _pending;

    private async Task RequestAsync(string? action, IReadOnlyDictionary<string, JsonElement>? values, string? confirm, string? title)
    {
        if (_pending || !CanDispatch(action))
        {
            return;
        }

        _pending = true;
        try
        {
            if (!string.IsNullOrWhiteSpace(confirm))
            {
                var confirmed = await DialogService.ShowMessageBoxAsync(
                    title ?? Loc["WidConfirm"].Value, confirm,
                    yesText: Loc["WidConfirm"].Value, cancelText: Loc["Cancel"].Value);
                if (confirmed != true)
                {
                    return;
                }
            }

            await OnAction.InvokeAsync(new SchemaActionRequest(action!, values));
        }
        finally
        {
            _pending = false;
        }
    }

    private JsonElement? Lookup(string key)
        => Data?.Fields is not null && Data.Fields.TryGetValue(key, out var v) && v.Visible ? v.Value : null;

    private bool IsKeyVisible(string key)
        => !string.IsNullOrEmpty(SchemaRendering.ReadKeyValue(Lookup(key)).Text);

    // A keyvalue's value: its text, as a link when it came as { text, link } with a link the portal may follow.
    private RenderFragment RenderKeyValue(string key, JsonElement? value) => __builder =>
    {
        var (text, href) = SchemaRendering.ReadKeyValue(value);
        @if (href is not null)
        {
            <a class="schema-link" href="@href">@text</a>
        }
        else
        {
            @Click(SchemaClick.Datum(key, text), b => b.AddContent(0, text))
        }
    };

    private IReadOnlyList<JsonElement> Rows()
        => Element.RowsField is not null && Lookup(Element.RowsField) is { ValueKind: JsonValueKind.Array } rows
            ? rows.EnumerateArray().ToList()
            : [];

    /// <summary>
    /// A row of stat tiles, one per row of <c>RowsField</c>: <c>label</c> above a large <c>value</c>, an optional
    /// <c>caption</c> below, coloured by <c>color</c>. A row with a positive <c>max</c> also draws <c>current</c>
    /// against it: a bar, or one pip per point when <c>pips</c> is true.
    /// </summary>
    private RenderFragment RenderStats() => __builder =>
    {
        var tiles = Rows().Select(row => (Tile: SchemaRendering.ReadStat(row), Datum: SchemaClick.Datum(row))).Where(t => !string.IsNullOrEmpty(t.Tile.Value)).ToList();
        if (tiles.Count == 0)
        {
            @if (!string.IsNullOrWhiteSpace(Element.Empty))
            {
                <EmptyState Compact="true" Class="schema-empty">@Element.Empty</EmptyState>
            }
            return;
        }

        <div class="schema-stats">
            @foreach (var (tile, datum) in tiles)
            {
                var clickable = Clicks && Clickable(datum);
                <div class="schema-stat @(clickable ? "schema-stat--click" : null)" data-tone="@SchemaRendering.ToneName(tile.Color)"
                     role="@(clickable ? "button" : null)" tabindex="@(clickable ? "0" : null)"
                     aria-disabled="@(clickable && (Busy || _pending) ? "true" : null)"
                     @onclick="@(() => clickable ? ClickAsync(datum) : Task.CompletedTask)"
                     @onkeydown="@(args => clickable && args.Key is "Enter" or " " ? ClickAsync(datum) : Task.CompletedTask)">
                    <div class="schema-label">@tile.Label</div>
                    <div class="schema-stat-value">@tile.Value</div>
                    @if (tile.Max is > 0 and var max)
                    {
                        var current = Math.Clamp(tile.Current ?? 0, 0, max);
                        @if (tile.Pips)
                        {
                            <div class="schema-stat-pips" role="img" aria-label="@($"{current} / {max}")">
                                @for (var pip = 0; pip < max; pip++)
                                {
                                    <span class="schema-stat-pip @(pip < current ? "schema-stat-pip--on" : null)"></span>
                                }
                            </div>
                        }
                        else
                        {
                            <MudProgressLinear Value="@(current * 100.0 / max)" Color="@tile.Color" Rounded="true" Size="Size.Small"
                                               Class="schema-stat-bar" aria-label="@($"{current} / {max}")" />
                        }
                    }
                    @if (!string.IsNullOrWhiteSpace(tile.Caption))
                    {
                        <div class="schema-stat-caption">@tile.Caption</div>
                    }
                </div>
            }
        </div>
    };

    /// <summary>
    /// The chips in <c>SrcField</c>: an array of strings, or of <c>{ text, color }</c>, under the element's
    /// <c>Label</c> when it has one.
    /// </summary>
    private RenderFragment RenderChips() => __builder =>
    {
        var source = Element.SrcField is null ? null : Lookup(Element.SrcField);
        var chips = SchemaRendering.ReadChips(source);
        var data = source is { ValueKind: JsonValueKind.Array } list
            ? list.EnumerateArray().Select(SchemaClick.Datum).Where(d => !string.IsNullOrWhiteSpace(d.GetValueOrDefault("text"))).ToList()
            : [];
        if (chips.Count == 0)
        {
            @if (!string.IsNullOrWhiteSpace(Element.Empty))
            {
                <EmptyState Compact="true" Class="schema-empty">@Element.Empty</EmptyState>
            }
            return;
        }

        <div class="schema-chip-group">
            @if (!string.IsNullOrWhiteSpace(Element.Label))
            {
                <div class="schema-label">@Element.Label</div>
            }
            <div class="schema-chips">
                @for (var i = 0; i < chips.Count; i++)
                {
                    var chip = chips[i];
                    var datum = i < data.Count ? data[i] : SchemaClick.Datum(JsonSerializer.SerializeToElement(chip.Text));
                    @if (Clicks && Clickable(datum))
                    {
                        <MudChip T="string" Size="Size.Small" Color="chip.Color" Class="schema-chip schema-chip--click"
                                 Disabled="@(Busy || _pending)" OnClick="@(() => ClickAsync(datum))">@chip.Text</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="chip.Color" Class="schema-chip">@chip.Text</MudChip>
                    }
                }
            </div>
        </div>
    };

    private RenderFragment RenderTable() => __builder =>
    {
        var rows = Rows();
        if (Element.Columns is null)
        {
            return;
        }

        if (rows.Count == 0)
        {
            @if (!string.IsNullOrWhiteSpace(Element.Empty))
            {
                <EmptyState Compact="true" Class="schema-empty">@Element.Empty</EmptyState>
            }
            return;
        }

        <MudSimpleTable Dense="true" Striped="true" Class="schema-table">
            <thead>
                <tr>
                    @foreach (var col in Element.Columns)
                    {
                        <th>@col.Label</th>
                    }
                    @if (rows.Any(r => IsReorderable(RowText(r, "group"))))
                    {
                        <th><span class="visually-hidden">@Loc["WidTableMove"]</span></th>
                    }
                </tr>
            </thead>
            <tbody>
                @{ string? group = null; }
                @for (var i = 0; i < rows.Count; i++)
                {
                    var index = i; // the handlers below run after the loop has moved on
                    var row = rows[index];
                    var rowGroup = RowText(row, "group");
                    @if (!string.IsNullOrEmpty(rowGroup) && rowGroup != group)
                    {
                        <tr class="schema-table-group">
                            <th colspan="@(Element.Columns.Count + (IsReorderable(rowGroup) ? 1 : 0))" scope="rowgroup">@rowGroup</th>
                        </tr>
                    }
                    group = rowGroup;
                    var reorderable = IsReorderable(rowGroup);
                    var place = reorderable ? GroupPlace(rows, index) : 0;
                    var size = reorderable ? GroupSize(rows, rowGroup) : 0;
                    <tr class="@(reorderable ? "schema-table-row--reorder" : null) @(_dragging == index ? "schema-table-row--dragging" : null)"
                        draggable="@(reorderable && !Busy ? "true" : null)"
                        @ondragstart="@(() => _dragging = reorderable ? index : null)"
                        @ondragend="@(() => _dragging = null)"
                        @ondragover:preventDefault="@reorderable"
                        @ondrop="@(() => DropAsync(rows, index))">
                        @for (var c = 0; c < Element.Columns.Count; c++)
                        {
                            var col = Element.Columns[c];
                            <td>@(c == 0 ? Click(SchemaClick.Datum(row), RenderCell(col, row)) : RenderCell(col, row))</td>
                        }
                        @if (reorderable)
                        {
                            <td class="schema-table-move">
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small"
                                               aria-label="@Loc["WidTableMoveUp"]"
                                               Disabled="@(Busy || _pending || place <= 1)"
                                               OnClick="@(() => MoveAsync(row, place - 1))" />
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small"
                                               aria-label="@Loc["WidTableMoveDown"]"
                                               Disabled="@(Busy || _pending || place >= size)"
                                               OnClick="@(() => MoveAsync(row, place + 1))" />
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    };

    /// <summary>The row being dragged, by index, while a drag is under way.</summary>
    private int? _dragging;

    private static string RowText(JsonElement row, string name)
        => row.ValueKind == JsonValueKind.Object && row.TryGetProperty(name, out var value)
            ? SchemaViewRenderer.ValueToString(value)
            : string.Empty;

    // Only the group the schema names, and only when its action is one the document has.
    private bool IsReorderable(string group)
        => Element.Reorder is { Group: { Length: > 0 } named } reorder
           && string.Equals(group, named, StringComparison.Ordinal)
           && CanDispatch(reorder.Action)
           && !string.IsNullOrEmpty(reorder.Key);

    // A row's place within its group, from 1.
    private static int GroupPlace(IReadOnlyList<JsonElement> rows, int index)
    {
        var group = RowText(rows[index], "group");
        return rows.Take(index + 1).Count(r => RowText(r, "group") == group);
    }

    private static int GroupSize(IReadOnlyList<JsonElement> rows, string group)
        => rows.Count(r => RowText(r, "group") == group);

    /// <summary>The dragged row dropped on row <paramref name="target"/>: it takes that row's place in the group.</summary>
    private async Task DropAsync(IReadOnlyList<JsonElement> rows, int target)
    {
        if (_dragging is not { } source || source == target || source >= rows.Count)
        {
            _dragging = null;
            return;
        }

        _dragging = null;
        var group = RowText(rows[source], "group");
        if (!IsReorderable(group) || RowText(rows[target], "group") != group)
        {
            return;
        }

        await MoveAsync(rows[source], GroupPlace(rows, target));
    }

    /// <summary>Posts the reorder action for <paramref name="row"/>, moving it to <paramref name="position"/> in its group.</summary>
    private async Task MoveAsync(JsonElement row, int position)
    {
        if (Element.Reorder is not { } reorder || string.IsNullOrEmpty(reorder.Key))
        {
            return;
        }

        var values = new Dictionary<string, JsonElement>(StringComparer.Ordinal);
        foreach (var (key, value) in reorder.Values ?? new Dictionary<string, JsonElement>())
        {
            values[key] = value;
        }

        values["item"] = row.TryGetProperty(reorder.Key, out var item) ? item.Clone() : JsonSerializer.SerializeToElement(string.Empty);
        values["position"] = JsonSerializer.SerializeToElement(position);
        await RequestAsync(reorder.Action, values, null, null);
    }

    private RenderFragment RenderCell(SchemaColumn column, JsonElement row) => __builder =>
    {
        var text = row.ValueKind == JsonValueKind.Object && row.TryGetProperty(column.Key, out var cell)
            ? SchemaViewRenderer.ValueToString(cell)
            : string.Empty;
        var color = column.ColorKey is not null && row.ValueKind == JsonValueKind.Object
                    && row.TryGetProperty(column.ColorKey, out var colorValue)
            ? SchemaRendering.ParseColor(SchemaViewRenderer.ValueToString(colorValue))
            : Color.Default;
        var href = column.Link is null ? null : SchemaRendering.FillLink(column.Link, row);
        var isChip = string.Equals(column.Type, "chip", StringComparison.OrdinalIgnoreCase);
        @* An empty chip cell stays empty: a row with nothing to flag shows no blank pill. *@
        if (isChip && string.IsNullOrEmpty(text))
        {
            return;
        }

        RenderFragment content = isChip
            ? @<MudChip T="string" Size="Size.Small" Color="color" Class="schema-chip">@text</MudChip>
            : @<span class="@(color == Color.Default ? null : $"mud-{color.ToString().ToLowerInvariant()}-text")">@text</span>;

        @if (href is not null)
        {
            <a class="schema-link" href="@href">@content</a>
        }
        else
        {
            @content
        }
    };

    private RenderFragment RenderTimeline() => __builder =>
    {
        var entries = Rows().Select(SchemaRendering.ReadTimelineEntry).ToList();
        if (entries.Count == 0)
        {
            @if (!string.IsNullOrWhiteSpace(Element.Empty))
            {
                <EmptyState Compact="true" Class="schema-empty">@Element.Empty</EmptyState>
            }
            return;
        }

        <ol class="schema-timeline">
            @for (var i = 0; i < entries.Count; i++)
            {
                var entry = entries[i];
                // A row continues a conversation when the row before it holds the same group.
                var reply = entry.Group is not null && i > 0 && entries[i - 1].Group == entry.Group;
                var starts = entry.Group is not null && !reply && i > 0;
                <li class="@EntryClass(entry, reply, starts)" id="@entry.Anchor">
                    <div class="schema-timeline-head">
                        <span class="schema-timeline-author">@entry.Author</span>
                        @if (!string.IsNullOrEmpty(entry.Time))
                        {
                            <span class="schema-timeline-time">@entry.Time</span>
                        }
                        @if (entry.ReplyTo is not null)
                        {
                            <span class="schema-timeline-replyto">@entry.ReplyTo</span>
                        }
                        @if (entry.Tag is not null)
                        {
                            <MudChip T="string" Size="Size.Small" Color="entry.TagColor" Class="schema-timeline-tag">@entry.Tag</MudChip>
                        }
                        @if (entry.Unread)
                        {
                            <span class="schema-timeline-new">@Loc["WidTimelineNew"]</span>
                        }
                    </div>
                    @if (entry.IsCode)
                    {
                        <pre class="schema-timeline-body schema-timeline-code"><code>@entry.Body</code></pre>
                    }
                    else if (entry.IsMarkup)
                    {
                        <div class="schema-timeline-body schema-markup">@((MarkupString)SchemaRendering.MarkupToHtml(entry.Body))</div>
                    }
                    else
                    {
                        <div class="schema-timeline-body schema-markdown">@((MarkupString)SchemaRendering.MarkdownToHtml(entry.Body))</div>
                    }
                    @if (entry.Actions.Count > 0 || entry.Links is { Count: > 0 })
                    {
                        <div class="schema-timeline-actions">
                            @foreach (var link in entry.Links ?? [])
                            {
                                <a class="schema-link schema-timeline-link" href="@link.Href">@link.Label</a>
                            }
                            @foreach (var action in entry.Actions)
                            {
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="schema-timeline-action"
                                           OnClick="@(() => RequestAsync(action.Action, action.Values, action.Confirm, action.Label))"
                                           Disabled="@(Busy || _pending || !CanDispatch(action.Action))">
                                    @action.Label
                                </MudButton>
                            }
                        </div>
                    }
                    @if (entry.ChildrenHidden > 0 && entry.More is not null)
                    {
                        <a class="schema-link schema-timeline-more" href="@entry.More">@Loc.Plural("WidTimelineMore", "count", entry.ChildrenHidden)</a>
                    }
                </li>
            }
        </ol>
    };

    private static string EntryClass(SchemaRendering.TimelineEntry entry, bool reply, bool starts)
        => string.Join(' ', new[]
        {
            "schema-timeline-entry",
            entry.Group is not null ? "schema-timeline-entry--grouped" : null,
            reply ? "schema-timeline-entry--reply" : null,
            starts ? "schema-timeline-entry--starts" : null,
            entry.Unread ? "schema-timeline-entry--unread" : null,
        }.Where(c => c is not null));

    // The fragment last scrolled to, so a redraw (an action's answer) does not pull the page back to it.
    private string? _scrolledTo;

    /// <summary>
    /// Scrolls to the timeline entry the address's <c>#fragment</c> names, once it is drawn: the rows arrive
    /// after the page loads, too late for the browser's own jump.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Kind != "timeline")
        {
            return;
        }

        var uri = Nav.Uri;
        var hash = uri.IndexOf('#');
        if (hash < 0 || hash == uri.Length - 1)
        {
            return;
        }

        var fragment = Uri.UnescapeDataString(uri[(hash + 1)..]);
        if (fragment == _scrolledTo || !Rows().Select(SchemaRendering.ReadTimelineEntry).Any(e => e.Anchor == fragment))
        {
            return;
        }

        _scrolledTo = fragment;
        try
        {
            await JS.InvokeVoidAsync("SharpMUSH.scrollToId", fragment);
        }
        catch (JSException)
        {
            // Not scrolling leaves the page where it was; nothing else depends on it.
        }
    }
}
