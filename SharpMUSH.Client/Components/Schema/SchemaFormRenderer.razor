@using System.Text.Json
@using SharpMUSH.Client.Models.Applications
@using SharpMUSH.Client.Services
@inject SchemaAppService Schema
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> Loc

@* Renders an editable Portal Schema Document (kind:"form"). Collects field values, POSTs actions to
   the in-game handler, and binds the structured response back. All branching/progression is
   softcode-driven: an action may return a replacement schema, which simply re-renders, or replacement
   data, which redraws the display elements (tables, timelines) the form shares with a view. *@

@if (!_model.HasPages)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary">@Loc["WidFormNoPages"]</MudText>
}
else
{
    var page = CurrentPage;

    @if (!string.IsNullOrWhiteSpace(_model.Document!.Title))
    {
        <MudText Typo="Typo.h5" Class="mb-1">@_model.Document.Title</MudText>
    }
    @if (_model.PageCount > 1)
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            @Loc["WidFormStepOf", _model.PageIndex + 1, _model.PageCount]@(string.IsNullOrWhiteSpace(page.Title) ? "" : $" — {page.Title}")
        </MudText>
    }

    @if (_model.GlobalError is not null)
    {
        <MudAlert Severity="Severity.Error" Class="my-2" ShowCloseIcon="true" CloseIconClicked="() => _model.GlobalError = null">
            @_model.GlobalError
        </MudAlert>
    }

    <MudForm @ref="_form" Class="mt-2">
        @foreach (var section in (page.Sections ?? []).OrderBy(s => s.Order))
        {
            <MudPaper Outlined="true" Class="pa-4 mb-4">
                @if (!string.IsNullOrWhiteSpace(section.Name))
                {
                    <MudText Typo="Typo.h6" Class="mb-2">@section.Name</MudText>
                }
                @if (section.Columns > 1)
                {
                    <MudGrid Spacing="3">
                        @foreach (var element in section.Elements ?? [])
                        {
                            <MudItem xs="12" md="@SchemaFormModel.ColumnWidth(section.Columns, element.Span)">
                                @RenderElement(element)
                            </MudItem>
                        }
                    </MudGrid>
                }
                else
                {
                    @foreach (var element in section.Elements ?? [])
                    {
                        @RenderElement(element)
                    }
                }
            </MudPaper>
        }
    </MudForm>

    <div class="d-flex justify-space-between mt-2">
        <div>
            @if (!_model.IsFirstPage)
            {
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ChevronLeft"
                           OnClick="_model.PrevPage" Disabled="_busy">@Loc["WidBack"]</MudButton>
            }
        </div>
        <div class="d-flex gap-2">
            @if (!_model.IsLastPage)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ChevronRight"
                           OnClick="_model.NextPage" Disabled="_busy">@Loc["WidNext"]</MudButton>
            }
            else if (HasAction("submit"))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Check"
                           OnClick="@(() => Dispatch("submit"))" Disabled="_busy">
                    @if (_busy)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    @Loc["WidSubmit"]
                </MudButton>
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public PortalSchemaDocument? Document { get; set; }

    /// <summary>Optional prefill data (form editing an existing record), also what display elements read.</summary>
    [Parameter] public SchemaData? Data { get; set; }

    // The data display elements read: the parameter, until an action answers with replacement data.
    private SchemaData? _data;
    private SchemaData? _dataParameter;

    // Everything entered, the page showing and the errors bound; this component draws it and sends it.
    private readonly SchemaFormModel _model = new();
    private MudForm? _form;
    private bool _busy;

    private SchemaPage CurrentPage => _model.CurrentPage;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(Data, _dataParameter))
        {
            _data = _dataParameter = Data;
        }

        if (!ReferenceEquals(_model.Document, Document))
        {
            _model.Load(Document, _data);
        }
    }

    private Task Dispatch(string actionName) => Dispatch(actionName, null);

    private Task Dispatch(SchemaActionRequest request) => Dispatch(request.Action, request.Values);

    /// <summary>
    /// Posts the field values, with <paramref name="values"/> merged over them, to the action's route, and
    /// applies the answer.
    /// </summary>
    private async Task Dispatch(string actionName, IReadOnlyDictionary<string, JsonElement>? values)
    {
        // One action at a time: whatever arrives while one is in flight is dropped, not posted twice.
        if (_busy || _model.Action(actionName) is not { } action)
        {
            return;
        }

        // Advisory required-field check before a final submit (softcode remains authoritative).
        // Partial submits (buttons, "next") never block — softcode decides what is complete.
        if (actionName == "submit"
            && !_model.ValidateRequired(field => Loc["WidFieldRequired", field.Label ?? field.Key!], Loc["WidFillRequiredFields"]))
        {
            StateHasChanged();
            return;
        }

        _busy = true;
        _model.ClearErrors();
        StateHasChanged();

        SchemaActionResult result;
        try
        {
            result = await Schema.SubmitAsync(action.Route!, _model.Payload(values));
        }
        finally
        {
            _busy = false;
        }

        if (result.Ok)
        {
            var reset = action.OnSuccess?.ResetFields ?? false;
            if (reset)
            {
                _model.ResetValues();
            }

            if (result.Fields is not null && (reset || (action.OnSuccess?.MergeFields ?? false)))
            {
                _model.MergeFields(result.Fields);
            }

            if (result.Data is not null)
            {
                _data = result.Data;
            }

            if (result.Schema is not null)
            {
                // Softcode-driven progression: re-render from the returned document.
                _model.Load(result.Schema, _data);
            }

            if (!string.IsNullOrWhiteSpace(action.OnSuccess?.Toast) || !string.IsNullOrWhiteSpace(result.Message))
            {
                Snackbar.Add(action.OnSuccess?.Toast ?? result.Message!, Severity.Success);
            }

            if (!string.IsNullOrWhiteSpace(result.Redirect))
            {
                Nav.NavigateTo(result.Redirect!);
            }
            else if (!string.IsNullOrWhiteSpace(action.OnSuccess?.Navigate))
            {
                Nav.NavigateTo(action.OnSuccess!.Navigate!);
            }
        }
        else
        {
            _model.BindErrors(result.Errors, action.OnError?.BindFieldErrors ?? true, Loc["WidActionFailed"]);
        }

        StateHasChanged();
    }

    private string GetString(string key) => _model.GetString(key);
    private bool GetBool(string key) => _model.GetBool(key);
    private double? GetNumber(string key) => _model.GetNumber(key);
    private IEnumerable<string> GetMulti(string key) => _model.GetMulti(key);

    /// <summary>
    /// Stores an edit, then dispatches the field's <c>triggers_action</c> if it names one — how a filter
    /// select re-asks softcode for its rows the moment it changes.
    /// </summary>
    private Task Changed(SchemaElement field, Action store)
    {
        store();
        return string.IsNullOrWhiteSpace(field.TriggersAction) || _busy
            ? Task.CompletedTask
            : Dispatch(field.TriggersAction!, null);
    }
    private string? Error(string key) => _model.Error(key);
    private bool HasAction(string name) => _model.HasAction(name);

    private RenderFragment RenderElement(SchemaElement element) => __builder =>
    {
        switch ((element.Kind ?? "field").ToLowerInvariant())
        {
            case "field":
                @RenderField(element)
                break;
            case var kind when SchemaDisplay.Kinds.Contains(kind):
                <div class="mb-2">
                    <SchemaDisplay Element="element" Data="_data" Actions="_model.Document?.Actions" Busy="_busy" OnAction="Dispatch" />
                </div>
                break;
        }
    };

    private RenderFragment RenderField(SchemaElement element) => __builder =>
    {
        if (element.Key is null || string.Equals(element.Type, "hidden", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        var key = element.Key;
        var label = element.Label ?? key;
        var help = element.Help;
        var error = Error(key);
        var required = element.Validation?.Required ?? false;

        switch ((element.Type ?? "text").ToLowerInvariant())
        {
            case "boolean":
                <div class="mb-2">
                    <MudSwitch T="bool" Value="GetBool(key)" ValueChanged="v => Changed(element, () => _model.SetBool(key, v))"
                               Label="@label" Color="Color.Primary" />
                    @if (!string.IsNullOrWhiteSpace(help))
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@help</MudText>
                    }
                </div>
                break;

            case "number":
            case "slider":
                @if (element.Type == "slider")
                {
                    <div class="mb-3">
                        <MudText Typo="Typo.body2">@label: @(GetNumber(key)?.ToString() ?? "—")</MudText>
                        <MudSlider T="double" Value="@(GetNumber(key) ?? element.Validation?.Min ?? 0)"
                                   ValueChanged="v => Changed(element, () => _model.SetNumber(key, v))"
                                   Min="@(element.Validation?.Min ?? 0)" Max="@(element.Validation?.Max ?? 100)" Step="1" />
                    </div>
                }
                else
                {
                    <MudNumericField T="double?" Value="GetNumber(key)" ValueChanged="v => Changed(element, () => _model.SetNumber(key, v))"
                                     Label="@label" Variant="Variant.Outlined" Class="mb-2"
                                     HelperText="@help" Required="required" Error="@(error is not null)" ErrorText="@error"
                                     Min="@(element.Validation?.Min)" Max="@(element.Validation?.Max)" />
                }
                break;

            case "textarea":
            case "mstring":
                <MudTextField T="string" Value="GetString(key)" ValueChanged="v => Changed(element, () => _model.SetString(key, v))"
                              Label="@label" Variant="Variant.Outlined" Lines="4" Class="mb-2"
                              HelperText="@help" Required="required" Error="@(error is not null)" ErrorText="@error" />
                break;

            case "select":
                <MudSelect T="string" Value="GetString(key)" ValueChanged="v => Changed(element, () => _model.SetString(key, v))"
                           Label="@label" Variant="Variant.Outlined" Class="mb-2"
                           HelperText="@help" Required="required" Error="@(error is not null)" ErrorText="@error">
                    @foreach (var option in element.Options ?? [])
                    {
                        <MudSelectItem T="string" Value="@option.Value">@option.Label</MudSelectItem>
                    }
                </MudSelect>
                break;

            case "multiselect":
                <MudSelect T="string" SelectedValues="GetMulti(key).ToHashSet()"
                           SelectedValuesChanged="v => Changed(element, () => _model.SetMulti(key, v))" MultiSelection="true"
                           Label="@label" Variant="Variant.Outlined" Class="mb-2"
                           HelperText="@help" Error="@(error is not null)" ErrorText="@error">
                    @foreach (var option in element.Options ?? [])
                    {
                        <MudSelectItem T="string" Value="@option.Value">@option.Label</MudSelectItem>
                    }
                </MudSelect>
                break;

            case "radio":
                <div class="mb-2">
                    <MudText Typo="Typo.body2">@label</MudText>
                    <MudRadioGroup T="string" Value="GetString(key)" ValueChanged="v => Changed(element, () => _model.SetString(key, v))">
                        @foreach (var option in element.Options ?? [])
                        {
                            <MudRadio T="string" Value="@option.Value">@option.Label</MudRadio>
                        }
                    </MudRadioGroup>
                    @if (error is not null)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error">@error</MudText>
                    }
                </div>
                break;

            case "date":
                <MudDatePicker Label="@label" Date="_model.GetDate(key)"
                               DateChanged="d => Changed(element, () => _model.SetDate(key, d))"
                               Variant="Variant.Outlined" Class="mb-2" HelperText="@help"
                               Error="@(error is not null)" ErrorText="@error" />
                break;

            default:
                <MudTextField T="string" Value="GetString(key)" ValueChanged="v => Changed(element, () => _model.SetString(key, v))"
                              Label="@label" Variant="Variant.Outlined" Class="mb-2"
                              HelperText="@help" Required="required" Error="@(error is not null)" ErrorText="@error"
                              MaxLength="@(element.Validation?.MaxLength ?? 524288)" />
                break;
        }
    };
}
