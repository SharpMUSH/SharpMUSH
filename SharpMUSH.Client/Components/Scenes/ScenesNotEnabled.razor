@inject IStringLocalizer<SharedResource> Loc

@* What a scene page shows on a game that has the Scene System turned off: an old link or a bookmark
   still lands somewhere that says why, rather than on an error from an API with nothing behind it. *@
<div style="padding:var(--cpad);">
    <EmptyState>@Loc["RolScenesNotEnabled"]</EmptyState>
</div>
