@using SharpMUSH.Client.Services
@inject ServerInfoService ServerInfo
@implements IDisposable

@* The game's mark: its compact portal_logo, or with Full its portal_logo_full (else portal_logo), shown as it is,
   else the SharpMUSH logo in the theme's accent, its inner strokes in --logo-inner. Decorative: the link around it
   carries the name. A preview shows Picture instead of the saved logo. The first render draws the logo the portal
   already knows (from index.html or an earlier answer), so a reload does not flash SharpMUSH's. *@
@if (Logo is not null && Full)
{
    @* A full logo may be wider than it is tall: Size tall, at most four times as wide. *@
    <img src="@ApiUrl.Resolve(Logo)" height="@Size" alt="" aria-hidden="true"
         class="@($"game-logo game-logo--full {Class}".TrimEnd())"
         style="@($"--game-logo-size:{Size}px;")" />
}
else if (Logo is not null)
{
    <img src="@ApiUrl.Resolve(Logo)" width="@Size" height="@Size" alt="" aria-hidden="true"
         class="@($"game-logo {Class}".TrimEnd())" style="object-fit:contain;" />
}
else
{
    <svg width="@Size" height="@Size" viewBox="0 0 512 512" aria-hidden="true" class="@Class">
        <path fill="var(--accent)" d="m345.16-0.31-88.2 163.24-88.13-163.1-167.67 252.72 87.98 234.7-1.24-233.41 64.74-117.99 104.11 196.48 0.27-0.37 0.51 0.0 104.11-196.48 64.74 117.99-1.25 233.41 87.98-234.7z" />
        <g fill="var(--logo-inner)">
            <path d="m143.1 228.96 65.57 113.27v170.77l-65.99-166.48z" />
            <path d="m370.64 227.45-65.57 113.27v170.77l65.99-166.48z" />
        </g>
    </svg>
}

@code {
    /// <summary>Width and height in pixels.</summary>
    [Parameter]
    public int Size { get; set; } = 26;

    [Parameter]
    public string? Class { get; set; }

    /// <summary>The full logo (portal_logo_full, else portal_logo) rather than the compact mark.</summary>
    [Parameter]
    public bool Full { get; set; }

    /// <summary>Shows <see cref="Picture"/> rather than the saved logo, as an editor's preview does.</summary>
    [Parameter]
    public bool Preview { get; set; }

    /// <summary>The picture a preview shows; empty for the SharpMUSH logo.</summary>
    [Parameter]
    public string? Picture { get; set; }

    private string? _saved;

    private string? Logo => Preview ? (string.IsNullOrWhiteSpace(Picture) ? null : Picture.Trim()) : _saved;

    protected override async Task OnInitializedAsync()
    {
        ServerInfo.Changed += OnServerInfoChanged;
        if (Preview) return;
        _saved = ServerInfo.KnownLogo(Full);
        _saved = await SavedAsync();
    }

    private Task<string?> SavedAsync() => Full ? ServerInfo.FullLogoAsync() : ServerInfo.LogoAsync();

    private void OnServerInfoChanged() => _ = InvokeAsync(async () =>
    {
        if (Preview) return;
        _saved = await SavedAsync();
        StateHasChanged();
    });

    public void Dispose() => ServerInfo.Changed -= OnServerInfoChanged;
}
