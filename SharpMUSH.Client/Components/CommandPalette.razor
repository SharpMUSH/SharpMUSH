@using SharpMUSH.Client.Services
@using Microsoft.AspNetCore.Authorization
@inject IStringLocalizer<SharedResource> Loc
@inject NavigationManager Nav
@inject IAuthorizationService Authorization
@inject IJSRuntime JS
@inject ServerInfoService ServerInfo
@inject PaletteContext PageContext
@inject PaletteClient Server
@inject IPlayTerminalService PlayTerminal
@inject GameCommandService Commands

@* The command palette (docs/design/command-palette.md). Empty, it shows what the player's situation puts
   first: the @input session's lines, urgent commands, pins, what this page and the context stack raise,
   staples, then the portal's pages. Typing ranks everything, built-in commands included, and keeps the
   wiki and character searches last. Arrow keys move, Enter chooses, Alt+P pins, Escape closes (or leaves
   the slots) and hands focus back to whatever opened it. Opening it never waits on the network: the
   server's entries join the rows when they arrive. *@
@if (Open)
{
    <MudOverlay Visible="true" LockScroll="true" OnClick="CloseAsync" Style="@Scrim">
        <div class="kit-palette" role="dialog" aria-modal="true" aria-label="@Loc["NavSearchOpen"]"
             @onclick:stopPropagation="true" @onkeydown="OnKeyDownAsync">
            <MudFocusTrap DefaultFocus="DefaultFocus.None">
            @if (_slotRow is { } slotRow)
            {
                <div class="kit-palette-slots" aria-label="@slotRow.Label">
                    <MudIcon Icon="@slotRow.Icon" Size="Size.Small" />
                    @{ var slot = 0; }
                    @foreach (var part in PaletteLines.Parse(slotRow.Line ?? string.Empty))
                    {
                        if (!part.IsSlot)
                        {
                            <span class="kit-palette-slot-text">@part.Text</span>
                            continue;
                        }
                        var name = part.Text;
                        var index = slot++;
                        <input class="kit-palette-slot" type="text" aria-label="@name" placeholder="@name"
                               value="@_slotValues.GetValueOrDefault(name)" size="@Math.Max(name.Length, 4)"
                               @ref="_slotInputs[index]"
                               @oninput="@(e => _slotValues[name] = e.Value?.ToString() ?? string.Empty)" />
                    }
                </div>
                <div class="kit-palette-note">@Loc["NavPaletteSlots"]</div>
            }
            else
            {
                <div class="kit-palette-field">
                    <MudIcon Icon="@Icons.Material.Outlined.Search" Size="Size.Small" />
                    <input @ref="_input" type="text" role="combobox" aria-expanded="true" aria-controls="kit-palette-list"
                           aria-activedescendant="@($"kit-palette-{_active}")" aria-label="@Loc["NavSearchOpen"]"
                           placeholder="@Loc["NavPalettePlaceholder"]" value="@_query"
                           @oninput="@(e => { _query = e.Value?.ToString() ?? string.Empty; _active = 0; _output = null; })" />
                    <kbd class="kit-palette-kbd">Esc</kbd>
                </div>
            }
            @if (_output is { } output)
            {
                <div class="kit-palette-output" role="status">
                    <div class="kit-palette-output-title">@_outputFor</div>
                    @foreach (var line in output)
                    {
                        <div class="kit-palette-output-line">@line</div>
                    }
                </div>
            }
            @if (_slotRow is null)
            {
                <ul class="kit-palette-list" id="kit-palette-list" role="listbox">
                    @{ var option = 0; }
                    @foreach (var item in Items)
                    {
                        if (item.Header is { } header)
                        {
                            <li role="presentation" class="kit-palette-group">@Loc[header]</li>
                            continue;
                        }
                        var index = option++;
                        var active = index == _active;
                        <li id="@($"kit-palette-{index}")" role="option" aria-selected="@(active ? "true" : "false")"
                            class="kit-palette-item @(active ? "kit-palette-item--active" : null)"
                            @onclick="@(() => ChooseAsync(item))" @onmousemove="@(() => _active = index)">
                            @if (item.Row is { } row)
                            {
                                <MudIcon Icon="@row.Icon" Size="Size.Small" />
                                <span class="kit-palette-text">
                                    <span class="kit-palette-label">@row.Label</span>
                                    @if (row.Info is { } info)
                                    {
                                        <span class="kit-palette-info">@info</span>
                                    }
                                </span>
                                @if (row.Hint is { } hint)
                                {
                                    <span class="kit-palette-hint">@hint</span>
                                }
                                @if (Pinnable(row))
                                {
                                    var pinned = IsPinned(row);
                                    <button type="button" tabindex="-1" class="kit-palette-pin @(pinned ? "kit-palette-pin--on" : null)"
                                            aria-label="@(pinned ? Loc["NavPaletteUnpin"] : Loc["NavPalettePin"])"
                                            title="@(pinned ? Loc["NavPaletteUnpin"] : Loc["NavPalettePin"])"
                                            @onclick="@(() => TogglePinAsync(row))" @onclick:stopPropagation="true">
                                        <MudIcon Icon="@(pinned ? Icons.Material.Filled.PushPin : Icons.Material.Outlined.PushPin)" Size="Size.Small" />
                                    </button>
                                }
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Outlined.ExpandMore" Size="Size.Small" />
                                <span class="kit-palette-label">@string.Format(Loc["NavPaletteMore"], item.More)</span>
                            }
                        </li>
                    }
                </ul>
                @if (_query.Length == 0 && _server is { } server && (server.Invalid.Count > 0 || server.Dropped > 0))
                {
                    @* Only someone who may examine an object is told what is wrong with its entries. *@
                    <div class="kit-palette-note kit-palette-problems">
                        @if (server.Invalid.Count > 0)
                        {
                            <div>@Loc["NavPaletteInvalid"]</div>
                            @foreach (var problem in server.Invalid)
                            {
                                <div class="kit-palette-problem">@problem</div>
                            }
                        }
                        @if (server.Dropped > 0)
                        {
                            <div>@string.Format(Loc["NavPaletteDropped"], server.Dropped)</div>
                        }
                    </div>
                }
            }
            </MudFocusTrap>
        </div>
    </MudOverlay>
}

@code {
    /// <summary>One line of the list: a group heading, a row, or a group's "more" row.</summary>
    private sealed record ListItem(string? Header = null, PaletteRow? Row = null, string? MoreOf = null, int More = 0);

    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private const string Scrim = "background: rgba(var(--scrim-ink), 0.72); align-items: flex-start; padding-top: 12vh;";

    private ElementReference _input;
    private readonly Dictionary<int, ElementReference> _slotInputs = [];
    private string _query = string.Empty;
    private int _active;
    private bool _rememberFocus;
    private bool _focusSlots;
    private string? _itemsFor;
    private IReadOnlyList<ListItem> _items = [];
    private bool _wasOpen;
    private int _opening;
    private IReadOnlyList<PaletteRow> _destinations = [];
    private PaletteResponse? _server;
    private readonly HashSet<string> _expanded = [];
    private PaletteRow? _slotRow;
    private readonly Dictionary<string, string> _slotValues = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<string>? _output;
    private string? _outputFor;

    /// <summary>The list for the current query, rebuilt only when the query or the rows change.</summary>
    private IReadOnlyList<ListItem> Items
    {
        get
        {
            if (_itemsFor != _query)
            {
                _items = Build();
                _itemsFor = _query;
            }
            return _items;
        }
    }

    private IReadOnlyList<ListItem> Options => [.. Items.Where(item => item.Header is null)];

    private PaletteSnapshot Snapshot => new(
        _destinations,
        PageContext.Rows,
        _server,
        PageContext.Page,
        PlayTerminal.IsConnected,
        new PaletteWords(Loc["NavPaletteLeave"], Loc["NavPaletteHelpOn"]));

    private IReadOnlyList<ListItem> Build()
    {
        var term = _query.Trim();
        if (term.Length == 0)
        {
            return [.. PaletteRanker.Groups(Snapshot, _expanded).SelectMany(group => (IEnumerable<ListItem>)
            [
                new ListItem(Header: group.Name),
                .. group.Rows.Select(row => new ListItem(Row: row)),
                .. (ListItem[])(group.Hidden > 0 ? [new ListItem(MoreOf: group.Name, More: group.Hidden)] : [])
            ])];
        }

        return
        [
            .. PaletteRanker.Search(Snapshot, term).Select(row => new ListItem(Row: row)),
            new ListItem(Row: PaletteRow.Go($"/wiki?q={Uri.EscapeDataString(term)}", Icons.Material.Outlined.MenuBook, string.Format(Loc["NavPaletteSearchWiki"], term))),
            new ListItem(Row: PaletteRow.Go($"/characters?q={Uri.EscapeDataString(term)}", Icons.Material.Outlined.Groups, string.Format(Loc["NavPaletteFindCharacter"], term))),
        ];
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Open && !_wasOpen)
        {
            _query = string.Empty;
            _active = 0;
            _slotRow = null;
            _output = null;
            _expanded.Clear();
            var user = AuthState is null ? new System.Security.Claims.ClaimsPrincipal() : (await AuthState).User;
            var build = await BuildNavCatalog.VisibleAsync(Authorization, user);
            var scenes = await ServerInfo.HasFeatureAsync(GameFeatures.Scenes);
            _destinations =
            [
                PaletteRow.Go("/", Icons.Material.Outlined.Home, Loc["Home"]),
                PaletteRow.Go("/play", Icons.Material.Outlined.Terminal, Loc["Play"]),
                .. (PaletteRow[])(scenes ? [PaletteRow.Go("/scenes", Icons.Material.Outlined.Theaters, Loc["SceneArchive"])] : []),
                PaletteRow.Go("/wiki", Icons.Material.Outlined.MenuBook, Loc["Wiki"]),
                PaletteRow.Go("/characters", Icons.Material.Outlined.Groups, Loc["Characters"]),
                PaletteRow.Go("/help", Icons.Material.Outlined.HelpOutline, Loc["Help"]),
                PaletteRow.Go("/settings", Icons.Material.Outlined.Settings, Loc["Settings"]),
                .. build.Select(b => PaletteRow.Go(b.Href, b.Icon, Loc[b.LabelKey], Loc["NavBuildManage"])),
            ];
            _itemsFor = null;
            _rememberFocus = true;
            _ = LoadAsync(++_opening);
        }
        _wasOpen = Open;
    }

    /// <summary>Fetches the server's rows and adds them, unless the palette has closed or opened again since.</summary>
    private async Task LoadAsync(int opening)
    {
        var answer = await Server.GetAsync(PlayTerminal.Prompt?.Session);
        if (opening != _opening || !Open || answer is not PaletteResponse response) return;
        _server = response;
        _itemsFor = null;
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Remember what opened the palette before focus moves into it, so closing hands it back.
        if (_rememberFocus)
        {
            _rememberFocus = false;
            await RunFocusAsync("sharpmushLayout.rememberFocus");
        }

        if (!Open) return;
        try
        {
            if (_slotRow is not null)
            {
                if (_focusSlots && _slotInputs.TryGetValue(0, out var first))
                {
                    _focusSlots = false;
                    await first.FocusAsync();
                }
            }
            else
            {
                await _input.FocusAsync();
            }
        }
        catch (InvalidOperationException) { }
    }

    // No preventDefault: it is decided when the dialog renders, so it would act on the key after this
    // one (a letter lost from the field). Enter and Escape have no default in a field outside a form.
    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (_slotRow is { } slotRow)
        {
            switch (e.Key)
            {
                case "Enter": await RunAsync(slotRow, PaletteLines.Plain(slotRow.Line ?? string.Empty, _slotValues)); break;
                case "Escape": _slotRow = null; break;
            }
            return;
        }

        var options = Options;
        var count = options.Count;
        switch (e.Key)
        {
            case "ArrowDown" when count > 0: _active = (_active + 1) % count; break;
            case "ArrowUp" when count > 0: _active = (_active - 1 + count) % count; break;
            case "Enter" when count > 0: await ChooseAsync(options[Math.Clamp(_active, 0, count - 1)]); break;
            case "p" or "P" when e.AltKey && count > 0 && options[Math.Clamp(_active, 0, count - 1)].Row is { } row && Pinnable(row):
                await TogglePinAsync(row);
                break;
            case "Escape": await CloseAsync(); break;
        }
    }

    private async Task ChooseAsync(ListItem item)
    {
        if (item.MoreOf is { } group)
        {
            _expanded.Add(group);
            _itemsFor = null;
            return;
        }

        if (item.Row is not { } row) return;
        switch (row.Kind)
        {
            case PaletteRowKind.Go or PaletteRowKind.Help when row.Href is { } href:
                await CloseAsync();
                Nav.NavigateTo(href);
                break;
            case PaletteRowKind.Page when row.Run is { } run:
                await CloseAsync();
                await run();
                break;
            case PaletteRowKind.Run or PaletteRowKind.Input when row.HasSlots:
                _slotRow = row;
                _slotValues.Clear();
                _slotInputs.Clear();
                _focusSlots = true;
                break;
            case PaletteRowKind.Run or PaletteRowKind.Input or PaletteRowKind.Insert or PaletteRowKind.Builtin when row.Line is { } line:
                await RunAsync(row, PaletteLines.Plain(line, new Dictionary<string, string>()));
                break;
        }
    }

    /// <summary>
    /// Runs a line: into the composer for an insert or a built-in; through the Play terminal when it is
    /// connected, as a command link would, so an @input session takes it; otherwise through the server,
    /// showing what it answered under the field.
    /// </summary>
    private async Task RunAsync(PaletteRow row, string line)
    {
        if (row.Kind is PaletteRowKind.Insert or PaletteRowKind.Builtin)
        {
            await CloseAsync();
            if (!await PageContext.InsertAsync(line)) Nav.NavigateTo("/play");
            return;
        }

        if (PlayTerminal.IsConnected)
        {
            await CloseAsync();
            await PlayTerminal.SendAsync(line);
            return;
        }

        if (row.Kind == PaletteRowKind.Input) return;

        _slotRow = null;
        _outputFor = line;
        _output = await Commands.RunAsync(line) switch
        {
            PortalCommandResponse response => response.Output,
            ApiFailure failure => [failure.Message],
        };
    }

    private bool Pinnable(PaletteRow row)
        => _server is not null && row.Kind is not (PaletteRowKind.Page or PaletteRowKind.Help) && !row.Id.StartsWith("input:", StringComparison.Ordinal)
            && !(row.Kind == PaletteRowKind.Go && row.Href?.Contains('?') == true);

    private bool IsPinned(PaletteRow row) => _server?.Pins.Contains(row.Id) == true;

    private async Task TogglePinAsync(PaletteRow row)
    {
        if (_server is not { } server) return;
        IReadOnlyList<string> pins = server.Pins.Contains(row.Id)
            ? [.. server.Pins.Where(pin => pin != row.Id)]
            : [.. server.Pins, row.Id];
        _server = server with { Pins = pins };
        _itemsFor = null;
        await Server.SetPinsAsync(pins);
    }

    private async Task CloseAsync()
    {
        _wasOpen = false;
        _slotRow = null;
        await OpenChanged.InvokeAsync(false);
        await RunFocusAsync("sharpmushLayout.restoreFocus");
    }

    /// <summary>Focus hand-off through layout.js; skipped where it is not loaded.</summary>
    private async Task RunFocusAsync(string identifier)
    {
        try { await JS.InvokeVoidAsync(identifier); }
        catch (JSException) { }
        catch (InvalidOperationException) { }
    }
}
