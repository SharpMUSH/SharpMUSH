@using SharpMUSH.Client.Services
@using SharpMUSH.Library.Models.Portal.Onboarding
@inject ServerInfoService ServerInfo
@implements IDisposable

@* The game's own face at the top of Home, from its saved options (GameHeroCard draws it). *@
<GameHeroCard Identity="_identity" Sharpie="GenreArtFor(_onboarding)" />

@code {
    private GameIdentity _identity = new(string.Empty, null, null, null);
    private OnboardingPresentation? _onboarding;

    /// <summary>
    /// The guide's welcome picture: the game's own guide picture (onboarding_guide_art), else Sharpie for the game's
    /// genre and subgenre in its art style. Null for a game that named neither a picture nor a genre: the neutral
    /// Sharpie is the guide's own, not the game's.
    /// </summary>
    public static SharpieArt? GenreArtFor(OnboardingPresentation? onboarding) =>
        onboarding is null
            ? null
            : GenreArtFor(onboarding.GuideArt, onboarding.ArtStyle, onboarding.Genre, onboarding.Subgenre, onboarding.ArtOverrideId);

    /// <summary>
    /// The welcome picture for a guide picture of the game's own, else for a genre, subgenre and art style; null for a
    /// genre with none of its own.
    /// </summary>
    public static SharpieArt? GenreArtFor(string? ownPicture, string style, string genre, string subgenre, string overrideId) =>
        GuideArt.Own(ownPicture) ?? (SharpieArtCatalog.Resolve(style, genre, subgenre, overrideId, GuideImagery.Full, SharpieArtMoment.Welcome) is { } art
        && !string.Equals(art.Theme, "neutral", StringComparison.OrdinalIgnoreCase)
        && !string.Equals(art.Theme, "None", StringComparison.OrdinalIgnoreCase)
            ? art
            : null);

    protected override async Task OnInitializedAsync()
    {
        ServerInfo.Changed += OnServerInfoChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _identity = await ServerInfo.IdentityAsync();
        _onboarding = await ServerInfo.OnboardingAsync();
    }

    private void OnServerInfoChanged() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => ServerInfo.Changed -= OnServerInfoChanged;
}
