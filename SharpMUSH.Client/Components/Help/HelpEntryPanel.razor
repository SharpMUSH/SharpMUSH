@inject GameHelpService Help
@inject IStringLocalizer<SharedResource> Loc
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<HelpEntryPanel> Logger
@implements IAsyncDisposable

@* Renders one help topic out of the server's shipped helpfile corpus. Not a wiki page: there is
   nothing to create here, so a topic nobody wrote about is a plain "no such topic", never an
   invitation to write one. *@

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Dense="true">@Loc["HelpLoadFailed"] @_error</MudAlert>
}
else if (_entry is not null && _entry.Topic is not null)
{
    @if (_entry.CanonicalHref is not null)
    {
        <HeadContent>
            @* Every section route renders the complete article; its SEO canonical excludes the navigation fragment. *@
            <link rel="canonical" href="@Navigation.ToAbsoluteUri(_entry.CanonicalHref).GetLeftPart(UriPartial.Path)" />
        </HeadContent>
    }
    <article class="help-entry" @ref="_articleElement">@((MarkupString)(_entry.Html ?? string.Empty))</article>
}
else if (_entry is not null && _entry.Candidates.Count > 0)
{
    <p class="help-ambiguous">@string.Format(Loc["HelpSeveralTopicsMatch"], Topic)</p>
    <ul class="help-candidates">
        @foreach (var candidate in _entry.Candidates)
        {
            <li><a href="@HrefFor(candidate)">@candidate</a></li>
        }
    </ul>
}
else
{
    <MudAlert Severity="Severity.Info" Dense="true">@string.Format(Loc["HelpNoSuchTopic"], Topic)</MudAlert>
}

@code {
    /// <summary>The topic to resolve, exactly as it came out of the URL.</summary>
    [Parameter]
    public string Topic { get; set; } = string.Empty;

    /// <summary>Read the administrator corpus (<c>ahelp</c>) instead of the general one.</summary>
    [Parameter]
    public bool Admin { get; set; }

    private GameHelpEntry? _entry;
    private bool _loading = true;
    private string? _error;
    private string? _loadedTopic;
    private ElementReference _articleElement;
    private IJSObjectReference? _module;
    private bool _focusRequested;

    protected override async Task OnParametersSetAsync()
    {
        // Navigating between topics reuses this component instance, so reload on topic change only.
        var key = $"{Admin}|{Topic}";
        if (_loadedTopic == key)
        {
            return;
        }
        _loadedTopic = key;

        _loading = true;
        var result = Admin ? await Help.GetAdminEntryAsync(Topic) : await Help.GetEntryAsync(Topic);
        (_entry, _error) = result switch
        {
            GameHelpEntry entry => (entry, null),
            ApiFailure failure => ((GameHelpEntry?)null, failure.Message)
        };
        _loading = false;
        _focusRequested = _entry?.SectionId is not null || new Uri(Navigation.Uri).Fragment.Length > 1;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_loading || !_focusRequested || _entry?.Topic is null)
        {
            return;
        }
        _focusRequested = false;
        var section = _entry.SectionId ?? Uri.UnescapeDataString(new Uri(Navigation.Uri).Fragment.TrimStart('#'));
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Help/HelpEntryPanel.razor.js");
            await _module.InvokeVoidAsync("focusSection", _articleElement, section);
        }
        catch (JSException error)
        {
            Logger.LogDebug(error, "Could not scroll help to section {Section}", section);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.DisposeAsync();
        }
    }

    private string HrefFor(string topic) =>
        Admin
            ? $"/help/admin/{Uri.EscapeDataString(topic)}"
            : $"/help/{Uri.EscapeDataString(topic)}";
}
