# Quick local renderer image: copy pre-built binaries; shares /run/sharpmush with SocketServer.
FROM mcr.microsoft.com/dotnet/aspnet:11.0
WORKDIR /app
COPY SharpMUSH.RenderingWorker/bin/Release/net11.0/ ./
ENV Rendering__SocketPath=/run/sharpmush/render.sock
ENTRYPOINT ["dotnet", "SharpMUSH.RenderingWorker.dll"]
