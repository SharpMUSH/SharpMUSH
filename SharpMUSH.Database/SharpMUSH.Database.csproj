<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>default</LangVersion>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<NoWarn>NU1510</NoWarn>
	</PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="$(DotNetPackageVersion)" />
    <PackageReference Include="OneOf" Version="3.0.271" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpMUSH.Library\SharpMUSH.Library.csproj" />
    <!-- MarkupString used directly across the providers. Referenced explicitly because SharpMUSH.Library
         marks its SharpMUSH.* ProjectReferences PrivateAssets="all" (to keep them out of its NuGet
         package), so they no longer flow transitively through Library. -->
    <PackageReference Include="MarkupString" Version="$(MarkupStringVersion)" />
    <PackageReference Include="MarkupString.Ansi" Version="$(MarkupStringVersion)" />
    <PackageReference Include="MarkupString.Html" Version="$(MarkupStringVersion)" />
  </ItemGroup>

</Project>
