<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<!-- The portal runs on the browser's Mono runtime, which cannot run runtime-async methods: built with
		     runtime-async=on, the portal fails in Main with a ManagedError. This assembly loads in the browser,
		     so it stays on compiler state machines (Directory.Build.targets). -->
		<UseRuntimeAsync>false</UseRuntimeAsync>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>default</LangVersion>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<Content Update="mushcnf.dst">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<None Update="mushcnf.dst">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<Content Update="colors.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<None Update="colors.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SharpMUSH.Configuration.Generated\SharpMUSH.Configuration.Generated.csproj" OutputItemType="Analyzer" />
	</ItemGroup>

</Project>
