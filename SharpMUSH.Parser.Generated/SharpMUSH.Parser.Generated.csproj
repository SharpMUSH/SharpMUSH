<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>default</LangVersion>
  </PropertyGroup>

	<PropertyGroup>
		<TreatWarningsAsErrors>True</TreatWarningsAsErrors>
	</PropertyGroup>

  <ItemGroup>
		<!-- Antlr4BuildTasks reads this reference's version to pick the code generator. ExcludeAssets keeps
		     the package's assembly out of the build: the runtime is vendor/antlr4-csharp. -->
		<PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" ExcludeAssets="all" PrivateAssets="all" />
		<PackageReference Include="Antlr4BuildTasks" Version="12.14.0" PrivateAssets="all" IncludeAssets="build">
			<ToolType>antlr-ng</ToolType>
		</PackageReference>
		<Antlr4 Include="SharpMUSHLexer.g4" />
		<Antlr4 Include="SharpMUSHBoolExpLexer.g4" />
		<Antlr4 Include="SharpMUSHParser.g4" />
		<Antlr4 Include="SharpMUSHBoolExpParser.g4" />
		<PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.10.1" PrivateAssets="all" IncludeAssets="build" />
  </ItemGroup>
	
	<ItemGroup>
		<!-- The ANTLR runtime, built from source: see vendor/antlr4-csharp/README.md. -->
		<ProjectReference Include="..\vendor\antlr4-csharp\SharpMUSH.Antlr4.Runtime.csproj" />
	</ItemGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.CLSCompliant">
			<_Parameter1>false</_Parameter1>
			<_Parameter1_TypeName>System.Boolean</_Parameter1_TypeName>
		</AssemblyAttribute>
	</ItemGroup>
</Project>
