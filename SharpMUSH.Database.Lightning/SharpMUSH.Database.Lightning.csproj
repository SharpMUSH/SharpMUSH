<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>default</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharpMUSH.Tests" />
    <InternalsVisibleTo Include="SharpMUSH.Tests.Infrastructure" />
    <InternalsVisibleTo Include="WikiSemantics.NativeProbe" />
    <InternalsVisibleTo Include="FeedDictionary" />
    <InternalsVisibleTo Include="SharpMUSH.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LightningDB" Version="0.23.1" />
    <PackageReference Include="System.Linq.Async" Version="6.0.1" ExcludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpMUSH.Database\SharpMUSH.Database.csproj" />
    <ProjectReference Include="..\SharpMUSH.Contracts\SharpMUSH.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The feed line dictionary that ships with the server; never replaced (see LightningDatabase.FeedCompression.cs). -->
    <EmbeddedResource Include="Resources/feed-lines-0.zdict" LogicalName="SharpMUSH.Database.Lightning.feed-lines-0.zdict" />
  </ItemGroup>

</Project>
